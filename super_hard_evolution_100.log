s': [{'path': 'program.py', 'content': '# Copyright 2026 Google LLC\nfrom typing import Any, Mapping\nimport math\nimport random\nimport numpy as np\n\n# EVOLVE-BLOCK-START\ndef optimize_cover_step(congr_dict, cand_mods, targets, cnt_array, logm, logboost, t_temp):\n    """Optimize a single step of congruence cover using simulated annealing style logic.\n\n    Args:\n        congr_dict: Dictionary of r -> a\n        cand_mods: List of prime candidates\n        targets: np.array of target primes\n        cnt_array: np.array of coverage counts\n        logm: current log of modulus M\n        logboost: current log of boost factor\n        t_temp: current temperature\n\n    Returns:\n        Updated congr_dict\n    """\n    import numpy as np\n    import random\n\n    if len(targets) == 0:\n        # Safety fallback\n        kind = random.random()\n        r_in = random.choice(list(congr_dict)) if congr_dict else None\n        if kind < 0.5 and r_in is not None:\n            a_old = congr_dict[r_in]\n            a_new = random.randint(0, r_in - 1)\n            if a_new != a_old:\n                congr_dict[r_in] = a_new\n        elif kind < 0.7 and r_in is not None:\n            del congr_dict[r_in]\n        else:\n            r_out = random.choice(cand_mods)\n            if r_out not in congr_dict:\n                a_new = random.randint(0, r_out - 1)\n                congr_dict[r_out] = a_new\n        return congr_dict\n\n    temp = max(t_temp, 1e-4)\n\n    # 1. DROP PHASE\n    # Drop poorly performing moduli probabilistically\n    if congr_dict and random.random() < 0.2:\n        weights_drop = 0.5 ** (cnt_array - 1)\n        mods_in = list(congr_dict.keys())\n        scores = []\n        for r in mods_in:\n            a = congr_dict[r]\n            mask = (targets % r) == a\n            val = np.sum(weights_drop[mask])\n            cost = np.log(r) if r > 1 else 1.0\n            scores.append(val / cost)\n            \n        scores = np.array(scores)\n        if temp < 0.05:\n            worst_idx = int(np.argmin(scores))\n        else:\n            noise = np.random.gumbel(0, temp * (np.std(scores) + 1e-9), size=len(scores))\n            worst_idx = int(np.argmin(scores - noise))\n\n        worst_r = mods_in[worst_idx]\n        a_drop = congr_dict[worst_r]\n        del congr_dict[worst_r]\n        cnt_array = cnt_array - ((targets % worst_r) == a_drop)\n\n    # 2. ADD PHASE\n    # Always add one new modulus per step\n    cand_pool = [m for m in cand_mods if m not in congr_dict]\n    if cand_pool:\n        sample_size = min(150, len(cand_pool))\n        sampled_cands = random.sample(cand_pool, sample_size)\n        weights_add = 0.5 ** cnt_array\n        \n        cands_data = []\n        for r in sampled_cands:\n            counts = np.bincount(targets % r, weights=weights_add, minlength=r)\n            a = int(np.argmax(counts))\n            score = counts[a] / (np.log(r) if r > 1 else 1.0)\n            cands_data.append((score, r, a))\n            \n        scores = np.array([x[0] for x in cands_data])\n        if temp < 0.05:\n            best_idx = int(np.argmax(scores))\n        else:\n            noise = np.random.gumbel(0, temp * (np.std(scores) + 1e-9), size=len(scores))\n            best_idx = int(np.argmax(scores + noise))\n            \n        _, best_r, best_a = cands_data[best_idx]\n        congr_dict[best_r] = best_a\n        cnt_array = cnt_array + ((targets % best_r) == best_a)\n\n    # 3. OPTIMIZE PHASE\n    # Optimize all active moduli sequentially\n    if congr_dict:\n        mods_in = list(congr_dict.keys())\n        random.shuffle(mods_in)\n        for r in mods_in:\n            a_old = congr_dict[r]\n            is_covered = (targets % r) == a_old\n            cnt_bg = cnt_array - is_covered\n            \n            weights_opt = 0.5 ** cnt_bg\n            counts = np.bincount(targets % r, weights=weights_opt, minlength=r)\n            \n            if temp < 0.05:\n                a_new = int(np.argmax(counts))\n            else:\n                noise = np.random.gumbel(0, temp * (np.std(counts) + 1e-9), size=r)\n                a_new = int(np.argmax(counts + noise))\n                \n            if a_new != a_old:\n                congr_dict[r] = a_new\n                cnt_array = cnt_bg + ((targets % r) == a_new)\n\n    return congr_dict\n# EVOLVE-BLOCK-END\n\ndef evaluate(eval_inputs: Mapping[str, Any]) -> dict[str, float]:\n    """Run evaluation on the optimized step."""\n    # Let\'s say we maximize -n_digits_est (smaller estimated N-size)\n    # Using sympy/math to compute est digits\n    import sympy\n    import numpy as np\n    Q = 100003\n    targets = np.array(list(sympy.primerange(3, Q)), dtype=np.int64)\n    # Let\'s run the optimize_cover_step starting from empty cover for some iterations\n    congr_dict = {}\n    cand_mods = [int(r) for r in sympy.primerange(3, 8000)]\n    cnt_array = np.zeros(len(targets), dtype=np.int16)\n    logm = math.log(2)\n    logboost = math.log(2.0)\n    \n    for it in range(10):\n        t_temp = 0.8 * (0.02 / 0.8) ** (it / 10)\n        # Update cnt_array based on congr_dict\n        cnt_array = np.zeros(len(targets), dtype=np.int16)\n        logm = math.log(2)\n        logboost = math.log(2.0)\n        for r, a in congr_dict.items():\n            cnt_array += (targets % r) == a\n            logm += math.log(r)\n            logboost += math.log(r / (r - 1))\n            \n        congr_dict = optimize_cover_step(congr_dict, cand_mods, targets, cnt_array, logm, logboost, t_temp)\n        \n    # Recalculate final metrics\n    cnt_array = np.zeros(len(targets), dtype=np.int16)\n    logm = math.log(2)\n    logboost = math.log(2.0)\n    for r, a in congr_dict.items():\n        cnt_array += (targets % r) == a\n        logm += math.log(r)\n        logboost += math.log(r / (r - 1))\n        \n    n_res = int((cnt_array == 0).sum())\n    boost = math.exp(logboost)\n    m_digits = logm / math.log(10)\n    \n    ub = n_res * boost\n    LN10 = math.log(10)\n    D = (m_digits + math.sqrt(m_digits ** 2 + 4 * ub / (LN10 * LN10))) / 2\n    return {"neg_est_digits": -float(D)}\n'}]}, 'evaluation': {'scores': {'scores': [{'metric': 'neg_est_digits', 'score': -56.81776}]}}, 'parentPrograms': ['projects/799795028847/locations/global/collections/default_collection/engines/goldbach_1784979910032/sessions/7013217697778074030/alphaEvolveExperiments/15164875354338173448/alphaEvolvePrograms/18102573509735109626'], 'state': 'COMPLETED'}, {'name': 'projects/799795028847/locations/global/collections/default_collection/engines/goldbach_1784979910032/sessions/7013217697778074030/alphaEvolveExperiments/15164875354338173448/alphaEvolvePrograms/18102573509735109908', 'createTime': '2026-07-25T19:57:45.582310Z', 'content': {'files': [{'path': 'program.py', 'content': '# Copyright 2026 Google LLC\nfrom typing import Any, Mapping\nimport math\nimport random\nimport numpy as np\n\n# EVOLVE-BLOCK-START\ndef optimize_cover_step(congr_dict, cand_mods, targets, cnt_array, logm, logboost, t_temp):\n    """Optimize a single step of congruence cover using simulated annealing style logic.\n\n    Args:\n        congr_dict: Dictionary of r -> a\n        cand_mods: List of prime candidates\n        targets: np.array of target primes\n        cnt_array: np.array of coverage counts\n        logm: current log of modulus M\n        logboost: current log of boost factor\n        t_temp: current temperature\n\n    Returns:\n        Updated congr_dict\n    """\n    import numpy as np\n    import random\n\n    if len(targets) == 0:\n        # Safety fallback\n        kind = random.random()\n        r_in = random.choice(list(congr_dict)) if congr_dict else None\n        if kind < 0.5 and r_in is not None:\n            a_old = congr_dict[r_in]\n            a_new = random.randint(0, r_in - 1)\n            if a_new != a_old:\n                congr_dict[r_in] = a_new\n        elif kind < 0.7 and r_in is not None:\n            del congr_dict[r_in]\n        else:\n            r_out = random.choice(cand_mods)\n            if r_out not in congr_dict:\n                a_new = random.randint(0, r_out - 1)\n                congr_dict[r_out] = a_new\n        return congr_dict\n\n    temp = max(t_temp, 1e-4)\n\n    import math\n    LN10 = 2.302585092994046\n\n    # 1. DROP PHASE: Exact Objective Minimization\n    if congr_dict and random.random() < 0.4:\n        mods_in = list(congr_dict.keys())\n        scores = []\n        \n        m_digits = logm / LN10\n        boost = math.exp(logboost)\n        n_res = int(np.sum(cnt_array == 0))\n        \n        for r in mods_in:\n            a = congr_dict[r]\n            mask = (targets % r) == a\n            c1 = np.sum(cnt_array[mask] == 1)\n            \n            new_n_res = n_res + c1\n            new_m_digits = m_digits - math.log10(r)\n            new_boost = boost * (r - 1) / r\n            \n            ub = new_n_res * new_boost\n            new_D = (new_m_digits + math.sqrt(new_m_digits**2 + 4 * ub / (LN10**2))) / 2\n            \n            # We want to maximize score, which means minimizing new_D\n            scores.append((-new_D, r))\n            \n        scores_vals = np.array([x[0] for x in scores])\n        if temp < 0.05:\n            best_idx = int(np.argmax(scores_vals))\n        else:\n            noise = np.random.gumbel(0, temp * (np.std(scores_vals) + 1e-9), size=len(scores_vals))\n            best_idx = int(np.argmax(scores_vals + noise))\n            \n        _, worst_r = scores[best_idx]\n        a_drop = congr_dict[worst_r]\n        del congr_dict[worst_r]\n        cnt_array = cnt_array - ((targets % worst_r) == a_drop)\n        logm -= math.log(worst_r)\n        logboost -= math.log(worst_r / (worst_r - 1))\n\n    # 2. ADD PHASE: Greedy D-score Decimation\n    num_adds = random.randint(1, 3)\n    for _ in range(num_adds):\n        cand_pool = [m for m in cand_mods if m not in congr_dict]\n        if not cand_pool:\n            break\n            \n        m_digits = logm / LN10\n        boost = math.exp(logboost)\n        n_res = int(np.sum(cnt_array == 0))\n        \n        sample_size = min(300, len(cand_pool))\n        sampled_cands = random.sample(cand_pool, sample_size)\n        \n        cands_data = []\n        targets_0 = targets[cnt_array == 0]\n        targets_1 = targets[cnt_array == 1]\n        \n        for r in sampled_cands:\n            counts_0 = np.bincount((targets_0 % r).astype(np.int32), minlength=r) if len(targets_0) > 0 else np.zeros(r)\n            counts_1 = np.bincount((targets_1 % r).astype(np.int32), minlength=r) if len(targets_1) > 0 else np.zeros(r)\n            \n            combined_counts = counts_0 + 1e-6 * counts_1\n            best_a = int(np.argmax(combined_counts))\n            c0 = counts_0[best_a]\n            c1 = counts_1[best_a]\n            \n            new_n_res = n_res - c0\n            new_m_digits = m_digits + math.log10(r)\n            new_boost = boost * r / (r - 1)\n            \n            ub = new_n_res * new_boost\n            new_D = (new_m_digits + math.sqrt(new_m_digits**2 + 4 * ub / (LN10**2))) / 2\n            \n            cands_data.append((-new_D + c1 * 1e-8, r, best_a))\n            \n        scores = np.array([x[0] for x in cands_data])\n        if temp < 0.05:\n            best_idx = int(np.argmax(scores))\n        else:\n            noise = np.random.gumbel(0, temp * (np.std(scores) + 1e-9), size=len(scores))\n            best_idx = int(np.argmax(scores + noise))\n            \n        _, best_r, best_a = cands_data[best_idx]\n        congr_dict[best_r] = best_a\n        cnt_array = cnt_array + ((targets % best_r) == best_a)\n        logm += math.log(best_r)\n        logboost += math.log(best_r / (best_r - 1))\n\n    # 3. OPTIMIZE PHASE: Pure Zero-Target Focused Re-alignment\n    if congr_dict:\n        mods_in = list(congr_dict.keys())\n        random.shuffle(mods_in)\n        opt_count = max(1, int(len(mods_in) * 0.5))\n        for r in mods_in[:opt_count]:\n            a_old = congr_dict[r]\n            is_covered = (targets % r) == a_old\n            cnt_bg = cnt_array - is_covered\n            \n            targets_0 = targets[cnt_bg == 0]\n            targets_1 = targets[cnt_bg == 1]\n            counts_0 = np.bincount((targets_0 % r).astype(np.int32), minlength=r) if len(targets_0) > 0 else np.zeros(r)\n            counts_1 = np.bincount((targets_1 % r).astype(np.int32), minlength=r) if len(targets_1) > 0 else np.zeros(r)\n            \n            combined_counts = counts_0 + 1e-6 * counts_1\n            \n            if temp < 0.05:\n                a_new = int(np.argmax(combined_counts))\n            else:\n                noise = np.random.gumbel(0, temp * (np.std(combined_counts) + 1e-9), size=r)\n                a_new = int(np.argmax(combined_counts + noise))\n                \n            if a_new != a_old:\n                congr_dict[r] = a_new\n                cnt_array = cnt_bg + ((targets % r) == a_new)\n\n    return congr_dict\n# EVOLVE-BLOCK-END\n\ndef evaluate(eval_inputs: Mapping[str, Any]) -> dict[str, float]:\n    """Run evaluation on the optimized step."""\n    # Let\'s say we maximize -n_digits_est (smaller estimated N-size)\n    # Using sympy/math to compute est digits\n    import sympy\n    import numpy as np\n    Q = 100003\n    targets = np.array(list(sympy.primerange(3, Q)), dtype=np.int64)\n    # Let\'s run the optimize_cover_step starting from empty cover for some iterations\n    congr_dict = {}\n    cand_mods = [int(r) for r in sympy.primerange(3, 8000)]\n    cnt_array = np.zeros(len(targets), dtype=np.int16)\n    logm = math.log(2)\n    logboost = math.log(2.0)\n    \n    for it in range(10):\n        t_temp = 0.8 * (0.02 / 0.8) ** (it / 10)\n        # Update cnt_array based on congr_dict\n        cnt_array = np.zeros(len(targets), dtype=np.int16)\n        logm = math.log(2)\n        logboost = math.log(2.0)\n        for r, a in congr_dict.items():\n            cnt_array += (targets % r) == a\n            logm += math.log(r)\n            logboost += math.log(r / (r - 1))\n            \n        congr_dict = optimize_cover_step(congr_dict, cand_mods, targets, cnt_array, logm, logboost, t_temp)\n        \n    # Recalculate final metrics\n    cnt_array = np.zeros(len(targets), dtype=np.int16)\n    logm = math.log(2)\n    logboost = math.log(2.0)\n    for r, a in congr_dict.items():\n        cnt_array += (targets % r) == a\n        logm += math.log(r)\n        logboost += math.log(r / (r - 1))\n        \n    n_res = int((cnt_array == 0).sum())\n    boost = math.exp(logboost)\n    m_digits = logm / math.log(10)\n    \n    ub = n_res * boost\n    LN10 = math.log(10)\n    D = (m_digits + math.sqrt(m_digits ** 2 + 4 * ub / (LN10 * LN10))) / 2\n    return {"neg_est_digits": -float(D)}\n'}]}, 'evaluation': {'scores': {'scores': [{'metric': 'neg_est_digits', 'score': -57.66483}]}}, 'parentPrograms': ['projects/799795028847/locations/global/collections/default_collection/engines/goldbach_1784979910032/sessions/7013217697778074030/alphaEvolveExperiments/15164875354338173448/alphaEvolvePrograms/18102573509735109270'], 'state': 'COMPLETED'}, {'name': 'projects/799795028847/locations/global/collections/default_collection/engines/goldbach_1784979910032/sessions/7013217697778074030/alphaEvolveExperiments/15164875354338173448/alphaEvolvePrograms/18102573509735110994', 'createTime': '2026-07-25T19:33:02.187589Z', 'content': {'files': [{'path': 'program.py', 'content': '# Copyright 2026 Google LLC\nfrom typing import Any, Mapping\nimport math\nimport random\nimport numpy as np\n\n# EVOLVE-BLOCK-START\ndef optimize_cover_step(congr_dict, cand_mods, targets, cnt_array, logm, logboost, t_temp):\n    """Optimize a single step of congruence cover using simulated annealing style logic.\n\n    Args:\n        congr_dict: Dictionary of r -> a\n        cand_mods: List of prime candidates\n        targets: np.array of target primes\n        cnt_array: np.array of coverage counts\n        logm: current log of modulus M\n        logboost: current log of boost factor\n        t_temp: current temperature\n\n    Returns:\n        Updated congr_dict\n    """\n    import numpy as np\n    import random\n\n    if len(targets) == 0:\n        # Safety fallback\n        kind = random.random()\n        r_in = random.choice(list(congr_dict)) if congr_dict else None\n        if kind < 0.5 and r_in is not None:\n            a_old = congr_dict[r_in]\n            a_new = random.randint(0, r_in - 1)\n            if a_new != a_old:\n                congr_dict[r_in] = a_new\n        elif kind < 0.7 and r_in is not None:\n            del congr_dict[r_in]\n        else:\n            r_out = random.choice(cand_mods)\n            if r_out not in congr_dict:\n                a_new = random.randint(0, r_out - 1)\n                congr_dict[r_out] = a_new\n        return congr_dict\n\n    # Dynamic action probabilities based on temperature\n    # At high temp, we explore (more add/drop). At low temp, we exploit (more optimize).\n    factor = np.clip(t_temp, 0.0, 1.0)\n    p_opt = 0.85 - 0.45 * factor\n    p_add = 0.10 + 0.25 * factor\n    p_drop = 0.05 + 0.20 * factor\n    total_p = p_opt + p_add + p_drop\n    p_opt /= total_p\n    p_add /= total_p\n    p_drop /= total_p\n\n    kind = random.random()\n    if not congr_dict:\n        action = \'add\'\n    else:\n        cand_pool = [m for m in cand_mods if m not in congr_dict]\n        if not cand_pool:\n            p_opt_cond = p_opt / (p_opt + p_drop)\n            action = \'optimize\' if kind < p_opt_cond else \'drop\'\n        else:\n            if kind < p_add:\n                action = \'add\'\n            elif kind < p_add + p_opt:\n                action = \'optimize\'\n            else:\n                action = \'drop\'\n\n    if action == \'add\':\n        cand_pool = [m for m in cand_mods if m not in congr_dict]\n        if cand_pool:\n            sample_size = min(100, len(cand_pool))\n            sampled_cands = random.sample(cand_pool, sample_size)\n            \n            n_res_curr = np.sum(cnt_array == 0)\n            weights_add = (cnt_array == 0).astype(np.float64)\n            \n            cands_data = []\n            energies = []\n            LN10 = np.log(10)\n            LN10_SQ = LN10 * LN10\n            \n            for r in sampled_cands:\n                rem = targets % r\n                counts = np.bincount(rem, weights=weights_add, minlength=r)\n                a = int(np.argmax(counts))\n                \n                n_res_new = n_res_curr - counts[a]\n                lm_new = logm + np.log(r)\n                lb_new = logboost + np.log(r / (r - 1.0))\n                \n                m_d = lm_new / LN10\n                ub = n_res_new * np.exp(lb_new)\n                D_new = (m_d + np.sqrt(m_d**2 + 4 * ub / LN10_SQ)) / 2.0\n                \n                energies.append(D_new)\n                cands_data.append((r, a))\n            \n            energies = np.array(energies)\n            temp = max(t_temp, 1e-4)\n            scaled = -energies / temp\n            scaled = scaled - np.max(scaled)\n            probs = np.exp(scaled)\n            probs_sum = np.sum(probs)\n            if probs_sum > 0:\n                probs /= probs_sum\n            else:\n                probs = np.ones(len(probs)) / len(probs)\n                \n            idx = np.random.choice(len(sampled_cands), p=probs)\n            best_cand, best_a = cands_data[idx]\n            congr_dict[best_cand] = int(best_a)\n\n    elif action == \'optimize\':\n        mods_in = list(congr_dict.keys())\n        if mods_in:\n            sample_size = min(10, len(mods_in))\n            sampled_mods = random.sample(mods_in, sample_size)\n            \n            all_energies = []\n            all_actions = []\n            \n            LN10 = np.log(10)\n            LN10_SQ = LN10 * LN10\n            m_d = logm / LN10\n            boost_val = np.exp(logboost)\n            \n            for r in sampled_mods:\n                a_old = congr_dict[r]\n                is_covered_by_r = (targets % r) == a_old\n                cnt_bg = cnt_array - is_covered_by_r\n                \n                weights_opt = (cnt_bg == 0).astype(np.float64)\n                counts = np.bincount(targets % r, weights=weights_opt, minlength=r)\n                \n                n_res_bg = np.sum(cnt_bg == 0)\n                n_res_new = n_res_bg - counts\n                \n                ub = n_res_new * boost_val\n                energies = (m_d + np.sqrt(m_d**2 + 4 * ub / LN10_SQ)) / 2.0\n                \n                for a_cand in range(r):\n                    all_energies.append(energies[a_cand])\n                    all_actions.append((r, a_cand))\n                    \n            all_energies = np.array(all_energies)\n            temp = max(t_temp, 1e-4)\n            scaled = -all_energies / temp\n            scaled = scaled - np.max(scaled)\n            probs = np.exp(scaled)\n            probs_sum = np.sum(probs)\n            if probs_sum > 0:\n                probs /= probs_sum\n            else:\n                probs = np.ones(len(probs)) / len(probs)\n                \n            idx = np.random.choice(len(all_actions), p=probs)\n            chosen_r, chosen_a = all_actions[idx]\n            congr_dict[chosen_r] = int(chosen_a)\n\n    elif action == \'drop\':\n        mods_in = list(congr_dict.keys())\n        if mods_in:\n            sample_size = min(100, len(mods_in))\n            sampled_mods = random.sample(mods_in, sample_size)\n            \n            n_res_curr = np.sum(cnt_array == 0)\n            weights_drop = (cnt_array == 1).astype(np.float64)\n            \n            energies = []\n            LN10 = np.log(10)\n            LN10_SQ = LN10 * LN10\n            \n            for r in sampled_mods:\n                a = congr_dict[r]\n                mask = (targets % r) == a\n                n_res_new = n_res_curr + np.sum(weights_drop[mask])\n                lm_new = logm - np.log(r)\n                lb_new = logboost - np.log(r / (r - 1.0))\n                \n                m_d = lm_new / LN10\n                ub = n_res_new * np.exp(lb_new)\n                D_new = (m_d + np.sqrt(m_d**2 + 4 * ub / LN10_SQ)) / 2.0\n                energies.append(D_new)\n                \n            energies = np.array(energies)\n            temp = max(t_temp, 1e-4)\n            scaled = -energies / temp\n            scaled = scaled - np.max(scaled)\n            probs = np.exp(scaled)\n            probs_sum = np.sum(probs)\n            if probs_sum > 0:\n                probs /= probs_sum\n            else:\n                probs = np.ones(len(probs)) / len(probs)\n                \n            idx = np.random.choice(len(sampled_mods), p=probs)\n            r_drop = sampled_mods[idx]\n            del congr_dict[r_drop]\n\n    return congr_dict\n# EVOLVE-BLOCK-END\n\ndef evaluate(eval_inputs: Mapping[str, Any]) -> dict[str, float]:\n    """Run evaluation on the optimized step."""\n    # Let\'s say we maximize -n_digits_est (smaller estimated N-size)\n    # Using sympy/math to compute est digits\n    import sympy\n    import numpy as np\n    Q = 100003\n    targets = np.array(list(sympy.primerange(3, Q)), dtype=np.int64)\n    # Let\'s run the optimize_cover_step starting from empty cover for some iterations\n    congr_dict = {}\n    cand_mods = [int(r) for r in sympy.primerange(3, 8000)]\n    cnt_array = np.zeros(len(targets), dtype=np.int16)\n    logm = math.log(2)\n    logboost = math.log(2.0)\n    \n    for it in range(10):\n        t_temp = 0.8 * (0.02 / 0.8) ** (it / 10)\n        # Update cnt_array based on congr_dict\n        cnt_array = np.zeros(len(targets), dtype=np.int16)\n        logm = math.log(2)\n        logboost = math.log(2.0)\n        for r, a in congr_dict.items():\n            cnt_array += (targets % r) == a\n            logm += math.log(r