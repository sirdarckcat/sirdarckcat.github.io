\n        \n        if not current_congr:\n            move_type = \'add\'\n        elif not cand_pool:\n            move_type = random.choice([\'drop\', \'mutate_a\'])\n        else:\n            move_type = random.choice([\'add\', \'drop\', \'swap\', \'mutate_a\'])\n            \n        accepted = False\n        \n        if move_type == \'add\':\n            r = random.choice(cand_pool)\n            uncovered_indices = (current_cnt == 0)\n            rem = targets[uncovered_indices] % r\n            if len(rem) == 0:\n                a = random.randint(0, r - 1)\n                cov_count = 0\n            else:\n                counts = np.bincount(rem, minlength=r)\n                a = np.argmax(counts)\n                cov_count = counts[a]\n                \n            logm_new = current_logm + math.log(r)\n            logboost_new = current_logboost + math.log(r / (r - 1))\n            n_res_new = current_n_res - cov_count\n            \n            score_new = get_score_metrics(n_res_new, logm_new, logboost_new)\n            delta = score_new - get_score_metrics(current_n_res, current_logm, current_logboost)\n            if delta > 0 or random.random() < math.exp(delta / temp):\n                current_congr[r] = int(a)\n                current_cnt += (targets % r) == a\n                current_logm = logm_new\n                current_logboost = logboost_new\n                current_n_res = n_res_new\n                accepted = True\n                \n        elif move_type == \'drop\':\n            r = random.choice(list(current_congr.keys()))\n            a = current_congr[r]\n            \n            logm_new = current_logm - math.log(r)\n            logboost_new = current_logboost - math.log(r / (r - 1))\n            \n            is_cov = (targets % r) == a\n            unique_cov = np.count_nonzero((current_cnt == 1) & is_cov)\n            n_res_new = current_n_res + unique_cov\n            \n            score_new = get_score_metrics(n_res_new, logm_new, logboost_new)\n            delta = score_new - get_score_metrics(current_n_res, current_logm, current_logboost)\n            if delta > 0 or random.random() < math.exp(delta / temp):\n                current_cnt -= is_cov\n                del current_congr[r]\n                current_logm = logm_new\n                current_logboost = logboost_new\n                current_n_res = n_res_new\n                accepted = True\n                \n        elif move_type == \'swap\':\n            r_drop = random.choice(list(current_congr.keys()))\n            a_drop = current_congr[r_drop]\n            r_add = random.choice(cand_pool)\n            \n            is_cov_drop = (targets % r_drop) == a_drop\n            cnt_temp = current_cnt - is_cov_drop\n            \n            uncovered_temp = (cnt_temp == 0)\n            rem = targets[uncovered_temp] % r_add\n            if len(rem) == 0:\n                a_add = random.randint(0, r_add - 1)\n                cov_count = 0\n            else:\n                counts = np.bincount(rem, minlength=r_add)\n                a_add = np.argmax(counts)\n                cov_count = counts[a_add]\n                \n            n_res_new = np.count_nonzero(uncovered_temp) - cov_count\n            logm_new = current_logm - math.log(r_drop) + math.log(r_add)\n            logboost_new = current_logboost - math.log(r_drop / (r_drop - 1)) + math.log(r_add / (r_add - 1))\n            \n            score_new = get_score_metrics(n_res_new, logm_new, logboost_new)\n            delta = score_new - get_score_metrics(current_n_res, current_logm, current_logboost)\n            if delta > 0 or random.random() < math.exp(delta / temp):\n                current_cnt -= is_cov_drop\n                del current_congr[r_drop]\n                \n                current_congr[r_add] = int(a_add)\n                current_cnt += (targets % r_add) == a_add\n                current_logm = logm_new\n                current_logboost = logboost_new\n                current_n_res = n_res_new\n                accepted = True\n                \n        elif move_type == \'mutate_a\':\n            r = random.choice(list(current_congr.keys()))\n            a_old = current_congr[r]\n            if r > 1:\n                a_new = random.choice([i for i in range(r) if i != a_old])\n                is_cov_old = (targets % r) == a_old\n                cnt_temp = current_cnt - is_cov_old\n                is_cov_new = (targets % r) == a_new\n                cnt_new = cnt_temp + is_cov_new\n                n_res_new = np.count_nonzero(cnt_new == 0)\n                \n                score_new = get_score_metrics(n_res_new, current_logm, current_logboost)\n                delta = score_new - get_score_metrics(current_n_res, current_logm, current_logboost)\n                if delta > 0 or random.random() < math.exp(delta / temp):\n                    current_cnt[:] = cnt_new\n                    current_congr[r] = int(a_new)\n                    current_n_res = n_res_new\n                    accepted = True\n                    \n        if accepted:\n            current_score = get_score_metrics(current_n_res, current_logm, current_logboost)\n            if current_score > best_score:\n                best_score = current_score\n                best_congr = current_congr.copy()\n\n    # 2. Run greedy hill-climbing polish starting from the best cover found\n    current_congr = best_congr.copy()\n    current_cnt = np.zeros(len(targets), dtype=np.int16)\n    current_logm = math.log(2)\n    current_logboost = math.log(2.0)\n    for r, a in current_congr.items():\n        current_cnt += (targets % r) == a\n        current_logm += math.log(r)\n        current_logboost += math.log(r / (r - 1))\n    current_n_res = np.count_nonzero(current_cnt == 0)\n    best_score = get_score_metrics(current_n_res, current_logm, current_logboost)\n\n    for polish_iter in range(5):\n        improved = False\n        \n        # Sweep remainder optimization\n        for r in list(current_congr.keys()):\n            a_old = current_congr[r]\n            is_cov = (targets % r) == a_old\n            cnt_bg = current_cnt - is_cov\n            uncovered = (cnt_bg == 0)\n            rem_uncovered = targets[uncovered] % r\n            if len(rem_uncovered) > 0:\n                counts = np.bincount(rem_uncovered, minlength=r)\n                a_new = np.argmax(counts)\n            else:\n                a_new = a_old\n                \n            if a_new != a_old:\n                current_congr[r] = int(a_new)\n                current_cnt[:] = cnt_bg + ((targets % r) == a_new)\n                current_n_res = np.count_nonzero(current_cnt == 0)\n                \n        current_score = get_score_metrics(current_n_res, current_logm, current_logboost)\n        if current_score > best_score:\n            best_score = current_score\n            best_congr = current_congr.copy()\n            improved = True\n            \n        # Try adding a modulus greedily\n        best_add_r = None\n        best_add_a = None\n        best_add_score = -float(\'inf\')\n        \n        cand_pool = [r for r in cand_mods if r not in current_congr]\n        sampled_cands = random.sample(cand_pool, min(150, len(cand_pool))) if cand_pool else []\n        \n        uncovered_indices = (current_cnt == 0)\n        targets_uncovered = targets[uncovered_indices]\n        \n        for r in sampled_cands:\n            rem = targets_uncovered % r\n            if len(rem) == 0:\n                a = 0\n                n_res_new = current_n_res\n            else:\n                counts = np.bincount(rem, minlength=r)\n                a = np.argmax(counts)\n                n_res_new = current_n_res - counts[a]\n                \n            logm_new = current_logm + math.log(r)\n            logboost_new = current_logboost + math.log(r / (r - 1))\n            score_new = get_score_metrics(n_res_new, logm_new, logboost_new)\n            if score_new > best_add_score:\n                best_add_score = score_new\n                best_add_r = r\n                best_add_a = a\n                \n        if best_add_score > best_score:\n            r = best_add_r\n            a = best_add_a\n            current_congr[r] = int(a)\n            current_cnt += (targets % r) == a\n            current_logm += math.log(r)\n            current_logboost += math.log(r / (r - 1))\n            current_n_res = np.count_nonzero(current_cnt == 0)\n            best_score = best_add_score\n            best_congr = current_congr.copy()\n            improved = True\n            \n        # Try dropping a modulus greedily\n        best_drop_r = None\n        best_drop_score = -float(\'inf\')\n        for r in list(current_congr.keys()):\n            a = current_congr[r]\n            is_cov = (targets % r) == a\n            unique_cov = np.count_nonzero((current_cnt == 1) & is_cov)\n            n_res_new = current_n_res + unique_cov\n            \n            logm_new = current_logm - math.log(r)\n            logboost_new = current_logboost - math.log(r / (r - 1))\n            score_new = get_score_metrics(n_res_new, logm_new, logboost_new)\n            if score_new > best_drop_score:\n                best_drop_score = score_new\n                best_drop_r = r\n                \n        if best_drop_score > best_score:\n            r = best_drop_r\n            a = current_congr[r]\n            current_cnt -= (targets % r) == a\n            del current_congr[r]\n            current_logm -= math.log(r)\n            current_logboost -= math.log(r / (r - 1))\n            current_n_res = np.count_nonzero(current_cnt == 0)\n            best_score = best_drop_score\n            best_congr = current_congr.copy()\n            improved = True\n            \n        if not improved:\n            break\n            \n    return best_congr\n# EVOLVE-BLOCK-END\n\ndef evaluate(eval_inputs: Mapping[str, Any]) -> dict[str, float]:\n    """Run evaluation on the optimized step."""\n    import sympy\n    import numpy as np\n    Q = 100003\n    targets = np.array(list(sympy.primerange(3, Q)), dtype=np.int64)\n    \n    # Warm-start from the 195-digit record cover instead of starting empty\n    congr_dict = {int(r): int(a) for r, a in eval_inputs["warm_start_cover"]}\n    \n    cand_mods = [int(r) for r in sympy.primerange(3, 8000)]\n    cnt_array = np.zeros(len(targets), dtype=np.int16)\n    \n    # Pre-populate counts\n    for r, a in congr_dict.items():\n        cnt_array += (targets % r) == a\n        \n    for it in range(10):\n        t_temp = 0.8 * (0.02 / 0.8) ** (it / 10)\n        # Recalculate cnt_array based on congr_dict\n        cnt_array = np.zeros(len(targets), dtype=np.int16)\n        logm = math.log(2)\n        logboost = math.log(2.0)\n        for r, a in congr_dict.items():\n            cnt_array += (targets % r) == a\n            logm += math.log(r)\n            logboost += math.log(r / (r - 1))\n            \n        congr_dict = optimize_cover_step(congr_dict, cand_mods, targets, cnt_array, logm, logboost, t_temp)\n        \n    # Recalculate final metrics\n    cnt_array = np.zeros(len(targets), dtype=np.int16)\n    logm = math.log(2)\n    logboost = math.log(2.0)\n    for r, a in congr_dict.items():\n        cnt_array += (targets % r) == a\n        logm += math.log(r)\n        logboost += math.log(r / (r - 1))\n        \n    n_res = int((cnt_array == 0).sum())\n    boost = math.exp(logboost)\n    m_digits = logm / math.log(10)\n    \n    ub = n_res * boost\n    LN10 = math.log(10)\n    D = (m_digits + math.sqrt(m_digits ** 2 + 4 * ub / (LN10 * LN10))) / 2\n    \n    # Constrain E <= 17.5 via Lagrangian penalty to prevent reward hacking\n    E_limit = 17.5\n    E_actual = ub / (D * LN10) if D > 0 else 0.0\n    lagrangian_penalty = 0.0\n    if E_actual > E_limit:\n        lagrangian_penalty = 100.0 * (E_actual - E_limit) ** 2\n        \n    score_headline = -float(D + lagrangian_penalty)\n    \n    # Expose E, |U|, digits(M) as negated secondary metrics for joint optimization visibility\n    return {\n        "neg_est_digits": score_headline,\n        "neg_E": -float(E_actual),\n        "neg_residual_count": -float(n_res),\n        "neg_m_digits": -float(m_digits)\n    }\n'}]}, 'evaluation': {'scores': {'scores': [{'metric': 'neg_est_digits', 'score': -194.98308}, {'metric': 'neg_E', 'score': -17.40746}, {'metric': 'neg_residual_count', 'score': -711}, {'metric': 'neg_m_digits', 'score': -187.42311}]}, 'insights': {'insights': [{'label': 'Evaluation Metrics', 'text': 'Estimated Digits: 194.9831 (constrained), E: 17.4075, |U|: 711, digits(M): 187.42'}]}}, 'parentPrograms': ['projects/799795028847/locations/global/collections/default_collection/engines/goldbach_1784979910032/sessions/7658735534374771723/alphaEvolveExperiments/9582896010645531772/alphaEvolvePrograms/6333111851244192882'], 'state': 'COMPLETED'}, {'name': 'projects/799795028847/locations/global/collections/default_collection/engines/goldbach_1784979910032/sessions/7658735534374771723/alphaEvolveExperiments/9582896010645531772/alphaEvolvePrograms/7662895210918133556', 'createTime': '2026-07-26T05:59:14.212130Z', 'content': {'files': [{'path': 'program.py', 'content': '# Copyright 2026 Google LLC\nfrom typing import Any, Mapping\nimport math\nimport random\nimport numpy as np\n\n# EVOLVE-BLOCK-START\ndef optimize_cover_step(congr_dict, cand_mods, targets, cnt_array, logm, logboost, t_temp):\n    """Optimize a single step of congruence cover using simulated annealing style logic.\n\n    Args:\n        congr_dict: Dictionary of r -> a\n        cand_mods: List of prime candidates\n        targets: np.array of target primes\n        cnt_array: np.array of coverage counts\n        logm: current log of modulus M\n        logboost: current log of boost factor\n        t_temp: current temperature\n\n    Returns:\n        Updated congr_dict\n    """\n    import math\n    import random\n    import numpy as np\n\n    # Ensure congr_dict values are python ints\n    congr_dict = {int(k): int(v) for k, v in congr_dict.items()}\n\n    LN10 = math.log(10)\n    \n    def get_score(lm, lb, nr):\n        boost = math.exp(lb)\n        m_dig = lm / LN10\n        ub = nr * boost\n        D = (m_dig + math.sqrt(m_dig ** 2 + 4 * ub / (LN10 * LN10))) / 2\n        E_actual = ub / (D * LN10) if D > 0 else 0.0\n        penalty = 0.0\n        if E_actual > 17.5:\n            penalty = 100.0 * (E_actual - 17.5) ** 2\n        return D + penalty\n\n    cnt_array = cnt_array.copy()\n    current_score = get_score(logm, logboost, int(np.sum(cnt_array == 0)))\n    \n    num_steps = 300\n    \n    for _ in range(num_steps):\n        uncovered_idx = np.where(cnt_array == 0)[0]\n        uncovered_targets = targets[uncovered_idx]\n        n_res = len(uncovered_targets)\n        \n        r_choices = list(congr_dict.keys())\n        \n        if not r_choices:\n            action = \'add\'\n        elif len(r_choices) >= len(cand_mods):\n            action = \'modify_or_remove\'\n        else:\n            action = \'add\' if random.random() < 0.6 else \'modify_or_remove\'\n            \n        if action == \'add\':\n            avail_cands = [m for m in cand_mods if m not in congr_dict]\n            if not avail_cands:\n                continue\n            \n            # Prioritize smaller primes (first 10) and some random primes (up to 10)\n            num_smallest = min(10, len(avail_cands))\n            smallest_cands = avail_cands[:num_smallest]\n            remaining_cands = avail_cands[num_smallest:]\n            if remaining_cands:\n                random_cands = random.sample(remaining_cands, min(10, len(remaining_cands)))\n            else:\n                random_cands = []\n                \n            sampled_r = smallest_cands + random_cands\n            \n            best_candidate_move = None\n            best_candidate_score = float(\'inf\')\n            \n            for r in sampled_r:\n                if n_res == 0:\n                    continue\n                \n                rem = uncovered_targets % r\n                unique_res, counts = np.unique(rem, return_counts=True)\n                \n                for a, c in zip(unique_res, counts):\n                    new_n_res = n_res - c\n                    new_logm = logm + math.log(r)\n                    new_logboost = logboost + math.log(r / (r - 1))\n                    score = get_score(new_logm, new_logboost, new_n_res)\n                    if score < best_candidate_score:\n                        best_candidate_score = score\n                        best_candidate_move = (r, int(a), new_logm, new_logboost, new_n_res)\n            \n            if best_candidate_move is not None:\n                r, a, new_logm, new_logboost, new_n_res = best_candidate_move\n                score_diff = best_candidate_score - current_score\n                \n                if score_diff < 0 or random.random() < math.exp(-score_diff / t_temp):\n                    congr_dict[r] = a\n                    logm = new_logm\n                    logboost = new_logboost\n                    cnt_array += (targets % r) == a\n                    current_score = best_candidate_score\n                    \n        else: # modify_or_remove\n            r = random.choice(r_choices)\n            a_old = congr_dict[r]\n            \n            mask_only = (cnt_array == 1) & ((targets % r) == a_old)\n            L = int(np.sum(mask_only))\n            \n            if n_res > 0:\n                rem = uncovered_targets % r\n                unique_res, counts = np.unique(rem, return_counts=True)\n                res_counts = dict(zip(unique_res, counts))\n            else:\n                res_counts = {}\n                \n            best_opt_score = float(\'inf\')\n            best_opt_action = None\n            best_opt_metrics = None\n            \n            # Option 1: Remove r\n            new_logm_rem = logm - math.log(r)\n            new_logboost_rem = logboost - math.log(r / (r - 1))\n            new_n_res_rem = n_res + L\n            score_rem = get_score(new_logm_rem, new_logboost_rem, new_n_res_rem)\n            if score_rem < best_opt_score:\n                best_opt_score = score_rem\n                best_opt_action = \'remove\'\n                best_opt_metrics = (new_logm_rem, new_logboost_rem, new_n_res_rem)\n                \n            # Option 2: Keep r (no change)\n            if current_score < best_opt_score:\n                best_opt_score = current_score\n                best_opt_action = (\'modify\', a_old)\n                best_opt_metrics = (logm, logboost, n_res)\n                \n            # Option 3: Modify residue\n            for a_new, c in res_counts.items():\n                if a_new == a_old:\n                    continue\n                new_n_res_mod = n_res + L - c\n                score_mod = get_score(logm, logboost, new_n_res_mod)\n                if score_mod < best_opt_score:\n                    best_opt_score = score_mod\n                    best_opt_action = (\'modify\', int(a_new))\n                    best_opt_metrics = (logm, logboost, new_n_res_mod)\n                    \n            if best_opt_action is not None:\n                score_diff = best_opt_score - current_score\n                if score_diff < 0 or random.random() < math.exp(-score_diff / t_temp):\n                    new_logm, new_logboost, new_n_res = best_opt_metrics\n                    if best_opt_action == \'remove\':\n                        cnt_array -= (targets % r) == a_old\n                        del congr_dict[r]\n                    elif best_opt_action[0] == \'modify\':\n                        a_new = best_opt_action[1]\n                        if a_new != a_old:\n                            cnt_array -= (targets % r) == a_old\n                            cnt_array += (targets % r) == a_new\n                            congr_dict[r] = a_new\n                    logm = new_logm\n                    logboost = new_logboost\n                    current_score = best_opt_score\n\n    return congr_dict\n# EVOLVE-BLOCK-END\n\ndef evaluate(eval_inputs: Mapping[str, Any]) -> dict[str, float]:\n    """Run evaluation on the optimized step."""\n    import sympy\n    import numpy as np\n    Q = 100003\n    targets = np.array(list(sympy.primerange(3, Q)), dtype=np.int64)\n    \n    # Warm-start from the 195-digit record cover instead of starting empty\n    congr_dict = {int(r): int(a) for r, a in eval_inputs["warm_start_cover"]}\n    \n    cand_mods = [int(r) for r in sympy.primerange(3, 8000)]\n    cnt_array = np.zeros(len(targets), dtype=np.int16)\n    \n    # Pre-populate counts\n    for r, a in congr_dict.items():\n        cnt_array += (targets % r) == a\n        \n    for it in range(10):\n        t_temp = 0.8 * (0.02 / 0.8) ** (it / 10)\n        # Recalculate cnt_array based on congr_dict\n        cnt_array = np.zeros(len(targets), dtype=np.int16)\n        logm = math.log(2)\n        logboost = math.log(2.0)\n        for r, a in congr_dict.items():\n            cnt_array += (targets % r) == a\n            logm += math.log(r)\n            logboost += math.log(r / (r - 1))\n            \n        congr_dict = optimize_cover_step(congr_dict, cand_mods, targets, cnt_array, logm, logboost, t_temp)\n        \n    # Recalculate final metrics\n    cnt_array = np.zeros(len(targets), dtype=np.int16)\n    logm = math.log(2)\n    logboost = math.log(2.0)\n    for r, a in congr_dict.items():\n        cnt_array += (targets % r) == a\n        logm += math.log(r)\n        logboost += math.log(r / (r - 1))\n        \n    n_res = int((cnt_array == 0).sum())\n    boost = math.exp(logboost)\n    m_digits = logm / math.log(10)\n    \n    ub = n_res * boost\n    LN10 = math.log(10)\n    D = (m_digits + math.sqrt(m_digits ** 2 + 4 * ub / (LN10 * LN10))) / 2\n    \n    # Constrain E <= 17.5 via Lagrangian penalty to prevent reward