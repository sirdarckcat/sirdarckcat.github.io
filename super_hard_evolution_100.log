ts ** 2 + 4 * ub / (LN10 * LN10))) / 2\n    return {"neg_est_digits": -float(D)}\n'}]}, 'evaluation': {'scores': {'scores': [{'metric': 'neg_est_digits', 'score': -50.655006}]}}, 'parentPrograms': ['projects/799795028847/locations/global/collections/default_collection/engines/goldbach_1784979910032/sessions/7013217697778074030/alphaEvolveExperiments/15164875354338173448/alphaEvolvePrograms/18102573509735110994'], 'state': 'COMPLETED'}, {'name': 'projects/799795028847/locations/global/collections/default_collection/engines/goldbach_1784979910032/sessions/7013217697778074030/alphaEvolveExperiments/15164875354338173448/alphaEvolvePrograms/18102573509735111919', 'createTime': '2026-07-25T19:38:40.934862Z', 'content': {'files': [{'path': 'program.py', 'content': '# Copyright 2026 Google LLC\nfrom typing import Any, Mapping\nimport math\nimport random\nimport numpy as np\n\n# EVOLVE-BLOCK-START\ndef optimize_cover_step(congr_dict, cand_mods, targets, cnt_array, logm, logboost, t_temp):\n    """Optimize a single step of congruence cover using simulated annealing style logic.\n\n    Args:\n        congr_dict: Dictionary of r -> a\n        cand_mods: List of prime candidates\n        targets: np.array of target primes\n        cnt_array: np.array of coverage counts\n        logm: current log of modulus M\n        logboost: current log of boost factor\n        t_temp: current temperature\n\n    Returns:\n        Updated congr_dict\n    """\n    import numpy as np\n    import random\n    import math\n\n    if len(targets) == 0:\n        # Safety fallback\n        kind = random.random()\n        r_in = random.choice(list(congr_dict)) if congr_dict else None\n        if kind < 0.5 and r_in is not None:\n            a_old = congr_dict[r_in]\n            a_new = random.randint(0, r_in - 1)\n            if a_new != a_old:\n                congr_dict[r_in] = a_new\n        elif kind < 0.7 and r_in is not None:\n            del congr_dict[r_in]\n        else:\n            r_out = random.choice(cand_mods)\n            if r_out not in congr_dict:\n                a_new = random.randint(0, r_out - 1)\n                congr_dict[r_out] = a_new\n        return congr_dict\n\n    def calc_D(log_m, log_boost, n_uncovered):\n        LN10 = 2.302585092994046\n        m_digits = log_m / LN10\n        ub = n_uncovered * math.exp(log_boost)\n        val = m_digits**2 + 4.0 * ub / (LN10 * LN10)\n        if val < 0:\n            val = 0.0\n        return 0.5 * (m_digits + math.sqrt(val))\n\n    best_congr_dict = congr_dict.copy()\n    n_res_curr = np.sum(cnt_array == 0)\n    best_D = calc_D(logm, logboost, n_res_curr)\n\n    # We run multiple internal steps of thermodynamic/probabilistic transition\n    # to significantly accelerate finding the optimal congruence cover.\n    num_internal_steps = 500\n    for _ in range(num_internal_steps):\n        # 0. Greedy Redundant Prime Drop\n        # If a prime covers no unique targets, dropping it is strictly beneficial.\n        redundant_found = True\n        while redundant_found:\n            redundant_found = False\n            cnt_1_mask = (cnt_array == 1)\n            targets_1 = targets[cnt_1_mask]\n            for r, a in list(congr_dict.items()):\n                if not np.any((targets_1 % r) == a):\n                    cnt_array -= (targets % r) == a\n                    logm -= math.log(r)\n                    logboost -= math.log(r / (r - 1))\n                    del congr_dict[r]\n                    redundant_found = True\n                    break  # Re-evaluate mask as other primes might now be uniquely covering\n        \n        n_res_curr = np.sum(cnt_array == 0)\n        D_curr = calc_D(logm, logboost, n_res_curr)\n        \n        # Explicit elitism tracking ensures returning optimal minimum\n        if D_curr < best_D:\n            best_D = D_curr\n            best_congr_dict = congr_dict.copy()\n            \n        moves = []  # list of (type, data, D_new)\n        moves.append((\'none\', None, D_curr))\n        \n        uncovered_targets = targets[cnt_array == 0]\n        cnt_1_mask = (cnt_array == 1)\n        \n        congr_items = list(congr_dict.items())\n        uniq_cov = []\n        if congr_items:\n            targets_1 = targets[cnt_1_mask]\n            uniq_cov = np.array([np.sum((targets_1 % r) == a) for r, a in congr_items])\n            drop_weights = 1.0 / (uniq_cov + 0.1)\n            drop_weights /= np.sum(drop_weights)\n        else:\n            targets_1 = np.array([], dtype=np.int64)\n            uniq_cov = np.array([])\n            drop_weights = np.array([])\n        \n        # 1. Propose ADD moves\n        cand_pool = [m for m in cand_mods if m not in congr_dict]\n        if cand_pool:\n            cand_pool_arr = np.array(cand_pool, dtype=np.int64)\n            # Bias selection towards smaller moduli using 1.0 / r weights\n            r_weights = 1.0 / cand_pool_arr\n            r_weights /= np.sum(r_weights)\n            \n            sample_size = min(60, len(cand_pool))\n            sampled_adds = np.random.choice(cand_pool_arr, size=sample_size, replace=False, p=r_weights)\n            \n            if len(uncovered_targets) > 0:\n                for r in sampled_adds:\n                    counts = np.bincount(uncovered_targets % r, minlength=r)\n                    a_best = int(np.argmax(counts))\n                    num_covered = counts[a_best]\n                    \n                    n_res_new = n_res_curr - num_covered\n                    logm_new = logm + math.log(r)\n                    logboost_new = logboost + math.log(r / (r - 1))\n                    D_new = calc_D(logm_new, logboost_new, n_res_new)\n                    moves.append((\'add\', (r, a_best), D_new))\n            else:\n                for r in sampled_adds:\n                    logm_new = logm + math.log(r)\n                    logboost_new = logboost + math.log(r / (r - 1))\n                    D_new = calc_D(logm_new, logboost_new, 0)\n                    moves.append((\'add\', (r, 0), D_new))\n                    \n        # 2. Propose OPTIMIZE moves\n        if congr_items:\n            n_opt = min(40, len(congr_items))\n            opt_indices = np.random.choice(len(congr_items), size=n_opt, replace=False)\n            for idx in opt_indices:\n                r, a_old = congr_items[idx]\n                \n                uniquely_covered = targets_1[(targets_1 % r) == a_old]\n                if len(uniquely_covered) > 0:\n                    uncovered_bg = np.concatenate([uncovered_targets, uniquely_covered])\n                else:\n                    uncovered_bg = uncovered_targets\n                    \n                if len(uncovered_bg) > 0:\n                    counts = np.bincount(uncovered_bg % r, minlength=r)\n                    a_new = int(np.argmax(counts))\n                    num_covered = counts[a_new]\n                    n_res_new = len(uncovered_bg) - num_covered\n                else:\n                    a_new = 0\n                    n_res_new = 0\n                    \n                if a_new != a_old:\n                    D_new = calc_D(logm, logboost, n_res_new)\n                    moves.append((\'optimize\', (r, a_new), D_new))\n                \n        # 3. Propose DROP moves\n        if congr_items:\n            n_drop = min(40, len(congr_items))\n            drop_indices = np.random.choice(len(congr_items), size=n_drop, replace=False, p=drop_weights)\n            for idx in drop_indices:\n                r, a_old = congr_items[idx]\n                # Fast computation: newly uncovered targets exactly equal to unique covers of this prime\n                n_res_new = n_res_curr + uniq_cov[idx]\n                logm_new = logm - math.log(r)\n                logboost_new = logboost - math.log(r / (r - 1))\n                D_new = calc_D(logm_new, logboost_new, n_res_new)\n                moves.append((\'drop\', (r, a_old), D_new))\n\n        # 4. Propose SWAP moves (Swap an existing prime out for a new one)\n        if congr_items and cand_pool:\n            n_swaps = min(60, len(congr_items) * len(cand_pool))\n            swap_adds = np.random.choice(cand_pool_arr, size=n_swaps, replace=True, p=r_weights)\n            swap_drops_idx = np.random.choice(len(congr_items), size=n_swaps, replace=True, p=drop_weights)\n            \n            swap_pairs = list(set(zip(swap_drops_idx, swap_adds)))\n            for idx_d, r_a in swap_pairs[:60]:\n                r_d, a_old = congr_items[idx_d]\n                r_d = int(r_d)\n                r_a = int(r_a)\n                \n                uniquely_covered = targets_1[(targets_1 % r_d) == a_old]\n                if len(uniquely_covered) > 0:\n                    uncovered_bg = np.concatenate([uncovered_targets, uniquely_covered])\n                else:\n                    uncovered_bg = uncovered_targets\n                \n                if len(uncovered_bg) > 0:\n                    counts = np.bincount(uncovered_bg % r_a, minlength=r_a)\n                    a_new = int(np.argmax(counts))\n                    num_covered = counts[a_new]\n                    n_res_new = len(uncovered_bg) - num_covered\n                else:\n                    a_new = 0\n                    n_res_new = 0\n                    \n                logm_new = logm - math.log(r_d) + math.log(r_a)\n                logboost_new = logboost - math.log(r_d / (r_d - 1)) + math.log(r_a / (r_a - 1))\n                D_new = calc_D(logm_new, logboost_new, n_res_new)\n                moves.append((\'swap\', (r_d, r_a, a_new), D_new))\n            \n        if len(moves) == 1:\n            break\n            \n        # Select move using Gibbs/Boltzmann distribution over the objective values\n        scores = np.array([-m[2] for m in moves])\n        temp = max(t_temp, 1e-4)\n        scaled_scores = scores / temp\n        scaled_scores -= np.max(scaled_scores)\n        probs = np.exp(scaled_scores)\n        probs /= np.sum(probs)\n        \n        idx = np.random.choice(len(moves), p=probs)\n        chosen_move = moves[idx]\n        \n        # Apply chosen move\n        m_type, m_data, D_new = chosen_move\n        \n        if m_type == \'add\':\n            r, a = m_data\n            r = int(r); a = int(a)\n            congr_dict[r] = a\n            cnt_array += (targets % r) == a\n            logm += math.log(r)\n            logboost += math.log(r / (r - 1))\n        elif m_type == \'optimize\':\n            r, a = m_data\n            r = int(r); a = int(a)\n            a_old = congr_dict[r]\n            cnt_array -= (targets % r) == a_old\n            cnt_array += (targets % r) == a\n            congr_dict[r] = a\n        elif m_type == \'drop\':\n            r, a = m_data\n            r = int(r); a = int(a)\n            cnt_array -= (targets % r) == a\n            logm -= math.log(r)\n            logboost -= math.log(r / (r - 1))\n            del congr_dict[r]\n        elif m_type == \'swap\':\n            r_d, r_a, a_new = m_data\n            r_d = int(r_d); r_a = int(r_a); a_new = int(a_new)\n            a_old = congr_dict[r_d]\n            \n            cnt_array -= (targets % r_d) == a_old\n            logm -= math.log(r_d)\n            logboost -= math.log(r_d / (r_d - 1))\n            del congr_dict[r_d]\n            \n            congr_dict[r_a] = a_new\n            cnt_array += (targets % r_a) == a_new\n            logm += math.log(r_a)\n            logboost += math.log(r_a / (r_a - 1))\n\n        # Explicit elitism tracking ensures returning optimal minimum\n        if D_new < best_D:\n            best_D = D_new\n            best_congr_dict = congr_dict.copy()\n\n    # Update in place to best state found\n    congr_dict.clear()\n    congr_dict.update(best_congr_dict)\n    return congr_dict\n# EVOLVE-BLOCK-END\n\ndef evaluate(eval_inputs: Mapping[str, Any]) -> dict[str, float]:\n    """Run evaluation on the optimized step."""\n    # Let\'s say we maximize -n_digits_est (smaller estimated N-size)\n    # Using sympy/math to compute est digits\n    import sympy\n    import numpy as np\n    Q = 100003\n    targets = np.array(list(sympy.primerange(3, Q)), dtype=np.int64)\n    # Let\'s run the optimize_cover_step starting from empty cover for some iterations\n    congr_dict = {}\n    cand_mods = [int(r) for r in sympy.primerange(3, 8000)]\n    cnt_array = np.zeros(len(targets), dtype=np.int16)\n    logm = math.log(2)\n    logboost = math.log(2.0)\n    \n    for it in range(10):\n        t_temp = 0.8 * (0.02 / 0.8) ** (it / 10)\n        # Update cnt_array based on congr_dict\n        cnt_array = np.zeros(len(targets), dtype=np.int16)\n        logm = math.log(2)\n        logboost = math.log(2.0)\n        for r, a in congr_dict.items():\n            cnt_array += (targets % r) == a\n            logm += math.log(r)\n            logboost += math.log(r / (r - 1))\n            \n        congr_dict = optimize_cover_step(congr_dict, cand_mods, targets, cnt_array, logm, logboost, t_temp)\n        \n    # Recalculate final metrics\n    cnt_array = np.zeros(len(targets), dtype=np.int16)\n    logm = math.log(2)\n    logboost = math.log(2.0)\n    for r, a in congr_dict.items():\n        cnt_array += (targets % r) == a\n        logm += math.log(r)\n        logboost += math.log(r / (r - 1))\n        \n    n_res = int((cnt_array == 0).sum())\n    boost = math.exp(logboost)\n    m_digits = logm / math.log(10)\n    \n    ub = n_res * boost\n    LN10 = math.log(10)\n    D = (m_digits + math.sqrt(m_digits ** 2 + 4 * ub / (LN10 * LN10))) / 2\n    return {"neg_est_digits": -float(D)}\n'}]}, 'evaluation': {'scores': {'scores': [{'metric': 'neg_est_digits', 'score': -50.655006}]}}, 'parentPrograms': ['projects/799795028847/locations/global/collections/default_collection/engines/goldbach_1784979910032/sessions/7013217697778074030/alphaEvolveExperiments/15164875354338173448/alphaEvolvePrograms/18102573509735108916'], 'state': 'COMPLETED'}, {'name': 'projects/7