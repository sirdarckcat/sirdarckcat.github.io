e_sqrt))) / 2\n        \n        E_limit = 17.5\n        E_actual = ub / (D * LN10) if D > 0 else 0.0\n        lagrangian_penalty = 0.0\n        if E_actual > E_limit:\n            lagrangian_penalty = 10000.0 * (E_actual - E_limit) ** 2\n        return D + lagrangian_penalty\n\n    def optimize_all(congr, cnt):\n        keys = list(congr.keys())\n        random.shuffle(keys)\n        for r in keys:\n            a_old = congr[r]\n            rem = targets % r\n            is_cov = (rem == a_old)\n            # Remove contribution\n            cnt[is_cov] -= 1\n            # Find best a\n            uncovered = targets[cnt == 0]\n            if len(uncovered) > 0:\n                counts = np.bincount(uncovered % r, minlength=r)\n                a_new = int(np.argmax(counts))\n            else:\n                a_new = 0\n            # Add contribution back\n            if a_new != a_old:\n                cnt[rem == a_new] += 1\n                congr[r] = a_new\n            else:\n                cnt[is_cov] += 1\n\n    # Initial residue optimization\n    optimize_all(congr_dict, cnt_array)\n    n_res = int((cnt_array == 0).sum())\n    current_D = calc_D_val(n_res, logm, logboost)\n\n    base_temp = max(t_temp, 1e-4)\n    N_STEPS = 1200\n\n    for step in range(N_STEPS):\n        temp = base_temp * (0.95 ** (step / 50.0))\n        \n        # Periodically optimize all to stay on the local optimum manifold\n        if step > 0 and step % 150 == 0:\n            optimize_all(congr_dict, cnt_array)\n            n_res = int((cnt_array == 0).sum())\n            current_D = calc_D_val(n_res, logm, logboost)\n\n        # "Apocalyptic Supernova": Occasionally blast away the most bloated, useless prime\n        if temp > 0.05 and random.random() < 0.02 and len(congr_dict) > 10:\n            active = list(congr_dict.keys())\n            sample_active = random.sample(active, min(15, len(active)))\n            singly_covered = (cnt_array == 1)\n            worst_score = float(\'inf\')\n            worst_r = None\n            for r in sample_active:\n                a = congr_dict[r]\n                loss = np.sum(singly_covered & ((targets % r) == a))\n                score = loss / (math.log(r) + 1e-9)\n                if score < worst_score:\n                    worst_score = score\n                    worst_r = r\n            if worst_r is not None:\n                r_drop = worst_r\n                a_drop = congr_dict[r_drop]\n                cnt_array[(targets % r_drop) == a_drop] -= 1\n                del congr_dict[r_drop]\n                logm -= math.log(r_drop)\n                logboost -= math.log(r_drop / (r_drop - 1))\n                n_res = int((cnt_array == 0).sum())\n                current_D = calc_D_val(n_res, logm, logboost)\n                continue\n\n        action = random.choices([\'add\', \'drop\', \'swap\', \'optimize\'], weights=[0.25, 0.15, 0.45, 0.15], k=1)[0]\n\n        if action == \'add\':\n            cand_pool = [m for m in cand_mods if m not in congr_dict]\n            if cand_pool:\n                uncovered = targets[cnt_array == 0]\n                n_uncovered = len(uncovered)\n                \n                sampled = random.sample(cand_pool, min(150, len(cand_pool)))\n                best_new_D = float(\'inf\')\n                best_r = None\n                best_a = None\n                best_new_n_res = n_res\n                \n                for r in sampled:\n                    if n_uncovered > 0:\n                        counts = np.bincount(uncovered % r, minlength=r)\n                        a = int(np.argmax(counts))\n                        added_cov = counts[a]\n                    else:\n                        a = 0\n                        added_cov = 0\n                    \n                    new_n_res = n_uncovered - added_cov\n                    new_logm = logm + math.log(r)\n                    new_logboost = logboost + math.log(r / (r - 1))\n                    new_D = calc_D_val(new_n_res, new_logm, new_logboost)\n                    if new_D < best_new_D:\n                        best_new_D = new_D\n                        best_r = r\n                        best_a = a\n                        best_new_n_res = new_n_res\n                \n                if best_r is not None:\n                    delta = best_new_D - current_D\n                    if delta < 0 or random.random() < math.exp(-delta / temp):\n                        congr_dict[best_r] = best_a\n                        cnt_array[(targets % best_r) == best_a] += 1\n                        n_res = best_new_n_res\n                        logm += math.log(best_r)\n                        logboost += math.log(best_r / (best_r - 1))\n                        current_D = best_new_D\n\n        elif action == \'drop\':\n            active = list(congr_dict.keys())\n            if active:\n                sampled = random.sample(active, min(50, len(active)))\n                best_new_D = float(\'inf\')\n                best_r = None\n                best_new_n_res = n_res\n                \n                singly_covered = (cnt_array == 1)\n                for r in sampled:\n                    a = congr_dict[r]\n                    lost_cov = np.sum(singly_covered & ((targets % r) == a))\n                    new_n_res = n_res + lost_cov\n                    new_logm = logm - math.log(r)\n                    new_logboost = logboost - math.log(r / (r - 1))\n                    new_D = calc_D_val(new_n_res, new_logm, new_logboost)\n                    if new_D < best_new_D:\n                        best_new_D = new_D\n                        best_r = r\n                        best_new_n_res = new_n_res\n                \n                if best_r is not None:\n                    delta = best_new_D - current_D\n                    if delta < 0 or random.random() < math.exp(-delta / temp):\n                        r_drop = best_r\n                        a_drop = congr_dict[r_drop]\n                        cnt_array[(targets % r_drop) == a_drop] -= 1\n                        del congr_dict[r_drop]\n                        n_res = best_new_n_res\n                        logm -= math.log(r_drop)\n                        logboost -= math.log(r_drop / (r_drop - 1))\n                        current_D = best_new_D\n\n        elif action == \'swap\':\n            active = list(congr_dict.keys())\n            cand_pool = [m for m in cand_mods if m not in congr_dict]\n            if active and cand_pool:\n                # Sample 10 active primes\n                sample_active = random.sample(active, min(10, len(active)))\n                singly_covered = (cnt_array == 1)\n                best_swap_D = float(\'inf\')\n                best_r_drop = None\n                best_r_add = None\n                best_a_add = None\n                best_new_n_res = n_res\n                \n                # Evaluate and sort by loss/log(r) to find worst-performing active primes\n                scored_active = []\n                for r in sample_active:\n                    a = congr_dict[r]\n                    loss = np.sum(singly_covered & ((targets % r) == a))\n                    score = loss / (math.log(r) + 1e-9)\n                    scored_active.append((score, r, loss))\n                scored_active.sort()\n                \n                # Try dropping each of the 3 worst-performing active primes\n                for _, r_drop, loss in scored_active[:3]:\n                    a_drop = congr_dict[r_drop]\n                    is_cov = (targets % r_drop) == a_drop\n                    cnt_array[is_cov] -= 1\n                    \n                    uncovered = targets[cnt_array == 0]\n                    n_uncovered = len(uncovered)\n                    \n                    sampled_add = random.sample(cand_pool, min(100, len(cand_pool)))\n                    logm_temp = logm - math.log(r_drop)\n                    logboost_temp = logboost - math.log(r_drop / (r_drop - 1))\n                    \n                    for r in sampled_add:\n                        if n_uncovered > 0:\n                            counts = np.bincount(uncovered % r, minlength=r)\n                            a = int(np.argmax(counts))\n                            added_cov = counts[a]\n                        else:\n                            a = 0\n                            added_cov = 0\n                        \n                        new_n_res = n_uncovered - added_cov\n                        new_logm = logm_temp + math.log(r)\n                        new_logboost = logboost_temp + math.log(r / (r - 1))\n                        \n                        new_D = calc_D_val(new_n_res, new_logm, new_logboost)\n                        if new_D < best_swap_D:\n                            best_swap_D = new_D\n                            best_r_drop = r_drop\n                            best_r_add = r\n                            best_a_add = a\n                            best_new_n_res = new_n_res\n                    \n                    # Restore counts\n                    cnt_array[is_cov] += 1\n                \n                if best_r_drop is not None:\n                    delta = best_swap_D - current_D\n                    if delta < 0 or random.random() < math.exp(-delta / temp):\n                        r_drop = best_r_drop\n                        a_drop = congr_dict[r_drop]\n                        cnt_array[(targets % r_drop) == a_drop] -= 1\n                        del congr_dict[r_drop]\n                        \n                        r_add = best_r_add\n                        a_add = best_a_add\n                        congr_dict[r_add] = a_add\n                        cnt_array[(targets % r_add) == a_add] += 1\n                        \n                        logm += math.log(r_add) - math.log(r_drop)\n                        logboost += math.log(r_add / (r_add - 1)) - math.log(r_drop / (r_drop - 1))\n                        n_res = best_new_n_res\n                        current_D = best_swap_D\n\n        elif action == \'optimize\':\n            active = list(congr_dict.keys())\n            if active:\n                sampled = random.sample(active, min(15, len(active)))\n                for r in sampled:\n                    a_old = congr_dict[r]\n                    is_cov = (targets % r) == a_old\n                    cnt_array[is_cov] -= 1\n                    \n                    uncovered = targets[cnt_array == 0]\n                    if len(uncovered) > 0:\n                        counts = np.bincount(uncovered % r, minlength=r)\n                        a_new = int(np.argmax(counts))\n                    else:\n                        a_new = 0\n                    \n                    cnt_array[(targets % r) == a_new] += 1\n                    congr_dict[r] = a_new\n                \n                n_res = int((cnt_array == 0).sum())\n                current_D = calc_D_val(n_res, logm, logboost)\n\n    # Final cleanup to ensure absolute optimality of residues\n    optimize_all(congr_dict, cnt_array)\n    return congr_dict\n# EVOLVE-BLOCK-END\n\ndef evaluate(eval_inputs: Mapping[str, Any]) -> dict[str, float]:\n    """Run evaluation on the optimized step."""\n    import sympy\n    import numpy as np\n    Q = 100003\n    targets = np.array(list(sympy.primerange(3, Q)), dtype=np.int64)\n    \n    # Warm-start from the 195-digit record cover instead of starting empty\n    congr_dict = {int(r): int(a) for r, a in eval_inputs["warm_start_cover"]}\n    \n    cand_mods = [int(r) for r in sympy.primerange(3, 8000)]\n    cnt_array = np.zeros(len(targets), dtype=np.int16)\n    \n    # Pre-populate counts\n    for r, a in congr_dict.items():\n        cnt_array += (targets % r) == a\n        \n    for it in range(10):\n        t_temp = 0.8 * (0.02 / 0.8) ** (it / 10)\n        # Recalculate cnt_array based on congr_dict\n        cnt_array = np.zeros(len(targets), dtype=np.int16)\n        logm = math.log(2)\n        logboost = math.log(2.0)\n        for r, a in congr_dict.items():\n            cnt_array += (targets % r) == a\n            logm += math.log(r)\n            logboost += math.log(r / (r - 1))\n            \n        congr_dict = optimize_cover_step(congr_dict, cand_mods, targets, cnt_array, logm, logboost, t_temp)\n        \n    # Recalculate final metrics\n    cnt_array = np.zeros(len(targets), dtype=np.int16)\n    logm = math.log(2)\n    logboost = math.log(2.0)\n    for r, a in congr_dict.items():\n        cnt_array += (targets % r) == a\n        logm += math.log(r)\n        logboost += math.log(r / (r - 1))\n        \n    n_res = int((cnt_array == 0).sum())\n    boost = math.exp(logboost)\n    m_digits = logm / math.log(10)\n    \n    ub = n_res * boost\n    LN10 = math.log(10)\n    D = (m_digits + math.sqrt(m_digits ** 2 + 4 * ub / (LN10 * LN10))) / 2\n    \n    # Constrain E <= 17.5 via Lagrangian penalty to prevent reward hacking\n    E_limit = 17.5\n    E_actual = ub / (D * LN10) if D > 0 else 0.0\n    lagrangian_penalty = 0.0\n    if E_actual > E_limit:\n        lagrangian_penalty = 100.0 * (E_actual - E_limit) ** 2\n        \n    score_headline = -float(D + lagrangian_penalty)\n    \n    # Expose E, |U|, digits(M) as negated secondary metrics for joint optimization visibility\n    return {\n        "neg_est_digits": score_headline,\n        "neg_E": -float(E_actual),\n        "neg_residual_count": -float(n_res),\n        "neg_m_digits": -float(m_digits)\n    }\n'}]}, 'evaluation': {'scores': {'scores': [{'metric': 'neg_est_digits', 'score': -204.34642}, {'metric': 'neg_E', 'score': -17.500477}, {'metric': 'neg_residual_count', 'score': -806}, {'metric': 'neg_m_digits', 'score': -196.74605}]}, 'insights': {'insights': [{'label': 'Evaluation Metrics', 'text': 'Estimated Digits: 204.3464 (constrained), E: 17.5005, |U|: 806, digits(M): 196.75'}]}}, 'parentPrograms': ['projects/799795028847/locations/global/collections/