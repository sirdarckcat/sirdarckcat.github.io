 (r_drop - 1)) + math.log(r_add / (r_add - 1))\n                new_D = calc_D(new_logm, new_n_res * math.exp(new_logboost))\n                \n                if new_D < u_current_D or random.random() < math.exp((u_current_D - new_D) / max(t_temp, 1e-9)):\n                    del u_congr[r_drop]\n                    u_congr[r_add] = a_add\n                    u_cnt += (targets % r_add) == a_add\n                    u_logm, u_logboost, u_current_D, u_n_res = new_logm, new_logboost, new_D, new_n_res\n                else:\n                    u_cnt += drop_mask\n\n            elif action == \'target_add\':\n                uncovered_targets = targets[u_cnt == 0]\n                if len(uncovered_targets) == 0:\n                    continue\n                t_stub = int(random.choice(uncovered_targets))\n                \n                best_r, best_a, best_cov, best_D = None, None, 0, u_current_D\n                cand_samp = random.sample(cand_mods, min(3, len(cand_mods)))\n                for r in cand_samp:\n                    if r in u_congr: continue\n                    a = t_stub % r\n                    cov = int(np.sum((uncovered_targets % r) == a))\n                    test_n_res = u_n_res - cov\n                    test_logm = u_logm + math.log(r)\n                    test_logboost = u_logboost + math.log(r / (r - 1))\n                    test_D = calc_D(test_logm, test_n_res * math.exp(test_logboost))\n                    if best_r is None or test_D < best_D:\n                        best_r, best_a, best_cov, best_D = r, a, cov, test_D\n                        \n                if best_r is not None:\n                    new_n_res = u_n_res - best_cov\n                    new_logm = u_logm + math.log(best_r)\n                    new_logboost = u_logboost + math.log(best_r / (best_r - 1))\n                    if best_D < u_current_D or random.random() < math.exp((u_current_D - best_D) / max(t_temp, 1e-9)):\n                        u_congr[best_r] = best_a