urrent_D, n_res])\n\n    internal_steps = 1200\n\n    for step in range(internal_steps):\n        for idx in range(num_replicas):\n            r_dict, r_cnt, r_lm, r_lb, r_D, r_n = replicas[idx]\n            temp = temperatures[idx]\n\n            action = random.choice([\'add\', \'drop\', \'optimize\'])\n            if not r_dict:\n                action = \'add\'\n\n            if action == \'add\':\n                # Tournament selection for adding to make it ultra-aggressive\n                best_r = None\n                best_a = None\n                best_max_covered = -1\n                \n                # Sample 3 random candidates and pick the one covering the most\n                for _ in range(3):\n                    cand = random.choice(cand_mods)\n                    if cand in r_dict:\n                        continue\n                    uncovered_targets = targets[r_cnt == 0]\n                    if len(uncovered_targets) > 0:\n                        counts = np.bincount(uncovered_targets % cand, minlength=cand)\n                        a_cand = int(np.argmax(counts))\n                        max_cov = counts[a_cand]\n                    else:\n                        a_cand, max_cov = 0, 0\n                    \n                    if max_cov > best_max_covered:\n                        best_max_covered, best_r, best_a = max_cov, cand, a_cand\n\n                if best_r is not None:\n                    new_n_res = r_n - best_max_covered\n                    new_logm = r_lm + math.log(best_r)\n                    new_logboost = r_lb + math.log(best_r / (best_r - 1))\n                    new_ub = new_n_res * math.exp(new_logboost)\n                    new_D = calc_D(new_logm, new_ub)\n                    \n                    if new_D < r_D or random.random() < math.exp((r_D - new_D) / temp):\n                        r_dict[best_r] = best_a\n                        r_cnt += (targets % best_r) == best_a\n                        replicas[idx][2:6] = [new_logm, new_logboost, new_D, new_n_res]\n\n            elif action == \'drop\':\n                r = random.choice(list(r_dict.keys()))\n                a_drop = r_dict[r]\n                \n                mask = (targets % r) == a_drop\n                num_only_r = np.sum((r_cnt == 1) & mask)\n                \n                new_n_res = r_n + num_only_r\n                new_logm = r_lm - math.log(r)\n                new_logboost = r_lb - math.log(r / (r - 1))\n                new_ub = new_n_res * math.exp(new_logboost)\n                new_D = calc_D(new_logm, new_ub)\n                \n                if new_D < r_D or random.random() < math.exp((r_D - new_D) / temp):\n                    del r_dict[r]\n                    r_cnt -= mask\n                    replicas[idx][2:6] = [new_logm, new_logboost, new_D, new_n_res]\n\n            elif action == \'optimize\':\n                r = random.choice(list(r_dict.keys()))\n                a_old = r_dict[r]\n                \n                mask = (targets % r) == a_old\n                only_r_mask = (r_cnt == 1) & mask\n                uncovered_bg = targets[(r_cnt == 0) | only_r_mask]\n                \n                if len(uncovered_bg) > 0:\n                    counts = np.bincount(uncovered_bg % r, minlength=r)\n                    a_new = int(np.argmax(counts))\n                    max_covered = counts[a_new]\n                else:\n                    a_new = 0\n                    max_covered = 0\n                    \n                if a_new != a_old:\n                    new_n_res = r_n + np.sum(only_r_mask) - max_covered\n                    new_ub = new_n_res * math.exp(r_lb)\n                    new_D = calc_D(r_lm, new_ub)\n                    \n                    if new_D < r_D or random.random() < math.exp((r_D - new_D) / temp):\n                        r_dict[r] = a_new\n                        r_cnt -= mask\n                        r_cnt += (targets % r) == a_new\n                        replicas[idx][4:6] = [new_D, new_n_res]\n\n        # Quantum Replica Exchange: Swap parallel universes to escape local minima\n        if step > 0 and step % 20 == 0:\n            for idx in range(num_replicas - 1):\n                D1 = replicas[idx][4]\n                D2 = replicas[idx+1][4]\n                T1 = temperatures[idx]\n                T2 = temperatures[idx+1]\n                \n                # Exchange probability based on thermodynamic Detailed Balance\n                delta = (D1 - D2) * (1.0 / T1 - 1.0 / T2)\n                \n                if delta >= 0 or random.random() < math.exp(max(-100.0, delta)):\n                    replicas[idx], replicas[idx+1] = replicas[idx+1], replicas[idx]\n\n    # Return the configuration from the best replica\n    best_replica = min(replicas, key=lambda rep: rep[4])\n    \n    # Safely update the original dictionary and array to reflect best replica\n    congr_dict.clear()\n    congr_dict.update(best_replica[0])\n    cnt_array[:] = best_replica[1][:]\n\n    return congr_dict\n# EVOLVE-BLOCK-END\n\ndef evaluate(eval_inputs: Mapping[str, Any]) -> dict[str, float]:\n    """Run evaluation on the optimized step."""\n    # Let\'s say we maximize -n_digits_est (smaller estimated N-size)\n    # Using sympy/math to compute est digits\n    import sympy\n    import numpy as np\n    Q = 100003\n    targets = np.array(list(sympy.primerange(3, Q)), dtype=np.int64)\n    # Let\'s run the optimize_cover_step starting from empty cover for some iterations\n    congr_dict = {}\n    cand_mods = [int(r) for r in sympy.primerange(3, 8000)]\n    cnt_array = np.zeros(len(targets), dtype=np.int16)\n    logm = math.log(2)\n    logboost = math.log(2.0)\n    \n    for it in range(10):\n        t_temp = 0.8 * (0.02 / 0.8) ** (it / 10)\n        # Update cnt_array based on congr_dict\n        cnt_array = np.zeros(len(targets), dtype=np.int16)\n        logm = math.log(2)\n        logboost = math.log(2.0)\n        for r, a in congr_dict.items():\n            cnt_array += (targets % r) == a\n            logm += math.log(r)\n            logboost += math.log(r / (r - 1))\n            \n        congr_dict = optimize_cover_step(congr_dict, cand_mods, targets, cnt_array, logm, logboost, t_temp)\n        \n    # Recalculate final metrics\n    cnt_array = np.zeros(len(targets), dtype=np.int16)\n    logm = math.log(2)\n    logboost = math.log(2.0)\n    for r, a in congr_dict.items():\n        cnt_array += (targets % r) == a\n        logm += math.log(r)\n        logboost += math.log(r / (r - 1))\n        \n    n_res = int((cnt_array == 0).sum())\n    boost = math.exp(logboost)\n    m_digits = logm / math.log(10)\n    \n    ub = n_res * boost\n    LN10 = math.log(10)\n    D = (m_digits + math.sqrt(m_digits ** 2 + 4 * ub / (LN10 * LN10))) / 2\n    return {"neg_est_digits": -float(D)}\n'}]}, 'evaluation': {'scores': {'scores': [{'metric': 'neg_est_digits', 'score': -50.655006}]}}, 'parentPrograms': ['projects/799795028847/locations/global/collections/default_collection/engines/goldbach_1784979910032/sessions/7013217697778074030/alphaEvolveExperiments/15164875354338173448/alphaEvolvePrograms/18102573509735108720'], 'state': 'COMPLETED'}, {'name': 'projects/799795028847/locations/global/collections/default_collection/engines/goldbach_1784979910032/sessions/7013217697778074030/alphaEvolveExperiments/15164875354338173448/alphaEvolvePrograms/18102573509735110350', 'createTime': '2026-07-25T20:19:32.963721Z', 'content': {'files': [{'path': 'program.py', 'content': '# Copyright 2026 Google LLC\nfrom typing import Any, Mapping\nimport math\nimport random\nimport numpy as np\n\n# EVOLVE-BLOCK-START\ndef optimize_cover_step(congr_dict, cand_mods, targets, cnt_array, logm, logboost, t_temp):\n    """Optimize congruence cover using multi-step exact simulated annealing logic."""\n    import numpy as np\n    import random\n    import math\n\n    def calc_D(m_val, ub_val):\n        LN10 = 2.302585092994046\n        m_dig = m_val / LN10\n        if ub_val >= 0:\n            return (m_dig + math.sqrt(m_dig**2 + 4 * ub_val / (LN10**2))) / 2\n        else:\n            dD_dub = 1.0 / max(1e-9, 2.0 * m_dig * (LN10**2))\n            return m_dig + ub_val * dD_dub\n\n    if len(targets) == 0:\n        return congr_dict\n\n    # Cast cnt_array to np.int64 to support safe accumulation\n    cnt_array = np.array(cnt_array, dtype=np.int64)\n\n    # Multi-step Simulated Annealing with add, drop, optimize, and replace moves.\n    # We increase steps and add \'replace\' to easily traverse equal-size covers.\n    internal_steps = 6000\n\n    n_res = int(np.sum(cnt_array == 0))\n    current_ub = n_res * math.exp(logboost)\n    current_D = calc_D(logm, current_ub)\n\n    for step in range(internal_steps):\n        if not congr_dict:\n            action = \'add\'\n        else:\n            p = random.random()\n            if p < 0.3:\n                action = \'add\'\n            elif p < 0.4:\n                action = \'drop\'\n            elif p < 0.7:\n                action = \'optimize\'\n            else:\n                action = \'replace\'\n\n        if action == \'add\':\n            best_new_D = float(\'inf\')\n            best_r, best_a, best_n_res, best_logm, best_logboost = None, None, None, None, None\n            uncovered_targets = targets[cnt_array == 0]\n            \n            for _ in range(2):\n                r = random.choice(cand_mods)\n                if r in congr_dict:\n                    continue\n                \n                if len(uncovered_targets) > 0:\n                    counts = np.bincount(uncovered_targets % r, minlength=r)\n                    a = int(np.argmax(counts))\n                    max_covered = counts[a]\n                else:\n                    a = 0\n                    max_covered = 0\n                    \n                new_n_res = n_res - max_covered\n                new_logm = logm + math.log(r)\n                new_logboost = logboost + math.log(r / (r - 1))\n                new_ub = new_n_res * math.exp(new_logboost)\n                new_D = calc_D(new_logm, new_ub)\n                \n                if new_D < best_new_D:\n                    best_new_D = new_D\n                    best_r, best_a, best_n_res, best_logm, best_logboost = r, a, new_n_res, new_logm, new_logboost\n            \n            if best_r is not None:\n                if best_new_D < current_D or random.random() < math.exp((current_D - best_new_D) / max(t_temp, 1e-9)):\n                    congr_dict[best_r] = best_a\n                    cnt_array += (targets % best_r) == best_a\n                    logm, logboost, current_D, n_res = best_logm, best_logboost, best_new_D, best_n_res\n\n        elif action == \'drop\':\n            r = random.choice(list(congr_dict.keys()))\n            a_drop = congr_dict[r]\n            \n            mask = (targets % r) == a_drop\n            cnt_array -= mask\n            new_n_res = int(np.sum(cnt_array == 0))\n            \n            new_logm = logm - math.log(r)\n            new_logboost = logboost - math.log(r / (r - 1))\n            new_ub = new_n_res * math.exp(new_logboost)\n            new_D = calc_D(new_logm, new_ub)\n            \n            if new_D < current_D or random.random() < math.exp((current_D - new_D) / max(t_temp, 1e-9)):\n                del congr_dict[r]\n                logm, logboost, current_D, n_res = new_logm, new_logboost, new_D, new_n_res\n            else:\n                cnt_array += mask\n\n        elif action == \'optimize\':\n            r = random.choice(list(congr_dict.keys()))\n            a_old = congr_dict[r]\n            \n            mask = (targets % r) == a_old\n            cnt_array -= mask\n            uncovered_bg = targets[cnt_array == 0]\n            \n            if len(uncovered_bg) > 0:\n                counts = np.bincount(uncovered_bg % r, minlength=r)\n                a_new = int(np.argmax(counts))\n                max_covered = counts[a_new]\n            else:\n                a_new = 0\n                max_covered = 0\n                \n            if a_new != a_old:\n                new_n_res = len(uncovered_bg) - max_covered\n                new_ub = new_n_res * math.exp(logboost)\n                new_D = calc_D(logm, new_ub)\n                \n                if new_D < current_D or random.random() < math.exp((current_D - new_D) / max(t_temp, 1e-9)):\n                    congr_dict[r] = a_new\n                    cnt_array += (targets % r) == a_new\n                    current_D, n_res = new_D, new_n_res\n                else:\n                    cnt_array += mask\n            else:\n                cnt_array += mask\n\n        elif action == \'replace\':\n            r_drop = random.choice(list(congr_dict.keys()))\n            a_drop = congr_dict[r_drop]\n            \n            mask_drop = (targets % r_drop) == a_drop\n            cnt_array -= mask_drop\n            \n            uncovered_targets = targets[cnt_array == 0]\n            \n            best_new_D = float(\'inf\')\n            best_r, best_a, best_n_res, best_logm, best_logboost = None, None, None, None, None\n            \n            for _ in range(2):\n                r_add = random.choice(cand_mods)\n                if r_add in congr_dict or r_add == r_drop:\n                    continue\n                    \n                if len(uncovered_targets) > 0:\n                    counts = np.bincount(uncovered_targets % r_add, minlength=r_add)\n                    a_add = int(np.argmax(counts))\n                    max_covered = counts[a_add]\n                else:\n                    a_add = 0\n                    max_covered = 0\n                    \n                new_n_res = len(uncovered_targets) - max_covered\n                new_logm = logm - math.log(r_drop) + math.log(r_add)\n                new_logboost = logboost - math.log(r_drop / (r_drop - 1)) + math.log(r_add / (r_add - 1))\n                new_ub = new_n_res * math.exp(new_logboost)\n                new_D = calc_D(new_logm, new_ub)\n                \n                if new_D < best_new_D:\n                    best_new_D = new_D\n                    best_r, best_a, best_n_res, best_logm, best_logboost = r_add, a_add, new_n_res, new_logm, new_logboost\n\n            if best_r is not None:\n                if best_new_D < current_D or random.random() < math.exp((current_D - best_new_D) / max(t_temp, 1e-9)):\n                    del congr_dict[r_drop]\n                    congr_dict[best_r] = best_a\n                    cnt_array += (targets % best_r) == best_a\n                    logm, logboost, current_D, n_res = best_logm, best_logboost, best_new_D, best_n_res\n                else:\n                    cnt_array += mask_drop\n            else:\n                cnt_array += mask_drop\n\n    return congr_dict\n# EVOLVE-BLOCK-END\n\ndef evaluate(eval_inputs: Mapping[str, Any]) -> dict[str, float]:\n    """Run evaluation on the optimized step."""\n    # Let\'s say we maximize -n_digits_est (smaller estimated N-size)\n    # Using sympy/math to compute est digits\n    import sympy\n    import numpy as np\n    Q = 100003\n    targets = np.array(list(sympy.primerange(3, Q)), dtype=np.int64)\n    # Let\'s run the optimize_cover_step starting from empty cover for some iterations\n    congr_dict = {}\n    cand_mods = [int(r) for r in sympy.primerange(3, 8000)]\n    cnt_array = np.zeros(len(targets), dtype=np.int16)\n    logm = math.log(2)\n    logboost = math.log(2.0)\n    \n    for it in range(10):\n        t_temp = 0.8 * (0.02 / 0.8) ** (it / 10)\n        # Update cnt_array based on congr_dict\n        cnt_array = np.zeros(len(targets), dtype=np.int16)\n        logm = math.log(2)\n        logboost = math.log(2.0)\n        for r, a in congr_dict.items():\n            cnt_array += (targets % r) == a\n            logm += math.log(r)\n            logboost += math.log(r / (r - 1))\n            \n        congr_dict = optimize_cover_step(congr_dict, cand_mods, targets, cnt_array, logm, logboost, t_temp)\n        \n    # Recalculate final metrics\n    cnt_array = np.zeros(len(targets), dtype=np.int16)\n    logm = math.log(2)\n    logboost = math.log(2.0)\n    for r, a in congr_dict.items():\n        cnt_array += (targets % r) == a\n        logm += math.log(r)\n        logboost += math.log(r / (r - 1))\n        \n    n_res = int((cnt_array == 0).sum())\n    boost = math.exp(logboost)\n    m_digits = logm / math.log(10)\n    \n    ub = n_res * boost\n    LN10 = math.log(10)\n    D = (m_digits + math.sqrt(m_digits ** 2 + 4 * ub / (LN10 * LN10))) / 2\n    return {"neg_est_digits": -float(D)}\n'}]}, 'evaluation': {'scores': {'scores': [{'metric': 'neg_est_digits', 'score': -50.655006}]}}, 'parentPrograms': ['projects/799795028847/locations/global/collections/default_collection/engines/goldbach_1784979910032/sessions/7013217697778074030/alphaEvolveExperiments/15164875354338173448/alphaEvolvePrograms/18102573509735108720'], 'state': 'COMPLETED'}, {'name': 'projects/799795028847/locations/global/collections/default_collection/engines/goldbach_1784979910032/sessions/7013217697778074030/alphaEvolveExperiments/15164875354338173448/alphaEvolvePrograms/18102573509735108651', 'createTime': '2026-07-25T20:19:00.296862Z', 'content': {'files': [{'path': 'program.py', 'content': '# Copyright 2026 Google LLC\nfrom typing import Any, Mapping\nimport math\nimport random\nimport numpy as np\n\n# EVOLVE-BLOCK-START\ndef optimize_cover_step(congr_dict, cand_mods, targets, cnt_array, logm, logboost, t_temp):\n    """Optimize a single step of congruence cover using simulated annealing style logic.\n\n    Args:\n        congr_dict: Dictionary of r -> a\n        cand_mods: List of prime candidates\n        targets: np.array of target primes\n        cnt_array: np.array of coverage counts\n        logm: current log of modulus M\n        logboost: current log of boost factor\n        t_temp: current temperature\n\n    Returns:\n        Updated congr_dict\n    """\n    import numpy as np\n    import random\n\n    if len(targets) == 0:\n        # Safety fallback\n        kind = random.random()\n        r_in = random.choice(list(congr_dict)) if congr_dict else None\n        if kind < 0.5 and r_in is not None:\n            a_old = congr_dict[r_in]\n            a_new = random.randint(0, r_in - 1)\n            if a_new != a_old:\n                congr_dict[r_in] = a_new\n        elif kind < 0.7 and r_in is not None:\n            del congr_dict[r_in]\n        else:\n            r_out = random.choice(cand_mods)\n            if r_out not in congr_dict:\n                a_new = random.randint(0, r_out - 1)\n                congr_dict[r_out] = a_new\n        return congr_dict\n\n    import math\n\n    # Persistent, self-cleaning cache of remainder arrays to avoid repeated modulo operations\n    if not hasattr(optimize_cover_step, "_last_targets_id") or optimize_cover_step._last_targets_id != id(targets):\n        optimize_cover_step._mod_cache = {}\n        optimize_cover_step._last_targets_id = id(targets)\n    cache = optimize_cover_step._mod_cache\n\n    def get_mod_array(r):\n        if r not in cache:\n            cache[r] = (targets % r).astype(np.int32)\n        return cache[r]\n\n    LN10 = math.log(10)\n    LN10_SQ = LN10 * LN10\n\n    def compute_D(lm, lb, nr):\n        m_d = lm / LN10\n        ub = nr * math.exp(lb)\n        return (m_d + math.sqrt(max(0.0, m_d**2 + 4 * ub / LN10_SQ))) / 2.0\n\n    cnt = cnt_array.copy()\n    current_logm = logm\n    current_logboost = logboost\n    n_res = int(np.sum(cnt == 0))\n    current_D = compute_D(current_logm, current_logboost, n_res)\n\n    best_overall_dict = congr_dict.copy()\n    best_overall_D = current_D\n\n    def biased_sample_add(population, k):\n        n = len(population)\n        if n <= k:\n            return population\n        indices = set()\n        while len(indices) < k:\n            idx = min(n - 1, int(n * (random.random() ** 1.8)))\n            indices.add(idx)\n        return [population[i] for i in sorted(indices)]\n\n    def biased_sample_drop(population, k):\n        n = len(population)\n        if n <= k:\n            return population\n        indices = set()\n        while len(indices) < k:\n            idx = min(n - 1, int(n * (1.0 - random.random() ** 1.8)))\n            indices.add(idx)\n        return [population[i] for i in sorted(indices)]\n\n    # Run a highly efficient internal simulated annealing search\n    steps = 1500\n    for step in range(steps):\n        frac = step / steps\n        temp = max(t_temp * (0.05 ** frac), 1e-6)\n\n        p_add = 0.45 * (1.0 - 0.5 * frac)\n        p_drop = 0.15 * (1.0 - 0.5 * frac)\n        \n        r_val = random.random()\n        \n        if r_val < p_add:\n            cand_pool = [m for m in cand_mods if m not in congr_dict]\n            if cand_pool:\n                sampled = biased_sample_add(cand_pool, min(40, len(cand_pool)))\n                best_r, best_a, best_D = None, None, float(\'inf\')\n                best_cov = 0\n                \n                uncovered = np.where(cnt == 0)[0]\n                for r in sampled:\n                    rem = get_mod_array(r)\n                    if len(uncovered) > 0:\n                        counts = np.bincount(rem[uncovered], minlength=r)\n                        a = int(np.argmax(counts))\n                        cov = int(counts[a])\n                    else:\n                        a, cov = 0, 0\n                        \n                    new_n_res = n_res - cov\n                    new_logm = current_logm + math.log(r)\n                    new_logboost = current_logboost + math.log(r / (r - 1.0))\n                    new_D = compute_D(new_logm, new_logboost, new_n_res)\n                    \n                    if new_D < best_D:\n                        best_D = new_D\n                        best_r = r\n                        best_a = a\n                        best_cov = cov\n                        \n                if best_r is not None:\n                    if best_D < current_D or random.random() < math.exp((current_D - best_D) / temp):\n                        congr_dict[best_r] = best_a\n                        rem = get_mod_array(best_r)\n                        cnt[rem == best_a] += 1\n                        current_logm += math.log(best_r)\n                        current_logboost += math.log(best_r / (best_r - 1.0))\n                        n_res -= best_cov\n                        current_D = best_D\n\n        elif r_val < p_add + p_drop:\n            if congr_dict:\n                sorted_keys = sorted(list(congr_dict.keys()))\n                sampled = biased_sample_drop(sorted_keys, min(30, len(sorted_keys)))\n                best_r, best_D = None, float(\'inf\')\n                best_revealed = 0\n                \n                for r in sampled:\n                    a = congr_dict[r]\n                    rem = get_mod_array(r)\n                    revealed = int(np.sum(cnt[rem == a] == 1))\n                    \n                    new_n_res = n_res + revealed\n                    new_logm = current_logm - math.log(r)\n                    new_logboost = current_logboost - math.log(r / (r - 1.0))\n                    new_D = compute_D(new_logm, new_logboost, new_n_res)\n                    \n                    if new_D < best_D:\n                        best_D = new_D\n                        best_r = r\n                        best_revealed = revealed\n                        \n                if best_r is not None:\n                    if best_D < current_D or random.random() < math.exp((current_D - best_D) / temp):\n                        a_drop = congr_dict[best_r]\n                        rem = get_mod_array(best_r)\n                        cnt[rem == a_drop] -= 1\n                        del congr_dict[best_r]\n                        current_logm -= math.log(best_r)\n                        current_logboost -= math.log(best_r / (best_r - 1.0))\n                        n_res += best_revealed\n                        current_D = best_D\n                        \n        else:\n            if congr_dict:\n                sampled = random.sample(list(congr_dict.keys()), min(20, len(congr_dict)))\n                best_r, best_a, best_D = None, None, float(\'inf\')\n                \n                for r in sampled:\n                    a_old = congr_dict[r]\n                    rem = get_mod_array(r)\n                    \n                    cnt[rem == a_old] -= 1\n                    uncovered = np.where(cnt == 0)[0]\n                    if len(uncovered) > 0:\n                        counts = np.bincount(rem[uncovered], minlength=r)\n                        counts[a_old] = -1  # Force strictly exploring a new congruence class\n                        a_new = int(np.argmax(counts))\n                        cov = int(counts[a_new])\n                    else:\n                        a_new, cov = 0, 0\n                        \n                    new_n_res = len(uncovered) - cov\n                    new_D = compute_D(current_logm, current_logboost, new_n_res)\n                    \n                    cnt[rem == a_old] += 1\n                    \n                    if new_D < best_D:\n                        best_D = new_D\n                        best_r = r\n                        best_a = a_new\n                        \n                if best_r is not None:\n                    if best_D < current_D or random.random() < math.exp((current_D - best_D) / temp):\n                        a_old = congr_dict[best_r]\n                        rem = get_mod_array(best_r)\n                        cnt[rem == a_old] -= 1\n                        cnt[rem == best_a] += 1\n                        congr_dict[best_r] = best_a\n                        n_res = int(np.sum(cnt == 0))\n                        current_D = best_D\n                        \n        if current_D < best_overall_D:\n            best_overall_D = current_D\n            best_overall_dict = congr_dict.copy()\n\n    return best_overall_dict\n\n    \'\'\'\n    # Dynamic action probabilities based on temperature\n    # At high temp, we explore (more add/drop). At low temp, we exploit (more optimize).\n    factor = np.clip(t_temp, 0.0, 1.0)\n    p_opt = 0.85 - 0.45 * factor\n    p_add = 0.10 + 0.25 * factor\n    p_drop = 0.05 + 0.20 * factor\n    total_p = p_opt + p_add + p_drop\n    p_opt /= total_p\n    p_add /= total_p\n    p_drop /= total_p\n\n    kind = random.random()\n    if not congr_dict:\n        action = \'add\'\n    else:\n        cand_pool = [m for m in cand_mods if m not in congr_dict]\n        if not cand_pool:\n            p_opt_cond = p_opt / (p_opt + p_drop)\n            action = \'optimize\' if kind < p_opt_cond else \'drop\'\n        else:\n            if kind < p_add:\n                action = \'add\'\n            elif kind < p_add + p_opt:\n                action = \'optimize\'\n            else:\n                action = \'drop\'\n\n    if action == \'add\':\n        cand_pool = [m for m in cand_mods if m not in congr_dict]\n        if cand_pool:\n            sample_size = min(100, len(cand_pool))\n            sampled_cands = random.sample(cand_pool, sample_size)\n            \n            n_res_curr = np.sum(cnt_array == 0)\n            weights_add = (cnt_array == 0).astype(np.float64)\n            \n            cands_data = []\n            energies = []\n            LN10 = np.log(10)\n            LN10_SQ = LN10 * LN10\n            \n            for r in sampled_cands:\n                rem = targets % r\n                counts = np.bincount(rem, weights=weights_add, minlength=r)\n                a = int(np.argmax(counts))\n                \n                n_res_new = n_res_curr - counts[a]\n                lm_new = logm + np.log(r)\n                lb_new = logboost + np.log(r / (r - 1.0))\n                \n                m_d = lm_new / LN10\n                ub = n_res_new * np.exp(lb_new)\n                D_new = (m_d + np.sqrt(m_d**2 + 4 * ub / LN10_SQ)) / 2.0\n                \n                energies.append(D_new)\n                cands_data.append((r, a))\n            \n            energies = np.array(energies)\n            temp = max(t_temp, 1e-4)\n            scaled = -energies / temp\n            scaled = scaled - np.max(scaled)\n            probs = np.exp(scaled)\n            probs_sum = np.sum(probs)\n            if probs_sum > 0:\n                probs /= probs_sum\n            else:\n                probs = np.ones(len(probs)) / len(probs)\n                \n            idx = np.random.choice(len(sampled_cands), p=probs)\n            best_cand, best_a = cands_data[idx]\n            congr_dict[best_cand] = int(best_a)\n\n    elif action == \'optimize\':\n        mods_in = list(congr_dict.keys())\n        if mods_in:\n            sample_size = min(10, len(mods_in))\n            sampled_mods = random.sample(mods_in, sample_size)\n            \n            all_energies = []\n            all_actions = []\n            \n            LN10 = np.log(10)\n            LN10_SQ = LN10 * LN10\n            m_d = logm / LN10\n            boost_val = np.exp(logboost)\n            \n            for r in sampled_mods:\n                a_old = congr_dict[r]\n                is_covered_by_r = (targets % r) == a_old\n                cnt_bg = cnt_array - is_covered_by_r\n                \n                weights_opt = (cnt_bg == 0).astype(np.float64)\n                counts = np.bincount(targets % r, weights=weights_opt, minlength=r)\n                \n                n_res_bg = np.sum(cnt_bg == 0)\n                n_res_new = n_res_bg - counts\n                \n                ub = n_res_new * boost_val\n                energies = (m_d + np.sqrt(m_d**2 + 4 * ub / LN10_SQ)) / 2.0\n                \n                for a_cand in range(r):\n                    all_energies.append(energies[a_cand])\n                    all_actions.append((r, a_cand))\n                    \n            all_energies = np.array(all_energies)\n            temp = max(t_temp, 1e-4)\n            scaled = -all_energies / temp\n            scaled = scaled - np.max(scaled)\n            probs = np.exp(scaled)\n            probs_sum = np.sum(probs)\n            if probs_sum > 0:\n                probs /= probs_sum\n            else:\n                probs = np.ones(len(probs)) / len(probs)\n                \n            idx = np.random.choice(len(all_actions), p=probs)\n            chosen_r, chosen_a = all_actions[idx]\n            congr_dict[chosen_r] = int(chosen_a)\n\n    elif action == \'drop\':\n        mods_in = list(congr_dict.keys())\n        if mods_in:\n            sample_size = min(100, len(mods_in))\n            sampled_mods = random.sample(mods_in, sample_size)\n            \n            n_res_curr = np.sum(cnt_array == 0)\n            weights_drop = (cnt_array == 1).astype(np.float64)\n            \n            energies = []\n            LN10 = np.log(10)\n            LN10_SQ = LN10 * LN10\n            \n            for r in sampled_mods:\n                a = congr_dict[r]\n                mask = (targets % r) == a\n                n_res_new = n_res_curr + np.sum(weights_drop[mask])\n                lm_new = logm - np.log(r)\n                lb_new = logboost - np.log(r / (r - 1.0))\n                \n                m_d = lm_new / LN10\n                ub = n_res_new * np.exp(lb_new)\n                D_new = (m_d + np.sqrt(m_d**2 + 4 * ub / LN10_SQ)) / 2.0\n                energies.append(D_new)\n                \n            energies = np.array(energies)\n            temp = max(t_temp, 1e-4)\n            scaled = -energies / temp\n            scaled = scaled - np.max(scaled)\n            probs = np.exp(scaled)\n            probs_sum = np.sum(probs)\n            if probs_sum > 0:\n                probs /= probs_sum\n            else:\n                probs = np.ones(len(probs)) / len(probs)\n                \n            idx = np.random.choice(len(sampled_mods), p=probs)\n            r_drop = sampled_mods[idx]\n            del congr_dict[r_drop]\n    \'\'\'\n\n    return congr_dict\n# EVOLVE-BLOCK-END\n\ndef evaluate(eval_inputs: Mapping[str, Any]) -> dict[str, float]:\n    """Run evaluation on the optimized step."""\n    # Let\'s say we maximize -n_digits_est (smaller estimated N-size)\n    # Using sympy/math to compute est digits\n    import sympy\n    import numpy as np\n    Q = 100003\n    targets = np.array(list(sympy.primerange(3, Q)), dtype=np.int64)\n    # Let\'s run the optimize_cover_step starting from empty cover for some iterations\n    congr_dict = {}\n    cand_mods = [int(r) for r in sympy.primerange(3, 8000)]\n    cnt_array = np.zeros(len(targets), dtype=np.int16)\n    logm = math.log(2)\n    logboost = math.log(2.0)\n    \n    for it in range(10):\n        t_temp = 0.8 * (0.02 / 0.8) ** (it / 10)\n        # Update cnt_array based on congr_dict\n        cnt_array = np.zeros(len(targets), dtype=np.int16)\n        logm = math.log(2)\n        logboost = math.log(2.0)\n        for r, a in congr_dict.items():\n            cnt_array += (targets % r) == a\n            logm += math.log(r)\n            logboost += math.log(r / (r - 1))\n            \n        congr_dict = optimize_cover_step(congr_dict, cand_mods, targets, cnt_array, logm, logboost, t_temp)\n        \n    # Recalculate final metrics\n    cnt_array = np.zeros(len(targets), dtype=np.int16)\n    logm = math.log(2)\n    logboost = math.log(2.0)\n    for r, a in congr_dict.items():\n        cnt_array += (targets % r) == a\n        logm += math.log(r)\n        logboost += math.log(r / (r - 1))\n        \n    n_res = int((cnt_array == 0).sum())\n    boost = math.exp(logboost)\n    m_digits = logm / math.log(10)\n    \n    ub = n_res * boost\n    LN10 = math.log(10)\n    D = (m_digits + math.sqrt(m_digits ** 2 + 4 * ub / (LN10 * LN10))) / 2\n    return {"neg_est_digits": -float(D)}\n'}]}, 'evaluation': {'scores': {'scores': [{'metric': 'neg_est_digits', 'score': -50.655006}]}}, 'parentPrograms': ['projects/799795028847/locations/global/collections/default_collection/engines/goldbach_1784979910032/sessions/7013217697778074030/alphaEvolveExperiments/15164875354338173448/alphaEvolvePrograms/18102573509735110994', 'projects/799795028847/locations/global/collections/default_collection/engines/goldbach_1784979910032/sessions/7013217697778074030/alphaEvolveExperiments/15164875354338173448/alphaEvolvePrograms/18102573509735112557', 'projects/799795028847/locations/global/collections/default_collection/engines/goldbach_1784979910032/sessions/7013217697778074030/alphaEvolveExperiments/15164875354338173448/alphaEvolvePrograms/18102573509735108844'], 'state': 'COMPLETED'}, {'name': 'projects/799795028847/locations/global/collections/default_collection/engines/goldbach_1784979910032/sessions/7013217697778074030/alphaEvolveExperiments/15164875354338173448/alphaEvolvePrograms/18102573509735111730', 'createTime': '2026-07-25T20:18:31.685024Z', 'content': {'files': [{'path': 'program.py', 'content': '# Copyright 2026 Google LLC\nfrom typing import Any, Mapping\nimport math\nimport random\nimport numpy as np\n\n# EVOLVE-BLOCK-START\ndef optimize_cover_step(congr_dict, cand_mods, targets, cnt_array, logm, logboost, t_temp):\n    """Optimize congruence cover using multi-step exact simulated annealing logic."""\n    import numpy as np\n    import random\n    import math\n\n    def calc_D(m_val, ub_val):\n        LN10 = 2.302585092994046\n        m_dig = m_val / LN10\n        if ub_val >= 0:\n            return (m_dig + math.sqrt(m_dig**2 + 4 * ub_val / (LN10**2))) / 2\n        else:\n            dD_dub = 1.0 / max(1e-9, 2.0 * m_dig * (LN10**2))\n            return m_dig + ub_val * dD_dub\n\n    if len(targets) == 0:\n        return congr_dict\n\n    # Cast cnt_array to np.int64 to support safe accumulation\n    cnt_array = np.array(cnt_array, dtype=np.int64)\n\n    # Evolutionary Simulated Annealing with Quantum Tunneling and Tournament Selection (ESA-QT)\n    # We evaluate a small batch of candidates for each move type (Scout/Predator)\n    # and include a \'swap\' move to tunnel through energy barriers.\n    internal_steps = 3000\n\n    n_res = int(np.sum(cnt_array == 0))\n    current_ub = n_res * math.exp(logboost)\n    current_D = calc_D(logm, current_ub)\n\n    for _ in range(internal_steps):\n        action = random.choice([\'add\', \'drop\', \'optimize\', \'swap\'])\n        if not congr_dict:\n            action = \'add\'\n\n        if action == \'add\':\n            best_new_D = float(\'inf\')\n            best_r = None; best_a = None; best_max_covered = None\n            \n            uncovered_targets = targets[cnt_array == 0]\n            sampled_rs = random.sample(cand_mods, min(3, len(cand_mods)))\n            \n            for r in sampled_rs:\n                if r in congr_dict: continue\n                if len(uncovered_targets) > 0:\n                    counts = np.bincount(uncovered_targets % r, minlength=r)\n                    a = int(np.argmax(counts))\n                    max_covered = counts[a]\n                else:\n                    a = 0; max_covered = 0\n                    \n                new_n_res = n_res - max_covered\n                new_logm = logm + math.log(r)\n                new_logboost = logboost + math.log(r / (r - 1))\n                new_ub = new_n_res * math.exp(new_logboost)\n                new_D_val = calc_D(new_logm, new_ub)\n                \n                if new_D_val < best_new_D:\n                    best_new_D = new_D_val\n                    best_r = r; best_a = a; best_max_covered = max_covered\n            \n            if best_r is not None:\n                new_D = best_new_D\n                new_n_res = n_res - best_max_covered\n                new_logm = logm + math.log(best_r)\n                new_logboost = logboost + math.log(best_r / (best_r - 1))\n                if new_D < current_D or random.random() < math.exp((current_D - new_D) / max(t_temp, 1e-9)):\n                    congr_dict[best_r] = best_a\n                    cnt_array += (targets % best_r) == best_a\n                    logm, logboost, current_D, n_res = new_logm, new_logboost, new_D, new_n_res\n\n        elif action == \'drop\':\n            best_new_D = float(\'inf\')\n            best_r = None; best_a_drop = None; best_mask = None; best_num_only_r = None\n            \n            sampled_rs = random.sample(list(congr_dict.keys()), min(3, len(congr_dict)))\n            for r in sampled_rs:\n                a_drop = congr_dict[r]\n                mask = (targets % r) == a_drop\n                num_only_r = np.sum((cnt_array == 1) & mask)\n                \n                new_n_res = n_res + num_only_r\n                new_logm_val = logm - math.log(r)\n                new_logboost_val = logboost - math.log(r / (r - 1))\n                new_ub = new_n_res * math.exp(new_logboost_val)\n                new_D_val = calc_D(new_logm_val, new_ub)\n                \n                if new_D_val < best_new_D:\n                    best_new_D = new_D_val\n                    best_r = r; best_a_drop = a_drop; best_mask = mask; best_num_only_r = num_only_r\n                    \n            if best_r is not None:\n                new_D = best_new_D\n                new_n_res = n_res + best_num_only_r\n                new_logm = logm - math.log(best_r)\n                new_logboost = logboost - math.log(best_r / (best_r - 1))\n                if new_D < current_D or random.random() < math.exp((current_D - new_D) / max(t_temp, 1e-9)):\n                    del congr_dict[best_r]\n                    cnt_array -= best_mask\n                    logm, logboost, current_D, n_res = new_logm, new_logboost, new_D, new_n_res\n\n        elif action == \'optimize\':\n            best_new_D = float(\'inf\')\n            best_r = None; best_a_old = None; best_a_new = None; best_mask = None; best_new_n_res = None\n            \n            sampled_rs = random.sample(list(congr_dict.keys()), min(3, len(congr_dict)))\n            for r in sampled_rs:\n                a_old = congr_dict[r]\n                mask = (targets % r) == a_old\n                only_r_mask = (cnt_array == 1) & mask\n                uncovered_bg = targets[(cnt_array == 0) | only_r_mask]\n                \n                if len(uncovered_bg) > 0:\n                    counts = np.bincount(uncovered_bg % r, minlength=r)\n                    a_new = int(np.argmax(counts))\n                    max_covered = counts[a_new]\n                else:\n                    a_new = 0; max_covered = 0\n                    \n                if a_new != a_old:\n                    new_n_res = n_res + np.sum(only_r_mask) - max_covered\n                    new_ub = new_n_res * math.exp(logboost)\n                    new_D_val = calc_D(logm, new_ub)\n                    \n                    if new_D_val < best_new_D:\n                        best_new_D = new_D_val\n                        best_r = r; best_a_old = a_old; best_a_new = a_new; best_mask = mask; best_new_n_res = new_n_res\n                        \n            if best_r is not None:\n                if best_new_D < current_D or random.random() < math.exp((current_D - best_new_D) / max(t_temp, 1e-9)):\n                    congr_dict[best_r] = best_a_new\n                    cnt_array -= best_mask\n                    cnt_array += (targets % best_r) == best_a_new\n                    current_D, n_res = best_new_D, best_new_n_res\n\n        elif action == \'swap\':\n            r_old = random.choice(list(congr_dict.keys()))\n            a_old = congr_dict[r_old]\n            \n            r_new = random.choice(cand_mods)\n            if r_new not in congr_dict:\n                mask_old = (targets % r_old) == a_old\n                temp_uncovered_mask = (cnt_array == 0) | ((cnt_array == 1) & mask_old)\n                uncovered_bg = targets[temp_uncovered_mask]\n                \n                if len(uncovered_bg) > 0:\n                    counts = np.bincount(uncovered_bg % r_new, minlength=r_new)\n                    a_new = int(np.argmax(counts))\n                    max_covered = counts[a_new]\n                else:\n                    a_new = 0; max_covered = 0\n                    \n                num_only_r_old = np.sum((cnt_array == 1) & mask_old)\n                new_n_res = n_res + num_only_r_old - max_covered\n                \n                new_logm = logm - math.log(r_old) + math.log(r_new)\n                new_logboost = logboost - math.log(r_old / (r_old - 1)) + math.log(r_new / (r_new - 1))\n                new_ub = new_n_res * math.exp(new_logboost)\n                new_D = calc_D(new_logm, new_ub)\n                \n                if new_D < current_D or random.random() < math.exp((current_D - new_D) / max(t_temp, 1e-9)):\n                    del congr_dict[r_old]\n                    cnt_array -= mask_old\n                    congr_dict[r_new] = a_new\n                    cnt_array += (targets % r_new) == a_new\n                    logm, logboost, current_D, n_res = new_logm, new_logboost, new_D, new_n_res\n\n    return congr_dict\n# EVOLVE-BLOCK-END\n\ndef evaluate(eval_inputs: Mapping[str, Any]) -> dict[str, float]:\n    """Run evaluation on the optimized step."""\n    # Let\'s say we maximize -n_digits_est (smaller estimated N-size)\n    # Using sympy/math to compute est digits\n    import sympy\n    import numpy as np\n    Q = 100003\n    targets = np.array(list(sympy.primerange(3, Q)), dtype=np.int64)\n    # Let\'s run the optimize_cover_step starting from empty cover for some iterations\n    congr_dict = {}\n    cand_mods = [int(r) for r in sympy.primerange(3, 8000)]\n    cnt_array = np.zeros(len(targets), dtype=np.int16)\n    logm = math.log(2)\n    logboost = math.log(2.0)\n    \n    for it in range(10):\n        t_temp = 0.8 * (0.02 / 0.8) ** (it / 10)\n