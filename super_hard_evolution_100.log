n        E_actual = ub / (D * LN10) if D > 0 else 0.0\n        lagrangian_penalty = 0.0\n        if E_actual > E_limit:\n            lagrangian_penalty = 1000.0 * (E_actual - E_limit) ** 2\n        return D + lagrangian_penalty\n\n    def optimize_all(congr, cnt):\n        keys = list(congr.keys())\n        random.shuffle(keys)\n        for r in keys:\n            a_old = congr[r]\n            is_cov = (targets % r) == a_old\n            cnt[is_cov] -= 1\n            uncovered = targets[cnt == 0]\n            if len(uncovered) > 0:\n                counts = np.bincount(uncovered % r, minlength=r)\n                a_new = int(np.argmax(counts))\n            else:\n                a_new = 0\n            if a_new != a_old:\n                cnt[(targets % r) == a_new] += 1\n                congr[r] = a_new\n            else:\n                cnt[is_cov] += 1\n\n    # Initial rank-1 block updates\n    optimize_all(congr_dict, cnt_array)\n    n_res = int((cnt_array == 0).sum())\n    current_D = calc_D_val(n_res, logm, logboost)\n\n    temp = max(t_temp, 1e-5)\n    N_STEPS = 600\n\n    for step in range(N_STEPS):\n        # Periodically realign all tensor components to stay on the local optimum manifold\n        if step > 0 and step % 100 == 0:\n            optimize_all(congr_dict, cnt_array)\n            n_res = int((cnt_array == 0).sum())\n            current_D = calc_D_val(n_res, logm, logboost)\n\n        # "Apocalyptic Supernova": blast away bloated primes to avoid poor local minima\n        if temp > 0.1 and random.random() < 0.05 and congr_dict:\n            active = list(congr_dict.keys())\n            sample_active = random.sample(active, min(10, len(active)))\n            worst_r = None\n            worst_score = float(\'inf\')\n            \n            for r in sample_active:\n                unique_cov = np.sum((cnt_array == 1) & ((targets % r) == congr_dict[r]))\n                score = unique_cov / (math.log(r) + 1e-9)\n                if score < worst_score:\n                    worst_score = score\n                    worst_r = r\n                    \n            if worst_r is not None:\n                r_drop = worst_r\n                a_drop = congr_dict[r_drop]\n                cnt_array[(targets % r_drop) == a_drop] -= 1\n                del congr_dict[r_drop]\n                n_res = int((cnt_array == 0).sum())\n                logm -= math.log(r_drop)\n                logboost -= math.log(r_drop / (r_drop - 1))\n                current_D = calc_D_val(n_res, logm, logboost)\n                continue\n\n        action = random.choices([\'add\', \'drop\', \'swap\', \'optimize\'], weights=[0.30, 0.15, 0.40, 0.15], k=1)[0]\n\n        if action == \'add\':\n            cand_pool = [m for m in cand_mods if m not in congr_dict]\n            if cand_pool:\n                uncovered_targets = targets[cnt_array == 0]\n                n_res_current = len(uncovered_targets)\n                \n                # Tensor matching pursuit step: sample candidates\n                sampled = random.sample(cand_pool, min(150, len(cand_pool)))\n                best_r = None\n                best_a = None\n                best_new_D = float(\'inf\')\n                best_new_n_res = n_res\n                \n                for r in sampled:\n                    if n_res_current > 0:\n                        counts = np.bincount(uncovered_targets % r, minlength=r)\n                        a = int(np.argmax(counts))\n                        added_cov = counts[a]\n                    else:\n                        a = 0\n                        added_cov = 0\n                    new_n_res = n_res - added_cov\n                    new_logm = logm + math.log(r)\n                    new_logboost = logboost + math.log(r / (r - 1))\n                    new_D = calc_D_val(new_n_res, new_logm, new_logboost)\n                    if new_D < best_new_D:\n                        best_new_D = new_D\n                        best_r = r\n                        best_a = a\n                        best_new_n_res = new_n_res\n                        \n                if best_r is not None:\n                    delta = best_new_D - current_D\n                    if delta < 0 or random.random() < math.exp(-delta / temp):\n                        congr_dict[best_r] = best_a\n                        cnt_array[targets % best_r == best_a] += 1\n                        n_res = best_new_n_res\n                        logm += math.log(best_r)\n                        logboost += math.log(best_r / (best_r - 1))\n                        current_D = best_new_D\n\n        elif action == \'drop\':\n            active = list(congr_dict.keys())\n            if active:\n                sampled = random.sample(active, min(50, len(active)))\n                best_r = None\n                best_new_D = float(\'inf\')\n                best_new_n_res = n_res\n                \n                singly_covered = (cnt_array == 1)\n                for r in sampled:\n                    a = congr_dict[r]\n                    lost_cov = np.sum(singly_covered & ((targets % r) == a))\n                    new_n_res = n_res + lost_cov\n                    new_logm = logm - math.log(r)\n                    new_logboost = logboost - math.log(r / (r - 1))\n                    new_D = calc_D_val(new_n_res, new_logm, new_logboost)\n                    if new_D < best_new_D:\n                        best_new_D = new_D\n                        best_r = r\n                        best_new_n_res = new_n_res\n                        \n                if best_r is not None:\n                    delta = best_new_D - current_D\n                    if delta < 0 or random.random() < math.exp(-delta / temp):\n                        r_drop = best_r\n                        a_drop = congr_dict[r_drop]\n                        cnt_array[targets % r_drop == a_drop] -= 1\n                        del congr_dict[r_drop]\n                        n_res = best_new_n_res\n 