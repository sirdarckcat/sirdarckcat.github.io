() ** power)))\n            attempts += 1\n        if len(res) < k:\n            rem = list(set(range(n)) - res)\n            res.update(random.sample(rem, k - len(res)))\n        return [population[i] for i in res]\n\n    def sample_high(population, k, power=1.8):\n        n = len(population)\n        if n <= k: return population\n        res = set()\n        attempts = 0\n        while len(res) < k and attempts < k * 10:\n            res.add(int(n * (1.0 - random.random() ** power)))\n            attempts += 1\n        if len(res) < k:\n            rem = list(set(range(n)) - res)\n            res.update(random.sample(rem, k - len(res)))\n        return [population[i] for i in res]\n\n    # Initialize local search state\n    cnt = cnt_array.copy()\n    current_logm = logm\n    current_logboost = logboost\n    uncovered_indices = np.where(cnt == 0)[0]\n    n_res = len(uncovered_indices)\n    current_D = compute_D(current_logm, current_logboost, n_res)\n\n    best_overall_dict = congr_dict.copy()\n    best_overall_D = current_D\n\n    # Run a highly efficient internal simulated annealing search of 3000 micro-steps\n    steps = 3000\n    for step in range(steps):\n        # Cool down the internal temperature\n        frac = step / steps\n        temp = max(t_temp * (0.10 ** frac), 1e-5)\n\n        # Dynamic action probabilities (exploration early, exploitation late)\n        p_add = 0.55 * (1.0 - 0.6 * frac)\n        p_drop = 0.15 * (1.0 - 0.5 * frac)\n        r_val = random.random()\n\n        if r_val < p_add:\n            # TRY ADD\n            cand_pool = [m for m in cand_mods if m not in congr_dict]\n            if cand_pool:\n                sampled = sample_low(cand_pool, min(40, len(cand_pool)))\n                best_r, best_a, best_D = None, None, float(\'inf\')\n                best_cov = 0\n\n                for r in sampled:\n                    rem = get_mod_array(r)\n                    counts = np.bincount(rem[uncovered_indices], minlength=r)\n                    a = int(np.argmax(counts))\n                    cov = int(counts[a])\n\n                    new_logm = current_logm + np.log(r)\n                    new_logboost = current_logboost + np.log(r / (r - 1.0))\n                    new_n_res = n_res - cov\n                    new_D = compute_D(new_logm, new_logboost, new_n_res)\n\n                    if new_D < best_D:\n                        best_D = new_D\n                        best_r = r\n                        best_a = a\n                        best_cov = cov\n\n                if best_r is not None:\n                    if best_D < current_D or random.random() < np.exp((current_D - best_D) / temp):\n                        congr_dict[best_r] = best_a\n                        rem = get_mod_array(best_r)\n                        cnt[rem == best_a] += 1\n                        current_logm += np.log(best_r)\n                        current_logboost += np.log(best_r / (best_r - 1.0))\n                        uncovered_indices = np.where(cnt == 0)[0]\n                        n_res = len(uncovered_indices)\n                        current_D = best_D\n\n        elif r_val < p_add + p_drop:\n            # TRY DROP\n            if congr_dict:\n                sorted_keys = sorted(list(congr_dict.keys()))\n                sampled = sample_high(sorted_keys, min(30, len(sorted_keys)))\n                best_r, best_D = None, float(\'inf\')\n                best_revealed = 0\n\n                for r in sampled:\n                    rem = get_mod_array(r)\n                    a = congr_dict[r]\n                    revealed = int(np.count_nonzero(cnt[rem == a] == 1))\n\n                    new_logm = current_logm - np.log(r)\n                    new_logboost = current_logboost - np.log(r / (r - 1.0))\n                    new_n_res = n_res + revealed\n                    new_D = compute_D(new_logm, new_logboost, new_n_res)\n\n                    if new_D < best_D:\n                        best_D = new_D\n                        best_r = r\n                        best_revealed = revealed\n\n                if best_r is not None:\n                    if best_D < current_D or random.random() < np.exp((current_D - best_D) / temp):\n                        a_drop = congr_dict[best_r]\n                        rem = get_mod_array(best_r)\n                        cnt[rem == a_drop] -= 1\n                        del congr_dict[best_r]\n                        current_logm -= np.log(best_r)\n                        current_logboost -= np.log(best_r / (best_r - 1.0))\n                        uncovered_indices = np.where(cnt == 0)[0]\n                        n_res = len(uncovered_indices)\n                        current_D = best_D\n\n        else:\n            # TRY SWAP / OPTIMIZE CONGRUENCE CLASSES\n            if congr_dict:\n                sorted_keys = sorted(list(congr_dict.keys()))\n                sampled = sample_high(sorted_keys, min(30, len(sorted_keys)))\n                best_r, best_a, best_D = None, None, float(\'inf\')\n\n                for r in sampled:\n                    rem = get_mod_array(r)\n                    a_old = congr_dict[r]\n\n                    revealed = int(np.count_nonzero(cnt[rem == a_old] == 1))\n                    counts = np.bincount(rem[uncovered_indices], minlength=r)\n                    counts[a_old] += revealed\n                    \n                    a_new = int(np.argmax(counts))\n                    cov = int(counts[a_new])\n\n                    new_n_res = n_res + revealed - cov\n                    new_D = compute_D(current_logm, current_logboost, new_n_res)\n\n                    if new_D < best_D:\n                        best_D = new_D\n                        best_r = r\n                        best_a = a_new\n\n                if best_r is not None:\n                    if best_D < current_D or random.random() < np.exp((current_D - best_D) / temp):\n                        a_old = congr_dict[best_r]\n                        rem = get_mod_array(best_r)\n\n                        cnt[rem == a_old] -= 1\n                        cnt[rem == best_a] += 1\n                        congr_dict[best_r] = best_a\n\n                        uncovered_indices = np.where(cnt == 0)[0]\n                        n_res = len(uncovered_indices)\n                        current_D = best_D\n\n        # Keep track of the elite overall configuration visited\n        if current_D < best_overall_D:\n            best_overall_D = current_D\n            best_overall_dict = congr_dict.copy()\n\n    return best_overall_dict\n# EVOLVE-BLOCK-END\n\ndef evaluate(eval_inputs: Mapping[str, Any]) -> dict[str, float]:\n    """Run evaluation on the optimized step."""\n    # Let\'s say we maximize -n_digits_est (smaller estimated N-size)\n    # Using sympy/math to compute est digits\n    import sympy\n    import numpy as np\n    Q = 100003\n    targets = np.array(list(sympy.primerange(3, Q)), dtype=np.int64)\n    # Let\'s run the optimize_cover_step starting from empty cover for some iterations\n    congr_dict = {}\n    cand_mods = [int(r) for r in sympy.primerange(3, 8000)]\n    cnt_array = np.zeros(len(targets), dtype=np.int16)\n    logm = math.log(2)\n    logboost = math.log(2.0)\n    \n    for it in range(10):\n        t_temp = 0.8 * (0.02 / 0.8) ** (it / 10)\n        # Update cnt_array based on congr_dict\n        cnt_array = np.zeros(len(targets), dtype=np.int16)\n        logm = math.log(2)\n        logboost = math.log(2.0)\n        for r, a in congr_dict.items():\n            cnt_array += (targets % r) == a\n            logm += math.log(r)\n            logboost += math.log(r / (r - 1))\n            \n        congr_dict = optimize_cover_step(congr_dict, cand_mods, targets, cnt_array, logm, logboost, t_temp)\n        \n    # Recalculate final metrics\n    cnt_array = np.zeros(len(targets), dtype=np.int16)\n    logm = math.log(2)\n    logboost = math.log(2.0)\n    for r, a in congr_dict.items():\n        cnt_array += (targets % r) == a\n        logm += math.log(r)\n        logboost += math.log(r / (r - 1))\n        \n    n_res = int((cnt_array == 0).sum())\n    boost = math.exp(logboost)\n    m_digits = logm / math.log(10)\n    \n    ub = n_res * boost\n    LN10 = math.log(10)\n    D = (m_digits + math.sqrt(m_digits ** 2 + 4 * ub / (LN10 * LN10))) / 2\n    return {"neg_est_digits": -float(D)}\n'}]}, 'evaluation': {'scores': {'scores': [{'metric': 'neg_est_digits', 'score': -50.655006}]}}, 'parentPrograms': ['projects/799795028847/locations/global/collections/default_collection/engines/goldbach_1784979910032/sessions/7013217697778074030/alphaEvolveExperiments/15164875354338173448/alphaEvolvePrograms/18102573509735108844', 'projects/799795028847/locations/global/collections/default_collection/engines/goldbach_1784979910032/sessions/7013217697778074030/alphaEvolveExperiments/15164875354338173448/alphaEvolvePrograms/18102573509735112557', 'projects/799795028847/locations/global/collections/default_collection/engines/goldbach_1784979910032/sessions/7013217697778074030/alphaEvolveExperiments/15164875354338173448/alphaEvolvePrograms/18102573509735109406'], 'state': 'COMPLETED'}, {'name': 'projects/799795028847/locations/global/collections/default_collection/engines/goldbach_1784979910032/sessions/7013217697778074030/alphaEvolveExperiments/15164875354338173448/alphaEvolvePrograms/18102573509735111089', 'createTime': '2026-07-25T19:47:39.024830Z', 'content': {'files': [{'path': 'program.py', 'content': '# Copyright 2026 Google LLC\nfrom typing import Any, Mapping\nimport math\nimport random\nimport numpy as np\n\n# EVOLVE-BLOCK-START\ndef optimize_cover_step(congr_dict, cand_mods, targets, cnt_array, logm, logboost, t_temp):\n    """Optimize congruence cover using multi-step exact simulated annealing logic."""\n    import numpy as np\n    import random\n    import math\n\n    def calc_D(m_val, ub_val):\n        LN10 = 2.302585092994046\n        m_dig = m_val / LN10\n        if ub_val >= 0:\n            return (m_dig + math.sqrt(m_dig**2 + 4 * ub_val / (LN10**2))) / 2\n        else:\n            dD_dub = 1.0 / max(1e-9, 2.0 * m_dig * (LN10**2))\n            return m_dig + ub_val * dD_dub\n\n    if len(targets) == 0:\n        return congr_dict\n\n    # Cast cnt_array to np.int64 to support safe accumulation\n    cnt_array = np.array(cnt_array, dtype=np.int64)\n\n    # Perform multiple internal steps per call to maximize convergence rate\n    internal_steps = 150\n\n    for _ in range(internal_steps):\n        n_res = int(np.sum(cnt_array == 0))\n        current_ub = n_res * math.exp(logboost)\n        current_D = calc_D(logm, current_ub)\n\n        candidates = []\n        # 1. Option: stay (no-op)\n        candidates.append((\'stay\', None, current_D, logm, logboost))\n\n        # 2. Option: add\n        cand_pool = sorted([m for m in cand_mods if m not in congr_dict])\n        if cand_pool:\n            num_small = min(40, len(cand_pool))\n            small_cands = cand_pool[:num_small]\n            remaining = cand_pool[num_small:]\n            num_random = min(80, len(remaining))\n            random_cands = random.sample(remaining, num_random) if remaining else []\n            sampled_cands = small_cands + random_cands\n\n            uncovered_targets = targets[cnt_array == 0]\n            for r in sampled_cands:\n                if len(uncovered_targets) > 0:\n                    counts = np.bincount(uncovered_targets % r, minlength=r)\n                    top_a_indices = np.argsort(counts)[-2:]\n                else:\n                    top_a_indices = [0]\n\n                for a in top_a_indices:\n                    a = int(a)\n                    max_covered = counts[a] if len(uncovered_targets) > 0 else 0\n                    new_n_res = n_res - max_covered\n                    new_logm = logm + math.log(r)\n                    new_logboost = logboost + math.log(r / (r - 1))\n                    new_ub = new_n_res * math.exp(new_logboost)\n                    new_D = calc_D(new_logm, new_ub)\n                    candidates.append((\'add\', (r, a), new_D, new_logm, new_logboost))\n\n        # 3. Options: optimize and drop\n        if congr_dict:\n            cnt_array_eq_1 = (cnt_array == 1)\n            for r, a_old in congr_dict.items():\n                # Optimize\n                only_r_mask = cnt_array_eq_1 & (targets % r == a_old)\n                uncovered_bg = targets[(cnt_array == 0) | only_r_mask]\n                \n                if len(uncovered_bg) > 0:\n                    counts = np.bincount(uncovered_bg % r, minlength=r)\n                    top_a_indices = np.argsort(counts)[-2:]\n                else:\n                    top_a_indices = [0]\n\n                for a_new in top_a_indices:\n                    a_new = int(a_new)\n                    max_covered = counts[a_new] if len(uncovered_bg) > 0 else 0\n                    if a_new != a_old:\n                        new_n_res = len(uncovered_bg) - max_covered\n                        new_ub = new_n_res * math.exp(logboost)\n                        new_D = calc_D(logm, new_ub)\n                        candidates.append((\'optimize\', (r, a_new), new_D, logm, logboost))\n\n                # Drop\n                num_only_r = np.sum(only_r_mask)\n                new_n_res_drop = n_res + num_only_r\n                new_logm_drop = logm - math.log(r)\n                new_logboost_drop = logboost - math.log(r / (r - 1))\n                new_ub_drop = new_n_res_drop * math.exp(new_logboost_drop)\n                new_D_drop = calc_D(new_logm_drop, new_ub_drop)\n                candidates.append((\'drop\', r, new_D_drop, new_logm_drop, new_logboost_drop))\n\n        # 4. Option: swap (drop one, add one)\n        if congr_dict and cand_pool:\n            num_drop = min(8, len(congr_dict))\n            drop_samples = random.sample(list(congr_dict.keys()), num_drop)\n            num_add = min(15, len(cand_pool))\n            add_samples = cand_pool[:min(5, len(cand_pool))]\n            rem_cands = cand_pool[5:]\n            if rem_cands:\n                add_samples += random.sample(rem_cands, min(num_add - len(add_samples), len(rem_cands)))\n            \n            cnt_array_eq_1 = (cnt_array == 1)\n            cnt_array_eq_0 = (cnt_array == 0)\n            \n            for r_drop in drop_samples:\n                a_drop = congr_dict[r_drop]\n                only_r_mask = cnt_array_eq_1 & (targets % r_drop == a_drop)\n                uncovered_bg = targets[cnt_array_eq_0 | only_r_mask]\n                \n                for r_add in add_samples:\n                    if len(uncovered_bg) > 0:\n                        counts = np.bincount(uncovered_bg % r_add, minlength=r_add)\n                        top_a_add = np.argsort(counts)[-2:]\n                    else:\n                        top_a_add = [0]\n                        \n                    for a_add in top_a_add:\n                        a_add = int(a_add)\n                        max_covered = counts[a_add] if len(uncovered_bg) > 0 else 0\n                        new_n_res = len(uncovered_bg) - max_covered\n                        new_logm = logm - math.log(r_drop) + math.log(r_add)\n                        new_logboost = logboost - math.log(r_drop / (r_drop - 1)) + math.log(r_add / (r_add - 1))\n                        new_ub = new_n_res * math.exp(new_logboost)\n                        new_D = calc_D(new_logm, new_ub)\n                        candidates.append((\'swap\', (r_drop, r_add, a_add), new_D, new_logm, new_logboost))\n\n        # Sample from candidates using Boltzmann/Gibbs distribution\n        D_vals = np.array([c[2] for c in candidates])\n        min_D = np.min(D_vals)\n        std_D = np.std(D_vals) if len(D_vals) > 1 else 1.0\n        if std_D < 1e-6:\n            std_D = 1.0\n\n        temp = max(t_temp * std_D, 1e-5)\n        scaled_scores = -(D_vals - min_D) / temp\n        probs = np.exp(scaled_scores)\n        probs /= np.sum(probs)\n\n        idx = np.random.choice(len(candidates), p=probs)\n        action, act_data, _, next_logm, next_logboost = candidates[idx]\n\n        if action == \'add\':\n            r, a = act_data\n            congr_dict[r] = a\n            cnt_array += (targets % r) == a\n            logm = next_logm\n            logboost = next_logboost\n        elif action == \'optimize\':\n            r, a_new = act_data\n            a_old = congr_dict[r]\n            cnt_array -= (targets % r) == a_old\n            cnt_array += (targets % r) == a_new\n            congr_dict[r] = a_new\n        elif action == \'drop\':\n            r = act_data\n            a_drop = congr_dict[r]\n            cnt_array -= (targets % r) == a_drop\n            del congr_dict[r]\n            logm = next_logm\n            logboost = next_logboost\n        elif action == \'swap\':\n            r_drop, r_add, a_add = act_data\n            a_drop = congr_dict[r_drop]\n            cnt_array -= (targets % r_drop) == a_drop\n            del congr_dict[r_drop]\n            congr_dict[r_add] = a_add\n            cnt_array += (targets % r_add) == a_add\n            logm = next_logm\n            logboost = next_logboost\n\n    return congr_dict\n# EVOLVE-BLOCK-END\n\ndef evaluate(eval_inputs: Mapping[str, Any]) -> dict[str, float]:\n    """Run evaluation on the optimized step."""\n    # Let\'s say we maximize -n_digits_est (smaller estimated N-size)\n    # Using sympy/math to compute est digits\n    import sympy\n    import numpy as np\n    Q = 100003\n    targets = np.array(list(sympy.primerange(3, Q)), dtype=np.int64)\n    # Let\'s run the optimize_cover_step starting from empty cover for some iterations\n    congr_dict = {}\n    cand_mods = [int(r) for r in sympy.primerange(3, 8000)]\n    cnt_array = np.zeros(len(targets), dtype=np.int16)\n    logm = math.log(2)\n    logboost = math.log(2.0)\n    \n    for it in range(10):\n        t_temp = 0.8 * (0.02 / 0.8) ** (it / 10)\n        # Update cnt_array based on congr_dict\n        cnt_array = np.zeros(len(targets), dtype=np.int16)\n        logm = math.log(2)\n        logboost = math.log(2.0)\n        for r, a in congr_dict.items():\n            cnt_array += (targets % r) == a\n            logm += math.log(r)\n            logboost += math.log(r / (r - 1))\n            \n        congr_dict = optimize_cover_step(congr_dict, cand_mods, targets, cnt_array, logm, logboost, t_temp)\n        \n    # Recalculate final metrics\n    cnt_array = np.zeros(len(targets), dtype=np.int16)\n    logm = math.log(2)\n    logboost = math.log(2.0)\n    for r, a in congr_dict.items():\n        cnt_array += (targets % r) == a\n        logm += math.log(r)\n        logboost += math.log(r / (r - 1))\n        \n    n_res = int((cnt_array == 0).sum())\n    boost = math.exp(logboost)\n    m_digits = logm / math.log(10)\n    \n    ub = n_res * boost\n    LN10 = math.log(10)\n    D = (m_digits + math.sqrt(m_digits ** 2 + 4 * ub / (LN10 * LN10))) / 2\n    return {"neg_est_digits": -float(D)}\n'}]}, 'evaluation': {'scores': {'scores': [{'metric': 'neg_est_digits', 'score': -50.655006}]}}, 'parentPrograms': ['projects/799795028847/locations/global/collections/default_collection/engines/goldbach_1784979910032/sessions/7013217697778074030/alphaEvolveExperiments/15164875354338173448/alphaEvolvePrograms/18102573509735111141'], 'state': 'COMPLETED'}, {'name': 'projects/799795028847/locations/global/collections/default_collection/engines/goldbach_1784979910032/sessions/7013217697778074030/alphaEvolveExperiments/15164875354338173448/alphaEvolvePrograms/18102573509735110076', 'createTime': '2026-07-25T19:47:13.956028Z', 'content': {'files': [{'path': 'program.py', 'content': '# Copyright 2026 Google LLC\nfrom typing import Any, Mapping\nimport math\nimport random\nimport numpy as np\n\n# EVOLVE-BLOCK-START\ndef optimize_cover_step(congr_dict, cand_mods, targets, cnt_array, logm, logboost, t_temp):\n    """Optimize a single step of congruence cover using simulated annealing style logic.\n\n    Args:\n        congr_dict: Dictionary of r -> a\n        cand_mods: List of prime candidates\n        targets: np.array of target primes\n        cnt_array: np.array of coverage counts\n        logm: current log of modulus M\n        logboost: current log of boost factor\n        t_temp: current temperature\n\n    Returns:\n        Updated congr_dict\n    """\n    import numpy as np\n    import random\n\n    # Persistent, self-cleaning cache of remainder arrays to avoid repeated modulo operations\n    if not hasattr(optimize_cover_step, "_last_targets_id") or optimize_cover_step._last_targets_id != id(targets):\n        optimize_cover_step._mod_cache = {}\n        optimize_cover_step._last_targets_id = id(targets)\n    cache = optimize_cover_step._mod_cache\n\n    def get_mod_array(r):\n        if r not in cache:\n            cache[r] = (targets % r).astype(np.int32)\n        return cache[r]\n\n    LN10 = np.log(10)\n    LN10_SQ = LN10 * LN10\n\n    def compute_D(lm, lb, nr):\n        m_d = lm / LN10\n        ub = nr * np.exp(lb)\n        return (m_d + np.sqrt(max(0.0, m_d**2 + 4 * ub / LN10_SQ))) / 2.0\n\n    # Initialize local search state\n    cnt = cnt_array.copy()\n    current_logm = logm\n    current_logboost = logboost\n    \n    uncovered_indices = np.where(cnt == 0)[0]\n    n_res = len(uncovered_indices)\n    current_D = compute_D(current_logm, current_logboost, n_res)\n\n    best_overall_dict = congr_dict.copy()\n    best_overall_D = current_D\n\n    def biased_sample_add(population, k):\n        n = len(population)\n        if n <= k:\n            return population\n        indices = set()\n        while len(indices) < k:\n            idx = int(n * (random.random() ** 1.8))\n            indices.add(idx)\n        return [population[i] for i in sorted(indices)]\n\n    def biased_sample_drop(population, k):\n        n = len(population)\n        if n <= k:\n            return population\n        indices = set()\n        while len(indices) < k:\n            idx = int(n * (1.0 - random.random() ** 1.8))\n            indices.add(idx)\n        return [population[i] for i in sorted(indices)]\n\n    # Run a highly efficient internal simulated annealing search of 2000 micro-steps\n    steps = 2000\n    for step in range(steps):\n        # Cool down the internal temperature\n        frac = step / steps\n        temp = max(t_temp * (0.12 ** frac), 1e-5)\n\n        # Dynamic action probabilities (exploration early, exploitation late)\n        p_add = 0.55 * (1.0 - 0.6 * frac)\n        p_drop = 0.15 * (1.0 - 0.5 * frac)\n        r_val = random.random()\n\n        if r_val < p_add:\n            # TRY ADD\n            cand_pool = [m for m in cand_mods if m not in congr_dict]\n            if cand_pool:\n                sampled = biased_sample_add(cand_pool, min(50, len(cand_pool)))\n                best_r, best_a, best_D = None, None, float(\'inf\')\n                best_cov = 0\n\n                for r in sampled:\n                    rem = get_mod_array(r)\n                    rem_uncovered = rem[uncovered_indices]\n                    counts = np.bincount(rem_uncovered, minlength=r)\n                    a = int(np.argmax(counts))\n                    cov = int(counts[a])\n\n                    new_logm = current_logm + np.log(r)\n                    new_logboost = current_logboost + np.log(r / (r - 1.0))\n                    new_n_res = n_res - cov\n                    new_D = compute_D(new_logm, new_logboost, new_n_res)\n\n                    if new_D < best_D:\n                        best_D = new_D\n                        best_r = r\n                        best_a = a\n                        best_cov = cov\n\n                if best_r is not None:\n                    if best_D < current_D or random.random() < np.exp((current_D - best_D) / temp):\n                        congr_dict[best_r] = best_a\n                        rem = get_mod_array(best_r)\n                        cnt[rem == best_a] += 1\n                        current_logm += np.log(best_r)\n                        current_logboost += np.log(best_r / (best_r - 1.0))\n                        \n                        uncovered_indices = np.where(cnt == 0)[0]\n                        n_res = len(uncovered_indices)\n                        current_D = best_D\n\n        elif r_val < p_add + p_drop:\n            # TRY DROP\n            if congr_dict:\n                sorted_keys = sorted(list(congr_dict.keys()))\n                sampled = biased_sample_drop(sorted_keys, min(40, len(sorted_keys)))\n                best_r, best_D = None, float(\'inf\')\n                best_revealed = 0\n\n                for r in sampled:\n                    rem = get_mod_array(r)\n                    a = congr_dict[r]\n                    revealed = int(np.sum(cnt[rem == a] == 1))\n\n                    new_logm = current_logm - np.log(r)\n                    new_logboost = current_logboost - np.log(r / (r - 1.0))\n                    new_n_res = n_res + revealed\n                    new_D = compute_D(new_logm, new_logboost, new_n_res)\n\n                    if new_D < best_D:\n                        best_D = new_D\n                        best_r = r\n                        best_revealed = revealed\n\n                if best_r is not None:\n                    if best_D < current_D or random.random() < np.exp((current_D - best_D) / temp):\n                        a_drop = congr_dict[best_r]\n                        rem = get_mod_array(best_r)\n                        cnt[rem == a_drop] -= 1\n                        del congr_dict[best_r]\n                        current_logm -= np.log(best_r)\n                        current_logboost -= np.log(best_r / (best_r - 1.0))\n                        \n                        uncovered_indices = np.where(cnt == 0)[0]\n                        n_res = len(uncovered_indices)\n                        current_D = best_D\n\n        else:\n            # TRY SWAP / OPTIMIZE CONGRUENCE CLASSES\n            if congr_dict:\n                sampled = random.sample(list(congr_dict.keys()), min(40, len(congr_dict)))\n                best_r, best_a, best_D = None, None, float(\'inf\')\n\n                for r in sampled:\n                    rem = get_mod_array(r)\n                    a_old = congr_dict[r]\n\n                    revealed = int(np.sum(cnt[rem == a_old] == 1))\n                    rem_uncovered = rem[uncovered_indices]\n                    counts = np.bincount(rem_uncovered, minlength=r)\n                    counts[a_old] = revealed\n\n                    a_new = int(np.argmax(counts))\n                    cov = int(counts[a_new])\n\n                    new_n_res = n_res + revealed - cov\n                    new_D = compute_D(current_logm, current_logboost, new_n_res)\n\n                    if new_D < best_D:\n                        best_D = new_D\n                        best_r = r\n                        best_a = a_new\n\n                if best_r is not None:\n                    if best_D < current_D or random.random() < np.exp((current_D - best_D) / temp):\n                        a_old = congr_dict[best_r]\n                        if a_old != best_a:\n                            rem = get_mod_array(best_r)\n                            cnt[rem == a_old] -= 1\n                            cnt[rem == best_a] += 1\n                            congr_dict[best_r] = best_a\n\n                            uncovered_indices = np.where(cnt == 0)[0]\n                            n_res = len(uncovered_indices)\n                            current_D = best_D\n\n        # Keep track of the elite overall configuration visited\n        if current_D < best_overall_D:\n            best_overall_D = current_D\n            best_overall_dict = congr_dict.copy()\n\n    return best_overall_dict\n# EVOLVE-BLOCK-END\n\ndef evaluate(eval_inputs: Mapping[str, Any]) -> dict[str, float]:\n    """Run evaluation on the optimized step."""\n    # Let\'s say we maximize -n_digits_est (smaller estimated N-size)\n    # Using sympy/math to compute est digits\n    import sympy\n    import numpy as np\n    Q = 100003\n    targets = np.array(list(sympy.primerange(3, Q)), dtype=np.int64)\n    # Let\'s run the optimize_cover_step starting from empty cover for some iterations\n    congr_dict = {}\n    cand_mods = [int(r) for r in sympy.primerange(3, 8000)]\n    cnt_array = np.zeros(len(targets), dtype=np.int16)\n    logm = math.log(2)\n    logboost = math.log(2.0)\n    \n    for it in range(10):\n        t_temp = 0.8 * (0.02 / 0.8) ** (it / 10)\n        # Update cnt_array based on congr_dict\n        cnt_array = np.zeros(len(targets), dtype=np.int16)\n        logm = math.log(2)\n        logboost = math.log(2.0)\n        for r, a in congr_dict.items():\n            cnt_array += (targets % r) == a\n            logm += math.log(r)\n            logboost += math.log(r / (r - 1))\n            \n        congr_dict = optimize_cover_step(congr_dict, cand_mods, targets, cnt_array, logm, logboost, t_temp)\n        \n    # Recalculate final metrics\n    cnt_array = np.zeros(len(targets), dtype=np.int16)\n    logm = math.log(2)\n    logboost = math.log(2.0)\n    for r, a in congr_dict.items():\n        cnt_array += (targets % r) == a\n        logm += math.log(r)\n        logboost += math.log(r / (r - 1))\n        \n    n_res = int((cnt_array == 0).sum())\n    boost = math.exp(logboost)\n    m_digits = logm / math.log(10)\n    \n    ub = n_res * boost\n    LN10 = math.log(10)\n    D = (m_digits + math.sqrt(m_digits ** 2 + 4 * ub / (LN10 * LN10))) / 2\n    return {"neg_est_digits": -float(D)}\n'}]}, 'evaluation': {'scores': {'scores': [{'metric': 'neg_est_digits', 'score': -50.655006}]}}, 'parentPrograms': ['projects/799795028847/locations/global/collections/default_collection/engines/goldbach_1784979910032/sessions/7013217697778074030/alphaEvolveExperiments/15164875354338173448/alphaEvolvePrograms/18102573509735112557', 'projects/79979