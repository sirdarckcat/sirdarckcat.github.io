y = 100.0 * (E_actual - E_limit) ** 2\n        return -float(D + lagrangian_penalty)\n\n    # Pre-cache uncovered and once-covered targets for speed\n    targets_uncovered = targets[cnt_array == 0]\n    targets_once = targets[cnt_array == 1]\n    n_res = len(targets_uncovered)\n\n    # Dynamic action probabilities based on temperature\n    factor = np.clip(t_temp, 0.0, 1.0)\n    p_opt = 0.85 - 0.45 * factor\n    p_add = 0.10 + 0.25 * factor\n    p_drop = 0.05 + 0.20 * factor\n    total_p = p_opt + p_add + p_drop\n    p_opt /= total_p\n    p_add /= total_p\n    p_drop /= total_p\n\n    kind = random.random()\n    if not congr_dict:\n        action = \'add\'\n    else:\n        cand_pool = [m for m in cand_mods if m not in congr_dict]\n        if not cand_pool:\n            p_opt_cond = p_opt / (p_opt + p_drop)\n            action = \'optimize\' if kind < p_opt_cond else \'drop\'\n        else:\n            if kind < p_add:\n                action = \'add\'\n            elif kind < p_add + p_opt:\n                action = \'optimize\'\n            else:\n                action = \'drop\'\n\n    if action == \'add\':\n        cand_pool = [m for m in cand_mods if m not in congr_dict]\n        if cand_pool:\n            # We can sample up to 100 candidates for a very thorough selection\n            sample_size = min(100, len(cand_pool))\n            sampled_cands = random.sample(cand_pool, sample_size)\n            \n            r_a_scores = []\n            for r in sampled_cands:\n                rem_uncovered = targets_uncovered % r\n                k = np.bincount(rem_uncovered, minlength=r)\n                a_best = int(np.argmax(k))\n                k_best = k[a_best]\n                \n                logm_new = logm + math.log(r)\n                logboost_new = logboost + math.log(r / (r - 1))\n                n_res_new = n_res - k_best\n                \n                score_new = get_score(logm_new, logboost_new, n_res_new)\n                r_a_scores.append((r