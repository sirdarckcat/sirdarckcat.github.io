', 'content': {'files': [{'path': 'program.py', 'content': '# Copyright 2026 Google LLC\nfrom typing import Any, Mapping\nimport math\nimport random\nimport numpy as np\n\n# EVOLVE-BLOCK-START\ndef optimize_cover_step(congr_dict, cand_mods, targets, cnt_array, logm, logboost, t_temp):\n    """Optimize a single step of congruence cover using simulated annealing style logic.\n\n    Args:\n        congr_dict: Dictionary of r -> a\n        cand_mods: List of prime candidates\n        targets: np.array of target primes\n        cnt_array: np.array of coverage counts\n        logm: current log of modulus M\n        logboost: current log of boost factor\n        t_temp: current temperature\n\n    Returns:\n        Updated congr_dict\n    """\n    import numpy as np\n    import random\n\n    if len(targets) == 0:\n        # Safety fallback\n        kind = random.random()\n        r_in = random.choice(list(congr_dict)) if congr_dict else None\n        if kind < 0.5 and r_in is not None:\n            a_old = congr_dict[r_in]\n            a_new = random.randint(0, r_in - 1)\n            if a_new != a_old:\n                congr_dict[r_in] = a_new\n        elif kind < 0.7 and r_in is not None:\n            del congr_dict[r_in]\n        else:\n            r_out = random.choice(cand_mods)\n            if r_out not in congr_dict:\n                a_new = random.randint(0, r_out - 1)\n                congr_dict[r_out] = a_new\n        return congr_dict\n\n    LN10 = 2.302585092994046\n    \n    def calc_score(n_res_val, lm, lb):\n        """Exact matching of evaluation objective + rigid Lagrangian barrier for E <= 17.5"""\n        m_dig = lm / LN10\n        bst = math.exp(lb)\n        ub = n_res_val * bst\n        disc = m_dig**2 + 4 * ub / (LN10**2)\n        D = (m_dig + math.sqrt(max(0.0, disc))) / 2\n        E = ub / (D * LN10) if D > 0 else 0.0\n        penalty = 100.0 * (max(0.0, E - 17.5))**2\n        return D + penalty\n\n    current_n_res = int((cnt_array == 0).sum())\n    \n    # Run multiple inner SA iterations to massively accelerate optimization scope per step\n    inner_steps = 20\n    for inner_it in range(inner_steps):\n        moves = []\n        \n        # 1. Add Moves Evaluation\n        cand_pool = [m for m in cand_mods if m not in congr_dict]\n        sample_add = random.sample(cand_pool, min(40, len(cand_pool))) if cand_pool else []\n        zeros_mask = (cnt_array == 0)\n        \n        for r in sample_add:\n            rem = targets % r\n            counts = np.bincount(rem[zeros_mask], minlength=r)\n            if len(counts) > 0:\n                a = int(np.argmax(counts))\n                covered_uncovered = counts[a]\n            else:\n                a = 0\n                covered_uncovered = 0\n            \n            new_n_res = current_n_res - covered_uncovered\n            new_logm = logm + math.log(r)\n            new_logboost = logboost + math.log(r / (r - 1))\n            score = calc_score(new_n_res, new_logm, new_logboost)\n            moves.append((\'add\', r, a, score, new_n_res, new_logm, new_logboost))\n            \n        mods_in = list(congr_dict.keys())\n        \n        # 2. Drop Moves Evaluation\n        sample_drop = random.sample(mods_in, min(40, len(mods_in))) if mods_in else []\n        ones_mask = (cnt_array == 1)\n        \n        for r in sample_drop:\n            a = congr_dict[r]\n            covered_unique = np.sum(ones_mask & ((targets % r) == a))\n            \n            new_n_res = current_n_res + covered_unique\n            new_logm = logm - math.log(r)\n            new_logboost = logboost - math.log(r / (r - 1))\n            score = calc_score(new_n_res, new_logm, new_logboost)\n            moves.append((\'drop\', r, None, score, new_n_res, new_logm, new_logboost))\n            \n        # 3. Optimize Moves Evaluation\n        sample_opt = random.sample(mods_in, min(40, len(mods_in))) if mods_in else []\n        for r in sample_opt:\n            a_old = congr_dict[r]\n            is_cov = ((targets % r) == a_old).astype(np.int16)\n            bg_zeros = (cnt_array - is_cov) == 0\n            \n            counts = np.bincount((targets % r)[bg_zeros], minlength=r)\n            if len(counts) > 0:\n                loss = counts[a_old]\n                counts[a_old] = -1  # Exclude current remainder from pool entirely\n                a_new = int(np.argmax(counts))\n                gain = counts[a_new] if counts[a_new] >= 0 else 0\n            else:\n                loss = 0\n                a_new = 0\n                gain = 0\n                \n            new_n_res = current_n_res + loss - gain\n            score = calc_score(new_n_res, logm, logboost)\n            moves.append((\'optimize\', r, a_new, score, new_n_res, logm, logboost))\n                \n        if not moves:\n            break\n            \n        scores = np.array([m[3] for m in moves])\n        \n        # Scale temp: translates directly to SA magnitude probabilities matching D change magnitudes\n        temp = max(t_temp, 1e-4) * 2.0\n        \n        scaled_scores = -scores / temp\n        scaled_scores = scaled_scores - np.max(scaled_scores)\n        probs = np.exp(scaled_scores)\n        probs /= np.sum(probs)\n        \n        r_val = random.random()\n        cum_probs = np.cumsum(probs)\n        idx = np.searchsorted(cum_probs, r_val)\n        if idx >= len(moves):\n            idx = len(moves) - 1\n            \n        action, r, a, _, next_n_res, next_logm, next_logboost = moves[idx]\n        \n        # In-place mutable state tracking (very fast loop turnaround mapping array counts instantly)\n        if action == \'add\':\n            congr_dict[r] = int(a)\n            cnt_array += ((targets % r) == a).astype(np.int16)\n        elif action == \'drop\':\n            a_old = congr_dict[r]\n            del congr_dict[r]\n            cnt_array -= ((targets % r) == a_old).astype(np.int16)\n        elif action == \'optimize\':\n            a_old = congr_dict[r]\n            congr_dict[r] = int(a)\n            cnt_array -= ((targets % r) == a_old).astype(np.int16)\n            cnt_array += ((targets % r) == a).astype(np.int16)\n            \n        current_n_res = next_n_res\n        logm = next_logm\n        logboost = next_logboost\n\n    return congr_dict\n# EVOLVE-BLOCK-END\n\ndef evaluate(eval_inputs: Mapping[str, Any]) -> dict[str, float]:\n    """Run evaluation on the optimized step."""\n    import sympy\n    import numpy as np\n    Q = 100003\n    targets = np.array(list(sympy.primerange(3, Q)), dtype=np.int64)\n    \n    # Warm-start from the 195-digit record cover instead of starting empty\n    congr_dict = {int(r): int(a) for r, a in eval_inputs["warm_start_cover"]}\n    \n    cand_mods = [int(r) for r in sympy.primerange(3, 8000)]\n    cnt_array = np.zeros(len(targets), dtype=np.int16)\n    \n    # Pre-populate counts\n    for r, a in congr_dict.items():\n        cnt_array += (targets % r) == a\n        \n    for it in range(10):\n        t_temp = 0.8 * (0.02 / 0.8) ** (it / 10)\n        # Recalculate cnt_array based on congr_dict\n        cnt_array = np.zeros(len(targets), dtype=np.int16)\n        logm = math.log(2)\n        logboost = math.log(2.0)\n        for r, a in congr_dict.items():\n            cnt_array += (targets % r) == a\n            logm += math.log(r)\n            logboost += math.log(r / (r - 1))\n            \n        congr_dict = optimize_cover_step(congr_dict, cand_mods, targets, cnt_array, logm, logboost, t_temp)\n        \n    # Recalculate final metrics\n    cnt_array = np.zeros(len(targets), dtype=np.int16)\n    logm = math.log(2)\n    logboost = math.log(2.0)\n    for r, a in congr_dict.items():\n        cnt_array += (targets % r) == a\n        logm += math.log(r)\n        logboost += math.log(r / (r - 1))\n        \n    n_res = int((cnt_array == 0).sum())\n    boost = math.exp(logboost)\n    m_digits = logm / math.log(10)\n    \n    ub = n_res * boost\n    LN10 = math.log(10)