hasattr(optimize_cover_step, "_log_cache"):\n        optimize_cover_step._log_cache = {}\n        optimize_cover_step._logboost_cache = {}\n    \n    log_cache = optimize_cover_step._log_cache\n    logb_cache = optimize_cover_step._logboost_cache\n    \n    for r in cand_mods:\n        if r not in log_cache:\n            log_cache[r] = math.log(r)\n            logb_cache[r] = math.log(r / (r - 1.0))\n            \n    for r in congr_dict:\n        if r not in log_cache:\n            log_cache[r] = math.log(r)\n            logb_cache[r] = math.log(r / (r - 1.0))\n\n    LN10 = math.log(10)\n    LN10_SQ = LN10 * LN10\n\n    def compute_D(lm, lb, nr):\n        m_d = lm / LN10\n        ub = nr * math.exp(lb)\n        return (m_d + math.sqrt(max(0.0, m_d**2 + 4 * ub / LN10_SQ))) / 2.0\n\n    # Initialize local search state\n    cnt = cnt_array.copy()\n    current_logm = logm\n    current_logboost = logboost\n    n_res = int(np.sum(cnt == 0))\n    current_D = compute_D(current_logm, current_logboost, n_res)\n\n    best_overall_dict = congr_dict.copy()\n    best_overall_D = current_D\n\n    # Run a highly efficient internal simulated annealing search of 1200 micro-steps\n    steps = 1200\n    for step in range(steps):\n        # Cool down the internal temperature\n        frac = step / steps\n        temp = max(t_temp * (0.12 ** frac), 1e-5)\n\n        # Dynamic action probabilities (exploration early, exploitation late)\n        p_add = 0.45 * (1.0 - 0.6 * frac)\n        p_drop = 0.15 * (1.0 - 0.5 * frac)\n        p_swap_prime = 0.15\n        r_val = random.random()\n\n        if r_val < p_add:\n            # TRY ADD\n            cand_pool = [m for m in cand_mods if m not in congr_dict]\n            if cand_pool:\n                # Biased sampling towards smaller primes (70% biased, 30% uniform)\n                n_pool = len(cand_pool)\n                sampled_indices = set()\n                while len(sampled_indices) < min(30, n_pool):\n                    if random.random() < 0.7:\n                        u = random.random() ** 1.8\n                    else:\n                        u = random.random()\n                    sampled_indices.add(int(u * n_pool))\n                sampled = [cand_pool[i] for i in sorted(sampled_indices)]\n\n                best_r, best_a, best_D = None, None, float(\'inf\')\n                best_cov = 0\n                uncovered_mask = (cnt == 0).astype(np.float64)\n\n                for r in sampled:\n                    rem = get_mod_array(r)\n                    counts = np.bincount(rem, weights=uncovered_mask, minlength=r)\n                    a = int(np.argmax(counts))\n                    cov = int(counts[a])\n\n                    new_logm = current_logm + log_cache[r]\n                    new_logboost = current_logboost + logb_cache[r]\n                    new_n_res = n_res - cov\n                    new_D = compute_D(new_logm, new_logboost, new_n_res)\n\n                    if new_D < best_D:\n                        best_D = new_D\n                        best_r = r\n                        best_a = a\n                        best_cov = cov\n\n                if best_r is not None:\n                    if best_D < current_D or random.random() < math.exp((current_D - best_D) / temp):\n                        congr_dict[best_r] = best_a\n                        rem = get_mod_array(best_r)\n                        cnt[rem == best_a] += 1\n                        current_logm += log_cache[best_r]\n                        current_logboost += logb_cache[best_r]\n                        n_res -= best_cov\n                        current_D = best_D\n\n        elif r_val < p_add + p_drop:\n            # TRY DROP\n            if congr_dict:\n                # Biased sampling towards larger primes (70% biased, 30% uniform)\n                sorted_keys = sorted(congr_dict.keys())\n                n_keys = len(sorted_keys)\n                sampled_indices = set()\n                while len(sampled_indice