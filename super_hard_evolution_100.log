tep(congr_dict, cand_mods, targets, cnt_array, logm, logboost, t_temp):\n    """Optimize a single step of congruence cover using simulated annealing style logic.\n\n    Args:\n        congr_dict: Dictionary of r -> a\n        cand_mods: List of prime candidates\n        targets: np.array of target primes\n        cnt_array: np.array of coverage counts\n        logm: current log of modulus M\n        logboost: current log of boost factor\n        t_temp: current temperature\n\n    Returns:\n        Updated congr_dict\n    """\n    import numpy as np\n    import random\n    import math\n\n    if len(targets) == 0:\n        return congr_dict\n\n    # Precompute remainders for extremely fast lookups during search\n    rem_cache = {}\n    for r in cand_mods:\n        rem_cache[r] = targets % r\n    for r in congr_dict.keys():\n        if r not in rem_cache:\n            rem_cache[r] = targets % r\n\n    LN10 = math.log(10)\n    E_limit = 17.5\n\n    def calc_D_val(n_res_val, logm_val, logboost_val):\n        boost = math.exp(logboost_val)\n        m_digits = logm_val / LN10\n        ub = n_res_val * boost\n        inside_sqrt = m_digits ** 2 + 4 * ub / (LN10 * LN10)\n        D = (m_digits + math.sqrt(max(0.0, inside_sqrt))) / 2\n        E_actual = ub / (D * LN10) if D > 0 else 0.0\n        lagrangian_penalty = 0.0\n        if E_actual > E_limit:\n            lagrangian_penalty = 100.0 * (E_actual - E_limit) ** 2\n        return D + lagrangian_penalty\n\n    def optimize_all(congr, cnt):\n        keys = list(congr.keys())\n        random.shuffle(keys)\n        for r in keys:\n            a_old = congr[r]\n            rem = rem_cache[r]\n            cnt[rem == a_old] -= 1\n            counts = np.bincount(rem, weights=(cnt == 0), minlength=r)\n            a_new = int(np.argmax(counts))\n            cnt[rem == a_new] += 1\n            congr[r] = a_new\n\n    # Copy state to avoid mutations to the caller\'s objects\n    congr_dict = dict(congr_dict)\n    cnt_array = np.array(cnt_array, dtype=np.int16)\n\n    # Initial residue optimization to start from a local optimum\n    optimize_all(congr_dict, cnt_array)\n    n_res = int((cnt_array == 0).sum())\n    current_D = calc_D_val(n_res, logm, logboost)\n\n    N_STEPS = 300\n    temp_start = max(t_temp, 1e-6)\n    temp_end = temp_start * 0.05\n\n    for step in range(N_STEPS):\n        # Periodically run coordinate descent to stay on the local optimum manifold\n        if step > 0 and step % 50 == 0:\n            optimize_all(congr_dict, cnt_array)\n            n_res = int((cnt_array == 0).sum())\n            current_D = calc_D_val(n_res, logm, logboost)\n\n        # Geometric cooling schedule\n        temp = temp_start * ((temp_end / temp_start) ** (step / N_STEPS))\n\n        action = random.choices([\'add\', \'drop\', \'swap\', \'optimize_single\'], weights=[0.35, 0.35, 0.20, 0.10], k=1)[0]\n\n        if action == \'add\':\n            cand_pool = [m for m in cand_mods if m not in congr_dict]\n            if cand_pool:\n                sampled = random.sample(cand_pool, min(40, len(cand_pool)))\n                best_r = None\n                best_a = None\n                best_new_D = float(\'inf\')\n                best_new_n_res = n_res\n                \n                for r in sampled:\n                    rem = rem_cache[r]\n                    counts = np.bincount(rem, weights=(cnt_array == 0), minlength=r)\n                    a = int(np.argmax(counts))\n                    \n                    added_cov = counts[a]\n                    new_n_res = n_res - added_cov\n                    new_logm = logm + math.log(r)\n                    new_logboost = logboost + math.log(r / (r - 1))\n                    new_D = calc_D_val(new_n_res, new_logm, new_logboost)\n                    if new_D < best_new_D:\n                        best_new_D = new_D\n                        best_r = r\n                        best_a = a\n                        best_new_n_res = new_n_res\n                        \n                if best_r is not None:\n                    delta = best_new_D - current_D\n                    if delta < 0 or random.random() < math.exp(-delta / temp):\n                        congr_dict[best_r] = best_a\n                        cnt_array[rem_cache[best_r] == best_a] += 1\n                        n_res = best_new_n_res\n                        logm += math.log(best_r)\n                        logboost += math.log(best_r / (best_r - 1))\n                        current_D = best_new_D\n\n        elif action == \'drop\':\n            active = list(congr_dict.keys())\n            if active:\n                sampled = random.sample(active, min(40, len(active)))\n                best_r = None\n                best_new_D = float(\'inf\')\n                best_new_n_res = n_res\n                \n                for r in sampled:\n                    a = congr_dict[r]\n                    rem = rem_cache[r]\n                    lost_cov = np.sum((cnt_array == 1) & (rem == a))\n                    new_n_res = n_res + lost_cov\n                    new_logm = logm - math.log(r)\n                    new_logboost = logboost - math.log(r / (r - 1))\n                    new_D = calc_D_val(new_n_res, new_logm, new_logboost)\n                    if new_D < best_new_D:\n                        best_new_D = new_D\n                        best_r = r\n                        best_new_n_res = new_n_res\n                        \n                if best_r is not None:\n                    delta = best_new_D - current_D\n                    if delta < 0 or random.random() < math.exp(-delta / temp):\n                        r_drop = best_r\n                        a_drop = congr_dict[r_drop]\n                        cnt_array[rem_cache[r_drop] == a_drop] -= 1\n                        del congr_dict[r_drop]\n                        n_res = best_new_n_res\n                        logm -= math.log(r_drop)\n                        logboost -= math.log(r_drop / (r_drop - 1))\n                        current_D = best_new_D\n\n        elif action == \'swap\':\n            active = list(congr_dict.keys())\n            cand_pool = [m for m in cand_mods if m not in congr_dict]\n            if active and cand_pool:\n                r_old = random.choice(active)\n                a_old = congr_dict[r_old]\n                \n                cnt_array[rem_cache[r_old] == a_old] -= 1\n                temp_n_res = int((cnt_array == 0).sum())\n                temp_logm = logm - math.log(r_old)\n                temp_logboost = logboost - math.log(r_old / (r_old - 1))\n                \n                sampled = random.sample(cand_pool, min(15, len(cand_pool)))\n                best_r_new = None\n                best_a_new = None\n                best_new_D = float(\'inf\')\n                best_new_n_res = temp_n_res\n                \n                for r_new in sampled:\n                    rem = rem_cache[r_new]\n                    counts = np.bincount(rem, weights=(cnt_array == 0), minlength=r_new)\n                    a_new = int(np.argmax(counts))\n                    \n                    added_cov = counts[a_new]\n                    new_n_res = temp_n_res - added_cov\n                    new_logm = temp_logm + math.log(r_new)\n                    new_logboost = temp_logboost + math.log(r_new / (r_new - 1))\n                    new_D = calc_D_val(new_n_res, new_logm, new_logboost)\n                    if new_D < best_new_D:\n                        best_new_D = new_D\n                        best_r_new = r_new\n                        best_a_new = a_new\n                        best_new_n_res = new_n_res\n                \n                if best_r_new is not None:\n                    delta = best_new_D - current_D\n                    if delta < 0 or random.random() < math.exp(-delta / temp):\n                        cnt_array[rem_cache[best_r_new] == best_a_new] += 1\n                        del congr_dict[r_old]\n                        congr_dict[best_r_new] = best_a_new\n                        n_res = best_new_n_res\n                        logm = temp_logm + math.log(best_r_new)\n                        logboost = temp_logboost + math.log(best_r_new / (best_r_new - 1))\n                        current_D = best_new_D\n                    else:\n                        cnt_array[rem_cache[r_old] == a_old] += 1\n\n        elif action == \'optimize_single\':\n            active = list(congr_dict.keys())\n            if active:\n                r = random.choice(active)\n                a_old = congr_dict[r]\n                rem = rem_cache[r]\n                cnt_array[rem == a_old] -= 1\n                \n                counts = np.bincount(rem, weights=(cnt_array == 0), minlength=r)\n                a_new = int(np.argmax(counts))\n                \n                cnt_array[rem == a_new] += 1\n                congr_dict[r] = a_new\n                n_res = int((cnt_array == 0).sum())\n                current_D = calc_D_val(n_res, logm, logboost)\n\n    # Final cleanup to ensure absolute optimality of residues\n    optimize_all(congr_dict, cnt_array)\n    return congr_dict\n# EVOLVE-BLOCK-END\n\ndef evaluate(eval_inputs: Mapping[str, Any]) -> dict[str, float]:\n    """Run evaluation on the optimized step."""\n    import sympy\n    import numpy as np\n    Q = 100003\n    targets = np.array(list(sympy.primerange(3, Q)), dtype=np.int64)\n    \n    # Warm-start from the 195-digit record cover instead of starting empty\n    congr_dict = {int(r): int(a) for r, a in eval_inputs["warm_start_cover"]}\n    \n    cand_mods = [int(r) for r in sympy.primerange(3, 8000)]\n    cnt_array = np.zeros(len(targets), dtype=np.int16)\n    \n    # Pre-populate counts\n    for r, a in congr_dict.items():\n        cnt_array += (targets % r) == a\n        \n    for it in range(10):\n        t_temp = 0.8 * (0.02 / 0.8) ** (it / 10)\n        # Recalculate cnt_array based on congr_dict\n        cnt_array = np.zeros(len(targets), dtype=np.int16)\n        logm = math.log(2)\n        logboost = math.log(2.0)\n        for r, a in congr_dict.items():\n            cnt_array += (targets % r) == a\n            logm += math.log(r)\n            logboost += math.log(r / (r - 1))\n            \n        congr_dict = optimize_cover_step(congr_dict, cand_mods, targets, cnt_array, logm, logboost, t_temp)\n        \n    # Recalculate final metrics\n    cnt_array = np.zeros(len(targets), dtype=np.int16)\n    logm = math.log(2)\n    logboost = math.log(2.0)\n    for r, a in congr_dict.items():\n        cnt_array += (targets % r) == a\n        logm += math.log(r)\n        logboost += math.log(r / (r - 1))\n        \n    n_res = int((cnt_array == 0).sum())\n    boost = math.exp(logboost)\n    m_digits = logm / math.log(10)\n    \n    ub = n_res * boost\n    LN10 = math.log(10)\n    D = (m_digits + math.sqrt(m_digits ** 2 + 4 * ub / (LN10 * LN10))) / 2\n    \n    # Constrain E <= 17.5 via Lagrangian penalty to prevent reward hacking\n    E_limit = 17.5\n    E_actual = ub / (D * LN10) if D > 0 else 0.0\n    lagrangian_penalty = 0.0\n    if E_actual > E_limit:\n        lagrangian_penalty = 100.0 * (E_actual - E_limit) ** 2\n        \n    score_headline = -float(D + lagrangian_penalty)\n    \n    # Expose E, |U|, digits(M) as negated secondary metrics for joint optimization visibility\n    return {\n        "neg_est_digits": score_headline,\n        "neg_E": -float(E_actual),\n        "neg_residual_count": -float(n_res),\n        "neg_m_digits": -float(m_digits)\n    }\n'}]}, 'evaluation': {'scores': {'scores': [{'metric': 'neg_est_digits', 'score': -194.03145}, {'metric': 'neg_E', 'score': -17.504194}, {'metric': 'neg_residual_count', 'score': -720}, {'metric': 'neg_m_digits', 'score': -186.4277}]}, 'insights': {'insights': [{'label': 'Evaluation Metrics', 'text': 'Estimated Digits: 194.0314 (constrained), E: 17.5042, |U|: 720, digits(M): 186.43'}]}}, 'parentPrograms': ['projects/799795028847/lo