t_keys, congr_dict, cnt_array)\n    n_res = int((cnt_array == 0).sum())\n    current_D = calc_D_val(n_res, logm, logboost)\n\n    temp = max(t_temp, 1e-6)\n    N_STEPS = 100000\n\n    for step in range(N_STEPS):\n        # Periodically optimize all to stay on the local optimum manifold\n        if step > 0 and step % 10000 == 0:\n            keys = list(congr_dict.keys())\n            random.shuffle(keys)\n            optimize_subset(keys, congr_dict, cnt_array)\n            n_res = int((cnt_array == 0).sum())\n            current_D = calc_D_val(n_res, logm, logboost)\n\n        rand_val = random.random()\n        if rand_val < 0.25:\n            action = \'add\'\n        elif rand_val < 0.50:\n            action = \'drop\'\n        elif rand_val < 0.90:\n            action = \'swap\'\n        else:\n            action = \'optimize\'\n\n        if action == \'add\':\n            r = random.choice(cand_mods)\n            if r not in congr_dict:\n                counts = np.bincount(targets[cnt_array == 0] % r, minlength=r)\n                a = int(np.argmax(counts))\n                \n                new_n_res = n_res - counts[a]\n                new_logm = logm + math.log(r)\n                new_logboost = logboost + math.log(r / (r - 1))\n                new_D = calc_D_val(new_n_res, new_logm, new_logboost)\n                \n                if new_D < current_D or random.random() < math.exp(-(new_D - current_D) / temp):\n                    congr_dict[r] = a\n                    cnt_array[targets % r == a] += 1\n                    n_res, current_D = new_n_res, new_D\n                    logm, logboost = new_logm, new_logboost\n\n        elif action == \'drop\':\n            active = list(congr_dict.keys())\n            if active:\n                r = random.choice(active)\n                a = congr_dict[r]\n                lost_cov = int(np.sum((targets[cnt_array == 1] % r) == a))\n                \n                new_n_res = n_res + lost_cov\n                new_logm = logm - math.log(r)\n                new_logboost = logboost - math.log(r / (r - 1))\n                new_D = calc_D_val(new_n_res, new_logm, new_logboost)\n                \n                if new_D < current_D or random.random() < math.exp(-(new_D - current_D) / temp):\n                    cnt_array[targets % r == a] -= 1\n                    del congr_dict[r]\n                    n_res, current_D = new_n_res, new_D\n                    logm, logboost = new_logm, new_logboost\n\n        elif action == \'swap\':\n            active = list(congr_dict.keys())\n            if active:\n                r_drop = random.choice(active)\n                r_add = random.choice(cand_mods)\n                \n                if r_add not in congr_dict:\n                    a_drop = congr_dict[r_drop]\n                    drop_mask = (targets % r_drop) == a_drop\n                    \n                    lost_cov = int(np.sum(drop_mask & (cnt_array == 1)))\n                    uncovered = (cnt_array == 0) | (drop_mask & (cnt_array == 1))\n                    \n                    counts = np.bincount(targets[uncovered] % r_add, minlength=r_add)\n                    a_add = int(np.argmax(counts))\n                    \n                    new_n_res = n_res + lost_cov - counts[a_add]\n                    new_logm = logm - math.log(r_drop) + math.log(r_add)\n                    new_logboost = logboost - math.log(r_drop / (r_drop - 1)) + math.log(r_add / (r_add - 1))\n                    new_D = calc_D_val(new_n_res, new_logm, new_logboost)\n                    \n                    if new_D < current_D or random.random() < math.exp(-(new_D - current_D) / temp):\n                        del congr_dict[r_drop]\n                        congr_dict[r_add] = a_add\n                        cnt_array[drop_mask] -= 1\n                        cnt_array[targets % r_add == a_add] += 1\n                        n_res, current_D = new_n_res, new_D\n                        logm, logboost = new_logm, new_logboost\n\n        elif action == \'optimize\':\n            active = list(congr_dict.keys())\n            if active:\n                sampled = [random.choice(active)]\n                optimize_subset(sampled, congr_dict, cnt_array)\n                n_res = int((cnt_array == 0).sum())\n                current_D = calc_D_val(n_res, logm, logboost)\n\n    # Final cleanup to ensure absolute optimality of residues\n    final_keys = list(congr_dict.keys())\n    random.shuffle(final_keys)\n    optimize_subset(final_keys, congr_dict, cnt_array)\n    return congr_dict\n# EVOLVE-BLOCK-END\n\ndef evaluate(eval_inputs: Mapping[str, Any]) -> dict[str, float]:\n    """Run evaluation on the optimized step."""\n    import sympy\n    import numpy as np\n    Q = 100003\n    targets = np.array(list(sympy.primerange(3, Q)), dtype=np.int64)\n    \n    # Warm-start from the 195-digit record cover instead of starting empty\n    congr_dict = {int(r): int(a) for r, a in eval_inputs["warm_start_cover"]}\n    \n    cand_mods = [int(r) for r in sympy.primerange(3, 8000)]\n    cnt_array = np.zeros(len(targets), dtype=np.int16)\n    \n    # Pre-populate counts\n    for r, a in congr_dict.items():\n        cnt_array += (targets % r) == a\n        \n    for it in range(10):\n        t_temp = 0.8 * (0.02 / 0.8) ** (it / 10)\n        # Recalculate cnt_array based on congr_dict\n        cnt_array = np.zeros(len(targets), dtype=np.int16)\n        logm = math.log(2)\n        logboost = math.log(2.0)\n        for r, a in congr_dict.items():\n            cnt_array += (targets % r) == a\n            logm += math.log(r)\n            logboost += math.log(r / (r - 1))\n            \n        congr_dict = optimize_cover_step(congr_dict, cand_mods, targets, cnt_array, logm, logboost, t_temp)\n        \n    # Recalculate final metrics\n    cnt_array = np.zeros(len(targets), dtype=np.int16)\n    logm = math.log(2)\n    logboost = math.log(2.0)\n    for r, a in congr_dict.items():\n        cnt_array += (targets % r) == a\n        logm += math.log(r)\n        logboost += math.log(r / (r - 1))\n        \n    n_res = int((cnt_array == 0).sum())\n    boost = math.exp(logboost)\n    m_digits = logm / math.log(10)\n    \n    ub = n_res * boost\n    LN10 = math.log(10)\n    D = (m_digits + math.sqrt(m_digits ** 2 + 4 * ub / (LN10 * LN10))) / 2\n    \n    # Constrain E <= 17.5 via Lagrangian penalty to prevent reward hacking\n    E_limit = 17.5\n    E_actual = ub / (D * LN10) if D > 0 else 0.0\n    lagrangian_penalty = 0.0\n    if E_actual > E_limit:\n        lagrangian_penalty = 100.0 * (E_actual - E_limit) ** 2\n        \n    score_headline = -float(D + lagrangian_penalty)\n    \n    # Expose E, |U|, digits(M) as negated secondary metrics for joint optimization visibility\n    return {\n        "neg_est_digits": score_headline,\n        "neg_E": -float(E_actual),\n        "neg_residual_count": -float(n_res),\n        "neg_m_digits": -float(m_digits)\n    }\n'}]}, 'evaluation': {'scores': {'scores': [{'metric': 'neg_est_digits', 'score': -193.45819}, {'metric': 'neg_E', 'score': -17.498932}, {'metric': 'neg_residual_count', 'score': -736}, {'metric': 'neg_m_digits', 'score': -185.8585}]}, 'insights': {'insights': [{'label': 'Evaluation Metrics', 'text': 'Estimated Digits: 193.4582 (constrained), E: 17.4989, |U|: 736, digits(M): 185.86'}]}}, 'parentPrograms': ['projects/799795028847/locations/global/collections/default_collection/engines/goldbach_1784979910032/sessions/7658735534374771723/alphaEvolveExperiments/9582896010645531772/alphaEvolvePrograms/11597998738524452663'], 'state': 'COMPLETED'}, {'name': 'projects/799795028847/locations/global/collections/default_collection/engines/goldbach_1784979910032/sessions/7658735534374771723/alphaEvolveExperiments/9582896010645531772/alphaEvolvePrograms/7662895210918131671', 'createTime': '2026-07-26T05:52:51.072186Z', 'content': {'files': [{'path': 'program.py', 'content': '# Copyright 2026 Google LLC\nfrom typing import Any, Mapping\nimport math\nimport random\nimport numpy as np\n\n# EVOLVE-BLOCK-START\ndef optimize_cover_step(congr_dict, cand_mods, targets, cnt_array, logm, logboost, t_temp):\n    """Optimize congruence cover using a powerful local search with Simulated Annealing style logic."""\n    import numpy as np\n    import random\n    import math\n\n    if len(targets) == 0:\n        return congr_dict\n\n    # Copy to avoid side effects during search\n    cnt_array = cnt_array.copy()\n    n_res = int((cnt_array == 0).sum())\n\n    def calc_D_val(n_res_val, logm_val, logboost_val):\n        boost = math.exp(logboost_val)\n        m_digits = logm_val / math.log(10)\n        ub = n_res_val * boost\n        LN10 = math.log(10)\n        inside_sqrt = m_digits ** 2 + 4 * ub / (LN10 * LN10)\n        D = (m_digits + math.sqrt(max(0.0, inside_sqrt))) / 2\n        \n        E_limit = 17.5\n        E_actual = ub / (D * LN10) if D > 0 else 0.0\n        lagrangian_penalty = 0.0\n        if E_actual > E_limit:\n            lagrangian_penalty = 100.0 * (E_actual - E_limit) ** 2\n        return D + lagrangian_penalty\n\n    def optimize_all(congr, cnt):\n        keys = list(congr.keys())\n        random.shuffle(keys)\n        for r in keys:\n            a_old = congr[r]\n            rem = targets % r\n            # Remove contribution\n            cnt[rem == a_old] -= 1\n            # Find best a\n            uncovered = targets[cnt == 0]\n            if len(uncovered) > 0:\n                counts = np.bincount(uncovered % r, minlength=r)\n                a_new = int(np.argmax(counts))\n            else:\n                a_new = 0\n            # Add contribution back\n            cnt[rem == a_new] += 1\n            congr[r] = a_new\n\n    # Initial residue optimization\n    optimize_all(congr_dict, cnt_array)\n    n_res = int((cnt_array == 0).sum())\n    current_D = calc_D_val(n_res, logm, logboost)\n\n    temp = max(t_temp, 1e-6)\n    N_STEPS = 600\n\n    for step in range(N_STEPS):\n        # Periodically optimize all to stay on the local optimum manifold\n        if step > 0 and step % 60 == 0:\n            optimize_all(congr_dict, cnt_array)\n            n_res = int((cnt_array == 0).sum())\n            current_D = calc_D_val(n_res, logm, logboost)\n\n        # Dynamic action probabilities: explore initially, exploit later\n        progress = step / N_STEPS\n        w_add = 0.40 - 0.20 * progress\n        w_drop = 0.40 - 0.20 * progress\n        w_opt = 0.20 + 0.40 * progress\n        action = random.choices([\'add\', \'drop\', \'optimize\'], weights=[w_add, w_drop, w_opt], k=1)[0]\n\n        if action == \'add\':\n            cand_pool = [m for m in cand_mods if m not in congr_dict]\n            if cand_pool:\n                sampled = random.sample(cand_pool, min(150, len(cand_pool)))\n                best_r = None\n                best_a = None\n                best_new_D = float(\'inf\')\n                best_new_n_res = n_res\n                \n                uncovered = targets[cnt_array == 0]\n                n_res_old = len(uncovered)\n                \n                for r in sampled:\n                    if n_res_old > 0:\n                        counts = np.bincount(uncovered % r, minlength=r)\n                        a = int(np.argmax(counts))\n                        added_cov = counts[a]\n                    else:\n                        a = 0\n                        added_cov = 0\n                        \n                    new_n_res = n_res_old - added_cov\n                    new_logm = logm + math.log(r)\n                    new_logboost = logboost + math.log(r / (r - 1))\n                    new_D = calc_D_val(new_n_res, new_logm, new_logboost)\n                    if new_D < best_new_D:\n                        best_new_D = new_D\n                        best_r = r\n                        best_a = a\n                        best_new_n_res = new_n_res\n                        \n                if best_r is not None:\n                    delta = best_new_D - current_D\n                    if delta < 0 or random.random() < math.exp(-delta / temp):\n                        congr_dict[best_r] = best_a\n                        cnt_array[targets % best_r == best_a] += 1\n                        n_res = best_new_n_res\n                        logm += math.log(best_r)\n                        logboost += math.log(best_r / (best_r - 1))\n                        current_D = best_new_D\n\n        elif action == \'drop\':\n            active = list(congr_dict.keys())\n            if active:\n                sampled = random.sample(active, min(100, len(active)))\n                best_r = None\n                best_new_D = float(\'inf\')\n                best_new_n_res = n_res\n                \n                unique_covered = targets[cnt_array == 1]\n                for r in sampled:\n                    a = congr_dict[r]\n                    lost_cov = np.sum(unique_covered % r == a)\n                    \n                    new_n_res = n_res + lost_cov\n                    new_logm = logm - math.log(r)\n                    new_logboost = logboost - math.log(r / (r - 1))\n                    new_D = calc_D_val(new_n_res, new_logm, new_logboost)\n                    if new_D < best_new_D:\n                        best_new_D = new_D\n                        best_r = r\n                        best_new_n_res = new_n_res\n                        \n                if best_r is not None:\n                    delta = best_new_D - current_D\n                    if delta < 0 or random.random() < math.exp(-delta / temp):\n                        r_drop = best_r\n                        a_drop = congr_dict[r_drop]\n                        cnt_array[targets % r_drop == a_drop] -= 1\n                        del congr_dict[r_drop]\n                        n_res = best_new_n_res\n                        logm -= math.log(r_drop)\n                        logboost -= math.log(r_drop / (r_drop - 1))\n                        current_D = best_new_D\n\n        elif action == \'optimize\':\n            active = list(congr_dict.keys())\n            if active:\n                sampled = random.sample(active, min(10, len(active)))\n                for r in sampled:\n                    a_old = congr_dict[r]\n                    rem = targets % r\n                    cnt_array[rem == a_old] -= 1\n                    \n                    uncovered = targets[cnt_array == 0]\n                    if len(uncovered) > 0:\n                        counts = np.bincount(uncovered % r, minlength=r)\n                        a_new = int(np.argmax(counts))\n                    else:\n                        a_new = 0\n                    \n                    cnt_array[rem == a_new] += 1\n                    congr_dict[r] = a_new\n                    \n                n_res = int((cnt_array == 0).sum())\n                current_D = calc_D_val(n_res, logm, logboost)\n\n    # Final cleanup to ensure absolute optimality of residues\n    optimize_all(congr_dict, cnt_array)\n    return congr_dict\n# EVOLVE-BLOCK-END\n\ndef evaluate(eval_inputs: Mapping[str, Any]) -> dict[str, float]:\n    """Run evaluation on the optimized step."""\n    import sympy\n    import numpy as np\n    Q = 100003\n    targets = np.array(list(sympy.primerange(3, Q)), dtype=np.int64)\n    \n    # Warm-start from the 195-digit record cover instead of starting empty\n    congr_dict = {int(r): int(a) for r, a in eval_inputs["warm_start_cover"]}\n    \n    cand_mods = [int(r) for r in sympy.primerange(3, 8000)]\n    cnt_array = np.zeros(len(targets), dtype=np.int16)\n    \n    # Pre-populate counts\n    for r, a in congr_dict.items():\n        cnt_array += (targets % r) == a\n        \n    for it in range(10):\n        t_temp = 0.8 * (0.02 / 0.8) ** (it / 10)\n        # Recalculate cnt_array based on congr_dict\n        cnt_array = np.zeros(len(targets), dtype=np.int16)\n        logm = math.log(2)\n        logboost = math.log(2.0)\n        for r, a in congr_dict.items():\n            cnt_array += (targets % r) == a\n            logm += math.log(r)\n            logboost += math.log(r / (r - 1))\n            \n        congr_dict = optimize_cover_step(congr_dict, cand_mods, targets, cnt_array, logm, logboost, t_temp)\n        \n    # Recalculate final metrics\n    cnt_array = np.zeros(len(targets), dtype=np.int16)\n    logm = math.log(2)\n    logboost = math.log(2.0)\n    for r, a in congr_dict.items():\n        cnt_array += (targets % r) == a\n        logm += math.log(r)\n        logboost += math.log(r / (r - 1))\n        \n    n_res = int((cnt_array == 0).sum())\n    boost = math.exp(logboost)\n    m_digits = logm / math.log(10)\n    \n    ub = n_res * boost\n    LN10 = math.log(10)\n    D = (m_digits + math.sqrt(m_digits ** 2 + 4 * ub / (LN10 * LN10))) / 2\n    \n    # Constrain E <= 17.5 via Lagrangian penalty to prevent reward hacking\n    E_limit = 17.5\n    E_actual = ub / (D * LN10) if D > 0 else 0.0\n    lagrangian_penalty = 0.0\n    if E_actual > E_limit:\n        lagrangian_penalty = 100.0 * (E_actual - E_limit) ** 2\n        \n    score_headline = -float(D + lagrangian_penalty)\n    \n    # Expose E, |U|, digits(M) as negated secondary metrics for joint optimization visibility\n    return {\n        "neg_est_digits": score_headline,\n        "neg_E": -float(E_actual),\n        "neg_residual_count": -float(n_res),\n        "neg_m_digits": -float(m_digits)\n    }\n'}]}, 'evaluation': {'scores': {'scores': [{'metric': 'neg_est_digits', 'score': -193.54967}, {'metric': 'neg_E', 'score': -17.549484}, {'metric': 'neg_residual_count', 'score': -717}, {'metric': 'neg_m_digits', 'score': -185.68317}]}, 'insights': {'insights': [{'label': 'Evaluation Metrics', 'text': 'Estimated Digits: 193.5497 (constrained), E: 17.5495, |U|: 717, digits(M): 185.68'}]}}, 'parentPrograms': ['projects/799795028847/locations/global/collections/default_collection/engines/goldbach_1784979910032/sessions/76587