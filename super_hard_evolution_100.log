py()\n    n_res = int((cnt_array == 0).sum())\n\n    # Precompute / cache modulos for extreme speedup\n    mod_cache = {}\n    for r in cand_mods:\n        mod_cache[r] = targets % r\n    for r in congr_dict:\n        if r not in mod_cache:\n            mod_cache[r] = targets % r\n\n    def calc_D_val(n_res_val, logm_val, logboost_val):\n        boost = math.exp(logboost_val)\n        m_digits = logm_val / math.log(10)\n        ub = n_res_val * boost\n        LN10 = math.log(10)\n        inside_sqrt = m_digits ** 2 + 4 * ub / (LN10 * LN10)\n        D = (m_digits + math.sqrt(max(0.0, inside_sqrt))) / 2\n        \n        E_limit = 17.5\n        E_actual = ub / (D * LN10) if D > 0 else 0.0\n        lagrangian_penalty = 0.0\n        if E_actual > E_limit:\n            lagrangian_penalty = 1000.0 * (E_actual - E_limit) ** 2\n        return D + lagrangian_penalty\n\n    def optimize_all(congr, cnt):\n        keys = list(congr.keys())\n        random.shuffle(keys)\n        for r in keys:\n            a_old = congr[r]\n            rem = mod_cache[r]\n            # Remove contribution\n            cnt[rem == a_old] -= 1\n            # Find best a\n            counts = np.bincount(rem, weights=(cnt == 0), minlength=r)\n            a_new = int(np.argmax(counts))\n            # Add contribution back\n            cnt[rem == a_new] += 1\n            congr[r] = a_new\n\n    # Initial residue optimization\n    optimize_all(congr_dict, cnt_array)\n    n_res = int((cnt_array == 0).sum())\n    current_D = calc_D_val(n_res, logm, logboost)\n\n    temp = max(t_temp, 1e-6)\n    N_STEPS = 850\n\n    for step in range(N_STEPS):\n        # Periodically optimize all to stay on the local optimum manifold\n        if step > 0 and step % 100 == 0:\n            optimize_all(congr_dict, cnt_array)\n            n_res = int((cnt_array == 0).sum())\n            current_D = calc_D_val(n_res, logm, logboost)\n\n        action = random.choices([\'add\', \'drop\', \'swap\', \'optimize\'], weights=[0.25, 0.20, 0.45, 0.10], k=1)[0]\n\n        if action == \'add\':\n            cand_pool = [m for m in cand_mods if m not in congr_dict]\n            if cand_pool:\n                sampled = random.sample(cand_pool, min(100, len(cand_pool)))\n                best_r = None\n                best_a = None\n                best_new_D = float(\'inf\')\n                best_new_n_res = n_res\n                \n                uncovered = (cnt_array == 0)\n                for r in sampled:\n                    rem = mod_cache[r]\n                    counts = np.bincount(rem, weights=uncovered, minlength=r)\n                    a = int(np.argmax(counts))\n                    \n                    added_cov = counts[a]\n                    new_n_res = n_res - added_cov\n                    new_logm = logm + math.log(r)\n                    new_logboost = logboost + math.log(r / (r - 1))\n                    new_D = calc_D_val(new_n_res, new_logm, new_logboost)\n                    if new_D < best_new_D:\n                        best_new_D = new_D\n                        best_r = r\n                        best_a = a\n                        best_new_n_res = new_n_res\n                        \n                if best_r is not None:\n                    delta = best_new_D - current_D\n                    if delta < 0 or random.random() < math.exp(-delta / temp):\n                        congr_dict[best_r] = best_a\n                        cnt_array[mod_cache[best_r] == best_a] += 1\n                        n_res = best_new_n_res\n                        logm += math.log(best_r)\n                        logboost += math.log(best_r / (best_r - 1))\n                        current_D = best_new_D\n\n        elif action == \'drop\':\n            active = list(congr_dict.keys())\n            if active:\n                best_r = None\n                best_new_D = float(\'inf\')\n                best_new_n_res = n_res\n                \n                singly_covered = (cnt_array == 1)\n                for r in active:\n                    a = congr_dict[r]\n                    rem = mod_cache[r]\n                    lost_cov = np.sum(singly_covered & (rem == a))\n                    new_n_res = n_res + lost_cov\n                    new_logm = logm - math.log(r)\n                    new_logboost = logboost - math.log(r / (r - 1))\n                    new_D = calc_D_val(new_n_res, new_logm, new_logboost)\n                    if new_D < best_new_D:\n                        best_new_D = new_D\n                        best_r = r\n                        best_new_n_res = new_n_res\n                        \n                if best_r is not None:\n                    delta = best_new_D - current_D\n                    if delta < 0 or random.random() < math.exp(-delta / temp):\n                        r_drop = best_r\n                        a_drop = congr_dict[r_drop]\n                        cnt_array[mod_cache[r_drop] == a_drop] -= 1\n                        del congr_dict[r_drop]\n                        n_res = best_new_n_res\n                        logm -= math.log(r_drop)\n                        logboost -= math.log(r_drop / (r_drop - 1))\n                        current_D = best_new_D\n\n        elif action == \'swap\':\n            active = list(congr_dict.keys())\n            cand_pool = [m for m in cand_mods if m not in congr_dict]\n            if active and cand_pool:\n                singly_covered = (cnt_array == 1)\n                drop_candidates = []\n                for r in active:\n                    a = congr_dict[r]\n                    rem = mod_cache[r]\n                    lost_cov = np.sum(singly_covered & (rem == a))\n                    new_n_res = n_res + lost_cov\n                    new_logm = logm - math.log(r)\n                    new_logboost = logboost - math.log(r / (r - 1))\n                    new_D = calc_D_val(new_n_res, new_logm, new_logboost)\n                    drop_candidates.append((new_D, r, a, new_n_res, new_logm, new_logboost))\n                \n                drop_candidates.sort(key=lambda x: x[0])\n                top_drops = drop_candidates[:3]\n                \n                best_swap_D = float(\'inf\')\n                best_swap_r_drop = None\n                best_swap_r_add = None\n                best_swap_a_add = None\n                best_swap_n_res = None\n                best_swap_logm = None\n                best_swap_logboost = None\n                \n                sampled_add = random.sample(cand_pool, min(60, len(cand_pool)))\n                \n                for D_drop, r_drop, a_drop, n_res_drop, logm_drop, logboost_drop in top_drops:\n                    rem_drop = mod_cache[r_drop]\n                    uncovered_after_drop = (cnt_array == 0) | ((cnt_array == 1) & (rem_drop == a_drop))\n                    \n                    for r_add in sampled_add:\n                        rem_add = mod_cache[r_add]\n                        counts = np.bincount(rem_add, weights=uncovered_after_drop, minlength=r_add)\n                        a_add = int(np.argmax(counts))\n                        added_cov = counts[a_add]\n                        \n                        new_n_res = n_res_drop - added_cov\n                        new_logm = logm_drop + math.log(r_add)\n                        new_logboost = logboost_drop + math.log(r_add / (r_add - 1))\n                        \n                        new_D = calc_D_val(new_n_res, new_logm, new_logboost)\n                        if new_D < best_swap_D:\n                            best_swap_D = new_D\n                            best_swap_r_drop = r_drop\n                            best_swap_r_add = r_add\n                            best_swap_a_add = a_add\n                            best_swap_n_res = new_n_res\n                            best_swap_logm = new_logm\n                            best_swap_logboost = new_logboost\n                            \n                if best_swap_r_drop is not None:\n                    delta = best_swap_D - current_D\n                    if delta < 0 or random.random() < math.exp(-delta / temp):\n                        r_drop = best_swap_r_drop\n                        a_drop = congr_dict[r_drop]\n                        r_add = best_swap_r_add\n                        a_add = best_swap_a_add\n                        \n                        cnt_array[mod_cache[r_drop] == a_drop] -= 1\n                        cnt_array[mod_cache[r_add] == a_add] += 1\n                        \n                        del congr_dict[r_drop]\n                        congr_dict[r_add] = a_add\n                        \n                        n_res = best_swap_n_res\n                        logm = best_swap_logm\n                        logboost = best_swap_logboost\n                        current_D = best_swap_D\n\n        elif action == \'optimize\':\n            active = list(congr_dict.keys())\n            if active:\n                sampled = random.sample(active, min(15, len(active)))\n                for r in sampled:\n                    a_old = congr_dict[r]\n                    rem = mod_cache[r]\n                    cnt_array[rem == a_old] -= 1\n                    \n                    counts = np.bincount(rem, weights=(cnt_array == 0), minlength=r)\n                    a_new = int(np.argmax(counts))\n                    \n                    cnt_array[rem == a_new] += 1\n                    congr_dict[r] = a_new\n                    \n                n_res = int((cnt_array == 0).sum())\n                current_D = calc_D_val(n_res, logm, logboost)\n\n    # Final cleanup to ensure absolute optimality of residues\n    optimize_all(congr_dict, cnt_array)\n    return congr_dict\n# EVOLVE-BLOCK-END\n\ndef evaluate(eval_inputs: Mapping[str, Any]) -> dict[str, float]:\n    """Run evaluation on the optimized step."""\n    import sympy\n    import numpy as np\n    Q = 100003\n    targets = np.array(list(sympy.primerange(3, Q)), dtype=np.int64)\n    \n    # Warm-start from the 195-digit record cover instead of starting empty\n    congr_dict = {int(r): int(a) for r, a in eval_inputs["warm_start_cover"]}\n    \n    cand_mods = [int(r) for r in sympy.primerange(3, 8000)]\n    cnt_array = np.zeros(len(targets), dtype=np.int16)\n    \n    # Pre-populate counts\n    for r, a in congr_dict.items():\n        cnt_array += (targets % r) == a\n        \n    for it in range(10):\n        t_temp = 0.8 * (0.02 / 0.8) ** (it / 10)\n        # Recalculate cnt_array based on congr_dict\n        cnt_array = np.zeros(len(targets), dtype=np.int16)\n        logm = math.log(2)\n        logboost = math.log(2.0)\n        for r, a in congr_dict.items():\n            cnt_array += (targets % r) == a\n            logm += math.log(r)\n            logboost += math.log(r / (r - 1))\n            \n        congr_dict = optimize_cover_step(congr_dict, cand_mods, targets, cnt_array, logm, logboost, t_temp)\n        \n    # Recalculate final metrics\n    cnt_array = np.zeros(len(targets), dtype=np.int16)\n    logm = math.log(2)\n    logboost = math.log(2.0)\n    for r, a in congr_dict.items():\n        cnt_array += (targets % r) == a\n        logm += math.log(r)\n        logboost += math.log(r / (r - 1))\n        \n    n_res = int((cnt_array == 0).sum())\n    boost = math.exp(logboost)\n    m_digits = logm / math.log(10)\n    \n    ub = n_res * boost\n    LN10 = math.log(10)\n    D = (m_digits + math.sqrt(m_digits ** 2 + 4 * ub / (LN10 * LN10))) / 2\n    \n    # Constrain E <= 17.5 via Lagrangian penalty to prevent reward hacking\n    E_limit = 17.5\n    E_actual = ub / (D * LN10) if D > 0 else 0.0\n    lagrangian_penalty = 0.0\n    if E_actual > E_limit:\n        lagrangian_penalty = 100.0 * (E_actual - E_limit) ** 2\n        \n    score_headline = -float(D + lagrangian_penalty)\n    \n    # Expose E, |U|, digits(M) as negated secondary metrics for joint optimization visibility\n    return {\n        "neg_est_digits": score_headline,\n        "neg_E": -float(E_actual),\n        "neg_residual_count": -float(n_res),\n        "neg_m_digits": -float(m_digits)\n    }\n'}]}, 'evaluation': {'scores': {'scores': [{'metric': 'neg_est_digits', 'score': -194.89795}, {'metric': 'neg_E', 'score': -17.406656}, {'metric': 'neg_residual_count', 'score': -734}, {'metric': 'neg_m_digits', 'score': -187.33833}]}, 'insights': {'insights': [{'label': 'Evaluation Metrics', 'text': 'Estimated Digits: 194.8979 (constrained), E: 17.4067, |U|: 734, digits(M): 187.34'}]}}, 'parentPrograms': ['projects/799795028847/locations/global/collections/default_collection/engines/goldbach_1784979910032/sessions/7658735534374771723/alphaEvolveExperiments/9582896010645531772/alphaEvolvePrograms/7662895210918132141', 'projects/799795028847/locations/global/collections/default_collection/engines/goldbach_1784979910032/sessions/7658735534374771723/alphaEvolveExperiments/9582896010645531772/alphaEvolvePrograms/7662895210918131403', 'projects/799795028847/locations/global/collections/default_collection/engines/goldbach_1784979910032/sessions/7658735534374771723/alphaEvolveExperiments/9582896010645531772/alphaEvolvePrograms/7662895210918131403', 'projects/799795028847/locations/global/collections/default_collection/engines/goldbach_1784979910032/sessions/7658735534374771723/alphaEvolveExperiments/9582896010645531772/alphaEvolvePrograms/7662895210918129792'], 'state': 'COMPLETED'}, {'name': 'projects/799795028847/locations/global/collections/default_collection/engines/goldbach_1784979910032/sessions/7658735534374771723/alphaEvolveExperiments/9582896010645531772/alphaEvolvePrograms/6680257159901447396', 'createTime': '2026-07-26T10:13:26.665379Z', 'content': {'files': [{'path': 'program.py', 'content': '# Copyright 2026 Google LLC\nfrom typing import Any, Mapping\nimport math\nimport random\nimport numpy as np\n\n# EVOLVE-BLOCK-START\ndef optimize_cover_step(congr_dict, cand_mods, targets, cnt_array, logm, logboost, t_temp):\n    """Optimize congruence cover using simulated annealing and greedy hill-climbing."""\n    import numpy as np\n    import random\n    import math\n\n    if len(targets) == 0:\n        return congr_dict\n\n    LN10 = math.log(10)\n    LN10_SQ = LN10 * LN10\n\n    # Precompute modulo tables for all candidate and current moduli\n    all_mods = set(cand_mods) | set(congr_dict.keys())\n    targets_mod_r = {r: targets % r for r in all_mods}\n\n    # Precompute weights for biased sampling (smaller primes preferred)\n    cand_weights = [1.0 / (r ** 0.8) for r in cand_mods]\n    cand_to_weight = dict(zip(cand_mods, cand_weights))\n\n    # Initialize or retrieve dynamic bandit multipliers to preserve learning across steps\n    if not hasattr(optimize_cover_step, "cand_mult") or len(optimize_cover_step.cand_mult) != len(cand_mods):\n        optimize_cover_step.cand_mult = {r: 1.0 for r in cand_mods}\n    else:\n        # Soft decay of bandit multipliers towards 1.0 to maintain search plasticity\n        for r in optimize_cover_step.cand_mult:\n            optimize_cover_step.cand_mult[r] = 0.9 * optimize_cover_step.cand_mult[r] + 0.1 * 1.0\n            \n    cand_mult = optimize_cover_step.cand_mult\n\n    def get_score_metrics(n_res, lm, lboost, penalty_w=100.0):\n        boost = math.exp(lboost)\n        m_digits = lm / LN10\n        ub = n_res * boost\n        D = (m_digits + math.sqrt(m_digits ** 2 + 4 * ub / LN10_SQ)) / 2\n        E_actual = ub / (D * LN10) if D > 0 else 0.0\n        lagrangian_penalty = 0.0\n        if E_actual > 17.5:\n            lagrangian_penalty = penalty_w * (E_actual - 17.5) ** 2\n        return -(D + lagrangian_penalty)\n\n    # Initialize current state\n    current_congr = congr_dict.copy()\n    current_cnt = cnt_array.copy()\n    current_logm = logm\n    current_logboost = logboost\n    current_n_res = np.count_nonzero(current_cnt == 0)\n    \n    best_congr = current_congr.copy()\n    best_score = get_score_metrics(current_n_res, current_logm, current_logboost, penalty_w=100.0)\n    \n    temp = max(t_temp, 1e-6)\n    sa_penalty_weight = 50.0 + 3.0 / temp\n    \n    current_score = get_score_metrics(current_n_res, current_logm, current_logboost, penalty_w=sa_penalty_weight)\n\n    # 1. Run SA for 6000 steps\n    sa_steps = 6000\n    for step in range(sa_steps):\n        cand_pool = [m for m in cand_mods if m not in current_congr]\n        \n        if not current_congr:\n            move_type = \'add\'\n        elif not cand_pool:\n            move_type = random.choice([\'drop\', \'mutate_a\'])\n        else:\n            move_type = random.choice([\'add\', \'drop\', \'swap\', \'swap\', \'mutate_a\', \'mutate_a\'])\n            \n        accepted = False\n        \n        if move_type == \'add\':\n            weights = [cand_to_weight[r] * cand_mult[r] for r in cand_pool]\n            raw_cands = random.choices(cand_pool, weights=weights, k=50)\n            cands = list(set(raw_cands))[:20]\n            \n            uncovered_indices = np.nonzero(current_cnt == 0)[0]\n            \n            best_r, best_a, max_cov = cands[0], 0, -1\n            for r in cands:\n                rem = targets_mod_r[r][uncovered_indices]\n                if len(rem) == 0:\n                    a = random.randint(0, r - 1)\n                    cov = 0\n                else:\n                    counts = np.bincount(rem, minlength=r)\n                    a = np.argmax(counts)\n                    cov = counts[a]\n                if cov > max_cov:\n                    max_cov = cov\n                    best_r = r\n                    best_a = a\n                    \n            r = best_r\n            a = best_a\n            cov_count = max_cov\n                \n            logm_new = current_logm + math.log(r)\n            logboost_new = current_logboost + math.log(r / (r - 1))\n            n_res_new = current_n_res - cov_count\n            \n            score_new = get_score_metrics(n_res_new, logm_new, logboost_new, penalty_w=sa_penalty_weight)\n            delta = score_new - current_score\n            if delta > 0 or random.random() < math.exp(delta / temp):\n                current_congr[r] = int(a)\n                current_cnt += (targets_mod_r[r] == a)\n                current_logm = logm_new\n                current_logboost = logboost_new\n                current_n_res = n_res_new\n                current_score = score_new\n                accepted = True\n                # Bandit feedback\n                cand_mult[r] = min(cand_mult[r] * 1.2, 10.0)\n                \n        elif move_type == \'drop\':\n            r = random.choice(list(current_congr.keys()))\n            a = current_congr[r]\n            \n            logm_new = current_logm - math.log(r)\n            logboost_new = current_logboost - math.log(r / (r - 1))\n            \n            is_cov = (targets_mod_r[r] == a)\n            unique_cov = np.count_nonzero((current_cnt == 1) & is_cov)\n            n_res_new = current_n_res + unique_cov\n            \n            score_new = get_score_metrics(n_res_new, logm_new, logboost_new, penalty_w=sa_penalty_weight)\n            delta = score_new - current_score\n            if delta > 0 or random.random() < math.exp(delta / temp):\n                current_cnt -= is_cov\n                del current_congr[r]\n                current_logm = logm_new\n                current_logboost = logboost_new\n                current_n_res = n_res_new\n                current_score = score_new\n                accepted = True\n                # Bandit feedback\n                cand_mult[r] = max(cand_mult[r] * 0.8, 0.1)\n                \n        elif move_type == \'swap\':\n            r_drop = random.choice(list(current_congr.keys()))\n            a_drop = current_congr[r_drop]\n            \n            is_cov_drop = (targets_mod_r[r_drop] == a_drop)\n            cnt_temp = current_cnt - is_cov_drop\n            uncovered_indices = np.nonzero(cnt_temp == 0)[0]\n            n_uncovered = len(uncovered_indices)\n            \n            weights = [cand_to_weight[r] * cand_mult[r] for r in cand_pool]\n            raw_cands = random.choices(cand_pool, weights=weights, k=50)\n            cands = list(set(raw_cands))[:20]\n                    \n            best_r_add, best_a_add, max_cov = cands[0], 0, -1\n            for r in cands:\n                rem = targets_mod_r[r][uncovered_indices]\n                if len(rem) == 0:\n                    a = random.randint(0, r - 1)\n                    cov = 0\n                else:\n                    counts = np.bincount(rem, minlength=r)\n                    a = np.argmax(counts)\n                    cov = counts[a]\n                if cov > max_cov:\n                    max_cov = cov\n                    best_r_add = r\n                    best_a_add = a\n                    \n            r_add = best_r_add\n            a_add = best_a_add\n            cov_count = max_cov\n                \n            n_res_new = n_uncovered - cov_count\n            logm_new = current_logm - math.log(r_drop) + math.log(r_add)\n            logboost_new = current_logboost - math.log(r_drop / (r_drop - 1)) + math.log(r_add / (r_add - 1))\n            \n            score_new = get_score_metrics(n_res_new, logm_new, logboost_new, penalty_w=sa_penalty_weight)\n            delta = score_new - current_score\n            if delta > 0 or random.random() < math.exp(delta / temp):\n                current_cnt -= is_cov_drop\n                del current_congr[r_drop]\n                \n                current_congr[r_add] = int(a_add)\n                current_cnt += (targets_mod_r[r_add] == a_add)\n                current_logm = logm_new\n                current_logboost = logboost_new\n                current_n_res = n_res_new\n                current_score = score_new\n                accepted = True\n                # Bandit feedback\n                cand_mult[r_add] = min(cand_mult[r_add] * 1.2, 10.0)\n                cand_mult[r_drop] = max(cand_mult[r_drop] * 0.8, 0.1)\n                \n        elif move_type == \'mutate_a\':\n            r = random.choice(list(current_congr.keys()))\n            a_old = current_congr[r]\n            \n            is_cov_old = (targets_mod_r[r] == a_old)\n            cnt_temp = current_cnt - is_cov_old\n            uncovered_indices = np.nonzero(cnt_temp == 0)[0]\n            \n            rem = targets_mod_r[r][uncovered_indices]\n            if len(rem) > 0:\n                counts = np.bincount(rem, minlength=r)\n                counts[a_old] = -1\n                a_new = np.argmax(counts)\n            else:\n                a_new = random.choice([i for i in range(r) if i != a_old])\n                \n            is_cov_new = (targets_mod_r[r] == a_new)\n            cnt_new = cnt_temp + is_cov_new\n            n_res_new = np.count_nonzero(cnt_new == 0)\n            \n            score_new = get_score_metrics(n_res_new, current_logm, current_logboost, penalty_w=sa_penalty_weight)\n            delta = score_new - current_score\n            if delta > 0 or random.random() < math.exp(delta / temp):\n                current_cnt[:] = cnt_new\n                current_congr[r] = int(a_new)\n                current_n_res = n_res_new\n                current_score = score_new\n                accepted = True\n                    \n        if accepted:\n            real_score = get_score_metrics(current_n_res, current_logm, current_logboost, penalty_w=100.0)\n            if real_score > best_score:\n                best_score = real_score\n                best_congr = current_congr.copy()\n\n    # 2. Run greedy hill-climbing polish starting from the best cover found\n    current_congr = best_congr.copy()\n    current_cnt = np.zeros(len(targets), dtype=np.int16)\n    current_logm = math.log(2)\n    current_logboost = math.log(2.0)\n    for r, a in current_congr.items():\n        current_cnt += (targets_mod_r[r] == a)\n        current_logm += math.log(r)\n        current_logboost += math.log(r / (r - 1))\n    current_n_res = np.count_nonzero(current_cnt == 0)\n\n    def sweep_remainders():\n        nonlocal current_n_res\n        sweep_improved = True\n        while sweep_improved:\n            sweep_improved = False\n            for r in list(current_congr.keys()):\n                a_old = current_congr[r]\n                is_cov = (targets_mod_r[r] == a_old)\n                cnt_bg = current_cnt - is_cov\n                uncovered_indices = np.nonzero(cnt_bg == 0)[0]\n                rem_uncovered = targets_mod_r[r][uncovered_indices]\n                if len(rem_uncovered) > 0:\n                    counts = np.bincount(rem_uncovered, minlength=r)\n                    a_new = np.argmax(counts)\n                else:\n                    a_new = a_old\n                    \n                if a_new != a_old:\n                    current_congr[r] = int(a_new)\n                    current_cnt[:] = cnt_bg + (targets_mod_r[r] == a_new)\n                    current_n_res = np.count_nonzero(current_cnt == 0)\n                    sweep_improved = True\n\n    # Run initial sweep to make sure remainders are perfectly optimal\n    sweep_remainders()\n    best_score = get_score_metrics(current_n_res, current_logm, current_logboost, penalty_w=100.0)\n    best_congr = current_congr.copy()\n\n    for polish_iter in range(15):\n        improved = False\n        \n        # Try adding a modulus greedily (biased towards smaller primes)\n        best_add_r = None\n        best_add_a = None\n        best_add_score = -float(\'inf\')\n        \n        cand_pool = [r for r in cand_mods if r not in current_congr]\n        sampled_cands = cand_pool\n            \n        uncovered_indices = np.nonzero(current_cnt == 0)[0]\n        \n        for r in sampled_cands:\n            rem = targets_mod_r[r][uncovered_indices]\n            if len(rem) == 0:\n                a = 0\n                n_res_new = current_n_res\n            else:\n                counts = np.bincount(rem, minlength=r)\n                a = np.argmax(counts)\n                n_res_new = current_n_res - counts[a]\n                \n            logm_new = current_logm + math.log(r)\n            logboost_new = current_logboost + math.log(r / (r - 1))\n            score_new = get_score_metrics(n_res_new, logm_new, logboost_new, penalty_w=100.0)\n            if score_new > best_add_score:\n                best_add_score = score_new\n                best_add_r = r\n                best_add_a = a\n                \n        if best_add_score > best_score:\n            r = best_add_r\n            a = best_add_a\n            current_congr[r] = int(a)\n            current_cnt += (targets_mod_r[r] == a)\n            current_logm += math.log(r)\n            current_logboost += math.log(r / (r - 1))\n            current_n_res = np.count_nonzero(current_cnt == 0)\n            \n            sweep_remainders()\n            best_score = get_score_metrics(current_n_res, current_logm, current_logboost, penalty_w=100.0)\n            best_congr = current_congr.copy()\n            improved = True\n            # Bandit feedback\n            cand_mult[r] = min(cand_mult[r] * 1.3, 10.0)\n            \n        # Try dropping a modulus greedily\n        best_drop_r = None\n        best_drop_score = -float(\'inf\')\n        for r in list(current_congr.keys()):\n            a = current_congr[r]\n            is_cov = (targets_mod_r[r] == a)\n            unique_cov = np.count_nonzero((current_cnt == 1) & is_cov)\n            n_res_new = current_n_res + unique_cov\n            \n            logm_new = current_logm - math.log(r)\n            logboost_new = current_logboost - math.log(r / (r - 1))\n            score_new = get_score_metrics(n_res_new, logm_new, logboost_new, penalty_w=100.0)\n            if score_new > best_drop_score:\n                best_drop_score = score_new\n                best_drop_r = r\n                \n        if best_drop_score > best_score:\n            r = best_drop_r\n            a = current_congr[r]\n            current_cnt -= (targets_mod_r[r] == a)\n            del current_congr[r]\n            current_logm -= math.log(r)\n            current_logboost -= math.log(r / (r - 1))\n            current_n_res = np.count_nonzero(current_cnt == 0)\n            \n            sweep_remainders()\n            best_score = get_score_metrics(current_n_res, current_logm, current_logboost, penalty_w=100.0)\n            best_congr = current_congr.copy()\n            improved = True\n            # Bandit feedback\n            cand_mult[r] = max(cand_mult[r] * 0.7, 0.1)\n            \n        # Try swapping greedily (targeting the weak elements with lowest unique coverage)\n        best_swap_r_drop = None\n        best_swap_r_add = None\n        best_swap_a_add = None\n        best_swap_score = -float(\'inf\')\n        \n        cover_keys = list(current_congr.keys())\n        if len(cover_keys) <= 12:\n            sampled_drops = cover_keys\n        else:\n            # Sort by unique coverage\n            uc_list = []\n            for r in cover_keys:\n                a = current_congr[r]\n                is_cov = (targets_mod_r[r] == a)\n                uc = np.count_nonzero((current_cnt == 1) & is_cov)\n                uc_list.append((uc, r))\n            uc_list.sort()\n            sampled_drops = [r for uc, r in uc_list[:12]]\n        \n        for r_drop in sampled_drops:\n            a_drop = current_congr[r_drop]\n            is_cov_drop = (targets_mod_r[r_drop] == a_drop)\n            cnt_temp = current_cnt - is_cov_drop\n            uncovered_indices = np.nonzero(cnt_temp == 0)[0]\n            n_uncovered = len(uncovered_indices)\n            \n            cand_pool = [r for r in cand_mods if r not in current_congr and r != r_drop]\n            if cand_pool:\n                weights = [cand_to_weight[r] * cand_mult[r] for r in cand_pool]\n                raw_cands = random.choices(cand_pool, weights=weights, k=400)\n                sampled_adds = list(set(raw_cands))[:200]\n            else:\n                sampled_adds = []\n                \n            for r_add in sampled_adds:\n                rem = targets_mod_r[r_add][uncovered_indices]\n                if len(rem) == 0:\n                    a_add = 0\n                    n_res_new = n_uncovered\n                else:\n                    counts = np.bincount(rem, minlength=r_add)\n                    a_add = np.argmax(counts)\n                    n_res_new = n_uncovered - counts[a_add]\n                    \n                logm_new = current_logm - math.log(r_drop) + math.log(r_add)\n                logboost_new = current_logboost - math.log(r_drop / (r_drop - 1)) + math.log(r_add / (r_add - 1))\n                score_new = get_score_metrics(n_res_new, logm_new, logboost_new, penalty_w=100.0)\n                if score_new > best_swap_score:\n                    best_swap_score = score_new\n                    best_swap_r_drop = r_drop\n                    best_swap_r_add = r_add\n                    best_swap_a_add = a_add\n                    \n        if best_swap_score > best_score:\n            r_drop = best_swap_r_drop\n            r_add = best_swap_r_add\n            a_add = best_swap_a_add\n            \n            a_drop = current_congr[r_drop]\n            current_cnt -= (targets_mod_r[r_drop] == a_drop)\n            del current_congr[r_drop]\n            \n            current_congr[r_add] = int(a_add)\n            current_cnt += (targets_mod_r[r_add] == a_add)\n            \n            current_logm += -math.log(r_drop) + math.log(r_add)\n            current_logboost += -math.log(r_drop / (r_drop - 1)) + math.log(r_add / (r_add - 1))\n            current_n_res = np.count_nonzero(current_cnt == 0)\n            \n            sweep_remainders()\n            best_score = get_score_metrics(current_n_res, current_logm, current_logboost, penalty_w=100.0)\n            best_congr = current_congr.copy()\n            improved = True\n            # Bandit feedback\n            cand_mult[r_add] = min(cand_mult[r_add] * 1.3, 10.0)\n            cand_mult[r_drop] = max(cand_mult[r_drop] * 0.7, 0.1)\n            \n        if not improved:\n            break\n            \n    return best_congr\n# EVOLVE-BLOCK-END\n\ndef evaluate(eval_inputs: Mapping[str, Any]) -> dict[str, float]:\n    """Run evaluation on the optimized step."""\n    import sympy\n    import numpy as np\n    Q = 100003\n    targets = np.array(list(sympy.primerange(3, Q)), dtype=np.int64)\n    \n    # Warm-start from the 195-digit record cover instead of starting empty\n    congr_dict = {int(r): int(a) for r, a in eval_inputs["warm_start_cover"]}\n    \n    cand_mods = [int(r) for r in sympy.primerange(3, 8000)]\n    cnt_array = np.zeros(len(targets), dtype=np.int16)\n    \n    # Pre-populate counts\n    for r, a in congr_dict.items():\n        cnt_array += (targets % r) == a\n        \n    for it in range(10):\n        t_temp = 0.8 * (0.02 / 0.8) ** (it / 10)\n        # Recalculate cnt_array based on congr_dict\n        cnt_array = np.zeros(len(targets), dtype=np.int16)\n        logm = math.log(2)\n        logboost = math.log(2.0)\n        for r, a in congr_dict.items():\n            cnt_array += (targets % r) == a\n            logm += math.log(r)\n            logboost += math.log(r / (r - 1))\n            \n        congr_dict = optimize_cover_step(congr_dict, cand_mods, targets, cnt_array, logm, logboost, t_temp)\n        \n    # Recalculate final metrics\n    cnt_array = np.zeros(len(targets), dtype=np.int16)\n    logm = math.log(2)\n    logboost = math.log(2.0)\n    for r, a in congr_dict.items():\n        cnt_array += (targets % r) == a\n        logm += math.log(r)\n        logboost += math.log(r / (r - 1))\n        \n    n_res = int((cnt_array == 0).sum())\n    boost = math.exp(logboost)\n    m_digits = logm / math.log(10)\n    \n    ub = n_res * boost\n    LN10 = math.log(10)\n    D = (m_digits + math.sqrt(m_digits ** 2 + 4 * ub / (LN10 * LN10))) / 2\n    \n    # Constrain E <= 17.5 via Lagrangian penalty to prevent reward hacking\n    E_limit = 17.5\n    E_actual = ub / (D * LN10) if D > 0 else 0.0\n    lagrangian_penalty = 0.0\n    if E_actual > E_limit:\n        lagrangian_penalty = 100.0 * (E_actual - E_limit) ** 2\n        \n    score_headline = -float(D + lagrangian_penalty)\n    \n    # Expose E, |U|, digits(M) as negated secondary metrics for joint optimization visibility\n    return {\n        "neg_est_digits": score_headline,\n        "neg_E": -float(E_actual),\n        "neg_residual_count": -float(n_res),\n        "neg_m_digits": -float(m_digits)\n    }\n'}]}, 'evaluation': {'scores': {'scores': [{'metric': 'neg_est_digits', 'score': -194.90706}, {'metric': 'neg_E', 'score': -17.422125}, {'metric': 'neg_residual_count', 'score': -711}, {'metric': 'neg_m_digits', 'score': -187.34073}]}, 'insights': {'insights': [{'label': 'Evaluation Metrics', 'text': 'Estimated Digits: 194.9071 (constrained), E: 17.4221, |U|: 711, digits(M): 187.34'}]}}, 'parentPrograms': ['projects/799795028847/locations/global/collections/default_collection/engines/goldbach_1784979910032/sessions/7658735534374771723/alphaEvolveExperiments/9582896010645531772/alphaEvolvePrograms/11597998738524453658'], 'state': 'COMPLETED'}, {'name': 'projects/799795028847/locations/global/collections/default_collection/engines/goldbach_1784979910032/sessions/7658735534374771723/alphaEvolveExperiments/9582896010645531772/alphaEvolvePrograms/7662895210918131074', 'createTime': '2026-07-26T06:02:54.534411Z', 'content': {'files': [{'path': 'program.py', 'content': '# Copyright 2026 Google LLC\nfrom typing import Any, Mapping\nimport math\nimport random\nimport numpy as np\n\n# EVOLVE-BLOCK-START\ndef optimize_cover_step(congr_dict, cand_mods, targets, cnt_array, logm, logboost, t_temp):\n    """Optimize congruence cover using simulated annealing and greedy hill-climbing."""\n    import numpy as np\n    import random\n    import math\n\n    if len(targets) == 0:\n        return congr_dict\n\n    LN10 = math.log(10)\n    LN10_SQ = LN10 * LN10\n\n    def get_score_metrics(n_res, lm, lboost):\n        boost = math.exp(lboost)\n        m_digits = lm / LN10\n        ub = n_res * boost\n        D = (m_digits + math.sqrt(m_digits ** 2 + 4 * ub / LN10_SQ)) / 2\n        E_actual = ub / (D * LN10) if D > 0 else 0.0\n        lagrangian_penalty = 0.0\n        if E_actual > 17.5:\n            lagrangian_penalty = 100.0 * (E_actual - 17.5) ** 2\n        return -(D + lagrangian_penalty)\n\n    # Initialize current state\n    current_congr = congr_dict.copy()\n    current_cnt = cnt_array.copy()\n    current_logm = logm\n    current_logboost = logboost\n    current_n_res = np.count_nonzero(current_cnt == 0)\n    \n    best_congr = current_congr.copy()\n    best_score = get_score_metrics(current_n_res, current_logm, current_logboost)\n    \n    temp = max(t_temp, 1e-6)\n    \n    # 1. Run SA for 2000 steps\n    sa_steps = 2000\n    for step in range(sa_steps):\n        cand_pool = [m for m in cand_mods if m not in current_congr]\n        \n        if not current_congr:\n            move_type = \'add\'\n        elif not cand_pool:\n            move_type = random.choice([\'drop\', \'mutate_a\'])\n        else:\n            move_type = random.choice([\'add\', \'drop\', \'swap\', \'swap\', \'mutate_a\', \'mutate_a\'])\n            \n        accepted = False\n        \n        if move_type == \'add\':\n            cands = random.sample(cand_pool, min(3, len(cand_pool)))\n            uncovered_indices = (current_cnt == 0)\n            targets_uncovered = targets[uncovered_indices]\n            \n            best_r, best_a, max_cov = cands[0], 0, -1\n            for r in cands:\n                rem = targets_uncovered % r\n                if len(rem) == 0:\n                    a = random.randint(0, r - 1)\n                    cov = 0\n                else:\n                    counts = np.bincount(rem, minlength=r)\n                    a = np.argmax(counts)\n                    cov = counts[a]\n                if cov > max_cov:\n                    max_cov = cov\n                    best_r = r\n                    best_a = a\n                    \n            r = best_r\n            a = best_a\n            cov_count = max_cov\n                \n            logm_new = current_logm + math.log(r)\n            logboost_new = current_logboost + math.log(r / (r - 1))\n            n_res_new = current_n_res - cov_count\n            \n            score_new = get_score_metrics(n_res_new, logm_new, logboost_new)\n            delta = score_new - get_score_metrics(current_n_res, current_logm, current_logboost)\n            if delta > 0 or random.random() < math.exp(delta / temp):\n                current_congr[r] = int(a)\n                current_cnt += (targets % r) == a\n                current_logm = logm_new\n                current_logboost = logboost_new\n                current_n_res = n_res_new\n                accepted = True\n                \n        elif move_type == \'drop\':\n            r = random.choice(list(current_congr.keys()))\n            a = current_congr[r]\n            \n            logm_new = current_logm - math.log(r)\n            logboost_new = current_logboost - math.log(r / (r - 1))\n            \n            is_cov = (targets % r) == a\n            unique_cov = np.count_nonzero((current_cnt == 1) & is_cov)\n            n_res_new = current_n_res + unique_cov\n            \n            score_new = get_score_metrics(n_res_new, logm_new, logboost_new)\n            delta = score_new - get_score_metrics(current_n_res, current_logm, current_logboost)\n            if delta > 0 or random.random() < math.exp(delta / temp):\n                current_cnt -= is_cov\n                del current_congr[r]\n                current_logm = logm_new\n                current_logboost = logboost_new\n                current_n_res = n_res_new\n                accepted = True\n                \n        elif move_type == \'swap\':\n            r_drop = random.choice(list(current_congr.keys()))\n            a_drop = current_congr[r_drop]\n            \n            is_cov_drop = (targets % r_drop) == a_drop\n            cnt_temp = current_cnt - is_cov_drop\n            uncovered_temp = (cnt_temp == 0)\n            targets_uncovered = targets[uncovered_temp]\n            \n            cands = random.sample(cand_pool, min(3, len(cand_pool)))\n            best_r_add, best_a_add, max_cov = cands[0], 0, -1\n            for r in cands:\n                rem = targets_uncovered % r\n                if len(rem) == 0:\n                    a = random.randint(0, r - 1)\n                    cov = 0\n                else:\n                    counts = np.bincount(rem, minlength=r)\n                    a = np.argmax(counts)\n                    cov = counts[a]\n                if cov > max_cov:\n                    max_cov = cov\n                    best_r_add = r\n                    best_a_add = a\n                    \n            r_add = best_r_add\n            a_add = best_a_add\n            cov_count = max_cov\n                \n            n_res_new = np.count_nonzero(uncovered_temp) - cov_count\n            logm_new = current_logm - math.log(r_drop) + math.log(r_add)\n            logboost_new = current_logboost - math.log(r_drop / (r_drop - 1)) + math.log(r_add / (r_add - 1))\n            \n            score_new = get_score_metrics(n_res_new, logm_new, logboost_new)\n            delta = score_new - get_score_metrics(current_n_res, current_logm, current_logboost)\n            if delta > 0 or random.random() < math.exp(delta / temp):\n                current_cnt -= is_cov_drop\n                del current_congr[r_drop]\n                \n                current_congr[r_add] = int(a_add)\n                current_cnt += (targets % r_add) == a_add\n                current_logm = logm_new\n                current_logboost = logboost_new\n                current_n_res = n_res_new\n                accepted = True\n                \n        elif move_type == \'mutate_a\':\n            r = random.choice(list(current_congr.keys()))\n            a_old = current_congr[r]\n            \n            is_cov_old = (targets % r) == a_old\n            cnt_temp = current_cnt - is_cov_old\n            uncovered_temp = (cnt_temp == 0)\n            \n            rem = targets[uncovered_temp] % r\n            if len(rem) > 0:\n                counts = np.bincount(rem, minlength=r)\n                counts[a_old] = -1\n                a_new = np.argmax(counts)\n            else:\n                a_new = random.choice([i for i in range(r) if i != a_old])\n                \n            is_cov_new = (targets % r) == a_new\n            cnt_new = cnt_temp + is_cov_new\n            n_res_new = np.count_nonzero(cnt_new == 0)\n            \n            score_new = get_score_metrics(n_res_new, current_logm, current_logboost)\n            delta = score_new - get_score_metrics(current_n_res, current_logm, current_logboost)\n            if delta > 0 or random.random() < math.exp(delta / temp):\n                current_cnt[:] = cnt_new\n                current_congr[r] = int(a_new)\n                current_n_res = n_res_new\n                accepted = True\n                    \n        if accepted:\n            current_score = get_score_metrics(current_n_res, current_logm, current_logboost)\n            if current_score > best_score:\n                best_score = current_score\n                best_congr = current_congr.copy()\n\n    # 2. Run greedy hill-climbing polish starting from the best cover found\n    current_congr = best_congr.copy()\n    current_cnt = np.zeros(len(targets), dtype=np.int16)\n    current_logm = math.log(2)\n    current_logboost = math.log(2.0)\n    for r, a in current_congr.items():\n        current_cnt += (targets % r) == a\n        current_logm += math.log(r)\n        current_logboost += math.log(r / (r - 1))\n    current_n_res = np.count_nonzero(current_cnt == 0)\n    best_score = get_score_metrics(current_n_res, current_logm, current_logboost)\n\n    for polish_iter in range(5):\n        improved = False\n        \n        # Sweep remainder optimization\n        for r in list(current_congr.keys()):\n            a_old = current_congr[r]\n            is_cov = (targets % r) == a_old\n            cnt_bg = current_cnt - is_cov\n            uncovered = (cnt_bg == 0)\n            rem_uncovered = targets[uncovered] % r\n            if len(rem_uncovered) > 0:\n                counts = np.bincount(rem_uncovered, minlength=r)\n                a_new = np.argmax(counts)\n            else:\n                a_new = a_old\n                \n            if a_new != a_old:\n                current_congr[r] = int(a_new)\n                current_cnt[:] = cnt_bg + ((targets % r) == a_new)\n                current_n_res = np.count_nonzero(current_cnt == 0)\n                \n        current_score = get_score_metrics(current_n_res, current_logm, current_logboost)\n        if current_score > best_score:\n            best_score = current_score\n            best_congr = current_congr.copy()\n            improved = True\n            \n        # Try adding a modulus greedily\n        best_add_r = None\n        best_add_a = None\n        best_add_score = -float(\'inf\')\n        \n        cand_pool = [r for r in cand_mods if r not in current_congr]\n        sampled_cands = random.sample(cand_pool, min(400, len(cand_pool))) if cand_pool else []\n        \n        uncovered_indices = (current_cnt == 0)\n        targets_uncovered = targets[uncovered_indices]\n        \n        for r in sampled_cands:\n            rem = targets_uncovered % r\n            if len(rem) == 0:\n                a = 0\n                n_res_new = current_n_res\n            else:\n                counts = np.bincount(rem, minlength=r)\n                a = np.argmax(counts)\n                n_res_new = current_n_res - counts[a]\n                \n            logm_new = current_logm + math.log(r)\n            logboost_new = current_logboost + math.log(r / (r - 1))\n            score_new = get_score_metrics(n_res_new, logm_new, logboost_new)\n            if score_new > best_add_score:\n                best_add_score = score_new\n                best_add_r = r\n                best_add_a = a\n                \n        if best_add_score > best_score:\n            r = best_add_r\n            a = best_add_a\n            current_congr[r] = int(a)\n            current_cnt += (targets % r) == a\n            current_logm += math.log(r)\n            current_logboost += math.log(r / (r - 1))\n            current_n_res = np.count_nonzero(current_cnt == 0)\n            best_score = best_add_score\n            best_congr = current_congr.copy()\n            improved = True\n            \n        # Try dropping a modulus greedily\n        best_drop_r = None\n        best_drop_score = -float(\'inf\')\n        for r in list(current_congr.keys()):\n            a = current_congr[r]\n            is_cov = (targets % r) == a\n            unique_cov = np.count_nonzero((current_cnt == 1) & is_cov)\n            n_res_new = current_n_res + unique_cov\n            \n            logm_new = current_logm - math.log(r)\n            logboost_new = current_logboost - math.log(r / (r - 1))\n            score_new = get_score_metrics(n_res_new, logm_new, logboost_new)\n            if score_new > best_drop_score:\n                best_drop_score = score_new\n                best_drop_r = r\n                \n        if best_drop_score > best_score:\n            r = best_drop_r\n            a = current_congr[r]\n            current_cnt -= (targets % r) == a\n            del current_congr[r]\n            current_logm -= math.log(r)\n            current_logboost -= math.log(r / (r - 1))\n            current_n_res = np.count_nonzero(current_cnt == 0)\n            best_score = best_drop_score\n            best_congr = current_congr.copy()\n            improved = True\n            \n        if not improved:\n            break\n            \n    return best_congr\n# EVOLVE-BLOCK-END\n\ndef evaluate(eval_inputs: Mapping[str, Any]) -> dict[str, float]:\n    """Run evaluation on the optimized step."""\n    import sympy\n    import numpy as np\n    Q = 100003\n    targets = np.array(list(sympy.primerange(3, Q)), dtype=np.int64)\n    \n    # Warm-start from the 195-digit record cover instead of starting empty\n    congr_dict = {int(r): int(a) for r, a in eval_inputs["warm_start_cover"]}\n    \n    cand_mods = [int(r) for r in sympy.primerange(3, 8000)]\n    cnt_array = np.zeros(len(targets), dtype=np.int16)\n    \n    # Pre-populate counts\n    for r, a in congr_dict.items():\n        cnt_array += (targets % r) == a\n        \n    for it in range(10):\n        t_temp = 0.8 * (0.02 / 0.8) ** (it / 10)\n        # Recalculate cnt_array based on congr_dict\n        cnt_array = np.zeros(len(targets), dtype=np.int16)\n        logm = math.log(2)\n        logboost = math.log(2.0)\n        for r, a in congr_dict.items():\n            cnt_array += (targets % r) == a\n            logm += math.log(r)\n            logboost += math.log(r / (r - 1))\n            \n        congr_dict = optimize_cover_step(congr_dict, cand_mods, targets, cnt_array, logm, logboost, t_temp)\n        \n    # Recalculate final metrics\n    cnt_array = np.zeros(len(targets), dtype=np.int16)\n    logm = math.log(2)\n    logboost = math.log(2.0)\n    for r, a in congr_dict.items():\n        cnt_array += (targets % r) == a\n        logm += math.log(r)\n        logboost += math.log(r / (r - 1))\n        \n    n_res = int((cnt_array == 0).sum())\n    boost = math.exp(logboost)\n    m_digits = logm / math.log(10)\n    \n    ub = n_res * boost\n    LN10 = math.log(10)\n    D = (m_digits + math.sqrt(m_digits ** 2 + 4 * ub / (LN10 * LN10))) / 2\n    \n    # Constrain E <= 17.5 via Lagrangian penalty to prevent reward hacking\n    E_limit = 17.5\n    E_actual = ub / (D * LN10) if D > 0 else 0.0\n    lagrangian_penalty = 0.0\n    if E_actual > E_limit:\n        lagrangian_penalty = 100.0 * (E_actual - E_limit) ** 2\n        \n    score_headline = -float(D + lagrangian_penalty)\n    \n    # Expose E, |U|, digits(M) as negated secondary metrics for joint optimization visibility\n    return {\n        "neg_est_digits": score_headline,\n        "neg_E": -float(E_actual),\n        "neg_residual_count": -float(n_res),\n        "neg_m_digits": -float(m_digits)\n    }\n'}]}, 'evaluation': {'scores': {'scores': [{'metric': 'neg_est_digits', 'score': -194.90706}, {'metric': 'neg_E', 'score': -17.422125}, {'metric': 'neg_residual_count', 'score': -711}, {'metric': 'neg_m_digits', 'score': -187.34073}]}, 'insights': {'insights': [{'label': 'Evaluation Metrics', 'text': 'Estimated Digits: 194.9071 (constrained), E: 17.4221, |U|: 711, digits(M): 187.34'}]}}, 'parentPrograms': ['projects/799795028847/locations/global/collections/default_collection/engines/goldbach_1784979910032/sessions/7658735534374771723/alphaEvolveExperiments/9582896010645531772/alphaEvolvePrograms/7662895210918132005'], 'state': 'COMPLETED'}, {'name': 'projects/799795028847/locations/global/collections/default_collection/engines/goldbach_1784979910032/sessions/7658735534374771723/alphaEvolveExperiments/9582896010645531772/alphaEvolvePrograms/11597998738524452106', 'createTime': '2026-07-26T08:59:23.443295Z', 'content': {'files': [{'path': 'program.py', 'content': '# Copyright 2026 Google LLC\nfrom typing import Any, Mapping\nimport math\nimport random\nimport numpy as np\n\n# EVOLVE-BLOCK-START\ndef optimize_cover_step(congr_dict, cand_mods, targets, cnt_array, logm, logboost, t_temp):\n    """Optimize a single step of congruence cover using simulated annealing style logic.\n\n    Args:\n        congr_dict: Dictionary of r -> a\n        cand_mods: List of prime candidates\n        targets: np.array of target primes\n        cnt_array: np.array of coverage counts\n        logm: current log of modulus M\n        logboost: current log of boost factor\n        t_temp: current temperature\n\n    Returns:\n        Updated congr_dict\n    """\n    import math\n    import random\n    import numpy as np\n\n    # Ensure congr_dict values are python ints\n    congr_dict = {int(k): int(v) for k, v in congr_dict.items()}\n\n    LN10 = 2.302585092994046\n    LN10_SQ = 5.301898110478393\n    \n    def get_score(lm, lb, nr):\n        boost = math.exp(lb)\n        m_dig = lm / LN10\n        ub = nr * boost\n        D = (m_dig + math.sqrt(m_dig * m_dig + 4.0 * ub / LN10_SQ)) / 2.0\n        E_actual = ub / (D * LN10) if D > 0 else 0.0\n        penalty = 0.0\n        if E_actual > 17.5:\n            penalty = 100.0 * (E_actual - 17.5) ** 2\n        return D + penalty\n\n    cnt_array = cnt_array.copy()\n    \n    # First, eliminate any redundant primes (L == 0) to start fresh and clean\n    changed = True\n    while changed:\n        changed = False\n        for r in list(congr_dict.keys()):\n            a = congr_dict[r]\n            only_covered = (cnt_array == 1) & ((targets % r) == a)\n            if np.sum(only_covered) == 0:\n                cnt_array -= (targets % r) == a\n                del congr_dict[r]\n                logm -= math.log(r)\n                logboost -= math.log(r / (r - 1))\n                changed = True\n                break\n\n    current_score = get_score(logm, logboost, int(np.sum(cnt_array == 0)))\n    \n    num_steps = 450\n    \n    for _ in range(num_steps):\n        uncovered_idx = np.where(cnt_array == 0)[0]\n        uncovered_targets = targets[uncovered_idx]\n        n_res = len(uncovered_targets)\n        \n        r_choices = list(congr_dict.keys())\n        \n        if not r_choices:\n            action = \'add\'\n        elif len(r_choices) >= len(cand_mods):\n            action = \'modify_or_remove\'\n        else:\n            action = \'add\' if random.random() < 0.5 else \'modify_or_remove\'\n            \n        if action == \'add\':\n            avail_cands = [m for m in cand_mods if m not in congr_dict]\n            if not avail_cands:\n                continue\n            \n            # Sample 60 candidates: 15 smallest, and 45 random from the rest\n            num_smallest = min(15, len(avail_cands))\n            smallest_cands = avail_cands[:num_smallest]\n            remaining_cands = avail_cands[num_smallest:]\n            if remaining_cands:\n                random_cands = random.sample(remaining_cands, min(45, len(remaining_cands)))\n            else:\n                random_cands = []\n                \n            sampled_r = smallest_cands + random_cands\n            \n            best_candidate_move = None\n            best_candidate_score = float(\'inf\')\n            \n            # Screen candidates using a fast heuristic: C / log(r)\n            screened_cands = []\n            for r in sampled_r:\n                if n_res == 0:\n                    continue\n                rem = uncovered_targets % r\n                counts = np.bincount(rem)\n                if len(counts) == 0:\n                    continue\n                a = np.argmax(counts)\n                c = counts[a]\n                h = c / math.log(r)\n                screened_cands.append((h, r, a, c))\n            \n            screened_cands.sort(key=lambda x: x[0], reverse=True)\n            top_cands = screened_cands[:5]\n            \n            for h, r, a, c in top_cands:\n                new_n_res = n_res - c\n                new_logm = logm + math.log(r)\n                new_logboost = logboost + math.log(r / (r - 1))\n                score = get_score(new_logm, new_logboost, new_n_res)\n                if score < best_candidate_score:\n                    best_candidate_score = score\n                    best_candidate_move = (r, int(a), new_logm, new_logboost, new_n_res)\n            \n            if best_candidate_move is not None:\n                r, a, new_logm, new_logboost, new_n_res = best_candidate_move\n                score_diff = best_candidate_score - current_score\n                \n                if score_diff < 0 or random.random() < math.exp(-score_diff / t_temp):\n                    congr_dict[r] = a\n                    logm = new_logm\n                    logboost = new_logboost\n                    cnt_array += (targets % r) == a\n                    current_score = best_candidate_score\n                    \n        else: # modify_or_remove\n            # Tournament selection: find a prime with low efficiency (L / log(r))\n            k = min(5, len(r_choices))\n            candidates = random.sample(r_choices, k)\n            \n            best_r = None\n            min_efficiency = float(\'inf\')\n            best_r_L = 0\n            \n            for r_cand in candidates:\n                a_cand = congr_dict[r_cand]\n                mask_only = (cnt_array == 1) & ((targets % r_cand) == a_cand)\n                L_cand = int(np.sum(mask_only))\n                eff = L_cand / math.log(r_cand)\n                if eff < min_efficiency:\n                    min_efficiency = eff\n                    best_r = r_cand\n                    best_r_L = L_cand\n                    \n            if best_r is None:\n                continue\n                \n            r = best_r\n            a_old = congr_dict[r]\n            L = best_r_L\n            \n            if n_res > 0:\n                counts = np.bincount(uncovered_targets % r)\n                nonzero_indices = np.nonzero(counts)[0]\n                res_counts = {int(a_new): int(counts[a_new]) for a_new in nonzero_indices}\n            else:\n                res_counts = {}\n                \n            best_opt_score = float(\'inf\')\n            best_opt_action = None\n            best_opt_metrics = None\n            \n            # Option 1: Remove r\n            new_logm_rem = logm - math.log(r)\n            new_logboost_rem = logboost - math.log(r / (r - 1))\n            new_n_res_rem = n_res + L\n            score_rem = get_score(new_logm_rem, new_logboost_rem, new_n_res_rem)\n            if score_rem < best_opt_score:\n                best_opt_score = score_rem\n                best_opt_action = \'remove\'\n                best_opt_metrics = (new_logm_rem, new_logboost_rem, new_n_res_rem)\n                \n            # Option 2: Keep r (no change)\n            if current_score < best_opt_score:\n                best_opt_score = current_score\n                best_opt_action = (\'modify\', a_old)\n                best_opt_metrics = (logm, logboost, n_res)\n                \n            # Option 3: Modify residue\n            for a_new, c in res_counts.items():\n                if a_new == a_old:\n                    continue\n                new_n_res_mod = n_res + L - c\n                score_mod = get_score(logm, logboost, new_n_res_mod)\n                if score_mod < best_opt_score:\n                    best_opt_score = score_mod\n                    best_opt_action = (\'modify\', int(a_new))\n                    best_opt_metrics = (logm, logboost, new_n_res_mod)\n                    \n            if best_opt_action is not None:\n                score_diff = best_opt_score - current_score\n                if score_diff < 0 or random.random() < math.exp(-score_diff / t_temp):\n                    new_logm, new_logboost, new_n_res = best_opt_metrics\n                    if best_opt_action == \'remove\':\n                        cnt_array -= (targets % r) == a_old\n                        del congr_dict[r]\n                    elif best_opt_action[0] == \'modify\':\n                        a_new = best_opt_action[1]\n                        if a_new != a_old:\n                            cnt_array -= (targets % r) == a_old\n                            cnt_array += (targets % r) == a_new\n                            congr_dict[r] = a_new\n                    logm = new_logm\n                    logboost = new_logboost\n                    current_score = best_opt_score\n\n    # Final clean-up of any redundant primes before returning\n    changed = True\n    while changed:\n        changed = False\n        for r in list(congr_dict.keys()):\n            a = congr_dict[r]\n            only_covered = (cnt_array == 1) & ((targets % r) == a)\n            if np.sum(only_covered) == 0:\n                cnt_array -= (targets % r) == a\n                del congr_dict[r]\n                logm -= math.log(r)\n                logboost -= math.log(r / (r - 1))\n                changed = True\n                break\n\n    return congr_dict\n# EVOLVE-BLOCK-END\n\ndef evaluate(eval_inputs: Mapping[str, Any]) -> dict[str, float]:\n    """Run evaluation on the optimized step."""\n    import sympy\n    import numpy as np\n    Q = 100003\n    targets = np.array(list(sympy.primerange(3, Q)), dtype=np.int64)\n    \n    # Warm-start from the 195-digit record cover instead of starting empty\n    congr_dict = {int(r): int(a) for r, a in eval_inputs["warm_start_cover"]}\n    \n    cand_mods = [int(r) for r in sympy.primerange(3, 8000)]\n    cnt_array = np.zeros(len(targets), dtype=np.int16)\n    \n    # Pre-populate counts\n    for r, a in congr_dict.items():\n        cnt_array += (targets % r) == a\n        \n    for it in range(10):\n        t_temp = 0.8 * (0.02 / 0.8) ** (it / 10)\n        # Recalculate cnt_array based on congr_dict\n        cnt_array = np.zeros(len(targets), dtype=np.int16)\n        logm = math.log(2)\n        logboost = math.log(2.0)\n        for r, a in congr_dict.items():\n            cnt_array += (targets % r) == a\n            logm += math.log(r)\n            logboost += math.log(r / (r - 1))\n            \n        congr_dict = optimize_cover_step(congr_dict, cand_mods, targets, cnt_array, logm, logboost, t_temp)\n        \n    # Recalculate final metrics\n    cnt_array = np.zeros(len(targets), dtype=np.int16)\n    logm = math.log(2)\