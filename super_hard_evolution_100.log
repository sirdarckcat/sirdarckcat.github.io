0\n        ub = n_res * math.exp(lb)\n        D_denom = m_dig**2 + 4 * ub / (LN10**2)\n        D = (m_dig + math.sqrt(D_denom)) / 2 if D_denom > 0 else 0.0\n        E_act = ub / (D * LN10) if D > 0 else 0.0\n        return D + 100.0 * max(0.0, E_act - 17.5)**2\n\n    curr_res = int((cnt_array == 0).sum())\n    curr_score = exact_lagrangian_score(curr_res, logm, logboost)\n    \n    cand_set = set(cand_mods)\n    \n    # Run a high-frequency micro-annealing loop\n    internal_iters = 250\n    for i in range(internal_iters):\n        micro_temp = max(t_temp * (1.0 - i / internal_iters), 1e-4)\n        \n        mods_in = list(congr_dict.keys())\n        cand_pool = list(cand_set - set(mods_in))\n        \n        if not mods_in:\n            action = \'add\'\n        elif not cand_pool:\n            action = random.choice([\'drop\', \'optimize\'])\n        else:\n            action = random.choices([\'add\', \'drop\', \'optimize\', \'swap\'], weights=[0.25, 0.10, 0.35, 0.30])[0]\n            \n        if action == \'add\':\n            tournament = random.sample(cand_pool, min(5, len(cand_pool)))\n            best_r, best_a, best_new_score, best_mask, best_new_res = None, None, float(\'inf\'), None, None\n            \n            for r in tournament:\n                rem = targets % r\n                counts = np.bincount(rem[cnt_array == 0], minlength=r)\n                a = int(random.choice(np.flatnonzero(counts == counts.max())))\n                mask = (rem == a)\n                \n                new_res = curr_res - int((cnt_array[mask] == 0).sum())\n                new_lm = logm + math.log(r)\n                new_lb = logboost + math.log(r / (r - 1))\n                new_score = exact_lagrangian_score(new_res, new_lm, new_lb)\n                \n                if new_score < best_new_score:\n                    best_new_score = new_score\n                    best_r, best_a, best_mask, best_new_res = r, a, mask, new_res\n            \n            if best_new_s