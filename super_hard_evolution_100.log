 \n    # Dynamic sparsity penalty: relaxed at high temps (explore), strict at low temps (exploit)\n    # Penalty is proportional to log(r), matching the cost of the modulus.\n    penalty_factor = 0.05 + 0.3 * (1.0 - np.clip(t_temp, 0.0, 1.0))\n    \n    for _ in range(num_updates):\n        active_mods = list(congr_dict.keys())\n        inactive_mods = [m for m in cand_mods if m not in congr_dict]\n        \n        # Pick a coordinate: bias 50% to active moduli (to refine/drop) and 50% to inactive (to add)\n        if active_mods and (not inactive_mods or random.random() < 0.5):\n            r = random.choice(active_mods)\n        elif inactive_mods:\n            r = random.choice(inactive_mods)\n        else:\n            break\n            \n        cost = np.log(r) if r > 1 else 1.0\n        \n        # Compute background coverage (virtually remove r if active)\n        if r in congr_dict:\n            a_old = congr_dict[r]\n            mask_old = (targets % r) == a_old\n            is_uniquely_covered = (cnt_array == 1) & mask_old\n            weights = np.where(cnt_array == 0, 1.0, 1e-4)\n            bg_weights = np.where(is_uniquely_covered, 1.0, weights)\n            current_state = a_old\n        else:\n            bg_weights = np.where(cnt_array == 0, 1.0, 1e-4)\n            current_state = -1  # represents dropped\n            \n        # The benefit counts how many currently uncovered targets each remainder \'a\' covers\n        counts = np.bincount(targets % r, weights=bg_weights, minlength=r)\n        \n        # State score: Coverage Benefit - Sparsity Penalty\n        penalty = penalty_factor * cost\n        \n        scores = np.zeros(r + 1)\n        # States 0 to r-1: Active with remainder a\n        scores[:r] = counts - penalty\n        # State r: Dropped (0 coverage benefit, 0 penalty)\n        scores[r] = 0.0\n        \n        # Gibbs sampling over the r+1 states\n        scaled_scores = scores / temp\n        scaled_scores -= np.max(scaled_scores)\n        probs = np.exp(scaled_scores)\n        probs /= np.sum(probs)\n        \n        a_new = np.random.choice(r + 1, p=probs)\n        \n        # Apply the update and maintain cnt_array\n        if a_new == r:\n            if current_state != -1:\n                del congr_dict[r]\n                cnt_array -= mask_old.astype(cnt_array.dtype)\n        else:\n            if current_state == -1:\n                congr_dict[r] = int(a_new)\n                cnt_array += ((targets % r) == a_new).astype(cnt_array.dtype)\n            elif current_state != a_new:\n                congr_dict[r] = int(a_new)\n                cnt_array -= mask_old.astype(cnt_array.dtype)\n                cnt_array += ((targets % r) == a_new).astype(cnt_array.dtype)\n\n    return congr_dict\n# EVOLVE-BLOCK-END\n\ndef evaluate(eval_inputs: Mapping[str, Any]) -> dict[str, float]:\n    """Run evaluation on the optimized step."""\n    # Let\'s say we maximize -n_digits_est (smaller estimated N-size)\n    # Using sympy/math to compute est digits\n    import sympy\n    import numpy as np\n    Q = 100003\n    targets = np.array(list(sympy.primerange(3, Q)), dtype=np.int64)\n    # Let\'s run the optimize_cover_step starting from empty cover for some iterations\n    congr_dict = {}\n    cand_mods = [int(r) for r in sympy.primerange(3, 8000)]\n    cnt_array = np.zeros(len(targets), dtype=np.int16)\n    logm = math.log(2)\n    logboost = math.log(2.0)\n    \n    for it in range(10):\n        t_temp = 0.8 * (0.02 / 0.8) ** (it / 10)\n        # Update cnt_array based on congr_dict\n        cnt_array = np.zeros(len(targets), dtype=np.int16)\n        logm = math.log(2)\n        logboost = math.log(2.0)\n        for r, a in congr_dict.items():\n            cnt_array += (targets % r) == a\n            logm += math.log(r)\n            logboost += math.log(r / (r - 1))\n            \n        congr_dict = optimize_cover_step(congr_dict, cand_mods, targets, cnt_array, logm, logboost, t_temp)\n        \n