py()\n\n    def calc_score(n_res_val, logm_val, logboost_val):\n        boost = math.exp(logboost_val)\n        m_digits = logm_val / math.log(10)\n        ub = n_res_val * boost\n        LN10 = math.log(10)\n        inside_sqrt = m_digits ** 2 + 4 * ub / (LN10 * LN10)\n        D = (m_digits + math.sqrt(max(0.0, inside_sqrt))) / 2\n        \n        E_limit = 17.5\n        E_actual = ub / (D * LN10) if D > 0 else 0.0\n        lagrangian_penalty = 0.0\n        if E_actual > E_limit:\n            lagrangian_penalty = 1000.0 * (E_actual - E_limit) ** 2\n        return D + lagrangian_penalty\n\n    def optimize_all(congr, cnt):\n        keys = list(congr.keys())\n        random.shuffle(keys)\n        changed = False\n        for r in keys:\n            a_old = congr[r]\n            rem = targets % r\n            is_cov = (rem == a_old)\n            cnt[is_cov] -= 1\n            \n            uncovered = targets[cnt == 0]\n            if len(uncovered) > 0:\n                counts = np.bincount(uncovered % r, minlength=r)\n                a_new = int(np.argmax(counts))\n            else:\n                a_new = 0\n                \n            if a_new != a_old:\n                cnt[rem == a_new] += 1\n                congr[r] = a_new\n                changed = True\n            else:\n                cnt[is_cov] += 1\n        return changed\n\n    # Initial residue optimization\n    optimize_all(congr_dict, cnt_array)\n    n_res = int((cnt_array == 0).sum())\n    current_score = calc_score(n_res, logm, logboost)\n\n    N_STEPS = 800\n    base_temp = max(t_temp, 1e-4)\n\n    cand_set = set(cand_mods)\n    active_set = set(congr_dict.keys())\n    pool_set = cand_set - active_set\n\n    for step in range(N_STEPS):\n        temp = base_temp * (0.8 ** (step / N_STEPS))\n        \n        if step > 0 and step % 100 == 0:\n            if optimize_all(congr_dict, cnt_array):\n                n_res = int((cnt_array == 0).sum())\n                current_score = calc_score(n_res,