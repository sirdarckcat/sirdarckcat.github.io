  \n                rem_drop = targets % r_drop\n                cnt_array[rem_drop == a_drop] -= 1\n                uncovered = (cnt_array == 0)\n                \n                sampled_add = random.sample(cand_pool, min(300, len(cand_pool)))\n                best_add_r = None\n                best_add_a = None\n                best_new_D = float(\'inf\')\n                best_new_n_res = n_res\n                \n                uncovered_targets = targets[uncovered]\n                n_res_after_drop = len(uncovered_targets)\n                logm_after_drop = logm - math.log(r_drop)\n                logboost_after_drop = logboost - math.log(r_drop / (r_drop - 1))\n                \n                for r in sampled_add:\n                    if n_res_after_drop > 0:\n                        counts = np.bincount(uncovered_targets % r, minlength=r)\n                        a = int(np.argmax(counts))\n                        added_cov = counts[a]\n                    else:\n                        a = 0\n                        added_cov = 0\n                    \n                    new_n_res = n_res_after_drop - added_cov\n                    new_logm = logm_after_drop + math.log(r)\n                    new_logboost = logboost_after_drop + math.log(r / (r - 1))\n                    \n                    new_D = calc_D_val(new_n_res, new_logm, new_logboost)\n                    if new_D < best_new_D:\n                        best_new_D = new_D\n                        best_add_r = r\n                        best_add_a = a\n                        best_new_n_res = new_n_res\n                        \n                if best_add_r is not None:\n                    delta = best_new_D - current_D\n                    if delta < 0 or random.random() < math.exp(-delta / temp):\n                        del congr_dict[r_drop]\n                        congr_dict[best_add_r] = best_add_a\n                        cnt_array[targets % best_add_r == best_add_a] += 1\n                        n_res = best_new_n_res\n                        logm = logm_after_drop + math.log(best_add_r)\n                        logboost = logboost_after_drop + math.log(best_add_r / (best_add_r - 1))\n                        current_D = best_new_D\n                    else:\n                        cnt_array[rem_drop == a_drop] += 1\n                else:\n                    cnt_array[rem_drop == a_drop] += 1\n\n        elif action == \'super_swap\':\n            active = list(congr_dict.keys())\n            cand_pool = [m for m in cand_mods if m not in congr_dict]\n            if len(active) >= 2 and len(cand_pool) >= 2:\n                sample_active = random.sample(active, min(25, len(active)))\n                singly_covered = (cnt_array == 1)\n                \n                drop_scores = []\n                for r in sample_active:\n                    loss = np.sum(singly_covered & ((targets % r) == congr_dict[r]))\n                    new_n_res = n_res + loss\n                    new_logm = logm - math.log(r)\n                    new_logboost = logboost - math.log(r / (r - 1))\n                    D_drop = calc_D_val(new_n_res, new_logm, new_logboost)\n                    drop_scores.append((D_drop, r))\n                \n                drop_scores.sort(key=lambda x: x[0])\n                r_drop1 = drop_scores[0][1]\n                r_drop2 = drop_scores[1][1]\n                \n                a_drop1 = congr_dict[r_drop1]\n                a_drop2 = congr_dict[r_drop2]\n                \n                cnt_array[targets % r_drop1 == a_drop1] -= 1\n                cnt_array[targets % r_drop2 == a_drop2] -= 1\n                \n                uncovered = (cnt_array == 0)\n                uncovered_targets = targets[uncovered]\n                n_res_after_drop = len(uncovered_targets)\n                logm_after = logm - math.log(r_drop1) - math.log(r_drop2)\n                logboost_after = logboost - math.log(r_drop1 / (r_drop1 - 1)) - math.log(r_drop2 / (r_drop2 - 1))\n                \n                sampled_add = random.sample(cand_pool, min(300, len(cand_pool)))\n                \n                best_r1, best_a1, best_D1 = None, None, float(\'inf\')\n                for r in sampled_add:\n                    if n_res_after_drop > 0:\n                        counts = np.bincount(uncovered_targets % r, minlength=r)\n                        a = int(np.argmax(counts))\n                        cov = counts[a]\n                    else:\n                        a, cov = 0, 0\n                    n_res_1 = n_res_after_drop - cov\n                    D_1 = calc_D_val(n_res_1, logm_after + math.log(r), logboost_after + math.log(r / (r - 1)))\n                    if D_1 < best_D1:\n                        best_D1 = D_1\n                        best_r1, best_a1 = r, a\n                \n                if best_r1 is not None:\n                    added_mask = (uncovered_targets % best_r1) == best_a1\n                    rem_uncovered = uncovered_targets[~added_mask]\n                    n_res_mid = len(rem_uncovered)\n                    logm_mid = logm_after + math.log(best_r1)\n                    logboost_mid = logboost_after + math.log(best_r1 / (best_r1 - 1))\n                    \n                    best_r2, best_a2, best_D2, best_n_res2 = None, None, float(\'inf\'), n_res_mid\n                    for r in sampled_add:\n                        if r == best_r1: continue\n                        if n_res_mid > 0:\n                            counts = np.bincount(rem_uncovered % r, minlength=r)\n                            a = int(np.argmax(counts))\n                            cov = counts[a]\n                        else:\n                            a, cov = 0, 0\n                        n_res_final = n_res_mid - cov\n                        logm_final = logm_mid + math.log(r)\n                        logboost_final = logboost_mid + math.log(r / (r - 1))\n                        D_final = calc_D_val(n_res_final, logm_final, logboost_final)\n                        if D_final < best_D2:\n                            best_D2 = D_final\n                            best_r2, best_a2 = r, a\n                            best_n_res2 = n_res_final\n                            \n                    if best_r2 is not None:\n                        delta = best_D2 - current_D\n                        if delta < 0 or random.random() < math.exp(-delta / temp):\n                            del congr_dict[r_drop1]\n                            del congr_dict[r_drop2]\n                            congr_dict[best_r1] = best_a1\n                            congr_dict[best_r2] = best_a2\n                            cnt_array[targets % best_r1 == best_a1] += 1\n                            cnt_array[targets % best_r2 == best_a2] += 1\n                            n_res = best_n_res2\n                            logm = logm_final\n                            logboost = logboost_final\n                            current_D = best_D2\n                        else:\n                            cnt_array[targets % r_drop1 == a_drop1] += 1\n                            cnt_array[targets % r_drop2 == a_drop2] += 1\n                    else:\n                        cnt_array[targets % r_drop1 == a_drop1] += 1\n                        cnt_array[targets % r_drop2 == a_drop2] += 1\n                else:\n                    cnt_array[targets % r_drop1 == a_drop1] += 1\n                    cnt_array[targets % r_drop2 == a_drop2] += 1\n\n        elif action == \'optimize\':\n            active = list(congr_dict.keys())\n            if active:\n                sampled = random.sample(active, min(10, len(active)))\n                for r in sampled:\n                    a_old = congr_dict[r]\n                    is_cov = (targets % r) == a_old\n                    cnt_array[is_cov] -= 1\n                    \n                    uncovered_targets = targets[cnt_array == 0]\n                    if len(uncovered