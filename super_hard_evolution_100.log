ocus on adding and optimizing more than dropping\n        action = random.choices([\'add\', \'drop\', \'optimize\'], weights=[0.50, 0.15, 0.35], k=1)[0]\n        if not congr_dict:\n            action = \'add\'\n\n        if action == \'add\':\n            # Tournament selection for \'add\'\n            sampled = random.choices(cand_mods, weights=cand_weights, k=k_add * 3)\n            unique_candidates = []\n            for r in sampled:\n                if r not in congr_dict and r not in unique_candidates:\n                    unique_candidates.append(r)\n                    if len(unique_candidates) == k_add:\n                        break\n            \n            if not unique_candidates:\n                continue\n\n            best_r = None\n            best_a = None\n            best_new_D = float(\'inf\')\n            best_max_covered = 0\n            best_new_n_res = 0\n            best_new_logm = 0\n            best_new_logboost = 0\n\n            uncovered_targets = targets[cnt_array == 0]\n            for r in unique_candidates:\n                if len(uncovered_targets) > 0:\n                    counts = np.bincount(uncovered_targets % r, minlength=r)\n                    a = int(np.argmax(counts))\n                    max_covered = counts[a]\n                else:\n                    a = 0\n                    max_covered = 0\n                    \n                new_n_res = n_res - max_covered\n                new_logm = logm + math.log(r)\n                new_logboost = logboost + math.log(r / (r - 1))\n                new_ub = new_n_res * math.exp(new_logboost)\n                new_D = calc_D(new_logm, new_ub)\n                \n                if new_D < best_new_D:\n                    best_new_D = new_D\n                    best_r = r\n                    best_a = a\n                    best_max_covered = max_covered\n                    best_new_n_res = new_n_res\n                    best_new_logm = new_logm\n                    best_new_logboost = new_logboost\n\n            if best_r is not None:\n                if best_new_D < current_D or random.random() < math.exp((current_D - best_new_D) / max(t_temp, 1e-9)):\n                    congr_dict[best_r] = best_a\n                    cnt_array += (targets % best_r) == best_a\n                    logm, logboost, current_D, n_res = best_new_logm, best_new_logboost, best_new_D, best_new_n_res\n\n        elif action == \'drop\':\n            # Tournament selection for \'drop\'\n            keys = list(congr_dict.keys())\n            sampled_keys = random.sample(keys, min(len(keys), k_drop))\n            \n            best_r = None\n            best_new_D = float(\'inf\')\n            best_mask = None\n            best_new_n_res = 0\n            best_new_logm = 0\n            best_new_logboost = 0\n            \n            for r in sampled_keys:\n                a_drop = congr_dict[r]\n                mask = (targets % r) == a_drop\n                num_only_r = np.sum((cnt_array == 1) & mask)\n                \n                new_n_res = n_res + num_only_r\n                new_logm = logm - math.log(r)\n                new_logboost = logboost - math.log(r / (r - 1))\n                new_ub = new_n_res * math.exp(new_logboost)\n                new_D = calc_D(new_logm, new_ub)\n                \n                if new_D < best_new_D:\n                    best_new_D = new_D\n                    best_r = r\n                    best_mask = mask\n                    best_new_n_res = new_n_res\n                    best_new_logm = new_logm\n                    best_new_logboost = best_new_logboost\n            \n            if best_r is not None:\n                if best_new_D < current_D or random.random() < math.exp((current_D - best_new_D) / max(t_temp, 1e-9)):\n                    del congr_dict[best_r]\n                    cnt_array -= best_mask\n                    logm, logboost, current_D, n_res = best_new_logm, best_new_logboost, best_new_D, best_new_n