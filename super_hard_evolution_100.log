andidates\n        targets: np.array of target primes\n        cnt_array: np.array of coverage counts\n        logm: current log of modulus M\n        logboost: current log of boost factor\n        t_temp: current temperature\n\n    Returns:\n        Updated congr_dict\n    """\n    import numpy as np\n    import random\n\n    if len(targets) == 0:\n        # Safety fallback\n        kind = random.random()\n        r_in = random.choice(list(congr_dict)) if congr_dict else None\n        if kind < 0.5 and r_in is not None:\n            a_old = congr_dict[r_in]\n            a_new = random.randint(0, r_in - 1)\n            if a_new != a_old:\n                congr_dict[r_in] = a_new\n        elif kind < 0.7 and r_in is not None:\n            del congr_dict[r_in]\n        else:\n            r_out = random.choice(cand_mods)\n            if r_out not in congr_dict:\n                a_new = random.randint(0, r_out - 1)\n                congr_dict[r_out] = a_new\n        return congr_dict\n\n    # CRAZY IDEA WITH A CAPITAL C: "Target-Driven Sniper Mode" & "Thermonuclear Pruning"\n    # Instead of blindly picking moduli and hoping they cover things, \n    # we use the uncovered targets as a primary targeting coordinate system.\n    \n    uncovered_idx = np.where(cnt_array == 0)[0]\n    mods_in = list(congr_dict.keys())\n    cand_pool = [m for m in cand_mods if m not in congr_dict]\n    \n    factor = np.clip(t_temp, 0.0, 1.0)\n    # Actions: sniper_add, thermonuclear_drop, sniper_optimize\n    p_sniper_add = 0.20 + 0.30 * factor\n    p_thermo_drop = 0.10 + 0.20 * factor\n    p_sniper_opt = 1.0 - (p_sniper_add + p_thermo_drop)\n    \n    kind = random.random()\n    if not congr_dict:\n        action = \'sniper_add\'\n    elif not cand_pool:\n        action = \'sniper_optimize\' if kind < 0.7 else \'thermonuclear_drop\'\n    else:\n        if kind < p_sniper_add: action = \'sniper_add\'\n        elif kind < p_sniper_add + p_thermo_drop: action = \'thermonuclear_drop\'\n        else: action = \'sniper_optimize\'\n\n    if action == \'sniper_add\':\n        # SNIPER MODE: Pick an uncovered target and guarantee its destruction!\n        if len(uncovered_idx) > 0:\n            target_to_assassinate = targets[random.choice(uncovered_idx)]\n        else:\n            target_to_assassinate = random.choice(targets) # fallback\n            \n        sample_size = min(40, len(cand_pool))\n        sampled_cands = random.sample(cand_pool, sample_size)\n        \n        scores = []\n        cands_data = []\n        for r in sampled_cands:\n            # We perfectly align the congruence to kill the target\n            a = target_to_assassinate % r\n            \n            # Evaluate splash damage on other uncovered targets\n            splash_mask = (targets % r) == a\n            # Splash damage is good if it hits 0-count, bad if it\'s just redundant\n            splash_hits = np.sum(cnt_array[splash_mask] == 0) \n            \n            # Cost-benefit ratio (we want max splash per log(r))\n            cost = np.log(r) if r > 1 else 1.0\n            score = splash_hits / cost\n            scores.append(score)\n            cands_data.append((r, a))\n            \n        scores = np.array(scores)\n        temp = max(t_temp, 1e-4)\n        scaled = scores / temp\n        scaled = scaled - np.max(scaled)\n        probs = np.exp(scaled)\n        probs /= np.sum(probs)\n        \n        idx = np.random.choice(len(sampled_cands), p=probs)\n        best_cand, best_a = cands_data[idx]\n        congr_dict[best_cand] = int(best_a)\n\n    elif action == \'sniper_optimize\':\n        if mods_in:\n            temp = max(t_temp, 1e-4)\n            r = random.choice(mods_in)\n            a_old = congr_dict[r]\n            \n            # Remove r\'s current coverage\n            mask_old = (targets % r) == a_old\n            cnt_bg = cnt_array - mask_old\n            \n            uncovered_bg_idx = np.where(cnt_bg == 0)[0]\n            if len(uncovered_bg_idx) > 0:\n                # Pick 5 random newly uncovered/still uncovered targets as candidates\n                num_snipes = min(5, len(uncovered_bg_idx))\n                snipe_targets = np.random.choice(targets[uncovered_bg_idx], num_snipes, replace=False)\n                \n                best_a = a_old\n                best_score = -1.0\n                \n                # Check which targeted \'a\' gives the best total coverage\n                for st in snipe_targets:\n                    a_test = st % r\n                    mask_test = (targets % r) == a_test\n                    score = np.sum(cnt_bg[mask_test] == 0)\n                    # Add some thermal noise to the score\n                    score_noisy = score + random.gauss(0, temp * 2.0)\n                    if score_noisy > best_score:\n                        best_score = score_noisy\n                        best_a = a_test\n                        \n                congr_dict[r] = int(best_a)\n            else:\n                # Fallback to random if everything is perfectly covered\n                congr_dict[r] = random.randint(0, r - 1)\n\n    elif action == \'thermonuclear_drop\':\n        # Drop the prime that is pulling the least weight!\n        if mods_in:\n            # We measure unique hits (targets covered ONLY by this prime)\n            # primes with 0 unique hits are essentially dead weight.\n            scores = []\n            temp = max(t_temp, 1e-4)\n            for r in mods_in:\n                a = congr_dict[r]\n                mask = (targets % r) == a\n                unique_hits = np.sum((cnt_array == 1) & mask)\n                cost = np.log(r) if r > 1 else 1.0\n                # We want to drop primes with LOW unique hits and HIGH cost\n                # So we score them on how "droppable" they are\n                score = cost / (unique_hits + 1e-3)\n                scores.append(score)\n                \n            scores = np.array(scores)\n            scaled = scores / temp\n            scaled = scaled - np.max(scaled)\n            probs = np.exp(scaled)\n            probs /= np.sum(probs)\n            \n            # Drop 1-2 worst primes to cause a controlled avalanche\n            drop_count = min(len(mods_in), random.choices([1, 2], weights=[0.8, 0.2])[0])\n            drop_indices = np.random.choice(len(mods_in), size=drop_count, p=probs, replace=False)\n            \n            for idx in drop_indices:\n                r_drop = mods_in[idx]\n                del congr_dict[r_drop]\n\n    return congr_dict\n# EVOLVE-BLOCK-END\n\ndef evaluate(eval_inputs: Mapping[str, Any]) -> dict[str, float]:\n    """Run evaluation on the optimized step."""\n    import sympy\n    import numpy as np\n    Q = 100003\n    targets = np.array(list(sympy.primerange(3, Q)), dtype=np.int64)\n    \n    # Warm-start from the 195-digit record cover instead of starting empty\n    congr_dict = {int(r): int(a) for r, a in eval_inputs["warm_start_cover"]}\n    \n    cand_mods = [int(r) for r in sympy.primerange(3, 8000)]\n    cnt_array = np.zeros(len(targets), dtype=np.int16)\n    \n    # Pre-populate counts\n    for r, a in congr_dict.items():\n        cnt_array += (targets % r) == a\n        \n    for it in range(10):\n        t_temp = 0.8 * (0.02 / 0.8) ** (it / 10)\n        # Recalculate cnt_array based on congr_dict\n        cnt_array = np.zeros(len(targets), dtype=np.int16)\n        logm = math.log(2)\n        logboost = math.log(2.0)\n        for r, a in congr_dict.items():\n            cnt_array += (targets % r) == a\n            logm += math.log(r)\n            logboost += math.log(r / (r - 1))\n            \n        congr_dict = optimize_cover_step(congr_dict, cand_mods, targets, cnt_array, logm, logboost, t_temp)\n        \n    # Recalculate final metrics\n    cnt_array = np.zeros(len(targets), dtype=np.int16)\n    logm = math.log(2)\n    logboost = math.log(2.0)\n    for r, a in congr_dict.items():\n        cnt_array += (targets % r) == a\