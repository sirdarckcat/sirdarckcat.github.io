nalty\n\n    current_n_res = int((cnt_array == 0).sum())\n    \n    # Run multiple inner SA iterations to massively accelerate optimization scope per step\n    inner_steps = 40\n    for inner_it in range(inner_steps):\n        \n        moves = []\n        add_moves = []\n        drop_moves = []\n        \n        # 1. Add Moves Evaluation (expand search pool biased towards smaller, highly efficient primes)\n        cand_pool = [m for m in cand_mods if m not in congr_dict]\n        if cand_pool:\n            if len(cand_pool) <= 120:\n                sample_add = cand_pool\n            else:\n                small_pool = cand_pool[:200]\n                large_pool = cand_pool[200:]\n                s_sample = random.sample(small_pool, min(80, len(small_pool)))\n                l_sample = random.sample(large_pool, min(40, len(large_pool)))\n                sample_add = s_sample + l_sample\n        else:\n            sample_add = []\n            \n        zeros_mask = (cnt_array == 0)\n        \n        for r in sample_add:\n            if r not in cache:\n                cache[r] = targets % r\n            rem = cache[r]\n            counts = np.bincount(rem[zeros_mask], minlength=r)\n            a = int(np.argmax(counts))\n            covered_uncovered = counts[a]\n            \n            new_n_res = current_n_res - covered_uncovered\n            new_logm = logm + math.log(r)\n            new_logboost = logboost + math.log(r / (r - 1))\n            score = calc_score(new_n_res, new_logm, new_logboost)\n            add_moves.append((r, a, score, new_n_res, new_logm, new_logboost))\n            moves.append((\'add\', r, a, score, new_n_res, new_logm, new_logboost))\n            \n        mods_in = list(congr_dict.keys())\n        \n        # 2. Drop Moves Evaluation (evaluate all existing modules)\n        ones_mask = (cnt_array == 1)\n        \n        for r in mods_in:\n            if r not in cache:\n                cache[r] = targets % r\n            rem = cache[r]\n            a = congr_dict[r]\n            covered_unique = np.sum(ones_mask & (rem == a))\n            \n            new_n_res = current_n_res + covered_unique\n            new_logm = logm - math.log(r)\n            new_logboost = logboost - math.log(r / (r - 1))\n            score = calc_score(new_n_res, new_logm, new_logboost)\n            drop_moves.append((r, a, score, new_n_res, new_logm, new_logboost))\n            moves.append((\'drop\', r, None, score, new_n_res, new_logm, new_logboost))\n            \n        # 2b. Swap Moves Evaluation (pair up the top 40 drop and top 40 add moves)\n        drop_moves.sort(key=lambda x: x[2])\n        add_moves.sort(key=lambda x: x[2])\n        best_drops = drop_moves[:40]\n        best_adds = add_moves[:40]\n        for r_drop, a_drop, _, n_res_d, logm_d, logb_d in best_drops:\n            for r_add, a_add, _, n_res_a, logm_a, logb_a in best_adds:\n                swap_n_res = max(0, n_res_d + n_res_a - current_n_res)\n                swap_logm = logm_d + logm_a - logm\n                swap_logboost = logb_d + logb_a - logboost\n                score = calc_score(swap_n_res, swap_logm, swap_logboost)\n                moves.append((\'swap\', (r_drop, r_add), (a_drop, a_add), score, swap_n_res, swap_logm, swap_logboost))\n            \n        # 3. Optimize Moves Evaluation (evaluate all existing modules, with simplified mask logic)\n        for r in mods_in:\n            if r not in cache:\n                cache[r] = targets % r\n            rem = cache[r]\n            a_old = congr_dict[r]\n            bg_zeros = (cnt_array == (rem == a_old))\n            \n            counts = np.bincount(rem[bg_zeros], minlength=r)\n            loss = counts[a_old]\n            counts[a_old] = -1  # Exclude current remainder from pool\n            a_new = int(np.argmax(counts))\n            gain = counts[a_new]\n                \n            new_n_res = current_n_res + loss - gain\n            score = calc_score(new_n_res, logm, l