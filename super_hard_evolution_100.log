, targets, cnt_array, logm, logboost, t_temp):\n    """Optimize congruence cover using multi-step exact simulated annealing logic."""\n    import numpy as np\n    import random\n    import math\n\n    def calc_D(m_val, ub_val):\n        LN10 = 2.302585092994046\n        m_dig = m_val / LN10\n        if ub_val >= 0:\n            return (m_dig + math.sqrt(m_dig**2 + 4 * ub_val / (LN10**2))) / 2\n        else:\n            dD_dub = 1.0 / max(1e-9, 2.0 * m_dig * (LN10**2))\n            return m_dig + ub_val * dD_dub\n\n    if len(targets) == 0:\n        return congr_dict\n\n    # Ensure cand_mods is sorted to correctly apply small-prime bias\n    cand_mods = sorted(cand_mods)\n\n    # Use a function-level cache to store targets % r to avoid expensive modulo operations\n    if not hasattr(optimize_cover_step, "_cache") or optimize_cover_step._cache_id != id(targets):\n        optimize_cover_step._cache = {}\n        optimize_cover_step._cache_id = id(targets)\n    cache = optimize_cover_step._cache\n\n    # Cast cnt_array to np.int64 to support safe accumulation\n    cnt_array = np.array(cnt_array, dtype=np.int64)\n    uncovered_mask = (cnt_array == 0)\n\n    # Massively increased iterations due to caching & masking optimizations\n    internal_steps = 5000\n\n    n_res = int(np.sum(uncovered_mask))\n    current_ub = n_res * math.exp(logboost)\n    current_D = calc_D(logm, current_ub)\n\n    for step in range(internal_steps):\n        # Local temperature cooling schedule\n        frac = step / internal_steps\n        T = t_temp * (0.15 ** frac)\n\n        action = random.choice([\'add\', \'drop\', \'optimize\'])\n        if not congr_dict:\n            action = \'add\'\n\n        if action == \'add\':\n            # Bias choice towards smaller primes (indices) using power law\n            idx = int(len(cand_mods) * (random.random() ** 1.6))\n            r = cand_mods[idx]\n            if r in congr_dict:\n                continue\n            \n            if r not in cac