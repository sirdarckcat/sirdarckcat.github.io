not None:\n            del congr_dict[r_in]\n        else:\n            r_out = random.choice(cand_mods)\n            if r_out not in congr_dict:\n                a_new = random.randint(0, r_out - 1)\n                congr_dict[r_out] = a_new\n        return congr_dict\n\n    def calc_D(log_m, log_boost, n_uncovered):\n        LN10 = 2.302585092994046\n        m_digits = log_m / LN10\n        ub = n_uncovered * math.exp(log_boost)\n        val = m_digits**2 + 4.0 * ub / (LN10 * LN10)\n        if val < 0:\n            val = 0.0\n        return 0.5 * (m_digits + math.sqrt(val))\n\n    best_congr_dict = congr_dict.copy()\n    n_res_curr = np.sum(cnt_array == 0)\n    best_D = calc_D(logm, logboost, n_res_curr)\n\n    # We run multiple internal steps of thermodynamic/probabilistic transition\n    # to significantly accelerate finding the optimal congruence cover.\n    num_internal_steps = 200\n    for _ in range(num_internal_steps):\n        n_res_curr = np.sum(cnt_array == 0)\n        D_curr = calc_D(logm, logboost, n_res_curr)\n        \n        moves = []  # list of (type, data, D_new)\n        moves.append((\'none\', None, D_curr))\n        \n        # 1. Propose ADD moves\n        cand_pool = [m for m in cand_mods if m not in congr_dict]\n        if cand_pool:\n            cand_pool_arr = np.array(cand_pool, dtype=np.int64)\n            # Bias selection towards smaller moduli using 1.0 / (r * log(r))\n            r_weights = 1.0 / (cand_pool_arr * np.log(cand_pool_arr))\n            r_weights /= np.sum(r_weights)\n            \n            sample_size = min(120, len(cand_pool))\n            sampled_adds = np.random.choice(cand_pool_arr, size=sample_size, replace=False, p=r_weights)\n            \n            uncovered_targets = targets[cnt_array == 0]\n            if len(uncovered_targets) > 0:\n                for r in sampled_adds:\n                    counts = np.bincount(uncovered_targets % r, minlength=r)\n                    a_best = int(np.argmax(counts))\n                    num_covered = counts[a_best]\n                    \n                    n_res_new = n_res_curr - num_covered\n                    logm_new = logm + math.log(r)\n                    logboost_new = logboost + math.log(r / (r - 1))\n                    D_new = calc_D(logm_new, logboost_new, n_res_new)\n                    moves.append((\'add\', (r, a_best), D_new))\n            else:\n                for r in sampled_adds:\n                    logm_new = logm + math.log(r)\n                    logboost_new = logboost + math.log(r / (r - 1))\n                    D_new = calc_D(logm_new, logboost_new, 0)\n                    moves.append((\'add\', (r, 0), D_new))\n                    \n        # 2 & 3. Propose OPTIMIZE and DROP moves\n        drop_contributions = {}\n        uncovered_bg_dict = {}\n        for r, a_old in list(congr_dict.items()):\n            cnt_bg = cnt_array - (targets % r == a_old)\n            uncovered_bg = targets[cnt_bg == 0]\n            n_res_drop = len(uncovered_bg)\n            \n            drop_contributions[r] = n_res_drop - n_res_curr\n            uncovered_bg_dict[r] = uncovered_bg\n            \n            # DROP move\n            logm_drop = logm - math.log(r)\n            logboost_drop = logboost - math.log(r / (r - 1))\n            D_drop = calc_D(logm_drop, logboost_drop, n_res_drop)\n            moves.append((\'drop\', (r, a_old), D_drop))\n            \n            # OPTIMIZE move\n            if n_res_drop > 0:\n                counts = np.bincount(uncovered_bg % r, minlength=r)\n                a_new = int(np.argmax(counts))\n                num_covered = counts[a_new]\n                n_res_opt = n_res_drop - num_covered\n            else:\n                a_new = 0\n                n_res_opt = 0\n                \n            if a_new != a_old:\n                D_opt = calc_D(logm, logboost, n_res_opt)\n                moves.append((\'optimize\', (r, a_new), D_opt))\n\n        # 4. Propose SWAP moves (Swap 