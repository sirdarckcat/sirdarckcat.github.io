 * LN10) if D > 0 else 0.0\n        penalty = 1000.0 * (E_actual - 17.5) ** 2 if E_actual > 17.5 else 0.0\n        return D + penalty\n\n    def optimize_subset(keys, congr, cnt):\n        for r in keys:\n            a_old = congr[r]\n            rem = targets % r\n            cnt[rem == a_old] -= 1\n            counts = np.bincount(rem[cnt == 0], minlength=r)\n            a_new = int(np.argmax(counts))\n            cnt[rem == a_new] += 1\n            congr[r] = a_new\n\n    def evaluate_adds(cand_list, base_n_res, base_logm, base_logboost, uncovered):\n        best_r, best_a, best_new_D, best_new_n_res = None, None, float(\'inf\'), base_n_res\n        uncovered_targets = targets[uncovered]\n        for r in cand_list:\n            counts = np.bincount(uncovered_targets % r, minlength=r)\n            a = int(np.argmax(counts))\n            new_n_res = base_n_res - counts[a]\n            new_D = calc_D_val(new_n_res, base_logm + math.log(r), base_logboost + math.log(r / (r - 1)))\n            if new_D < best_new_D:\n                best_new_D, best_r, best_a, best_new_n_res = new_D, r, a, new_n_res\n        return best_r, best_a, best_new_D, best_new_n_res\n\n    def evaluate_drops(active_list, base_n_res, base_logm, base_logboost, singly_covered):\n        best_r, best_new_D, best_new_n_res = None, float(\'inf\'), base_n_res\n        singly_covered_targets = targets[singly_covered]\n        for r in active_list:\n            lost_cov = np.sum((singly_covered_targets % r) == congr_dict[r])\n            new_n_res = base_n_res + lost_cov\n            new_D = calc_D_val(new_n_res, base_logm - math.log(r), base_logboost - math.log(r / (r - 1)))\n            if new_D < best_new_D:\n                best_new_D, best_r, best_new_n_res = new_D, r, new_n_res\n        return best_r, best_new_D, best_new_n_res\n\n    # Initial residue optimization\n    init_keys = list(congr_dict.keys())\n    random.shuffle(init_keys)\n    optimize_subset(init_keys, congr_dict, cnt_array)\n    n_res = int((cnt_array == 0).sum())\n    current_D = calc_D_val(n_res, logm, logboost)\n\n    temp = max(t_temp, 1e-6)\n    N_STEPS = 2000\n\n    for step in range(N_STEPS):\n        # Periodically optimize all to stay on the local optimum manifold\n        if step > 0 and step % 200 == 0:\n            keys = list(congr_dict.keys())\n            random.shuffle(keys)\n            optimize_subset(keys, congr_dict, cnt_array)\n            n_res = int((cnt_array == 0).sum())\n            current_D = calc_D_val(n_res, logm, logboost)\n\n        action = random.choices([\'add\', \'drop\', \'swap\', \'optimize\'], weights=[0.20, 0.20, 0.40, 0.20], k=1)[0]\n\n        if action == \'add\':\n            cand_pool = [m for m in cand_mods if m not in congr_dict]\n            if cand_pool:\n                sampled = random.sample(cand_pool, min(80, len(cand_pool)))\n                best_r, best_a, best_new_D, best_new_n_res = evaluate_adds(\n                    sampled, n_res, logm, logboost, (cnt_array == 0))\n                \n                if best_r is not None:\n                    if best_new_D < current_D or random.random() < math.exp(-(best_new_D - current_D) / temp):\n                        congr_dict[best_r] = best_a\n                        cnt_array[targets % best_r == best_a] += 1\n                        n_res, current_D = best_new_n_res, best_new_D\n                        logm += math.log(best_r)\n                        logboost += math.log(best_r / (best_r - 1))\n\n        elif action == \'drop\':\n            active = list(congr_dict.keys())\n            if active:\n                sampled = random.sample(active, min(80, len(active)))\n                best_r, best_new_D, best_new_n_res = evaluate_drops(\n                    sampled, n_res, logm, logboost, (cnt_array == 1))\n                \n                if best_r is not None:\n                    if best_new_D < current_D or random.random() < math.exp(-(best_new_D - current_D) / temp):\n                        a_drop = congr_dict[best_r]\n                        cnt_array[targets % best_r == a_drop] -= 1\n                        del congr_dict[best_r]\n                        n_res, current_D = best_new_n_res, best_new_D\n                        logm -= math.log(best_r)\n                        logboost -= math.log(best_r / (best_r - 1))\n\n        elif action == \'swap\':\n            active = list(congr_dict.keys())\n            cand_pool = [m for m in cand_mods if m not in congr_dict]\n            if active and cand_pool:\n                sampled_drop = random.sample(active, min(20, len(active)))\n                r_drop, _, _ = evaluate_drops(\n                    sampled_drop, n_res, logm, logboost, (cnt_array == 1))\n                if r_drop is None:\n                    r_drop = random.choice(active)\n                    \n                a_drop = congr_dict[r_drop]\n                \n                rem_drop = targets % r_drop\n                cnt_array[rem_drop == a_drop] -= 1\n                n_res_after_drop = int((cnt_array == 0).sum())\n                logm_after_drop = logm - math.log(r_drop)\n                logboost_after_drop = logboost - math.log(r_drop / (r_drop - 1))\n                \n                sampled_add = random.sample(cand_pool, min(80, len(cand_pool)))\n                best_add_r, best_add_a, best_new_D, best_new_n_res = evaluate_adds(\n                    sampled_add, n_res_after_drop, logm_after_drop, logboost_after_drop, (cnt_array == 0))\n                        \n                if best_add_r is not None:\n                    if best_new_D < current_D or random.random() < math.exp(-(best_new_D - current_D) / temp):\n                        del congr_dict[r_drop]\n                        congr_dict[best_add_r] = best_add_a\n                        cnt_array[targets % best_add_r == best_add_a] += 1\n                        n_res, current_D = best_new_n_res, best_new_D\n                        logm = logm_after_drop + math.log(best_add_r)\n                        logboost = logboost_after_drop + math.log(best_add_r / (best_add_r - 1))\n                    else:\n                        cnt_array[rem_drop == a_drop] += 1\n                else:\n                    cnt_array[rem_drop == a_drop] += 1\n\n        elif action == \'optimize\':\n            active = list(congr_dict.keys())\n            if active:\n                sampled = random.sample(active, min(20, len(active)))\n                optimize_subset(sampled, congr_dict, cnt_array)\n                n_res = int((cnt_array == 0).sum())\n                current_D = calc_D_val(n_res, logm, logboost)\n\n    # Final cleanup to ensure absolute optimality of residues\n    final_keys = list(congr_dict.keys())\n    random.shuffle(final_keys)\n    optimize_subset(final_keys, congr_dict, cnt_array)\n    return congr_dict\n# EVOLVE-BLOCK-END\n\ndef evaluate(eval_inputs: Mapping[str, Any]) -> dict[str, float]:\n    """Run evaluation on the optimized step."""\n    import sympy\n    import numpy as np\n    Q = 100003\n    targets = np.array(list(sympy.primerange(3, Q)), dtype=np.int64)\n    \n    # Warm-start from the 195-digit record cover instead of starting empty\n    congr_dict = {int(r): int(a) for r, a in eval_inputs["warm_start_cover"]}\n    \n    cand_mods = [int(r) for r in sympy.primerange(3, 8000)]\n    cnt_array = np.zeros(len(targets), dtype=np.int16)\n    \n    # Pre-populate counts\n    for r, a in congr_dict.items():\n        cnt_array += (targets % r) == a\n        \n    for it in range(10):\n        t_temp = 0.8 * (0.02 / 0.8) ** (it / 10)\n        # Recalculate cnt_array based on congr_dict\n        cnt_array = np.zeros(len(targets), dtype=np.int16)\n        logm = math.log(2)\n        logboost = math.log(2.0)\n        for r, a in congr_dict.items():\n            cnt_array += (targets % r) == a\n            logm += math.log(r)\n            logboost += math.log(r / (r - 1))\n            \n        congr_dict = optimize_cover_step(congr_dict, cand_mods, targets, cnt_array, logm, logboost, t_temp)\n        \n    # Recalculate final metrics\n    cnt_array = np.zeros(len(targets), dtype=np.int16)\n    logm = math.log(2)\n    logboost = math.log(2.0)\n    for r, a in congr_dict.items():\n        cnt_array += (targets % r) == a\n        logm += math.log(r)\n        logboost += math.log(r / (r - 1))\n        \n    n_res = int((cnt_array == 0).sum())\n    boost = math.exp(logboost)\n    m_digits = logm / math.log(10)\n    \n    ub = n_res * boost\n    LN10 = math.log(10)\n    D = (m_digits + math.sqrt(m_digits ** 2 + 4 * ub / (LN10 * LN10))) / 2\n    \n    # Constrain E <= 17.5 via Lagrangian penalty to prevent reward hacking\n    E_limit = 17.5\n    E_actual = ub / (D * LN10) if D > 0 else 0.0\n    lagrangian_penalty = 0.0\n    if E_actual > E_limit:\n        lagrangian_penalty = 100.0 * (E_actual - E_limit) ** 2\n        \n    score_headline = -float(D + lagrangian_penalty)\n    \n    # Expose E, |U|, digits(M) as negated secondary metrics for joint optimization visibility\n    return {\n        "neg_est_digits": score_headline,\n        "neg_E": -float(E_actual),\n        "neg_residual_count": -float(n_res),\n        "neg_m_digits": -float(m_digits)\n    }\n'}]}, 'evaluation': {'scores': {'scores': [{'metric': 'neg_est_digits', 'score': -192.38857}, {'metric': 'neg_E', 'score': -17.495766}, {'metric': 'neg_residual_count', 'score': -717}, {'metric': 'neg_m_digits', 'score': -184.79025}]}, 'insights': {'insights': [{'label': 'Evaluation Metrics', 'text': 'Estimated Digits: 192.3886 (constrained), E: 17.4958, |U|: 717, digits(M): 184.79'}]}}, 'parentPrograms': ['projects/799795028847/locations/global/collections/default_collection/engines/goldbach_1784979910032/sessions/7658735534374771723/alphaEvolveExperiments/9582896010645531772/alphaEvolvePrograms/11597998738524454557'], 'state': 'COMPLETED'}, {'name': 'projects/799795028847/locations/global/collections/default_collection/engines/goldbach_1784979910032/sessions/7658735534374771723/alphaEvolveExperiments/9582896010645531772/alphaEvolvePrograms/11597998738524451651', 'createTime': '2026-07-26T09:04:43.001740Z', 'content': {'files': [{'path': 'program.py', 'content': '# Copyright 2026 Google LLC\nfrom typing import Any, Mapping\nimport math\nimport random\nimport numpy as np\n\n# EVOLVE-BLOCK-START\ndef optimize_cover_step(congr_dict, cand_mods, targets, cnt_array, logm, logboost, t_temp):\n    """Optimize a single step of congruence cover using simulated annealing style logic.\n\n    Args:\n        congr_dict: Dictionary of r -> a\n        cand_mods: List of prime candidates\n        targets: np.array of target primes\n        cnt_array: np.array of coverage counts\n        logm: current log of modulus M\n        logboost: current log of boost factor\n        t_temp: current temperature\n\n    Returns:\n        Updated congr_dict\n    """\n    import numpy as np\n    import random\n    import math\n\n    if len(targets) == 0:\n        return congr_dict\n\n    LN10 = math.log(10)\n    C_UB = 4.0 / (LN10 * LN10)\n    \n    def compute_score(lm, lb, nr):\n        m_digits = lm / LN10\n        ub = nr * math.exp(lb)\n        D = (m_digits + math.sqrt(max(0.0, m_digits ** 2 + C_UB * ub))) / 2\n        E_actual = ub / (D * LN10) if D > 0 else 0.0\n        lagrangian_penalty = 100.0 * (E_actual - 17.5) ** 2 if E_actual > 17.5 else 0.0\n        return -float(D + lagrangian_penalty)\n\n    # Pre-calculate modulo values for all candidates to massively speed up inner loops\n    if not hasattr(optimize_cover_step, "mod_cache"):\n        optimize_cover_step.mod_cache = {r: (targets % r).astype(np.int16) for r in cand_mods}\n    mod_cache = optimize_cover_step.mod_cache\n\n    # Crazy idea: Combine the massive speedup of the modulo cache with a neighborhood \n    # search (multiple candidate proposals) and simulated annealing acceptance.\n    inner_steps = 2000\n    congr_dict = dict(congr_dict)\n    cnt_array = np.array(cnt_array, dtype=np.int16)\n    \n    uncovered_mask = (cnt_array == 0)\n    single_cover_mask = (cnt_array == 1)\n    n_res_curr = np.sum(uncovered_mask)\n    S_curr = compute_score(logm, logboost, n_res_curr)\n\n    for step in range(inner_steps):\n        t_curr = t_temp * (0.0258 ** (step / inner_steps))\n        temp = max(t_curr, 1e-6)\n        \n        action_choice = random.random()\n        mods_in = list(congr_dict.keys())\n        cand_pool = [m for m in cand_mods if m not in congr_dict]\n        \n        if not mods_in:\n            action = \'add\'\n        elif not cand_pool:\n            action = \'drop\' if action_choice < 0.5 else \'optimize\'\n        else:\n            if action_choice < 0.20:\n                action = \'add\'\n            elif action_choice < 0.40:\n                action = \'drop\'\n            elif action_choice < 0.80:\n                action = \'swap\'\n            else:\n                action = \'optimize\'\n\n        if action == \'drop\':\n            sampled_mods = random.sample(mods_in, min(20, len(mods_in)))\n            best_score = -999999.0\n            best_r = None\n            \n            for r in sampled_mods:\n                a = congr_dict[r]\n                uncovered_count = np.sum(single_cover_mask & (mod_cache[r] == a))\n                n_res_new = n_res_curr + uncovered_count\n                logm_new = logm - math.log(r)\n                logboost_new = logboost - math.log(r / (r - 1))\n                \n                score = compute_score(logm_new, logboost_new, n_res_new)\n                if score > best_score:\n                    best_score = score\n                    best_r = r\n            \n            if best_r is not None:\n                diff = best_score - S_curr\n                if diff >= 0 or random.random() < math.exp(diff / temp):\n                    a_drop = congr_dict[best_r]\n                    cnt_array -= (mod_cache[best_r] == a_drop)\n                    del congr_dict[best_r]\n                    logm -= math.log(best_r)\n                    logboost -= math.log(best_r / (best_r - 1))\n                    S_curr = best_score\n                    uncovered_mask = (cnt_array == 0)\n                    single_cover_mask = (cnt_array == 1)\n                    n_res_curr = np.sum(uncovered_mask)\n\n        elif action == \'add\':\n            sampled_cands = random.sample(cand_pool, min(40, len(cand_pool)))\n            best_score = -999999.0\n            best_r = None\n            best_a = None\n            \n            for r in sampled_cands:\n                uncovered_targets_mod = mod_cache[r][uncovered_mask]\n                if len(uncovered_targets_mod) > 0:\n                    counts = np.bincount(uncovered_targets_mod, minlength=r)\n                    a = int(np.argmax(counts))\n                    cov_count = counts[a]\n                else:\n                    a = 0\n                    cov_count = 0\n                \n                n_res_new = n_res_curr - cov_count\n                logm_new = logm + math.log(r)\n                logboost_new = logboost + math.log(r / (r - 1))\n                \n                score = compute_score(logm_new, logboost_new, n_res_new)\n                if score > best_score:\n                    best_score = score\n                    best_r = r\n                    best_a = a\n                    \n            if best_r is not None:\n                diff = best_score - S_curr\n                if diff >= 0 or random.random() < math.exp(diff / temp):\n                    congr_dict[best_r] = best_a\n                    cnt_array += (mod_cache[best_r] == best_a)\n                    logm += math.log(best_r)\n                    logboost += math.log(best_r / (best_r - 1))\n                    S_curr = best_score\n                    uncovered_mask = (cnt_array == 0)\n                    single_cover_mask = (cnt_array == 1)\n                    n_res_curr = np.sum(uncovered_mask)\n\n        elif ac