import Any, Mapping\nimport math\nimport random\nimport numpy as np\n\n# EVOLVE-BLOCK-START\n_MOD_CACHE = {}\n\ndef optimize_cover_step(congr_dict, cand_mods, targets, cnt_array, logm, logboost, t_temp):\n    """Optimize a single step of congruence cover using simulated annealing style logic.\n\n    Args:\n        congr_dict: Dictionary of r -> a\n        cand_mods: List of prime candidates\n        targets: np.array of target primes\n        cnt_array: np.array of coverage counts\n        logm: current log of modulus M\n        logboost: current log of boost factor\n        t_temp: current temperature\n\n    Returns:\n        Updated congr_dict\n    """\n    import numpy as np\n    import random\n\n    if len(targets) == 0:\n        # Safety fallback\n        kind = random.random()\n        r_in = random.choice(list(congr_dict)) if congr_dict else None\n        if kind < 0.5 and r_in is not None:\n            a_old = congr_dict[r_in]\n            a_new = random.randint(0, r_in - 1)\n            if a_new != a_old:\n                congr_dict[r_in] = a_new\n        elif kind < 0.7 and r_in is not None:\n            del congr_dict[r_in]\n        else:\n            r_out = random.choice(cand_mods)\n            if r_out not in congr_dict:\n                a_new = random.randint(0, r_out - 1)\n                congr_dict[r_out] = a_new\n        return congr_dict\n\n    global _MOD_CACHE\n    if _MOD_CACHE is None:\n        _MOD_CACHE = {}\n\n    LN10 = np.log(10)\n    cache_key_prefix = (len(targets), int(targets[0]), int(targets[-1]))\n\n    def calc_D(M, B, N):\n        K_const = 4.0 / (LN10 * LN10)\n        return (M + np.sqrt(M**2 + K_const * N * B)) / 2.0\n\n    # Ensure cnt_array is writable/copied if needed\n    cnt_array = cnt_array.copy()\n\n    # Track the best configuration seen during this step\n    best_congr_dict = congr_dict.copy()\n    best_D = calc_D(logm / LN10, np.exp(logboost), np.sum(cnt_array == 0))\n\n    K_inner = 25  # Number of inner local search/annealing steps\n    for step in range(K_inner):\n        uncovered_idx = np.where(cnt_array == 0)[0]\n        N = len(uncovered_idx)\n\n        M_cur = logm / LN10\n        B_cur = np.exp(logboost)\n        D_cur = calc_D(M_cur, B_cur, N)\n\n        proposals = []\n\n        # 1. Add proposals\n        cand_pool = [m for m in cand_mods if m not in congr_dict]\n        if cand_pool:\n            sample_size = min(300, len(cand_pool))\n            sampled_cands = random.sample(cand_pool, sample_size)\n            for r in sampled_cands:\n                cache_key = cache_key_prefix + (r,)\n                if cache_key not in _MOD_CACHE:\n                    _MOD_CACHE[cache_key] = targets % r\n                rem = _MOD_CACHE[cache_key]\n\n                rem_uncovered = rem[uncovered_idx]\n                counts = np.bincount(rem_uncovered, minlength=r)\n                a = int(np.argmax(counts))\n                dn = counts[a]\n\n                M_new = (logm + np.log(r)) / LN10\n                B_new = B_cur * r / (r - 1)\n                N_new = N - dn\n\n                D_new = calc_D(M_new, B_new, N_new)\n                proposals.append((\'add\', r, a, D_new))\n\n        # 2. Drop proposals\n        if congr_dict:\n            for r in congr_dict:\n                a = congr_dict[r]\n                cache_key = cache_key_prefix + (r,)\n                if cache_key not in _MOD_CACHE:\n                    _MOD_CACHE[cache_key] = targets % r\n                rem = _MOD_CACHE[cache_key]\n\n                mask = (rem == a)\n                dn_lost = np.sum((cnt_array == 1) & mask)\n\n                M_new = (logm - np.log(r)) / LN10\n                B_new = B_cur * (r - 1) / r\n                N_new = N + dn_lost\n\n                D_new = calc_D(M_new, B_new, N_new)\n                proposals.append((\'drop\', r, None, D_new))\n\n        # 3. Optimize proposals\n        if congr_dict:\n            for r in congr_dict:\n                a_old = congr_dict[r]\n                cache_key = cache_key_prefix + (r,)\n                if cache_key not in _MOD_CACHE:\n                    _MOD_CACHE[cache_key] = targets % r\n                rem = _MOD_CACHE[cache_key]\n\n                is_covered_by_r = (rem == a_old)\n                cnt_bg = cnt_array - is_covered_by_r\n\n                uncovered_bg_idx = np.where(cnt_bg == 0)[0]\n                rem_uncovered_bg = rem[uncovered_bg_idx]\n                counts = np.bincount(rem_uncovered_bg, minlength=r)\n                a_new = int(np.argmax(counts))\n\n                if a_new != a_old:\n                    dn_new = counts[a_new]\n                    dn_old = np.sum((cnt_array == 1) & is_covered_by_r)\n\n                    M_new = M_cur\n                    B_new = B_cur\n                    N_new = N + dn_old - dn_new\n\n                    D_new = calc_D(M_new, B_new, N_new)\n                    proposals.append((\'optimize\', r, a_new, D_new))\n\n        if not proposals:\n            break\n\n        # Unified simulated annealing selection\n        scores = np.array([-p[3] for p in proposals])\n        max_score = np.max(scores)\n        scaled_scores = scores - max_score\n\n        # Linear schedule of temperature inside the step\n        temp_step = max(t_temp * (1.0 - step / K_inner), 1e-4)\n\n        gumbel_noise = np.random.gumbel(size=len(scores))\n        idx = np.argmax(scaled_scores / temp_step + gumbel_noise)\n\n        action, r, a, D_new = proposals[idx]\n\n        # Apply action\n        if action == \'add\':\n            congr_dict[r] = a\n            cache_key = cache_key_prefix + (r,)\n            rem = _MOD_CACHE[cache_key]\n            cnt_array += (rem == a).astype(np.int16)\n            logm += np.log(r)\n            logboost += np.log(r / (r - 1))\n\n        elif action == \'drop\':\n            a_old = congr_dict[r]\n            cache_key = cache_key_prefix + (r,)\n            rem = _MOD_CACHE[cache_key]\n            cnt_array -= (rem == a_old).astype(np.int16)\n            logm -= np.log(r)\n            logboost -= np.log(r / (r - 1))\n            del congr_dict[r]\n\n        elif action == \'optimize\':\n            a_old = congr_dict[r]\n            cache_key = cache_key_prefix + (r,)\n            rem = _MOD_CACHE[cache_key]\n            cnt_array -= (rem == a_old).astype(np.int16)\n            cnt_array += (rem == a).astype(np.int16)\n            congr_dict[r] = a\n\n        # Update best configuration seen so far\n        current_D = calc_D(logm / LN10, np.exp(logboost), np.sum(cnt_array == 0))\n        if current_D < best_D:\n            best_D = current_D\n            best_congr_dict = congr_dict.copy()\n\n    return best_congr_dict\n# EVOLVE-BLOCK-END\n\ndef evaluate(eval_inputs: Mapping[str, Any]) -> dict[str, float]:\n    """Run evaluation on the optimized step."""\n    # Let\'s say we maximize -n_digits_est (smaller estimated N-size)\n    # Using sympy/math to compute est digits\n    import sympy\n    import numpy as np\n    Q = 100003\n    targets = np.array(list(sympy.primerange(3, Q)), dtype=np.int64)\n    # Let\'s run the optimize_cover_step starting from empty cover for some iterations\n    congr_dict = {}\n    cand_mods = [int(r) for r in sympy.primerange(3, 8000)]\n    cnt_array = np.zeros(len(targets), dtype=np.int16)\n    logm = math.log(2)\n    logboost = math.log(2.0)\n    \n    for it in range(10):\n        t_temp = 0.8 * (0.02 / 0.8) ** (it / 10)\n        # Update cnt_array based on congr_dict\n        cnt_array = np.zeros(len(targets), dtype=np.int16)\n        logm = math.log(2)\n        logboost = math.log(2.0)\n        for r, a in congr_dict.items():\n            cnt_array += (targets % r) == a\n            logm += math.log(r)\n            logboost += math.log(r / (r - 1))\n            \n        congr_dict = optimize_cover_step(congr_dict, cand_mods, targets, cnt_array, logm, logboost, t_temp)\n        \n    # Recalculate final metrics\n    cnt_array = np.zeros(len(targets), dtype=np.int16)\n    logm = math.log(2)\n    logboost = math.log(2.0)\n    for r, a in congr_dict.items():\n        cnt_array += (targets % r) == a\n        logm += math.log(r)\n        logboost += math.log(r / (r - 1))\n        \n    n_res = int((cnt_array == 0).sum())\n    boost = math.exp(logboost)\n    m_digits = logm / math.log(10)\n    \n    ub = n_res * boost\n    LN10 = math.log(10)\n    D = (m_digits + math.sqrt(m_digits ** 2 + 4 * ub / (LN10 * LN10))) / 2\n    return {"neg_est_digits": -float(D)}\n'}]}, 'evaluation': {'scores': {'scores': [{'metric': 'neg_est_digits', 'score': -50.655006}]}}, 'parentPrograms': ['projects/799795028847/locations/global/collections/default_collection/engines/goldbach_1784979910032/sessions/7013217697778074030/alphaEvolveExperiments/15164875354338173448/alphaEvolvePrograms/18102573509735108708'], 'state': 'COMPLETED'}, {'name': 'projects/799795028847/locations/global/collections/default_collection/engines/goldbach_1784979910032/sessions/7013217697778074030/alphaEvolveExperiments/15164875354338173448/alphaEvolvePrograms/18102573509735110733', 'createTime': '2026-07-25T20:16:41.308343Z', 'content': {'files': [{'path': 'program.py', 'content': '# Copyright 2026 Google LLC\nfrom typing import Any, Mapping\nimport math\nimport random\nimport numpy as np\n\n# EVOLVE-BLOCK-START\ndef optimize_cover_step(congr_dict, cand_mods, targets, cnt_array, logm, logboost, t_temp, _mod_cache={}, _log_cache={}):\n    """Optimize congruence cover using multi-step exact simulated annealing logic."""\n    import numpy as np\n    import random\n    import math\n\n    def calc_D(m_val, ub_val):\n        m_dig = m_val * 0.43429448190325182  # 1 / LN10\n        return (m_dig + math.sqrt(m_dig**2 + ub_val * 0.7544468205288924)) / 2\n\n    if len(targets) == 0:\n        return congr_dict\n\n    # Cast cnt_array to np.int16 for faster element-wise operations and lower memory footprint\n    cnt_array = np.array(cnt_array, dtype=np.int16)\n\n    # Use mutable default arguments to persist cache safely across iterative runs\n    mod_map = _mod_cache.setdefault(id(targets), {})\n\n    # Drastically increased step budget enabled by caching and array speedups\n    internal_steps = 15000\n\n    n_res = int(np.count_nonzero(cnt_array == 0))\n    current_ub = n_res * math.exp(logboost)\n    current_D = calc_D(logm, current_ub)\n\n    for _ in range(internal_steps):\n        if not congr_dict:\n            action = \'add\'\n        else:\n            rand_val = random.random()\n            if rand_val < 0.40:\n                action = \'add\'\n            elif rand_val < 0.70:\n                action = \'drop\'\n            else:\n                action = \'optimize\'\n\n        if action == \'add\':\n            # Biased selection towards smaller primes to minimize logm increase\n            for _ in range(15):\n                idx = int(len(cand_mods) * (random.random() ** 2.2))\n                r = cand_mods[idx]\n                if r not in congr_dict:\n                    break\n            else:\n                continue\n            \n            if r not in mod_map:\n                mod_map[r] = targets % r\n            r_mod = mod_map[r]\n            \n            if n_res > 0:\n                uncovered_mask = (cnt_array == 0)\n                counts = np.bincount(r_mod[uncovered_mask], minlength=r)\n                a = int(np.argmax(counts))\n                max_covered = counts[a]\n            else:\n                a = 0\n                max_covered = 0\n                \n            new_n_res = n_res - max_covered\n            \n            if r not in _log_cache:\n                _log_cache[r] = (math.log(r), math.log(r / (r - 1)))\n            log_r, log_r_ratio = _log_cache[r]\n            \n            new_logm = logm + log_r\n            new_logboost = logboost + log_r_ratio\n            new_ub = new_n_res * math.exp(new_logboost)\n            new_D = calc_D(new_logm, new_ub)\n            \n            if new_D < current