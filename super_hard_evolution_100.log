_all(congr_dict, cnt_array)\n    return congr_dict\n# EVOLVE-BLOCK-END\n\ndef evaluate(eval_inputs: Mapping[str, Any]) -> dict[str, float]:\n    """Run evaluation on the optimized step."""\n    import sympy\n    import numpy as np\n    Q = 100003\n    targets = np.array(list(sympy.primerange(3, Q)), dtype=np.int64)\n    \n    # Warm-start from the 195-digit record cover instead of starting empty\n    congr_dict = {int(r): int(a) for r, a in eval_inputs["warm_start_cover"]}\n    \n    cand_mods = [int(r) for r in sympy.primerange(3, 8000)]\n    cnt_array = np.zeros(len(targets), dtype=np.int16)\n    \n    # Pre-populate counts\n    for r, a in congr_dict.items():\n        cnt_array += (targets % r) == a\n        \n    for it in range(10):\n        t_temp = 0.8 * (0.02 / 0.8) ** (it / 10)\n        # Recalculate cnt_array based on congr_dict\n        cnt_array = np.zeros(len(targets), dtype=np.int16)\n        logm = math.log(2)\n        logboost = math.log(2.0)\n        for r, a in congr_dict.items():\n            cnt_array += (targets % r) == a\n            logm += math.log(r)\n            logboost += math.log(r / (r - 1))\n            \n        congr_dict = optimize_cover_step(congr_dict, cand_mods, targets, cnt_array, logm, logboost, t_temp)\n        \n    # Recalculate final metrics\n    cnt_array = np.zeros(len(targets), dtype=np.int16)\n    logm = math.log(2)\n    logboost = math.log(2.0)\n    for r, a in congr_dict.items():\n        cnt_array += (targets % r) == a\n        logm += math.log(r)\n        logboost += math.log(r / (r - 1))\n        \n    n_res = int((cnt_array == 0).sum())\n    boost = math.exp(logboost)\n    m_digits = logm / math.log(10)\n    \n    ub = n_res * boost\n    LN10 = math.log(10)\n    D = (m_digits + math.sqrt(m_digits ** 2 + 4 * ub / (LN10 * LN10))) / 2\n    \n    # Constrain E <= 17.5 via Lagrangian penalty to prevent reward hacking\n    E_limit = 17.5\n    E_actual = ub / (D * LN10) if D > 0 else 0.0\n    lagrangian_penalty = 0.0\n    if E_actual > E_limit:\n        lagrangian_penalty = 100.0 * (E_actual - E_limit) ** 2\n        \n    score_headline = -float(D + lagrangian_penalty)\n    \n    # Expose E, |U|, digits(M) as negated secondary metrics for joint optimization visibility\n    return {\n        "neg_est_digits": score_headline,\n        "neg_E": -float(E_actual),\n        "neg_residual_count": -float(n_res),\n        "neg_m_digits": -float(m_digits)\n    }\n'}]}, 'evaluation': {'scores': {'scores': [{'metric': 'neg_est_digits', 'score': -595.0053}, {'metric': 'neg_E', 'score': -2.081384}, {'metric': 'neg_residual_count', 'score': -220}, {'metric': 'neg_m_digits', 'score': -594.1014}]}, 'insights': {'insights': [{'label': 'Evaluation Metrics', 'text': 'Estimated Digits: 595.0053 (constrained), E: 2.0814, |U|: 220, digits(M): 594.10'}]}}, 'parentPrograms': ['projects/799795028847/locations/global/collections/default_collection/engines/goldbach_1784979910032/sessions/7658735534374771723/alphaEvolveExperiments/9582896010645531772/alphaEvolvePrograms/7662895210918131606', 'projects/799795028847/locations/global/collections/default_collection/engines/goldbach_1784979910032/sessions/7658735534374771723/alphaEvolveExperiments/9582896010645531772/alphaEvolvePrograms/7662895210918131403', 'projects/799795028847/locations/global/collections/default_collection/engines/goldbach_1784979910032/sessions/7658735534374771723/alphaEvolveExperiments/9582896010645531772/alphaEvolvePrograms/7662895210918129792', 'projects/799795028847/locations/global/collections/default_collection/engines/goldbach_1784979910032/sessions/7658735534374771723/alphaEvolveExperiments/9582896010645531772/alphaEvolvePrograms/7662895210918131403'], 'state': 'COMPLETED'}, {'name': 'projects/799795028847/locations/global/collections/default_collection/engines/goldbach_1784979910032/sessions/7658735534374771723/alphaEvolveExperiments/9582896010645531772/alphaEvolvePrograms/11597998738524452781', 'createTime': '2026-07-26T09:07:57.082357Z', 'content': {'files': [{'path': 'program.py', 'content': '# Copyright 2026 Google LLC\nfrom typing import Any, Mapping\nimport math\nimport random\nimport numpy as np\n\n# EVOLVE-BLOCK-START\ndef optimize_cover_step(congr_dict, cand_mods, targets, cnt_array, logm, logboost, t_temp):\n    """Optimize a single step of congruence cover using simulated annealing style logic.\n\n    Args:\n        congr_dict: Dictionary of r -> a\n        cand_mods: List of prime candidates\n        targets: np.array of target primes\n        cnt_array: np.array of coverage counts\n        logm: current log of modulus M\n        logboost: current log of boost factor\n        t_temp: current temperature\n\n    Returns:\n        Updated congr_dict\n    """\n    import numpy as np\n    import random\n\n    if len(targets) == 0:\n        # Safety fallback\n        kind = random.random()\n        r_in = random.choice(list(congr_dict)) if congr_dict else None\n        if kind < 0.5 and r_in is not None:\n            a_old = congr_dict[r_in]\n            a_new = random.randint(0, r_in - 1)\n            if a_new != a_old:\n                congr_dict[r_in] = a_new\n        elif kind < 0.7 and r_in is not None:\n            del congr_dict[r_in]\n        else:\n            r_out = random.choice(cand_mods)\n            if r_out not in congr_dict:\n                a_new = random.randint(0, r_out - 1)\n                congr_dict[r_out] = a_new\n        return congr_dict\n\n    def get_cost(n_res, lm, lb):\n        LN10 = math.log(10)\n        boost = math.exp(lb)\n        m_dig = lm / LN10\n        ub = n_res * boost\n        if m_dig <= 0 and ub <= 0: return 0.0\n        D = (m_dig + math.sqrt(m_dig**2 + 4 * ub / (LN10 * LN10))) / 2\n        E_act = ub / (D * LN10) if D > 0 else 0.0\n        pen = 100.0 * max(0.0, E_act - 17.5)**2\n        return D + pen\n\n    N_INTERNAL = 300\n    decay_factor = (0.02 / 0.8) ** (0.1 / N_INTERNAL)\n    t_curr = t_temp\n\n    for inner_it in range(N_INTERNAL):\n        t_curr *= decay_factor\n        # Dynamic action probabilities based on temperature\n        factor = np.clip(t_curr, 0.0, 1.0)\n        p_opt = 0.85 - 0.45 * factor\n        p_add = 0.10 + 0.25 * factor\n        p_drop = 0.05 + 0.20 * factor\n        total_p = p_opt + p_add + p_drop\n        p_opt /= total_p\n        p_add /= total_p\n        p_drop /= total_p\n\n        kind = random.random()\n        cand_pool = [m for m in cand_mods if m not in congr_dict]\n        \n        if not congr_dict:\n            action = \'add\'\n        else:\n            if not cand_pool:\n                p_opt_cond = p_opt / (p_opt + p_drop)\n                action = \'optimize\' if kind < p_opt_cond else \'drop\'\n            else:\n                if kind < p_add:\n                    action = \'add\'\n                elif kind < p_add + p_opt:\n                    action = \'optimize\'\n                else:\n                    action = \'drop\'\n\n        if action == \'add\':\n            if cand_pool:\n                sample_size = min(100, len(cand_pool))\n                sampled_cands = random.sample(cand_pool, sample_size)\n                \n                base_n_res = int((cnt_array == 0).sum())\n                uncovered_targets = targets[cnt_array == 0]\n                \n                costs = []\n                cands_data = []\n                for r in sampled_cands:\n                    if len(uncovered_targets) > 0:\n                        counts = np.bincount(uncovered_targets % r, minlength=r)\n                        a = int(np.argmax(counts))\n                        cov = counts[a]\n                    else:\n                        a = 0\n                        cov = 0\n                    \n                    new_n_res = base_n_res - cov\n                    new_lm = logm + math.log(r)\n                    new_lb = logboost + math.log(r / (r - 1))\n                    c = get_cost(new_n_res, new_lm, new_lb)\n                    costs.append(c)\n                    cands_data.append((r, a))\n                \n                costs = np.array(costs)\n                temp = max(t_curr, 1e-4)\n                scaled_costs = -costs / temp\n                scaled_costs = scaled_costs - np.max(scaled_costs)\n                probs = np.exp(scaled_costs)\n                probs /= np.sum(probs)\n                \n                idx = np.random.choice(len(sampled_cands), p=probs)\n                best_cand, best_a = cands_data[idx]\n                \n                congr_dict[best_cand] = int(best_a)\n                cnt_array += (targets % best_cand) == best_a\n                logm += math.log(best_cand)\n                logboost += math.log(best_cand / (best_cand - 1))\n\n        elif action == \'optimize\':\n            mods_in = list(congr_dict.keys())\n            if mods_in:\n                r = random.choice(mods_in)\n                a_old = congr_dict[r]\n                \n                is_covered_by_r = (targets % r) == a_old\n                cnt_bg = cnt_array - is_covered_by_r\n                \n                uncovered_targets = targets[cnt_bg == 0]\n                if len(uncovered_targets) > 0:\n                    counts = np.bincount(uncovered_targets % r, minlength=r)\n                else:\n                    counts = np.zeros(r, dtype=int)\n                \n                base_n_res = int((cnt_bg == 0).sum())\n                new_n_res_array = base_n_res - counts\n                \n                LN10 = math.log(10)\n                boost = math.exp(logboost)\n                m_dig = logm / LN10\n                ub_array = new_n_res_array * boost\n                D_array = (m_dig + np.sqrt(m_dig**2 + 4 * ub_array / (LN10 * LN10))) / 2\n                D_safe = np.where(D_array > 0, D_array, 1.0)\n                E_act_array = np.where(D_array > 0, ub_array / (D_safe * LN10), 0.0)\n                pen_array = 100.0 * np.maximum(0.0, E_act_array - 17.5)**2\n                costs = D_array + pen_array\n                \n                temp = max(t_curr, 1e-4)\n                scaled_costs = -costs / temp\n                scaled_costs = scaled_costs - np.max(scaled_costs)\n                probs = np.exp(scaled_costs)\n                probs /= np.sum(probs)\n                \n                a_new = np.random.choice(r, p=probs)\n                if a_new != a_old:\n                    congr_dict[r] = int(a_new)\n                    cnt_array = cnt_bg + ((targets % r) == a_new)\n\n        elif action == \'drop\':\n            mods_in = list(congr_dict.keys())\n            if mods_in:\n                costs = []\n                ones_mask = (cnt_array == 1)\n                targets_ones = targets[ones_mask]\n                base_n_res = int((cnt_array == 0).sum())\n                \n                for r in mods_in:\n                    a = congr_dict[r]\n                    if len(targets_ones) > 0:\n                        inc = int(np.sum((targets_ones % r) == a))\n                    else:\n                        inc = 0\n                    new_n_res = base_n_res + inc\n                    new_lm = logm - math.log(r)\n                    new_lb = logboost - math.log(r / (r - 1))\n                    \n                    c = get_cost(new_n_res, new_lm, new_lb)\n                    costs.append(c)\n                    \n                costs = np.array(costs)\n                temp = max(t_curr, 1e-4)\n                scaled_costs = -costs / temp\n                scaled_costs = scaled_costs - np.max(scaled_costs)\n                probs = np.exp(scaled_costs)\n                probs /= np.sum(probs)\n                \n                idx = np.random.choice(len(mods_in), p=probs)\n                r_drop = mods_in[idx]\n                a_drop = congr_dict[r_drop]\n                \n                del congr_dict[r_drop]\n                cnt_array -= (targets % r_drop) == a_drop\n                logm -= math.log(r_drop)\n                logboost -= math.log(r_drop / (r_drop - 1))\n\n    return congr_dict\n# EVOLVE-BLOCK-END\n\ndef evaluate(eval_inputs: Mapping[str, Any]) -> dict[str, float]:\n    """Run evaluation on the optimized step."""\n    import sympy\n    import numpy as np\n    Q = 100003\n    targets = np.array(list(sympy.primerange(3, Q)), dtype=np.int64)\n    \n    # Warm-start from the 195-digit record cover instead of starting empty\n    congr_dict = {int(r): int(a) for r, a in eval_inputs["warm_start_cover"]}\n    \n    cand_mods = [int(r) for r in sympy.primerange(3, 8000)]\n    cnt_array = np.zeros(len(targets), dtype=np.int16)\n    \n    # Pre-populate counts\n    for r, a in congr_dict.items():\n        cnt_array += (targets % r) == a\n        \n    for it in range(10):\n        t_temp = 0.8 * (0.02 / 0.8) ** (it / 10)\n        # Recalculate cnt_array based on congr_dict\n        cnt_array = np.zeros(len(targets), dtype=np.int16)\n        logm = math.log(2)\n        logboost = math.log(2.0)\n        for r, a in congr_dict.items():\n            cnt_array += (targets % r) == a\n            logm += math.log(r)\n            logboost += math.log(r / (r - 1))\n            \n        congr_dict = optimize_cover_step(congr_dict, cand_mods, targets, cnt_array, logm, logboost, t_temp)\n        \n    # Recalculate final metrics\n    cnt_array = np.zeros(len(targets), dtype=np.int16)\n    logm = math.log(2)\n    logboost = math.log(2.0)\n    for r, a in congr_dict.items():\n        cnt_array += (targets % r) == a\n        logm += math.log(r)\n        logboost += math.log(r / (r - 1))\n        \n    n_res = int((cnt_array == 0).sum())\n    boost = math.exp(logboost)\n    m_digits = logm / math.log(10)\n    \n    ub = n_res * boost\n    LN10 = math.log(10)\n    D = (m_digits + math.sqrt(m_digits ** 2 + 4 * ub / (LN10 * LN10))) / 2\n    \n    # Constrain E <= 17.5 via Lagrangian penalty to prevent reward hacking\n    E_limit = 17.5\n    E_actual = ub / (D * LN10) if D > 0 else 0.0\n    lagrangian_penalty = 0.0\n   