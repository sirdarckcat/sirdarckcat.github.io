         uncovered_targets = targets[cnt_array == 0]\n                if len(uncovered_targets) > 0:\n                    counts = np.bincount(uncovered_targets % r, minlength=r)\n                    a_new = int(np.argmax(counts))\n                else:\n                    a_new = 0\n                    \n                new_n_res = n_res\n                if a_new != a_old:\n                    cnt_array[(targets % r) == a_new] += 1\n                    new_n_res = int((cnt_array == 0).sum())\n                    new_D = calc_D_val(new_n_res, logm, logboost)\n                    delta = new_D - current_D\n                    if delta <= 0 or random.random() < math.exp(-delta / temp):\n                        congr_dict[r] = a_new\n                        current_D = new_D\n                        n_res = new_n_res\n                    else:\n                        cnt_array[(targets % r) == a_new] -= 1\n                        cnt_array[is_cov] += 1\n                else:\n                    cnt_array[is_cov] += 1\n\n    n_res, current_D = optimize_all(congr_dict, cnt_array, n_res, logm, logboost, current_D)\n    return congr_dict\n# EVOLVE-BLOCK-END\n\ndef evaluate(eval_inputs: Mapping[str, Any]) -> dict[str, float]:\n    """Run evaluation on the optimized step."""\n    import sympy\n    import numpy as np\n    Q = 100003\n    targets = np.array(list(sympy.primerange(3, Q)), dtype=np.int64)\n    \n    # Warm-start from the 195-digit record cover instead of starting empty\n    congr_dict = {int(r): int(a) for r, a in eval_inputs["warm_start_cover"]}\n    \n    cand_mods = [int(r) for r in sympy.primerange(3, 8000)]\n    cnt_array = np.zeros(len(targets), dtype=np.int16)\n    \n    # Pre-populate counts\n    for r, a in congr_dict.items():\n        cnt_array += (targets % r) == a\n        \n    for it in range(10):\n        t_temp = 0.8 * (0.02 / 0.8) ** (it / 10)\n        # Recalculate cnt_array based on congr_dict\n        cnt_array = np.zeros(len(targets), dtype=np.int16)\n        logm = math.log(2)\n        logboost = math.log(2.0)\n        for r, a in congr_dict.items():\n            cnt_array += (targets % r) == a\n            logm += math.log(r)\n            logboost += math.log(r / (r - 1))\n            \n        congr_dict = optimize_cover_step(congr_dict, cand_mods, targets, cnt_array, logm, logboost, t_temp)\n        \n    # Recalculate final metrics\n    cnt_array = np.zeros(len(targets), dtype=np.int16)\n    logm = math.log(2)\n    logboost = math.log(2.0)\n    for r, a in congr_dict.items():\n        cnt_array += (targets % r) == a\n        logm += math.log(r)\n        logboost += math.log(r / (r - 1))\n        \n    n_res = int((cnt_array == 0).sum())\n    boost = math.exp(logboost)\n    m_digits = logm / math.log(10)\n    \n    ub = n_res * boost\n    LN10 = math.log(10)\n    D = (m_digits + math.sqrt(m_digits ** 2 + 4 * ub / (LN10 * LN10))) / 2\n    \n    # Constrain E <= 17.5 via Lagrangian penalty to prevent reward hacking\n    E_limit = 17.5\n    E_actual = ub / (D * LN10) if D > 0 else 0.0\n    lagrangian_penalty = 0.0\n    if E_actual > E_limit:\n        lagrangian_penalty = 100.0 * (E_actual - E_limit) ** 2\n        \n    score_headline = -float(D + lagrangian_penalty)\n    \n    # Expose E, |U|, digits(M) as negated secondary metrics for joint optimization visibility\n    return {\n        "neg_est_digits": score_headline,\n        "neg_E": -float(E_actual),\n        "neg_residual_count": -float(n_res),\n        "neg_m_digits": -float(m_digits)\n    }\n'}]}, 'evaluation': {'scores': {'scores': [{'metric': 'neg_est_digits', 'score': -192.46277}, {'metric': 'neg_E', 'score': -17.489494}, {'metric': 'neg_residual_count', 'score': -707}, {'metric': 'neg_m_digits', 'score': -184.86717}]}, 'insights': {'insights': [{'label': 'Evaluation Metrics', 'text': 'Estimated Digits: 192.4628 (constrained), E: 17.4895, |U|: 707, digits(M): 184.87'}]}}, 'parentPrograms': ['projects/799795028847/locations/global/collections/default_collection/engines/goldbach_1784979910032/sessions/7658735534374771723/alphaEvolveExperiments/9582896010645531772/alphaEvolvePrograms/7662895210918132147', 'projects/799795028847/locations/global/collections/default_collection/engines/goldbach_1784979910032/sessions/7658735534374771723/alphaEvolveExperiments/9582896010645531772/alphaEvolvePrograms/7662895210918133436', 'projects/799795028847/locations/global/collections/default_collection/engines/goldbach_1784979910032/sessions/7658735534374771723/alphaEvolveExperiments/9582896010645531772/alphaEvolvePrograms/7662895210918129792', 'projects/799795028847/locations/global/collections/default_collection/engines/goldbach_1784979910032/sessions/7658735534374771723/alphaEvolveExperiments/9582896010645531772/alphaEvolvePrograms/7662895210918132147'], 'state': 'COMPLETED'}, {'name': 'projects/799795028847/locations/global/collections/default_collection/engines/goldbach_1784979910032/sessions/7658735534374771723/alphaEvolveExperiments/9582896010645531772/alphaEvolvePrograms/11597998738524451402', 'createTime': '2026-07-26T08:57:55.524865Z', 'content': {'files': [{'path': 'program.py', 'content': '# Copyright 2026 Google LLC\nfrom typing import Any, Mapping\nimport math\nimport random\nimport numpy as np\n\n# EVOLVE-BLOCK-START\ndef optimize_cover_step(congr_dict, cand_mods, targets, cnt_array, logm, logboost, t_temp):\n    """Optimize a single step of congruence cover using simulated annealing style logic.\n\n    Args:\n        congr_dict: Dictionary of r -> a\n        cand_mods: List of prime candidates\n        targets: np.array of target primes\n        cnt_array: np.array of coverage counts\n        logm: current log of modulus M\n        logboost: current log of boost factor\n        t_temp: current temperature\n\n    Returns:\n        Updated congr_dict\n    """\n    import math\n    import random\n    import numpy as np\n\n    # Ensure congr_dict values are python ints\n    congr_dict = {int(k): int(v) for k, v in congr_dict.items()}\n\n    LN10 = math.log(10)\n    \n    def get_score(nr, lm, lb):\n        if nr == 0:\n            return lm / LN10\n        md = lm / LN10\n        ub = nr * math.exp(lb)\n        D = (md + math.sqrt(md * md + 4 * ub / (LN10 * LN10))) / 2\n        E_actual = ub / (D * LN10) if D > 0 else 0.0\n        penalty = 0.0\n        if E_actual > 17.5:\n            penalty = 100.0 * (E_actual - 17.5) ** 2\n        return D + penalty\n\n    cnt_array = cnt_array.copy()\n    n_res = int((cnt_array == 0).sum())\n    curr_score = get_score(n_res, logm, logboost)\n    \n    num_steps = 500\n    \n    for _ in range(num_steps):\n        action = random.choices([\'add\', \'drop\', \'optimize\', \'swap\'], weights=[20, 20, 30, 30])[0]\n        \n        if action == \'add\':\n            cand_pool = [m for m in cand_mods if m not in congr_dict]\n            if not cand_pool:\n                continue\n            cand_pool_sorted = sorted(cand_pool)\n            cands = cand_pool_sorted[:15]\n            if len(cand_pool_sorted) > 15:\n                cands += random.sample(cand_pool_sorted[15:], min(25, len(cand_pool_sorted) - 15))\n                \n            uncovered = targets[cnt_array == 0]\n            if len(uncovered) == 0:\n                continue\n                \n            best_new_score = float(\'inf\')\n            best_r = None\n            best_a = None\n            best_hits = 0\n            \n            for r in cands:\n                rem = uncovered % r\n                counts = np.bincount(rem, minlength=r)\n                a = int(np.argmax(counts))\n                hits = counts[a]\n                \n                nr = n_res - hits\n                lm = logm + math.log(r)\n                lb = logboost + math.log(r / (r - 1))\n                sc = get_score(nr, lm, lb)\n                \n                if sc < best_new_score:\n                    best_new_score = sc\n                    best_r = r\n                    best_a = a\n                    best_hits = hits\n                    \n            if best_r is not None:\n                score_diff = best_new_score - curr_score\n                if score_diff < 0 or random.random() < math.exp(-score_diff / t_temp):\n                    congr_dict[best_r] = best_a\n                    cnt_array += ((targets % best_r) == best_a)\n                    n_res -= best_hits\n                    logm += math.log(best_r)\n                    logboost += math.log(best_r / (best_r - 1))\n                    curr_score = best_new_score\n                    \n        elif action == \'drop\':\n            mods_in = list(congr_dict.keys())\n            if not mods_in:\n                continue\n            cands = random.sample(mods_in, min(25, len(mods_in)))\n            \n            best_new_score = float(\'inf\')\n            best_r = None\n            best_a = None\n            best_unique = 0\n            best_mask = None\n            \n            for r in cands:\n                a = congr_dict[r]\n                mask = (targets % r) == a\n                unique_hits = np.sum((cnt_array == 1) & mask)\n                \n                nr = n_res + unique_hits\n                lm = logm - math.log(r)\n                lb = logboost - math.log(r / (r - 1))\n                sc = get_score(nr, lm, lb)\n                \n                if sc < best_new_score:\n                    best_new_score = sc\n                    best_r = r\n                    best_a = a\n                    best_unique = unique_hits\n                    best_mask = mask\n                    \n            if best_r is not None:\n                score_diff = best_new_score - curr_score\n                if score_diff < 0 or random.random() < math.exp(-score_diff / t_temp):\n                    del congr_dict[best_r]\n                    cnt_array -= best_mask\n                    n_res += best_unique\n                    logm -= math.log(best_r)\n                    logboost -= math.log(best_r / (best_r - 1))\n                    curr_score = best_new_score\n                    \n        elif action == \'optimize\':\n            mods_in = list(congr_dict.keys())\n            if not mods_in:\n                continue\n            r = random.choice(mods_in)\n            a_old = congr_dict[r]\n            \n            mask_old = (targets % r) == a_old\n            unique_hits = np.sum((cnt_array == 1) & mask_old)\n            n_res_bg = n_res + unique_hits\n            \n            cnt_bg = cnt_array - mask_old\n            uncovered_bg = targets[cnt_bg == 0]\n            \n            if len(uncovered_bg) > 0:\n                rem = uncovered_bg % r\n                counts = np.bincount(rem, minlength=r)\n                noise = np.random.uniform(0, t_temp * np.max(counts) + 1e-9, size=r)\n                a_new = int(np.argmax(counts + noise))\n                hits = counts[a_new]\n            else:\n                a_new = random.randint(0, r - 1)\n                hits = 0\n                \n            new_n_res = n_res_bg - hits\n            new_score = get_score(new_n_res, logm, logboost)\n            \n            score_diff = new_score - curr_score\n            if score_diff < 0 or random.random() < math.exp(-score_diff / t_temp):\n                congr_dict[r] = a_new\n                cnt_array = cnt_bg + ((targets % r) == a_new)\n                n_res = new_n_res\n                curr_score = new_score\n                \n        elif action == \'swap\':\n            mods_in = list(congr_dict.keys())\n            cand_pool = [m for m in cand_mods if m not in congr_dict]\n            if not mods_in or not cand_pool:\n                continue\n                \n            r_drop = random.choice(mods_in)\n            a_drop = congr_dict[r_drop]\n            \n            mask_drop = (targets % r_drop) == a_drop\n            unique_hits = np.sum((cnt_array == 1) & mask_drop)\n            n_res_bg = n_res + unique_hits\n            \n            cnt_bg = cnt_array - mask_drop\n            uncovered_bg = targets[cnt_bg == 0]\n            \n            cand_pool_sorted = sorted(cand_pool)\n            cands = cand_pool_sorted[:15]\n            if len(cand_pool_sorted) > 15:\n                cands += random.sample(cand_pool_sorted[15:], min(25, len(cand_pool_sorted) - 15))\n                \n            best_new_score = float(\'inf\')\n            best_r_add = None\n            best_a_add = None\n            best_hits = 0\n            \n            for r_add in cands:\n                if len(uncovered_bg) > 0:\n                    rem = uncovered_bg % r_add\n                    counts = np.bincount(rem, minlength=r_add)\n                    a_add = int(np.argmax(counts))\n                    hits = counts[a_add]\n                else:\n                    a_add = random.randint(0, r_add - 1)\n                    hits = 0\n                    \n                nr = n_res_bg - hits\n                lm = logm - math.log(r_drop) + math.log(r_add)\n                lb = logboost - math.log(r_drop / (r_drop - 1)) + math.log(r_add / (r_add - 1))\n                sc = get_score(nr, lm, lb)\n                \n                if sc < best_new_score:\n                    best_new_score = sc\n                    best_r_add = r_add\n                    best_a_add = a_add\n                    best_hits = hits\n                    \n            if best_r_add is not None:\n                score_diff = best_new_score - curr_score\n                if score_diff < 0 or random.random() < math.exp(-score_diff / t_temp):\n                    del congr_dict[r_drop]\n                    congr_dict[best_r_add] = best_a_add\n                    cnt_array = cnt_bg + ((targets % best_r_add) == best_a_add)\n                    n_res = n_res_bg - best_hits\n                    logm = logm - math.log(r_drop) + math.log(best_r_add)\n                    logboost = logboost - math.log(r_drop / (r_drop - 1)) + math.log(best_r_add / (best_r_add - 1))\n                    curr_score = best_new_score\n\n    return congr_dict\n# EVOLVE-BLOCK-END\n\ndef evaluate(eval_inputs: Mapping[str, Any]) -> dict[str, float]:\n    """Run evaluation on the optimized step."""\n    import sympy\n    import numpy as np\n    Q = 100003\n    targets = np.array(list(sympy.primerange(3, Q)), dtype=np.int64)\n    \n    # Warm-start from the 195-digit record cover instead of starting empty\n    congr_dict = {int(r): int(a) for r, a in eval_inputs["warm_start_cover"]}\n    \n    cand_mods = [int(r) for r in sympy.primerange(3, 8000)]\n    cnt_array = np.zeros(len(targets), dtype=np.int16)\n    \n    # Pre-populate counts\n    for r, a in congr_dict.items():\n        cnt_array += (targets % r) == a\n        \n    for it in range(10):\n        t_temp = 0.8 * (0.02 / 0.8) ** (it / 10)\n        # Recalculate cnt_array based on congr_dict\n        cnt_array = np.zeros(len(targets), dtype=np.int16)\n        logm = math.log(2)\n        logboost = math.log(2.0)\n        for r, a in congr_dict.items():\n            cnt_array += (targets % r) == a\n            logm += math.log(r)\n            logboost += math.log(r / (r - 1))\n            \n        congr_dict = optimize_cover_step(congr_dict, cand_mods, targets, cnt_array, logm, logboost, t_temp)\n        \n    # Recalculate final metrics\n    cnt_array = np.zeros(len(targets), dtype=np.int16)\n    logm = math.log(2)\n    logboost = math.log(2.0)\n    for r, a in congr_dict.items():\n        cnt_array += (targets % r) == a\n        logm += math.log(r)\n        logboost += math.log(r / (r - 1))\n        \n    n_res = int((cnt_array == 0).sum())\n    boost = math.exp(logboost)\n    m_digits = logm / math.log(10)\n    \n    ub = n_res * boost\n    LN10 = math.log(10)\n    D = (m_digits + math.sqrt(m_digits ** 2 + 4 * ub / (LN10 * LN10))) / 2\n    \n    # Constrain E <= 17.5 via Lagrangian penalty to prevent reward hacking\n    E_limit = 17.5\n    E_actual = ub / (D * LN10) if D > 0 else 0.0\n    lagrangian_penalty = 0.0\n    if E_actual > E_limit:\n        lagrangian_penalty = 100.0 * (E_actual - E_limit) ** 2\n        \n    score_headline = -float(D + lagrangian_penalty)\n    \n    # Expose E, |U|, digits(M) as negated secondary metrics for joint optimization visibility\n    return {\n        "neg_est_digits": score_headline,\n        "neg_E": -float(E_actual),\n        "neg_residual_count": -float(n_res),\n        "neg_m_digits": -float(m_digits)\n    }\n'}]}, 'evaluation': {'scores': {'scores': [{'metric': 'neg_est_digits', 'score': -192.47745}, {'metric': 'neg_E', 'score': -17.517206}, {'metric': 'neg_residual_count', 'score': -708}, {'metric': 'neg_m_digits', 'score': -184.84021}]}, 'insights': {'insights': [{'label': 'Evaluation Metrics', 'text': 'Estimated Digits: 192.4774 (constrained), E: 17.5172, |U|: 708, digits(M): 184.84'}]}}, 'parentPrograms': ['projects/799795028847/locations/global/collections/default_collection/engines/goldbach_1784979910032/sessions/7658735534374771723/alphaEvolveExperiments/9582896010645531772/alphaEvolvePrograms/7662895210918133556', 'projects/799795028847/locations/global/collections/default_collection/engines/goldbach_1784979910032/sessions/7658735534374771723/alphaEvolveExperiments/9582896010645531772/alphaEvolvePrograms/7662895210918133288', 'projects/799795028847/locations/global/collections/default_collection/engines/goldbach_1784979910032/sessions/7658735534374771723/alphaEvolveExperiments/9582896010645531772/alphaEvolvePrograms/7662895210918131408'], 'state': 'COMPLETED'}, {'name': 'projects/799795028847/locations/global/collections/default_collection/engines/goldbach_1784979910032/sessions/7658735534374771723/alphaEvolveExperiments/9582896010645531772/alphaEvolvePrograms/11597998738524453658', 'createTime': '2026-07-26T09:31:25.296870Z', 'content': {'files': [{'path': 'program.py', 'content': '# Copyright 2026 Google LLC\nfrom typing import Any, Mapping\nimport math\nimport random\nimport numpy as np\n\n# EVOLVE-BLOCK-START\ndef optimize_cover_step(congr_dict, cand_mods, targets, cnt_array, logm, logboost, t_temp):\n    """Optimize congruence cover using simulated annealing and greedy hill-climbing."""\n    import numpy as np\n    import random\n    import math\n\n    if len(targets) == 0:\n        return congr_dict\n\n    LN10 = math.log(10)\n    LN10_SQ = LN10 * LN10\n\n    # Precompute modulo tables for all candidate and current moduli\n    all_mods = set(cand_mods) | set(congr_dict.keys())\n    targets_mod_r = {r: targets % r for r in all_mods}\n\n    # Precompute weights for biased sampling (smaller primes preferred)\n    cand_weights = [1.0 / (r ** 0.8) for r in cand_mods]\n    cand_to_weight = dict(zip(cand_mods, cand_weights))\n\n    def get_score_metrics(n_res, lm, lboost, penalty_w=100.0):\n        boost = math.exp(lboost)\n        m_digits = lm / LN10\n        ub = n_res * boost\n        D = (m_digits + math.sqrt(m_digits ** 2 + 4 * ub / LN10_SQ)) / 2\n        E_actual = ub / (D * LN10) if D > 0 else 0.0\n        lagrangian_penalty = 0.0\n        if E_actual > 17.5:\n            lagrangian_penalty = penalty_w * (E_actual - 17.5) ** 2\n        return -(D + lagrangian_penalty)\n\n    # Initialize current state\n    current_congr = congr_dict.copy()\n    current_cnt = cnt_array.copy()\n    current_logm = logm\n    current_logboost = logboost\n    current_n_res = np.count_nonzero(current_cnt == 0)\n    \n    best_congr = current_congr.copy()\n    best_score = get_score_metrics(current_n_res, current_logm, current_logboost, penalty_w=100.0)\n    \n    temp = max(t_temp, 1e-6)\n    sa_penalty_weight = 50.0 + 3.0 / temp\n    \n    current_score = get_score_metrics(current_n_res, current_logm, current_logboost, penalty_w=sa_penalty_weight)\n\n    # 1. Run SA for 5000 steps\n    sa_steps = 5000\n    for step in range(sa_steps):\n        cand_pool = [m for m in cand_mods if m not in current_congr]\n        \n        if not current_congr:\n            move_type = \'add\'\n        elif not cand_pool:\n            move_type = random.choice([\'drop\', \'mutate_a\'])\n        else:\n            move_type = random.choice([\'add\', \'drop\', \'swap\', \'swap\', \'mutate_a\', \'mutate_a\'])\n            \n        accepted = False\n        \n        if move_type == \'add\':\n            weights = [cand_to_weight[r] for r in cand_pool]\n            raw_cands = random.choices(cand_pool, weights=weights, k=40)\n            cands = list(set(raw_cands))[:15]\n            \n            uncovered_indices = np.nonzero(current_cnt == 0)[0]\n            \n            best_r, best_a, max_cov = cands[0], 0, -1\n            for r in cands:\n                rem = targets_mod_r[r][uncovered_indices]\n                if len(rem) == 0:\n                    a = random.randint(0, r - 1)\n                    cov = 0\n                else:\n                    counts = np.bincount(rem, minlength=r)\n                    a = np.argmax(counts)\n                    cov = counts[a]\n                if cov > max_cov:\n                    max_cov = cov\n                    best_r = r\n                    best_a = a\n                    \n            r = best_r\n            a = best_a\n            cov_count = max_cov\n                \n            logm_new = current_logm + math.log(r)\n            logboost_new = current_logboost + math.log(r / (r - 1))\n            n_res_new = current_n_res - cov_count\n            \n            score_new = get_score_metrics(n_res_new, logm_new, logboost_new, penalty_w=sa_penalty_weight)\n            delta = score_new - current_score\n            if delta > 0 or random.random() < math.exp(delta / temp):\n                current_congr[r] = int(a)\n                current_cnt += (targets_mod_r[r] == a)\n                current_logm = logm_new\n                current_logboost = logboost_new\n                current_n_res = n_res_new\n                current_score = score_new\n                accepted = True\n                \n        elif move_type == \'drop\':\n            r = random.choice(list(current_congr.keys()))\n            a = current_congr[r]\n            \n            logm_new = current_logm - math.log(r)\n            logboost_new = current_logboost - math.log(r / (r - 1))\n            \n            is_cov = (targets_mod_r[r] == a)\n            unique_cov = np.count_nonzero((current_cnt == 1) & is_cov)\n            n_res_new = current_n_res + unique_cov\n            \n            score_new = get_score_metrics(n_res_new, logm_new, logboost_new, penalty_w=sa_penalty_weight)\n            delta = score_new - current_score\n            if delta > 0 or random.random() < math.exp(delta / temp):\n                current_cnt -= is_cov\n                del current_congr[r]\n                current_logm = logm_new\n                current_logboost = logboost_new\n                current_n_res = n_res_new\n                current_score = score_new\n                accepted = True\n                \n        elif move_type == \'swap\':\n            r_drop = random.choice(list(current_congr.keys()))\n            a_drop = current_congr[r_drop]\n            \n            is_cov_drop = (targets_mod_r[r_drop] == a_drop)\n            cnt_temp = current_cnt - is_cov_drop\n            uncovered_indices = np.nonzero(cnt_temp == 0)[0]\n            n_uncovered = len(uncovered_indices)\n            \n            weights = [cand_to_weight[r] for r in cand_pool]\n            raw_cands = random.choices(cand_pool, weights=weights, k=40)\n            cands = list(set(raw_cands))[:15]\n                    \n            best_r_add, best_a_add, max_cov = cands[0], 0, -1\n            for r in cands:\n                rem = targets_mod_r[r][uncovered_indices]\n                if len(rem) == 0:\n                    a = random.randint(0, r - 1)\n                    cov = 0\n                else:\n                    counts = np.bincount(rem, minlength=r)\n                    a = np.argmax(counts)\n                    cov = counts[a]\n                if cov > max_cov:\n                    max_cov = cov\n                    best_r_add = r\n                    best_a_add = a\n                    \n            r_add = best_r_add\n            a_add = best_a_add\n            cov_count = max_cov\n                \n            n_res_new = n_uncovered - cov_count\n            logm_new = current_logm - math.log(r_drop) + math.log(r_add)\n            logboost_new = current_logboost - math.log(r_drop / (r_drop - 1)) + math.log(r_add / (r_add - 1))\n            \n            score_new = get_score_metrics(n_res_new, logm_new, logboost_new, penalty_w=sa_penalty_weight)\n            delta = score_new - current_score\n            if delta > 0 or random.random() < math.exp(delta / temp):\n                current_cnt -= is_cov_drop\n                del current_congr[r_drop]\n                \n                current_congr[r_add] = int(a_add)\n                current_cnt += (targets_mod_r[r_add] == a_add)\n                current_logm = logm_new\n                current_logboost = logboost_new\n                current_n_res = n_res_new\n                current_score = score_new\n                accepted = True\n                \n        elif move_type == \'mutate_a\':\n            r = random.choice(list(current_congr.keys()))\n            a_old = current_congr[r]\n            \n            is_cov_old = (targets_mod_r[r] == a_old)\n            cnt_temp = current_cnt - is_cov_old\n            uncovered_indices = np.nonzero(cnt_temp == 0)[0]\n            \n            rem = targets_mod_r[r][uncovered_indices]\n            if len(rem) > 0:\n                counts = np.bincount(rem, minlength=r)\n                counts[a_old] = -1\n                a_new = np.argmax(counts)\n            else:\n                a_new = random.choice([i for i in range(r) if i != a_old])\n                \n            is_cov_new = (targets_mod_r[r] == a_new)\n            cnt_new = cnt_temp + is_cov_new\n            n_res_new = np.count_nonzero(cnt_new == 0)\n            \n            score_new = get_score_metrics(n_res_new, current_logm, current_logboost, penalty_w=sa_penalty_weight)\n            delta = score_new - current_score\n            if delta > 0 or random.random() < math.exp(delta / temp):\n                current_cnt[:] = cnt_new\n                current_congr[r] = int(a_new)\n                current_n_res = n_res_new\n                current_score = score_new\n                accepted = True\n                    \n        if accepted:\n            real_score = get_score_metrics(current_n_res, current_logm, current_logboost, penalty_w=100.0)\n            if real_score > best_score:\n                best_score = real_score\n                best_congr = current_congr.copy()\n\n    # 2. Run greedy hill-climbing polish starting from the best cover found\n    current_congr = best_congr.copy()\n    current_cnt = np.zeros(len(targets), dtype=np.int16)\n    current_logm = math.log(2)\n    current_logboost = math.log(2.0)\n    for r, a in current_congr.items():\n        current_cnt += (targets_mod_r[r] == a)\n        current_logm += math.log(r)\n        current_logboost += math.log(r / (r - 1))\n    current_n_res = np.count_nonzero(current_cnt == 0)\n\n    def sweep_remainders():\n        nonlocal current_n_res\n        sweep_improved = True\n        while sweep_improved:\n            sweep_improved = False\n            for r in list(current_congr.keys()):\n                a_old = current_congr[r]\n                is_cov = (targets_mod_r[r] == a_old)\n                cnt_bg = current_cnt - is_cov\n                uncovered_indices = np.nonzero(cnt_bg == 0)[0]\n                rem_uncovered = targets_mod_r[r][uncovered_indices]\n                if len(rem_uncovered) > 0:\n                    counts = np.bincount(rem_uncovered, minlength=r)\n                    a_new = np.argmax(counts)\n                else:\n                    a_new = a_old\n                    \n                if a_new != a_old:\n                    current_congr[r] = int(a_new)\n                    current_cnt[:] = cnt_bg + (targets_mod_r[r] == a_new)\n                    current_n_res = np.count_nonzero(current_cnt == 0)\n                    sweep_improved = True\n\n    # Run initial sweep to make sure remainders are perfectly optimal\n    sweep_remainders()\n    best_score = get_score_metrics(current_n_res, current_logm, current_logboost, penalty_w=100.0)\n    best_congr = current_congr.copy()\n\n    for polish_iter in range(8):\n        improved = False\n        \n        # Try adding a modulus greedily (biased towards smaller primes)\n        best_add_r = None\n        best_add_a = None\n        best_add_score = -float(\'inf\')\n        \n        cand_pool = [r for r in cand_mods if r not in current_congr]\n        sampled_cands = cand_pool\n            \n        uncovered_indices = np.nonzero(current_cnt == 0)[0]\n        \n        for r in sampled_cands:\n            rem = targets_mod_r[r][uncovered_indices]\n            if len(rem) == 0:\n                a = 0\n                n_res_new = current_n_res\n            else:\n                counts = np.bincount(rem, minlength=r)\n                a = np.argmax(counts)\n                n_res_new = current_n_res - counts[a]\n                \n            logm_new = current_logm + math.log(r)\n            logboost_new = current_logboost + math.log(r / (r - 1))\n            score_new = get_score_metrics(n_res_new, logm_new, logboost_new, penalty_w=100.0)\n            if score_new > best_add_score:\n                best_add_score = score_new\n                best_add_r = r\n                best_add_a = a\n                \n        if best_add_score > best_score:\n            r = best_add_r\n            a = best_add_a\n            current_congr[r] = int(a)\n            current_cnt += (targets_mod_r[r] == a)\n            current_logm += math.log(r)\n            current_logboost += math.log(r / (r - 1))\n            current_n_res = np.count_nonzero(current_cnt == 0)\n            \n            sweep_remainders()\n            best_score = get_score_metrics(current_n_res, current_logm, current_logboost, penalty_w=100.0)\n            best_congr = current_congr.copy()\n            improved = True\n            \n        # Try dropping a modulus greedily\n        best_drop_r = None\n        best_drop_score = -float(\'inf\')\n        for r in list(current_congr.keys()):\n            a = current_congr[r]\n            is_cov = (targets_mod_r[r] == a)\n            unique_cov = np.count_nonzero((current_cnt == 1) & is_cov)\n            n_res_new = current_n_res + unique_cov\n            \n            logm_new = current_logm - math.log(r)\n            logboost_new = current_logboost - math.log(r / (r - 1))\n            score_new = get_score_metrics(n_res_new, logm_new, logboost_new, penalty_w=100.0)\n            if score_new > best_drop_score:\n                best_drop_score = score_new\n                best_drop_r = r\n                \n        if best_drop_score > best_score:\n            r = best_drop_r\n            a = current_congr[r]\n            current_cnt -= (targets_mod_r[r] == a)\n            del current_congr[r]\n            current_logm -= math.log(r)\n            current_logboost -= math.log(r / (r - 1))\n            current_n_res = np.count_nonzero(current_cnt == 0)\n            \n            sweep_remainders()\n            best_score = get_score_metrics(current_n_res, current_logm, current_logboost, penalty_w=100.0)\n            best_congr = current_congr.copy()\n            improved = True\n            \n        # Try swapping greedily\n        best_swap_r_drop = None\n        best_swap_r_add = None\n        best_swap_a_add = None\n        best_swap_score = -float(\'inf\')\n        \n        cover_keys = list(current_congr.keys())\n        sampled_drops = cover_keys\n        \n        for r_drop in sampled_drops:\n            a_drop = current_congr[r_drop]\n            is_cov