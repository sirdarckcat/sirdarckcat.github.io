     action = random.choices([\'add\', \'drop\', \'optimize\', \'swap\'], weights=[20, 20, 30, 30])[0]\n\n        if action == \'add\':\n            cand_pool = [m for m in cand_mods if m not in congr_dict]\n            if not cand_pool: continue\n            \n            cands = random.sample(cand_pool, min(20, len(cand_pool)))\n            uncovered = targets[cnt_array == 0]\n            if len(uncovered) == 0: continue\n            \n            best_new_score = float(\'inf\')\n            best_r = None\n            best_a = None\n            best_hits = 0\n            \n            for r in cands:\n                rem = uncovered % r\n                counts = np.bincount(rem, minlength=r)\n                a = int(np.argmax(counts))\n                hits = counts[a]\n                \n                nr = n_res - hits\n                lm = logm + math.log(r)\n                lb = logboost + math.log(r / (r - 1))\n                sc = get_score(nr, lm, lb)\n                \n                if sc < best_new_score:\n                    best_new_score = sc\n                    best_r = r\n                    best_a = a\n                    best_hits = hits\n            \n            if best_new_score < curr_score or random.random() < math.exp((curr_score - best_new_score) / t_temp):\n                congr_dict[best_r] = best_a\n                cnt_array = cnt_array + ((targets % best_r) == best_a)\n                n_res -= best_hits\n                logm += math.log(best_r)\n                logboost += math.log(best_r / (best_r - 1))\n                curr_score = best_new_score\n\n        elif action == \'drop\':\n            mods_in = list(congr_dict.keys())\n            if not mods_in: continue\n            \n            cands = random.sample(mods_in, min(20, len(mods_in)))\n            \n            best_new_score = float(\'inf\')\n            best_r = None\n            best_a = None\n            best_unique = 0\n            best_mask = None\n            \n            for r in cands:\n                a = congr_dict[r]\n                mask = (targets % r) == a\n                unique_hits = np.sum((cnt_array == 1) & mask)\n                \n                nr = n_res + unique_hits\n                lm = logm - math.log(r)\n                lb = logboost - math.log(r / (r - 1))\n                sc = get_score(nr, lm, lb)\n                \n                if sc < best_new_score:\n                    best_new_score = sc\n                    best_r = r\n                    best_a = a\n                    best_unique = unique_hits\n                    best_mask = mask\n            \n            if best_new_score < curr_score or random.random() < math.exp((curr_score - best_new_score) / t_temp):\n                del congr_dict[best_r]\n                cnt_array = cnt_array - best_mask\n                n_res += best_unique\n                logm -= math.log(best_r)\n                logboost -= math.log(best_r / (best_r - 1))\n                curr_score = best_new_score\n\n        elif action == \'optimize\':\n            mods_in = list(congr_dict.keys())\n            if not mods_in: continue\n            r = random.choice(mods_in)\n            a_old = congr_dict[r]\n            \n            mask_old = (targets % r) == a_old\n            unique_hits = np.sum((cnt_array == 1) & mask_old)\n            n_res_bg = n_res + unique_hits\n            \n            cnt_bg = cnt_array - mask_old\n            uncovered_bg = targets[cnt_bg == 0]\n            \n            if len(uncovered_bg) > 0:\n                rem = uncovered_bg % r\n                counts = np.bincount(rem, minlength=r)\n                noise = np.random.uniform(0, t_temp * np.max(counts) + 1e-9, size=r)\n                a_new = int(np.argmax(counts + noise))\n                hits = counts[a_new]\n            else:\n                a_new = random.randint(0, r - 1)\n                hits = 0\n                \n            new_n_res = n_res_bg - hits\n            new_score = get_score(new_n_res, logm, logboost)\n            \n            if new_score < curr_score or random.random() < math.exp((curr_score - new_score) / t_temp):\n                congr_dict[r] = a_new\n                cnt_array = cnt_bg + ((targets % r) == a_new)\n                n_res = new_n_res\n                curr_score = new_score\n\n        elif action == \'swap\':\n            mods_in = list(congr_dict.keys())\n            cand_pool = [m for m in cand_mods if m not in congr_dict]\n            if not mods_in or not cand_pool: continue\n            \n            r_drop = random.choice(mods_in)\n            a_drop = congr_dict[r_drop]\n            \n            mask_drop = (targets % r_drop) == a_drop\n            unique_hits = np.sum((cnt_array == 1) & mask_drop)\n            n_res_bg = n_res + unique_hits\n            \n            cnt_bg = cnt_array - mask_drop\n            uncovered_bg = targets[cnt_bg == 0]\n            \n            cands = random.sample(cand_pool, min(20, len(cand_pool)))\n            \n            best_new_score = float(\'inf\')\n            best_r_add = None\n            best_a_add = None\n            best_hits = 0\n            \n            for r_add in cands:\n                rem = uncovered_bg % r_add\n                if len(rem) > 0:\n                    counts = np.bincount(rem, minlength=r_add)\n                    a_add = int(np.argmax(counts))\n                    hits = counts[a_add]\n                else:\n                    a_add = random.randint(0, r_add - 1)\n                    hits = 0\n                    \n                nr = n_res_bg - hits\n                lm = logm - math.log(r_drop) + math.log(r_add)\n                lb = logboost - math.log(r_drop / (r_drop - 1)) + math.log(r_add / (r_add - 1))\n                sc = get_score(nr, lm, lb)\n                \n                if sc < best_new_score:\n                    best_new_score = sc\n                    best_r_add = r_add\n                    best_a_add = a_add\n                    best_hits = hits\n                    \n            if best_new_score < curr_score or random.random() < math.exp((curr_score - best_new_score) / t_temp):\n                del congr_dict[r_drop]\n                congr_dict[best_r_add] = best_a_add\n                cnt_array = cnt_bg + ((targets % best_r_add) == best_a_add)\n                n_res = n_res_bg - best_hits\n                logm = logm - math.log(r_drop) + math.log(best_r_add)\n                logboost = logboost - math.log(r_drop / (r_drop - 1)) + math.log(best_r_add / (best_r_add - 1))\n                curr_score = best_new_score\n\n    return congr_dict\n# EVOLVE-BLOCK-END\n\ndef evaluate(eval_inputs: Mapping[str, Any]) -> dict[str, float]:\n    """Run evaluation on the optimized step."""\n    import sympy\n    import numpy as np\n    Q = 100003\n    targets = np.array(list(sympy.primerange(3, Q)), dtype=np.int64)\n    \n    # Warm-start from the 195-digit record cover instead of starting empty\n    congr_dict = {int(r): int(a) for r, a in eval_inputs["warm_start_cover"]}\n    \n    cand_mods = [int(r) for r in sympy.primerange(3, 8000)]\n    cnt_array = np.zeros(len(targets), dtype=np.int16)\n    \n    # Pre-populate counts\n    for r, a in congr_dict.items():\n        cnt_array += (targets % r) == a\n        \n    for it in range(10):\n        t_temp = 0.8 * (0.02 / 0.8) ** (it / 10)\n        # Recalculate cnt_array based on congr_dict\n        cnt_array = np.zeros(len(targets), dtype=np.int16)\n        logm = math.log(2)\n        logboost = math.log(2.0)\n        for r, a in congr_dict.items():\n            cnt_array += (targets % r) == a\n            logm += math.log(r)\n            logboost += math.log(r / (r - 1))\n            \n        congr_dict = optimize_cover_step(congr_dict, cand_mods, targets, cnt_array, logm, logboost, t_temp)\n        \n    # Recalculate final metrics\n    cnt_array = np.zeros(len(targets), dtype=np.int16)\n    logm = math.log(2)\n    logboost = math.log(2.0)\n    for r, a in congr_dict.items():\n        cnt_array += (targets % r) == a\n        logm += math.log(r)\n        logboost += math.log(r / (r - 1))\n        \n    n_res = int((cnt_array == 0).sum())\n    boost = math.exp(logboost)\n    m_digits = logm / math.log(10)\n    \n    ub = n_res * boost\n    LN10 = math.log(10)\n    D = (m_digits + math.sqrt(m_digits ** 2 + 4 * ub / (LN10 * LN10))) / 2\n    \n    # Constrain E <= 17.5 via Lagrangian penalty to prevent reward hacking\n    E_limit = 17.5\n    E_actual = ub / (D * LN10) if D > 0 else 0.0\n    lagrangian_penalty = 0.0\n    if E_actual > E_limit:\n        lagrangian_penalty = 100.0 * (E_actual - E_limit) ** 2\n        \n    score_headline = -float(D + lagrangian_penalty)\n    \n    # Expose E, |U|, digits(M) as negated secondary metrics for joint optimization visibility\n    return {\n        "neg_est_digits": score_headline,\n        "neg_E": -float(E_actual),\n        "neg_residual_count": -float(n_res),\n        "neg_m_digits": -float(m_digits)\n    }\n'}]}, 'evaluation': {'scores': {'scores': [{'metric': 'neg_est_digits', 'score': -193.76837}, {'metric': 'neg_E', 'score': -17.52139}, {'metric': 'neg_residual_count', 'score': -718}, {'metric': 'neg_m_digits', 'score': -186.11317}]}, 'insights': {'insights': [{'label': 'Evaluation Metrics', 'text': 'Estimated Digits: 193.7684 (constrained), E: 17.5214, |U|: 718, digits(M): 186.11'}]}}, 'parentPrograms': ['projects/799795028847/locations/global/collections/default_collection/engines/goldbach_1784979910032/sessions/7658735534374771723/alphaEvolveExperiments/9582896010645531772/alphaEvolvePrograms/7662895210918129928'], 'state': 'COMPLETED'}, {'name': 'projects/799795028847/locations/global/collections/default_collection/engines/goldbach_1784979910032/sessions/7658735534374771723/alphaEvolveExperiments/9582896010645531772/alphaEvolvePrograms/7662895210918130271', 'createTime': '2026-07-26T06:06:42.503013Z', 'content': {'files': [{'path': 'program.py', 'content': '# Copyright 2026 Google LLC\nfrom typing import Any, Mapping\nimport math\nimport random\nimport numpy as np\n\n# EVOLVE-BLOCK-START\ndef optimize_cover_step(congr_dict, cand_mods, targets, cnt_array, logm, logboost, t_temp):\n    """Optimize a single step of congruence cover using simulated annealing style logic.\n\n    Args:\n        congr_dict: Dictionary of r -> a\n        cand_mods: List of prime candidates\n        targets: np.array of target primes\n        cnt_array: np.array of coverage counts\n        logm: current log of modulus M\n        logboost: current log of boost factor\n        t_temp: current temperature\n\n    Returns:\n        Updated congr_dict\n    """\n    import numpy as np\n    import random\n    import math\n\n    if len(targets) == 0:\n        return congr_dict\n\n    LN10 = math.log(10)\n    C_UB = 4.0 / (LN10 * LN10)\n    \n    def compute_score(lm, lb, nr):\n        m_digits = lm / LN10\n        ub = nr * math.exp(lb)\n        D = (m_digits + math.sqrt(max(0.0, m_digits ** 2 + C_UB * ub))) / 2\n        E_actual = ub / (D * LN10) if D > 0 else 0.0\n        lagrangian_penalty = 100.0 * (E_actual - 17.5) ** 2 if E_actual > 17.5 else 0.0\n        return -float(D + lagrangian_penalty)\n\n    # Crazy idea: Unify all move types (add, drop, optimize, swap) into a single \n    # transition proposal and use a standard Metropolis-Hastings acceptance criterion. \n    # This completely removes the expensive multiple-sample generation, score array \n    # calculations, and softmax choices, simplifying the code massively and allowing \n    # us to run many more inner steps (deep Markov chain exploration).\n    inner_steps = 10000\n    congr_dict = dict(congr_dict)\n    cnt_array = np.array(cnt_array, dtype=np.int16)\n    \n    uncovered_mask = (cnt_array == 0)\n    single_cover_mask = (cnt_array == 1)\n    n_res_curr = np.sum(uncovered_mask)\n    curr_score = compute_score(logm, logboost, n_res_curr)\n\n    for step in range(inner_steps):\n        t_curr = t_temp * (0.0258 ** (step / inner_steps))\n        temp = max(t_curr, 1e-4)\n        \n        factor = min(max(t_curr, 0.0), 1.0)\n        p_opt = 0.40 - 0.10 * factor\n        p_add = 0.20 + 0.05 * factor\n        p_drop = 0.20 + 0.05 * factor\n        p_swap = 0.20\n\n        kind = random.random()\n        mods_in = list(congr_dict.keys())\n        cand_pool = [m for m in cand_mods if m not in congr_dict]\n        \n        if not mods_in:\n            action = \'add\'\n        elif not cand_pool:\n            action = \'optimize\' if kind < (p_opt / (p_opt + p_drop)) else \'drop\'\n        else:\n            if kind < p_add:\n                action = \'add\'\n            elif kind < p_add + p_opt:\n                action = \'optimize\'\n            elif kind < p_add + p_opt + p_drop:\n                action = \'drop\'\n            else:\n                action = \'swap\'\n\n        r_drop = None\n        r_add = None\n\n        if action == \'add\':\n            r_add = random.choice(cand_pool)\n        elif action == \'optimize\':\n            r_drop = r_add = random.choice(mods_in)\n        elif action == \'drop\':\n            r_drop = random.choice(mods_in)\n        elif action == \'swap\':\n            r_drop = random.choice(mods_in)\n            r_add = random.choice(cand_pool)\n            \n        a_drop = congr_dict[r_drop] if r_drop else None\n        \n        if r_drop:\n            newly_uncovered = single_cover_mask & ((targets % r_drop) == a_drop)\n            bg_uncovered_mask = uncovered_mask | newly_uncovered\n            logm_new = logm - math.log(r_drop)\n            logboost_new = logboost - math.log(r_drop / (r_drop - 1))\n        else:\n            bg_uncovered_mask = uncovered_mask\n            logm_new = logm\n            logboost_new = logboost\n            \n        n_res_bg = np.sum(bg_uncovered_mask)\n        targets_bg_uncovered = targets[bg_uncovered_mask]\n        \n        if r_add:\n            if len(targets_bg_uncovered) > 0:\n                counts = np.bincount(targets_bg_uncovered % r_add, minlength=r_add)\n                a_add = int(np.argmax(counts))\n                cov_count = counts[a_add]\n            else:\n                a_add = 0\n                cov_count = 0\n            n_res_new = n_res_bg - cov_count\n            logm_new += math.log(r_add)\n            logboost_new += math.log(r_add / (r_add - 1))\n        else:\n            a_add = None\n            n_res_new = n_res_bg\n            \n        score = compute_score(logm_new, logboost_new, n_res_new)\n        \n        # Metropolis-Hastings acceptance\n        if score > curr_score or random.random() < math.exp((score - curr_score) / temp):\n            if r_drop:\n                del congr_dict[r_drop]\n                cnt_array -= (targets % r_drop) == a_drop\n            if r_add:\n                congr_dict[r_add] = a_add\n                cnt_array += (targets % r_add) == a_add\n                \n            logm = logm_new\n            logboost = logboost_new\n            curr_score = score\n            uncovered_mask = (cnt_array == 0)\n            single_cover_mask = (cnt_array == 1)\n\n    return congr_dict\n# EVOLVE-BLOCK-END\n\ndef evaluate(eval_inputs: Mapping[str, Any]) -> dict[str, float]:\n    """Run evaluation on the optimized step."""\n    import sympy\n    import numpy as np\n    Q = 100003\n    targets = np.array(list(sympy.primerange(3, Q)), dtype=np.int64)\n    \n    # Warm-start from the 195-digit record cover instead of starting empty\n    congr_dict = {int(r): int(a) for r, a in eval_inputs["warm_start_cover"]}\n    \n    cand_mods = [int(r) for r in sympy.primerange(3, 8000)]\n    cnt_array = np.zeros(len(targets), dtype=np.int16)\n    \n    # Pre-populate counts\n    for r, a in congr_dict.items():\n        cnt_array += (targets % r) == a\n        \n    for it in range(10):\n        t_temp = 0.8 * (0.02 / 0.8) ** (it / 10)\n        # Recalculate cnt_array based on congr_dict