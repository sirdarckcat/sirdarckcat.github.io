ve dilution\n        moves.sort(key=lambda x: x[3])\n        moves = moves[:40]\n        \n        scores = np.array([m[3] for m in moves])\n        \n        # Scale temp: translates directly to SA magnitude probabilities matching D change magnitudes\n        temp = max(t_temp, 1e-4) * 2.0\n        \n        scaled_scores = -scores / temp\n        scaled_scores = scaled_scores - np.max(scaled_scores)\n        probs = np.exp(scaled_scores)\n        probs /= np.sum(probs)\n        \n        idx = np.random.choice(len(moves), p=probs)\n        action, r, a, _, next_n_res, next_logm, next_logboost = moves[idx]\n        \n        # In-place mutable state tracking (very fast loop turnaround mapping array counts instantly)\n        if action == \'add\':\n            congr_dict[r] = int(a)\n            cnt_array += ((targets % r) == a).astype(np.int16)\n        elif action == \'drop\':\n            a_old = congr_dict[r]\n            del congr_dict[r]\n            cnt_array -= ((targets % r) == a_old).astype(np.int16)\n        elif action == \'optimize\':\n            a_old = congr_dict[r]\n            congr_dict[r] = int(a)\n            cnt_array -= ((targets % r) == a_old).astype(np.int16)\n            cnt_array += ((targets % r) == a).astype(np.int16)\n            \n        current_n_res = next_n_res\n        logm = next_logm\n        logboost = next_logboost\n\n    return congr_dict\n# EVOLVE-BLOCK-END\n\ndef evaluate(eval_inputs: Mapping[str, Any]) -> dict[str, float]:\n    """Run evaluation on the optimized step."""\n    import sympy\n    import numpy as np\n    Q = 100003\n    targets = np.array(list(sympy.primerange(3, Q)), dtype=np.int64)\n    \n    # Warm-start from the 195-digit record cover instead of starting empty\n    congr_dict = {int(r): int(a) for r, a in eval_inputs["warm_start_cover"]}\n    \n    cand_mods = [int(r) for r in sympy.primerange(3, 8000)]\n    cnt_array = np.zeros(len(targets), dtype=np.int16)\n    \n    # Pre-populate counts\n    for r, a i