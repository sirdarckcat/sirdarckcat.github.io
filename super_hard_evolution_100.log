dom\n\n    # Persistent, self-cleaning cache of remainder arrays to avoid repeated modulo operations\n    if not hasattr(optimize_cover_step, "_last_targets_id") or optimize_cover_step._last_targets_id != id(targets):\n        optimize_cover_step._mod_cache = {}\n        optimize_cover_step._last_targets_id = id(targets)\n    cache = optimize_cover_step._mod_cache\n\n    def get_mod_array(r):\n        if r not in cache:\n            cache[r] = (targets % r).astype(np.int32)\n        return cache[r]\n\n    LN10 = np.log(10)\n    LN10_SQ = LN10 * LN10\n\n    def compute_D(lm, lb, nr):\n        m_d = lm / LN10\n        ub = nr * np.exp(lb)\n        return (m_d + np.sqrt(max(0.0, m_d**2 + 4 * ub / LN10_SQ))) / 2.0\n\n    def sample_low(population, k, power=1.5):\n        n = len(population)\n        if n <= k: return population\n        scores = [(random.random() * ((n - i) / n) ** power, i) for i in range(n)]\n        scores.sort(reverse=True)\n        chosen_indices = sorted([scores[j][1] for j in range(k)])\n        return [population[idx] for idx in chosen_indices]\n\n    def sample_high(population, k, power=1.5):\n        n = len(population)\n        if n <= k: return population\n        scores = [(random.random() * ((i + 1) / n) ** power, i) for i in range(n)]\n        scores.sort(reverse=True)\n        chosen_indices = sorted([scores[j][1] for j in range(k)])\n        return [population[idx] for idx in chosen_indices]\n\n    # Initialize local search state\n    cnt = cnt_array.copy()\n    current_logm = logm\n    current_logboost = logboost\n    \n    uncovered_indices = np.where(cnt == 0)[0]\n    n_res = len(uncovered_indices)\n    current_D = compute_D(current_logm, current_logboost, n_res)\n\n    best_overall_dict = congr_dict.copy()\n    best_overall_D = current_D\n\n    # Run a highly efficient internal simulated annealing search of 3000 micro-steps\n    steps = 3000\n    steps_since_improvement = 0\n    \n    for step in range(steps):\n        # Cool down the internal temperature\n        frac = step / steps\n        temp = max(t_temp * (0.10 ** frac), 1e-5)\n\n        # Dynamic action probabilities (exploration early, exploitation late)\n        p_add = 0.55 * (1.0 - 0.6 * frac)\n        p_drop = 0.15 * (1.0 - 0.5 * frac)\n        r_val = random.random()\n\n        if r_val < p_add:\n            # TRY ADD\n            cand_pool = [m for m in cand_mods if m not in congr_dict]\n            if cand_pool:\n                sampled = sample_low(cand_pool, min(40, len(cand_pool)))\n                best_r, best_a, best_D = None, None, float(\'inf\')\n                best_cov = 0\n\n                for r in sampled:\n                    rem = get_mod_array(r)\n                    counts = np.bincount(rem[uncovered_indices], minlength=r)\n                    a = int(np.argmax(counts))\n                    cov = int(counts[a])\n\n                    new_logm = current_logm + np.log(r)\n                    new_logboost = current_logboost + np.log(r / (r - 1.0))\n                    new_n_res = n_res - cov\n                    new_D = compute_D(new_logm, new_logboost, new_n_res)\n\n                    if new_D < best_D:\n                        best_D = new_D\n                        best_r = r\n                        best_a = a\n                        best_cov = cov\n\n                if best_r is not None:\n                    if best_D < current_D or random.random() < np.exp((current_D - best_D) / temp):\n                        congr_dict[best_r] = best_a\n                        rem = get_mod_array(best_r)\n                        cnt[rem == best_a] += 1\n                        current_logm += np.log(best_r)\n                        current_logboost += np.log(best_r / (best_r - 1.0))\n                        \n                        uncovered_indices = uncovered_indices[cnt[uncovered_indices] == 0]\n                        n_res = len(uncovered_indices)\n                        current_D = best_D\n\n        elif r_val < p_add + p_drop:\n            # TRY DROP\n            if congr_dict:\n                sorted_keys = sorted(list(congr_dict.keys()))\n                sampled = sample_high(sorted_keys, min(30, len(sorted_keys)))\n                best_r, best_D = None, float(\'inf\')\n                best_revealed = 0\n\n                for r in sampled:\n                    rem = get_mod_array(r)\n                    a = congr_dict[r]\n                    revealed = int(np.count_nonzero(cnt[rem == a] == 1))\n\n                    new_logm = current_logm - np.log(r)\n                    new_logboost = current_logboost - np.log(r / (r - 1.0))\n                    new_n_res = n_res + revealed\n                    new_D = compute_D(new_logm, new_logboost, new_n_res)\n\n                    if new_D < best_D:\n                        best_D = new_D\n                        best_r = r\n                        best_revealed = revealed\n\n                if best_r is not None:\n                    if best_D < current_D or random.random() < np.exp((current_D - best_D) / temp):\n                        a_drop = congr_dict[best_r]\n                        rem = get_mod_array(best_r)\n                        cnt[rem == a_drop] -= 1\n                        del congr_dict[best_r]\n                        current_logm -= np.log(best_r)\n                        current_logboost -= np.log(best_r / (best_r - 1.0))\n                        \n                        newly_uncovered = np.where(rem == a_drop)[0]\n                        newly_uncovered = newly_uncovered[cnt[newly_uncovered] == 0]\n                        if len(newly_uncovered) > 0:\n                            uncovered_indices = np.concatenate([uncovered_indices, newly_uncovered])\n                            uncovered_indices.sort()\n                        n_res = len(uncovered_indices)\n                        current_D = best_D\n\n        else:\n            # TRY SWAP / OPTIMIZE CONGRUENCE CLASSES\n            if congr_dict:\n       