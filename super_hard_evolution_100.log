ycelium Hyper-Heuristic with Supernovas"\n    # We treat the solution as an interstellar Mycelium network. Uncovered targets \n    # are uncolonized planets.\n    # 1. "Naked Singularity Extraction": We dynamically slice the universe down to \n    # ONLY the uncovered targets (~700 elements instead of 9592), yielding a >10x speedup!\n    # 2. "Hyper-Panspermia": With the massive speedup, we evaluate 200 "spores" (primes) \n    # simultaneously instead of a measly 60, drastically expanding our search horizon.\n    # 3. "Entropy-Driven Swaps": We deliberately assassinate primes with the lowest \n    # Unique-Shielding-to-Mass ratios during swaps, forcing a leaner network.\n    # 4. "Apocalyptic Supernovas": At high temperatures, we occasionally trigger \n    # cosmic catastrophes that blast away the single most bloated, useless prime in \n    # the active set to aggressively shatter local minima.\n    \n    # Copy to avoid side effects during search\n    cnt_array = cnt_array.copy()\n    n_res = int((cnt_array == 0).sum())\n\n    def calc_D_val(n_res_val, logm_val, logboost_val):\n        boost = math.exp(logboost_val)\n        m_digits = logm_val / math.log(10)\n        ub = n_res_val * boost\n        LN10 = math.log(10)\n        inside_sqrt = m_digits ** 2 + 4 * ub / (LN10 * LN10)\n        D = (m_digits + math.sqrt(max(0.0, inside_sqrt))) / 2\n        \n        E_limit = 17.5\n        E_actual = ub / (D * LN10) if D > 0 else 0.0\n        lagrangian_penalty = 0.0\n        if E_actual > E_limit:\n            lagrangian_penalty = 1000.0 * (E_actual - E_limit) ** 2\n        return D + lagrangian_penalty\n\n    def optimize_all(congr, cnt):\n        keys = list(congr.keys())\n        random.shuffle(keys)\n        for r in keys:\n            a_old = congr[r]\n            is_cov = (targets % r) == a_old\n            cnt[is_cov] -= 1\n            uncovered = targets[cnt == 0]\n            if len(uncovered) > 0:\n                counts = np.bincount(uncovered % r, minlength=r)\n                a_new = int(np.argmax(counts))\n            else:\n                a_new = 0\n            if a_new != a_old:\n                cnt[(targets % r) == a_new] += 1\n                congr[r] = a_new\n            else:\n                cnt[is_cov] += 1\n\n    # Initial residue optimization\n    optimize_all(congr_dict, cnt_array)\n    n_res = int((cnt_array == 0).sum())\n    current_D = calc_D_val(n_res, logm, logboost)\n\n    temp = max(t_temp, 1e-6)\n    N_STEPS = 1000\n\n    for step in range(N_STEPS):\n        # Periodically optimize all to stay on the local optimum manifold\n        if step > 0 and step % 100 == 0:\n            optimize_all(congr_dict, cnt_array)\n            n_res = int((cnt_array == 0).sum())\n            current_D = calc_D_val(n_res, logm, logboost)\n\n        # "Apocalyptic Supernova": Occasionally blast away the most bloated prime\n        if temp > 0.1 and random.random() < 0.05 and congr_dict:\n            active = list(congr_dict.keys())\n            sample_active = random.sample(active, min(10, len(active)))\n            worst_r = None\n            worst_score = float(\'inf\')\n            for r in sample_active:\n                unique_cov = np.sum((cnt_array == 1) & ((targets % r) == congr_dict[r]))\n                # High mass, low unique coverage -> low score (more likely to be dropped)\n                score = unique_cov / (math.log(r) + 1e-9)\n                if score < worst_score:\n                    worst_score = score\n                    worst_r = r\n            if worst_r is not None:\n                r_drop = worst_r\n                a_drop = congr_dict[r_drop]\n                cnt_array[(targets % r_drop) == a_drop] -= 1\n                del congr_dict[r_drop]\n                n_res = int((cnt_array == 0).sum())\n                logm -= math.log(r_drop)\n                logboost -= math.log(r_drop / (r_drop - 1))\n                current_D = calc_D_val(n_res, logm, logboost)\n                continue\n\n        action = random.choices([\'add\', \'drop\', \'swap\', \'optimize\'], weights=[0.30, 0.15, 0.40, 0.15], k=1)[0]\n\n        if action == \'add\':\n            cand_pool = [m for m in cand_mods if m not in congr_dict]\n            if cand_pool:\n                uncovered_targets = targets[cnt_array == 0]\n                n_res_current = len(uncovered_targets)\n                \n                # "Targeted Teleportation": Focus exclusively on currently uncovered targets\n                sampled = random.sample(cand_pool, min(200, len(cand_pool)))\n                best_r = None\n                best_a = None\n                best_new_D = float(\'inf\')\n                best_new_n_res = n_res\n                \n                for r in sampled:\n                    if n_res_current > 0:\n                        counts = np.bincount(uncovered_targets % r, minlength=r)\n                        a = int(np.argmax(counts))\n                        added_cov = counts[a]\n                    else:\n                        a = 0\n                        added_cov = 0\n                    new_n_res = n_res - added_cov\n                    new_logm = logm + math.log(r)\n                    new_logboost = logboost + math.log(r / (r - 1))\n                    new_D = calc_D_val(new_n_res, new_logm, new_logboost)\n                    if new_D < best_new_D:\n                        best_new_D = new_D\n                        best_r = r\n                        best_a = a\n                        best_new_n_res = new_n_res\n                        \n                if best_r is not None:\n                    delta = best_new_D - current_D\n                    if delta < 0 or random.random() < math.exp(-delta / temp):\n                        congr_dict[best_r] = best_a\n                        cnt_array[targets % best_r == best_a] += 1\n                        n_res = best_new_n_res\n                        logm += math.log(best_r)\n                        logboost += math.log(best_r / (best_r - 1))\n                        current_D = best_new_D\n\n        elif action == \'drop\':\n            active = list(congr_dict.keys())\n            if active:\n                sampled = random.sample(active, min(60, len(active)))\n                best_r = None\n                best_new_D = float(\'inf\')\n                best_new_n_res = n_res\n                \n                singly_covered = (cnt_array == 1)\n                for r in sampled:\n                    a = congr_dict[r]\n                    lost_cov = np.sum(singly_covered & ((targets % r) == a))\n                    new_n_res = n_res + lost_cov\n                    new_logm = logm - math.log(r)\n                    new_logboost = logboost - math.log(r / (r - 1))\n                    new_D = calc_D_val(new_n_res, new_logm, new_logboost)\n                    if new_D < best_new_D:\n                        best_new_D = new_D\n                        best_r = r\n                        best_new_n_res = new_n_res\n                        \n                if best_r is not None:\n                    delta = best_new_D - current_D\n                    if delta < 0 or random.random() < math.exp(-delta / temp):\n                        r_drop = best_r\n                        a_drop = congr_dict[r_drop]\n                        cnt_array[targets % r_drop == a_drop] -= 1\n                        del congr_dict[r_drop]\n                        n_res = best_new_n_res\n                        logm -= math.log(r_drop)\n                        logboost -= math.log(r_drop / (r_drop - 1))\n                        current_D = best_new_D\n\n        elif action == \'swap\':\n            active = list(congr_dict.keys())\n            cand_pool = [m for m in cand_mods if m not in congr_dict]\n            if active and cand_pool:\n                # "Entropy-Driven Antimatter Swap"\n                sample_active = random.sample(active, min(15, len(active)))\n                r_drop = sample_active[0]\n                worst_score = float(\'inf\')\n                singly_covered = (cnt_array == 1)\n                for r in sample_active:\n                    loss = np.sum(singly_covered & ((targets % r) == congr_dict[r]))\n                    score = loss + 1.0 / (math.log(r) + 1e-9)\n                    if score < worst_score:\n                        worst_score = score\n                        r_drop = r\n                \n                a_drop = congr_dict[r_drop]\n                \n                rem_drop = targets % r_drop\n                cnt_array[rem_drop == a_drop] -= 1\n                uncovered = (cnt_array == 0)\n                \n                sampled_add = random.sample(cand_pool, min(200, len(cand_pool)))\n                best_add_r = None\n                best_add_a = None\n                best_new_D = float(\'inf\')\n                best_new_n_res = n_res\n                \n                uncovered_targets = targets[uncovered]\n                n_res_after_drop = len(uncovered_targets)\n                logm_after_drop = logm - math.log(r_drop)\n                logboost_after_drop = logboost - math.log(r_drop / (r_drop - 1))\n                \n                for r in sampled_add:\n                    if n_res_after_drop > 0:\n                        counts = np.bincount(uncovered_targets % r, minlength=r)\n                        a = int(np.argmax(counts))\n                        added_cov = counts[a]\n                    else:\n                        a = 0\n                        added_cov = 0\n                    \n                    new_n_res = n_res_after_drop - added_cov\n                    new_logm = logm_after_drop + math.log(r)\n                    new_logboost = logboost_after_drop + math.log(r / (r - 1))\n                    \n                    new_D = calc_D_val(new_n_res, new_logm, new_logboost)\n                    if new_D < best_new_D:\n                        best_new_D = new_D\n                        best_add_r = r\n                        best_add_a = a\n                        best_new_n_res = new_n_res\n                        \n                if best_add_r is not None:\n                    delta = best_new_D - current_D\n                    if delta < 0 or random.random() < math.exp(-delta / temp):\n                        del congr_dict[r_drop]\n                        congr_dict[best_add_r] = best_add_a\n                        cnt_array[targets % best_add_r == best_add_a] += 1\n                        n_res = best_new_n_res\n                        logm = logm_after_drop + math.log(best_add_r)\n                        logboost = logboost_after_drop + math.log(best_add_r / (best_add_r - 1))\n                        current_D = best_new_D\n                    else:\n                        cnt_array[rem_drop == a_drop] += 1\n                else:\n                    cnt_array[rem_drop == a_drop] += 1\n\n        elif action == \'optimize\':\n            active = list(congr_dict.keys())\n            if active:\n                sampled = random.sample(active, min(10, len(active)))\n                for r in sampled:\n                    a_old = congr_dict[r]\n                    is_cov = (targets % r) == a_old\n                    cnt_array[is_cov] -= 1\n                    \n                    uncovered_targets = targets[cnt_array == 0]\n                    if len(uncovered_targets) > 0:\n                        counts = np.bincount(uncovered_targets % r, minlength=r)\n                        a_new = int(np.argmax(counts))\n                    else:\n                        a_new = 0\n                    \n                    cnt_array[(targets % r) == a_new] += 1\n                    congr_dict[r] = a_new\n                    \n                n_res = int((cnt_array == 0).sum())\n                current_D = calc_D_val(n_res, logm, logboost)\n\n    # Final cleanup to ensure absolute optimality of residues\n    optimize_all(congr_dict, cnt_array)\n    return congr_dict\n# EVOLVE-BLOCK-END\n\ndef evaluate(eval_inputs: Mapping[str, Any]) -> dict[str, float]:\n    """Run evaluation on the optimized step."""\n    import sympy\n    import numpy as np\n    Q = 100003\n    targets = np.array(list(sympy.primerange(3, Q)), dtype=np.int64)\n    \n    # Warm-start from the 195-digit record cover instead of starting empty\n    congr_dict = {int(r): int(a) for r, a in eval_inputs["warm_start_cover"]}\n    \n    cand_mods = [int(r) for r in sympy.primerange(3, 8000)]\n    cnt_array = np.zeros(len(targets), dtype=np.int16)\n    \n    # Pre-populate counts\n    for r, a in congr_dict.items():\n        cnt_array += (targets % r) == a\n        \n    for it in range(10):\n        t_temp = 0.8 * (0.02 / 0.8) ** (it / 10)\n        # Recalculate cnt_array based on congr_dict\n        cnt_array = np.zeros(len(targets), dtype=np.int16)\n        logm = math.log(2)\n        logboost = math.log(2.0)\n        for r, a in congr_dict.items():\n            cnt_array += (targets % r) == a\n            logm += math.log(r)\n            logboost += math.log(r / (r - 1))\n            \n        congr_dict = optimize_cover_step(congr_dict, cand_mods, targets, cnt_array, logm, logboost, t_temp)\n        \n    # Recalculate final metrics\n    cnt_array = np.zeros(len(targets), dtype=np.int16)\n    logm = math.log(2)\n    logboost = math.log(2.0)\n    for r, a in congr_dict.items():\n        cnt_array += (targets % r) == a\n        logm += math.log(r)\n        logboost += math.log(r / (r - 1))\n        \n    n_res = int((cnt_array == 0).sum())\n    boost = math.exp(logboost)\n    m_digits = logm / math.log(10)\n    \n    ub = n_res * boost\n    LN10 = math.log(10)\n    D = (m_digits + math.sqrt(m_digits ** 2 + 4 * ub / (LN10 * LN10))) / 2\n    \n    # Constrain E <= 17.5 via Lagrangian penalty to prevent reward hacking\n    E_limit = 17.5\n    E_actual = ub / (D * LN10) if D > 0 else 0.0\n    lagrangian_penalty = 0.0\n    if E_actual > E_limit:\n        lagrangian_penalty = 100.0 * (E_actual - E_limit) ** 2\n        \n    score_headline = -float(D + lagrangian_penalty)\n    \n    # Expose E, |U|, digits(M) as negated secondary metrics for joint optimization visibility\n    return {\n        "neg_est_digits": score_headline,\n        "neg_E": -float(E_actual),\n        "neg_residual_count": -float(n_res),\n        "neg_m_digits": -float(m_digits)\n    }\n'}]}, 'evaluation': {'scores': {'scores': [{'metric': 'neg_est_digits', 'score': -192.11285}, {'metric': 'neg_E', 'score': -17.510841}, {'metric': 'neg_residual_count', 'score': -717}, {'metric': 'neg_m_digits', 'score': -184.49625}]}, 'insights': {'insights': [{'label': 'Evaluation Metrics', 'text': 'Estimated Digits: 192.1129 (constrained), E: 17.5108, |U|: 717, digits(M): 184.50'}]}}, 'parentPrograms': ['projects/799795028847/locations/global/collections/default_collection/engines/goldbach_1784979910032/sessions/7658735534374771723/alphaEvolveExperiments/9582896010645531772/alphaEvolvePrograms/7662895210918132141', 'projects/799795028847/locations/global/collections/default_collection/engines/goldbach_1784979910032/sessions/7658735534374771723/alphaEvolveExperiments/9582896010645531772/alphaEvolvePrograms/7662895210918131403', 'projects/799795028847/locations/global/collections/default_collection/engines/goldbach_1784979910032/sessions/7658735534374771723/alphaEvolveExperiments/9582896010645531772/alphaEvolvePrograms/7662895210918131403', 'projects/799795028847/locations/global/collections/default_collection/engines/goldbach_1784979910032/sessions/7658735534374771723/alphaEvolveExperiments/9582896010645531772/alphaEvolvePrograms/7662895210918129792'], 'state': 'COMPLETED'}, {'name': 'projects/799795028847/locations/global/collections/default_collection/engines/goldbach_1784979910032/sessions/7658735534374771723/alphaEvolveExperiments/9582896010645531772/alphaEvolvePrograms/6680257159901446167', 'createTime': '2026-07-26T10:11:00.362312Z', 'content': {'files': [{'path': 'program.py', 'content': '# Copyright 2026 Google LLC\nfrom typing import Any, Mapping\nimport math\nimport random\nimport numpy as np\n\n# EVOLVE-BLOCK-START\ndef optimize_cover_step(congr_dict, cand_mods, targets, cnt_array, logm, logboost, t_temp):\n    """Optimize congruence cover using a powerful local search with Simulated Annealing style logic."""\n    import numpy as np\n    import random\n    import math\n\n    if len(targets) == 0:\n        return congr_dict\n\n    # Copy to avoid side effects during search\n    cnt_array = cnt_array.copy()\n    n_res = int((cnt_array == 0).sum())\n\n    LN10 = math.log(10)\n\n    def calc_D_val(n_res_val, logm_val, logboost_val):\n        boost = math.exp(logboost_val)\n        m_digits = logm_val / LN10\n        ub = n_res_val * boost\n        inside_sqrt = m_digits ** 2 + 4 * ub / (LN10 * LN10)\n        D = (m_digits + math.sqrt(max(0.0, inside_sqrt))) / 2\n        \n        E_actual = ub / (D * LN10) if D > 0 else 0.0\n        penalty = 1000.0 * (E_actual - 17.5) ** 2 if E_actual > 17.5 else 0.0\n        return D + penalty\n\n    def optimize_subset(keys, congr, cnt):\n        for r in keys:\n            a_old = congr[r]\n            rem = targets % r\n            is_cov = (rem == a_old)\n            # Remove contribution\n            cnt[is_cov] -= 1\n            # Find best a\n            uncovered = targets[cnt == 0]\n            if len(uncovered) > 0:\n                counts = np.bincount(uncovered % r, minlength=r)\n                a_new = int(np.argmax(counts))\n            else:\n                a_new = 0\n            # Add contribution back\n            if a_new != a_old:\n                cnt[rem == a_new] += 1\n                congr[r] = a_new\n            else:\n                cnt[is_cov] += 1\n\n    # Initial residue optimization\n    init_keys = list(congr_dict.keys())\n    random.shuffle(init_keys)\n    optimize_subset(init_keys, congr_dict, cnt_array)\n    n_res = int((cnt_array == 0).sum())\n    current_D = calc_D_val(n_res, logm, logboost)\n\n    base_temp = max(t_temp, 1e-6)\n    N_STEPS = 5000\n\n    for step in range(N_STEPS):\n        temp = base_temp * (0.9 ** (step / N_STEPS))\n        # Periodically optimize all to stay on the local optimum manifold\n        if step > 0 and step % 500 == 0:\n            keys = list(congr_dict.keys())\n            random.shuffle(keys)\n            optimize_subset(keys, congr_dict, cnt_array)\n            n_res = int((cnt_array == 0).sum())\n            current_D = calc_D_val(n_res, logm, logboost)\n\n\n        cand_pool = [m for m in cand_mods if m not in congr_dict]\n        if not congr_dict:\n            action = \'add\'\n        else:\n            if not cand_pool:\n                action = random.choices([\'drop\', \'optimize\'], weights=[0.2, 0.8], k=1)[0]\n            else:\n                action = random.choices([\'add\', \'drop\', \'swap\', \'optimize\'], weights=[0.25, 0.25, 0.40, 0.10], k=1)[0]\n        if action == \'add\':\n            if cand_pool:\n                sample_size = min(10, len(cand_pool))\n                sampled_cands = random.sample(cand_pool, sample_size)\n                uncovered = targets[cnt_array == 0]\n                n_res_old = len(uncovered)\n                \n                scores = []\n                cands_data = []\n                for r in sampled_cands:\n                    if n_res_old > 0:\n                        counts = np.bincount(uncovered % r, minlength=r)\n                        a = int(np.argmax(counts))\n                        newly_covered = counts[a]\n                    else:\n                        a = 0\n                        newly_covered = 0\n                    \n                    n_res_new = n_res_old - newly_covered\n                    logm_new = logm + math.log(r)\n                    logboost_new = logboost + math.log(r / (r - 1))\n                    \n                    D = calc_D_val(n_res_new, logm_new, logboost_new)\n                    scores.append(-D)\n                    cands_data.append((r, a))\n                \n                scores = np.array(scores)\n                scaled_scores = scores / temp\n                scaled_scores = scaled_scores - np.max(scaled_scores)\n                probs = np.exp(scaled_scores)\n                probs /= np.sum(probs)\n                \n                idx = np.random.choice(len(sampled_cands), p=probs)\n                best_cand, best_a = cands_data[idx]\n                \n                if -scores[idx] < current_D or random.random() < math.exp(-(-scores[idx] - current_D) / temp):\n                    congr_dict[best_cand] = best_a\n                    cnt_array += (targets % best_cand == best_a)\n                    n_res = int((cnt_array == 0).sum())\n                    logm += math.log(best_cand)\n                    logboost += math.log(best_cand / (best_cand - 1))\n                    current_D = calc_D_val(n_res, logm, logboost)\n\n        elif action == \'swap\':\n            active = list(congr_dict.keys())\n            if active and cand_pool:\n                sampled_mods = random.sample(active, min(20, len(active)))\n                worst_r = sampled_mods[0]\n                worst_score = float(\'inf\')\n                for r in sampled_mods:\n                    unique_cov = np.sum((cnt_array == 1) & (targets % r == congr_dict[r]))\n                    score = unique_cov / (math.log(r) + 1e-9)\n                    if score < worst_score:\n                        worst_score = score\n                        worst_r = r\n                \n                r_drop = worst_r\n                a_drop = congr_dict[r_drop]\n                \n                rem_drop = targets % r_drop\n                cnt_array[rem_drop == a_drop] -= 1\n                n_res_mid = int((cnt_array == 0).sum())\n                logm_mid = logm - math.log(r_drop)\n                logboost_mid = logboost - math.log(r_drop / (r_drop - 1))\n                \n                sampled_cands = random.sample(cand_pool, min(20, len(cand_pool)))\n                best_cand = None\n                best_a = None\n                best_D = float(\'inf\')\n                best_n_res = n_res_mid\n                \n                uncovered = targets[cnt_array == 0]\n                for r in sampled_cands:\n                    if n_res_mid > 0:\n                        counts = np.bincount(uncovered % r, minlength=r)\n                        a = int(np.argmax(counts))\n                        newly_covered = counts[a]\n                    else:\n                        a = 0\n                        newly_covered = 0\n                        \n                    n_res_new = n_res_mid - newly_covered\n                    logm_new = logm_mid + math.log(r)\n                    logboost_new = logboost_mid + math.log(r / (r - 1))\n                    D = calc_D_val(n_res_new, logm_new, logboost_new)\n                    \n                    if D < best_D:\n                        best_D = D\n                        best_cand = r\n                        best_a = a\n                        best_n_res = n_res_new\n                        \n                delta = best_D - current_D\n                if delta < 0 or random.random() < math.exp(-delta / temp):\n                    del congr_dict[r_drop]\n                    congr_dict[best_cand] = best_a\n                    cnt_array += (targets % best_cand == best_a)\n                    n_res = best_n_res\n                    logm = logm_mid + math.log(best_cand)\n                    logboost = logboost_mid + math.log(best_cand / (best_cand - 1))\n                    current_D = best_D\n                else:\n                    cnt_array[rem_drop == a_drop] += 1\n\n        elif action == \'drop\':\n            mods_in = list(congr_dict.keys())\n            if mods_in:\n                sample_size = min(10, len(mods_in))\n                sampled_mods = random.sample(mods_in, sample_size)\n                n_res_old = int((cnt_array == 0).sum())\n                \n                scores = []\n                for r in sampled_mods:\n                    a = congr_dict[r]\n                    loss = np.sum((cnt_array == 1) & (targets % r == a))\n                    n_res_new = n_res_old + loss\n                    \n                    logm_new = logm - math.log(r)\n                    logboost_new = logboost - math.log(r / (r - 1))\n                    \n                    D = calc_D_val(n_res_new, logm_new, logboost_new)\n                    scores.append(-D)\n                    \n                scores = np.array(scores)\n                scaled_scores = scores / temp\n                scaled_scores = scaled_scores - np.max(scaled_scores)\n                probs = np.exp(scaled_scores)\n                probs /= np.sum(probs)\n                \n                idx = np.random.choice(len(sampled_mods), p=probs)\n                r_drop = sampled_mods[idx]\n                a_drop = congr_dict[r_drop]\n                \n                if -scores[idx] < current_D or random.random() < math.exp(-(-scores[idx] - current_D) / temp):\n                    del congr_dict[r_drop]\n                    cnt_array -= (targets % r_drop == a_drop)\n                    n_res = int((cnt_array == 0).sum())\n                    logm -= math.log(r_drop)\n                    logboost -= math.log(r_drop / (r_drop - 1))\n                    current_D = calc_D_val(n_res, logm, logboost)\n\n        elif action == \'optimize\':\n            mods_in = list(congr_dict.keys())\n            if mods_in:\n                sample_size = min(10, len(mods_in))\n                sampled_mods = random.sample(mods_in, sample_size)\n                \n                candidates = []\n                scores = []\n                for r in sampled_mods:\n                    a_old = congr_dict[r]\n                    is_covered_by_r = (targets % r) == a_old\n                    cnt_bg = cnt_array - is_covered_by_r\n                    \n                    uncovered_bg = targets[cnt_bg == 0]\n                    n_res_bg = len(uncovered_bg)\n                    \n                    if n_res_bg > 0:\n                        counts = np.bincount(uncovered_bg % r, minlength=r)\n                        a_best = int(np.argmax(counts))\n                        newly_covered = counts[a_best]\n                    else:\n                        a_best = 0\n                        newly_covered = 0\n                        \n                    n_res_new = n_res_bg - newly_covered\n                    D = calc_D_val(n_res_new, logm, logboost)\n                    \n                    candidates.append((r, a_old, a_best))\n                    scores.append(-D)\n                    \n                scores = np.array(scores)\n                scaled_scores = scores / temp\n                scaled_scores = scaled_scores - np.max(scaled_scores)\n                probs = np.exp(scaled_scores)\n                probs /= np.sum(probs)\n                \n                idx = np.random.choice(len(candidates), p=probs)\n                r_sel, a_old, a_sel = candidates[idx]\n                \n                if a_sel != a_old and (-scores[idx] < current_D or random.random() < math.exp(-(-scores[idx] - current_D) / temp)):\n                    congr_dict[r_sel] = a_sel\n                    cnt_array -= (targets % r_sel == a_old)\n                    cnt_array += (targets % r_sel == a_sel)\n                    n_res = int((cnt_array == 0).sum())\n                    current_D = calc_D_val(n_res, logm, logboost)\n\n    # Final cleanup to ensure absolute optimality of residues\n    final_keys = list(congr_dict.keys())\n    random.shuffle(final_keys)\n    optimize_subset(final_keys, congr_dict, cnt_array)\n    return congr_dict\n# EVOLVE-BLOCK-END\n\ndef evaluate(eval_inputs: Mapping[str, Any]) -> dict[str, float]:\n    """Run evaluation on the optimized step."""\n    import sympy\n    import numpy as np\n    Q = 100003\n    targets = np.array(list(sympy.primerange(3, Q)), dtype=np.int64)\n    \n    # Warm-start from the 195-digit record cover instead of starting empty\n    congr_dict = {int(r): int(a) for r, a in eval_inputs["warm_start_cover"]}\n    \n    cand_mods = [int(r) for r in sympy.primerange(3, 8000)]\n    cnt_array = np.zeros(len(targets), dtype=np.int16)\n    \n    # Pre-populate counts\n    for r, a in congr_dict.items():\n        cnt_array += (targets % r) == a\n        \n    for it in range(10):\n        t_temp = 0.8 * (0.02 / 0.8) ** (it / 10)\n        # Recalculate cnt_array based on congr_dict\n        cnt_array = np.zeros(len(targets), dtype=np.int16)\n        logm = math.log(2)\n        logboost = math.log(2.0)\n        for r, a in congr_dict.items():\n            cnt_array += (targets % r) == a\n            logm += math.log(r)\n            logboost += math.log(r / (r - 1))\n            \n        congr_dict = optimize_cover_step(congr_dict, cand_mods, targets, cnt_array, logm, logboost, t_temp)\n        \n    # Recalculate final metrics\n    cnt_array = np.zeros(len(targets), dtype=np.int16)\n    logm = math.log(2)\n    logboost = math.log(2.0)\n    for r, a in congr_dict.items():\n        cnt_array += (targets % r) == a\n        logm += math.log(r)\n        logboost += math.log(r / (r - 1))\n        \n    n_res = int((cnt_array == 0).sum())\n    boost = math.exp(logboost)\n    m_digits = logm / math.log(10)\n    \n    ub = n_res * boost\n    LN10 = math.log(10)\n    D = (m_digits + math.sqrt(m_digits ** 2 + 4 * ub / (LN10 * LN10))) / 2\n    \n    # Constrain E <= 17.5 via Lagrangian penalty to prevent reward hacking\n    E_limit = 17.5\n    E_actual = ub / (D * LN10) if D > 0 else 0.0\n    lagrangian_penalty = 0.0\n    if E_actual > E_limit:\n        lagrangian_penalty = 100.0 * (E_actual - E_limit) ** 2\n        \n    score_headline = -float(D + lagrangian_penalty)\n    \n    # Expose E, |U|, digits(M) as negated secondary metrics for joint optimization visibility\n    retu