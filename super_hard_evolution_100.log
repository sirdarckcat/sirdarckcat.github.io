)\n            scaled_scores = scores / temp\n            scaled_scores = scaled_scores - np.max(scaled_scores)\n            probs = np.exp(scaled_scores)\n            probs /= np.sum(probs)\n            \n            idx = np.random.choice(len(sampled_mods), p=probs)\n            best_r, best_a = cands_data[idx]\n            congr_dict[best_r] = int(best_a)\n\n    elif action == \'drop\':\n        mods_in = list(congr_dict.keys())\n        if mods_in:\n            sample_size = min(200, len(mods_in))\n            sampled_mods = random.sample(mods_in, sample_size)\n            \n            n_res = np.sum(cnt_array == 0)\n            LN10 = np.log(10)\n            \n            mask_1 = (cnt_array == 1)\n            targets_1 = targets[mask_1]\n            \n            scores = []\n            for r in sampled_mods:\n                a = congr_dict[r]\n                loss = np.sum((targets_1 % r) == a)\n                \n                new_n_res = n_res + loss\n                new_logm = logm - np.log(r)\n                new_logboost = logboost - np.log(r / (r - 1))\n                new_boost = np.exp(new_logboost)\n                new_m_digits = new_logm / LN10\n                \n                ub = new_n_res * new_boost\n                val_inner = new_m_digits**2 + 4 * ub / (LN10 * LN10)\n                val_inner = max(0.0, val_inner)\n                D_new = (new_m_digits + np.sqrt(val_inner)) / 2\n                \n                scores.append(-D_new)\n                \n            scores = np.array(scores)\n            temp = max(t_temp, 1e-4)\n            scaled_scores = scores / temp\n            scaled_scores = scaled_scores - np.max(scaled_scores)\n            probs = np.exp(scaled_scores)\n            probs /= np.sum(probs)\n            \n            idx = np.random.choice(len(sampled_mods), p=probs)\n            r_drop = sampled_mods[idx]\n            del congr_dict[r_drop]\n\n    return congr_dict\n# EVOLVE-BLOCK-END\n\ndef evaluate(eval_inputs: Ma