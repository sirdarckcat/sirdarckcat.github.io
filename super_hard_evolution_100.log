* LN10) if D > 0 else 0.0\n        lagrangian_penalty = 0.0\n        if E_actual > E_limit:\n            lagrangian_penalty = 10000.0 * (E_actual - E_limit) ** 2\n        return D + lagrangian_penalty\n\n    def optimize_all(congr, cnt):\n        keys = list(congr.keys())\n        random.shuffle(keys)\n        for r in keys:\n            a_old = congr[r]\n            rem = targets % r\n            is_cov = (rem == a_old)\n            # Remove contribution\n            cnt[is_cov] -= 1\n            # Find best a\n            uncovered = targets[cnt == 0]\n            if len(uncovered) > 0:\n                counts = np.bincount(uncovered % r, minlength=r)\n                a_new = int(np.argmax(counts))\n            else:\n                a_new = 0\n            # Add contribution back\n            if a_new != a_old:\n                cnt[rem == a_new] += 1\n                congr[r] = a_new\n            else:\n                cnt[is_cov] += 1\n\n    # Initial residue optimization\n    optimize_all(congr_dict, cnt_array)\n    n_res = int((cnt_array == 0).sum())\n    current_D = calc_D_val(n_res, logm, logboost)\n\n    base_temp = max(t_temp, 1e-5)\n    N_STEPS = 2000\n\n    for step in range(N_STEPS):\n        temp = base_temp * (0.95 ** (10 * step / N_STEPS))\n        \n        # Fast local re-optimization\n        if step > 0 and step % 150 == 0:\n            optimize_all(congr_dict, cnt_array)\n            n_res = int((cnt_array == 0).sum())\n            current_D = calc_D_val(n_res, logm, logboost)\n\n        cand_pool = [m for m in cand_mods if m not in congr_dict]\n        \n        if not congr_dict:\n            action = \'add\'\n        else:\n            action = random.choices([\'add\', \'drop\', \'swap\', \'optimize\'], weights=[0.25, 0.15, 0.45, 0.15], k=1)[0]\n            if not cand_pool and action in [\'add\', \'swap\']:\n                action = \'optimize\'\n\n        if action == \'add\':\n            sampled = random.sample(cand_pool, min(200, len(cand_pool)))\n            best_r = None\n            best_a = None\n            best_new_D = float(\'inf\')\n            best_new_n_res = n_res\n            \n            uncovered_targets = targets[cnt_array == 0]\n            for r in sampled:\n                if len(uncovered_targets) > 0:\n                    counts = np.bincount(uncovered_targets % r, minlength=r)\n                    a = int(np.argmax(counts))\n                    added_cov = counts[a]\n                else:\n                    a = 0\n                    added_cov = 0\n                \n                new_n_res = n_res - added_cov\n                new_logm = logm + math.log(r)\n                new_logboost = logboost + math.log(r / (r - 1))\n                new_D = calc_D_val(new_n_res, new_logm, new_logboost)\n                \n                if new_D < best_new_D:\n                    best_new_D = new_D\n                    best_r = r\n                    best_a = a\n                    best_new_n_res = new_n_res\n                    \n            if best_r is not None:\n                delta = best_new_D - current_D\n                if delta < 0 or random.random() < math.exp(-delta / temp):\n                    congr_dict[best_r] = best_a\n                    cnt_array[targets % best_r == best_a] += 1\n                    n_res = best_new_n_res\n                    logm += math.log(best_r)\n                    logboost += math.log(best_r / (best_r - 1))\n                    current_D = best_new_D\n\n        elif action == \'swap\':\n            active = list(congr_dict.keys())\n            sample_active = random.sample(active, min(20, len(active)))\n            singly_covered = (cnt_array == 1)\n            \n            worst_r = sample_active[0]\n            worst_score = float(\'inf\')\n            for r in sample_active:\n                loss = np.sum(singly_covered & ((targets % r) == congr_dict[r]))\n                score = loss + 1.0 / (math.log(r) + 1e-9)\n                if score < worst_score:\n                    worst_score = score\n                    worst_r = r\n            \n            r_drop = worst_r\n            a_drop = congr_dict[r_drop]\n            \n            rem_drop = targets % r_drop\n            cnt_array[rem_drop == a_drop] -= 1\n            \n            uncovered_targets = targets[cnt_array == 0]\n            n_res_after_drop = len(uncovered_targets)\n            logm_after_drop = logm - math.log(r_drop)\n            logboost_after_drop = logboost - math.log(r_drop / (r_drop - 1))\n            \n            sampled_add = random.sample(cand_pool, min(200, len(cand_pool)))\n            best_add_r = None\n            best_add_a = None\n            best_new_D = float(\'inf\')\n            best_new_n_res = n_res_after_drop\n            \n            for r in sampled_add:\n                if n_res_after_drop > 0:\n                    counts = np.bincount(uncovered_targets % r, minlength=r)\n                    a = int(np.argmax(counts))\n                    added_cov = counts[a]\n                else:\n                    a = 0\n                    added_cov = 0\n                \n                new_n_res = n_res_after_drop - added_cov\n                new_logm = logm_after_drop + math.log(r)\n                new_logboost = logboost_after_drop + math.log(r / (r - 1))\n                \n                new_D = calc_D_val(new_n_res, new_logm, new_logboost)\n                if new_D < best_new_D:\n                    best_new_D = new_D\n                    best_add_r = r\n                    best_add_a = a\n                    best_new_n_res = new_n_res\n                    \n            if best_add_r is not None:\n                delta = best_new_D - current_D\n                if delta < 0 or random.random() < math.exp(-delta / temp):\n                    del congr_dict[r_drop]\n                    congr_dict[best_add_r] = best_add_a\n                    cnt_array[targets % best_add_r == best_add_a] += 1\n                    n_res = best_new_n_res\n                    logm = logm_after_drop + math.log(best_add_r)\n                    logboost = logboost_after_drop + math.log(best_add_r / (best_add_r - 1))\n                    current_D = best_new_D\n                else:\n                    cnt_array[rem_drop == a_drop] += 1\n            else:\n                cnt_array[rem_drop == a_drop] += 1\n\n        elif action == \'drop\':\n            active = list(congr_dict.keys())\n            sampled = random.sample(active, min(80, len(active)))\n            best_r = None\n            best_new_D = float(\'inf\')\n            best_new_n_res = n_res\n            \n            singly_covered = (cnt_array == 1)\n            for r in sampled:\n                a = congr_dict[r]\n                lost_cov = np.sum(singly_covered & ((targets % r) == a))\n                new_n_res = n_res + lost_cov\n                new_logm = logm - math.log(r)\n                new_logboost = logboost - math.log(r / (r - 1))\n                new_D = calc_D_val(new_n_res, new_logm, new_logboost)\n                if new_D < best_new_D:\n                    best_new_D = new_D\n                    best_r = r\n                    best_new_n_res = new_n_res\n                    \n            if best_r is not None:\n                delta = best_new_D - current_D\n                if delta < 0 or random.random() < math.exp(-delta / temp):\n                    r_drop = best_r\n                    a_drop = congr_dict[r_drop]\n                    cnt_array[targets % r_drop == a_drop] -= 1\n                    del congr_dict[r_drop]\n                    n_res = best_new_n_res\n                    logm -= math.log(r_drop)\n                    logboost -= math.log(r_drop / (r_drop - 1))\n                    current_D = best_new_D\n\n        elif action == \'optimize\':\n            active = list(congr_dict.keys())\n            sampled = random.sample(active, min(30, len(active)))\n            for r in sampled:\n                a_old = congr_dict[r]\n                is_cov = (targets % r) == a_old\n                cnt_array[is_cov] -= 1\n                \n                uncovered = targets[cnt_array == 0]\n                if len(uncovered) > 0:\n                    counts = np.bincount(uncovered % r, minlength=r)\n                    a_new = int(np.argmax(counts))\n                else:\n                    a_new = 0\n                \n                cnt_array[(targets % r) == a_new] += 1\n                congr_dict[r] = a_new\n            n_res = int((cnt_array == 0).sum())\n            current_D = calc_D_val(n_res, logm, logboost)\n\n    # Final cleanup to ensure absolute optimality of residues\n    optimize_all(congr_dict, cnt_array)\n    return congr_dict\n# EVOLVE-BLOCK-END\n\ndef evaluate(eval_inputs: Mapping[str, Any]) -> dict[str, float]:\n    """Run evaluation on the optimized step."""\n    import sympy\n    import numpy as np\n    Q = 100003\n    targets = np.array(list(sympy.primerange(3, Q)), dtype=np.int64)\n    \n    # Warm-start from the 195-digit record cover instead of starting empty\n    congr_dict = {int(r): int(a) for r, a in eval_inputs["warm_start_cover"]}\n    \n    cand_mods = [int(r) for r in sympy.primerange(3, 8000)]\n    cnt_array = np.zeros(len(targets), dtype=np.int16)\n    \n    # Pre-populate counts\n    for r, a in congr_dict.items():\n        cnt_array += (targets % r) == a\n        \n    for it in range(10):\n        t_temp = 0.8 * (0.02 / 0.8) ** (it / 10)\n        # Recalculate cnt_array based on congr_dict\n        cnt_array = np.zeros(len(targets), dtype=np.int16)\n        logm = math.log(2)\n        logboost = math.log(2.0)\n        for r, a in congr_dict.items():\n            cnt_array += (targets % r) == a\n            logm += math.log(r)\n            logboost += math.log(r / (r - 1))\n            \n        congr_dict = optimize_cover_step(congr_dict, cand_mods, targets, cnt_array, logm, logboost, t_temp)\n        \n    # Recalculate final metrics\n    cnt_array = np.zeros(len(targets), dtype=np.int16)\n    logm = math.log(2)\n    logboost = math.log(2.0)\n    for r, a in congr_dict.items():\n        cnt_array += (targets % r) == a\n        logm += math.log(r)\n        logboost += math.log(r / (r - 1))\n        \n    n_res = int((cnt_array == 0).sum())\n    boost = math.exp(logboost)\n    m_digits = logm / math.log(10)\n    \n    ub = n_res * boost\n    LN10 = math.log(10)\n    D = (m_digits + math.sqrt(m_digits ** 2 + 4 * ub / (LN10 * LN10))) / 2\n    \n    # Constrain E <= 17.5 via Lagrangian penalty to prevent reward hacking\n    E_limit = 17.5\n    E_actual = ub / (D * LN10) if D > 0 else 0.0\n    lagrangian_penalty = 0.0\n    if E_actual > E_limit:\n        lagrangian_penalty = 100.0 * (E_actual - E_limit) ** 2\n        \n    score_headline = -float(D + lagrangian_penalty)\n    \n    # Expose E, |U|, digits(M) as negated secondary metrics for joint optimization visibility\n    return {\n        "neg_est_digits": score_headline,\n        "neg_E": -float(E_actual),\n        "neg_residual_count": -float(n_res),\n        "neg_m_digits": -float(m_digits)\n    }\n'}]}, 'evaluation': {'scores': {'scores': [{'metric': 'neg_est_digits', 'score': -192.35034}, {'metric': 'neg_E', 'score': -17.484274}, {'metric': 'neg_residual_count', 'score': -706}, {'metric': 'neg_m_digits', 'score': -184.757}]}, 'insights': {'insights': [{'label': 'Evaluation Metrics', 'text': 'Estimated Digits: 192.3503 (constrained), E: 17.4843, |U|: 706, digits(M): 184.76'}]}}, 'parentPrograms': ['projects/799795028847/locations/global/collections/default_collection/engines/goldbach_1784979910032/sessions/7658735534374771723/alphaEvolveExperiments/9582896010645531772/alphaEvolvePrograms/11597998738524454422', 'projects/799795028847/locations/global/collections/default_collection/engines/goldbach_1784979910032/sessions/7658735534374771723/alphaEvolveExperiments/9582896010645531772/alphaEvolvePrograms/7662895210918133436', 'projects/799795028847/locations/global/collections/default_collection/engines/goldbach_1784979910032/sessions/7658735534374771723/alphaEvolveExperiments/9582896010645531772/alphaEvolvePrograms/7662895210918132147', 'projects/799795028847/locations/global/collections/default_collection/engines/goldbach_1784979910032/sessions/7658735534374771723/alphaEvolveExperiments/9582896010645531772/alphaEvolvePrograms/7662895210918132147'], 'state': 'COMPLETED'}, {'name': 'projects/799795028847/locations/global/collections/default_collection/engines/goldbach_1784979910032/sessions/7658735534374771723/alphaEvolveExperiments/9582896010645531772/alphaEvolvePrograms/6680257159901446481', 'createTime': '2026-07-26T10:16:44.729982Z', 'content': {'files': [{'path': 'program.py', 'content': '# Copyright 2026 Google LLC\nfrom typing import Any, Mapping\nimport math\nimport random\nimport numpy as np\n\n# EVOLVE-BLOCK-START\ndef optimize_cover_step(congr_dict, cand_mods, targets, cnt_array, logm, logboost, t_temp):\n    """Optimize a single step of congruence cover using simulated annealing style logic.\n\n    Args:\n        congr_dict: Dictionary of r -> a\n        cand_mods: List of prime candidates\n        targets: np.array of target primes\n        cnt_array: np.array of coverage counts\n        logm: current log of modulus M\n        logboost: current log of boost factor\n        t_temp: current temperature\n\n    Returns:\n        Updated congr_dict\n    """\n    import math\n    import random\n    import numpy as np\n\n    # Ensure congr_dict values are python ints\n    congr_dict = {int(k): int(v) for k, v in congr_dict.items()}\n\n    LN10 = 2.302585092994046\n    LN10_SQ = 5.301898110478393\n    \n    def get_score(nr, lm, lb):\n        if nr == 0:\n            return lm / LN10\n        md = lm / LN10\n        ub = nr * math.exp(lb)\n        D = (md + math.sqrt(md * md + 4.0 * ub / LN10_SQ)) / 2.0\n        E_actual = ub / (D * LN10) if D > 0 else 0.0\n        penalty = 0.0\n        if E_actual > 17.5:\n            penalty = 100.0 * (E_actual - 17.5) ** 2\n        return D + penalty\n\n    cnt_array = cnt_array.copy()\n    \n    # Fast redundant prime elimination\n    changed = True\n    while changed:\n        changed = False\n        for r in list(congr_dict.keys()):\n            a = congr_dict[r]\n            mask = (targets % r) == a\n            if np.sum((cnt_array == 1) & mask) == 0:\n                cnt_array -= mask\n                del congr_dict[r]\n                logm -= math.log(r)\n                logboost -= math.log(r / (r - 1))\n                changed = True\n\n    n_res = int((cnt_array == 0).sum())\n    curr_score = get_score(n_res, logm, logboost)\n    \n    num_steps = 600\n    \n    for _ in range(num_steps):\n        action = random.choices([\'add\', \'drop\', \'optimize\', \'swap\'], weights=[20, 20, 30, 30])[0]\n        \n        if action == \'add\':\n            cand_pool = [m for m in cand_mods if m not in congr_dict]\n            if not cand_pool:\n                continue\n            cand_pool_sorted = sorted(cand_pool)\n            cands = cand_pool_sorted[:15]\n            if len(cand_pool_sorted) > 15:\n                cands += random.sample(cand_pool_sorted[15:], min(25, len(cand_pool_sorted) - 15))\n                \n            uncovered = targets[cnt_array == 0]\n            if len(uncovered) == 0:\n                continue\n                \n            best_new_score = float(\'inf\')\n            best_r = None\n            best_a = None\n            best_hits = 0\n            \n            for r in cands:\n                rem = uncovered % r\n                counts = np.bincount(rem, minlength=r)\n                a = int(np.argmax(counts))\n                hits = counts[a]\n                \n                nr = n_res - hits\n                lm = logm + math.log(r)\n                lb = logboost + math.log(r / (r - 1))\n                sc = get_score(nr, lm, lb)\n                \n                if sc < best_new_score:\n                    best_new_score = sc\n                    best_r = r\n                    best_a = a\n                    best_hits = hits\n                    \n            if best_r is not None:\n                score_diff = best_new_score - curr_score\n                if score_diff < 0 or random.random() < math.exp(-score_diff / t_temp):\n                    congr_dict[best_r] = best_a\n                    cnt_array += ((targets % best_r) == best_a)\n                    n_res -= best_hits\n                    logm += math.log(best_r)\n                    logboost += math.log(best_r / (best_r - 1))\n                    curr_score = best_new_score\n                    \n        elif action == \'drop\':\n            mods_in = list(congr_dict.keys())\n            if not mods_in:\n                continue\n            cands = random.sample(mods_in, min(25, len(mods_in)))\n            \n            best_new_score = float(\'inf\')\n            best_r = None\n            best_a = None\n            best_unique = 0\n            best_mask = None\n            \n            for r in cands:\n                a = congr_dict[r]\n                mask = (targets % r) == a\n                unique_hits = np.sum((cnt_array == 1) & mask)\n                \n                nr = n_res + unique_hits\n                lm = logm - math.log(r)\n                lb = logboost - math.log(r / (r - 1))\n                sc = get_score(nr, lm, lb)\n                \n                if sc < best_new_score:\n                    best_new_score = sc\n                    best_r = r\n                    best_a = a\n                    best_unique = unique_hits\n                    best_mask = mask\n                    \n            if best_r is not None:\n                score_diff = best_new_score - curr_score\n                if score_diff < 0 or random.random() < math.exp(-score_diff / t_temp):\n                    del congr_dict[best_r]\n                    cnt_array -= best_mask\n                    n_res += best_unique\n                    logm -= math.log(best_r)\n                    logboost -= math.log(best_r / (best_r - 1))\n                    curr_score = best_new_score\n                    \n        elif action == \'optimize\':\n            mods_in = list(congr_dict.keys())\n            if not mods_in:\n                continue\n            \n            cands = random.sample(mods_in, min(5, len(mods_in)))\n            best_eff = float(\'inf\')\n            r = cands[0]\n            for cand_r in cands:\n                cand_a = congr_dict[cand_r]\n                eff = np.sum((cnt_array == 1) & ((targets % cand_r) == cand_a)) / math.log(cand_r)\n                if eff < best_eff:\n                    best_eff = eff\n                    r = cand_r\n                    \n            a_old = congr_dict[r]\n            \n            mask_old = (targets % r) == a_old\n            unique_hits = np.sum((cnt_array == 1) & mask_old)\n            n_res_bg = n_res + unique_hits\n            \n            cnt_bg = cnt_array - mask_old\n            uncovered_bg = targets[cnt_bg == 0]\n            \n            if len(uncovered_bg) > 0:\n                rem = uncovered_bg % r\n                counts = np.bincount(rem, minlength=r)\n                noise = np.random.uniform(0, t_temp * np.max(counts) + 1e-9, size=r)\n                a_new = int(np.argmax(counts + noise))\n                hits = counts[a_new]\n            else:\n                a_new = random.randint(0, r - 1)\n                hits = 0\n                \n            new_n_res = n_res_bg - hits\n            new_score = get_score(new_n_res, logm, logboost)\n            \n            score_diff = new_score - curr_score\n            if score_diff < 0 or random.random() < math.exp(-score_diff / t_temp):\n                congr_dict[r] = a_new\n                cnt_array = cnt_bg + ((targets % r) == a_new)\n                n_res = new_n_res\n                curr_score = new_score\n                \n        elif action == \'swap\':\n            mods_in = list(congr_dict.keys())\n            cand_pool = [m for m in cand_mods if m not in congr_dict]\n            if not mods_in or not cand_pool:\n                continue\n                \n            cands = random.sample(mods_in, min(5, len(mods_in)))\n            best_eff = float(\'inf\')\n            r_drop = cands[0]\n            for cand_r in cands:\n                cand_a = congr_dict[cand_r]\n                eff = np.sum((cnt_array == 1) & ((targets % cand_r) == cand_a)) / math.log(cand_r)\n                if eff < best_eff:\n                    best_eff = eff\n                    r_drop = cand_r\n                    \n            a_drop = congr_dict[r_drop]\n            \n            mask_drop = (targets % r_drop) == a_drop\n            unique_hits = np.sum((cnt_array == 1) & mask_drop)\n            n_res_bg = n_res + unique_hits\n            \n            cnt_bg = cnt_array - mask_drop\n            uncovered_bg = targets[cnt_bg == 0]\n            \n            cand_pool_sorted = sorted(cand_pool)\n            cands = cand_pool_sorted[:15]\n            if len(cand_pool_sorted) > 15:\n                cands += random.sample(cand_pool_sorted[15:], min(25, len(cand_pool_sorted) - 15))\n                \n            best_new_score = float(\'inf\')\n            best_r_add = None\n            best_a_add = None\n            best_hits = 0\n            \n            for r_add in cands:\n                if len(uncovered_bg) > 0:\n                    rem = uncovered_bg % r_add\n                    counts = np.bincount(rem, minlength=r_add)\n                    a_add = int(np.argmax(counts))\n                    hits = counts[a_add]\n                else:\n                    a_add = random.randint(0, r_add - 1)\n                    hits = 0\n                    \n                nr = n_res_bg - hits\n                lm = logm - math.log(r_drop) + math.log(r_add)\n                lb = logboost - math.log(r_drop / (r_drop - 1)) + math.log(r_add / (r_add - 1))\n                sc = get_score(nr, lm, lb)\n                \n                if sc < best_new_score:\n                    best_new_score = sc\n                    best_r_add = r_add\n                    best_a_add = a_add\n                    best_hits = hits\n                    \n            if best_r_add is not None:\n                score_diff = best_new_score - curr_score\n                if score_diff < 0 or random.random() < math.exp(-score_diff / t_temp):\n                    del congr_dict[r_drop]\n                    congr_dict[best_r_add] = best_a_add\n                    cnt_array = cnt_bg + ((targets % best_r_add) == best_a_add)\n                    n_res = n_res_bg - best_hits\n                    logm = logm - math.log(r_drop) + math.log(best_r_add)\n                    logboost = logboost - math.log(r_drop / (r_drop - 1)) + math.log(best_r_add / (best_r_add - 1))\n                    curr_score = best_new_score\n\n    # Fast redundant prime elimination before returning\n    changed = True\n    while changed:\n        changed = False\n        for r in list(congr_dict.keys()):\n            a = congr_dict[r]\n            mask = (targets % r) == a\n            if np.sum((cnt_array == 1) & mask) == 0:\n                cnt_array -= mask\n                del congr_dict[r]\n                logm -= math.log(r)\n                logboost -= math.log(r / (r - 1))\n                changed = True\n\n    return congr_dict\n# EVOLVE-BLOCK-END\n\ndef evaluate(eval_inputs: Mapping[str, Any]) -> dict[str, float]:\n    """Run evaluation on the optimized step."""\n    import sympy\n    import numpy as np\n    Q = 100003\n    targets = np.array(list(sympy.primerange(3, Q)), dtype=np.int64)\n    \n    # Warm-start from the 195-digit record cover instead of starting empty\n    congr_dict = {int(r): int(a) for r, a in eval_inputs["warm_start_cover"]}\n    \n    cand_mods = [int(r) for r in sympy.primerange(3, 8000)]\n    cnt_array = np.zeros(len(targets), dtype=np.int16)\n    \n    # Pre-populate counts\n    for r, a in congr_dict.items():\n        cnt_array += (targets % r) == a\n        \n    for it in range(10):\n        t_temp = 0.8 * (0.02 / 0.8) ** (it / 10)\n        # Recalculate cnt_array based on congr_dict\n        cnt_array = np.zeros(len(targets), dtype=np.int16)\n        logm = math.log(2)\n        logboost = math.log(2.0)\n        for r, a in congr_dict.items():\n            cnt_array += (targets % r) == a\n            logm += math.log(r)\n            logboost += math.log(r / (r - 1))\n            \n        congr_dict = optimize_cover_step(congr_dict, cand_mods, targets, cnt_array, logm, logboost, t_temp)\n        \n    # Recalculate final metrics\n    cnt_array = np.zeros(len(targets), dtype=np.int16)\n    logm = math.log(2)\n    logboost = math.log(2.0)\n    for r, a in congr_dict.items():\n        cnt_array += (targets % r) == a\n        logm += math.log(r)\n        logboost += math.log(r / (r - 1))\n        \n    n_res = int((cnt_array == 0).sum())\n    boost = math.exp(logboost)\n    m_digits = logm / math.log(10)\n    \n    ub = n_res * boost\n    LN10 = math.log(10)\n    D = (m_digits + math.sqrt(m_digits ** 2 + 4 * ub / (LN10 * LN10))) / 2\n    \n    # Constrain E <= 17.5 via Lagrangian penalty to prevent reward hacking\n    E_limit = 17.5\n    E_actual = ub / (D * LN10) if D > 0 else 0.0\n    lagrangian_penalty = 0.0\n    if E_actual > E_limit:\n        lagrangian_penalty = 100.0 * (E_actual - E_limit) ** 2\n        \n    score_headline = -float(D + lagrangian_penalty)\n    \n    # Expose E, |U|, digits(M) as negated secondary metrics for joint optimization visibility\n    return {\n        "neg_est_digits": score_headline,\n        "neg_E": -float(E_actual),\n        "neg_residual_count": -float(n_res),\n        "neg_m_digits": -float(m_digits)\n    }\n'}]}, 'evaluation': {'scores': {'scores': [{'metric': 'neg_est_digits', 'score': -192.35484}, {'metric': 'neg_E', 'score': 