zeros(len(targets), dtype=np.int16)\n    logm = math.log(2)\n    logboost = math.log(2.0)\n    for r, a in congr_dict.items():\n        cnt_array += (targets % r) == a\n        logm += math.log(r)\n        logboost += math.log(r / (r - 1))\n        \n    n_res = int((cnt_array == 0).sum())\n    boost = math.exp(logboost)\n    m_digits = logm / math.log(10)\n    \n    ub = n_res * boost\n    LN10 = math.log(10)\n    D = (m_digits + math.sqrt(m_digits ** 2 + 4 * ub / (LN10 * LN10))) / 2\n    \n    # Constrain E <= 17.5 via Lagrangian penalty to prevent reward hacking\n    E_limit = 17.5\n    E_actual = ub / (D * LN10) if D > 0 else 0.0\n    lagrangian_penalty = 0.0\n    if E_actual > E_limit:\n        lagrangian_penalty = 100.0 * (E_actual - E_limit) ** 2\n        \n    score_headline = -float(D + lagrangian_penalty)\n    \n    # Expose E, |U|, digits(M) as negated secondary metrics for joint optimization visibility\n    return {\n        "neg_est_digits": score_headline,\n        "neg_E": -float(E_actual),\n        "neg_residual_count": -float(n_res),\n        "neg_m_digits": -float(m_digits)\n    }\n'}]}, 'evaluation': {'scores': {'scores': [{'metric': 'neg_est_digits', 'score': -198.14232}, {'metric': 'neg_E', 'score': -17.459}, {'metric': 'neg_residual_count', 'score': -745}, {'metric': 'neg_m_digits', 'score': -190.55997}]}, 'insights': {'insights': [{'label': 'Evaluation Metrics', 'text': 'Estimated Digits: 198.1423 (constrained), E: 17.4590, |U|: 745, digits(M): 190.56'}]}}, 'parentPrograms': ['projects/799795028847/locations/global/collections/default_collection/engines/goldbach_1784979910032/sessions/7658735534374771723/alphaEvolveExperiments/9582896010645531772/alphaEvolvePrograms/6333111851244192882', 'projects/799795028847/locations/global/collections/default_collection/engines/goldbach_1784979910032/sessions/7658735534374771723/alphaEvolveExperiments/9582896010645531772/alphaEvolvePrograms/6333111851244192882', 'projects/799795028847/locations/global/collections/default_collection/engines/goldbach_1784979910032/sessions/7658735534374771723/alphaEvolveExperiments/9582896010645531772/alphaEvolvePrograms/6333111851244192882', 'projects/799795028847/locations/global/collections/default_collection/engines/goldbach_1784979910032/sessions/7658735534374771723/alphaEvolveExperiments/9582896010645531772/alphaEvolvePrograms/6333111851244192882'], 'state': 'COMPLETED'}, {'name': 'projects/799795028847/locations/global/collections/default_collection/engines/goldbach_1784979910032/sessions/7658735534374771723/alphaEvolveExperiments/9582896010645531772/alphaEvolvePrograms/7662895210918133618', 'createTime': '2026-07-26T05:52:40.579391Z', 'content': {'files': [{'path': 'program.py', 'content': '# Copyright 2026 Google LLC\nfrom typing import Any, Mapping\nimport math\nimport random\nimport numpy as np\n\n# EVOLVE-BLOCK-START\ndef optimize_cover_step(congr_dict, cand_mods, targets, cnt_array, logm, logboost, t_temp):\n    """Optimize a single step of congruence cover using simulated annealing style logic.\n\n    Args:\n        congr_dict: Dictionary of r -> a\n        cand_mods: List of prime candidates\n        targets: np.array of target primes\n        cnt_array: np.array of coverage counts\n        logm: current log of modulus M\n        logboost: current log of boost factor\n        t_temp: current temperature\n\n    Returns:\n        Updated congr_dict\n    """\n    import numpy as np\n    import random\n    import math\n\n    if len(targets) == 0:\n        # Safety fallback\n        kind = random.random()\n        r_in = random.choice(list(congr_dict)) if congr_dict else None\n        if kind < 0.5 and r_in is not None:\n            a_old = congr_dict[r_in]\n            a_new = random.randint(0, r_in - 1)\n            if a_new != a_old:\n                congr_dict[r_in] = a_new\n        elif kind < 0.7 and r_in is not None:\n            del congr_dict[r_in]\n        else:\n            r_out = random.choice(cand_mods)\n            if r_out not in congr_dict:\n                a_new = random.randint(0, r_out - 1)\n                congr_dict[r_out] = a_new\n        return congr_dict\n\n    # Sync logm and logboost exactly\n    logm = math.log(2)\n    logboost = math.log(2.0)\n    for r, a in congr_dict.items():\n        logm += math.log(r)\n        logboost += math.log(r / (r - 1))\n\n    # Copy cnt_array to avoid in-place side effects on caller\'s reference\n    cnt_array = cnt_array.copy()\n    n_res = int((cnt_array == 0).sum())\n    \n    LN10 = 2.302585092994046\n\n    def get_score(n_res, logm, logboost):\n        m_digits = logm / LN10\n        boost = math.exp(logboost)\n        ub = n_res * boost\n        D = (m_digits + math.sqrt(m_digits ** 2 + 4 * ub / (LN10 * LN10))) / 2\n        E_actual = ub / (D * LN10) if D > 0 else 0.0\n        lagrangian_penalty = 0.0\n        if E_actual > 17.5:\n            lagrangian_penalty = 100.0 * (E_actual - 17.5) ** 2\n        return D + lagrangian_penalty\n\n    current_score = get_score(n_res, logm, logboost)\n    \n    # Run multiple inner simulated annealing iterations to optimize thoroughly\n    inner_iters = 150\n    cand_mods_set = set(cand_mods)\n    congr_keys = set(congr_dict.keys())\n    \n    for _ in range(inner_iters):\n        action = random.choices(\n            [\'adjust\', \'drop\', \'add\', \'swap\'],\n            weights=[0.35, 0.15, 0.25, 0.25],\n            k=1\n        )[0]\n        \n        if action == \'adjust\' and congr_dict:\n            r = random.choice(list(congr_dict.keys()))\n            a_old = congr_dict[r]\n            mask_old = (targets % r == a_old)\n            cnt_temp = cnt_array - mask_old\n            counts = np.bincount(targets % r, weights=(cnt_temp == 0).astype(float), minlength=r)\n            a_new = int(np.argmax(counts))\n            if a_new != a_old:\n                n_res_new = int(np.sum(cnt_temp == 0) - counts[a_new])\n                new_score = get_score(n_res_new, logm, logboost)\n                if new_score < current_score or random.random() < math.exp((current_score - new_score) / t_temp):\n                    congr_dict[r] = a_new\n                    cnt_array = cnt_temp + (targets % r == a_new)\n                    n_res = n_res_new\n                    current_score = new_score\n                    \n        elif action == \'drop\' and len(congr_dict) > 1:\n            r = random.choice(list(congr_dict.keys()))\n            a = congr_dict[r]\n            mask = (targets % r == a)\n            n_res_new = n_res + int(np.sum((cnt_array == 1) & mask))\n            logm_new = logm - math.log(r)\n            logboost_new = logboost - math.log(r / (r - 1))\n            new_score = get_score(n_res_new, logm_new, logboost_new)\n            if new_score < current_score or random.random() < math.exp((current_score - new_score) / t_temp):\n                del congr_dict[r]\n                congr_keys.remove(r)\n                cnt_array -= mask\n                n_res = n_res_new\n                logm = logm_new\n                logboost = logboost_new\n                current_score = new_score\n                \n        elif action == \'add\':\n            avail = list(cand_mods_set - congr_keys)\n            if avail:\n                sampled = random.sample(avail, min(15, len(avail)))\n                best_r, best_a, best_n_res_new, best_score = None, None, None, float(\'inf\')\n                for r in sampled:\n                    counts = np.bincount(targets % r, weights=(cnt_array == 0).astype(float), minlength=r)\n                    a = int(np.argmax(counts))\n                    n_res_new = n_res - counts[a]\n                    logm_new = logm + math.log(r)\n                    logboost_new = logboost + math.log(r / (r - 1))\n                    score = get_score(n_res_new, logm_new, logboost_new)\n                    if score < best_score:\n                        best_score, best_r, best_a, best_n_res_new = score, r, a, n_res_new\n                \n                if best_r is not None:\n                    if best_score < current_score or random.random() < math.exp((current_score - best_score) / t_temp):\n                        congr_dict[best_r] = best_a\n                        congr_keys.add(best_r)\n                        cnt_array += (targets % best_r == best_a)\n                        n_res = int(best_n_res_new)\n                        logm = logm + math.log(best_r)\n                        logboost = logboost + math.log(best_r / (best_r - 1))\n                        current_score = best_score\n                        \n        elif action == \'swap\' and congr_dict:\n            r_in = random.choice(list(congr_dict.keys()))\n            avail = list(cand_mods_set - congr_keys)\n            if avail:\n                sampled = random.sample(avail, min(10, len(avail)))\n                a_in = congr_dict[r_in]\n                mask_in = (targets % r_in == a_in)\n                cnt_temp = cnt_array - mask_in\n                n_res_temp = n_res + int(np.sum((cnt_array == 1) & mask_in))\n                logm_temp = logm - math.log(r_in)\n                logboost_temp = logboost - math.log(r_in / (r_in - 1))\n                \n                best_r, best_a, best_n_res_new, best_score = None, None, None, float(\'inf\')\n                for r_out in sampled:\n                    counts = np.bincount(targets % r_out, weights=(cnt_temp == 0).astype(float), minlength=r_out)\n                    a_out = int(np.argmax(counts))\n                    n_res_new = n_res_temp - counts[a_out]\n                    logm_new = logm_temp + math.log(r_out)\n                    logboost_new = logboost_temp + math.log(r_out / (r_out - 1))\n                    score = get_score(n_res_new, logm_new, logboost_new)\n                    if score < best_score:\n                        best_score, best_r, best_a, best_n_res_new = score, r_out, a_out, n_res_new\n                \n                if best_r is not None:\n                    if best_score < current_score or random.random() < math.exp((current_score - best_score) / t_temp):\n                        del congr_dict[r_in]\n                        congr_keys.remove(r_in)\n                        congr_dict[best_r] = best_a\n                        congr_keys.add(best_r)\n                        cnt_array = cnt_temp + (targets % best_r == best_a)\n                        n_res = int(best_n_res_new)\n                        logm = logm_temp + math.log(best_r)\n                        logboost = logboost_temp + math.log(best_r / (best_r - 1))\n                        current_score = best_score\n\n    return congr_dict\n# EVOLVE-BLOCK-END\n\ndef evaluate(eval_inputs: Mapping[str, Any]) -> dict[str, float]:\n    """Run evaluation on the optimized step."""\n    import sympy\n    import numpy as np\n    Q = 100003\n    targets = np.array(list(sympy.primerange(3, Q)), dtype=np.int64)\n    \n    # Warm-start from the 195-digit record cover instead of starting empty\n    congr_dict = {int(r): int(a) for r, a in eval_inputs["warm_start_cover"]}\n    \n    cand_mods = [int(r) for r in sympy.primerange(3, 8000)]\n    cnt_array = np.zeros(len(targets), dtype=np.int16)\n    \n    # Pre-populate counts\n    for r, a in congr_dict.items():\n        cnt_array += (targets % r) == a\n        \n    for it in range(10):\n        t_temp = 0.8 * (0.02 / 0.8) ** (it / 10)\n        # Recalculate cnt_array based on congr_dict\n        cnt_array = np.zeros(len(targets), dtype=np.int16)\n        logm = math.log(2)\n        logboost = math.log(2.0)\n        for r, a in congr_dict.items():\n            cnt_array += (targets % r) == a\n            logm += math.log(r)\n            logboost += math.log(r / (r - 1))\n            \n        congr_dict = optimize_cover_step(congr_dict, cand_mods, targets, cnt_array, logm, logboost, t_temp)\n        \n    # Recalculate final metrics\n    cnt_array = np.zeros(len(targets), dtype=np.int16)\n    logm = math.log(2)\n    logboost = math.log(2.0)\n    for r, a in congr_dict.items():\n        cnt_array += (targets % r) == a\n        logm += math.log(r)\n        logboost += math.log(r / (r - 1))\n        \n    n_res = int((cnt_array == 0).sum())\n    boost = math.exp(logboost)\n    m_digits = logm / math.log(10)\n    \n    ub = n_res * boost\n    LN10 = math.log(10)\n    D = (m_digits + math.sqrt(m_digits ** 2 + 4 * ub / (LN10 * LN10))) / 2\n    \n    # Constrain E <= 17.5 via Lagrangian penalty to prevent reward hacking\n    E_limit = 17.5\n    E_actual = ub / (D * LN10) if D > 0 else 0.0\n    lagrangian_penalty = 0.0\n    if E_actual > E_limit:\n        lagrangian_penalty = 100.0 * (E_actual - E_limit) ** 2\n        \n    score_headline = -float(D + lagrangian_penalty)\n    \n    # Expose E, |U|, digits(M) as negated secondary metrics for joint optimization visibility\n    return {\n        "neg_est_digits": score_headline,\n        "neg_E": -float(E_actual),\n        "neg_residual_count": -float(n_res),\n        "neg_m_digits": -float(m_digits)\n    }\n'}]}, 'evaluation': {'scores': {'scores': [{'metric': 'neg_est_digits', 'score': -198.34496}, {'metric': 'neg_E', 'score': -17.535019}, {'metric': 'neg_residual_count', 'score': -753}, {'metric': 'neg_m_digits', 'score': -190.60695}]}, 'insights': {'insights': [{'label': 'Evaluation Metrics', 'text': 'Estimated Digits: 198.3449 (constrained), E: 17.5350, |U|: 753, digits(M): 190.61'}]}}, 'parentPrograms': ['projects/799795028847/locations/global/collections/default_collection/engines/goldbach_1784979910032/sessions/7658735534374771723/alphaEvolveExperiments/9582896010645531772/alphaEvolvePrograms/7662895210918130595'], 'state': 'COMPLETED'}, {'name': 'projects/799795028847/locations/global/collections/default_collection/engines/goldbach_1784979910032/sessions/7658735534374771723/alphaEvolveExperiments/9582896010645531772/alphaEvolvePrograms/7662895210918133753', 'createTime': '2026-07-26T05:53:21.932503Z', 'content': {'files': [{'path': 'program.py', 'content': '# Copyright 2026 Google LLC\nfrom typing import Any, Mapping\nimport math\nimport random\nimport numpy as np\n\n# EVOLVE-BLOCK-START\ndef optimize_cover_step(congr_dict, cand_mods, targets, cnt_array, logm, logboost, t_temp):\n    """Optimize a single step of congruence cover using simulated annealing style logic.\n\n    Args:\n        congr_dict: Dictionary of r -> a\n        cand_mods: List of prime candidates\n        targets: np.array of target primes\n        cnt_array: np.array of coverage counts\n        logm: current log of modulus M\n        logboost: current log of boost factor\n        t_temp: current temperature\n\n    Returns:\n        Updated congr_dict\n    """\n    import numpy as np\n    import random\n    import math\n\n    if len(targets) == 0:\n        # Safety fallback\n        kind = random.random()\n        r_in = random.choice(list(congr_dict)) if congr_dict else None\n        if kind < 0.5 and r_in is not None:\n            a_old = congr_dict[r_in]\n            a_new = random.randint(0, r_in - 1)\n            if a_new != a_old:\n                congr_dict[r_in] = a_new\n        elif kind < 0.7 and r_in is not None:\n            del congr_dict[r_in]\n        else:\n            r_out = random.choice(cand_mods)\n            if r_out not in congr_dict:\n                a_new = random.randint(0, r_out - 1)\n                congr_dict[r_out] = a_new\n        return congr_dict\n\n    n_res_current = int(np.sum(cnt_array == 0))\n    \n    def get_score(n_res, lm, lb):\n        import math\n        boost = math.exp(lb)\n        md = lm / 2.302585092994046\n        ub = n_res * boost\n        LN10 = 2.302585092994046\n        D = (md + math.sqrt(max(0.0, md**2 + 4 * ub / (LN10 * LN10)))) / 2\n        E_act = ub / (D * LN10) if D > 0 else 0.0\n        pen = 100.0 * (max(0.0, E_act - 17.5))**2\n        return D + pen\n\n    # Dynamic action probabilities based on temperature\n    factor = np.clip(t_temp, 0.0, 1.0)\n    p_opt = 0.85 - 0.45 * factor\n    p_add = 0.10 + 0.25 * factor\n    p_drop = 0.05 + 0.20 * factor\n    total_p = p_opt + p_add + p_drop\n    p_opt /= total_p\n    p_add /= total_p\n    p_drop /= total_p\n\n    kind = random.random()\n    if not congr_dict:\n        action = \'add\'\n    else:\n        cand_pool = [m for m in cand_mods if m not in congr_dict]\n        if not cand_pool:\n            p_opt_cond = p_opt / (p_opt + p_drop)\n            action = \'optimize\' if kind < p_opt_cond else \'drop\'\n        else:\n            if kind < p_add:\n                action = \'add\'\n            elif kind < p_add + p_opt:\n                action = \'optimize\'\n            else:\n                action = \'drop\'\n\n    if action == \'add\':\n        if cand_pool:\n            sample_size = min(300, len(cand_pool))\n            sampled_cands = random.sample(cand_pool, sample_size)\n            \n            weights_add = np.where(cnt_array == 0, 1.0, 1e-4)\n            \n            fitnesses = []\n            cands_data = []\n            for r in sampled_cands:\n                rem = targets % r\n                counts = np.bincount(rem, weights=weights_add, minlength=r)\n                a = int(np.argmax(counts))\n                cov_pseudo = counts[a]\n                \n                n_res_pseudo = n_res_current - cov_pseudo\n                lm_new = logm + math.log(r)\n                lb_new = logboost + math.log(r / (r - 1))\n                \n                score = get_score(n_res_pseudo, lm_new, lb_new)\n                fitnesses.append(-score)\n                cands_data.append((r, a))\n                \n            fitnesses = np.array(fitnesses)\n            fit_min, fit_max = np.min(fitnesses), np.max(fitnesses)\n            if fit_max > fit_min:\n                norm_fit = (fitnesses - fit_min) / (fit_max - fit_min)\n            else:\n                norm_fit = np.ones_like(fitnesses)\n                \n            temp = max(t_temp, 1e-4)\n            scaled = norm_fit / temp\n            scaled = scaled - np.max(scaled)\n            probs = np.exp(scaled)\n            probs /= np.sum(probs)\n            \n            idx = np.random.choice(len(sampled_cands), p=probs)\n            best_cand, best_a = cands_data[idx]\n            congr_dict[best_cand] = int(best_a)\n\n    elif action == \'optimize\':\n        mods_in = list(congr_dict.keys())\n        if mods_in:\n            r = random.choice(mods_in)\n            a_old = congr_dict[r]\n            \n            is_covered_by_r = (targets % r) == a_old\n            cnt_bg = cnt_array - is_covered_by_r\n            \n            weights_opt = np.where(cnt_bg == 0, 1.0, 1e-4)\n            counts = np.bincount(targets % r, weights=weights_opt, minlength=r)\n            \n            c_min, c_max = np.min(counts), np.max(counts)\n            if c_max > c_min:\n                norm_fit = (counts - c_min) / (c_max - c_min)\n            else:\n                norm_fit = np.ones_like(counts)\n                \n            temp = max(t_temp, 1e-4)\n            scaled = norm_fit / temp\n            scaled = scaled - np.max(scaled)\n            probs = np.exp(scaled)\n            probs /= np.sum(probs)\n            \n            a_new = np.random.choice(r, p=probs)\n            congr_dict[r] = int(a_new)\n\n    elif action == \'drop\':\n        mods_in = list(congr_dict.keys())\n        if mods_in:\n            weights_drop = np.where(cnt_array == 1, 1.0, 1e-4)\n            \n            fitnesses = []\n            for r in mods_in:\n                a = congr_dict[r]\n                mask = (targets % r) == a\n                uncov_pseudo = np.sum(weights_drop[mask])\n                \n                n_res_pseudo = n_res_current + uncov_pseudo\n                lm_new = logm - math.log(r)\n                lb_new = logboost - math.log(r / (r - 1))\n                \n                score = get_score(n_res_pseudo, lm_new, lb_new)\n                fitnesses.append(-score)\n                \n            fitnesses = np.array(fitnesses)\n            fit_min, fit_max = np.min(fitnesses), np.max(fitnesses)\n            if fit_max > fit_min:\n                norm_fit = (fitnesses - fit_min) / (fit_max - fit_min)\n            else:\n                norm_fit = np.ones_like(fitnesses)\n                \n            temp = max(t_temp, 1e-4)\n            scaled = norm_fit / temp\n            scaled = scaled - np.max(scaled)\n            probs = np.exp(scaled)\n            probs /= np.sum(probs)\n            \n            idx = np.random.choice(len(mods_in), p=probs)\n            r_drop = mods_in[idx]\n            del congr_dict[r_drop]\n\n    return congr_dict\n# EVOLVE-BLOCK-END\n\ndef evaluate(eval_inputs: Mapping[str, Any]) -> dict[str, float]:\n    """Run evaluation on the optimized step."""\n    import sympy\n    import numpy as np\n    Q = 100003\n    targets = np.array(list(sympy.primerange(3, Q)), dtype=np.int64)\n    \n    # Warm-start from the 195-digit record cover instead of starting empty\n    congr_dict = {int(r): int(a) for r, a in eval_inputs["warm_start_cover"]}\n    \n    cand_mods = [int(r) for r in sympy.primerange(3, 8000)]\n    cnt_array = np.zeros(len(targets), dtype=np.int16)\n    \n    # Pre-populate counts\n    for r, a in congr_dict.items():\n        cnt_array += (targets % r) == a\n        \n    for it in range(10):\n        t_temp = 0.8 * (0.02 / 0.8) ** (it / 10)\n        # Recalculate cnt_array based on congr_dict\n        cnt_array = np.zeros(len(targets), dtype=np.int16)\n        logm = math.log(2)\n        logboost = math.log(2.0)\n        for r, a in congr_dict.items():\n            cnt_array += (targets % r) == a\n            logm += math.log(r)\n            logboost += math.log(r / (r - 1))\n            \n        congr_dict = optimize_cover_step(congr_dict, cand_mods, targets, cnt_array, logm, logboost, t_temp)\n        \n    # Recalculate final metrics\n    cnt_array = np.zeros(len(targets), dtype=np.int16