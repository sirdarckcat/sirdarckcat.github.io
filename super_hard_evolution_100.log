t_lagrangian_score(new_res, logm, logboost)\n                \n                if new_score < best_new_score:\n                    best_new_score = new_score\n                    best_r, best_a_new, best_mask_old, best_mask_new, best_new_res = r, a_new, mask_old, mask_new, new_res\n                \n                cnt_array[mask_old] += 1\n\n            if best_new_score < curr_score or random.random() < math.exp((curr_score - best_new_score) / micro_temp):\n                congr_dict[best_r] = best_a_new\n                cnt_array[best_mask_old] -= 1\n                cnt_array[best_mask_new] += 1\n                curr_res = best_new_res\n                curr_score = best_new_score\n\n        elif action == \'swap\':\n            r_drop = random.choice(mods_in)\n            a_drop = congr_dict[r_drop]\n            mask_drop = (targets % r_drop) == a_drop\n            \n            cnt_array[mask_drop] -= 1\n            temp_res = curr_res + int((cnt_array[mask_drop] == 0).sum())\n            \n            tournament = random.sample(cand_pool, min(4, len(cand_pool)))\n            best_r_add, best_a_add, best_new_score, best_mask_add, best_new_res = None, None, float(\'inf\'), None, None\n            new_lm_base = logm - math.log(r_drop)\n            new_lb_base = logboost - math.log(r_drop / (r_drop - 1))\n            \n            for r_add in tournament:\n                rem_add = targets % r_add\n                counts = np.bincount(rem_add[cnt_array == 0], minlength=r_add)\n                a_add = int(random.choice(np.flatnonzero(counts == counts.max())))\n                mask_add = (rem_add == a_add)\n                \n                new_res = temp_res - int((cnt_array[mask_add] == 0).sum())\n                new_lm = new_lm_base + math.log(r_add)\n                new_lb = new_lb_base + math.log(r_add / (r_add - 1))\n                new_score = exact_lagrangian_score(new_res, new_lm, new_lb)\n                \n                if new_score < best_new_score:\n   