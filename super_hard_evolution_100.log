:\n            a_old = congr_dict[r]\n            rem = get_remainders(r, targets)\n            # Boolean tensor mask for elements reliant on or uncovered by this mode\n            uncovered_bg = (cnt_array == 0) | ((cnt_array == 1) & (rem == a_old))\n            counts = np.bincount(rem[uncovered_bg], minlength=r)\n            best_a = int(np.argmax(counts))\n            if best_a != a_old and counts[best_a] > counts[a_old]:\n                congr_dict[r] = best_a\n                cnt_array -= (rem == a_old)\n                cnt_array += (rem == best_a)\n                changed = True\n        if not changed:\n            break\n\n    def compute_score(n_res, lm, lb):\n        boost = math.exp(lb)\n        md = lm / math.log(10)\n        ub = n_res * boost\n        LN10 = math.log(10)\n        D = (md + math.sqrt(md ** 2 + 4 * ub / (LN10 * LN10))) / 2\n        \n        # Lagrangian penalization to strictly maintain E <= 17.5 boundary with a safe margin\n        E_limit = 17.48\n        E_actual = ub / (D * LN10) if D > 0 else 0.0\n        penalty = 5000.0 * (E_actual - E_limit) ** 2 if E_actual > E_limit else 0.0\n        return float(D + penalty)\n\n    # Perform multiple inner steps to accelerate convergence within the SA temperature window\n    for inner_it in range(50):\n        uncovered = (cnt_array == 0)\n        covered_once = (cnt_array == 1)\n        curr_n_res = int(np.count_nonzero(uncovered))\n        moves = []\n        \n        # 1. Evaluate candidate ADD moves (Biased sampling to favor smaller primes)\n        unused = [m for m in cand_mods if m not in congr_dict]\n        if unused:\n            if len(unused) <= 60:\n                add_cands = unused\n            else:\n                add_cands = unused[:20] + random.sample(unused[20:], 40)\n            for r in add_cands:\n                rem = get_remainders(r, targets)\n                counts = np.bincount(rem[uncovered], minlength=r)\n                best_a = int(np.argmax(counts))\n                new_n_res = curr_n_res - counts[best_a]\n                new_lm = logm + math.log(r)\n                new_lb = logboost + math.log(r / (r - 1))\n                score = compute_score(new_n_res, new_lm, new_lb)\n                moves.append((\'add\', r, best_a, score))\n\n        # 2. Evaluate candidate DROP moves (Full gradient evaluation over all used modes)\n        used = sorted(congr_dict.keys())\n        if used:\n            # Evaluate all used primes to precisely identify the least contributing mode\n            drop_cands = used\n            for r in drop_cands:\n                a = congr_dict[r]\n                rem = get_remainders(r, targets)\n                new_n_res = curr_n_res + int(np.count_nonzero(rem[covered_once] == a))\n                new_lm = logm - math.log(r)\n                new_lb = logboost - math.log(r / (r - 1))\n                score = compute_score(new_n_res, new_lm, new_lb)\n                moves.append((\'drop\', r, a, score))\n\n        # 3. Evaluate candidate OPTIMIZE moves (Full gradient evaluation)\n        if used:\n            n_opt = min(60, len(used))\n            opt_cands = random.sample(used, n_opt) if len(used) > 60 else used\n            for r in opt_cands:\n                a_old = congr_dict[r]\n                rem = get_remainders(r, targets)\n                uncovered_bg = uncovered | (covered_once & (rem == a_old))\n                n_res_bg = int(np.count_nonzero(uncovered_bg))\n                \n                counts = np.bincount(rem[uncovered_bg], minlength=r)\n                counts[a_old] = -1  # Exclude current choice to simulate a state transition\n                best_a = int(np.argmax(counts))\n                if counts[best_a] >= 0:\n                    new_n_res = n_res_bg - counts[best_a]\n                    score = compute_score(new_n_res, logm, logboost)\n                    moves.append((\'optimize\', r, best_a, score, a_old))\n\n        if not moves:\n            break\n\n        # Probabilistically select the optimal local move across all action classes (Minimize Score)\n        scores = np.array([m[3] for m in moves])\n        temp = max(t_temp, 1e-5)\n        scaled = -(scores - np.min(scores)) / temp\n        \n        if temp < 1e-4:\n            best_idx = int(np.argmin(scores))\n            probs = np.zeros(len(scores))\n            probs[best_idx] = 1.0\n        else:\n            scaled = np.clip(scaled, -500, 0)\n            probs = np.exp(scaled)\n            sum_probs = np.sum(probs)\n            if sum_probs > 0:\n                probs /= sum_probs\n            else:\n                probs = np.ones(len(probs)) / len(probs)\n                \n        chosen_idx = np.random.choice(len(moves), p=probs)\n        move = moves[chosen_idx]\n        action = move[0]\n        r = move[1]\n        \n        # Apply the chosen move and precisely cascade modifications inplace\n        if action == \'add\':\n            a = move[2]\n            congr_dict[r] = a\n            cnt_array += (get_remainders(r, targets) == a)\n            logm += math.log(r)\n            logboost += math.log(r / (r - 1))\n        elif action == \'drop\':\n            a = move[2]\n            del congr_dict[r]\n            cnt_array -= (get_remainders(r, targets) == a)\n            logm -= math.log(r)\n            logboost -= math.log(r / (r - 1))\n        elif action == \'optimize\':\n            a_new = move[2]\n            a_old = move[4]\n            congr_dict[r] = a_new\n            cnt_array -= (get_remainders(r, targets) == a_old)\n            cnt_array += (get_remainders(r, targets) == a_new)\n\n    return congr_dict\n# EVOLVE-BLOCK-END\n\ndef evaluate(eval_inputs: Mapping[str, Any]) -> dict[str, float]:\n    """Run evaluation on the optimized step."""\n    import sympy\n    import numpy as np\n    Q = 100003\n    targets = np.array(list(sympy.primerange(3, Q)), dtype=np.int64)\n    \n    # Warm-start from the 195-digit record cover instead of starting empty\n  