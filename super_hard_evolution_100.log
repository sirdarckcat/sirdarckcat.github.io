ngian_penalty = 100.0 * (E_actual - E_limit) ** 2\n        return D + lagrangian_penalty\n\n    def optimize_all(congr, cnt):\n        keys = list(congr.keys())\n        random.shuffle(keys)\n        for r in keys:\n            a_old = congr[r]\n            rem = targets % r\n            is_cov = (rem == a_old)\n            cnt[is_cov] -= 1\n            uncovered = targets[cnt == 0]\n            if len(uncovered) > 0:\n                counts = np.bincount(uncovered % r, minlength=r)\n                a_new = int(np.argmax(counts))\n            else:\n                a_new = 0\n            if a_new != a_old:\n                cnt[rem == a_new] += 1\n                congr[r] = a_new\n            else:\n                cnt[is_cov] += 1\n\n    optimize_all(congr_dict, cnt_array)\n    n_res = int((cnt_array == 0).sum())\n    current_D = calc_D_val(n_res, logm, logboost)\n\n    mods_in = list(congr_dict.keys())\n    cand_pool = [m for m in cand_mods if m not in congr_dict]\n\n    N_STEPS = 4000\n    base_temp = max(t_temp, 1e-4)\n\n    for step in range(N_STEPS):\n        temp = base_temp * (0.8 ** (step / (N_STEPS / 10)))\n        \n        if step > 0 and step % 800 == 0:\n            optimize_all(congr_dict, cnt_array)\n            n_res = int((cnt_array == 0).sum())\n            current_D = calc_D_val(n_res, logm, logboost)\n\n        if not mods_in:\n            action = \'add\'\n        elif not cand_pool:\n            action = random.choice([\'drop\', \'optimize\'])\n        else:\n            action = random.choices([\'add\', \'drop\', \'swap\', \'optimize\'], weights=[0.25, 0.15, 0.40, 0.20])[0]\n\n        if action == \'add\':\n            uncovered = targets[cnt_array == 0]\n            if len(uncovered) > 0:\n                sample_cands = random.sample(cand_pool, min(4, len(cand_pool)))\n                best_r = sample_cands[0]\n                best_a = 0\n                best_newly_covered = -1\n                \n                if random.random() < 0.7:\n                    bh = uncovered[random.randint(0, len(uncovered) - 1)]\n                    for r in sample_cands:\n                        a = int(bh % r)\n                        newly_covered = np.sum((uncovered % r) == a)\n                        if newly_covered > best_newly_covered:\n                            best_newly_covered = newly_covered\n                            best_r = r\n                            best_a = a\n                else:\n                    for r in sample_cands:\n                        counts = np.bincount(uncovered % r, minlength=r)\n                        a = int(np.argmax(counts))\n                        newly_covered = counts[a]\n                        if newly_covered > best_newly_covered:\n                            best_newly_covered = newly_covered\n                            best_r = r\n                            best_a = a\n                r = best_r\n                a = best_a\n                newly_covered = best_newly_covered\n            else:\n                r = random.choice(cand_pool)\n                a = 0\n                newly_covered = 0\n                \n            n_res_new = n_res - newly_covered\n            logm_new = logm + math.log(r)\n            logboost_new = logboost + math.log(r / (r - 1))\n            D_new = calc_D_val(n_res_new, logm_new, logboost_new)\n            \n            delta = D_new - current_D\n            if delta < 0 or random.random() < math.exp(-delta / temp):\n                congr_dict[r] = a\n                cand_pool.remove(r)\n                mods_in.append(r)\n                cnt_array += (targets % r == a)\n                n_res = n_res_new\n                logm = logm_new\n                logboost = logboost_new\n                current_D = D_new\n\n        elif action == \'drop\':\n            sample_mods = random.sample(mods_in, min(4, len(mods_in)))\n            best_drop_r = sample_mods[0]\n            min_loss = float(\'inf\')\n            best_a = congr_dict[b