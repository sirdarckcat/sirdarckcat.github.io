vered_targets = targets[cnt_array == 0]\n            if len(uncovered_targets) == 0:\n                continue\n                \n            best_r = None\n            best_a = 0\n            best_max_covered = -1\n            \n            for _ in range(2):\n                r_cand = random.choice(cand_mods)\n                if r_cand in congr_dict:\n                    continue\n                counts = np.bincount(uncovered_targets % r_cand, minlength=r_cand)\n                a_cand = int(np.argmax(counts))\n                if counts[a_cand] > best_max_covered:\n                    best_max_covered = counts[a_cand]\n                    best_r = r_cand\n                    best_a = a_cand\n                    \n            if best_r is None:\n                continue\n                \n            r = best_r\n            a = best_a\n            max_covered = best_max_covered\n            \n            new_n_res = n_res - max_covered\n            new_logm = logm + math.log(r)\n            new_logboost = logboost + math.log(r / (r - 1))\n            new_ub = new_n_res * math.exp(new_logboost)\n            new_D = calc_D(new_logm, new_ub)\n            \n            if new_D < current_D or random.random() < math.exp((current_D - new_D) / max(t_temp, 1e-9)):\n                congr_dict[r] = a\n                cnt_array += (targets % r) == a\n                logm, logboost, current_D, n_res = new_logm, new_logboost, new_D, new_n_res\n\n        elif action == \'drop\':\n            best_r = None\n            best_new_D = float(\'inf\')\n            best_mask = None\n            best_new_n_res = 0\n            \n            candidates = random.sample(list(congr_dict.keys()), min(2, len(congr_dict)))\n            for r in candidates:\n                a_drop = congr_dict[r]\n                mask = (targets % r) == a_drop\n                num_only_r = np.sum((cnt_array == 1) & mask)\n                \n                n_res_cand = n_res + num_only_r\n                logm_cand = logm - math.log(r)\n                logboost_cand = logboost - math.log(r / (r - 1))\n                ub_cand = n_res_cand * math.exp(logboost_cand)\n                D_cand = calc_D(logm_cand, ub_cand)\n                \n                if D_cand < best_new_D:\n                    best_new_D = D_cand\n                    best_r = r\n                    best_mask = mask\n                    best_new_n_res = n_res_cand\n                    \n            if best_r is None:\n                continue\n                \n            if best_new_D < current_D or random.random() < math.exp((current_D - best_new_D) / max(t_temp, 1e-9)):\n                del congr_dict[best_r]\n                cnt_array -= best_mask\n                logm -= math.log(best_r)\n                logboost -= math.log(best_r / (best_r - 1))\n                current_D, n_res = best_new_D, best_new_n_res\n\n        elif action == \'swap\':\n            r_drop = random.choice(list(congr_dict.keys()))\n            a_drop = congr_dict[r_drop]\n            \n            mask_drop = (targets % r_drop) == a_drop\n            only_r_mask = (cnt_array == 1) & mask_drop\n            uncovered_bg = targets[(cnt_array == 0) | only_r_mask]\n            \n            if len(uncovered_bg) == 0:\n                continue\n\n            best_r_add = None\n            best_a_add = 0\n            best_max_covered = -1\n            \n            for _ in range(2):\n                r_cand = random.choice(cand_mods)\n                if r_cand in congr_dict:\n                    continue\n                counts = np.bincount(uncovered_bg % r_cand, minlength=r_cand)\n                a_cand = int(np.argmax(counts))\n                if counts[a_cand] > best_max_covered:\n                    best_max_covered = counts[a_cand]\n                    best_r_add = r_cand\n                    best_a_add = a_cand\n                    \n            if best_r_add is None:\n                continue\n                \n            r_add = best_r_add\n            a_add = best_a_add\n            max_covered = best_max_covered\n                \n            new_n_res = n_res + np.sum(only_r_mask) - max_covered\n            new_logm = logm - math.log(r_drop) + math.log(r_add)\n            new_logboost = logboost - math.log(r_drop / (r_drop - 1)) + math.log(r_add / (r_add - 1))\n            new_ub = new_n_res * math.exp(new_logboost)\n            new_D = calc_D(new_logm, new_ub)\n            \n            if new_D < current_D or random.random() < math.exp((current_D - new_D) / max(t_temp, 1e-9)):\n                del congr_dict[r_drop]\n                congr_dict[r_add] = a_add\n                cnt_array -= mask_drop\n                cnt_array += (targets % r_add) == a_add\n                logm, logboost, current_D, n_res = new_logm, new_logboost, new_D, new_n_res\n\n        elif action == \'optimize\':\n            best_r = None\n            best_a_new = None\n            best_new_D = float(\'inf\')\n            best_mask = None\n            best_new_n_res = 0\n            \n            candidates = random.sample(list(congr_dict.keys()), min(2, len(congr_dict)))\n            for r in candidates:\n                a_old = congr_dict[r]\n                mask = (targets % r) == a_old\n                only_r_mask = (cnt_array == 1) & mask\n                uncovered_bg = targets[(cnt_array == 0) | only_r_mask]\n                \n                if len(uncovered_bg) > 0:\n                    counts = np.bincount(uncovered_bg % r, minlength=r)\n                    a_new = int(np.argmax(counts))\n                    max_covered = counts[a_new]\n                else:\n                    a_new = 0\n                    max_covered = 0\n                    \n                if a_new != a_old:\n                    n_res_cand = n_res + np.sum(only_r_mask) - max_covered\n                    ub_cand = n_res_cand * math.exp(logboost)\n                    D_cand = calc_D(logm, ub_cand)\n                    \n                    if D_cand < best_new_D:\n                        best_new_D = D_cand\n                        best_r = r\n                        best_a_new = a_new\n                        best_mask = mask\n                        best_new_n_res = n_res_cand\n\n            if best_r is not None:\n                if best_new_D < current_D or random.random() < math.exp((current_D - best_new_D) / max(t_temp, 1e-9)):\n                    congr_dict[best_r] = best_a_new\n                    cnt_array -= best_mask\n                    cnt_array += (targets % best_r) == best_a_new\n                    current_D, n_res = best_new_D, best_new_n_res\n\n    return congr_dict\n# EVOLVE-BLOCK-END\n\ndef evaluate(eval_inputs: Mapping[str, Any]) -> dict[str, float]:\n    """Run evaluation on the optimized step."""\n    # Let\'s say we maximize -n_digits_est (smaller estimated N-size)\n    # Using sympy/math to compute est digits\n    import sympy\n    import numpy as np\n    Q = 100003\n    targets = np.array(list(sympy.primerange(3, Q)), dtype=np.int64)\n    # Let\'s run the optimize_cover_step starting from empty cover for some iterations\n    congr_dict = {}\n    cand_mods = [int(r) for r in sympy.primerange(3, 8000)]\n    cnt_array = np.zeros(len(targets), dtype=np.int16)\n    logm = math.log(2)\n    logboost = math.log(2.0)\n    \n    for it in range(10):\n        t_temp = 0.8 * (0.02 / 0.8) ** (it / 10)\n        # Update cnt_array based on congr_dict\n        cnt_array = np.zeros(len(targets), dtype=np.int16)\n        logm = math.log(2)\n        logboost = math.log(2.0)\n        for r, a in congr_dict.items():\n            cnt_array += (targets % r) == a\n            logm += math.log(r)\n            logboost += math.log(r / (r - 1))\n            \n        congr_dict = optimize_cover_step(congr_dict, cand_mods, targets, cnt_array, logm, logboost, t_temp)\n        \n    # Recalculate final metrics\n    cnt_array = np.zeros(len(targets), dtype=np.int16)\n    logm = math.log(2)\n    logboost = math.log(2.0)\n    for r, a in congr_dict.items():\n        cnt_array += (targets % r) == a\n        logm += math.log(r)\n        logboost += math.log(r / (r - 1))\n        \n    n_res = int((cnt_array == 0).sum())\n    boost = math.exp(logboost)\n    m_digits = logm / math.log(10)\n    \n    ub = n_res * boost\n    LN10 = math.log(10)\n    D = (m_digits + math.sqrt(m_digits ** 2 + 4 * ub / (LN10 * LN10))) / 2\n    return {"neg_est_digits": -float(D)}\n'}]}, 'evaluation': {'scores': {'scores': [{'metric': 'neg_est_digits', 'score': -50.655006}]}}, 'parentPrograms': ['projects/799795028847/locations/global/collections/default_collection/engines/goldbach_1784979910032/sessions/7013217697778074030/alphaEvolveExperiments/15164875354338173448/alphaEvolvePrograms/18102573509735108720'], 'state': 'COMPLETED'}, {'name': 'projects/799795028847/locations/global/collections/default_collection/engines/goldbach_1784979910032/sessions/7013217697778074030/alphaEvolveExperiments/15164875354338173448/alphaEvolvePrograms/18102573509735108640', 'createTime': '2026-07-25T19:51:34.848225Z', 'content': {'files': [{'path': 'program.py', 'content': '# Copyright 2026 Google LLC\nfrom typing import Any, Mapping\nimport math\nimport random\nimport numpy as np\n\n# EVOLVE-BLOCK-START\n_CACHE = {}\n\ndef get_mod_matrix(targets, cand_mods):\n    key = (id(targets), len(cand_mods))\n    if key not in _CACHE:\n        import numpy as np\n        import math\n        cand_mods_arr = np.array(cand_mods, dtype=np.int64)\n        mod_matrix = targets[:, np.newaxis] % cand_mods_arr\n        r_to_idx = {r: i for i, r in enumerate(cand_mods)}\n        log_r_dict = {r: math.log(r) for r in cand_mods}\n        boost_factor_dict = {r: r / (r - 1) for r in cand_mods}\n        _CACHE[key] = (mod_matrix, r_to_idx, log_r_dict, boost_factor_dict)\n    return _CACHE[key]\n\ndef optimize_cover_step(congr_dict, cand_mods, targets, cnt_array, logm, logboost, t_temp):\n    """Optimize congruence cover using multi-step exact simulated annealing logic."""\n    import numpy as np\n    import random\n    import math\n\n    if len(targets) == 0:\n        return congr_dict\n\n    LN10 = 2.302585092994046\n    LN10_SQ_INV_4 = 4.0 / (LN10 ** 2)\n\n    def calc_D(m_val, ub_val):\n        m_dig = m_val / LN10\n        if ub_val >= 0:\n            return (m_dig + math.sqrt(m_dig**2 + ub_val * LN10_SQ_INV_4)) / 2\n        else:\n            dD_dub = 1.0 / max(1e-9, 2.0 * m_dig * (LN10**2))\n            return m_dig + ub_val * dD_dub\n\n    mod_matrix, r_to_idx, log_r_dict, boost_factor_dict = get_mod_matrix(targets, cand_mods)\n    cnt_array = np.array(cnt_array, dtype=np.int16)\n\n    # We use a batch-proposal simulated annealing strategy.\n    # By precomputing the entire modulo matrix, we can evaluate candidate moves in parallel batches\n    # without memory allocation, allowing us to perform 4000 highly effective thermodynamic steps.\n    internal_steps = 4000\n    n_res = int(np.sum(cnt_array == 0))\n    boost = math.exp(logboost)\n    current_ub = n_res * boost\n    current_D = calc_D(logm, current_ub)\n\n    uncovered_mask = (cnt_array == 0)\n    uncovered_mods_all = mod_matrix[uncovered_mask, :]\n\n    for step_idx in range(internal_steps):\n        t_local = t_temp * (0.1 ** (step_idx / internal_steps))\n        \n        if not congr_dict:\n            action = \'add\'\n        else:\n            action = random.choices([\'add\', \'drop\', \'optimize\'], weights=[0.5, 0.25, 0.25])[0]\n\n        if action == \'add\':\n            available = [r for r in cand_mods if r not in congr_dict]\n            if not available:\n                continue\n            batch = random.sample(available, min(16, len(available)))\n            \n            best_r = None\n            best_a = None\n            best_new_D = float(\'inf\')\n            best_max_covered = 0\n            \n            for r in batch:\n                r_idx = r_to_idx[r]\n                uncovered_mods = uncovered_mods_all[:, r_idx]\n                if len(uncovered_mods) > 0:\n                    counts = np.bincount(uncovered_mods, minlength=r)\n                    a = int(np.argmax(counts))\n                    max_covered = counts[a]\n                else:\n                    a = 0\n                    max_covered = 0\n                \n                new_n_res = n_res - max_covered\n                new_logm = logm + log_r_dict[r]\n                new_boost = boost * boost_factor_dict[r]\n                new_ub = new_n_res * new_boost\n                new_D = calc_D(new_logm, new_ub)\n                \n                if new_D < best_new_D:\n                    best_new_D = new_D\n                    best_r = r\n                    best_a = a\n                    best_max_covered = max_covered\n            \n            if best_r is not None:\n                if best_new_D < current_D or random.random() < math.exp((current_D - best_new_D) / max(t_local, 1e-9)):\n                    congr_dict[best_r] = best_a\n                    r_idx = r_to_idx[best_r]\n                    cnt_array += (mod_matrix[:, r_idx] == best_a)\n                    logm += log_r_dict[best_r]\n                    boost *= boost_factor_dict[best_r]\n                    current_D = best_new_D\n                    n_res -= best_max_covered\n                    \n                    uncovered_mask = (cnt_array == 0)\n                    uncovered_mods_all = mod_matrix[uncovered_mask, :]\n\n        elif action == \'drop\':\n            active_keys = list(congr_dict.keys())\n            if active_keys:\n                batch = random.sample(active_keys, min(6, len(active_keys)))\n                best_r = None\n                best_new_D = float(\'inf\')\n                best_n_res = n_res\n                best_mask = None\n                \n                for r in batch:\n                    a_drop = congr_dict[r]\n                    r_idx = r_to_idx[r]\n                    mask = (mod_matrix[:, r_idx] == a_drop)\n                    num_only_r = np.sum((cnt_array == 1) & mask)\n                    \n                    new_n_res = n_res + num_only_r\n                    new_logm = logm - log_r_dict[r]\n                    new_boost = boost / boost_factor_dict[r]\n                    new_ub = new_n_res * new_boost\n                    new_D = calc_D(new_logm, new_ub)\n                    \n                    if new_D < best_new_D:\n                        best_new_D = new_D\n                        best_r = r\n                        best_n_res = new_n_res\n                        best_mask = mask\n                \n                if best_r is not None:\n                    if best_new_D < current_D or random.random() < math.exp((current_D - best_new_D) / max(t_local, 1e-9)):\n                        del congr_dict[best_r]\n                        cnt_array -= best_mask\n                        logm -= log_r_dict[best_r]\n                        boost /= boost_factor_dict[best_r]\n                        current_D = best_new_D\n                        n_res = best_n_res\n                        \n                        uncovered_mask = (cnt_array == 0)\n                        uncovered_mods_all = mod_matrix[uncovered_mask, :]\n\n        elif action == \'optimize\':\n            active_keys = list(congr_dict.keys())\n            if active_keys:\n                batch = random.sample(active_keys, min(6, len(active_keys)))\n                best_r = None\n                best_a_new = None\n                best_new_D = float(\'inf\')\n                best_n_res = n_res\n                best_old_mask = None\n                best_new_mask = None\n                \n                for r in batch:\n                    a_old = congr_dict[r]\n                    r_idx = r_to_idx[r]\n                    mask = (mod_matrix[:, r_idx] == a_old)\n                    only_r_mask = (cnt_array == 1) & mask\n                    uncovered_bg_mask = (cnt_array == 0) | only