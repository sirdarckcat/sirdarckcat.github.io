ub / (D * LN10) if D > 0 else 0.0\n        lagrangian_penalty = 0.0\n        if E_actual > E_limit:\n            lagrangian_penalty = 1000.0 * (E_actual - E_limit) ** 2\n        return D + lagrangian_penalty\n\n    current_D = calc_D_val(n_res, logm, logboost)\n\n    def optimize_all(congr, cnt, cur_n_res, cur_logm, cur_logboost, cur_D):\n        keys = list(congr.keys())\n        random.shuffle(keys)\n        for r in keys:\n            a_old = congr[r]\n            rem = targets % r\n            is_cov = (rem == a_old)\n            cnt[is_cov] -= 1\n            uncovered = targets[cnt == 0]\n            if len(uncovered) > 0:\n                counts = np.bincount(uncovered % r, minlength=r)\n                a_new = int(np.argmax(counts))\n            else:\n                a_new = 0\n                \n            if a_new != a_old:\n                cnt[rem == a_new] += 1\n                new_n_res = int((cnt == 0).sum())\n                new_D = calc_D_val(new_n_res, cur_logm, cur_logboost)\n                if new_D <= cur_D:\n                    congr[r] = a_new\n                    cur_D = new_D\n                    cur_n_res = new_n_res\n                else:\n                    cnt[rem == a_new] -= 1\n                    cnt[is_cov] += 1\n            else:\n                cnt[is_cov] += 1\n        return cur_n_res, cur_D\n\n    # Initial residue optimization\n    n_res, current_D = optimize_all(congr_dict, cnt_array, n_res, logm, logboost, current_D)\n\n    base_temp = max(t_temp, 1e-5)\n    N_STEPS = 500\n\n    for step in range(N_STEPS):\n        temp = base_temp * (0.95 ** (10 * step / N_STEPS))\n\n        action = random.choices(\n            [\'add\', \'drop\', \'swap\', \'optimize\'], \n            weights=[0.15, 0.15, 0.50, 0.20], \n            k=1\n        )[0]\n\n        cand_pool = [m for m in cand_mods if m not in congr_dict]\n        active = list(congr_dict.keys())\n        \n        if not active:\n            action = \'add\'\n        if not c