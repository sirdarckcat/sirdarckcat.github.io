ts_mod_r[r_add] == a_add)\n            \n            current_logm += -math.log(r_drop) + math.log(r_add)\n            current_logboost += -math.log(r_drop / (r_drop - 1)) + math.log(r_add / (r_add - 1))\n            current_n_res = np.count_nonzero(current_cnt == 0)\n            \n            sweep_remainders()\n            best_score = get_score_metrics(current_n_res, current_logm, current_logboost, penalty_w=100.0)\n            best_congr = current_congr.copy()\n            improved = True\n            \n        if not improved:\n            break\n            \n    return best_congr\n# EVOLVE-BLOCK-END\n\ndef evaluate(eval_inputs: Mapping[str, Any]) -> dict[str, float]:\n    """Run evaluation on the optimized step."""\n    import sympy\n    import numpy as np\n    Q = 100003\n    targets = np.array(list(sympy.primerange(3, Q)), dtype=np.int64)\n    \n    # Warm-start from the 195-digit record cover instead of starting empty\n    congr_dict = {int(r): int(a) for r, a in eval_inputs["warm_start_cover"]}\n    \n    cand_mods = [int(r) for r in sympy.primerange(3, 8000)]\n    cnt_array = np.zeros(len(targets), dtype=np.int16)\n    \n    # Pre-populate counts\n    for r, a in congr_dict.items():\n        cnt_array += (targets % r) == a\n        \n    for it in range(10):\n        t_temp = 0.8 * (0.02 / 0.8) ** (it / 10)\n        # Recalculate cnt_array based on congr_dict\n        cnt_array = np.zeros(len(targets), dtype=np.int16)\n        logm = math.log(2)\n        logboost = math.log(2.0)\n        for r, a in congr_dict.items():\n            cnt_array += (targets % r) == a\n            logm += math.log(r)\n            logboost += math.log(r / (r - 1))\n            \n        congr_dict = optimize_cover_step(congr_dict, cand_mods, targets, cnt_array, logm, logboost, t_temp)\n        \n    # Recalculate final metrics\n    cnt_array = np.zeros(len(targets), dtype=np.int16)\n    logm = math.log(2)\n    logboost = math.log(2.0)\n    for r, a in congr_dict.items():\n        cnt_array += (targets % r) == a\n        logm += math.log(r)\n        logboost += math.log(r / (r - 1))\n        \n    n_res = int((cnt_array == 0).sum())\n    boost = math.exp(logboost)\n    m_digits = logm / math.log(10)\n    \n    ub = n_res * boost\n    LN10 = math.log(10)\n    D = (m_digits + math.sqrt(m_digits ** 2 + 4 * ub / (LN10 * LN10))) / 2\n    \n    # Constrain E <= 17.5 via Lagrangian penalty to prevent reward hacking\n    E_limit = 17.5\n    E_actual = ub / (D * LN10) if D > 0 else 0.0\n    lagrangian_penalty = 0.0\n    if E_actual > E_limit:\n        lagrangian_penalty = 100.0 * (E_actual - E_limit) ** 2\n        \n    score_headline = -float(D + lagrangian_penalty)\n    \n    # Expose E, |U|, digits(M) as negated secondary metrics for joint optimization visibility\n    return {\n        "neg_est_digits": score_headline,\n        "neg_E": -float(E_actual),\n        "neg_residual_count": -float(n_res),\n        "neg_m_digits": -float(m_digits)\n    }\n'}]}, 'evaluation': {'scores': {'scores': [{'metric': 'neg_est_digits', 'score': -192.49173}, {'metric': 'neg_E', 'score': -17.513712}, {'metric': 'neg_residual_count', 'score': -708}, {'metric': 'neg_m_digits', 'score': -184.86682}]}, 'insights': {'insights': [{'label': 'Evaluation Metrics', 'text': 'Estimated Digits: 192.4917 (constrained), E: 17.5137, |U|: 708, digits(M): 184.87'}]}}, 'parentPrograms': ['projects/799795028847/locations/global/collections/default_collection/engines/goldbach_1784979910032/sessions/7658735534374771723/alphaEvolveExperiments/9582896010645531772/alphaEvolvePrograms/7662895210918132085'], 'state': 'COMPLETED'}, {'name': 'projects/799795028847/locations/global/collections/default_collection/engines/goldbach_1784979910032/sessions/7658735534374771723/alphaEvolveExperiments/9582896010645531772/alphaEvolvePrograms/6680257159901448318', 'createTime': '2026-07-26T10:33:31.375117Z', 'content': {'files': [{'path': 'program.py', 'content': '# Copyright 2026 Google LLC\nfrom typing import Any, Mapping\nimport math\nimport random\nimport numpy as np\n\n# EVOLVE-BLOCK-START\ndef optimize_cover_step(congr_dict, cand_mods, targets, cnt_array, logm, logboost, t_temp):\n    """Optimize congruence cover using CRISPR-Cas9 Guided Hyper-Dimensional Genome Editing!\n    \n    CRAZY IDEA: We treat the prime congruence cover as a living hyper-genome. Single-point mutations\n    are too slow, so we deploy programmable \'RNA guides\' to target and cleave \'junk DNA\' (inefficient\n    primes) via CRISPR_cleave. This is followed by Homology-Directed Repair (HDR_splice) to insert\n    highly-optimized gene cassettes. We also induce Transposon Leaps (multi-candidate guided swaps) \n    and Epigenetic Reprogramming (bulk residue optimization) to maximize phenotypic expression.\n    """\n    import numpy as np\n    import random\n    import math\n\n    if len(targets) == 0:\n        return congr_dict\n\n    # Copy to avoid side effects during search\n    cnt_array = cnt_array.copy()\n    n_res = int((cnt_array == 0).sum())\n\n    LN10 = math.log(10)\n\n    def calc_D_val(n_res_val, logm_val, logboost_val):\n        boost = math.exp(logboost_val)\n        m_digits = logm_val / LN10\n        ub = n_res_val * boost\n        inside_sqrt = m_digits ** 2 + 4 * ub / (LN10 * LN10)\n        D = (m_digits + math.sqrt(max(0.0, inside_sqrt))) / 2\n        \n        E_actual = ub / (D * LN10) if D > 0 else 0.0\n        penalty = 1000.0 * (E_actual - 17.5) ** 2 if E_actual > 17.5 else 0.0\n        return D + penalty\n\n    def optimize_subset(keys, congr, cnt):\n        for r in keys:\n            a_old = congr[r]\n            rem = targets % r\n            cnt[rem == a_old] -= 1\n            counts = np.bincount(rem[cnt == 0], minlength=r)\n            a_new = int(np.argmax(counts))\n            cnt[rem == a_new] += 1\n            congr[r] = a_new\n\n    # Initial residue optimization\n    init_keys = list(congr_dict.keys())\n    random.shuffle(init_keys)\n    optimize_subset(init_keys, congr_dict, cnt_array)\n    n_res = int((cnt_array == 0).sum())\n    current_D = calc_D_val(n_res, logm, logboost)\n\n    base_temp = max(t_temp, 1e-6)\n    N_STEPS = 100000\n\n    for step in range(N_STEPS):\n        temp = base_temp * (0.9 ** (step / N_STEPS))\n        # Periodically optimize all to stay on the local optimum manifold\n        if step > 0 and step % 10000 == 0:\n            keys = list(congr_dict.keys())\n            random.shuffle(keys)\n            optimize_subset(keys, congr_dict, cnt_array)\n            n_res = int((cnt_array == 0).sum())\n            current_D = calc_D_val(n_res, logm, logboost)\n\n        action = random.choices(\n            [\'add\', \'drop\', \'swap\', \'CRISPR_cleave\', \'HDR_splice\', \'transposon_leap\', \'epigenetic_reprogramming\'],\n            weights=[0.10, 0.10, 0.15, 0.15, 0.15, 0.25, 0.10], k=1)[0]\n\n        if action == \'add\':\n            r = random.choice(cand_mods)\n            if r not in congr_dict:\n                counts = np.bincount(targets[cnt_array == 0] % r, minlength=r)\n                a = int(np.argmax(counts))\n                new_n_res = n_res - counts[a]\n                new_D = calc_D_val(new_n_res, logm + math.log(r), logboost + math.log(r / (r - 1)))\n                \n                if new_D < current_D or random.random() < math.exp(-(new_D - current_D) / temp):\n                    congr_dict[r] = a\n                    cnt_array[targets % r == a] += 1\n                    n_res, current_D = new_n_res, new_D\n                    logm += math.log(r)\n                    logboost += math.log(r / (r - 1))\n\n        elif action == \'drop\':\n            active = list(congr_dict.keys())\n            if active:\n                r = random.choice(active)\n                a = congr_dict[r]\n                lost_cov = np.sum((targets[cnt_array == 1] % r) == a)\n                new_n_res = n_res + lost_cov\n                new_D = calc_D_val(new_n_res, logm - math.log(r), logboost - math.log(r / (r - 1)))\n                \n                if new_D < current_D or random.random() < math.exp(-(new_D - current_D) / temp):\n                    cnt_array[targets % r == a] -= 1\n                    del congr_dict[r]\n                    n_res, current_D = new_n_res, new_D\n                    logm -= math.log(r)\n                    logboost -= math.log(r / (r - 1))\n\n        elif action == \'swap\':\n            active = list(congr_dict.keys())\n            if active:\n                r_drop = random.choice(active)\n                r_add = random.choice(cand_mods)\n                \n                if r_add not in congr_dict:\n                    a_drop = congr_dict[r_drop]\n                    \n                    rem_drop = targets % r_drop\n                    cnt_array[rem_drop == a_drop] -= 1\n                    n_res_after_drop = int((cnt_array == 0).sum())\n                    logm_after = logm - math.log(r_drop)\n                    logboost_after = logboost - math.log(r_drop / (r_drop - 1))\n                    \n                    counts = np.bincount(targets[cnt_array == 0] % r_add, minlength=r_add)\n                    a_add = int(np.argmax(counts))\n                    \n                    new_n_res = n_res_after_drop - counts[a_add]\n                    new_D = calc_D_val(new_n_res, logm_after + math.log(r_add), logboost_after + math.log(r_add / (r_add - 1)))\n                    \n                    if new_D < current_D or random.random() < math.exp(-(new_D - current_D) / temp):\n                        del congr_dict[r_drop]\n                        congr_dict[r_add] = a_add\n                        cnt_array[targets % r_add == a_add] += 1\n                        n_res, current_D = new_n_res, new_D\n                        logm = logm_after + math.log(r_add)\n                        logboost = logboost_after + math.log(r_add / (r_add - 1))\n                    else:\n                        cnt_array[rem_drop == a_drop] += 1\n\n        elif action == \'optimize\' or action == \'epigenetic_reprogramming\':\n            active = list(congr_dict.keys())\n            if active:\n                k_samples = 1 if action == \'optimize\' else min(5, len(active))\n                sampled = random.sample(active, k_samples)\n                optimize_subset(sampled, congr_dict, cnt_array)\n                n_res = int((cnt_array == 0).sum())\n                current_D = calc_D_val(n_res, logm, logboost)\n\n        elif action == \'CRISPR_cleave\':\n            active = list(congr_dict.keys())\n            if len(active) > 5:\n                sampled = random.sample(active, min(15, len(active)))\n                scores = []\n                for r in sampled:\n                    a = congr_dict[r]\n                    unique_cov = np.sum((targets[cnt_array == 1] % r) == a)\n                    score = unique_cov / math.log(r)\n                    scores.append((score, r, a))\n                scores.sort()\n                \n                n_drop = random.randint(1, 3)\n                to_drop = scores[:n_drop]\n                \n                cnt_test = cnt_array.copy()\n                logm_test = logm\n                logboost_test = logboost\n                \n                for _, r, a in to_drop:\n                    cnt_test[targets % r == a] -= 1\n                    logm_test -= math.log(r)\n                    logboost_test -= math.log(r / (r - 1))\n                \n                new_n_res = int((cnt_test == 0).sum())\n                new_D = calc_D_val(new_n_res, logm_test, logboost_test)\n                \n                if new_D < current_D or random.random() < math.exp(-(new_D - current_D) / temp):\n                    cnt_array = cnt_test\n                    for _, r, a in to_drop:\n                        del congr_dict[r]\n                    n_res, current_D = new_n_res, new_D\n                    logm, logboost = logm_test, logboost_test\n\n        elif action == \'HDR_splice\':\n            n_splice = random.randint(1, 3)\n            sampled_cands = [r for r in random.sample(cand_mods, min(40, len(cand_mods))) if r not in congr_dict][:15]\n            if sampled_cands:\n                cnt_test = cnt_array.copy()\n                logm_test = logm\n                logboost_test = logboost\n                \n                to_add = []\n                for _ in range(n_splice):\n                    best_cand = None\n                    best_a = None\n                    best_cov = -1\n                    uncovered = targets[cnt_test == 0]\n                    if len(uncovered) == 0:\n                        break\n                    \n                    for r in sampled_cands:\n                        if r in [x[0] for x in to_add]:\n                            continue\n                        counts = np.bincount(uncovered % r, minlength=r)\n                        a = int(np.argmax(counts))\n                        cov = counts[a]\n                        score = cov / math.log(r)\n                        if score > best_cov:\n                            best_cov = score\n                            best_cand = r\n                            best_a = a\n                            \n                    if best_cand is not None:\n                        to_add.append((best_cand, best_a))\n                        cnt_test[targets % best_cand == best_a] += 1\n                        logm_test += math.log(best_cand)\n                        logboost_test += math.log(best_cand / (best_cand - 1))\n                \n                if to_add:\n                    new_n_res = int((cnt_test == 0).sum())\n                    new_D = calc_D_val(new_n_res, logm_test, logboost_test)\n                    \n                    if new_D < current_D or random.random() < math.exp(-(new_D - current_D) / temp):\n                        cnt_array = cnt_test\n                        for r, a in to_add:\n                            congr_dict[r] = a\n                        n_res, current_D = new_n_res, new_D\n                        logm, logboost = logm_test, logboost_test\n\n        elif action == \'transposon_leap\':\n            active = list(congr_dict.keys())\n            sampled_cands = [r for r in random.sample(cand_mods, min(40, len(cand_mods))) if r not in congr_dict][:15]\n            if active and sampled_cands:\n                r_drop = random.choice(active)\n                a_drop = congr_dict[r_drop]\n                \n                cnt_test = cnt_array.copy()\n                cnt_test[targets % r_drop == a_drop] -= 1\n                logm_test = logm - math.log(r_drop)\n                logboost_test = logboost - math.log(r_drop / (r_drop - 1))\n                \n                uncovered = targets[cnt_test == 0]\n                \n                best_cand = None\n                best_a = None\n                best_D = float(\'inf\')\n                best_n_res = 0\n                \n                for r_add in sampled_cands:\n                    if len(uncovered) > 0:\n                        counts = np.bincount(uncovered % r_add, minlength=r_add)\n                        a_add = int(np.argmax(counts))\n                        cov = counts[a_add]\n                    else:\n                        a_add = 0\n                        cov = 0\n                        \n                    new_n_res = len(uncovered) - cov\n                    new_logm = logm_test + math.log(r_add)\n                    new_logboost = logboost_test + math.log(r_add / (r_add - 1))\n                    \n                    D = calc_D_val(new_n_res, new_logm, new_logboost)\n                    if D < best_D:\n                        best_D = D\n                        best_cand = r_add\n                        best_a = a_add\n                        best_n_res = new_n_res\n                \n                if best_D < current_D or random.random() < math.exp(-(best_D - current_D) / temp):\n                    del congr_dict[r_drop]\n                    congr_dict[best_cand] = best_a\n                    cnt_test[targets % best_cand == best_a] += 1\n                    cnt_array = cnt_test\n                    n_res, current_D = best_n_res, best_D\n                    logm = logm_test + math.log(best_cand)\n                    logboost = logboost_test + math.log(best_cand / (best_cand - 1))\n\n    # Final cleanup to ensure absolute optimality of residues\n    final_keys = list(congr_dict.keys())\n    random.shuffle(final_keys)\n    optimize_subset(final_keys, congr_dict, cnt_array)\n    return congr_dict\n# EVOLVE-BLOCK-END\n\ndef evaluate(eval_inputs: Mapping[str, Any]) -> dict[str, float]:\n    """Run evaluation on the optimized step."""\n    import sympy\n    import numpy as np\n    Q = 100003\n    targets = np.array(list(sympy.primerange(3, Q)), dtype=np.int64)\n    \n    # Warm-start from the 195-digit record cover instead of starting empty\n    congr_dict = {int(r): int(a) for r, a in eval_inputs["warm_start_cover"]}\n    \n    cand_mods = [int(r) for r in sympy.primerange(3, 8000)]\n    cnt_array = np.zeros(len(targets), dtype=np.int16)\n    \n    # Pre-populate counts\n    for r, a in congr_dict.items():\n        cnt_array += (targets % r) == a\n        \n    for it in range(10):\n        t_temp = 0.8 * (0.02 / 0.8) ** (it / 10)\n        # Recalculate cnt_array based on congr_dict\n        cnt_array = np.zeros(len(targets), dtype=np.int16)\n        logm = math.log(2)\n        logboost = math.log(2.0)\n        for r, a in congr_dict.items():\n            cnt_array += (targets % r) == a\n            logm += math.log(r)\n            logboost += math.log(r / (r - 1))\n            \n        congr_dict = optimize_cover_step(congr_dict, cand_mods, targets, cnt_array, logm, logboost, t_temp)\n        \n    # Recalculate final metrics\n    cnt_array = np.zeros(len(targets), dtype=np.int16)\n    logm = math.log(2)\n    logboost = math.log(2.0)\n    for r, a in congr_dict.items()