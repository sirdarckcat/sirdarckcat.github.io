m.randint(0, r_in - 1)\n            if a_new != a_old:\n                congr_dict[r_in] = a_new\n        elif kind < 0.7 and r_in is not None:\n            del congr_dict[r_in]\n        else:\n            r_out = random.choice(cand_mods)\n            if r_out not in congr_dict:\n                a_new = random.randint(0, r_out - 1)\n                congr_dict[r_out] = a_new\n        return congr_dict\n\n    n_res_current = int(np.sum(cnt_array == 0))\n    \n    def get_score(n_res, lm, lb):\n        import math\n        boost = math.exp(lb)\n        md = lm / 2.302585092994046\n        ub = n_res * boost\n        LN10 = 2.302585092994046\n        D = (md + math.sqrt(max(0.0, md**2 + 4 * ub / (LN10 * LN10)))) / 2\n        E_act = ub / (D * LN10) if D > 0 else 0.0\n        pen = 1000.0 * (max(0.0, E_act - 17.5))**2\n        return D + pen\n\n    for _inner_step in range(400):\n        current_score = get_score(n_res_current, logm, logboost)\n        \n        # Dynamic action probabilities based on temperature and current E\n        inner_t = t_temp * (0.1 ** (_inner_step / 400))\n        factor = np.clip(inner_t, 0.0, 1.0)\n        \n        boost_curr = math.exp(logboost)\n        md_curr = logm / 2.302585092994046\n        ub_curr = n_res_current * boost_curr\n        LN10 = 2.302585092994046\n        D_curr = (md_curr + math.sqrt(max(0.0, md_curr**2 + 4 * ub_curr / (LN10 * LN10)))) / 2\n        E_curr = ub_curr / (D_curr * LN10) if D_curr > 0 else 0.0\n        \n        if E_curr < 17.0:\n            p_drop = 0.60\n            p_opt = 0.30\n            p_add = 0.10\n        else:\n            p_drop = 0.10 + 0.10 * factor\n            p_opt = 0.50 - 0.20 * factor\n            p_add = 0.40 + 0.10 * factor\n\n        total_p = p_opt + p_add + p_drop\n        p_opt /= total_p\n        p_add /= total_p\n        p_drop /= total_p\n    \n        kind = random.random()\n        if not congr_dict:\n            action = \'add\'\n        else:\n            cand_pool = [m for m in cand_mods if m not in congr_dict]\n            if not cand_pool:\n                p_opt_cond = p_opt / (p_opt + p_drop)\n                action = \'optimize\' if kind < p_opt_cond else \'drop\'\n            else:\n                if kind < p_add:\n                    action = \'add\'\n                elif kind < p_add + p_opt:\n                    action = \'optimize\'\n                else:\n                    action = \'drop\'\n    \n        if action == \'add\':\n            if cand_pool:\n                sample_size = min(200, len(cand_pool))\n                sampled_cands = random.sample(cand_pool, sample_size)\n                \n                mask_zero = (cnt_array == 0)\n                targets_zero = targets[mask_zero]\n                # Tensor-inspired cross-coverage reward: 1.0 / cnt to build redundancy for dropping\n                safe_cnt = np.maximum(cnt_array, 1)\n                weights_bg = np.where(mask_zero, 0.0, 1.0 / safe_cnt)\n                \n                fitnesses = []\n                cands_data = []\n                for r in sampled_cands:\n                    rem = targets % r\n                    rem_zero = targets_zero % r\n                    \n                    counts_0 = np.bincount(rem_zero, minlength=r)\n                    counts_bg = np.bincount(rem, weights=weights_bg, minlength=r)\n                    \n                    max_cov = np.max(counts_0)\n                    best_as = np.where(counts_0 == max_cov)[0]\n                    if len(best_as) > 1:\n                        a = int(best_as[np.argmax(counts_bg[best_as])])\n                    else:\n                        a = int(best_as[0])\n                    \n                    cov_actual_0 = max_cov\n                    n_res_pseudo = n_res_current - cov_actual_0\n                    lm_new = logm + math.log(r)\n                    lb_new = logboost + math.log(r / (r - 1))\n                    \n                    score = get_score(n_res_pseudo, lm_new, lb_new)\n                    fitnesses.append(-score + 1e-4 * counts_bg[a])\n                    cands_data.append((r, a, score))\n                \n                fitnesses = np.array(fitnesses)\n                fit_min, fit_max = np.min(fitnesses), np.max(fitnesses)\n                if fit_max > fit_min:\n                    norm_fit = (fitnesses - fit_min) / (fit_max - fit_min)\n                else:\n                    norm_fit = np.ones_like(fitnesses)\n                    \n                temp = max(inner_t, 1e-5)\n                scaled = norm_fit / temp\n                scaled = scaled - np.max(scaled)\n                probs = np.exp(scaled)\n                probs /= np.sum(probs)\n                \n                idx = np.random.choice(len(sampled_cands), p=probs)\n                best_cand, best_a, best_score = cands_data[idx]\n                \n                if best_score > current_score and random.random() > math.exp((current_score - best_score) / temp):\n                    continue  # reject\n                    \n                congr_dict[best_cand] = int(best_a)\n                cnt_array += (targets % best_cand == best_a)\n                n_res_current = int(np.sum(cnt_array == 0))\n                logm += math.log(best_cand)\n                logboost += math.log(best_cand / (best_cand - 1))\n                current_score = best_score\n    \n        elif action == \'optimize\':\n            mods_in = list(congr_dict.keys())\n            if mods_in:\n                sample_size = min(50, len(mods_in))\n                sampled_rs = random.sample(mods_in, sample_size)\n                \n                fitnesses = []\n                cands_data = []\n                \n                for r in sampled_rs:\n                    a_old = congr_dict[r]\n                    rem = targets % r\n                    is_covered_by_r = (rem == a_old)\n                    cnt_bg = cnt_array - is_covered_by_r\n                    \n                    mask_