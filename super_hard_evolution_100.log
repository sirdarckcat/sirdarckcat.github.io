array of coverage counts\n        logm: current log of modulus M\n        logboost: current log of boost factor\n        t_temp: current temperature\n\n    Returns:\n        Updated congr_dict\n    """\n    import numpy as np\n    import random\n    import math\n\n    if len(targets) == 0:\n        # Safety fallback\n        kind = random.random()\n        r_in = random.choice(list(congr_dict)) if congr_dict else None\n        if kind < 0.5 and r_in is not None:\n            a_old = congr_dict[r_in]\n            a_new = random.randint(0, r_in - 1)\n            if a_new != a_old:\n                congr_dict[r_in] = a_new\n        elif kind < 0.7 and r_in is not None:\n            del congr_dict[r_in]\n        else:\n            r_out = random.choice(cand_mods)\n            if r_out not in congr_dict:\n                a_new = random.randint(0, r_out - 1)\n                congr_dict[r_out] = a_new\n        return congr_dict\n\n    def calc_score(m_digits, ub):\n        LN10 = 2.302585092994046\n        D = 0.5 * (m_digits + math.sqrt(max(0.0, m_digits ** 2 + 4 * ub / (LN10 * LN10))))\n        E = ub / (D * LN10) if D > 0 else 0.0\n        penalty = 0.0\n        if E > 17.5:\n            penalty = 100.0 * (E - 17.5) ** 2\n        return D + penalty\n\n    # We run multiple internal steps per external call to accelerate optimization\n    # Crazy idea: Enforce Metropolis-Hastings acceptance, add a swap move to walk the boundary, and vastly increase steps!\n    num_steps = 1000\n    cnt_array_local = cnt_array.copy()\n    logm_local = logm\n    logboost_local = logboost\n\n    # Dynamic action probabilities based on temperature\n    factor = np.clip(t_temp, 0.0, 1.0)\n    p_opt = 0.40 - 0.20 * factor\n    p_add = 0.15 + 0.10 * factor\n    p_drop = 0.15 + 0.10 * factor\n    p_swap = 0.30\n    total_p = p_opt + p_add + p_drop + p_swap\n    p_opt /= total_p\n    p_add /= total_p\n    p_drop /= total_p\n    p_swap /= total_p\n\n    for _ in range(num_steps):\n        if not congr_dict:\n            action = \'add\'\n        else:\n            cand_pool = [m for m in cand_mods if m not in congr_dict]\n            if not cand_pool:\n                p_opt_cond = p_opt / (p_opt + p_drop)\n                action = \'optimize\' if random.random() < p_opt_cond else \'drop\'\n            else:\n                kind = random.random()\n                if kind < p_add:\n                    action = \'add\'\n                elif kind < p_add + p_swap:\n                    action = \'swap\'\n                elif kind < p_add + p_swap + p_opt:\n                    action = \'optimize\'\n                else:\n                    action = \'drop\'\n\n        if action == \'add\':\n            cand_pool = [m for m in cand_mods if m not in congr_dict]\n            if cand_pool:\n                sample_size = min(100, len(cand_pool))\n                sampled_cands = random.sample(cand_pool, sample_size)\n                \n                n_res_curr = np.sum(cnt_array_local == 0)\n                boost_curr = math.exp(logboost_local)\n                m_digits_curr = logm_local / math.log(10)\n                score_curr = calc_score(m_digits_curr, n_res_curr * boost_curr)\n                \n                cand_scores = []\n                cand_choices = []\n                \n                uncovered_targets = targets[cnt_array_local == 0]\n                for r in sampled_cands:\n                    if len(uncovered_targets) > 0:\n                        counts = np.bincount(uncovered_targets % r, minlength=r)\n                        a = int(np.argmax(counts))\n                        cov_count = counts[a]\n                    else:\n                        a = 0\n                        cov_count = 0\n                    \n                    m_digits_new = (logm_local + math.log(r)) / math.log(10)\n                    boost_new = boost_curr * r / (r - 1)\n                    n_res_new = max(0, n_res_curr - cov_count)\n                    ub_new = n_res_new * boost_new\n                    score_new = calc_score(m_digits_new, ub_new)\n                    \n                    benefit = score_curr - score_new\n                    cand_scores.append(benefit)\n                    cand_choices.append((r, a))\n                    \n                cand_scores = np.array(cand_scores)\n                temp = max(t_temp, 1e-4)\n                scaled = cand_scores / temp\n                scaled = scaled - np.max(scaled)\n                probs = np.exp(scaled)\n                probs /= np.sum(probs)\n                \n                idx = np.random.choice(len(cand_choices), p=probs)\n                best_cand, best_a = cand_choices[idx]\n                best_benefit = cand_scores[idx]\n                \n                if best_benefit > 0 or random.random() < math.exp(max(-50.0, best_benefit / temp)):\n                    congr_dict[best_cand] = int(best_a)\n                    cnt_array_local += (targets % best_cand == best_a)\n                    logm_local += math.log(best_cand)\n                    logboost_local += math.log(best_cand / (best_cand - 1))\n\n        elif action == \'swap\':\n            mods_in = list(congr_dict.keys())\n            cand_pool = [m for m in cand_mods if m not in congr_dict]\n            if mods_in and cand_pool:\n                r_drop = random.choice(mods_in)\n                a_drop = congr_dict[r_drop]\n                \n                boost_orig = math.exp(logboost_local)\n                m_digits_orig = logm_local / math.log(10)\n                score_curr = calc_score(m_digits_orig, np.sum(cnt_array_local == 0) * boost_orig)\n                \n                cnt_array_local -= (targets % r_drop == a_drop)\n                logm_temp = logm_local - math.log(r_drop)\n                logboost_temp = logboost_local - math.log(r_drop / (r_drop - 1))\n                \n                sample_size = min(50, len(cand_pool))\n                sampled_cands = random.sample(cand_pool, sample_size)\n                \n                n_res_temp = np.sum(cnt_array_local == 0)\n                boost_curr = math.exp(logboost_temp)\n                \n                cand_scores = []\n                cand_choices = []\n                \n                uncovered_targets = targets[cnt_array_local == 0]\n                for r in sampled_cands:\n                    if len(uncovered_targets) > 0:\n                        counts = np.bincount(uncovered_targets % r, minlength=r)\n                        a = int(np.argmax(counts))\n                        cov_count = counts[a]\n                    else:\n                        a = 0\n                        cov_count = 0\n                    \n                    m_digits_new = (logm_temp + math.log(r)) / math.log(10)\n                    boost_new = boost_curr * r / (r - 1)\n                    n_res_new = max(0, n_res_temp - cov_count)\n                    ub_new = n_res_new * boost_new\n                    score_new = calc_score(m_digits_new, ub_new)\n                    \n                    cand_scores.append(score_curr - score_new)\n                    cand_choices.append((r, a))\n                    \n                cand_scores = np.array(cand_scores)\n                temp = max(t_temp, 1e-4)\n                scaled = cand_scores / temp\n                scaled = scaled - np.max(scaled)\n                probs = np.exp(scaled)\n                probs /= np.sum(probs)\n                \n                idx = np.random.choice(len(cand_choices), p=probs)\n                best_cand, best_a = cand_choices[idx]\n                best_benefit = cand_scores[idx]\n                \n                if best_benefit > 0 or random.random() < math.exp(max(-50.0, best_benefit / temp)):\n                    del congr_dict[r_drop]\n                    congr_dict[best_cand] = int(best_a)\n                    cnt_array_local += (targets % best_cand == best_a)\n                    logm_local = logm_temp + math.log(best_cand)\n                    logboost_local = logboost_temp + math.log(best_cand / (best_cand - 1))\n                else:\n                    cnt_array_local += (targets % r_drop == a_drop)\n\n        elif action == \'optimize\':\n            mods_in = list(congr_dict.keys())\n            if mods_in:\n                r = random.choice(mods_in)\n                a_old = congr_dict[r]\n                \n                is_covered_by_r = (targets % r) == a_old\n                cnt_bg = cnt_array_local - is_covered_by_r\n                n_res_bg = np.sum(cnt_bg == 0)\n                \n                boost_curr = math.exp(logboost_local)\n                m_digits_curr = logm_local / math.log(10)\n                score_curr = calc_score(m_digits_curr, np.sum(cnt_array_local == 0) * boost_curr)\n                \n                bg_uncovered_targets = targets[cnt_bg == 0]\n                if len(bg_uncovered_targets) > 0:\n                    counts = np.bincount(bg_uncovered_targets % r, minlength=r)\n                else:\n                    counts = np.zeros(r, dtype=int)\n                \n                scores_new = []\n                for a in range(r):\n                    n_res_new = max(0, n_res_bg - counts[a])\n                    ub_new = n_res_new * boost_curr\n                    scores_new.append(calc_score(m_digits_curr, ub_new))\n                    \n                scores_new = np.array(scores_new)\n                benefits = score_curr - scores_new\n                \n                temp = max(t_temp, 1e-4)\n                scaled = benefits / temp\n                scaled = scaled - np.max(scaled)\n                probs = np.exp(scaled)\n                probs /= np.sum(probs)\n                \n                a_new = np.random.choice(r, p=probs)\n                best_benefit = benefits[a_new]\n                \n                if best_benefit > 0 or random.random() < math.exp(max(-50.0, best_benefit / temp)):\n                    congr_dict[r] = int(a_new)\n                    cnt_array_local -= is_covered_by_r\n                    cnt_array_local += (targets % r == a_new)\n\n        elif action == \'drop\':\n            mods_in = list(congr_dict.keys())\n            if mods_in:\n                boost_curr = math.exp(logboost_local)\n                m_digits_curr = logm_local / math.log(10)\n                score_curr = calc_score(m_digits_curr, np.sum(cnt_array_local == 0) * boost_curr)\n                \n                benefits = []\n                ones_mask = (cnt_array_local == 1)\n                targets_ones = targets[ones_mask]\n                base_n_res = int(np.sum(cnt_array_local == 0))\n                \n                for r in mods_in:\n                    a = congr_dict[r]\n                    if len(targets_ones) > 0:\n                        n_res_new = base_n_res + int(np.sum((targets_ones % r) == a))\n                    else:\n                        n_res_new = base_n_res\n                    \n                    m_digits_new = (logm_local - math.log(r)) / math.log(10)\n                    boost_new = boost_curr * (r - 1) / r\n                    ub_new = n_res_new * boost_new\n                    score_new = calc_score(m_digits_new, ub_new)\n                    \n                    benefits.append(score_curr - score_new)\n                    \n                benefits = np.array(benefits)\n                temp = max(t_temp, 1e-4)\n                scaled = benefits / temp\n                scaled = scaled - np.max(scaled)\n                probs = np.exp(scaled)\n                probs /= np.sum(probs)\n                \n                idx = np.random.choice(len(mods_in), p=probs)\n                r_drop = mods_in[idx]\n                a_drop = congr_dict[r_drop]\n                best_benefit = benefits[idx]\n                \n                if best_benefit > 0 or random.random() < math.exp(max(-50.0, best_benefit / temp)):\n                    del congr_dict[r_drop]\n                    cnt_array_local -= (targets % r_drop == a_drop)\n                    logm_local -= math.log(r_drop)\n                    logboost_local -= math.log(r_drop / (r_drop - 1))\n\n    return congr_dict\n# EVOLVE-BLOCK-END\n\ndef evaluate(eval_inputs: Mapping[str, Any]) -> dict[str, float]:\n    """Run evaluation on the optimized step."""\n    import sympy\n    import numpy as np\n    Q = 100003\n    targets = np.array(list(sympy.primerange(3, Q)), dtype=np.int64)\n    \n    # Warm-start from the 195-digit record cover instead of starting empty\n    congr_dict = {int(r): int(a) for r, a in eval_inputs["warm_start_cover"]}\n    \n    cand_mods = [int(r) for r in sympy.primerange(3, 8000)]\n    cnt_array = np.zeros(len(targets), dtype=np.int16)\n    \n    # Pre-populate counts\n    for r, a in congr_dict.items():\n        cnt_array += (targets % r) == a\n        \n    for it in range(10):\n        t_temp = 0.8 * (0.02 / 0.8) ** (it / 10)\n        # Recalculate cnt_array based on congr_dict\n        cnt_array = np.zeros(len(targets), dtype=np.int16)\n        logm = math.log(2)\n        logboost = math.log(2.0)\n        for r, a in congr_dict.items():\n            cnt_array += (targets % r) == a\n            logm += math.log(r)\n            logboost += math.log(r / (r - 1))\n            \n        congr_dict = optimize_cover_step(congr_dict, cand_mods, targets, cnt_array, logm, logboost, t_temp)\n        \n    # Recalculate final metrics\n    cnt_array = np.zeros(len(targets), dtype=np.int16)\n    logm = math.log(2)\n    logboost = math.log(2.0)\n    for r, a in congr_dict.items():\n        cnt_array += (targets % r) == a\n        logm += math.log(r)\n        logboost += math.log(r / (r - 1))\n        \n    n_res = int((cnt_array == 0).sum())\n    boost = math.exp(logboost)\n    m_digits = logm / math.log(10)\n    \n    ub = n_res * boost\n    LN10 = math.log(10)\n    D = (m_digits + math.sqrt(m_digits ** 2 + 4 * ub / (LN10 * LN10))) / 2\n    \n    # Constrain E <= 17.5 via Lagrangian penalty to prevent reward hacking\n    E_limit = 17.5\n    E_actual = ub / (D * LN10) if D > 0 else 0.0\n    lagrangian_penalty = 0.0\n    if E_actual > E_limit:\n        lagrangian_penalty = 100.0 * (E_actual - E_limit) ** 2\n        \n    score_headline = -float(D + lagrangian_penalty)\n    \n    # Expose E, |U|, digits(M) as negated secondary metrics for joint optimization visibility\n    return {\n        "neg_est_digits": score_headline,\n        "neg_E": -float(E_actual),\n        "neg_residual_count": -float(n_res),\n        "neg_m_digits": -float(m_digits)\n    }\n'}]}, 'evaluation': {'scores': {'scores': [{'metric': 'neg_est_digits', 'score': -192.62175}, {'metric': 'neg_E', 'score': -17.514406}, {'metric': 'neg_residual_count', 'score': -709}, {'metric': 'neg_m_digits', 'score': -184.99458}]}, 'insights': {'insights': [{'label': 'Evaluation Metrics', 'text': 'Estimated Digits: 192.6218 (constrained), E: 17.5144, |U|: 709, digits(M): 184.99'}]}}, 'parentPrograms': ['projects/799795028847/locations/global/collections/default_collection/engines/goldbach_1784979910032/sessions/7658735534374771723/alphaEvolveExperiments/9582896010645531772/alphaEvolvePrograms/11597998738524453598'], 'state': 'COMPLETED'}, {'name': 'projects/799795028847/locations/global/collections/default_collection/engines/goldbach_1784979910032/sessions/7658735534374771723/alphaEvolveExperiments/9582896010645531772/alphaEvolvePrograms/7662895210918132141', 'createTime': '2026-07-26T05:52:51.072186Z', 'content': {'files': [{'path': 'program.py', 'content': '# Copyright 2026 Google LLC\nfrom typing import Any, Mapping\nimport math\nimport random\nimport numpy as np\n\n# EVOLVE-BLOCK-START\ndef optimize_cover_step(congr_dict, cand_mods, targets, cnt_array, logm, logboost, t_temp):\n    """Optimize congruence cover using a powerful local search with Simulated Annealing style logic."""\n    import numpy as np\n    import random\n    import math\n\n    if len(targets) == 0:\n        return congr_dict\n\n    # Copy to avoid side effects during search\n    cnt_array = cnt_array.copy()\n    n_res = int((cnt_array == 0).sum())\n\n    def calc_D_val(n_res_val, logm_val, logboost_val):\n        boost = math.exp(logboost_val)\n        m_digits = logm_val / math.log(10)\n        ub = n_res_val * boost\n        LN10 = math.log(10)\n        inside_sqrt = m_digits ** 2 + 4 * ub / (LN10 * LN10)\n        D = (m_digits + math.sqrt(max(0.0, inside_sqrt))) / 2\n        \n        E_limit = 17.5\n        E_actual = ub / (D * LN10) if D > 0 else 0.0\n        lagrangian_penalty = 0.0\n        if E_actual > E_limit:\n            lagrangian_penalty = 1000.0 * (E_actual - E_limit) ** 2\n        return D + lagrangian_penalty\n\n    def optimize_all(congr, cnt):\n        keys = list(congr.keys())\n        random.shuffle(keys)\n        for r in keys:\n            a_old = congr[r]\n            rem = targets % r\n            # Remove contribution\n            cnt[rem == a_old] -= 1\n            # Find best a\n            counts = np.bincount(rem, weights=(cnt == 0), minlength=r)\n            a_new = int(np.argmax(counts))\n            # Add contribution back\n            cnt[rem == a_new] += 1\n            congr[r] = a_new\n\n    # Initial residue optimization\n    optimize_all(congr_dict, cnt_array)\n    n_res = int((cnt_array == 0).sum())\n    current_D = calc_D_val(n_res, logm, logboost)\n\n    temp = max(t_temp, 1e-6)\n    N_STEPS = 600\n\n    for step in range(N_STEPS):\n        # Periodically optimize all to stay on the local optimum manifold\n        if step > 0 and step % 100 == 0:\n            optimize_all(congr_dict, cnt_array)\n            n_res = int((cnt_array == 0).sum())\n            current_D = calc_D_val(n_res, logm, logboost)\n\n        action = random.choices([\'add\', \'drop\', \'swap\', \'optimize\'], weights=[0.25, 0.25, 0.35, 0.15], k=1)[0]\n\n        if action == \'add\':\n            cand_pool = [m for m in cand_mods if m not in congr_dict]\n            if cand_pool:\n                sampled = random.sample(cand_pool, min(60, len(cand_pool)))\n                best_r = None\n                best_a = None\n                best_new_D = float(\'inf\')\n                best_new_n_res = n_res\n                \n                uncovered = (cnt_array == 0)\n                for r in sampled:\n                    rem = targets % r\n                    counts = np.bincount(rem, weights=uncovered, minlength=r)\n                    a = int(np.argmax(counts))\n                    \n                    added_cov = counts[a]\n                    new_n_res = n_res - added_cov\n                    new_logm = logm + math.log(r)\n                    new_logboost = logboost + math.log(r / (r - 1))\n                    new_D = calc_D_val(new_n_res, new_logm, new_logboost)\n                    if new_D < best_new_D:\n                        best_new_D = new_D\n                        best_r = r\n                        best_a = a\n                        best_new_n_res = new_n_res\n                        \n                if best_r is not None:\n                    delta = best_new_D - current_D\n                    if delta < 0 or random.random() < math.exp(-delta / temp):\n                        congr_dict[best_r] = best_a\n                        cnt_array[targets % best_r == best_a] += 1\n                        n_res = best_new_n_res\n                        logm += math.log(best_r)\n                        logboost += math.log(best_r / (best_r - 1))\n                        current_D = best_new_D\n\n        elif action == \'drop\':\n            active = list(congr_dict.keys())\n            if active:\n                sampled = random.sample(active, min(60, len(active)))\n                best_r = None\n                best_new_D = float(\'inf\')\n                best_new_n_res = n_res\n                \n                singly_covered = (cnt_array == 1)\n                for r in sampled:\n                    a = congr_dict[r]\n                    rem = targets % r\n                    lost_cov = np.sum(singly_covered & (rem == a))\n                    new_n_res = n_res + lost_cov\n                    new_logm = logm - math.log(r)\n                    new_logboost = logboost - math.log(r / (r - 1))\n                    new_D = calc_D_val(new_n_res, new_logm, new_logboost)\n                    if new_D < best_new_D:\n                        best_new_D = new_D\n                        best_r = r\n                        best_new_n_res = new_n_res\n                        \n                if best_r is not None:\n                    delta = best_new_D - current_D\n                    if delta < 0 or random.random() < math.exp(-delta / temp):\n                        r_drop = best_r\n                        a_drop = congr_dict[r_drop]\n                        cnt_array[targets % r_drop == a_drop] -= 1\n                        del congr_dict[r_drop]\n                        n_res = best_new_n_res\n                        logm -= math.log(r_drop)\n                        logboost -= math.log(r_drop / (r_drop - 1))\n                        current_D = best_new_D\n\n        elif action == \'swap\':\n            active = list(congr_dict.keys())\n            cand_pool = [m for m in cand_mods if m not in congr_dict]\n            if active and cand_pool:\n                r_drop = random.choice(active)\n                a_drop = congr_dict[r_drop]\n                \n                rem_drop = targets % r_drop\n                cnt_array[rem_drop == a_drop] -= 1\n                uncovered = (cnt_array == 0)\n                \n                sampled_add = random.sample(cand_pool, min(60, len(cand_pool)))\n                best_add_r = None\n                best_add_a = None\n                best_new_D = float(\'inf\')\n                best_new_n_res = n_res\n                \n                n_res_after_drop = int(uncovered.sum())\n                logm_after_drop = logm - math.log(r_drop)\n                logboost_after_drop = logboost - math.log(r_drop / (r_drop - 1))\n                \n                for r in sampled_add:\n                    rem_add = targets % r\n                    counts = np.bincount(rem_add, weights=uncovered, minlength=r)\n                    a = int(np.argmax(counts))\n                    added_cov = counts[a]\n                    \n                    new_n_res = n_res_after_drop - added_cov\n                    new_logm = logm_after_drop + math.log(r)\n                    new_logboost = logboost_after_drop + math.log(r / (r - 1))\n                    \n                    new_D = calc_D_val(new_n_res, new_logm, new_logboost)\n                    if new_D < best_new_D:\n                        best_new_D = new_D\n                        best_add_r = r\n                        best_add_a = a\n                        best_new_n_res = new_n_res\n                        \n                if best_add_r is not None:\n                    delta = best_new_D - current_D\n                    if delta < 0 or random.random() < math.exp(-delta / temp):\n                        del congr_dict[r_drop]\n                        congr_dict[best_add_r] = best_add_a\n                        cnt_array[targets % best_add_r == best_add_a] += 1\n                        n_res = best_new_n_res\n                        logm = logm_after_drop + math.log(best_add_r)\n                        logboost = logboost_after_drop + math.log(best_add_r / (best_add_r - 1))\n                        current_D = best_new_D\n                    else:\n                        cnt_array[rem_drop == a_drop] += 1\n                else:\n                    cnt_array[rem_drop == a_drop] += 1\n\n        elif action == \'optimize\':\n            active = list(congr_dict.keys())\n            if active:\n                sampled = random.sample(active, min(5, len(active)))\n                for r in sampled:\n                    a_old = congr_dict[r]\n                    rem = targets % r\n                    cnt_array[rem == a_old] -= 1\n                    \n                    counts = np.bincount(rem, weights=(cnt_array == 0), minlength=r)\n                    a_new = int(np.argmax(counts))\n                    \n                    cnt_array[rem == a_new] += 1\n                    congr_dict[r] = a_new\n                    \n                n_res = int((cnt_array == 0).sum())\n                current_D = calc_D_val(n_res, logm, logboost)\n\n    # Final cleanup to ensure absolute optimality of residues\n    optimize_all(congr_dict, cnt_array)\n    return congr_dict\n# EVOLVE-BLOCK-END\n\ndef evaluate(eval_inputs: Mapping[str, Any]) -> dict[str, float]:\n    """Run evaluation on the optimized step."""\n    import sympy\n    import numpy as np\n    Q = 100003\n    targets = np.array(list(sympy.primerange(3, Q)), dtype=np.int64)\n    \n    # Warm-start from the 195-digit record cover instead of starting empty\n    congr_dict = {int(r): int(a) for r, a in eval_inputs["warm_start_cover"]}\n    \n    cand_mods = [int(r) for r in sympy.primerange(3, 8000)]\n    cnt_array = np.zeros(len(targets), dtype=np.int16)\n    \n    # Pre-populate counts\n    for r, a in congr_dict.items():\n        cnt_array += (targets % r) == a\n        \n    for it in range(10):\n        t_temp = 0.8 * (0.02 / 0.8) ** (it / 10)\n        # Recalculate cnt_array based on congr_dict\n        cnt_array = np.zeros(len(targets), dtype=np.int16)\n        logm = math.log(2)\n        logboost = math.log(2.0)\n        for r, a in congr_dict.items():\n            cnt_array += (targets % r) == a\n            logm += math.log(r)\n            logboost += math.log(r / (r - 1))\n            \n        congr_dict = optimize_cover_step(congr_dict, cand_mods, targets, cnt_array, logm, logboost, t_temp)\n        \n    # Recalculate final metrics\n    cnt_array = np.zeros(len(targets), dtype=np.int16)\n    logm = math.log(2)\n    logboost = math.log(2.0)\n    for r, a in congr_dict.items():\n        cnt_array += (targets % r) == a\n        logm += math.log(r)\n        logboost += math.log(r / (r - 1))\n        \n    n_res = int((cnt_array == 0).sum())\n    boost = math.exp(logboost)\n    m_digits = logm / math.log(10)\n    \n    ub = n_res * boost\n    LN10 = math.log(10)\n    D = (m_digits + math.sqrt(m_digits ** 2 + 4 * ub / (LN10 * LN10))) / 2\n    \n    # Constrain E <= 17.5 via Lagrangian penalty to prevent reward hacking\n    E_limit = 17.5\n    E_actual = ub / (D * LN10) if D > 0 else 0.0\n    lagrangian_penalty = 0.0\n    if E_actual > E_limit:\n        lagrangian_penalty = 100.0 * (E_actual - E_limit) ** 2\n        \n    score_headline = -float(D + lagrangian_penalty)\n    \n    # Expose E, |U|, digits(M) as negated secondary metrics for joint optimization visibility\n    return {\n        "neg_est_digits": score_headline,\n        "neg_E": -float(E_actual),\n        "neg_residual_count": -float(n_res),\n        "neg_m_digits": -float(m_digits)\n    }\n'}]}, 'evaluation': {'scores': {'scores': [{'metric': 'neg_est_digits', 'score': -192.6279}, {'metric': 'neg_E', 'score': -17.459888}, {'metric': 'neg_residual_count', 'score': -707}, {'metric': 'neg_m_digits', 'score': -185.04517}]}, 'insights': {'insights': [{'label': 'Evaluation Metrics', 'text': 'Estimated Digits: 192.6279 (constrained), E: 17.4599, |U|: 707, digits(M): 185.05'}]}}, 'parentPrograms': ['projects/799795028847/locations/global/collections/default_collection/engines/goldbach_1784979910032/sessions/7658735534374771723/alphaEvolveExperiments/9582896010645531772/alphaEvolvePrograms/7662895210918130125'], 'state': 'COMPLETED'}, {'name': 'projects/799795028847/locations/global/collections/default_collection/engines/goldbach_1784979910032/sessions/7658735534374771723/alphaEvolveExperiments/9582896010645531772/alphaEvolvePrograms/11597998738524452014', 'createTime': '2026-07-26T08:55:48.898743Z', 'content': {'files': [{'path': 'program.py', 'content': '# Copyright 2026 Google LLC\nfrom typing import Any, Mapping\nimport math\nimport random\nimport numpy as np\n\n# EVOLVE-BLOCK-START\ndef optimize_cover_step(congr_dict, cand_mods, targets, cnt_array, logm, logboost, t_temp):\n    """Optimize a single step of congruence cover using simulated annealing style logic.\n\n    Args:\n        congr_dict: Dictionary of r -> a\n        cand_mods: List of prime candidates\n        targets: np.array of target primes\n        cnt_array: np.array of coverage counts\n        logm: current log of modulus M\n        logboost: current log of boost factor\n        t_temp: current temperature\n\n    Returns:\n        Updated congr_dict\n    """\n    import math\n    import random\n    import numpy as np\n\n    if len(targets) == 0:\n        return congr_dict\n\n    # CRAZY IDEA: "The Multi-Verse Branching Search with Prime Trajectory Forecasting"\n    # We maintain a quantum superposition of possible universe states. When an action occurs,\n    # we don\'t just guess a replacement; we evaluate a massive wave of candidate replacements\n    # simultaneously. We select the absolute best replacement that minimizes the Lagrangian \n    # of estimated digits and Euler product exponent, ensuring we navigate the Pareto frontier \n    # with extreme precision. We also introduce a Gibbs Sweep to guarantee local phase optimality.\n\n    cnt = cnt_array.copy()\n\n    def calc_D_lagrangian(n_u, lm, lb):\n        boost = math.exp(lb)\n        m_dig = lm / math.log(10)\n        ub = n_u * boost\n        LN10 = math.log(10)\n        inside = m_dig ** 2 + 4 * ub / (LN10 * LN10)\n        D_val = (m_dig + math.sqrt(max(0.0, inside))) / 2\n        E_act = ub / (D_val * LN10) if D_val > 0 else 0\n        penalty = 1000.0 * max(0.0, E_act - 17.5)**2\n        return D_val + penalty\n\n    def gibbs_sweep(congr, active_cnt):\n        keys = list(congr.keys())\n        random.shuffle(keys)\n        for r in keys:\n            a_old = congr[r]\n            rem = targets % r\n            is_cov = (rem == a_old)\n            active_cnt[is_cov] -= 1\n            \n            uncovered = targets[active_cnt == 0]\n            if len(uncovered) > 0:\n                counts = np.bincount(uncovered % r, minlength=r)\n                a_new = int(np.argmax(counts))\n            else:\n                a_new = 0\n                \n            active_cnt[rem == a_new] += 1\n            congr[r] = a_new\n\n    # Ensure local phase optimality at start\n    gibbs_sweep(congr_dict, cnt)\n\n    n_res = int((cnt == 0).sum())\n    curr_D = calc_D_lagrangian(n_res, logm, logboost)\n\n    best_congr = congr_dict.copy()\n    best_D = curr_D\n\n    cand_pool = set(cand_mods) - set(congr_dict.keys())\n\n    STEPS = 500\n    temp = max(t_temp, 1e-6)\n\n    for step in range(STEPS):\n        action = random.random()\n\n        if action < 0.25 and cand_pool:\n            # Multi-Verse Branching ADD\n            sampled_cands = random.sample(list(cand_pool), min(100, len(cand_pool)))\n            uncovered = targets[cnt == 0]\n            n_u = len(uncovered)\n            \n            best_r = None\n            best_a = None\n            best_new_D = float(\'inf\')\n\n            for r in sampled_cands:\n                if n_u > 0:\n                    counts = np.bincount(uncovered % r, minlength=r)\n                    a = int(np.argmax(counts))\n                    cov = counts[a]\n                else:\n                    a = 0\n                    cov = 0\n\n                new_lm = logm + math.log(r)\n                new_lb = logboost + math.log(r / (r - 1))\n                new_D = calc_D_lagrangian(n_u - cov, new_lm, new_lb)\n\n                if new_D < best_new_D:\n                    best_new_D = new_D\n                    best_r = r\n                    best_a = a\n\n            if best_r is not None:\n                delta = best_new_D - curr_D\n                if delta < 0 or random.random() < math.exp(-delta / temp):\n                    congr_dict[best_r] = best_a\n                    