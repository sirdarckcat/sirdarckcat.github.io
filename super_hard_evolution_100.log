   cnt_array = np.array(cnt_array, dtype=np.int16)\n\n    # Cache targets % r to avoid doing modulo operations repeatedly\n    if not hasattr(optimize_cover_step, "mod_cache"):\n        optimize_cover_step.mod_cache = {}\n    cache = optimize_cover_step.mod_cache\n    for r in cand_mods:\n        if r not in cache:\n            cache[r] = targets % r\n\n    n_res_curr = np.sum(cnt_array == 0)\n    S_curr = compute_score(logm, logboost, n_res_curr)\n\n    for step in range(inner_steps):\n        t_curr = t_temp * (0.97 ** step)\n        temp = max(t_curr, 1e-6)\n        \n        mods_in = list(congr_dict.keys())\n        cand_pool = [m for m in cand_mods if m not in congr_dict]\n        \n        action_choice = random.random()\n        if not mods_in:\n            action = \'add\'\n        elif not cand_pool:\n            action = \'drop\'\n        else:\n            if action_choice < 0.25:\n                action = \'drop\'\n            elif action_choice < 0.50:\n                action = \'add\'\n            elif action_choice < 0.80:\n                action = \'swap\'\n            else:\n                action = \'optimize\'\n\n        uncovered_mask = (cnt_array == 0)\n        single_cover_mask = (cnt_array == 1)\n\n        if action == \'drop\':\n            sampled_mods = random.sample(mods_in, min(15, len(mods_in)))\n            best_score = -999999.0\n            best_r = None\n            \n            for r in sampled_mods:\n                a = congr_dict[r]\n                t_mod_r = cache[r]\n                uncovered_count = np.sum(single_cover_mask & (t_mod_r == a))\n                n_res_new = n_res_curr + uncovered_count\n                logm_new = logm - math.log(r)\n                logboost_new = logboost - math.log(r / (r - 1))\n                \n                score = compute_score(logm_new, logboost_new, n_res_new)\n                if score > best_score:\n                    best_score = score\n                    best_r = r\n            \n            if best_r is not None:\n                diff = best_score - S_curr\n                if diff >= 0 or random.random() < math.exp(diff / temp):\n                    a_drop = congr_dict[best_r]\n                    t_mod_r = cache[best_r]\n                    cnt_array -= (t_mod_r == a_drop)\n                    del congr_dict[best_r]\n                    logm -= math.log(best_r)\n                    logboost -= math.log(best_r / (best_r - 1))\n                    S_curr = best_score\n                    n_res_curr = np.sum(cnt_array == 0)\n\n        elif action == \'add\':\n            sampled_cands = random.sample(cand_pool, min(30, len(cand_pool)))\n            best_score = -999999.0\n            best_r = None\n            best_a = None\n            \n            for r in sampled_cands:\n                t_mod_r = cache[r]\n                uncovered_targets_mod = t_mod_r[uncovered_mask]\n                if len(uncovered_targets_mod) > 0:\n                    counts = np.bincount(uncovered_targets_mod, minlength=r)\n                    a = int(np.argmax(counts))\n                    cov_count = counts[a]\n                else:\n                    a = 0\n                    cov_count = 0\n                \n                n_res_new = n_res_curr - cov_count\n                logm_new = logm + math.log(r)\n                logboost_new = logboost + math.log(r / (r - 1))\n                \n                score = compute_score(logm_new, logboost_new, n_res_new)\n                if score > best_score:\n                    best_score = score\n                    best_r = r\n                    best_a = a\n                    \n            if best_r is not None:\n                diff = best_score - S_curr\n                if diff >= 0 or random.random() < math.exp(diff / temp):\n                    congr_dict[best_r] = best_a\n                    t_mod_r = cache[best_r]\n                    cnt_array += (t_mod_r == best_a)\n                    logm += math.log(best_r