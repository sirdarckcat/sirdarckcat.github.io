  """Optimize a single step of congruence cover using simulated annealing style logic.\n\n    Args:\n        congr_dict: Dictionary of r -> a\n        cand_mods: List of prime candidates\n        targets: np.array of target primes\n        cnt_array: np.array of coverage counts\n        logm: current log of modulus M\n        logboost: current log of boost factor\n        t_temp: current temperature\n\n    Returns:\n        Updated congr_dict\n    """\n    import numpy as np\n    import random\n\n    if len(targets) == 0:\n        # Safety fallback\n        kind = random.random()\n        r_in = random.choice(list(congr_dict)) if congr_dict else None\n        if kind < 0.5 and r_in is not None:\n            a_old = congr_dict[r_in]\n            a_new = random.randint(0, r_in - 1)\n            if a_new != a_old:\n                congr_dict[r_in] = a_new\n        elif kind < 0.7 and r_in is not None:\n            del congr_dict[r_in]\n        else:\n            r_out = random.choice(cand_mods)\n            if r_out not in congr_dict:\n                a_new = random.randint(0, r_out - 1)\n                congr_dict[r_out] = a_new\n        return congr_dict\n\n    # =========================================================================\n    # CRAZY IDEA: Thermodynamic D-Metric Gradient Descent with Quantum Tunneling!\n    # Instead of linear heuristics, we exactly simulate the actual non-linear\n    # D-metric topography (the multi-dimensional landscape of the Goldbach desert).\n    # We introduce "Quantum Tunneling" to bypass local traps, using an adaptive\n    # temperature coefficient proportional to the superposition of uncovered primes!\n    # =========================================================================\n    \n    factor = np.clip(t_temp, 0.0, 1.0)\n    p_opt = 0.80 - 0.50 * factor\n    p_add = 0.15 + 0.35 * factor\n    p_drop = 0.05 + 0.15 * factor\n    total_p = p_opt + p_add + p_drop\n    p_opt /= total_p\n    p_add /= total_p\n    p_drop /= total_p\n\n    kind = random.random()\n    if not congr_dict:\n        action = \'add\'\n    else:\n        cand_pool = [m for m in cand_mods if m not in congr_dict]\n        if not cand_pool:\n            p_opt_cond = p_opt / (p_opt + p_drop)\n            action = \'optimize\' if kind < p_opt_cond else \'drop\'\n        else:\n            if kind < p_add:\n                action = \'add\'\n            elif kind < p_add + p_opt:\n                action = \'optimize\'\n            else:\n                action = \'drop\'\n\n    # Global State Metrics for exact D-metric calculation\n    n_res = int(np.sum(cnt_array == 0))\n    m_digits = logm / np.log(10)\n    boost = np.exp(logboost)\n    LN10 = np.log(10)\n    \n    def calc_D(n_res_val, m_dig_val, b_val):\n        ub_val = n_res_val * b_val\n        return (m_dig_val + np.sqrt(np.maximum(0, m_dig_val ** 2 + 4 * ub_val / (LN10 * LN10)))) / 2\n\n    D_current = calc_D(n_res, m_digits, boost)\n    \n    # Quantum Tunneling Temperature: scales with high temp to traverse D-metric bottlenecks\n    tunnel_temp = max(t_temp, 1e-4) * (1.0 + 2.0 * np.exp(-1.0 / max(t_temp, 1e-5)))\n\n    if action == \'add\':\n        cand_pool = [m for m in cand_mods if m not in congr_dict]\n        if cand_pool:\n            # Hyper-sample size to survey the quantum landscape\n            sample_size = min(40, len(cand_pool))\n            sampled_cands = random.sample(cand_pool, sample_size)\n            \n            deltas = []\n            cands_data = []\n            \n            for r in sampled_cands:\n                rem = targets % r\n                counts = np.bincount(rem, weights=(cnt_array == 0), minlength=r)\n                \n                # Vectorized Quantum Evaluation of all viable residue classes simultaneously\n                valid_a = np.where(counts > 0)[0]\n                if len(valid_a) == 0 and n_res == 0:\n                    valid_a = np.arange(r)\n                \n                if len(valid_a) > 0:\n                    n_res_new = n_res - counts[valid_a]\n                    m_digits_new = m_digits + np.log10(r)\n                    boost_new = boost * (r / (r - 1))\n                    \n                    D_new = calc_D(n_res_new, m_digits_new, boost_new)\n                    \n                    for i, a in enumerate(valid_a):\n                        deltas.append(-(D_new[i] - D_current))\n                        cands_data.append((r, a))\n                        \n            if deltas:\n                deltas = np.array(deltas)\n                scaled_deltas = deltas / tunnel_temp\n                scaled_deltas = scaled_deltas - np.max(scaled_deltas)\n                probs = np.exp(scaled_deltas)\n                probs /= np.sum(probs)\n                \n                idx = np.random.choice(len(deltas), p=probs)\n                best_cand, best_a = cands_data[idx]\n                congr_dict[best_cand] = int(best_a)\n\n    elif action == \'optimize\':\n        mods_in = list(congr_dict.keys())\n        if mods_in:\n            r = random.choice(mods_in)\n            a_old = congr_dict[r]\n            \n            # Peel back the specific quantum layer of modulus r\n            is_covered_by_r = ((targets % r) == a_old).astype(np.int16)\n            cnt_bg = cnt_array - is_covered_by_r\n            n_res_bg = np.sum(cnt_bg == 0)\n            \n            counts = np.bincount(targets % r, weights=(cnt_bg == 0), minlength=r)\n            \n            n_res_new_arr = n_res_bg - counts\n            D_new_arr = calc_D(n_res_new_arr, m_digits, boost)\n            deltas = -(D_new_arr - D_current)\n            \n            scaled_deltas = deltas / tunnel_temp\n            scaled_deltas = scaled_deltas - np.max(scaled_deltas)\n            probs = np.exp(scaled_deltas)\n            probs /= np.sum(probs)\n            \n            a_new = np.random.choice(r, p=probs)\n            congr_dict[r] = int(a_new)\n\n    elif action == \'drop\':\n        mods_in = list(congr_dict.keys())\n        if mods_in:\n            deltas = []\n            for r in mods_in:\n                a = congr_dict[r]\n                mask = (targets % r) == a\n                loss = np.sum(cnt_array[mask] == 1)\n                n_res_new = n_res + loss\n                m_digits_new = m_digits - np.log10(r)\n                boost_new = boost / (r / (r - 1))\n                \n                D_new = calc_D(n_res_new, m_digits_new, boost_new)\n                deltas.append(-(D_new - D_current))\n                \n            deltas = np.array(deltas)\n            scaled_deltas = deltas / tunnel_temp\n            scaled_deltas = scaled_deltas - np.max(scaled_deltas)\n            probs = np.exp(scaled_deltas)\n            probs /= np.sum(probs)\n            \n            idx = np.random.choice(len(mods_in), p=probs)\n            r_drop = mods_in[idx]\n            del congr_dict[r_drop]\n\n    return congr_dict\n# EVOLVE-BLOCK-END\n\ndef evaluate(eval_inputs: Mapping[str, Any]) -> dict[str, float]:\n    """Run evaluation on the optimized step."""\n    # Let\'s say we maximize -n_digits_est (smaller estimated N-size)\n    # Using sympy/math to compute est digits\n    import sympy\n    import numpy as np\n    Q = 100003\n    targets = np.array(list(sympy.primerange(3, Q)), dtype=np.int64)\n    # Let\'s run the optimize_cover_step starting from empty cover for some iterations\n    congr_dict = {}\n    cand_mods = [int(r) for r in sympy.primerange(3, 8000)]\n    cnt_array = np.zeros(len(targets), dtype=np.int16)\n    logm = math.log(2)\n    logboost = math.log(2.0)\n    \n    for it in range(10):\n        t_temp = 0.8 * (0.02 / 0.8) ** (it / 10)\n        # Update cnt_array based on congr_dict\n        cnt_array = np.zeros(len(targets), dtype=np.int16)\n        logm = math.log(2)\n        logboost = math.log(2.0)\n        for r, a in congr_dict.items():\n            cnt_array += (targets % r) == a\n            logm += math.log(r)\n            logboost += math.log(r / (r - 1))\n            \n        congr_dict = optimize_cover_step(congr_dict, cand_mods, targets, cnt_array, logm, logboost, t_temp)\n        \n    # Recalculate final metrics\n    cnt_array = np.zeros(len(targets), dtype=np.int16)\n    logm = math.log(2)\n    logboost = math.log(2.0)\n    for r, a in congr_dict.items():\n        cnt_array += (targets % r) == a\n        logm += math.log(r)\n        logboost += math.log(r / (r - 1))\n        \n    n_res = int((cnt_array == 0).sum())\n    boost = math.exp(logboost)\n    m_digits = logm / math.log(10)\n    \n    ub = n_res * boost\n    LN10 = math.log(10)\n    D = (m_digits + math.sqrt(m_digits ** 2 + 4 * ub / (LN10 * LN10))) / 2\n    return {"neg_est_digits": -float(D)}\n'}]}, 'evaluation': {'scores': {'scores': [{'metric': 'neg_est_digits', 'score': -63.38732}]}}, 'parentPrograms': ['projects/799795028847/locations/global/collections/default_collection/engines/goldbach_1784979910032/sessions/7013217697778074030/alphaEvolveExperiments/15164875354338173448/alphaEvolvePrograms/7259743653139916870'], 'state': 'COMPLETED'}, {'name': 'projects/799795028847/locations/global/collections/default_collection/engines/goldbach_1784979910032/sessions/7013217697778074030/alphaEvolveExperiments/15164875354338173448/alphaEvolvePrograms/18102573509735111683', 'createTime': '2026-07-25T19:53:21.507745Z', 'content': {'files': [{'path': 'program.py', 'content': '# Copyright 2026 Google LLC\nfrom typing import Any, Mapping\nimport math\nimport random\nimport numpy as np\n\n# EVOLVE-BLOCK-START\ndef optimize_cover_step(congr_dict, cand_mods, targets, cnt_array, logm, logboost, t_temp):\n    """Optimize a single step of congruence cover using simulated annealing style logic.\n\n    Args:\n        congr_dict: Dictionary of r -> a\n        cand_mods: List of prime candidates\n        targets: np.array of target primes\n        cnt_array: np.array of coverage counts\n        logm: current log of modulus M\n        logboost: current log of boost factor\n        t_temp: current temperature\n\n    Returns:\n        Updated congr_dict\n    """\n    import numpy as np\n    import random\n    import math\n\n    if len(targets) == 0:\n        # Safety fallback\n        kind = random.random()\n        r_in = random.choice(list(congr_dict)) if congr_dict else None\n        if kind < 0.5 and r_in is not None:\n            a_old = congr_dict[r_in]\n            a_new = random.randint(0, r_in - 1)\n            if a_new != a_old:\n                congr_dict[r_in] = a_new\n        elif kind < 0.7 and r_in is not None:\n            del congr_dict[r_in]\n        else:\n            r_out = random.choice(cand_mods)\n            if r_out not in congr_dict:\n                a_new = random.randint(0, r_out - 1)\n                congr_dict[r_out] = a_new\n        return congr_dict\n\n    # Exact objective D and dynamic action probabilities\n    LN10 = 2.302585092994046\n    m = logm / LN10\n    boost = math.exp(logboost)\n    n_res = np.sum(cnt_array == 0)\n    ub = n_res * boost\n    \n    D_old = 0.5 * (m + math.sqrt(max(m**2 + 4.0 * ub / (LN10**2), 1e-9)))\n\n    factor = np.clip(t_temp, 0.0, 1.0)\n    p_opt = 0.70 - 0.30 * factor\n    p_add = 0.20 + 0.20 * factor\n    p_drop = 0.10 + 0.10 * factor\n\n    kind = random.random()\n    if not congr_dict:\n        action = \'add\'\n    else:\n        cand_pool = [m for m in cand_mods if m not in congr_dict]\n        if not cand_pool:\n            p_opt_cond = p_opt / (p_opt + p_drop)\n            action = \'optimize\' if kind < p_opt_cond else \'drop\'\n        else:\n            if n_res == 0:\n                p_add_adj = 0.0\n                p_opt_adj = p_opt / (p_opt + p_drop)\n                p_drop_adj = p_drop / (p_opt + p_drop)\n            else:\n                total_p = p_add + p_opt + p_drop\n                p_add_adj = p_add / total_p\n                p_opt_adj = p_opt / total_p\n                p_drop_adj = p_drop / total_p\n\n            if kind < p_add_adj:\n                action = \'add\'\n            elif kind < p_add_adj + p_opt_adj:\n                action = \'optimize\'\n            else:\n                action = \'drop\'\n\n    if action == \'add\':\n        cand_pool = [c for c in cand_mods if c not in congr_dict]\n        if cand_pool:\n            sample_size = min(200, len(cand_pool))\n            sampled_cands = random.sample(cand_pool, sample_size)\n            \n            uncovered_mask = (cnt_array == 0)\n            targets_uncovered = targets[uncovered_mask]\n            \n            cands_data = []\n            delta_Ds = []\n            for r in sampled_cands:\n                if len(targets_uncovered) > 0:\n                    rem = targets_uncovered % r\n                    counts = np.bincount(rem, minlength=r)\n                    best_a = int(np.argmax(counts))\n                    new_covered = counts[best_a]\n                else:\n                    best_a = 0\n                    new_covered = 0\n                \n                m_new = m + math.log(r) / LN10\n                ub_new = boost * (r / (r - 1)) * (n_res - new_covered) if r > 1 else ub\n                D_new = 0.5 * (m_new + math.sqrt(max(m_new**2 + 4.0 * ub_new / (LN10**2), 1e-9)))\n                \n                cands_data.append((r, best_a))\n                delta_Ds.append(D_new - D_old)\n            \n            delta_Ds = np.array(delta_Ds)\n            temp = max(t_temp, 1e-4)\n            scaled_scores = -delta_Ds / temp\n            scaled_scores = scaled_scores - np.max(scaled_scores)\n            probs = np.exp(scaled_scores)\n            probs /= np.sum(probs)\n            \n            idx = np.random.choice(len(sampled_cands), p=probs)\n            best_cand, best_a = cands_data[idx]\n            congr_dict[best_cand] = int(best_a)\n\n    elif action == \'optimize\':\n        mods_in = list(congr_dict.keys())\n        if mods_in:\n            sample_opt = random.sample(mods_in, min(100, len(mods_in)))\n            \n            candidates = []\n            for r in sample_opt:\n                a_old = congr_dict[r]\n                is_covered_by_r = (targets % r) == a_old\n                cnt_bg = cnt_array - is_covered_by_r\n                \n                bg_uncovered_mask = (cnt_bg == 0)\n                targets_bg_uncovered = targets[bg_uncovered_mask]\n                if len(targets_bg_uncovered) > 0:\n                    counts = np.bincount(targets_bg_uncovered % r, minlength=r)\n                else:\n                    counts = np.zeros(r, dtype=np.int64)\n                    \n                best_a_new = int(np.argmax(counts))\n                ub_new = boost * (n_res + counts[a_old] - counts[best_a_new])\n                D_new = 0.5 * (m + math.sqrt(max(m**2 + 4.0 * ub_new / (LN10**2), 1e-9)))\n                candidates.append((r, best_a_new, D_new - D_old, counts))\n                \n            delta_Ds = np.array([c[2] for c in candidates])\n            temp = max(t_temp, 1e-4)\n            scaled_scores = -delta_Ds / temp\n            scaled_scores = scaled_scores - np.max(scaled_scores)\n            probs = np.exp(scaled_scores)\n            probs /= np.sum(probs)\n            \n            idx = np.random.choice(len(candidates), p=probs)\n            r, best_a_new, _, counts = candidates[idx]\n            \n            a_old = congr_dict[r]\n            ub_new_a = boost * (n_res + counts[a_old] - counts)\n            D_new_a = 0.5 * (m + np.sqrt(np.maximum(m**2 + 4.0 * ub_new_a / (LN10**2), 1e-9)))\n            delta_Ds_a = D_new_a - D_old\n            scaled_scores_a = -delta_Ds_a / temp\n            scaled_scores_a = scaled_scores_a - np.max(scaled_scores_a)\n            probs_a = np.exp(scaled_scores_a)\n            probs_a /= np.sum(probs_a)\n            \n            a_new = np.random.choice(r, p=probs_a)\n            congr_dict[r] = int(a_new)\n\n    elif action == \'drop\':\n        mods_in = list(congr_dict.keys())\n        if mods_in:\n            unique_mask = (cnt_array == 1)\n            targets_unique = targets[unique_mask]\n            \n            delta_Ds = []\n            for r in mods_in:\n                a = congr_dict[r]\n                if len(targets_unique) > 0:\n                    newly_uncovered = np.sum((targets_unique % r) == a)\n                else:\n                    newly_uncovered = 0\n                    \n                m_new = m - math.log(r) / LN10\n                ub_new = boost * ((r - 1) / r) * (n_res + newly_uncovered) if r > 1 else ub\n                D_new = 0.5 * (m_new + math.sqrt(max(m_new**2 + 4.0 * ub_new / (LN10**2), 1e-9)))\n                delta_Ds.append(D_new - D_old)\n                \n            delta_Ds = np.array(delta_Ds)\n            temp = max(t_temp, 1e-4)\n            scaled_scores = -delta_Ds / temp\n            scaled_scores = scaled_scores - np.max(scaled_scores)\n            probs = np.exp(scaled_scores)\n            probs /= np.sum(probs)\n            \n            idx = np.random.choice(len(mods_in), p=probs)\n            r_drop = mods_in[idx]\n            del congr_dict[r_drop]\n\n    return congr_dict\n# EVOLVE-BLOCK-END\n\ndef evaluate(eval_inputs: Mapping[str, Any]) -> dict[str, float]:\n    """Run evaluation on the optimized step."""\n    # Let\'s say we maximize -n_digits_est (smaller estimated N-size)\n    # Using sympy/math to compute est digits\n    import sympy\n    import numpy as np\n    Q = 100003\n    targets = np.array(list(sympy.primerange(3, Q)), dtype=np.int64)\n    # Let\'s run the optimize_cover_step starting from empty cover for some iterations\n    congr_dict = {}\n    cand_mods = [int(r) for r in sympy.primerange(3, 8000)]\n    cnt_array = np.zeros(len(targets), dtype=np.int16)\n    logm = math.log(2)\n    logboost = math.log(2.0)\n    \n    for it in range(10):\n        t_temp = 0.8 * (0.02 / 0.8) ** (it / 10)\n        # Update cnt_array based on congr_dict\n        cnt_array = np.zeros(len(targets), dtype=np.int16)\n        logm = math.log(2)\n        logboost = math.log(2.0)\n        for r, a in congr_dict.items():\n            cnt_array += (targets % r) == a\n            logm += math.log(r)\n            logboost += math.log(r / (r - 1))\n            \n        congr_dict = optimize_cover_step(congr_dict, cand_mods, targets, cnt_array, logm, logboost, t_temp)\n        \n    # Recalculate final metrics\n    cnt_array = np.zeros(len(targets), dtype=np.int16)\n    logm = math.log(2)\n    logboost = math.log(2.0)\n    for r, a in congr_dict.items():\n        cnt_array += (targets % r) == a\n        logm += math.log(r)\n        logboost += math.log(r / (r - 1))\n        \n    n_res = int((cnt_array == 0).sum())\n    boost = math.exp(logboost)\n    m_digits = logm / math.log(10)\n    \n    ub = n_res * boost\n    LN10 = math.log(10)\n    D = (m_digits + math.sqrt(m_digits ** 2 + 4 * ub / (LN10 * LN10))) / 2\n    return {"neg_est_digits": -float(D)}\n'}]}, 'evaluation': {'scores': {'scores': [{'metric': 'neg_est_digits', 'score': -64.083115}]}}, 'parentPrograms': ['projects/799795028847/locations/global/collections/default_collection/engines/goldbach_1784979910032/sessions/7013217697778074030/alphaEvolveExperiments/15164875354338173448/alphaEvolvePrograms/18102573509735111823'], 'state': 'COMPLETED'}, {'name': 'projects/799795028847/locations/global/collections/default_collection/engines/goldbach_1784979910032/sessions/7013217697778074030/alphaEvolveExperiments/15164875354338173448/alphaEvolvePrograms/18102573509735109167', 'createTime': '2026-07-25T19:40:02.890476Z', 'content': {'files': [{'path': 'program.py', 'content': '# Copyright 2026 Google LLC\nfrom typing import Any, Mapping\nimport math\nimport random\nimport numpy as np\n\n# EVOLVE-BLOCK-START\ndef optimize_cover_step(congr_dict, cand_mods, targets, cnt_array, logm, logboost, t_temp):\n    """Optimize a single step of congruence cover using simulated annealing style logic.\n\n    Args:\n        congr_dict: Dictionary of r -> a\n        cand_mods: List of prime candidates\n        targets: np.array of target primes\n        cnt_array: np.array of coverage counts\n        logm: current log of modulus M\n        logboost: current log of boost factor\n        t_temp: current temperature\n\n    Returns:\n        Updated congr_dict\n    """\n    if len(targets) == 0:\n        return congr_dict\n\n    # Dynamic action probabilities based on temperature\n    # At high temp, we explore (more add/drop). At low temp, we exploit (more optimize).\n    factor = np.clip(t_temp, 0.0, 1.0)\n    p_opt = 0.85 - 0.45 * factor\n    p_add = 0.10 + 0.25 * factor\n    p_drop = 0.05 + 0.20 * factor\n\n    mods_in = list(congr_dict.keys())\n    cand_pool = [m for m in cand_mods if m not in congr_dict]\n\n    kind = random.random()\n    if not mods_in:\n        action = \'add\'\n    elif not cand_pool:\n        action = \'optimize\' if kind < p_opt / (p_opt + p_drop) else \'drop\'\n    elif kind < p_add:\n        action = \'add\'\n    elif kind < p_add + p_opt:\n        action = \'optimize\'\n    else:\n        action = \'drop\'\n\n    if action == \'add\' and cand_pool:\n        # Scale up sample size for a more comprehensive selection\n        sample_size = min(30, len(cand_pool))\n        sampled_cands = random.sample(cand_pool, sample_size)\n        \n        # Binary coverage objective: only count currently uncovered targets\n        weights_add = np.where(cnt_array == 0, 1.0, 1e-4)\n        total_weight = max(np.sum(weights_add), 1e-9)\n        \n        ratios = []\n        cands_data = []\n        for r in sampled_cands:\n            counts = np.bincount(targets % r, weights=weights_add, minlength=r)\n            a = int(np.argmax(counts))\n            val = counts[a] / total_weight  # Normalized to [0, 1] range\n            ratios.append(val / np.log(r))\n            cands_data.append((r, a))\n        \n        ratios = np.array(ratios)\n        temp = max(t_temp, 1e-4)\n        \n        # Gumbel-max trick for concise sampling from softmax\n        idx = int(np.argmax(ratios + np.random.gumbel(size=len(ratios)) * temp))\n        best_cand, best_a = cands_data[idx]\n        congr_dict[best_cand] = best_a\n\n    elif action == \'optimize\':\n        r = random.choice(mods_in)\n        \n        # Subtract the contribution of the active modulus to obtain background coverage\n        is_covered_by_r = (targets % r) == congr_dict[r]\n        cnt_bg = cnt_array - is_covered_by_r\n        \n        # We want to cover targets that are completely uncovered in the background\n        weights_opt = np.where(cnt_bg == 0, 1.0, 1e-4)\n        total_weight = max(np.sum(weights_opt), 1e-9)\n        \n        counts = np.bincount(targets % r, weights=weights_opt, minlength=r)\n        norm_counts = counts / total_weight  # Normalized to [0, 1] range\n        \n        temp = max(t_temp, 1e-4)\n        \n        # Gumbel-max trick for concise sampling from softmax\n        congr_dict[r] = int(np.argmax(norm_counts + np.random.gumbel(size=r) * temp))\n\n    elif action == \'drop\':\n        # Binary coverage loss: we only lose a target if it is covered exactly once\n        weights_drop = np.where(cnt_array == 1, 1.0, 1e-4)\n        total_weight = max(np.sum(weights_drop), 1e-9)\n        \n        scores = []\n        for r in mods_in:\n            mask = (targets % r) == congr_dict[r]\n            val = np.sum(weights_drop[mask]) / total_weight  # Normalized to [0, 1] range\n            scores.append(val / np.log(r))\n            \n        scores = np.array(scores)\n        temp = max(t_temp, 1e-4)\n        \n        # Gumbel-max trick for concise sampling from softmax\n        idx = int(np.argmax(-scores + np.random.gumbel(size=len(scores)) * temp))\n        del congr_dict[mods_in[idx]]\n\n    return congr_dict\n# EVOLVE-BLOCK-END\n\ndef evaluate(eval_inputs: Mapping[str, Any]) -> dict[str, float]:\n    """Run evaluation on the optimized step."""\n    # Let\'s say we maximize -n_digits_est (smaller estimated N-size)\n    # Using sympy/math to compute est digits\n    import sympy\n    import numpy as np\n    Q = 100003\n    targets = np.array(list(sympy.primerange(3, Q)), dtype=np.int64)\n    # Let\'s run the optimize_cover_step starting from empty cover for some iterations\n    congr_dict = {}\n    cand_mods = [int(r) for r in sympy.primerange(3, 8000)]\n    cnt_array = np.zeros(len(targets), dtype=np.int16)\n    logm = math.log(2)\n    logboost = math.log(2.0)\n    \n    for it in range(10):\n        t_temp = 0.8 * (0.02 / 0.8) ** (it / 10)\n        # Update cnt_array based on congr_dict\n        cnt_array = np.zeros(len(targets), dtype=np.int16)\n        logm = math.log(2)\n        logboost = math.log(2.0)\n        for r, a in congr_dict.items():\n            cnt_array += (targets % r) == a\n            logm += math.log(r)\n            logboost += math.log(r / (r - 1))\n            \n        congr_dict = optimize_cover_step(congr_dict, cand_mods, targets, cnt_array, logm, logboost, t_temp)\n        \n    # Recalculate final metrics\n    cnt_array = np.zeros(len(targets), dtype=np.int16)\n    logm = math.log(2)\n    logboost = math.log(2.0)\n    for r, a in congr_dict.items():\n        cnt_array += (targets % r) == a\n        logm += math.log(r)\n        logboost += math.log(r / (r - 1))\n        \n    n_res = int((cnt_array == 0).sum())\n    boost = math.exp(logboost)\n    m_digits = logm / math.log(10)\n    \n    ub = n_res * boost\n    LN10 = math.log(10)\n    D = (m_digits + math.sqrt(m_digits ** 2 + 4 * ub / (LN10 * LN10))) / 2\n    return {"neg_est_digits": -float(D)}\n'}]}, 'evaluation': {'scores': {'scores': [{'metric': 'neg_est_digits', 'score': -64.16838}]}}, 'parentPrograms': ['projects/799795028847/locations/global/collections/default_collection/engines/goldbach_1784979910032/sessions/7013217697778074030/alphaEvolveExperiments/15164875354338173448/alphaEvolvePrograms/18102573509735111640', 'projects/799795028847/locations/global/collections/default_collection/engines/goldbach_1784979910032/sessions/7013217697778074030/alphaEvolveExperiments/15164875354338173448/alphaEvolvePrograms/18102573509735111604'], 'state': 'COMPLETED'}, {'name': 'projects/799795028847/locations/global/collections/default_collection/engines/goldbach_1784979910032/sessions/7013217697778074030/alphaEvolveExperiments/15164875354338173448/alphaEvolvePrograms/18102573509735111276', 'createTime': '2026-07-25T19:57:43.305576Z', 'content': {'files': [{'path': 'program.py', 'content': '# Copyright 2026 Google LLC\nfrom typing import Any, Mapping\nimport math\nimport random\nimport numpy as np\n\n# EVOLVE-BLOCK-START\ndef optimize_cover_step(congr_dict, cand_mods, targets, cnt_array, logm, logboost, t_temp):\n    """Optimize a single step of congruence cover using simulated annealing style logic.\n\n    Args:\n        congr_dict: Dictionary of r -> a\n        cand_mods: List of prime candidates\n        targets: np.array of target primes\n        cnt_array: np.array of coverage counts\n        logm: current log of modulus M\n        logboost: current log of boost factor\n        t_temp: current temperature\n\n    Returns:\n        Updated congr_dict\n    """\n    import numpy as np\n    import random\n\n    if len(targets) == 0:\n        # Safety fallback\n        kind = random.random()\n        r_in = random.choice(list(congr_dict)) if congr_dict else None\n        if kind < 0.5 and r_in is not None:\n            a_old = congr_dict[r_in]\n            a_new = random.randint(0, r_in - 1)\n            if a_new != a_old:\n                congr_dict[r_in] = a_new\n        elif kind < 0.7 and r_in is not None:\n            del congr_dict[r_in]\n        else:\n            r_out = random.choice(cand_mods)\n            if r_out not in congr_dict:\n                a_new = random.randint(0, r_out - 1)\n                congr_dict[r_out] = a_new\n        return congr_dict\n\n    # =========================================================================\n    # CRAZY IDEA: Thermodynamic D-Metric Gradient Descent with Quantum Tunneling!\n    # Instead of linear heuristics, we exactly simulate the actual non-linear\n    # D-metric topography (the multi-dimensional landscape of the Goldbach desert).\n    # We introduce "Quantum Tunneling" to bypass local traps, using an adaptive\n    # temperature coefficient proportional to the superposition of uncovered primes!\n    # =========================================================================\n    \n    factor = np.clip(t_temp, 0.0, 1.0)\n    p_opt = 0.80 - 0.50 * factor\n    p_add = 0.15 + 0.35 * factor\n    p_drop = 0.05 + 0.15 * factor\n    probs = np.array([p_add, p_opt, p_drop])\n    probs /= probs.sum()\n\n    cand_pool = [m for m in cand_mods if m not in congr_dict]\n    \n    if not congr_dict:\n        action = \'add\'\n    elif not cand_pool:\n        p_sub = np.array([probs[1], probs[2]])\n        action = np.random.choice([\'optimize\', \'drop\'], p=p_sub / p_sub.sum())\n    else:\n        action = np.random.choice([\'add\', \'optimize\', \'drop\'], p=probs)\n\n    # Global State Metrics for exact D-metric calculation\n    n_res = int(np.sum(cnt_array == 0))\n    m_digits = logm / np.log(10)\n    boost = np.exp(logboost)\n    LN10 = np.log(10)\n    \n    def calc_D(n_res_val, m_dig_val, b_val):\n        ub_val = n_res_val * b_val\n        return (m_dig_val + np.sqrt(np.maximum(0, m_dig_val ** 2 + 4 * ub_val / (LN10 * LN10)))) / 2\n\n    D_current = calc_D(n_res, m_digits, boost)\n    \n    # Quantum Tunneling Temperature: scales with high temp to traverse D-metric bottlenecks\n    tunnel_temp = max(t_temp, 1e-4) * (1.0 + 2.0 * np.exp(-1.0 / max(t_temp, 1e-5)))\n\n    if action == \'add\':\n        if cand_pool:\n            # Hyper-sample size to survey the quantum landscape\n            sample_size = min(40, len(cand_pool))\n            sampled_cands = random.sample(cand_pool, sample_size)\n            \n            deltas = []\n            cands_data = []\n            \n            for r in sampled_cands:\n                rem = targets % r\n                counts = np.bincount(rem, weights=(cnt_array == 0), minlength=r)\n                \n                # Vectorized Quantum Evaluation of all viable residue classes simultaneously\n                valid_a = np.where(counts > 0)[0]\n                if len(valid_a) == 0 and n_res == 0:\n                    valid_a = np.arange(r)\n                \n                if len(valid_a) > 0:\n                    n_res_new = n_res - counts[valid_a]\n                    m_digits_new = m_digits + np.log10(r)\n                    boost_new = boost * (r / (r - 1))\n                    \n                    D_new = calc_D(n_res_new, m_digits_new, boost_new)\n                    \n                    for i, a in enumerate(valid_a):\n                        deltas.append(-(D_new[i] - D_current))\n                        cands_data.append((r, a))\n                        \n            if deltas:\n                deltas = np.array(deltas)\n                idx = np.argmax(deltas / tunnel_temp + np.random.gumbel(size=len(deltas)))\n                best_cand, best_a = cands_data[idx]\n                congr_dict[best_cand] = int(best_a)\n\n    elif action == \'optimize\':\n        mods_in = list(congr_dict.keys())\n        if mods_in:\n            r = random.choice(mods_in)\n            a_old = congr_dict[r]\n            \n            # Peel back the specific quantum layer of modulus r\n            is_covered_by_r = ((targets % r) == a_old).astype(np.int16)\n            cnt_bg = cnt_array - is_covered_by_r\n            n_res_bg = np.sum(cnt_bg == 0)\n            \n            counts = np.bincount(targets % r, weights=(cnt_bg == 0), minlength=r)\n            \n            n_res_new_arr = n_res_bg - counts\n            D_new_arr = calc_D(n_res_new_arr, m_digits, boost)\n            deltas = -(D_new_arr - D_current)\n            \n            a_new = np.argmax(deltas / tunnel_temp + np.random.gumbel(size=r))\n            congr_dict[r] = int(a_new)\n\n    elif action == \'drop\':\n        mods_in = list(congr_dict.keys())\n        if mods_in:\n            deltas = []\n            for r in mods_in:\n                a = congr_dict[r]\n                mask = (targets % r) == a\n                loss = np.sum(cnt_array[mask] == 1)\n                n_res_new = n_res + loss\n                m_digits_new = m_digits - np.log10(r)\n                boost_new = boost / (r / (r - 1))\n                \n                D_new = calc_D(n_res_new, m_digits_new, boost_new)\n                deltas.append(-(D_new - D_current))\n                \n            deltas = np.array(deltas)\n            idx = np.argmax(deltas / tunnel_temp + np.random.gumbel(size=len(deltas)))\n            del congr_dict[mods_in[idx]]\n\n    return congr_dict\n# EVOLVE-BLOCK-END\n\ndef evaluate(eval_inputs: Mapping[str, Any]) -> dict[str, float]:\n    """Run evaluation on the optimized step."""\n    # Let\'s say we maximize -n_digits_est (smaller estimated N-size)\n    # Using sympy/math to compute est digits\n    import sympy\n    import numpy as np\n    Q = 100003\n    targets = np.array(list(sympy.primerange(3, Q)), dtype=np.int64)\n    # Let\'s run the optimize_cover_step starting from empty cover for some iterations\n    congr_dict = {}\n    cand_mods = [int(r) for r in sympy.primerange(3, 8000)]\n    cnt_array = np.zeros(len(targets), dtype=np.int16)\n    logm = math.log(2)\n    logboost = math.log(2.0)\n    \n    for it in range(10):\n        t_temp = 0.8 * (0.02 / 0.8) ** (it / 10)\n        # Update cnt_array based on congr_dict\n        cnt_array = np.zeros(len(targets), dtype=np.int16)\n        logm = math.log(2)\n        logboost = math.log(2.0)\n        for r, a in congr_dict.items():\n            cnt_array += (targets % r) == a\n            logm += math.log(r)\n            logboost += math.log(r / (r - 1))\n            \n        congr_dict = optimize_cover_step(congr_dict, cand_mods, targets, cnt_array, logm, logboost, t_temp)\n        \n    # Recalculate final metrics\n    cnt_array = np.zeros(len(targets), dtype=np.int16)\n    logm = math.log(2)\n    logboost = math.log(2.0)\n    for r, a in congr_dict.items():\n        cnt_array += (targets % r) == a\n        logm += math.log(r)\n        logboost += math.log(r / (r - 1))\n        \n    n_res = int((cnt_array == 0).sum())\n    boost = math.exp(logboost)\n    m_digits = logm / math.log(10)\n    \n    ub = n_res * boost\n    LN10 = math.log(10)\n    D = (m_digits + math.sqrt(m_digits ** 2 + 4 * ub / (LN10 * LN10))) / 2\n    return {"neg_est_digits": -float(D)}\n'}]}, 'evaluation': {'scores': {'scores': [{'metric': 'neg_est_digits', 'score': -65.69888}]}}, 'parentPrograms': ['projects/799795028847/locations/global/collections/default_collection/engines/goldbach_1784979910032/sessions/7013217697778074030/alphaEvolveExperiments/15164875354338173448/alphaEvolvePrograms/18102573509735112581'], 'state': 'COMPLETED'}, {'name': 'projects/799795028847/locations/global/collections/default_collection/engines/goldbach_1784979910032/sessions/7013217697778074030/alphaEvolveExperiments/15164875354338173448/alphaEvolvePrograms/18102573509735111604', 'createTime': '2026-07-25T19:37:18.610795Z', 'content': {'files': [{'path': 'program.py', 'content': '# Copyright 2026 Google LLC\nfrom typing import Any, Mapping\nimport math\nimport random\nimport numpy as np\n\n# EVOLVE-BLOCK-START\ndef optimize_cover_step(congr_dict, cand_mods, targets, cnt_array, logm, logboost, t_temp):\n    """Optimize a single step of congruence cover using simulated annealing style logic.\n\n    Args:\n        congr_dict: Dictionary of r -> a\n        cand_mods: List of prime candidates\n        targets: np.array of target primes\n        cnt_array: np.array of coverage counts\n        logm: current log of modulus M\n        logboost: current log of boost factor\n        t_temp: current temperature\n\n    Returns:\n        Updated congr_dict\n    """\n    import numpy as np\n    import random\n\n    if len(targets) == 0:\n        # Safety fallback\n        kind = random.random()\n        r_in = random.choice(list(congr_dict)) if congr_dict else None\n        if kind < 0.5 and r_in is not None:\n            a_old = congr_dict[r_in]\n            a_new = random.randint(0, r_in - 1)\n            if a_new != a_old:\n                congr_dict[r_in] = a_new\n        elif kind < 0.7 and r_in is not None:\n            del congr_dict[r_in]\n        else:\n            r_out = random.choice(cand_mods)\n            if r_out not in congr_dict:\n                a_new = random.randint(0, r_out - 1)\n                congr_dict[r_out] = a_new\n        return congr_dict\n\n    # Dynamic action probabilities based on temperature\n    # At high temp, we explore (more add/drop). At low temp, we exploit (more optimize).\n    factor = np.clip(t_temp, 0.0, 1.0)\n    p_opt = 0.85 - 0.45 * factor\n    p_add = 0.10 + 0.25 * factor\n    p_drop = 0.05 + 0.20 * factor\n    total_p = p_opt + p_add + p_drop\n    p_opt /= total_p\n    p_add /= total_p\n    p_drop /= total_p\n\n    kind = random.random()\n    if not congr_dict:\n        action = \'add\'\n    else:\n        cand_pool = [m for m in cand_mods if m not in congr_dict]\n        if not cand_pool:\n            p_opt_cond = p_opt / (p_opt + p_drop)\n            action = \'optimize\' if kind < p_opt_cond else \'drop\'\n        else:\n            if kind < p_add:\n                action = \'add\'\n            elif kind < p_add + p_opt:\n                action = \'optimize\'\n            else:\n                action = \'drop\'\n\n    if action == \'add\':\n        cand_pool = [m for m in cand_mods if m not in congr_dict]\n        if cand_pool:\n            # Scale up sample size for a more comprehensive selection\n            sample_size = min(40, len(cand_pool))\n            sampled_cands = random.sample(cand_pool, sample_size)\n            \n            # Smooth exponentially decaying weights (surrogate for L0 sparsity)\n            # Provides a richer gradient signal than binary weights\n            weights_add = np.exp(-1.5 * cnt_array)\n            total_weight = max(np.sum(weights_add), 1e-9)\n            \n            ratios = []\n            cands_data = []\n            for r in sampled_cands:\n                rem = targets % r\n                counts = np.bincount(rem, weights=weights_add, minlength=r)\n                a = int(np.argmax(counts))\n                val = counts[a] / total_weight  # Normalized to [0, 1] range\n                cost = np.log(r) if r > 1 else 1.0\n                ratios.append(val / cost)\n                cands_data.append((r, a))\n            \n            ratios = np.array(ratios)\n            temp = max(t_temp, 1e-4)\n            scaled_ratios = ratios / temp\n            scaled_ratios = scaled_ratios - np.max(scaled_ratios)\n            probs = np.exp(scaled_ratios)\n            probs /= np.sum(probs)\n            \n            idx = np.random.choice(len(sampled_cands), p=probs)\n            best_cand, best_a = cands_data[idx]\n            congr_dict[best_cand] = int(best_a)\n\n    elif action == \'optimize\':\n        mods_in = list(congr_dict.keys())\n        if mods_in:\n            # Alternating Least Squares (ALS) inspired block-coordinate update\n            batch_size = min(3, len(mods_in))\n            sampled_mods = random.sample(mods_in, batch_size)\n            \n            for r in sampled_mods:\n                a_old = congr_dict[r]\n                \n                # Subtract the contribution of the active modulus to obtain background coverage\n                is_covered_by_r = (targets % r) == a_old\n                cnt_bg = cnt_array - is_covered_by_r\n                \n                # Smooth relaxation weights for better gradient signal\n                weights_opt = np.exp(-1.5 * cnt_bg)\n                total_weight = max(np.sum(weights_opt), 1e-9)\n                \n                counts = np.bincount(targets % r, weights=weights_opt, minlength=r)\n                norm_counts = counts / total_weight  # Normalized to [0, 1] range\n                \n                temp = max(t_temp, 1e-4)\n                scaled_counts = norm_counts / temp\n                scaled_counts = scaled_counts - np.max(scaled_counts)\n                probs = np.exp(scaled_counts)\n                probs /= np.sum(probs)\n                \n                a_new = np.random.choice(r, p=probs)\n                congr_dict[r] = int(a_new)\n                \n                # Update local cnt_array to allow sequential (ALS) improvements\n                if a_new != a_old:\n                    cnt_array = cnt_bg + ((targets % r) == a_new)\n\n    elif action == \'drop\':\n        mods_in = list(congr_dict.keys())\n        if mods_in:\n            # Evaluate redundancy loss using soft weights matching the surrogate loss derivative\n            weights_drop = np.exp(-1.5 * np.maximum(cnt_array - 1, 0)) * (cnt_array > 0)\n            total_weight = max(np.sum(weights_drop), 1e-9)\n            \n            scores = []\n            for r in mods_in:\n                a = congr_dict[r]\n                mask = (targets % r) == a\n                val = np.sum(weights_drop[mask]) / total_weight  # Normalized to [0, 1] range\n                cost = np.log(r) if r > 1 else 1.0\n                scores.append(val / cost)\n                \n            scores = np.array(scores)\n            temp = max(t_temp, 1e-4)\n            scaled_scores = -scores / temp\n            scaled_scores = scaled_scores - np.max(scaled_scores)\n            probs = np.exp(scaled_scores)\n            probs /= np.sum(probs)\n            \n            idx = np.random.choice(len(mods_in), p=probs)\n            r_drop = mods_in[idx]\n            del congr_dict[r_drop]\n\n    return congr_dict\n# EVOLVE-BLOCK-END\n\ndef evaluate(eval_inputs: Mapping[str, Any]) -> dict[str, float]:\n    """Run evaluation on the optimized step."""\n    # Let\'s say we maximize -n_digits_est (smaller estimated N-size)\n    # Using sympy/math to compute est digits\n    import sympy\n    import numpy as np\n    Q = 100003\n    targets = np.array(list(sympy.primerange(3, Q)), dtype=np.int64)\n    # Let\'s run the optimize_cover_step starting from empty cover for some iterations\n    congr_dict = {}\n    cand_mods = [int(r) for r in sympy.primerange(3, 8000)]\n    cnt_array = np.zeros(len(targets), dtype=np.int16)\n    logm = math.log(2)\n    logboost = math.log(2.0)\n    \n    for it in range(10):\n        t_temp = 0.8 * (0.02 / 0.8) ** (it / 10)\n        # Update cnt_array based on congr_dict\n        cnt_array = np.zeros(len(targets), dtype=np.int16)\n        logm = math.log(2)\n        logboost = math.log(2.0)\n        for r, a in congr_dict.items():\n            cnt_array += (targets % r) == a\n            logm += math.log(r)\n            logboost += math.log(r / (r - 1))\n            \n        congr_dict = optimize_cover_step(congr_dict, cand_mods, targets, cnt_array, logm, logboost, t_temp)\n        \n    # Recalculate final metrics\n    cnt_array = np.zeros(len(targets), dtype=np.int16)\n    logm = math.log(2)\n    logboost = math.log(2.0)\n    for r, a in congr_dict.items():\n        cnt_array += (targets % r) == a\n        logm += math.log(r)\n        logboost += math.log(r / (r - 1))\n        \n    n_res = int((cnt_array == 0).sum())\n    boost = math.exp(logboost)\n    m_digits = logm / math.log(10)\n    \n    ub = n_res * boost\n    LN10 = math.log(10)\n    D = (m_digits + math.sqrt(m_digits ** 2 + 4 * ub / (LN10 * LN10))) / 2\n    return {"neg_est_digits": -float(D)}\n'}]}, 'evaluation': {'scores': {'scores': [{'metric': 'neg_est_digits', 'score': -65.74175}]}}, 'parentPrograms': ['projects/799795028847/locations/global/collections/default_collection/engines/goldbach_1784979910032/sessions/7013217697778074030/alphaEvolveExperiments/15164875354338173448/alphaEvol