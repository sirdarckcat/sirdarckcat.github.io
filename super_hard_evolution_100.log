import random\nimport numpy as np\n\n# EVOLVE-BLOCK-START\ndef optimize_cover_step(congr_dict, cand_mods, targets, cnt_array, logm, logboost, t_temp):\n    """Optimize a single step of congruence cover using simulated annealing style logic.\n\n    Args:\n        congr_dict: Dictionary of r -> a\n        cand_mods: List of prime candidates\n        targets: np.array of target primes\n        cnt_array: np.array of coverage counts\n        logm: current log of modulus M\n        logboost: current log of boost factor\n        t_temp: current temperature\n\n    Returns:\n        Updated congr_dict\n    """\n    import numpy as np\n    import random\n    import math\n\n    if len(targets) == 0:\n        return congr_dict\n\n    if not hasattr(optimize_cover_step, \'_cache\') or optimize_cover_step._cache.get(\'id\') != id(targets) or optimize_cover_step._cache.get(\'len\') != len(targets):\n        optimize_cover_step._cache = {\'id\': id(targets), \'len\': len(targets)}\n        for r in cand_mods:\n            optimize_cover_step._cache[r] = targets % r\n    _cache = optimize_cover_step._cache\n\n    LN10 = 2.302585092994046\n    def eval_score(n_res, lm, lb):\n        md = lm / LN10\n        ub = n_res * math.exp(lb)\n        D = (md + math.sqrt(max(0.0, md**2 + 4 * ub / (LN10 * LN10)))) / 2\n        E_act = ub / (D * LN10) if D > 0 else 0.0\n        pen = 100.0 * (max(0.0, E_act - 17.5))**2\n        return D + pen\n\n    n_res = int(np.sum(cnt_array == 0))\n    NUM_STEPS = 10000\n\n    for step in range(NUM_STEPS):\n        temp = t_temp * (0.01 ** (step / NUM_STEPS))\n        \n        if congr_dict and random.random() < 0.5:\n            r = random.choice(list(congr_dict.keys()))\n        else:\n            r = random.choice(cand_mods)\n            \n        was_in = (r in congr_dict)\n        if was_in:\n            a_old = congr_dict[r]\n            mask_old = (_cache[r] == a_old)\n            cnt_array -= mask_old\n            n_res += int(np.sum((cnt_array == 0) & mask_old))\n            logm -= math.log(r)\n            logboost -= math.log(r / (r - 1))\n            \n        uncovered_mask = (cnt_array == 0)\n        if n_res > 0:\n            rem_zero = _cache[r][uncovered_mask]\n            cov_counts = np.bincount(rem_zero, minlength=r)\n        else:\n            cov_counts = np.zeros(r, dtype=int)\n            \n        unique_counts, count_freq = np.unique(cov_counts, return_counts=True)\n        \n        scores = []\n        score_drop = eval_score(n_res, logm, logboost)\n        scores.append(score_drop)\n        \n        logm_add = logm + math.log(r)\n        logboost_add = logboost + math.log(r / (r - 1))\n        for c in unique_counts:\n            scores.append(eval_score(n_res - c, logm_add, logboost_add))\n            \n        if temp > 1e-9:\n            min_score = min(scores)\n            weights = []\n            weights.append(math.exp(-(scores[0] - min_score) / temp))\n            for i, c in enumerate(unique_counts):\n                weights.append(count_freq[i] * math.exp(-(scores[i+1] - min_score) / temp))\n                \n            tot = sum(weights)\n            rnd = random.random() * tot\n            cum = 0.0\n            choice = len(weights) - 1\n            for i, w in enumerate(weights):\n                cum += w\n                if rnd <= cum:\n                    choice = i\n                    break\n        else:\n            min_score = min(scores)\n            best_indices = [i for i, s in enumerate(scores) if s == min_score]\n            choice = random.choice(best_indices)\n            \n        if choice == 0:\n            if was_in:\n                del congr_dict[r]\n        else:\n            c = unique_counts[choice - 1]\n            valid_a = (cov_counts == c).nonzero()[0]\n            a_new = int(random.choice(valid_a))\n            \n            congr_dict[r] = a_new\n            mask_new = (_cache[r] == a_new)\n            cnt_array += mask_new\n            n_res -