n        m_old = logm / LN10\n        boost = math.exp(logboost)\n        n_res = np.sum(cnt_array == 0)\n        ub_old = n_res * boost\n        \n        D_old = 0.5 * (m_old + math.sqrt(max(m_old**2 + 4.0 * ub_old / (LN10**2), 1e-9)))\n\n        factor = np.clip(t_temp, 0.0, 1.0)\n        p_opt = 0.85 - 0.45 * factor\n        p_add = 0.10 + 0.25 * factor\n        p_drop = 0.05 + 0.20 * factor\n\n        kind = random.random()\n        if not congr_dict:\n            action = \'add\'\n        else:\n            cand_pool = [m for m in cand_mods if m not in congr_dict]\n            if not cand_pool:\n                p_opt_cond = p_opt / (p_opt + p_drop)\n                action = \'optimize\' if kind < p_opt_cond else \'drop\'\n            else:\n                if n_res == 0:\n                    p_add_adj = 0.0\n                    p_opt_adj = p_opt / (p_opt + p_drop)\n                    p_drop_adj = p_drop / (p_opt + p_drop)\n                else:\n                    total_p = p_add + p_opt + p_drop\n                    p_add_adj = p_add / total_p\n                    p_opt_adj = p_opt / total_p\n                    p_drop_adj = p_drop / total_p\n\n                if kind < p_add_adj:\n                    action = \'add\'\n                elif kind < p_add_adj + p_opt_adj:\n                    action = \'optimize\'\n                else:\n                    action = \'drop\'\n\n        if action == \'add\':\n            cand_pool = [m for m in cand_mods if m not in congr_dict]\n            if cand_pool:\n                sample_size = min(300, len(cand_pool))\n                sampled_cands = random.sample(cand_pool, sample_size)\n                \n                uncovered_mask = (cnt_array == 0)\n                targets_uncovered = targets[uncovered_mask]\n                \n                candidates = []\n                for r in sampled_cands:\n                    if len(targets_uncovered) > 0:\n                        rem = targets_uncovered % r\n                        counts = np.bincount(rem, minlength=r)\n                        best_a = int(np.argmax(counts))\n                        new_covered = counts[best_a]\n                    else:\n                        best_a = 0\n                        new_covered = 0\n                    \n                    delta_m = math.log(r) / LN10\n                    delta_ub = boost * (n_res / (r - 1) - new_covered * r / (r - 1)) if r > 1 else 0.0\n                    \n                    m_new = m_old + delta_m\n                    ub_new = ub_old + delta_ub\n                    D_new = 0.5 * (m_new + math.sqrt(max(m_new**2 + 4.0 * ub_new / (LN10**2), 1e-9)))\n                    delta_D = D_new - D_old\n                    candidates.append((r, best_a, delta_D))\n                \n                if candidates:\n                    delta_Ds = np.array([c[2] for c in candidates])\n                    temp = max(t_temp, 1e-4)\n                    scaled_scores = -delta_Ds / temp\n                    scaled_scores = scaled_scores - np.max(scaled_scores)\n                    probs = np.exp(scaled_scores)\n                    probs /= np.sum(probs)\n                    \n                    idx = np.random.choice(len(candidates), p=probs)\n                    best_cand, best_a, _ = candidates[idx]\n                    \n                    congr_dict[best_cand] = int(best_a)\n                    is_covered = (targets % best_cand) == best_a\n                    cnt_array += is_covered\n                    logm += math.log(best_cand)\n                    logboost += math.log(best_cand / (best_cand - 1)) if best_cand > 1 else 0.0\n\n        elif action == \'optimize\':\n            mods_in = list(congr_dict.keys())\n            if mods_in:\n                sample_opt = random.sample(mods_in, min(100, len(mods_in)))\n                \n                uncovered_mask = (cnt_array == 0)\n                unique_mask = (cnt_array == 1)\n                targets_uncovered = targets[uncovered_mask]\n                targets_unique = targets[unique_mask]\n                \n                candidates = []\n                for r in sample_opt:\n                    a_old = congr_dict[r]\n                    if len(targets_unique) > 0:\n                        uncovered_by_drop = targets_unique[(targets_unique % r) == a_old]\n                        if len(targets_uncovered) > 0:\n                            bg_uncovered = np.concatenate([targets_uncovered, uncovered_by_drop])\n                        else:\n                            bg_uncovered = uncovered_by_drop\n                    else:\n                        bg_uncovered = targets_uncovered\n                        \n                    if len(bg_uncovered) > 0:\n                        counts = np.bincount(bg_uncovered % r, minlength=r)\n                    else:\n                        counts = np.zeros(r, dtype=np.int64)\n                        \n                    nz_indices = np.flatnonzero(counts)\n                    valid_as = set(nz_indices)\n                    valid_as.add(a_old)\n                    \n                    for a in valid_as:\n                        delta_ub = boost * (counts[a_old] - counts[a])\n                        ub_new = ub_old + delta_ub\n                        D_new = 0.5 * (m_old + math.sqrt(max(m_old**2 + 4.0 * ub_new / (LN10**2), 1e-9)))\n                        delta_D = D_new - D_old\n                        candidates.append((r, a, delta_D))\n                    \n                if candidates:\n                    delta_Ds = np.array([c[2] for c in candidates])\n                    temp = max(t_temp, 1e-4)\n                    scaled_scores = -delta_Ds / temp\n                    scaled_scores = scaled_scores - np.max(scaled_scores)\n                    probs = np.exp(scaled_scores)\n                    probs /= np.sum(probs)\n                    \n                    idx = np.random.choice(len(candidates), p=probs)\n                    r_opt, a_