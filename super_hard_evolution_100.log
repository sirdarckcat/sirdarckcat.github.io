 def get_mod_array(r):\n        if r not in cache:\n            cache[r] = (targets % r).astype(np.int32)\n        return cache[r]\n\n    LN10 = np.log(10)\n    LN10_SQ = LN10 * LN10\n\n    def compute_D(lm, lb, nr):\n        m_d = lm / LN10\n        ub = nr * np.exp(lb)\n        return (m_d + np.sqrt(max(0.0, m_d**2 + 4 * ub / LN10_SQ))) / 2.0\n\n    # Initialize local search state\n    cnt = cnt_array.copy()\n    current_logm = logm\n    current_logboost = logboost\n    \n    uncovered_indices = np.where(cnt == 0)[0]\n    n_res = len(uncovered_indices)\n    current_D = compute_D(current_logm, current_logboost, n_res)\n\n    best_overall_dict = congr_dict.copy()\n    best_overall_D = current_D\n\n    def biased_sample_add(population, k):\n        n = len(population)\n        if n <= k:\n            return population\n        indices = set()\n        while len(indices) < k:\n            idx = int(n * (random.random() ** 1.8))\n            indices.add(idx)\n        return [population[i] for i in sorted(indices)]\n\n    def biased_sample_drop(population, k):\n        n = len(population)\n        if n <= k:\n            return population\n        indices = set()\n        while len(indices) < k:\n            idx = int(n * (1.0 - random.random() ** 1.8))\n            indices.add(idx)\n        return [population[i] for i in sorted(indices)]\n\n    # Run a highly efficient internal simulated annealing search of 1500 micro-steps\n    steps = 1500\n    for step in range(steps):\n        # Cool down the internal temperature\n        frac = step / steps\n        temp = max(t_temp * (0.12 ** frac), 1e-5)\n\n        # Dynamic action probabilities (exploration early, exploitation late)\n        p_add = 0.55 * (1.0 - 0.6 * frac)\n        p_drop = 0.15 * (1.0 - 0.5 * frac)\n        r_val = random.random()\n\n        if r_val < p_add:\n            # TRY ADD\n            cand_pool = [m for m in cand_mods if m not in congr_dict]\n            if cand_pool:\n                sampled = biased_sample_add(cand_pool, min(40, len(cand_pool)))\n                best_r, best_a, best_D = None, None, float(\'inf\')\n                best_cov = 0\n\n                for r in sampled:\n                    rem = get_mod_array(r)\n                    rem_uncovered = rem[uncovered_indices]\n                    counts = np.bincount(rem_uncovered, minlength=r)\n                    a = int(np.argmax(counts))\n                    cov = int(counts[a])\n\n                    new_logm = current_logm + np.log(r)\n                    new_logboost = current_logboost + np.log(r / (r - 1.0))\n                    new_n_res = n_res - cov\n                    new_D = compute_D(new_logm, new_logboost, new_n_res)\n\n                    if new_D < best_D:\n                        best_D = new_D\n                        best_r = r\n                        best_a = a\n                        best_cov = cov\n\n                if best_r is not None:\n                    if best_D < current_D or random.random() < np.exp((current_D - best_D) / temp):\n                        congr_dict[best_r] = best_a\n                        rem = get_mod_array(best_r)\n                        cnt[rem == best_a] += 1\n                        current_logm += np.log(best_r)\n                        current_logboost += np.log(best_r / (best_r - 1.0))\n                        \n                        uncovered_indices = np.where(cnt == 0)[0]\n                        n_res = len(uncovered_indices)\n                        current_D = best_D\n\n        elif r_val < p_add + p_drop:\n            # TRY DROP\n            if congr_dict:\n                sorted_keys = sorted(list(congr_dict.keys()))\n                sampled = biased_sample_drop(sorted_keys, min(30, len(sorted_keys)))\n                best_r, best_D = None, float(\'inf\')\n                best_revealed = 0\n\n                for r in sampled:\n                    rem = get_mod_array(r)\n                    a = congr_dict[r]\n                    revealed = int(np.sum(cnt[rem == a] == 1))\n\n                    new_logm = current_logm - np.log(r)\n                    new_logboost = current_logboost - np.log(r / (r - 1.0))\n                    new_n_res = n_res + revealed\n                    new_D = compute_D(new_logm, new_logboost, new_n_res)\n\n                    if new_D < best_D:\n                        best_D = new_D\n                        best_r = r\n                        best_revealed = revealed\n\n                if best_r is not None:\n                    if best_D < current_D or random.random() < np.exp((current_D - best_D) / temp):\n                        a_drop = congr_dict[best_r]\n                        rem = get_mod_array(best_r)\n                        cnt[rem == a_drop] -= 1\n                        del congr_dict[best_r]\n                        current_logm -= np.log(best_r)\n                        current_logboost -= np.log(best_r / (best_r - 1.0))\n                        \n                        uncovered_indices = np.where(cnt == 0)[0]\n                        n_res = len(uncovered_indices)\n                        current_D = best_D\n\n        else:\n            # TRY SWAP / OPTIMIZE CONGRUENCE CLASSES\n            if congr_dict:\n                sampled = random.sample(list(congr_dict.keys()), min(20, len(congr_dict)))\n                best_r, best_a, best_D = None, None, float(\'inf\')\n\n                for r in sampled:\n                    rem = get_mod_array(r)\n                    a_old = congr_dict[r]\n\n                    # Temporarily remove\n                    cnt[rem == a_old] -= 1\n                    temp_uncovered = np.where(cnt == 0)[0]\n\n                    counts = np.bincount(rem[temp_uncovered], minlength=r)\n                    a_new = int(np.argmax(counts))\n                    cov = int(counts[a_new])\n\n                    new_n_res = len(temp_uncovered) - cov\n                    new_D = compute_D(current_logm, current_logboost, new_n_res)\n\n                    # Restore\n                    cnt[rem == a_old] += 1\n\n                    if new_D < best_D:\n                        best_D = new_D\n                        best_r = r\n                        best_a = a_new\n\n                if best_r is not None:\n                    if best_D < current_D or random.random() < np.exp((current_D - best_D) / temp):\n                        a_old = congr_dict[best_r]\n                        rem = get_mod_array(best_r)\n\n                        cnt[rem == a_old] -= 1\n                        cnt[rem == best_a] += 1\n                        congr_dict[best_r] = best_a\n\n                        uncovered_indices = np.where(cnt == 0)[0]\n                        n_res = len(uncovered_indices)\n                        current_D = best_D\n\n        # Keep track of the elite overall configuration visited\n        if current_D < best_overall_D:\n            best_overall_D = current_D\n            best_overall_dict = congr_dict.copy()\n\n    return best_overall_dict\n# EVOLVE-BLOCK-END\n\ndef evaluate(eval_inputs: Mapping[str, Any]) -> dict[str, float]:\n    """Run evaluation on the optimized step."""\n    # Let\'s say we maximize -n_digits_est (smaller estimated N-size)\n    # Using sympy/math to compute est digits\n    import sympy\n    import numpy as np\n    Q = 100003\n    targets = np.array(list(sympy.primerange(3, Q)), dtype=np.int64)\n    # Let\'s run the optimize_cover_step starting from empty cover for some iterations\n    congr_dict = {}\n    cand_mods = [int(r) for r in sympy.primerange(3, 8000)]\n    cnt_array = np.zeros(len(targets), dtype=np.int16)\n    logm = math.log(2)\n    logboost = math.log(2.0)\n    \n    for it in range(10):\n        t_temp = 0.8 * (0.02 / 0.8) ** (it / 10)\n        # Update cnt_array based on congr_dict\n        cnt_array = np.zeros(len(targets), dtype=np.int16)\n        logm = math.log(2)\n        logboost = math.log(2.0)\n        for r, a in congr_dict.items():\n            cnt_array += (targets % r) == a\n            logm += math.log(r)\n            logboost += math.log(r / (r - 1))\n            \n        congr_dict = optimize_cover_step(congr_dict, cand_mods, targets, cnt_array, logm, logboost, t_temp)\n        \n    # Recalculate final metrics\n    cnt_array = np.zeros(len(targets), dtype=np.int16)\n    logm = math.log(2)\n    logboost = math.log(2.0)\n    for r, a in congr_dict.items():\n        cnt_array += (targets % r) == a\n        logm += math.log(r)\n        logboost += math.log(r / (r - 1))\n        \n    n_res = int((cnt_array == 0).sum())\n    boost = math.exp(logboost)\n    m_digits = logm / math.log(10)\n    \n    ub = n_res * boost\n    LN10 = math.log(10)\n    D = (m_digits + math.sqrt(m_digits ** 2 + 4 * ub / (LN10 * LN10))) / 2\n    return {"neg_est_digits": -float(D)}\n'}]}, 'evaluation': {'scores': {'scores': [{'metric': 'neg_est_digits', 'score': -50.655006}]}}, 'parentPrograms': ['projects/799795028847/locations/global/collections/default_collection/engines/goldbach_1784979910032/sessions/7013217697778074030/alphaEvolveExperiments/15164875354338173448/alphaEvolvePrograms/18102573509735108844'], 'state': 'COMPLETED'}, {'name': 'projects/799795028847/locations/global/collections/default_collection/engines/goldbach_1784979910032/sessions/7013217697778074030/alphaEvolveExperiments/15164875354338173448/alphaEvolvePrograms/18102573509735110176', 'createTime': '2026-07-25T19:41:14.330079Z', 'content': {'files': [{'path': 'program.py', 'content': '# Copyright 2026 Google LLC\nfrom typing import Any, Mapping\nimport math\nimport random\nimport numpy as np\n\n# EVOLVE-BLOCK-START\ndef optimize_cover_step(congr_dict, cand_mods, targets, cnt_array, logm, logboost, t_temp):\n    """Optimize a single step of congruence cover using simulated annealing style logic.\n\n    Args:\n        congr_dict: Dictionary of r -> a\n        cand_mods: List of prime candidates\n        targets: np.array of target primes\n        cnt_array: np.array of coverage counts\n        logm: current log of modulus M\n        logboost: current log of boost factor\n        t_temp: current temperature\n\n    Returns:\n        Updated congr_dict\n    """\n    import numpy as np\n    import random\n    import math\n\n    if len(targets) == 0:\n        # Safety fallback\n        kind = random.random()\n        r_in = random.choice(list(congr_dict)) if congr_dict else None\n        if kind < 0.5 and r_in is not None:\n            a_old = congr_dict[r_in]\n            a_new = random.randint(0, r_in - 1)\n            if a_new != a_old:\n                congr_dict[r_in] = a_new\n        elif kind < 0.7 and r_in is not None:\n            del congr_dict[r_in]\n        else:\n            r_out = random.choice(cand_mods)\n            if r_out not in congr_dict:\n                a_new = random.randint(0, r_out - 1)\n                congr_dict[r_out] = a_new\n        return congr_dict\n\n    def calc_D(log_m, log_boost, n_uncovered):\n        LN10 = 2.302585092994046\n        m_digits = log_m / LN10\n        ub = n_uncovered * math.exp(log_boost)\n        val = m_digits**2 + 4.0 * ub / (LN10 * LN10)\n        if val < 0:\n            val = 0.0\n        return 0.5 * (m_digits + math.sqrt(val))\n\n    best_congr_dict = congr_dict.copy()\n    n_res_curr = np.sum(cnt_array == 0)\n    best_D = calc_D(logm, logboost, n_res_curr)\n\n    # We run multiple internal steps of thermodynamic/probabilistic transition\n    # to significantly accelerate finding the optimal congruence cover.\n    num_internal_steps = 150\n    for step_idx in range(num_internal_steps):\n        n_res_curr = np.sum(cnt_array == 0)\n        D_curr = calc_D(logm, logboost, n_res_curr)\n        \n        moves = []  # list of (type, data, D_new)\n        moves.append((\'none\', None, D_curr))\n        \n        # 1. Propose ADD moves\n        cand_pool = [m for m in cand_mods if m not in congr_dict]\n        add_evals = []\n        if cand_pool:\n            cand_pool_arr = np.array(cand_pool, dtype=np.int64)\n            # Bias selection towards smaller moduli using 1.0 / r weights\n            r_weights = 1.0 / cand_pool_arr\n            r_weights /= np.sum(r_weights)\n            \n            sample_size = min(150, len(cand_pool))\n            sampled_adds = np.random.choice(cand_pool_arr, size=sample_size, replace=False, p=r_weights)\n            \n            uncovered_targets = targets[cnt_array == 0]\n            if len(uncovered_targets) > 0:\n                for r in sampled_adds:\n                    counts = np.bincount(uncovered_targets % r, minlength=r)\n                    a_best = int(np.argmax(counts))\n                    num_covered = counts[a_best]\n                    \n                    n_res_new = n_res_curr - num_covered\n                    logm_new = logm + math.log(r)\n                    logboost_new = logboost + math.log(r / (r - 1))\n                    D_new = calc_D(logm_new, logboost_new, n_res_new)\n                    moves.append((\'add\', (r, a_best), D_new))\n                    add_evals.append((r, a_best, D_new))\n            else:\n                for r in sampled_adds:\n                    logm_new = logm + math.log(r)\n                    logboost_new = logboost + math.log(r / (r - 1))\n                    D_new = calc_D(logm_new, logboost_new, 0)\n                    moves.append((\'add\', (r, 0), D_new))\n                    add_evals.append((r, 0, D_new))\n                    \n        # 2 & 3. Propose OPTIMIZE and DROP moves\n        drop_evals = []\n        for r, a_old in list(congr_dict.items()):\n            cnt_bg = cnt_array - (targets % r == a_old)\n            uncovered_bg = targets[cnt_bg == 0]\n            n_res_drop = len(uncovered_bg)\n            \n            # DROP move\n            logm_drop = logm - math.log(r)\n            logboost_drop = logboost - math.log(r / (r - 1))\n            D_drop = calc_D(logm_drop, logboost_drop, n_res_drop)\n            moves.append((\'drop\', (r, a_old), D_drop))\n            drop_evals.append((r, a_old, n_res_drop, D_drop, cnt_bg))\n            \n            # OPTIMIZE move\n            if n_res_drop > 0:\n                counts = np.bincount(uncovered_bg % r, minlength=r)\n                a_new = int(np.argmax(counts))\n                num_covered = counts[a_new]\n                n_res_opt = n_res_drop - num_covered\n            else:\n                a_new = 0\n                n_res_opt = 0\n                \n            if a_new != a_old:\n                D_opt = calc_D(logm, logboost, n_res_opt)\n                moves.append((\'optimize\', (r, a_new), D_opt))\n\n        # 4. Propose SWAP moves (Swap an existing prime out for a new one)\n        if drop_evals and add_evals:\n            drop_evals.sort(key=lambda x: x[3])\n            add_evals.sort(key=lambda x: x[2])\n            \n            # Form synergistic pairs of the best drop candidates and best add candidates\n            top_drops = drop_evals[:20]\n            top_adds = [x[0] for x in add_evals[:20]]\n            \n            for drop_info in top_drops:\n                r_d, a_old, drop_n_res, drop_D, cnt_bg = drop_info\n                uncovered_bg = targets[cnt_bg == 0]\n                \n                if len(uncovered_bg) > 0:\n                    for r_a in top_adds:\n                        r_a = int(r_a)\n                        counts = np.bincount(uncovered_bg % r_a, minlength=r_a)\n                        a_new = int(np.argmax(counts))\n                        num_covered = counts[a_new]\n                        n_res_new = len(uncovered_bg) - num_covered\n                        \n                        logm_new = logm - math.log(r_d) + math.log(r_a)\n                        logboost_new = logboost - math.log(r_d / (r_d - 1)) + math.log(r_a / (r_a - 1))\n                        D_new = calc_D(logm_new, logboost_new, n_res_new)\n                        moves.append((\'swap\', (r_d, r_a, a_new), D_new))\n                else:\n                    for r_a in top_adds:\n                        r_a = int(r_a)\n                        a_new = 0\n                        n_res_new = 0\n                        \n                        logm_new = logm - math.log(r_d) + math.log(r_a)\n                        logboost_new = logboost - math.log(r_d / (r_d - 1)) + math.log(r_a / (r_a - 1))\n                        D_new = calc_D(logm_new, logboost_new, n_res_new)\n                        moves.append((\'swap\', (r_d, r_a, a_new), D_new))\n            \n        if len(moves) == 1:\n            break\n            \n        # Select move using Gibbs/Boltzmann distribution over the objective values\n        scores = np.array([-m[2] for m in moves])\n        \n        # Mini simulated annealing temperature schedule inside each macro step\n        temp_fraction = step_idx / num_internal_steps\n        internal_temp = max(t_temp * (1.0 - 0.95 * temp_fraction), 1e-5)\n        \n        scaled_scores = scores / internal_temp\n        scaled_scores -= np.max(scaled_scores)\n        probs = np.exp(scaled_scores)\n        probs /= np.sum(probs)\n        \n        idx = np.random.choice(len(moves), p=probs)\n        chosen_move = moves[idx]\n        \n        # Apply chosen move\n        m_type, m_data, D_new = chosen_move\n        \n        if m_type == \'add\':\n            r, a = m_data\n            r = int(r); a = int(a)\n            congr_dict[r] = a\n            cnt_array += (targets % r) == a\n            logm += math.log(r)\n            logboost += math.log(r / (r - 1))\n        elif m_type == \'optimize\':\n            r, a = m_data\n            r = int(r); a = int(a)\n            a_old = congr_dict[r]\n            cnt_array -= (targets % r) == a_old\n            cnt_array += (targets % r) == a\n            congr_dict[r] = a\n        elif m_type == \'drop\':\n            r, a = m_data\n            r = int(r); a = int(a)\n            cnt_array -= (targets % r) == a\n            logm -= math.log(r)\n            logboost -= math.log(r / (r - 1))\n            del congr_dict[r]\n        elif m_type == \'swap\':\n            r_d, r_a, a_new = m_data\n            r_d = int(r_d); r_a = int(r_a); a_new = int(a_new)\n            a_old = congr_dict[r_d]\n            \n            cnt_array -= (targets % r_d) == a_old\n            logm -= math.log(r_d)\n            logboost -= math.log(r_d / (r_d - 1))\n            del congr_dict[r_d]\n            \n            congr_dict[r_a] = a_new\n            cnt_array += (targets % r_a) == a_new\n            logm += math.log(r_a)\n            logboost += math.log(r_a / (r_a - 1))\n\n        # Explicit elitism tracking ensures returning optimal minimum\n        if D_new < best_D:\n            best_D = D_new\n            best_congr_dict = congr_dict.copy()\n\n    # Update in place to best state found\n    congr_dict.clear()\n    congr_dict.update(best_congr_dict)\n    return congr_dict\n# EVOLVE-BLOCK-END\n\ndef evaluate(eval_inputs: Mapping[str, Any]) -> dict[str, float]:\n    """Run evaluation on the optimized step."""\n    # Let\'s say we maximize -n_digits_est (smaller estimated N-size)\n    # Using sympy/math to compute est digits\n    import sympy\n    import numpy as np\n    Q = 100003\n    targets = np.array(list(sympy.primerange(3, Q)), dtype=np.int64)\n    # Let\'s run the optimize_cover_step starting from empty cover for some iterations\n    congr_dict = {}\n    cand_mods = [int(r) for r in sympy.primerange(3, 8000)]\n    cnt_array = np.zeros(len(targets), dtype=np.int16)\n    logm = math.log(2)\n    logboost = math.log(2.0)\n    \n    for it in range(10):\n        t_temp = 0.8 * (0.02 / 0.8) ** (it / 10)\n        # Update cnt_array based on congr_dict\n        cnt_array = np.zeros(len(targets), dtype=np.int16)\n        logm = math.log(2)\n        logboost = math.log(2.0)\n        for r, a in congr_dict.items():\n            cnt_array += (targets % r) == a\n            logm += math.log(r)\n            logboost += math.log(r / (r - 1))\n            \n        congr_dict = optimize_cover_step(congr_dict, cand_mods, targets, cnt_array, logm, logboost, t_temp)\n        \n    # Recalculate final metrics\n    cnt_array = np.zeros(len(targets), dtype=np.int16)\n    logm = math.log(2)\n    logboost = math.log(2.0)\n    for r, a in congr_dict.items():\n        cnt_array += (targets % r) == a\n        logm += math.log(r)\n        logboost += math.log(r / (r - 1))\n        \n    n_res = int((cnt_array == 0).sum())\n    boost = math.exp(logboost)\n    m_digits = logm / math.log(10)\n    \n    ub = n_res * boost\n    LN10 = math.log(10)\n    D = (m_digits + math.sqrt(m_digits ** 2 + 4 * ub / (LN10 * LN10))) / 2\n    return {"neg_est_digits": -float(D)}\n'}]}, 'evaluation': {'scores': {'scores': [{'metric': 'neg_est_digits', 'score': -50.655006}]}}, 'parentPrograms': ['projects/799795028847/locations/global/collections/default_collection/engines/goldbach_1784979910032/sessions/7013217697778074030/alphaEvolveExperiments/15164875354338173448/alphaEvolvePrograms/18102573509735108916'], 'state': 'COMPLETED'}, {'name': 'projects/799795028847/locations/global/collections/default_collection/engines/goldbach_1784979910032/sessions/7013217697778074030/alphaEvolveExperiments/15164875354338173448/alphaEvolvePrograms/18102573509735110858', 'createTime': '2026-07-25T19:41:14.330079Z', 'content': {'files': [{'path': 'program.py', 'content': '# Copyright 2026 Google LLC\nfrom typing import Any, Mapping\nimport math\nimport random\nimport numpy as np\n\n# EVOLVE-BLOCK-START\ndef optimize_cover_step(congr_dict, cand_mods, targets, cnt_array, logm, logboost, t_temp):\n    """Optimize a single step of congruence cover using simulated annealing style logic.\n\n    Args:\n        congr_dict: Dictionary of r -> a\n        cand_mods: List of prime candidates\n        targets: np.array of target primes\n        cnt_array: np.array of coverage counts\n        logm: current log of modulus M\n        logboost: current log of boost factor\n        t_temp: current temperature\n\n    Returns:\n        Updated congr_dict\n    """\n    import numpy as np\n    import random\n    import math\n\n    if len(targets) == 0:\n        # Safety fallback\n        kind = random.random()\n        r_in = random.choice(list(congr_dict)) if congr_dict else None\n        if kind < 0.5 and r_in is not None:\n            a_old = congr_dict[r_in]\n            a_new = random.randint(0, r_in - 1)\n            if a_new != a_old:\n                congr_dict[r_in] = a_new\n        elif kind < 0.7 and r_in is not None:\n            del congr_dict[r_in]\n        else:\n            r_out = random.choice(cand_mods)\n            if r_out not in congr_dict:\n                a_new = random.randint(0, r_out - 1)\n                congr_dict[r_out] = a_new\n        return congr_dict\n\n    def calc_D(log_m, log_boost, n_uncovered):\n        LN10 = 2.302585092994046\n        m_digits = log_m / LN10\n        ub = n_uncovered * math.exp(log_boost)\n        val = m_digits**2 + 4.0 * ub / (LN10 * LN10)\n        if val < 0:\n            val = 0.0\n        return 0.5 * (m_digits + math.sqrt(val))\n\n    best_congr_dict = congr_dict.copy()\n    n_res_curr = np.sum(cnt_array == 0)\n    best_D = calc_D(logm, logboost, n_res_curr)\n\n    # Simplified and highly optimized thermodynamic search logic\n    num_internal_steps = 350\n    for step_idx in range(num_internal_steps):\n        uncovered_targets = targets[cnt_array == 0]\n        covered_once_targets = targets[cnt_array == 1]\n        n_res_curr = len(uncovered_targets)\n        \n        D_curr = calc_D(logm, logboost, n_res_curr)\n        \n        # Local cooling schedule within the search step\n        curr_temp = max(t_temp * (0.1 ** (step_idx / num_internal_steps)), 1e-4)\n        \n        # Select one class of actions to explore per step, saving huge computational cost\n        action_types = [\'add\', \'drop\', \'swap\', \'optimize\']\n        action_probs = [0.35, 0.15, 0.40, 0.10]\n        action = np.random.choice(action_types, p=action_probs)\n        \n        moves = [(\'none\', None, D_curr)]\n        \n        if action == \'add\':\n            cand_pool = [m for m in cand_mods if m not in congr_dict]\n            if cand_pool:\n                cand_pool_arr = np.array(cand_pool, dtype=np.int64)\n                r_weights = 1.0 / cand_pool_arr\n                r_weights /= np.sum(r_weights)\n                \n                sample_size = min(12, len(cand_pool))\n                sampled_adds = np.random.choice(cand_pool_arr, size=sample_size, replace=False, p=r_weights)\n                \n                if len(uncovered_targets) > 0:\n                    for r in sampled_adds:\n                        counts = np.bincount(uncovered_targets % r, minlength=r)\n                        a_best = int(np.argmax(counts))\n                        num_covered = counts[a_best]\n                        \n                        n_res_new = n_res_curr - num_covered\n                        logm_new = logm + math.log(r)\n                        logboost_new = logboost + math.log(r / (r - 1))\n                        D_new = calc_D(logm_new, logboost_new, n_res_new)\n                        moves.append((\'add\', (r, a_best), D_new))\n                else:\n                    for r in sampled_adds:\n                        logm_new = logm + math.log(r)\n                        logboost_new = logboost + math.log(r / (r - 1))\n                        D_new = calc_D(logm_new, logboost_new, 0)\n                        moves.append((\'add\', (r, 0), D_new))\n                        \n        elif action == \'drop\' and congr_dict:\n            drop_cands = list(congr_dict.keys())\n            sample_size = min(8, len(drop_cands))\n            sampled_drops = random.sample(drop_cands, sample_size)\n            for r in sampled_drops:\n                a_old = congr_dict[r]\n                num_newly_uncovered = np.sum(covered_once_targets % r == a_old)\n                n_res_new = n_res_curr + num_newly_uncovered\n                logm_new = logm - math.log(r)\n                logboost_new = logboost - math.log(r / (r - 1))\n                D_new = calc_D(logm_new, logboost_new, n_res_new)\n                moves.append((\'drop\', (r, a_old), D_new))\n                \n        elif action == \'swap\' and congr_dict:\n            cand_pool = [m for m in cand_mods if m not in congr_dict]\n            if cand_pool:\n                cand_pool_arr = np.array(cand_pool, dtype=np.int64)\n                r_weights = 1.0 / cand_pool_arr\n                r_weights /= np.sum(r_weights)\n                \n                drop_cands = list(congr_dict.keys())\n                sample_size = 12\n                swap_adds = np.random.choice(cand_pool_arr, size=sample_size, replace=True, p=r_weights)\n                swap_drops = np.random.choice(drop_cands, size=sample_size, replace=True)\n                \n                for r_d, r_a in zip(swap_drops, swap_adds):\n                    r_d = int(r_d)\n                    r_a = int(r_a)\n                    if r_d == r_a:\n                        continue\n                    a_old = congr_dict[r_d]\n                    \n                    newly_uncovered = covered_once_targets[covered_once_targets % r_d == a_old]\n                    n_res_new_base = n_res_curr + len(newly_uncovered)\n                    \n                    counts = np.bincount(uncovered_targets % r_a, minlength=r_a)\n                    if len(newly_uncovered) > 0:\n                        counts += np.bincount(newly_uncovered % r_a, minlength=r_a)\n                    a_new = int(np.argmax(counts))\n                    n_res_new = n_res_new_base - counts[a_new]\n                    \n                    logm_new = logm - math.log(r_d) + math.log(r_a)\n                    logboost_new = logboost - math.log(r_d / (r_d - 1)) + math.log(r_a / (r_a - 1))\n                    D_new = calc_D(logm_new, logboost_new, n_res_new)\n                    moves.append((\'swap\', (r_d, r_a, a_new), D_new))\n                    \n        elif action == \'optimize\' and congr_dict:\n            opt_cands = list(congr_dict.keys())\n            sample_size = min(8, len(opt_cands))\n            sampled_opts = random.sample(opt_cands, sample_size)\n            for r in sampled_opts:\n                a_old = congr_dict[r]\n                counts = np.bincount(uncovered_targets % r, minlength=r)\n                num_newly_uncovered = np.sum(covered_once_targets % r == a_old)\n                counts[a_old] += num_newly_uncovered\n                \n                a_new = int(np.argmax(counts))\n                n_res_new = n_res_curr + num_newly_uncovered - counts[a_new]\n                \n                if a_new != a_old:\n                    D_new = calc_D(logm, logboost, n_res_new)\n                    moves.append((\'optimize\', (r, a_new), D_new))\n            \n        if len(moves) == 1:\n            continue\n            \n        # Select move using Gibbs/Boltzmann distribution over the objective values\n        scores = np.array([-m[2] for m in moves])\n        scaled_scores = scores / curr_temp\n        scaled_scores -= np.max(scaled_scores)\n        probs_move = np.exp(scaled_scores)\n        probs_move /= np.sum(probs_move)\n        \n        idx = np.random.choice(len(moves), p=probs_move)\n        chosen_move = moves[idx]\n        \n        # Apply chosen move\n        m_type, m_data, D_new = chosen_move\n        \n        if m_type == \'add\':\n            r, a = m_data\n            r = int(r); a = int(a)\n            congr_dict[r] = a\n            cnt_array += (targets % r) == a\n            logm += math.log(r)\n            logboost += math.log(r / (r - 1))\n        elif m_type == \'optimize\':\n            r, a = m_data\n            r = int(r); a = int(a)\n            a_old = congr_dict[r]\n            cnt_array -= (targets % r) == a_old\n            cnt_array += (targets % r) == a\n            congr_dict[r] = a\n        elif m_type == \'drop\':\n            r, a = m_data\n            r = int(r); a = int(a)\n            cnt_array -= (targets % r) == a\n            logm -= math.log(r)\n            logboost -= math.log(r / (r - 1))\n            del congr_dict[r]\n        elif m_type == \'swap\':\n            r_d, r_a, a_new = m_data\n            r_d = int(r_d); r_a = int(r_a); a_new = int(a_new)\n            a_old = congr_dict[r_d]\n            \n            cnt_array -= (targets % r_d) == a_old\n            logm -= math.log(r_d)\n            logboost -= math.log(r_d / (r_d - 1))\n            del congr_dict[r_d]\n            \n            congr_dict[r_a] = a_new\n            cnt_array += (targets % r_a) == a_new\n            logm += math.log(r_a)\n            logboost += math.log(r_a / (r_a - 1))\n\n        # Explicit elitism tracking ensures returning optimal minimum\n        if D_new < best_D:\n            best_D = D_new\n            best_congr_dict = congr_dict.copy()\n\n    # Update in place to best state found\n    congr_dict.clear()\n    congr_dict.update(best_congr_dict)\n    return congr_dict\n# EVOLVE-BLOCK-END\n\ndef evaluate(eval_inputs: Mapping[str, Any]) -> dict[str, float]:\n    """Run evaluation on the optimized step."""\n    # Let\'s say we maximize -n_digits_est (smaller estimated N-size)\n    # Using sympy/math to compute est digits\n    import sympy\n    import numpy as np\n    Q = 100003\n    targets = np.array(list(sympy.primerange(3, Q)), dtype=np.int64)\n    # Let\'s run the optimize_cover_step starting from empty cover for some iterations\n    congr_dict = {}\n    cand_mods = [int(r) for r in sympy.primerange(3, 8000)]\n    cnt_array = np.zeros(len(targets), dtype=np.int16)\n    logm = math.log(2)\n    logboost = math.log(2.0)\n    \n    for it in range(10):\n        t_temp = 0.8 * (0.02 / 0.8) ** (it / 10)\n        # Update cnt_array based on congr_dict\n        cnt_array = np.zeros(len(targets), dtype=np.int16)\n        logm = math.log(2)\n        logboost = math.log(2.0)\n        for r, a in congr_dict.items():\n            cnt_array += (targets % r) == a\n            logm += math.log(r)\n            logboost += math.log(r / (r - 1))\n            \n        congr_dict = optimize_cover_step(congr_dict, cand_mods, targets, cnt_array, logm, logboost, t_temp)\n        \n    # Recalculate final metrics\n    cnt_array = np.zeros(len(targets), dtype=np.int16)\n    logm = math.log(2)\n    logboost = math.log(2.0)\n    for r, a in congr_dict.items():\n        cnt_array += (targets % r) == a\n        logm += math.log(r)\n        logboost += math.log(r / (r - 1))\n        \n    n_res = int((cnt_array == 0).sum())\n    boost = math.exp(logboost)\n    m_digits = logm / math.log(10)\n    \n    ub = n_res * boost\n    LN10 = math.log(10)\n    D = (m_digits + math.sqrt(m_digits ** 2 + 4 * ub / (LN10 * LN10))) / 2\n    return {"neg_est_digits": -float(D)}\n'}]}, 'evaluation': {'scores': {'scores': [{'metric': 'neg_est_digits', 'score': -50.655006}]}}, 'parentPrograms': ['projects/799795028847/locations/global/collections/default_collection/engines/goldbach_1784979910032/sessions/7013217697778074030/alphaEvolveExperiments/15164875354338173448/alphaEvolvePrograms/18102573509735108916'], 'state': 'COMPLETED'}, {'name': 'projects/799795028847/locations/global/collections/default_collection/engines/goldbach_1784979910032/sessions/7013217697778074030/alphaEvolveExperiments/15164875354338173448/alphaEvolvePrograms/18102573509735112254', 'createTime': '2026-07-25T19:38:51.553580Z', 'content': {'files': [{'path': 'program.py', 'content': '# Copyright 2026 Google LLC\nfrom typing import Any, Mapping\nimport math\nimport random\nimport numpy as np\n\n# EVOLVE-BLOCK-START\ndef optimize_cover_step(congr_dict, cand_mods, targets, cnt_array, logm, logboost, t_temp):\n    """Optimize a single step of congruence cover using simulated annealing style logic.\n\n    Args:\n        congr_dict: Dictionary of r -> a\n        cand_mods: List of prime candidates\n        targets: np.array of target primes\n        cnt_array: np.array of coverage counts\n        logm: current log of modulus M\n        logboost: current log of boost factor\n        t_temp: current temperature\n\n    Returns:\n        Updated congr_dict\n    """\n    import numpy as np\n    import random\n    import math\n\n    if len(targets) == 0:\n        # Safety fallback\n        kind = random.random()\n        r_in = random.choice(list(congr_dict)) if congr_dict else None\n        if kind < 0.5 and r_in is not None:\n            a_old = congr_dict[r_in]\n            a_new = random.randint(0, r_in - 1)\n            if a_new != a_old:\n                congr_dict[r_in] = a_new\n        elif kind < 0.7 and r_in is not None:\n            del congr_dict[r_in]\n        else:\n            r_out = random.choice(cand_mods)\n            if r_out not in congr_dict:\n                a_new = random.randint(0, r_out - 1)\n                congr_dict[r_out] = a_new\n        return congr_dict\n\n    def calc_D(log_m, log_boost, n_uncovered):\n        LN10 = 2.302585092994046\n        m_digits = log_m / LN10\n        ub = n_uncovered * math.exp(log_boost)\n        val = m_digits**2 + 4.0 * ub / (LN10 * LN10)\n        if val < 0:\n            val = 0.0\n        return 0.5 * (m_digits + math.sqrt(val))\n\n    best_congr_dict = congr_dict.copy()\n    n_res_curr = np.sum(cnt_array == 0)\n    best_D = calc_D(logm, logboost, n_res_curr)\n\n    # We run multiple internal steps of thermodynamic/probabilistic transition\n    # to significantly accelerate finding the optimal congruence cover.\n    num_internal_steps = 400\n    for step_idx in range(num_internal_steps):\n        n_res_curr = np.sum(cnt_array == 0)\n        D_curr = calc_D(logm, logboost, n_res_curr)\n        \n        moves = []  # list of (type, data, D_new)\n        moves.append((\'none\', None, D_curr))\n        \n        # 1. Propose ADD moves\n        cand_pool = [m for m in cand_mods if m not in congr_dict]\n        if cand_pool:\n            cand_pool_arr = np.array(cand_pool, dtype=np.int64)\n            # Bias selection towards smaller moduli scaling by roughly 1/(r*log(r))\n            r_weights = 1.0 / (cand_pool_arr * np.log(cand_pool_arr))\n            r_weights /= np.sum(r_weights)\n            \n            sample_size = min(150, len(cand_pool))\n            sampled_adds = np.random.choice(cand_pool_arr, size=sample_size, replace=False, p=r_weights)\n            \n            uncovered_targets = targets[cnt_array == 0]\n            if len(uncovered_targets) > 0:\n                for r in sampled_adds:\n                    counts = np.bincount(uncovered_targets % r, minlength=r)\n                    max_count = np.max(counts)\n                    # Randomize tie-breaking for equal highest coverages\n                    a_best = int(np.random.choice(np.where(counts == max_count)[0]))\n                    \n                    n_res_new = n_res_curr - max_count\n                    logm_new = logm + math.log(r)\n                    logboost_new = logboost + math.log(r / (r - 1))\n                    D_new = calc_D(logm_new, logboost_new, n_res_new)\n                    moves.append((\'add\', (r, a_best), D_new))\n            else:\n                for r in sampled_adds:\n                    logm_new = logm + math.log(r)\n                    logboost_new = logboost + math.log(r / (r - 1))\n                    D_new = calc_D(logm_new, logboost_new, 0)\n                    moves.append((\'add\', (r, 0), D_new))\n                    \n        # 2 & 3. Propose OPTIMIZE and DROP moves\n        uncovered_bg_dict = {}\n        for r, a_old in list(congr_dict.items()):\n            cnt_bg = cnt_array - (targets % r == a_old)\n            uncovered_bg = targets[cnt_bg == 0]\n            uncovered_bg_dict[r] = uncovered_bg  # Cache array for SWAP moves below\n            \n            # DROP move\n            n_res_drop = len(uncovered_bg)\n            logm_drop = logm - math.log(r)\n            logboost_drop = logboost - math.log(r / (r - 1))\n            D_drop = calc_D(logm_drop, logboost_drop, n_res_drop)\n            moves.append((\'drop\', (r, a_old), D_drop))\n            \n            # OPTIMIZE move\n            if len(uncovered_bg) > 0:\n                counts = np.bincount(uncovered_bg % r, minlength=r)\n                max_count = np.max(counts)\n                a_new = int(np.random.choice(np.where(counts == max_count)[0]))\n                n_res_opt = n_res_drop - max_count\n            else:\n                a_new = 0\n                n_res_opt = 0\n                \n            if a_new != a_old:\n                D_opt = calc_D(logm, logboost, n_res_opt)\n                moves.append((\'optimize\', (r, a_new), D_opt))\n\n        # 4. Propose SWAP moves (Swap an existing prime out for a new one)\n        if congr_dict and cand_pool:\n            n_swaps = min(150, len(congr_dict) * len(cand_pool))\n            drop_cands = list(congr_dict.keys())\n            swap_adds = np.random.choice(cand_pool_arr, size=n_swaps, replace=True, p=r_weights)\n            swap_drops = np.random.choice(drop_cands, size=n_swaps, replace=True)\n            \n            swap_pairs = list(set(zip(swap_drops, swap_adds)))\n            for r_d, r_a in swap_pairs[:150]:\n                r_d = int(r_d)\n                r_a = int(r_a)\n                \n                # Fetch cached isolated background context explicitly evaluated above\n                uncovered_bg = uncovered_bg_dict[r_d]\n                \n                if len(uncovered_bg) > 0:\n                    counts = np.bincount(uncovered_bg % r_a, minlength=r_a)\n                    max_count = np.max(counts)\n                    a_new = int(np.random.choice(np.where(counts == max_count)[0]))\n                    n_res_new = len(uncovered_bg) - max_count\n                else:\n                    a_new = 0\n                    n_res_new = 0\n                    \n                logm_new = logm - math.log(r_d) + math.log(r_a)\n                logboost_new = logboost - math.log(r_d / (r_d - 1)) + math.log(r_a / (r_a - 1))\n                D_new = calc_D(logm_new, logboost_new, n_res_new)\n                moves.append((\'swap\', (r_d, r_a, a_new), D_new))\n            \n        if len(moves) == 1:\n            break\n            \n        # Select move using Gibbs/Boltzmann distribution over the objective values\n        scores = np.array([-m[2] for m in moves])\n        \n        # Local cyclic decrease of temperature inside the internal step iterations\n        current_temp = t_temp * (0.5 ** (step_idx / num_internal_steps))\n        temp = max(current_temp, 1e-5)\n        \n        scaled_scores = scores / temp\n        scaled_scores -= np.max(scaled_scores)\n        probs = np.exp(scaled_scores)\n        probs /= np.sum(probs)\n        \n        idx = np.random.choice(len(moves), p=probs)\n        chosen_move = moves[idx]\n        \n        # Apply chosen move\n        m_type, m_data, D_new = chosen_move\n        \n        if m_type == \'add\':\n            r, a = m_data\n            r = int(r); a = int(a)\n            congr_dict[r] = a\n            cnt_array += (targets % r) == a\n            logm += math.log(r)\n            logboost += math.log(r / (r - 1))\n        elif m_type == \'optimize\':\n            r, a = m_data\n            r = int(r); a = int(a)\n            a_old = congr_dict[r]\n            cnt_array -= (targets % r) == a_old\n            cnt_array += (targets % r) == a\n            congr_dict[r] = a\n        elif m_type == \'drop\':\n            r, a = m_data\n            r = int(r); a = int(a)\n            cnt_array -= (targets % r) == a\n            logm -= math.log(r)\n            logboost -= math.log(r / (r - 1))\n            del congr_dict[r]\n        elif m_type == \'swap\':\n            r_d, r_a, a_new = m_data\n            r_d = int(r_d); r_a = int(r_a); a_new = int(a_new)\n            a_old = congr_dict[r_d]\n            \n            cnt_array -= (targets % r_d) == a_old\n            logm -= math.log(r_d)\n            logboost -= math.log(r_d / (r_d - 1))\n            del congr_dict[r_d]\n            \n            congr_dict[r_a] = a_new\n            cnt_array += (targets % r_a) == a_new\n            logm += math.log(r_a)\n            logboost += math.log(r_a / (r_a - 1))\n\n        # Explicit elitism tracking ensures returning optimal minimum\n        if D_new < best_D:\n            best_D = D_new\n            best_congr_dict = congr_dict.copy()\n\n    # Update in place to best state found\n    congr_dict.clear()\n    congr_dict.update(best_congr_dict)\n    return congr_dict\n# EVOLVE-BLOCK-END\n\ndef evaluate(eval_inputs: Mapping[str, Any]) -> dict[str, float]:\n    """Run evaluation on the optimized step."""\n    # Let\'s say we maximize -n_digits_est (smaller estimated N-size)\n    # Using sympy/math to compute est digits\n    import sympy\n    import numpy as np\n    Q = 100003\n    targets = np.array(list(sympy.primerange(3, Q)), dtype=np.int64)\n    # Let\'s run the optimize_cover_step starting from empty cover for some iterations\n    congr_dict = {}\n    cand_mods = [int(r) for r in sympy.primerange(3, 8000)]\n    cnt_array = np.zeros(len(targets), dtype=np.int16)\n    logm = math.log(2)\n    logboost = math.log(2.0)\n    \n    for it in range(10):\n        t_temp = 0.8 * (0.02 / 0.8) ** (it / 10)\n        # Update cnt_array based on congr_dict\n        cnt_array = np.zeros(len(targets), dtype=np.int16)\n        logm = math.log(2)\n        logboost = math.log(2.0)\n        for r, a in congr_dict.items():\n            cnt_array += (targets % r) == a\n            logm += math.log(r)\n            logboost += math.log(r / (r - 1))\n            \n        congr_dict = optimize_cover_step(congr_dict, cand_mods, targets, cnt_array, logm, logboost, t_temp)\n        \n    # Recalculate final metrics\n    cnt_array = n