ngr_dict[best_r] = best_a\n                        cnt_array[targets % best_r == best_a] += 1\n                        n_res = best_new_n_res\n                        current_D = best_new_D\n                        logm += math.log(best_r)\n                        logboost += math.log(best_r / (best_r - 1))\n\n        elif action == \'drop\':\n            active = list(congr_dict.keys())\n            if active:\n                k = min(6, len(active))\n                sampled_active = random.sample(active, k)\n                \n                best_r = None\n                best_new_D = float(\'inf\')\n                best_new_n_res = n_res\n                \n                for r in sampled_active:\n                    a = congr_dict[r]\n                    lost_cov = np.sum((cnt_array == 1) & (targets % r == a))\n                    new_n_res = n_res + lost_cov\n                    new_D = calc_D_val(new_n_res, logm - math.log(r), logboost - math.log(r / (r - 1)))\n                    if new_D < best_new_D:\n                        best_new_D = new_D\n                        best_r = r\n                        best_new_n_res = new_n_res\n                \n                if best_r is not None:\n                    if best_new_D < current_D or random.random() < math.exp(-(best_new_D - current_D) / temp):\n                        a_drop = congr_dict[best_r]\n                        cnt_array[targets % best_r == a_drop] -= 1\n                        del congr_dict[best_r]\n                        n_res = best_new_n_res\n                        current_D = best_new_D\n                        logm -= math.log(best_r)\n                        logboost -= math.log(best_r / (best_r - 1))\n\n        elif action == \'swap\':\n            active = list(congr_dict.keys())\n            cand_pool = [r for r in cand_mods if r not in congr_dict]\n            if active and cand_pool:\n                k_drop = min(4, len(active))\n                sampled_drops = random.sample(activ