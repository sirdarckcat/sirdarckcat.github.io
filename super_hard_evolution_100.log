m.choice(list(congr_dict)) if congr_dict else None\n        if kind < 0.5 and r_in is not None:\n            a_old = congr_dict[r_in]\n            a_new = random.randint(0, r_in - 1)\n            if a_new != a_old:\n                congr_dict[r_in] = a_new\n        elif kind < 0.7 and r_in is not None:\n            del congr_dict[r_in]\n        else:\n            r_out = random.choice(cand_mods)\n            if r_out not in congr_dict:\n                a_new = random.randint(0, r_out - 1)\n                congr_dict[r_out] = a_new\n        return congr_dict\n\n    LN10 = 2.302585092994046\n    \n    def calc_score(n_res_val, lm, lb):\n        """Exact matching of evaluation objective + rigid Lagrangian barrier for E <= 17.5"""\n        m_dig = lm / LN10\n        bst = math.exp(lb)\n        ub = n_res_val * bst\n        disc = m_dig**2 + 4 * ub / (LN10**2)\n        D = (m_dig + math.sqrt(max(0.0, disc))) / 2\n        E = ub / (D * LN10) if D > 0 else 0.0\n        penalty = 100.0 * (max(0.0, E - 17.5))**2\n        return D + penalty\n\n    current_n_res = int((cnt_array == 0).sum())\n    \n    # CRAZY IDEA: "The Thanos Snap & Cambrian Explosion" (Capital C Crazy)\n    # We deliberately shatter local minima by wiping out the bottom 15% worst-performing \n    # moduli in a single apocalyptic event. Then, a \'Cambrian Explosion\' occurs where we \n    # instantly and greedily power-add new primes optimally suited for the new chaotic vacuum.\n    \n    inner_steps = 25\n    for inner_it in range(inner_steps):\n        \n        # ---------------------------------------------------------\n        # THE THANOS SNAP (Triggers at exactly halfway)\n        # ---------------------------------------------------------\n        if inner_it == 12 and len(congr_dict) > 20:\n            ones_mask = (cnt_array == 1)\n            efficiencies = []\n            for r, a in congr_dict.items():\n                uniques = np.sum(ones_mask & ((targets % r) == a))\n                efficiencies.append((uniques, r, a))\n            \n            # "Perfectly balanced, as all things should be."\n            efficiencies.sort(key=lambda x: x[0])\n            snap_count = len(efficiencies) * 15 // 100\n            \n            # Snap them out of existence\n            for i in range(snap_count):\n                _, r, a_old = efficiencies[i]\n                del congr_dict[r]\n                cnt_array -= ((targets % r) == a_old).astype(np.int16)\n                logm -= math.log(r)\n                logboost -= math.log(r / (r - 1))\n            \n            # Cambrian Explosion: Instantly evolve new life in the vacuum\n            cand_pool = [m for m in cand_mods if m not in congr_dict]\n            for _ in range(snap_count):\n                if not cand_pool: break\n                zeros_mask = (cnt_array == 0)\n                curr_zeros = int(zeros_mask.sum())\n                pool_sample = random.sample(cand_pool, min(40, len(cand_pool)))\n                best_add = None\n                best_score = float(\'inf\')\n                \n                for r in pool_sample:\n                    rem = targets % r\n                    counts = np.bincount(rem[zeros_mask], minlength=r)\n                    if len(counts) > 0:\n                        a = int(np.argmax(counts))\n                        cov = counts[a]\n                    else:\n                        a = 0\n                        cov = 0\n                        \n                    new_n_res = curr_zeros - cov\n                    nm = logm + math.log(r)\n                    nb = logboost + math.log(r / (r - 1))\n                    sc = calc_score(new_n_res, nm, nb)\n                    if sc < best_score:\n                        best_score = sc\n                        best_add = (r, a, nm, nb, rem)\n                            \n                if best_add:\n                    r, a, nm, nb, rem = best_add\n                    congr_dict[r] = a\n                    cnt_array += (rem == a).astype(np.int16)\n                    logm = nm\n                    logboost = nb\n                    cand_pool.remove(r)\n            \n            current_n_res = int((cnt_array == 0).sum())\n            continue # Let the universe settle for this step\n        # ---------------------------------------------------------\n\n        moves = []\n        \n        # 1. Add Moves Evaluation\n        cand_pool = [m for m in cand_mods if m not in congr_dict]\n        sample_add = random.sample(cand_pool, min(40, len(cand_pool))) if cand_pool else []\n        zeros_mask = (cnt_array == 0)\n        \n        for r in sample_add:\n            rem = targets % r\n            counts = np.bincount(rem[zeros_mask], minlength=r)\n            if len(counts) > 0:\n                a = int(np.argmax(counts))\n                covered_uncovered = counts[a]\n            else:\n                a = 0\n                covered_uncovered = 0\n            \n            new_n_res = current_n_res - covered_uncovered\n            new_logm = logm + math.log(r)\n            new_logboost = logboost + math.log(r / (r - 1))\n            score = calc_score(new_n_res, new_logm, new_logboost)\n            moves.append((\'add\', r, a, score, new_n_res, new_logm, new_logboost))\n            \n        mods_in = list(congr_dict.keys())\n        \n        # 2. Drop Moves Evaluation\n        sample_drop = random.sample(mods_in, min(40, len(mods_in))) if mods_in else []\n        ones_mask = (cnt_array == 1)\n        \n        for r in sample_drop:\n            a = congr_dict[r]\n            covered_unique = np.sum(ones_mask & ((targets % r) == a))\n            \n            new_n_res = current_n_res + covered_unique\n            new_logm = logm - math.log(r)\n            new_logboost = logboost - math.log(r / (r - 1))\n            score = calc_score(new_n_res, new_logm, new_logboost)\n            moves.append((\'drop\', r, None, score, new_n_res, new_logm, new_logboost))\n            \n        # 3.