c_D(n_res_val, logm_val, logboost_val):\n        m_digits = logm_val / LN10\n        ub = n_res_val * math.exp(logboost_val)\n        D = (m_digits + math.sqrt(max(0.0, m_digits**2 + 4 * ub / LN10_2))) / 2\n        E = ub / (D * LN10) if D > 0 else 0\n        return D + 100.0 * max(0.0, E - 17.5)**2\n\n    cnt_array = cnt_array.copy()\n    \n    def optimize_all():\n        keys = list(congr_dict.keys())\n        random.shuffle(keys)\n        for r in keys:\n            rem = targets % r\n            cnt_array[rem == congr_dict[r]] -= 1\n            congr_dict[r] = int(np.argmax(np.bincount(rem, weights=(cnt_array == 0), minlength=r)))\n            cnt_array[rem == congr_dict[r]] += 1\n\n    optimize_all()\n    n_res = int((cnt_array == 0).sum())\n    curr_D = calc_D(n_res, logm, logboost)\n\n    for step in range(150):\n        if step == 75: optimize_all()\n\n        action = random.choices([\'add\', \'drop\', \'swap\'], weights=[0.4, 0.4, 0.2])[0]\n        if not congr_dict: action = \'add\'\n\n        best_r, best_a, best_new_n_res, best_new_D = None, None, None, float(\'inf\')\n        \n        if action == \'add\':\n            pool = [m for m in cand_mods if m not in congr_dict]\n            if not pool: continue\n            for r in random.sample(pool, min(30, len(pool))):\n                counts = np.bincount(targets % r, weights=(cnt_array == 0), minlength=r)\n                a = int(np.argmax(counts))\n                n = n_res - counts[a]\n                lm = logm + math.log(r)\n                lb = logboost + math.log(r / (r - 1))\n                D = calc_D(n, lm, lb)\n                if D < best_new_D:\n                    best_r, best_a, best_new_n_res, best_new_D, best_lm, best_lb = r, a, n, D, lm, lb\n                    \n            if best_r and (best_new_D < curr_D or random.random() < math.exp((curr_D - best_new_D) / max(t_temp, 1e-6))):\n                congr_dict[best_r] = best_a\n                cnt_array[targets % best_r == best_a] += 1\n                n_res, logm, logboost, curr_D = best_new_n_res, best_lm, best_lb, best_new_D\n\n        elif action == \'drop\':\n            for r in random.sample(list(congr_dict.keys()), min(30, len(congr_dict))):\n                a = congr_dict[r]\n                n = n_res + np.sum((cnt_array == 1) & (targets % r == a))\n                lm = logm - math.log(r)\n                lb = logboost - math.log(r / (r - 1))\n                D = calc_D(n, lm, lb)\n                if D < best_new_D:\n                    best_r, best_a, best_new_n_res, best_new_D, best_lm, best_lb = r, a, n, D, lm, lb\n                    \n            if best_r and (best_new_D < curr_D or random.random() < math.exp((curr_D - best_new_D) / max(t_temp, 1e-6))):\n                cnt_array[targets % best_r == best_a] -= 1\n                del congr_dict[best_r]\n                n_res, logm, logboost, curr_D = best_new_n_res, best_lm, best_lb, best_new_D\n\n        elif action == \'swap\':\n            r = random.choice(list(congr_dict.keys()))\n            a_old = congr_dict[r]\n            rem = targets % r\n            cnt_array[rem == a_old] -= 1\n            a_new = int(np.argmax(np.bincount(rem, weights=(cnt_array == 0), minlength=r)))\n            cnt_array[rem == a_new] += 1\n            congr_dict[r] = a_new\n            n_res = int((cnt_array == 0).sum())\n            curr_D = calc_D(n_res, logm, logboost)\n\n    optimize_all()\n    return congr_dict\n# EVOLVE-BLOCK-END\n\ndef evaluate(eval_inputs: Mapping[str, Any]) -> dict[str, float]:\n    """Run evaluation on the optimized step."""\n    import sympy\n    import numpy as np\n    Q = 100003\n    targets = np.array(list(sympy.primerange(3, Q)), dtype=np.int64)\n    \n    # Warm-start from the 195-digit record cover instead of starting empty\n    congr_dict = {int(r): int(a) for r, a in eval_inputs["warm_start_cover"]}\n    \n    cand_mods = [int(r) for r in sympy.primerange(3, 8000)]\n    cnt_array = np.zeros(len(targets), dtype=np.int16)\n    \n    # Pre-populate counts\n    for r, a in congr_dict.items():\n        cnt_array += (targets % r) == a\n        \n    for it in range(10):\n        t_temp = 0.8 * (0.02 / 0.8) ** (it / 10)\n        # Recalculate cnt_array based on congr_dict\n        cnt_array = np.zeros(len(targets), dtype=np.int16)\n        logm = math.log(2)\n        logboost = math.log(2.0)\n        for r, a in congr_dict.items():\n            cnt_array += (targets % r) == a\n            logm += math.log(r)\n            logboost += math.log(r / (r - 1))\n            \n        congr_dict = optimize_cover_step(congr_dict, cand_mods, targets, cnt_array, logm, logboost, t_temp)\n        \n    # Recalculate final metrics\n    cnt_array = np.zeros(len(targets), dtype=np.int16)\n    logm = math.log(2)\n    logboost = math.log(2.0)\n    for r, a in congr_dict.items():\n        cnt_array += (targets % r) == a\n        logm += math.log(r)\n        logboost += math.log(r / (r - 1))\n        \n    n_res = int((cnt_array == 0).sum())\n    boost = math.exp(logboost)\n    m_digits = logm / math.log(10)\n    \n    ub = n_res * boost\n    LN10 = math.log(10)\n    D = (m_digits + math.sqrt(m_digits ** 2 + 4 * ub / (LN10 * LN10))) / 2\n    \n    # Constrain E <= 17.5 via Lagrangian penalty to prevent reward hacking\n    E_limit = 17.5\n    E_actual = ub / (D * LN10) if D > 0 else 0.0\n    lagrangian_penalty = 0.0\n    if E_actual > E_limit:\n        lagrangian_penalty = 100.0 * (E_actual - E_limit) ** 2\n        \n    score_headline = -float(D + lagrangian_penalty)\n    \n    # Expose E, |U|, digits(M) as negated secondary metrics for joint optimization visibility\n    return {\n        "neg_est_digits": score_headline,\n        "neg_E": -float(E_actual),\n        "neg_residual_count": -float(n_res),\n        "neg_m_digits": -float(m_digits)\n    }\n'}]}, 'evaluation': {'scores': {'scores': [{'metric': 'neg_est_digits', 'score': -194.16208}, {'metric': 'neg_E', 'score': -17.548363}, {'metric': 'neg