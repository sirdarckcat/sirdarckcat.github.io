ool = sorted(cand_pool)\n        if len(sorted_pool) <= k:\n            return sorted_pool\n        # Focus on smaller primes with 70% probability\n        if random.random() < 0.7:\n            sub_pool = sorted_pool[:min(100, len(sorted_pool))]\n            return random.sample(sub_pool, min(k, len(sub_pool)))\n        else:\n            return random.sample(sorted_pool, k)\n\n    # Convert congr_dict to a normal dictionary\n    congr_dict = dict(congr_dict)\n    \n    # Initialize state variables\n    current_n_res = int(np.sum(cnt_array == 0))\n    current_logm = float(logm)\n    current_logboost = float(logboost)\n    current_D = calc_D(current_n_res, current_logm, current_logboost)\n    \n    cnt_array = cnt_array.copy()\n    \n    # We perform 250 internal steps of simulated annealing per call\n    N_INNER_STEPS = 250\n    \n    for step in range(N_INNER_STEPS):\n        if not congr_dict:\n            action = \'add\'\n        else:\n            r_val = random.random()\n            if r_val < 0.25:\n                action = \'add\'\n            elif r_val < 0.40:\n                action = \'drop\'\n            elif r_val < 0.80:\n                action = \'swap\'\n            else:\n                action = \'optimize\'\n                \n        if action == \'add\':\n            cand_pool = [m for m in cand_mods if m not in congr_dict]\n            sampled_cands = get_candidates(cand_pool, k=8)\n            if sampled_cands:\n                best_cand = None\n                best_a = None\n                best_new_D = float(\'inf\')\n                best_num_covered = 0\n                \n                for r in sampled_cands:\n                    a, num_covered = get_best_residue(r, cnt_array, targets)\n                    new_logm = current_logm + math.log(r)\n                    new_logboost = current_logboost + math.log(r / (r - 1))\n                    new_n_res = current_n_res - num_covered\n                    new_D = calc_D(new_n_res, new_logm, new_logboost)\n                    if new_D < best_new_D:\n                        best_new_D = new_D\n                        best_cand = r\n                        best_a = a\n                        best_num_covered = num_covered\n                        \n                if best_cand is not None:\n                    delta_D = best_new_D - current_D\n                    if delta_D <= 0 or random.random() < math.exp(-delta_D / max(t_temp, 1e-6)):\n                        congr_dict[best_cand] = best_a\n                        cnt_array += (targets % best_cand == best_a)\n                        current_n_res -= best_num_covered\n                        current_logm += math.log(best_cand)\n                        current_logboost += math.log(best_cand / (best_cand - 1))\n                        current_D = best_new_D\n                        \n        elif action == \'drop\':\n            mods_in = list(congr_dict.keys())\n            if mods_in:\n                sampled_drops = random.sample(mods_in, min(8, len(mods_in)))\n                best_cand = None\n                best_new_D = float(\'inf\')\n                best_num_uncovered = 0\n                \n                for r in sampled_drops:\n                    a = congr_dict[r]\n                    num_uncovered = int(np.sum((cnt_array == 1) & (targets % r == a)))\n                    new_logm = current_logm - math.log(r)\n                    new_logboost = current_logboost - math.log(r / (r - 1))\n                    new_n_res = current_n_res + num_uncovered\n                    new_D = calc_D(new_n_res, new_logm, new_logboost)\n                    if new_D < best_new_D:\n                        best_new_D = new_D\n                        best_cand = r\n                        best_num_uncovered = num_uncovered\n                        \n                if best_cand is not None:\n                    delta_D = best_new_D - current_D\n                    if delta_D <= 0 or random.random() < math.exp(-delta_D / max(t_temp, 1e-6)):\n                        a = congr_dict[best_cand]\n                        cnt_array -= (targets % best_cand == a)\n                        del congr_dict[best_cand]\n                        current_n_res += best_num_uncovered\n                        current_logm -= math.log(best_cand)\n                        current_logboost -= math.log(best_cand / (best_cand - 1))\n                        current_D = best_new_D\n                        \n        elif action == \'swap\':\n            mods_in = list(congr_dict.keys())\n            cand_pool = [m for m in cand_mods if m not in congr_dict]\n            sampled_cands = get_candidates(cand_pool, k=8)\n            if mods_in and sampled_cands:\n                r_in = random.choice(mods_in)\n                a_in = congr_dict[r_in]\n                \n                temp_cnt_array = cnt_array - (targets % r_in == a_in)\n                temp_n_res = int(np.sum(temp_cnt_array == 0))\n                temp_logm = current_logm - math.log(r_in)\n                temp_logboost = current_logboost - math.log(r_in / (r_in - 1))\n                \n                best_out = None\n                best_a_out = None\n                best_new_D = float(\'inf\')\n                best_num_covered = 0\n                \n                for r_out in sampled_cands:\n                    a_out, num_covered = get_best_residue(r_out, temp_cnt_array, targets)\n                    new_logm = temp_logm + math.log(r_out)\n                    new_logboost = temp_logboost + math.log(r_out / (r_out - 1))\n                    new_n_res = temp_n_res - num_covered\n                    new_D = calc_D(new_n_res, new_logm, new_logboost)\n                    if new_D < best_new_D:\n                        best_new_D = new_D\n                        best_out = r_out\n                        best_a_out = a_out\n                        best_num_covered = num_covered\n                        \n                if best_out is not None:\n                    delta_D = best_new_D - current_D\n                    if delta_D <= 0 or random.random() < math.exp(-delta_D / max(t_temp, 1e-6)):\n                        del congr_dict[r_in]\n                        congr_dict[best_out] = best_a_out\n                        cnt_array = temp_cnt_array + (targets % best_out == best_a_out)\n                        current_n_res = temp_n_res - best_num_covered\n                        current_logm = temp_logm + math.log(best_out)\n                        current_logboost = temp_logboost + math.log(best_out / (best_out - 1))\n                        current_D = best_new_D\n                        \n        elif action == \'optimize\':\n            mods_in = list(congr_dict.keys())\n            if mods_in:\n                r = random.choice(mods_in)\n                a_old = congr_dict[r]\n                \n                temp_cnt_array = cnt_array - (targets % r == a_old)\n                temp_n_res = int(np.sum(temp_cnt_array == 0))\n                \n                a_new, num_covered = get_best_residue(r, temp_cnt_array, targets)\n                new_n_res = temp_n_res - num_covered\n                new_D = calc_D(new_n_res, current_logm, current_logboost)\n                \n                delta_D = new_D - current_D\n                if delta_D <= 0 or random.random() < math.exp(-delta_D / max(t_temp, 1e-6)):\n                    congr_dict[r] = a_new\n                    cnt_array = temp_cnt_array + (targets % r == a_new)\n                    current_n_res = new_n_res\n                    current_D = new_D\n\n    return congr_dict\n# EVOLVE-BLOCK-END\n\ndef evaluate(eval_inputs: Mapping[str, Any]) -> dict[str, float]:\n    """Run evaluation on the optimized step."""\n    # Let\'s say we maximize -n_digits_est (smaller estimated N-size)\n    # Using sympy/math to compute est digits\n    import sympy\n    import numpy as np\n    Q = 100003\n    targets = np.array(list(sympy.primerange(3, Q)), dtype=np.int64)\n    # Let\'s run the optimize_cover_step starting from empty cover for some iterations\n    congr_dict = {}\n    cand_mods = [int(r) for r in sympy.primerange(3, 8000)]\n    cnt_array = np.zeros(len(targets), dtype=np.int16)\n    logm = math.log(2)\n    logboost = math.log(2.0)\n    \n    for it in range(10):\n        t_temp = 0.8 * (0.02 / 0.8) ** (it / 10)\n        # Update cnt_array based on congr_dict\n        cnt_array = np.zeros(len(targets), dtype=np.int16)\n        logm = math.log(2)\n        logboost = math.log(2.0)\n        for r, a in congr_dict.items():\n            cnt_array += (targets % r) == a\n            logm += math.log(r)\n            logboost += math.log(r / (r - 1))\n            \n        congr_dict = optimize_cover_step(congr_dict, cand_mods, targets, cnt_array, logm, logboost, t_temp)\n        \n    # Recalculate final metrics\n    cnt_array = np.zeros(len(targets), dtype=np.int16)\n    logm = math.log(2)\n    logboost = math.log(2.0)\n    for r, a in congr_dict.items():\n        cnt_array += (targets % r) == a\n        logm += math.log(r)\n        logboost += math.log(r / (r - 1))\n        \n    n_res = int((cnt_array == 0).sum())\n    boost = math.exp(logboost)\n    m_digits = logm / math.log(10)\n    \n    ub = n_res * boost\n    LN10 = math.log(10)\n    D = (m_digits + math.sqrt(m_digits ** 2 + 4 * ub / (LN10 * LN10))) / 2\n    return {"neg_est_digits": -float(D)}\n'}]}, 'evaluation': {'scores': {'scores': [{'metric': 'neg_est_digits', 'score': -50.655006}]}}, 'parentPrograms': ['projects/799795028847/locations/global/collections/default_collection/engines/goldbach_1784979910032/sessions/7013217697778074030/alphaEvolveExperiments/15164875354338173448/alphaEvolvePrograms/7259743653139916870'], 'state': 'COMPLETED'}, {'name': 'projects/799795028847/locations/global/collections/default_collection/engines/goldbach_1784979910032/sessions/7013217697778074030/alphaEvolveExperiments/15164875354338173448/alphaEvolvePrograms/18102573509735109317', 'createTime': '2026-07-25T20:20:13.781663Z', 'content': {'files': [{'path': 'program.py', 'content': '# Copyright 2026 Google LLC\nfrom typing import Any, Mapping\nimport math\nimport random\nimport numpy as np\n\n# EVOLVE-BLOCK-START\nimport heapq\n\n_MOD_CACHE = {}\n\ndef get_mod_targets(targets, r):\n    key = (id(targets), r)\n    if key not in _MOD_CACHE:\n        _MOD_CACHE[key] = targets % r\n    return _MOD_CACHE[key]\n\ndef weighted_sample(population, weights, k):\n    if len(population) <= k:\n        return list(population)\n    scores = [random.random() ** (1.0 / w) for w in weights]\n    return [x for x, _ in heapq.nlargest(k, zip(population, scores), key=lambda x: x[1])]\n\ndef sample_gumbel():\n    u = random.random()\n    while u == 0.0:\n        u = random.random()\n    return -math.log(-math.log(u))\n\ndef optimize_cover_step(congr_dict, cand_mods, targets, cnt_array, logm, logboost, t_temp):\n    """Optimize a single step of congruence cover using simulated annealing style logic.\n\n    Args:\n        congr_dict: Dictionary of r -> a\n        cand_mods: List of prime candidates\n        targets: np.array of target primes\n        cnt_array: np.array of coverage counts\n        logm: current log of modulus M\n        logboost: current log of boost factor\n        t_temp: current temperature\n\n    Returns:\n        Updated congr_dict\n    """\n    if len(targets) == 0:\n        return congr_dict\n\n    cnt_array = cnt_array.copy()\n    cand_pool = set(cand_mods) - set(congr_dict.keys())\n    cand_pool = list(cand_pool)\n    mods_in = list(congr_dict.keys())\n\n    current_logm = logm\n    current_logboost = logboost\n    \n    FOUR_DIV_LN10_SQ = 0.7538965005934661\n    LN10 = 2.302585092994046\n\n    def calc_D(n_res, lm, lb):\n        boost = math.exp(lb)\n        m_digits = lm / LN10\n        ub = n_res * boost\n        if m_digits == 0:\n            return math.sqrt(FOUR_DIV_LN10_SQ * ub) / 2\n        return (m_digits + math.sqrt(m_digits ** 2 + FOUR_DIV_LN10_SQ * ub)) / 2\n\n    all_mods = set(cand_mods) | set(congr_dict.keys())\n    log_r_dict = {r: math.log(r) for r in all_mods}\n    log_r_ratio_dict = {r: math.log(r / (r - 1)) for r in all_mods if r > 1}\n    cand_weights_dict = {r: 1.0 / log_r_dict[r] for r in all_mods}\n\n    n_res = np.count_nonzero(cnt_array == 0)\n    current_D = calc_D(n_res, current_logm, current_logboost)\n\n    num_inner_steps = 300\n\n    for step_idx in range(num_inner_steps):\n        frac = step_idx / num_inner_steps\n        current_temp = t_temp * (0.2 ** frac)\n        temp_scale = 0.05 * max(current_temp, 1e-4)\n\n        if cand_pool:\n            weights = [cand_weights_dict[r] for r in cand_pool]\n            sampled_cands = weighted_sample(cand_pool, weights, min(40, len(cand_pool)))\n        else:\n            sampled_cands = []\n\n        sampled_mods_opt = random.sample(mods_in, min(25, len(mods_in))) if mods_in else []\n        sampled_mods_drop = random.sample(mods_in, min(25, len(mods_in))) if mods_in else []\n        \n        num_proposals = len(sampled_cands) + len(sampled_mods_opt) + len(sampled_mods_drop)\n        if num_proposals == 0:\n            break\n            \n        weight_do_nothing = max(1, num_proposals)\n        \n        best_action = None\n        best_r = None\n        best_a = None\n        best_new_n_res = n_res\n        best_new_lm = current_logm\n        best_new_lb = current_logboost\n        best_new_D = current_D\n        best_score = -temp_scale * math.log(weight_do_nothing) - sample_gumbel() * temp_scale\n\n        # Evaluate ADD\n        if sampled_cands:\n            mask0 = (cnt_array == 0)\n            for r in sampled_cands:\n                t_mod_r = get_mod_targets(targets, r)\n                counts = np.bincount(t_mod_r, weights=mask0, minlength=r)\n                a = int(np.argmax(counts))\n                \n                new_n_res = n_res - int(counts[a])\n                new_lm = current_logm + log_r_dict[r]\n                new_lb = current_logboost + log_r_ratio_dict[r]\n                new_D = calc_D(new_n_res, new_lm, new_lb)\n                \n                delta = new_D - current_D\n                score = delta - sample_gumbel() * temp_scale\n                \n                if score < best_score:\n                    best_score = score\n                    best_action = \'add\'\n                    best_r = r\n                    best_a = a\n                    best_new_n_res = new_n_res\n                    best_new_lm = new_lm\n                    best_new_lb = new_lb\n                    best_new_D = new_D\n\n        # Evaluate OPTIMIZE\n        if sampled_mods_opt:\n            for r in sampled_mods_opt:\n                old_a = congr_dict[r]\n                t_mod_r = get_mod_targets(targets, r)\n                is_covered = (t_mod_r == old_a)\n                \n                cnt_array -= is_covered\n                mask0 = (cnt_array == 0)\n                counts = np.bincount(t_mod_r, weights=mask0, minlength=r)\n                a = int(np.argmax(counts))\n                \n                if a != old_a:\n                    temp_n_res = np.count_nonzero(mask0)\n                    new_n_res = temp_n_res - int(counts[a])\n                    new_D = calc_D(new_n_res, current_logm, current_logboost)\n                    \n                    delta = new_D - current_D\n                    score = delta - sample_gumbel() * temp_scale\n                    \n                    if score < best_score:\n                        best_score = score\n                        best_action = \'optimize\'\n                        best_r = r\n                        best_a = a\n                        best_new_n_res = new_n_res\n                        best_new_lm = current_logm\n                        best_new_lb = current_logboost\n                        best_new_D = new_D\n                        \n                cnt_array += is_covered\n\n        # Evaluate DROP\n        if sampled_mods_drop:\n            mask1 = (cnt_array == 1)\n            for r in sampled_mods_drop:\n                a = congr_dict[r]\n                t_mod_r = get_mod_targets(targets, r)\n                count1 = np.count_nonzero(mask1 & (t_mod_r == a))\n                \n                new_n_res = n_res + count1\n                new_lm = current_logm - log_r_dict[r]\n                new_lb = current_logboost - log_r_ratio_dict[r]\n                new_D = calc_D(new_n_res, new_lm, new_lb)\n                \n                delta = new_D - current_D\n                score = delta - sample_gumbel() * temp_scale\n                \n                if score < best_score:\n                    best_score = score\n                    best_action = \'drop\'\n                    best_r = r\n                    best_new_n_res = new_n_res\n                    best_new_lm = new_lm\n                    best_new_lb = new_lb\n                    best_new_D = new_D\n\n        # Execute best action\n        if best_action == \'add\':\n            congr_dict[best_r] = best_a\n            cand_pool.remove(best_r)\n            mods_in.append(best_r)\n            cnt_array += (get_mod_targets(targets, best_r) == best_a)\n            \n            n_res = best_new_n_res\n            current_logm = best_new_lm\n            current_logboost = best_new_lb\n            current_D = best_new_D\n            \n        elif best_action == \'optimize\':\n            old_a = congr_dict[best_r]\n            cnt_array -= (get_mod_targets(targets, best_r) == old_a)\n            congr_dict[best_r] = best_a\n            cnt_array += (get_mod_targets(targets, best_r) == best_a)\n            \n            n_res = best_new_n_res\n            current_D = best_new_D\n            \n        elif best_action == \'drop\':\n            old_a = congr_dict[best_r]\n            cnt_array -= (get_mod_targets(targets, best_r) == old_a)\n            del congr_dict[best_r]\n            mods_in.remove(best_r)\n            cand_pool.append(best_r)\n            \n            n_res = best_new_n_res\n            current_logm = best_new_lm\n            current_logboost = best_new_lb\n            current_D = best_new_D\n\n    return congr_dict\n# EVOLVE-BLOCK-END\n\ndef evaluate(eval_inputs: Mapping[str, Any]) -> dict[str, float]:\n    """Run evaluation on the optimized step."""\n    # Let\'s say we maximize -n_digits_est (smaller estimated N-size)\n    # Using sympy/math to compute est digits\n    import sympy\n    import numpy as np\n    Q = 100003\n    targets = np.array(list(sympy.primerange(3, Q)), dtype=np.int64)\n    # Let\'s run the optimize_cover_step starting from empty cover for some iterations\n    congr_dict = {}\n    cand_mods = [int(r) for r in sympy.primerange(3, 8000)]\n    cnt_array = np.zeros(len(targets), dtype=np.int16)\n    logm = math.log(2)\n    logboost = math.log(2.0)\n    \n    for it in range(10):\n        t_temp = 0.8 * (0.02 / 0.8) ** (it / 10)\n        # Update cnt_array based on congr_dict\n        cnt_array = np.zeros(len(targets), dtype=np.int16)\n        logm = math.log(2)\n        logboost = math.log(2.0)\n        for r, a in congr_dict.items():\n            cnt_array += (targets % r) == a\n            logm += math.log(r)\n            logboost += math.log(r / (r - 1))\n            \n        congr_dict = optimize_cover_step(congr_dict, cand_mods, targets, cnt_array, logm, logboost, t_temp)\n        \n    # Recalculate final metrics\n    cnt_array = np.zeros(len(targets), dtype=np.int16)\n    logm = math.log(2)\n    logboost = math.log(2.0)\n    for r, a in congr_dict.items():\n        cnt_array += (targets % r) == a\n        logm += math.log(r)\n        logboost += math.log(r / (r - 1))\n        \n    n_res = int((cnt_array == 0).sum())\n    boost = math.exp(logboost)\n    m_digits = logm / math.log(10)\n    \n    ub = n_res * boost\n    LN10 = math.log(10)\n    D = (m_digits + math.sqrt(m_digits ** 2 + 4 * ub / (LN10 * LN10))) / 2\n    return {"neg_est_digits": -float(D)}\n'}]}, 'evaluation': {'scores': {'scores': [{'metric': 'neg_est_digits', 'score': -50.68834}]}}, 'parentPrograms': ['projects/799795028847/locations/global/collections/default_collection/engines/goldbach_1784979910032/sessions/7013217697778074030/alphaEvolveExperiments/15164875354338173448/alphaEvolvePrograms/18102573509735111775'], 'state': 'COMPLETED'}, {'name': 'projects/799795028847/locations/global/collections/default_collection/engines/goldbach_1784979910032/sessions/7013217697778074030/alphaEvolveExperiments/15164875354338173448/alphaEvolvePrograms/18102573509735112424', 'createTime': '2026-07-25T20:17:50.640615Z', 'content': {'files': [{'path': 'program.py', 'content': '# Copyright 2026 Google LLC\nfrom typing import Any, Mapping\nimport math\nimport random\nimport numpy as np\n\n# EVOLVE-BLOCK-START\ndef optimize_cover_step(congr_dict, cand_mods, targets, cnt_array, logm, logboost, t_temp):\n    """Optimize congruence cover using multi-step exact simulated annealing logic."""\n    import numpy as np\n    import random\n    import math\n\n    def calc_D(m_val, ub_val):\n        LN10 = 2.302585092994046\n        m_dig = m_val / LN10\n        if ub_val >= 0:\n            return (m_dig + math.sqrt(m_dig**2 + 4 * ub_val / (LN10**2))) / 2\n        else:\n            dD_dub = 1.0 / max(1e-9, 2.0 * m_dig * (LN10**2))\n            return m_dig + ub_val * dD_dub\n\n    if len(targets) == 0:\n        return congr_dict\n\n    # Cast cnt_array to np.int64 to support safe accumulation\n    cnt_array = np.array(cnt_array, dtype=np.int64)\n\n    # Crazy simplification: True symmetric Metropolis-Hastings over moduli presence!\n    # By picking a random modulus and just flipping its state (add if missing, drop if present),\n    # we enforce strict detailed balance. The exact symmetry allows us to drop complex branching\n    # and safely scale up to 10,000 internal steps for a much deeper search!\n    internal_steps = 10000\n\n    n_res = int(np.sum(cnt_array == 0))\n    current_ub = n_res * math.exp(logboost)\n    current_D = calc_D(logm, current_ub)\n\n    for _ in range(internal_steps):\n        r = random.choice(cand_mods)\n        \n        if r not in congr_dict:\n            uncovered_targets = targets[cnt_array == 0]\n            if len(uncovered_targets) > 0:\n                counts = np.bincount(uncovered_targets % r, minlength=r)\n                a = int(np.argmax(counts))\n                max_covered = counts[a]\n            else:\n                a = 0\n                max_covered = 0\n                \n            new_n_res = n_res - max_covered\n            new_logm = logm + math.log(r)\n            new_logboost = logboost + math.log(r / (r - 1))\n            new_ub = new_n_res * math.exp(new_logboost)\n            new_D = calc_D(new_logm, new_ub)\n            \n            if new_D < current_D or random.random() < math.exp((current_D - new_D) / max(t_temp, 1e-9)):\n                congr_dict[r] = a\n                cnt_array += (targets % r) == a\n                logm, logboost, current_D, n_res = new_logm, new_logboost, new_D, new_n_res\n\n        else:\n            a_drop = congr_dict[r]\n            \n            mask = (targets % r) == a_drop\n            num_only_r = np.sum((cnt_array == 1) & mask)\n            \n            new_n_res = n_res + num_only_r\n            new_logm = logm - math.log(r)\n            new_logboost = logboost - math.log(r / (r - 1))\n            new_ub = new_n_res * math.exp(new_logboost)\n            new_D = calc_D(new_logm, new_ub)\n            \n            if new_D < current_D or random.random() < math.exp((current_D - new_D) / max(t_temp, 1e-9)):\n                del congr_dict[r]\n                cnt_array -= mask\n                logm, logboost, current_D, n_res = new_logm, new_logboost, new_D, new_n_res\n\n    return congr_dict\n# EVOLVE-BLOCK-END\n\ndef evaluate(eval_inputs: Mapping[str, Any]) -> dict[str, float]:\n    """Run evaluation on the optimized step."""\n    # Let\'s say we maximize -n_digits_est (smaller estimated N-size)\n    # Using sympy/math to compute est digits\n    import sympy\n    import numpy as np\n    Q = 100003\n    targets = np.array(list(sympy.primerange(3, Q)), dtype=np.int64)\n    # Let\'s run the optimize_cover_step starting from empty cover for some iterations\n    congr_dict = {}\n    cand_mods = [int(r) for r in sympy.primerange(3, 8000)]\n    cnt_array = np.zeros(len(targets), dtype=np.int16)\n    logm = math.log(2)\n    logboost = math.log(2.0)\n    \n    for it in range(10):\n        t_temp = 0.8 * (0.02 / 0.8) ** (it / 10)\n        # Update cnt_array based on congr_dict\n        cnt_array = np.zeros(len(targets), dtype=np.int16)\n        logm = math.log(2)\n        logboost = math.log(2.0)\n        for r, a in congr_dict.items():\n            cnt_array += (targets % r) == a\n            logm += math.log(r)\n            logboost += math.log(r / (r - 1))\n            \n        congr_dict = optimize_cover_step(congr_dict, cand_mods, targets, cnt_array, logm, logboost, t_temp)\n        \n    # Recalculate final metrics\n    cnt_array = np.zeros(len(targets), dtype=np.int16)\n    logm = math.log(2)\n    logboost = math.log(2.0)\n    for r, a in congr_dict.items():\n        cnt_array += (targets % r) == a\n        logm += math.log(r)\n        logboost += math.log(r / (r - 1))\n        \n    n_res = int((cnt_array == 0).sum())\n    boost = math.exp(logboost)\n    m_digits = logm / math.log(10)\n    \n    ub = n_res * boost\n    LN10 = math.log(10)\n    D = (m_digits + math.sqrt(m_digits ** 2 + 4 * ub / (LN10 * LN10))) / 2\n    return {"neg_est_digits": -float(D)}\n'}]}, 'evaluation': {'scores': {'scores': [{'metric': 'neg_est_digits', 'score': -50.68834}]}}, 'parentPrograms': ['projects/799795028847/locations/global/collections/default_collection/engines/goldbach_1784979910032/sessions/7013217697778074030/alphaEvolveExperiments/15164875354338173448/alphaEvolvePrograms/18102573509735108720'