s(r)\n                \n                # Combine to break ties cleanly\n                combined_counts = counts_0 + 1e-6 * counts_1\n                best_a = int(np.argmax(combined_counts))\n                c0 = counts_0[best_a]\n                \n                new_n_res = curr_n_res - c0\n                new_m_digits = curr_m_digits + math.log10(r)\n                new_boost = curr_boost * r / (r - 1)\n                \n                ub = new_n_res * new_boost\n                new_D = (new_m_digits + math.sqrt(max(0, new_m_digits**2 + 4 * ub / (LN10**2)))) / 2\n                \n                cands_data.append((new_D, r, best_a, counts_1[best_a]))\n                \n            scores = np.array([-x[0] + x[3]*1e-8 for x in cands_data])\n            if temp < 0.05:\n                best_idx = int(np.argmax(scores))\n            else:\n                noise = np.random.gumbel(0, temp * (np.std(scores) + 1e-9), size=len(scores))\n                best_idx = int(np.argmax(scores + noise))\n                \n            best_new_D = cands_data[best_idx][0]\n            best_r = cands_data[best_idx][1]\n            best_a = cands_data[best_idx][2]\n            \n            delta = curr_D - best_new_D # Positive if adding improves D\n            # Force at least one addition to ensure exploration, otherwise SA accept\n            if add_idx == 0 or delta > 0 or random.random() < math.exp(max(-30, delta / temp)):\n                congr_dict[best_r] = best_a\n                cnt_array = cnt_array + ((targets % best_r) == best_a)\n                logm += math.log(best_r)\n                logboost += math.log(best_r / (best_r - 1))\n                curr_n_res = int(np.sum(cnt_array == 0))\n                curr_m_digits = logm / LN10\n                curr_boost = math.exp(logboost)\n                curr_D = best_new_D\n            else:\n                break # Stop adding if we hit a wall\n\n        # 3. OPTIMIZE PHASE\n        if congr_dict:\n            mods_in = list(congr_dict.keys())\n            random.shuffle(mods_in)\n            # Optimize a vast majority to maintain alignment\n            opt_count = max(1, int(len(mods_in) * 0.8))\n            for r in mods_in[:opt_count]:\n                a_old = congr_dict[r]\n                is_covered = (targets % r) == a_old\n                cnt_bg = cnt_array - is_covered\n                \n                n_res_bg = int(np.sum(cnt_bg == 0))\n                \n                targets_0 = targets[cnt_bg == 0]\n                targets_1 = targets[cnt_bg == 1]\n                counts_0 = np.bincount((targets_0 % r).astype(np.int32), minlength=r) if len(targets_0) > 0 else np.zeros(r)\n                counts_1 = np.bincount((targets_1 % r).astype(np.int32), minlength=r) if len(targets_1) > 0 else np.zeros(r)\n                \n                new_n_res_array = n_res_bg - counts_0\n                ub_array = new_n_res_array * curr_boost\n                D_array = (curr_m_digits + np.sqrt(np.maximum(0, curr_m_digits**2 + 4 * ub_array / (LN10**2)))) / 2\n                \n                scores = -D_array + counts_1 * 1e-8\n                \n                if temp < 0.05:\n                    a_new = int(np.argmax(scores))\n                else:\n                    noise = np.random.gumbel(0, temp * (np.std(scores) + 1e-9), size=r)\n                    a_new = int(np.argmax(scores + noise))\n                    \n                if a_new != a_old:\n                    congr_dict[r] = a_new\n                    cnt_array = cnt_bg + ((targets % r) == a_new)\n                    curr_n_res = int(np.sum(cnt_array == 0))\n                    # curr_m_digits and curr_boost don\'t change during OPTIMIZE of existing prime\n                    curr_ub = curr_n_res * curr_boost\n                    curr_D = (curr_m_digits + math.sqrt(max(0, curr_m_digits**2 + 4 * curr_ub / (LN10**2)))) / 2\n\n    return congr_dict\n# EVOLVE-BLOCK-END\n\ndef evaluate(eval_inputs: Mapping[str, Any]) -> dict[str,