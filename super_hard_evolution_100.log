ct, cand_mods, targets, cnt_array, logm, logboost, t_temp):\n    """Optimize congruence cover using multi-step exact simulated annealing logic."""\n    import numpy as np\n    import random\n    import math\n\n    def calc_D(m_val, ub_val):\n        LN10 = 2.302585092994046\n        m_dig = m_val / LN10\n        if ub_val >= 0:\n            return (m_dig + math.sqrt(m_dig**2 + 4 * ub_val / (LN10**2))) / 2\n        else:\n            dD_dub = 1.0 / max(1e-9, 2.0 * m_dig * (LN10**2))\n            return m_dig + ub_val * dD_dub\n\n    if len(targets) == 0:\n        return congr_dict\n\n    # Cast cnt_array to np.int64 to support safe accumulation\n    cnt_array = np.array(cnt_array, dtype=np.int64)\n\n    # Crazy Idea: "Quantum-Inspired Softmax-Batched Multiple-Try Simulated Annealing"\n    # We sample a mini-batch of candidates for each action, compute their "energy" (D), \n    # use a Softmax distribution to collapse the superposition into a single candidate,\n    # and then apply Metropolis-Hastings. We also add a powerful \'swap\' move!\n    internal_steps = 2500\n\n    n_res = int(np.sum(cnt_array == 0))\n    current_ub = n_res * math.exp(logboost)\n    current_D = calc_D(logm, current_ub)\n\n    for _ in range(internal_steps):\n        if not congr_dict:\n            action = \'add\'\n        else:\n            action = random.choices([\'add\', \'drop\', \'optimize\', \'swap\'], weights=[35, 15, 30, 20], k=1)[0]\n\n        T_eff = max(t_temp, 1e-9)\n\n        if action == \'add\':\n            cands = random.sample(cand_mods, min(12, len(cand_mods)))\n            uncovered_targets = targets[cnt_array == 0]\n            \n            candidates_info = []\n            for r in cands:\n                if r in congr_dict: continue\n                if len(uncovered_targets) > 0:\n                    counts = np.bincount(uncovered_targets % r, minlength=r)\n                    a = int(np.argmax(counts))\n                    max_covered = counts[a]\n                else:\n                    a = 0\n                    max_covered = 0\n                \n                new_n_res = n_res - max_covered\n                new_logm = logm + math.log(r)\n                new_logboost = logboost + math.log(r / (r - 1))\n                new_ub = new_n_res * math.exp(new_logboost)\n                new_D = calc_D(new_logm, new_ub)\n                candidates_info.append((new_D, r, a, max_covered, new_n_res, new_logm, new_logboost))\n                \n            if candidates_info:\n                min_D = min(c[0] for c in candidates_info)\n                # Softmax with temperature adaptation\n                weights = [math.exp(min((min_D - c[0]) / T_eff, 0.0)) for c in candidates_info]\n                total_w = sum(weights)\n                r_rand = random.random() * total_w\n                cum = 0\n                chosen = candidates_info[-1]\n                for i, w in enumerate(weights):\n                    cum += w\n                    if r_rand <= cum:\n                        chosen = candidates_info[i]\n                        break\n                        \n                new_D, r, a, max_covered, new_n_res, new_logm, new_logboost = chosen\n                \n                if new_D < current_D or random.random() < math.exp(min((current_D - new_D) / T_eff, 0.0)):\n                    congr_dict[r] = a\n                    cnt_array += (targets % r) == a\n                    logm, logboost, current_D, n_res = new_logm, new_logboost, new_D, new_n_res\n\n        elif action == \'drop\':\n            keys = list(congr_dict.keys())\n            cands = random.sample(keys, min(5, len(keys)))\n            candidates_info = []\n            for r in cands:\n                a_drop = congr_dict[r]\n                mask = (targets % r) == a_drop\n                num_only_r = np.sum((cnt_array == 1) & mask)\n                \n                new_n_res = n_res + num_only_r\n                new_logm = logm - math.log(r)\n                new_logboost = logboost - math.log(r / (r - 1))\n                new_ub = new_n_res * math.exp(new_logboost)\n                new_D = calc_D(new_logm, new_ub)\n                candidates_info.append((new_D, r, mask, new_n_res, new_logm, new_logboost))\n                \n            if candidates_info:\n                min_D = min(c[0] for c in candidates_info)\n                weights = [math.exp(min((min_D - c[0]) / T_eff, 0.0)) for c in candidates_info]\n                total_w = sum(weights)\n                r_rand = random.random() * total_w\n                cum = 0\n                chosen = candidates_info[-1]\n                for i, w in enumerate(weights):\n                    cum += w\n                    if r_rand <= cum:\n                        chosen = candidates_info[i]\n                        break\n                        \n                new_D, r, mask, new_n_res, new_logm, new_logboost = chosen\n                \n                if new_D < current_D or random.random() < math.exp(min((current_D - new_D) / T_eff, 0.0)):\n                    del congr_dict[r]\n                    cnt_array -= mask\n                    logm, logboost, current_D, n_res = new_logm, new_logboost, new_D, new_n_res\n\n        elif action == \'optimize\':\n            keys = list(congr_dict.keys())\n            cands = random.sample(keys, min(8, len(keys)))\n            candidates_info = []\n            \n            for r in cands:\n                a_old = congr_dict[r]\n                mask = (targets % r) == a_old\n                only_r_mask = (cnt_array == 1) & mask\n                uncovered_bg = targets[(cnt_array == 0) | only_r_mask]\n                \n                if len(uncovered_bg) > 0:\n                    counts = np.bincount(uncovered_bg % r, minlength=r)\n                    a_new = int(np.argmax(counts))\n                    max_covered = counts[a_new]\n                else:\n                    a_new = 0\n                    max_covered = 0\n              