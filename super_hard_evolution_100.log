                \n            if best_r_drop is not None:\n                diff = best_score - S_curr\n                if diff >= 0 or random.random() < math.exp(diff / temp):\n                    a_drop = congr_dict[best_r_drop]\n                    t_mod_drop = cache[best_r_drop]\n                    cnt_array -= (t_mod_drop == a_drop)\n                    del congr_dict[best_r_drop]\n                    \n                    congr_dict[best_r_add] = best_a_add\n                    t_mod_add = cache[best_r_add]\n                    cnt_array += (t_mod_add == best_a_add)\n                    \n                    logm += math.log(best_r_add) - math.log(best_r_drop)\n                    logboost += math.log(best_r_add / (best_r_add - 1)) - math.log(best_r_drop / (best_r_drop - 1))\n                    S_curr = best_score\n                    n_res_curr = np.sum(cnt_array == 0)\n\n        elif action == \'optimize\':\n            sampled_mods = random.sample(mods_in, min(15, len(mods_in)))\n            best_score = -999999.0\n            best_r = None\n            best_a = None\n            \n            for r in sampled_mods:\n                a_old = congr_dict[r]\n                t_mod_r = cache[r]\n                uncovered_temp = uncovered_mask | (single_cover_mask & (t_mod_r == a_old))\n                \n                uncovered_targets_mod = t_mod_r[uncovered_temp]\n                if len(uncovered_targets_mod) > 0:\n                    counts = np.bincount(uncovered_targets_mod, minlength=r)\n                    a_new = int(np.argmax(counts))\n                    cov_count = counts[a_new]\n                else:\n                    a_new = 0\n                    cov_count = 0\n                    \n                n_res_new = np.sum(uncovered_temp) - cov_count\n                score = compute_score(logm, logboost, n_res_new)\n                if score > best_score:\n                    best_score = score\n                    best_r = r\n                    bes