emperature\n\n    Returns:\n        Updated congr_dict\n    """\n    import numpy as np\n    import random\n    import math\n\n    if len(targets) == 0:\n        # Safety fallback\n        kind = random.random()\n        r_in = random.choice(list(congr_dict)) if congr_dict else None\n        if kind < 0.5 and r_in is not None:\n            a_old = congr_dict[r_in]\n            a_new = random.randint(0, r_in - 1)\n            if a_new != a_old:\n                congr_dict[r_in] = a_new\n        elif kind < 0.7 and r_in is not None:\n            del congr_dict[r_in]\n        else:\n            r_out = random.choice(cand_mods)\n            if r_out not in congr_dict:\n                a_new = random.randint(0, r_out - 1)\n                congr_dict[r_out] = a_new\n        return congr_dict\n\n    # Sync logm and logboost exactly\n    logm = math.log(2)\n    logboost = math.log(2.0)\n    for r, a in congr_dict.items():\n        logm += math.log(r)\n        logboost += math.log(r / (r - 1))\n\n    # Copy cnt_array to avoid in-place side effects on caller\'s reference\n    cnt_array = cnt_array.copy()\n    n_res = int((cnt_array == 0).sum())\n    \n    LN10 = 2.302585092994046\n\n    def get_score_and_E(n_res, logm, logboost):\n        m_digits = logm / LN10\n        ub = n_res * math.exp(logboost)\n        D = (m_digits + math.sqrt(m_digits ** 2 + 4 * ub / (LN10 * LN10))) / 2\n        E_actual = ub / (D * LN10) if D > 0 else 0.0\n        score = D + 10000.0 * max(0.0, E_actual - 17.5) ** 2\n        return score, E_actual, m_digits\n\n    # Precompute modulo cache to completely eliminate modulo operations in inner loop\n    all_needed_mods = set(cand_mods) | set(congr_dict.keys())\n    modulo_cache = {r: targets % r for r in all_needed_mods}\n\n    congr_keys = set(congr_dict.keys())\n    cand_mods_set = set(cand_mods)\n\n    def local_polish(congr_dict, cnt_array, logm, logboost):\n        for r in list(congr_dict.keys()):\n            a_old = congr_dict[r]\n            mod_r = modulo_cache[r]\n            cnt_temp = cnt_array - (mod_r == a_old)\n            \n            uncovered_mods = mod_r[cnt_temp == 0]\n            if len(uncovered_mods) == 0:\n                # Completely redundant prime!\n                del congr_dict[r]\n                cnt_array = cnt_temp\n                logm -= math.log(r)\n                logboost -= math.log(r / (r - 1))\n                continue\n                \n            counts = np.bincount(uncovered_mods, minlength=r)\n            a_new = int(counts.argmax())\n            if counts[a_new] == 0:\n                # Completely redundant prime!\n                del congr_dict[r]\n                cnt_array = cnt_temp\n                logm -= math.log(r)\n                logboost -= math.log(r / (r - 1))\n                continue\n                \n            congr_dict[r] = a_new\n            cnt_array = cnt_temp + (mod_r == a_new)\n            \n        n_res_val = int((cnt_array == 0).sum())\n        return congr_dict, cnt_array, n_res_val, logm, logboost\n\n    # Perform initial polish to ensure optimal state before SA\n    congr_dict, cnt_array, n_res, logm, logboost = local_polish(congr_dict, cnt_array, logm, logboost)\n    congr_keys = set(congr_dict.keys())\n\n    current_score, E_actual, m_digits = get_score_and_E(n_res, logm, logboost)\n    \n    # Run multiple inner simulated annealing iterations to optimize thoroughly\n    inner_iters = 4000\n    \n    for _ in range(inner_iters):\n        # Dynamically set action weights to guide search based on E_actual\n        if E_actual > 17.49:\n            # Danger of violating constraints! Heavily bias towards adding or adjusting to decrease E.\n            actions = [\'adjust\', \'drop\', \'add\', \'swap\']\n            weights = [0.30, 0.02, 0.38, 0.30]\n        elif E_actual < 17.42:\n            # Safe zone! Actively drop primes or swap to increase E and decrease D.\n            actions = [\'adjust\', \'drop\', \'add\', \'swap\']\n            weights = [0.15, 0.45, 0.05, 0.35]\n        else:\n            # Sweet spot! Balanced fine-tuning.\n            actions = [\'adjust\', \'drop\', \'add\', \'swap\']\n            weights = [0.25, 0.15, 0.15, 0.45]\n\n        action = random.choices(actions, weights=weights, k=1)[0]\n        \n        if action == \'adjust\' and congr_dict:\n            r = random.choice(list(congr_dict.keys()))\n            a_old = congr_dict[r]\n            mod_r = modulo_cache[r]\n            mask_old = (mod_r == a_old)\n            cnt_temp = cnt_array - mask_old\n            \n            uncovered_mods = mod_r[cnt_temp == 0]\n            if len(uncovered_mods) > 0:\n                counts = np.bincount(uncovered_mods, minlength=r)\n                best_a = int(counts.argmax())\n            else:\n                best_a = a_old\n            \n            if best_a != a_old:\n                n_res_new = len(uncovered_mods) - counts[best_a]\n                new_score, new_E, _ = get_score_and_E(n_res_new, logm, logboost)\n                if new_score < current_score or random.random() < math.exp((current_score - new_score) / t_temp):\n                    congr_dict[r] = best_a\n                    cnt_array = cnt_temp + (mod_r == best_a)\n                    n_res = n_res_new\n                    current_score = new_score\n                    E_actual = new_E\n                    \n        elif action == \'drop\' and len(congr_dict) > 1:\n            cnt_eq_1 = (cnt_array == 1)\n            if random.random() < 0.5:\n                r = random.choice(list(congr_dict.keys()))\n            else:\n                r_sample = random.sample(list(congr_dict.keys()), min(10, len(congr_dict)))\n                r = min(r_sample, key=lambda rx: np.sum(cnt_eq_1 & (modulo_cache[rx] == congr_dict[rx])))\n            \n            a = congr_dict[r]\n            mod_r = modulo_cache[r]\n            mask = (mod_r == a)\n            n_res_new = n_res + int(np.sum(cnt_eq_1 & mask))\n            logm_new = logm - math.log(r)\n            logboost_new = logboost - math.log(r / (r - 1))\n            new_score, new_E, _ = get_score_and_E(n_res_new, logm_new, logboost_new)\n            if new_score < current_score or random.random() < math.exp((current_score - new_score) / t_temp):\n                del congr_dict[r]\n                congr_keys.remove(r)\n                cnt_array -= mask\n                n_res = n_res_new\n                logm = logm_new\n                logboost = logboost_new\n                current_score = new_score\n                E_actual = new_E\n                \n        elif action == \'add\':\n            avail = list(cand_mods_set - congr_keys)\n            if avail:\n                sampled = random.sample(avail, min(150, len(avail)))\n                best_r, best_a, best_n_res_new, best_score, best_E = None, None, None, float(\'inf\'), None\n                uncovered_indices = (cnt_array == 0)\n                \n                for r in sampled:\n                    mod_r = modulo_cache[r]\n                    uncovered_mods = mod_r[uncovered_indices]\n                    if len(uncovered_mods) == 0:\n                        continue\n                    counts = np.bincount(uncovered_mods, minlength=r)\n                    a = int(counts.argmax())\n                    n_res_new = len(uncovered_mods) - counts[a]\n                    logm_new = logm + math.log(r)\n                    logboost_new = logboost + math.log(r / (r - 1))\n                    score, E_val, _ = get_score_and_E(n_res_new, logm_new, logboost_new)\n                    if score < best_score:\n                        best_score, best_r, best_a, best_n_res_new, best_E = score, r, a, n_res_new, E_val\n                \n                if best_r is not None:\n                    if best_score < current_score or random.random() < math.exp((current_score - best_score) / t_temp):\n                        congr_dict[best_r] = best_a\n                        congr_keys.add(best_r)\n                        cnt_array += (modulo_cache[best_r] == best_a)\n                        n_res = int(best_n_res_new)\n                        logm = logm + math.log(best_r)\n                        logboost = logboost + math.log(best_r / (best_r - 1))\n                        current_score = best_score\n                        E_actual = best_E\n                        \n        elif action == \'swap\' and congr_dict:\n            if random.random() < 0.5:\n                r_in = random.choice(list(congr_dict.keys()))\n            else:\n                cnt_eq_1 = (cnt_array == 1)\n                r_sample = random.sample(list(congr_dict.keys()), min(10, len(congr_dict)))\n                r_in = min(r_sample, key=lambda rx: np.sum(cnt_eq_1 & (modulo_cache[rx] == congr_dict[rx])))\n                \n            avail = list(cand_mods_set - congr_keys)\n            if avail:\n                sampled = random.sample(avail, min(150, len(avail)))\n                a_in = congr_dict[r_in]\n                mod_r_in = modulo_cache[r_in]\n                mask_in = (mod_r_in == a_in)\n                cnt_temp = cnt_array - mask_in\n                logm_temp = logm - math.log(r_in)\n                logboost_temp = logboost - math.log(r_in / (r_in - 1))\n                \n                best_r, best_a, best_n_res_new, best_score, best_E = None, None, None, float(\'inf\'), None\n                uncovered_indices = (cnt_temp == 0)\n                \n                for r_out in sampled:\n                    mod_r_out = modulo_cache[r_out]\n                    uncovered_mods = mod_r_out[uncovered_indices]\n                    if len(uncovered_mods) == 0:\n                        continue\n                    counts = np.bincount(uncovered_mods, minlength=r_out)\n                    a_out = int(counts.argmax())\n                    n_res_new = len(uncovered_mods) - counts[a_out]\n                    logm_new = logm_temp + math.log(r_out)\n                    logboost_new = logboost_temp + math.log(r_out / (r_out - 1))\n                    score, E_val, _ = get_score_and_E(n_res_new, logm_new, logboost_new)\n                    if score < best_score:\n                        best_score, best_r, best_a, best_n_res_new, best_E = score, r_out, a_out, n_res_new, E_val\n                \n                if best_r is not None:\n                    if best_score < current_score or random.random() < math.exp((current_score - best_score) / t_temp):\n                        del congr_dict[r_in]\n                        congr_keys.remove(r_in)\n                        congr_dict[best_r] = best_a\n                        congr_keys.add(best_r)\n                        cnt_array = cnt_temp + (modulo_cache[best_r] == best_a)\n                        n_res = int(best_n_res_new)\n                        logm = logm_temp + math.log(best_r)\n                        logboost = logboost_temp + math.log(best_r / (best_r - 1))\n                        current_score = best_score\n                        E_actual = best_E\n\n        # Periodic redundancy check and offset polishing to keep search space extremely clean\n        if _ % 1000 == 0 and _ > 0:\n            congr_dict, cnt_array, n_res, logm, logboost = local_polish(congr_dict, cnt_array, logm, logboost)\n            congr_keys = set(congr_dict.keys())\n            current_score, E_actual, m_digits = get_score_and_E(n_res, logm, logboost)\n\n    # Final polish before returning\n    congr_dict, cnt_array, n_res, logm, logboost = local_polish(congr_dict, cnt_array, logm, logboost)\n    return congr_dict\n# EVOLVE-BLOCK-END\n\ndef evaluate(eval_inputs: Mapping[str, Any]) -> dict[str, float]:\n    """Run evaluation on the optimized step."""\n    import sympy\n    import numpy as np\n    Q = 100003\n    targets = np.array(list(sympy.primerange(3, Q)), dtype=np.int64)\n    \n    # Warm-start from the 195-digit record cover instead of starting empty\n    congr_dict = {int(r): int(a) for r, a in eval_inputs["warm_start_cover"]}\n    \n    cand_mods = [int(r) for r in sympy.primerange(3, 8000)]\n    cnt_array = np.zeros(len(targets), dtype=np.int16)\n    \n    # Pre-populate counts\n    for r, a in congr_dict.items():\n        cnt_array += (targets % r) == a\n        \n    for it in range(10):\n        t_temp = 0.8 * (0.02 / 0.8) ** (it / 10)\n        # Recalculate cnt_array based on congr_dict\n        cnt_array = np.zeros(len(targets), dtype=np.int16)\n        logm = math.log(2)\n        logboost = math.log(2.0)\n        for r, a in congr_dict.items():\n            cnt_array += (targets % r) == a\n            logm += math.log(r)\n            logboost += math.log(r / (r - 1))\n            \n        congr_dict = optimize_cover_step(congr_dict, cand_mods, targets, cnt_array, logm, logboost, t_temp)\n        \n    # Recalculate final metrics\n    cnt_array = np.zeros(len(targets), dtype=np.int16)\n    logm = math.log(2)\n    logboost = math.log(2.0)\n    for r, a in congr_dict.items():\n        cnt_array += (targets % r) == a\n        logm += math.log(r)\n        logboost += math.log(r / (r - 1))\n        \n    n_res = int((cnt_array == 0).sum())\n    boost = math.exp(logboost)\n    m_digits = logm / math.log(10)\n    \n    ub = n_res * boost\n    LN10 = math.log(10)\n    D = (m_digits + math.sqrt(m_digits ** 2 + 4 * ub / (LN10 * LN10))) / 2\n    \n    # Constrain E <= 17.5 via Lagrangian penalty to prevent reward hacking\n    E_limit = 17.5\n    E_actual = ub / (D * LN10) if D > 0 else 0.0\n    lagrangian_penalty = 0.0\n    if E_actual > E_limit:\n        lagrangian_penalty = 100.0 * (E_actual - E_limit) ** 2\n        \n    score_headline = -float(D + lagrangian_penalty)\n    \n    # Expose E, |U|, digits(M) as negated secondary metrics for joint optimization visibility\n    return {\n        "neg_est_digits": score_headline,\n        "neg_E": -float(E_actual),\n        "neg_residual_count": -float(n_res),\n        "neg_m_digits": -float(m_digits)\n    }\n'}]}, 'evaluation': {'scores': {'scores': [{'metric': 'neg_est_digits', 'score': -192.68948}, {'metric': 'neg_E', 'score': -17.500101}, {'metric': 'neg_residual_count', 'score': -709}, {'metric': 'neg_m_digits', 'score': -185.0893}]}, 'insights': {'insights': [{'label': 'Evaluation Metrics', 'text': 'Estimated Digits: 192.6895 (constrained), E: 17.5001, |U|: 709, digits(M): 185.09'}]}}, 'parentPrograms': ['projects/799795028847/locations/global/collections/default_collection/engines/goldbach_1784979910032/sessions/7658735534374771723/alphaEvolveExperiments/9582896010645531772/alphaEvolvePrograms/6680257159901447695'], 'state': 'COMPLETED'}, {'name': 'projects/799795028847/locations/global/collections/default_collection/engines/goldbach_1784979910032/sessions/7658735534374771723/alphaEvolveExperiments/9582896010645531772/alphaEvolvePrograms/7662895210918131002', 'createTime': '2026-07-26T05:56:09.736460Z', 'content': {'files': [{'path': 'program.py', 'content': '# Copyright 2026 Google LLC\nfrom typing import Any, Mapping\nimport math\nimport random\nimport numpy as np\n\n# EVOLVE-BLOCK-START\ndef optimize_cover_step(congr_dict, cand_mods, targets, cnt_array, logm, logboost, t_temp):\n    """Optimize congruence cover using a powerful local search with Simulated Annealing style logic."""\n    import numpy as np\n    import random\n    import math\n\n    if len(targets) == 0:\n        return congr_dict\n\n    # Copy to avoid side effects during search\n    congr_dict = dict(congr_dict)\n    cnt_array = cnt_array.copy()\n    n_res = int((cnt_array == 0).sum())\n\n    def calc_D_val(n_res_val, logm_val, logboost_val):\n        boost = math.exp(logboost_val)\n        m_digits = logm_val / math.log(10)\n        ub = n_res_val * boost\n        LN10 = math.log(10)\n        inside_sqrt = m_digits ** 2 + 4 * ub / (LN10 * LN10)\n        D = (m_digits + math.sqrt(max(0.0, inside_sqrt))) / 2\n        \n        E_limit = 17.5\n        E_actual = ub / (D * LN10) if D > 0 else 0.0\n        lagrangian_penalty = 0.0\n        if E_actual > E_limit:\n            lagrangian_penalty = 1000.0 * (E_actual - E_limit) ** 2\n        return D + lagrangian_penalty\n\n    def optimize_all(congr, cnt):\n        keys = list(congr.keys())\n        random.shuffle(keys)\n        for r in keys:\n            a_old = congr[r]\n            rem = targets % r\n            cnt[rem == a_old] -= 1\n            counts = np.bincount(rem, weights=(cnt == 0), minlength=r)\n            a_new = int(np.argmax(counts))\n            cnt[rem == a_new] += 1\n            congr[r] = a_new\n\n    # Initial residue optimization\n    optimize_all(congr_dict, cnt_array)\n    n_res = int((cnt_array == 0).sum())\n    current_D = calc_D_val(n_res, logm, logboost)\n\n    best_congr = dict(congr_dict)\n    best_D = current_D\n\n    temp = max(t_temp, 1e-6)\n    N_STEPS = 500\n\n    for step in range(N_STEPS):\n        # Periodically optimize all to stay on the local optimum manifold\n        if step > 0 and step % 100 == 0:\n            optimize_all(congr_dict, cnt_array)\n            n_res = int((cnt_array == 0).sum())\n            current_D = calc_D_val(n_res, logm, logboost)\n\n        action = random.choices([\'add\', \'drop\', \'swap\', \'optimize\'], weights=[0.20, 0.20, 0.45, 0.15], k=1)[0]\n\n        if action == \'add\':\n            cand_pool = [m for m in cand_mods if m not in congr_dict]\n            if cand_pool:\n                sampled = random.sample(cand_pool, min(40, len(cand_pool)))\n                best_r = None\n                best_a = None\n                best_new_D = float(\'inf\')\n                best_new_n_res = n_res\n                \n                uncovered = (cnt_array == 0)\n                for r in sampled:\n                    rem = targets % r\n                    counts = np.bincount(rem, weights=uncovered, minlength=r)\n                    a = int(np.argmax(counts))\n                    \n                    added_cov = counts[a]\n                    new_n_res = n_res - added_cov\n                    new_logm = logm + math.log(r)\n                    new_logboost = logboost + math.log(r / (r - 1))\n                    new_D = calc_D_val(new_n_res, new_logm, new_logboost)\n                    if new_D < best_new_D:\n                        best_new_D = new_D\n                        best_r = r\n                        best_a = a\n                        best_new_n_res = new_n_res\n                        \n                if best_r is not None:\n                    delta = best_new_D - current_D\n                    if delta < 0 or random.random() < math.exp(-delta / temp):\n                        congr_dict[best_r] = best_a\n                        cnt_array[targets % best_r == best_a] += 1\n                        n_res = best_new_n_res\n                        logm += math.log(best_r)\n                        logboost += math.log(best_r / (best_r - 1))\n                        current_D = best_new_D\n\n        elif action == \'drop\':\n            active = list(congr_dict.keys())\n            if active:\n                sampled = random.sample(active, min(40, len(active)))\n                best_r = None\n                best_new_D = float(\'inf\')\n                best_new_n_res = n_res\n                \n                singly_covered = (cnt_array == 1)\n                for r in sampled:\n                    a = congr_dict[r]\n                    lost_cov = np.sum(singly_covered & (targets % r == a))\n                    new_n_res = n_res + lost_cov\n                    new_logm = logm - math.log(r)\n                    new_logboost = logboost - math.log(r / (r - 1))\n                    new_D = calc_D_val(new_n_res, new_logm, new_logboost)\n                    if new_D < best_new_D:\n                        best_new_D = new_D\n                        best_r = r\n                        best_new_n_res = new_n_res\n                        \n                if best_r is not None:\n                    delta = best_new_D - current_D\n                    if delta < 0 or random.random() < math.exp(-delta / temp):\n                        r_drop = best_r\n                        a_drop = congr_dict[r_drop]\n                        cnt_array[targets % r_drop == a_drop] -= 1\n                        del congr_dict[r_drop]\n                        n_res = best_new_n_res\n                        logm -= math.log(r_drop)\n                        logboost -= math.log(r_drop / (r_drop - 1))\n                        current_D = best_new_D\n\n        elif action == \'swap\':\n            active = list(congr_dict.keys())\n            cand_pool = [m for m in cand_mods if m not in congr_dict]\n            if active and cand_pool:\n                # Find worst active prime (parasite)\n                singly_covered = (cnt_array == 1)\n                worst_r_drop = None\n                worst_efficiency = float(\'inf\')\n                sampled_drops = random.sample(active, min(10, len(active)))\n                for r in sampled_drops:\n                    a = congr_dict[r]\n                    unique_cov = np.sum(singly_covered & (targets % r == a))\n                    efficiency = unique_cov / math.log(r)\n                    if efficiency < worst_efficiency:\n                        worst_efficiency = efficiency\n                        worst_r_drop = r\n                \n                if worst_r_drop is not None:\n                    a_drop = congr_dict[worst_r_drop]\n                    rem_drop = targets % worst_r_drop\n                    cnt_array[rem_drop == a_drop] -= 1\n                    uncovered = (cnt_array == 0)\n                    \n                    n_res_after_drop = int(uncovered.sum())\n                    logm_after_drop = logm - math.log(worst_r_drop)\n                    logboost_after_drop = logboost - math.log(worst_r_drop / (worst_r_drop - 1))\n                    \n                    sampled_add = random.sample(cand_pool, min(40, len(cand_pool)))\n                    best_add_r = None\n                    best_add_a = None\n                    best_new_D = float(\'inf\')\n                    best_new_n_res = n_res\n                    \n                    for r in sampled_add:\n                        rem_add = targets % r\n                        counts = np.bincount(rem_add, weights=uncovered, minlength=r)\n                        a = int(np.argmax(counts))\n                        added_cov = counts[a]\n                        \n                        new_n_res = n_res_after_drop - added_cov\n                        new_logm = logm_after_drop + math.log(r)\n                        new_logboost = logboost_after_drop + math.log(r / (r - 1))\n                        \n                        new_D = calc_D_val(new_n_res, new_logm, new_logboost)\n                        if new_D < best_new_D:\n                            best_new_D = new_D\n                            best_add_r = r\n                            best_add_a = a\n                            best_new_n_res = new_n_res\n                            \n                    if best_add_r is not None:\n                        delta = best_new_D - current_D\n                        if delta < 0 or random.random() < math.exp(-delta / temp):\n                            del congr_dict[worst_r_drop]\n                            congr_dict[best_add_r] = best_add_a\n                            cnt_array[targets % best_add_r == best_add_a] += 1\n                            n_res = best_new_n_res\n                            logm = logm_after_drop + math.log(best_add_r)\n                            logboost = logboost_after_drop + math.log(best_add_r / (best_add_r - 1))\n                            current_D = best_new_D\n                        else:\n                            cnt_array[rem_drop == a_drop] += 1\n                    else:\n                        cnt_array[rem_drop == a_drop] += 1\n\n        elif action == \'optimize\':\n            active = list(congr_dict.keys())\n            if active:\n                sampled = random.sample(active, min(10, len(active)))\n                for r in sampled:\n                    a_old = congr_dict[r]\n                    rem = targets % r\n                    cnt_array[rem == a_old] -= 1\n                    counts = np.bincount(rem, weights=(cnt_array == 0), minlength=r)\n                    a_new = int(np.argmax(counts))\n                    cnt_array[rem == a_new] += 1\n                    congr_dict[r] = a_new\n                n_res = int((cnt_array == 0).sum())\n                current_D = calc_D_val(n_res, logm, logboost)\n\n        if current_D < best_D:\n            best_D = current_D\n            best_congr = dict(congr_dict)\n\n    # Re-evaluate best_congr and optimize it fully one last time\n    cnt_array = np.zeros(len(targets), dtype=np.int16)\n    for r, a in best_congr.items():\n        cnt_array += (targets % r) == a\n    optimize_all(best_congr, cnt_array)\n    return best_congr\n# EVOLVE-BLOCK-END\n\ndef evaluate(eval_inputs: Mapping[str, Any]) -> dict[str, float]:\n    """Run evaluation on the optimized step."""\n    import sympy\n    import numpy as np\n    Q = 100003\n    targets = np.array(list(sympy.primerange(3, Q)), dtype=np.int64)\n    \n    # Warm-start from the 195-digit record cover instead of starting empty\n    congr_dict = {int(r): int(a) for r, a in eval_inputs["warm_start_cover"]}\n    \n    cand_mods = [int(r) for r in sympy.primerange(3, 8000)]\n    cnt_array = np.zeros(len(targets), dtype=np.int16)\n    \n    # Pre-populate counts\n    for r, a in congr_dict.items():\n        cnt_array += (targets % r) == a\n        \n    for it in range(10):\n        t_temp = 0.8 * (0.02 / 0.8) ** (it / 10)\n        # Recalculate cnt_array based on congr_dict\n        cnt_array = np.zeros(len(targets), dtype=np.int16)\n        logm = math.log(2)\n        logboost = math.log(2.0)\n        for r, a in congr_dict.items():\n            cnt_array += (targets % r) == a\n            logm += math.log(r)\n            logboost += math.log(r / (r - 1))\n            \n        congr_dict = optimize_cover_step(congr_dict, cand_mods, targets, cnt_array, logm, logboost, t_temp)\n        \n    # Recalculate final metrics\n    cnt_array = np.zeros(len(targets), dtype=np.int16)\n    logm = math.log(2)\n    logboost = math.log(2.0)\n    for r, a in congr_dict.items():\n        cnt_array += (targets % r) == a\n        logm += math.log(r)\n        logboost += math.log(r / (r - 1))\n        \n    n_res = int((cnt_array == 0).sum())\n    boost = math.exp(logboost)\n    m_digits = logm / math.log(10)\n    \n    ub = n_res * boost\n    LN10 = math.log(10)\n    D = (m_digits + math.sqrt(m_digits ** 2 + 4 * ub / (LN10 * LN10))) / 2\n    \n    # Constrain E <= 17.5 via Lagrangian penalty to prevent reward hacking\n    E_limit = 17.5\n    E_actual = ub / (D * LN10) if D > 0 else 0.0\n    lagrangian_penalty = 0.0\n    if E_actual > E_limit:\n        lagrangian_penalty = 100.0 * (E_actual - E_limit) ** 2\n        \n    score_headline = -float(D + lagrangian_penalty)\n    \n    # Expose E, |U|, digits(M) as negated secondary metrics for joint optimization visibility\n    return {\n        "neg_est_digits": score_headline,\n        "neg_E": -float(E_actual),\n        "neg_residual_count": -float(n_res),\n        "neg_m_digits": -float(m_digits)\n    }\n'}]}, 'evaluation': {'scores': {'scores': [{'metric': 'neg_est_digits', 'score': -192.722}, {'metric': 'neg_E', 'score': -17.48807}, {'metric': 'neg_residual_count', 'score': -709}, {'metric': 'neg_m_digits', 'score': -185.12703}]}, 'insights': {'insights': [{'label': 'Evaluation Metrics', 'text': 'Estimated Digits: 192.7220 (constrained), E: 17.4881, |U|: 709, digits(M): 185.13'}]}}, 'parentPrograms': ['projects/799795028847/locations/global/collections/default_collection/engines/goldbach_1784979910032/sessions/7658735534374771723/alphaEvolveExperiments/9582896010645531772/alphaEvolvePrograms/7662895210918133148', 'projects/799795028847/locations/global/collections/default_collection/engines/goldbach_1784979910032/sessions/7658735534374771723/alphaEvolveExperiments/9582896010645531772/alphaEvolvePrograms/7662895210918133148', 'projects/799795028847/locations/global/collections/default_collection/engines/goldbach_1784979910032/sessions/7658735534374771723/alphaEvolveExperiments/9582896010645531772/alphaEvolvePrograms/7662895210918131739', 'projects/799795028847/locations/global/collections/default_collection/engines/goldbach_1784979910032/sessions/7658735534374771723/alphaEvolveExperiments/9582896010645531772/alphaEvolvePrograms/7662895210918132141'], 'state': 'COMPLETED'}, {'name': 'projects/799795028847/locations/global/collections/default_collection/engines/goldbach_1784979910032/sessions/7658735534374771723/alphaEvolveExperiments/9582896010645531772/alphaEvolvePrograms/7662895210918130945', 'createTime': '2026-07-26T06:10:15.346233Z', 'content': {'files': [{'path': 'program.py', 'content': '# Copyright 2026 Google LLC\nfrom typing import Any, Mapping\nimport math\nimport random\nimport numpy as np\n\n# EVOLVE-BLOCK-START\ndef optimize_cover_step(congr_dict, cand_mods, targets, cnt_array, logm, logboost, t_temp):\n    """Optimize congruence cover using a powerful Gibbs-sampling local search with Simulated Annealing."""\n    import numpy as np\n    import random\n    import math\n\n    if len(targets) == 0:\n        return congr_dict\n\n    # Copy to avoid side effects\n    cnt_array = cnt_array.copy()\n    congr_dict = congr_dict.copy()\n\n    # Precompute mod arrays in int16 for lightning-fast lookups (removes division bottleneck)\n    mod_cache = {r: (targets % r).astype(np.int16) for r in cand_mods}\n\n    def calc_D_val(n_res_val, logm_val, logboost_val):\n        boost = math.exp(logboost_val)\n        m_digits = logm_val / math.log(10)\n        ub = n_res_val * boost\n        LN10 = math.log(10)\n        inside_sqrt = m_digits ** 2 + 4 * ub / (LN10 * LN10)\n        D = (m_digits + math.sqrt(max(0.0, inside_sqrt))) / 2\n        \n        E_limit = 17.5\n        E_actual = ub / (D * LN10) if D > 0 else 0.0\n        lagrangian_penalty = 0.0\n        if E_actual > E_limit:\n            lagrangian_penalty = 100.0 * (E_actual - E_limit) ** 2\n        return D + lagrangian_penalty\n\n    # Complete residue optimization helper\n    def optimize_all(congr, cnt):\n        keys = list(congr.keys())\n        random.shuffle(keys)\n        for r in keys:\n            a_old = congr[r]\n            cnt -= (mod_cache[r] == a_old)\n            uncovered = (cnt == 0)\n            if np.any(uncovered):\n                rem = mod_cache[r][uncovered]\n                counts = np.bincount(rem, minlength=r)\n                a_new = int(np.argmax(counts))\n            else:\n                a_new = 0\n            cnt += (mod_cache[r] == a_new)\n            congr[r] = a_new\n\n    optimize_all(congr_dict, cnt_array)\n    n_res = int((cnt_array == 0).sum())\n    current_D = calc_D_val(n_res, logm, logboost)\n\n    base_temp = max(t_temp, 1e-4)\n    N_STEPS = 150\n\n    for step in range(N_STEPS):\n        temp = base_temp * (0.85 ** (step / N_STEPS))\n\n        # Periodically keep residues strictly optimized\n        if step > 0 and step % 75 == 0:\n            optimize_all(congr_dict, cnt_array)\n            n_res = int((cnt_array == 0).sum())\n            current_D = calc_D_val(n_res, logm, logboost)\n\n        mods_in = list(congr_dict.keys())\n        cand_pool = [m for m in cand_mods if m not in congr_dict]\n\n        singly_covered = (cnt_array == 1)\n        uncovered_indices = (cnt_array == 0)\n        n_res = int(uncovered_indices.sum())\n\n        moves = []\n\n        # 1. Drop moves: Biased heavily towards dropping larger primes\n        if mods_in:\n            mods_in_sorted = sorted(mods_in)\n            mods_len = len(mods_in_sorted)\n            indices = set()\n            attempts = 0\n            while len(indices) < min(30, mods_len) and attempts < 300:\n                attempts += 1\n                idx = int(mods_len * (1.0 - random.random() ** 1.8))\n                indices.add(idx)\n            if len(indices) < min(30, mods_len):\n                remaining = set(range(mods_len)) - indices\n                indices.update(random.sample(list(remaining), min(30, mods_len) - len(indices)))\n            sampled_drops = [mods_in_sorted[i] for i in indices]\n\n            for r in sampled_drops:\n                a = congr_dict[r]\n                loss = np.sum(singly_covered & (mod_cache[r] == a))\n                new_n_res = n_res + loss\n                new_logm = logm - math.log(r)\n                new_logboost = logboost - math.log(r / (r - 1))\n                D_after = calc_D_val(new_n_res, new_logm, new_logboost)\n                delta = D_after - current_D\n                moves.append((\'drop\', r, a, delta))\n\n        # 2. Add moves: Biased heavily towards adding smaller primes (lower m_digits)\n        if cand_pool:\n            cand_pool_sorted = sorted(cand_pool)\n            pool_len = len(cand_pool_sorted)\n            indices = set()\n            attempts = 0\n            while len(indices) < min(150, pool_len) and attempts < 1000:\n                attempts += 1\n                idx = int(pool_len * (random.random() ** 1.8))\n                indices.add(idx)\n            if len(indices) < min(150, pool_len):\n                remaining = set(range(pool_len)) - indices\n                indices.update(random.sample(list(remaining), min(150, pool_len) - len(indices)))\n            sampled_adds = [cand_pool_sorted[i] for i in indices]\n\n            for r in sampled_adds:\n                if n_res > 0:\n                    rem = mod_cache[r][uncovered_indices]\n                    counts = np.bincount(rem, minlength=r)\n                    a = int(np.argmax(counts))\n                    added_cov = counts[a]\n                else:\n                    a = 0\n                    added_cov = 0\n                new_n_res = n_res - added_cov\n                new_logm = logm + math.log(r)\n                new_logboost = logboost + math.log(r / (r - 1))\n                D_after = calc_D_val(new_n_res, new_logm, new_logboost)\n                delta = D_after - current_D\n                moves.append((\'add\', r, a, delta))\n\n        # 3. Swap moves: Biased drop of large prime + biased add of small prime\n        if mods_in and cand_pool:\n            mods_in_sorted = sorted(mods_in)\n            mods_len = len(mods_in_sorted)\n            indices = set()\n            attempts = 0\n            while len(indices) < min(10, mods_len) and attempts < 100:\n                attempts += 1\n                idx = int(mods_len * (1.0 - random.random() ** 1.8))\n                indices.add(idx)\n            if len(indices) < min(10, mods_len):\n                remaining = set(range(mods_len)) - indices\n                indices.update(random.sample(list(remaining), min(10, mods_len) - len(indices)))\n            sampled_swap_drops = [mods_in_sorted[i] for i in indices]\n\n            cand_pool_sorted = sorted(cand_pool)\n            pool_len = len(cand_pool_sorted)\n            indices = set()\n            attempts = 0\n            while len(indices) < min(10, pool_len) and attempts < 100:\n                attempts += 1\n                idx = int(pool_len * (random.random() ** 1.8))\n                indices.add(idx)\n            if len(indices) < min(10, pool_len):\n                remaining = set(range(pool_len)) - indices\n                indices.update(random.sample(list(remaining), min(10, pool_len) - len(indices)))\n            sampled_swap_adds = [cand_pool_sorted[i] for i in indices]\n\n            for r_drop in sampled_swap_drops:\n                a_drop = congr_dict[r_drop]\n                loss = np.sum(singly_covered & (mod_cache[r_drop] == a_drop))\n                n_res_mid = n_res + loss\n                logm_mid = logm - math.log(r_drop)\n                logboost_mid = logboost - math.log(r_drop / (r_drop - 1))\n                uncovered_mid = uncovered_indices | (mod_cache[r_drop] == a_drop)\n\n                for r_add in sampled_swap_adds:\n                    if n_res_mid > 0:\n                        rem = mod_cache[r_add][uncovered_mid]\n                        counts = np.bincount(rem, minlength=r_add)\n                        a_add = int(np.argmax(counts))\n                        added_cov = counts[a_add]\n                    else:\n                        a_add = 0\n                        added_cov = 0\n                    new_n_res = n_res_mid - added_cov\n                    new_logm = logm_mid + math.log(r_add)\n                    new_logboost = logboost_mid + math.log(r_add / (r_add - 1))\n                    D_after = calc_D_val(new_n_res, new_logm, new_logboost)\n                    delta = D_after - current_D\n                    moves.append((\'swap\', (r_drop, a_drop), (r_add, a_add), delta))\n\n        if not moves:\n            continue\n\n        # Heat Bath selection over proposals using soft-max scaling\n        deltas = np.array([m[3] for m in moves])\n        scaled_scores = -deltas / temp\n        scaled_scores = scaled_scores - np.max(scaled_scores)\n        probs = np.exp(scaled_scores)\n        probs_sum = np.sum(probs)\n        if probs_sum > 0:\n            probs /= probs_sum\n        else:\n            probs = np.ones(len(moves)) / len(moves)\n\n        idx = np.random.choice(len(moves), p=probs)\n        selected_move = moves[idx]\n\n        # Execute transition\n        kind = selected_move[0]\n        if kind == \'drop\':\n            _, r, a, _ = selected_move\n            cnt_array -= (mod_cache[r] == a)\n            del congr_dict[r]\n            logm -= math.log(r)\n            logboost -= math.log(r / (r - 1))\n        elif kind == \'add\':\n            _, r, a, _ = selected_move\n            congr_dict[r] = a\n            cnt_array += (mod_cache[r] == a)\n            logm += math.log(r)\n            logboost += math.log(r / (r - 1))\n        elif kind == \'swap\':\n            _, (r_drop, a_drop), (r_add, a_add), _ = selected_move\n            cnt_array -= (mod_cache[r_drop] == a_drop)\n            del congr_dict[r_drop]\n            logm -= math.log(r_drop)\n            logboost -= math.log(r_drop / (r_drop - 1))\n\n            congr_dict[r_add] = a_add\n            cnt_array += (mod_cache[r_add] == a_add)\n            logm += math.log(r_add)\n            logboost += math.log(r_add / (r_add - 1))\n\n        # Local cleanup: micro-optimizations of residues\n        mods_in = list(congr_dict.keys())\n        if mods_in:\n            sampled_mods = random.sample(mods_in, min(10, len(mods_in)))\n            for r in sampled_mods:\n                a_old = congr_dict[r]\n                cnt_array -= (mod_cache[r] == a_old)\n                uncovered = (cnt_array == 0)\n                if np.any(uncovered):\n                    rem = mod_cache[r][uncovered]\n                    counts = np.bincount(rem, minlength=r)\n                    a_new = int(np.argmax(counts))\n                else:\n                    a_new = 0\n                cnt_array += (mod_cache[r] == a_new)\n                congr_dict[r] = a_new\n\n        n_res = int((cnt_array == 0).sum())\n        current_D = calc_D_val(n_res, logm, logboost)\n\n    optimize_all(congr_dict, cnt_array)\n    return congr_dict\n# EVOLVE-BLOCK-END\n\ndef evaluate(eval_inputs: Mapping[str, Any]) -> dict[str, float]:\n    """Run evaluation on the optimized step."""\n    import sympy\n    import numpy as np\n    Q = 100003\n    targets = np.array(list(sympy.primerange(3, Q)), dtype=np.int64)\n    \n    # Warm-start from the 195-digit record cover instead of starting empty\n    congr_dict = {int(r): int(a) for r, a in eval_inputs["warm_start_cover"]}\n    \n    cand_mods = [int(r) for r in sympy.primerange(3, 8000)]\n    cnt_array = np.zeros(len(targets), dtype=np.int16)\n    \n    # Pre-populate counts\n    for r, a in congr_dict.items():\n        cnt_array += (targets % r) == a\n        \n    for it in range(10):\n        t_temp = 0.8 * (0.02 / 0.8) ** (it / 10)\n        # Recalculate cnt_array based on congr_dict\n        cnt_array = np.zeros(len(targets), dtype=np.int16)\n        logm = math.log(2)\n        logboost = math.log(2.0)\n        for r, a in congr_dict.items():\n            cnt_array += (targets % r) == a\n            logm += math.log(r)\n            logboost += math.log(r / (r - 1))\n            \n        congr_dict = optimize_cover_step(congr_dict, cand_mods, targets, cnt_array, logm, logboost, t_temp)\n        \n    # Recalculate final metrics\n    cnt_array = np.zeros(len(targets), dtype=np.int16)\n    logm = math.log(2)\n    logboost = math.log(2.0)\n    for r, a in congr_dict.items():\n        cnt_array += (targets % r) == a\n        logm += math.log(r)\n        logboost += math.log(r / (r - 1))\n        \n    n_res = int((cnt_array == 0).sum())\n    boost = math.exp(logboost)\n    m_digits = logm / math.log(10)\n    \n    ub = n_res * boost\n    LN10 = math.log(10)\n    D = (m_digits + math.sqrt(m_digits ** 2 + 4 * ub / (LN10 * LN10))) / 2\n    \n    # Constrain E <= 17.5 via Lagrangian penalty to prevent reward hacking\n    E_limit = 17.5\n    E_actual = ub / (D * LN10) if D > 0 else 0.0\n    lagrangian_penalty = 0.0\n    if E_actual > E_limit:\n        lagrangian_penalty = 100.0 * (E_actual - E_limit) ** 2\n        \n    score_headline = -float(D + lagrangian_penalty)\n    \n    # Expose E, |U|, digits(M) as negated secondary metrics for joint optimization visibility\n    return {\n        "neg_est_digits": score_headline,\n        "neg_E": -float(E_actual),\n        "neg_residual_count": -float(n_res),\n        "neg_m_digits": -float(m_digits)\n    }\n'}]}, 'evaluation': {'scores': {'scores': [{'metric': 'neg_est_digits', 'score': -192.77368}, {'metric': 'neg_E', 'score': -17.412212}, {'metric': 'neg_residual_count', 'score': -706}, {'metric': 'neg_m_digits', 'score': -185.21165}]}, 'insights': {'insights': [{'label': 'Evaluation Metrics', 'text': 'Estimated Digits: 192.7737 (constrained), E: 17.4122, |U|: 706, digits(M): 185.21'}]}}, 'parentPrograms': ['projects/799795028847/locations/global/collections/default_collection/engines/goldbach_1784979910032/sessions/7658735534374771723/alphaEvolveExperiments/9582896010645531772/alphaEvolvePrograms/7662895210918131204', 'projects/799795028847/locations/global/collections/default_collection/engines/goldbach_1784979910032/sessions/7658735534374771723/alphaEvolveExperiments/9582896010645531772/alphaEvolvePrograms/7662895210918132147', 'projects/799795028847/locations/global/collections/default_collection/engines/goldbach_1784979910032/sessions/7658735534374771723/alphaEvolveExperiments/9582896010645531772/alphaEvolvePrograms/7662895210918129792', 'projects/799795028847/locations/global/collections/default_collection/engines/goldbach_1784979910032/sessions/7658735534374771723/alphaEvolveExperiments/9582896010645531772/alphaEvolvePrograms/7662895210918132147'], 'state': 'COMPLETED'}, {'name': 'projects/799795028847/locations/global/collections/default_collection/engines/goldbach_1784979910032/sessions/7658735534374771723/alphaEvolveExperiments/9582896010645531772/alphaEvolvePrograms/7662895210918132085', 'createTime': '2026-07-26T06:07:52.651279Z', 'content': {'files': [{'path': 'program.py', 'content': '# Copyright 2026 Google LLC\nfrom typing import Any, Mapping\nimport math\nimport random\nimport numpy as np\n\n# EVOLVE-BLOCK-START\ndef optimize_cover_step(congr_dict, cand_mods, targets, cnt_array, logm, logboost, t_temp):\n    """Optimize congruence cover using simulated annealing and greedy hill-climbing."""\n    import numpy as np\n    import random\n    import math\n\n    if len(targets) == 0:\n        return congr_dict\n\n    LN10 = math.log(10)\n    LN10_SQ = LN10 * LN10\n\n    # Precompute modulo tables for all candidate and current moduli\n    all_mods = set(cand_mods) | set(congr_dict.keys())\n    targets_mod_r = {r: targets % r for r in all_mods}\n\n    # Precompute weights for biased sampling (smaller primes preferred)\n    cand_weights = [1.0 / (r ** 0.8) for r in cand_mods]\n    cand_to_weight = dict(zip(cand_mods, cand_weights))\n\n    def get_score_metrics(n_res, lm, lboost, penalty_w=100.0):\n        boost = math.exp(lboost)\n        m_digits = lm / LN10\n        ub = n_res * boost\n        D = (m_digits + math.sqrt(m_digits ** 2 + 4 * ub / LN10_SQ)) / 2\n        E_actual = ub / (D * LN10) if D > 0 else 0.0\n        lagrangian_penalty = 0.0\n        if E_actual > 17.5:\n            lagrangian_penalty = penalty_w * (E_actual - 17.5) ** 2\n        return -(D + lagrangian_penalty)\n\n    # Initialize current state\n    current_congr = congr_dict.copy()\n    current_cnt = cnt_array.copy()\n    current_logm = logm\n    current_logboost = logboost\n    current_n_res = np.count_nonzero(current_cnt == 0)\n    \n    best_congr = current_congr.copy()\n    best_score = get_score_metrics(current_n_res, current_logm, current_logboost, penalty_w=100.0)\n    \n    temp = max(t_temp, 1e-6)\n    sa_penalty_weight = 50.0 + 3.0 / temp\n    \n    # 1. Run SA for 2500 steps\n    sa_steps = 2500\n    for step in range(sa_steps):\n        cand_pool = [m for m in cand_mods if m not in current_congr]\n        \n        if not current_congr:\n            move_type = \'add\'\n        elif not cand_pool:\n            move_type = random.choice([\'drop\', \'mutate_a\'])\n        else:\n            move_type = random.choice([\'add\', \'drop\', \'swap\', \'swap\', \'mutate_a\', \'mutate_a\'])\n            \n        accepted = False\n        \n        if move_type == \'add\':\n            weights = [cand_to_weight[r] for r in cand_pool]\n            raw_cands = random.choices(cand_pool, weights=weights, k=15)\n            cands = []\n            for rc in raw_cands:\n                if rc not in cands:\n                    cands.append(rc)\n                if len(cands) >= 4:\n                    break\n            \n            uncovered_indices = (current_cnt == 0)\n            \n            best_r, best_a, max_cov = cands[0], 0, -1\n            for r in cands:\n                rem = targets_mod_r[r][uncovered_indices]\n                if len(rem) == 0:\n                    a = random.randint(0, r - 1)\n                    cov = 0\n                else:\n                    counts = np.bincount(rem, minlength=r)\n                    a = np.argmax(counts)\n                    cov = counts[a]\n                if cov > max_cov:\n                    max_cov = cov\n                    best_r = r\n                    best_a = a\n                    \n            r = best_r\n            a = best_a\n            cov_count = max_cov\n                \n            logm_new = current_logm + math.log(r)\n            logboost_new = current_logboost + math.log(r / (r - 1))\n            n_res_new = current_n_res - cov_count\n            \n            score_new = get_score_metrics(n_res_new, logm_new, logboost_new, penalty_w=sa_penalty_weight)\n            score_curr = get_score_metrics(current_n_res, current_logm, current_logboost, penalty_w=sa_penalty_weight)\n            delta = score_new - score_curr\n            if delta > 0 or random.random() < math.exp(delta / temp):\n                current_congr[r] = int(a)\n                current_cnt += (targets_mod_r[r] == a)\n                current_logm = logm_new\n                current_logboost = logboost_new\n                current_n_res = n_res_new\n                accepted = True\n                \n        elif move_type == \'drop\':\n            r = random.choice(list(current_congr.keys()))\n            a = current_congr[r]\n            \n            logm_new = current_logm - math.log(r)\n            logboost_new = current_logboost - math.log(r / (r - 1))\n            \n            is_cov = (targets_mod_r[r] == a)\n            unique_cov = np.count_nonzero((current_cnt == 1) & is_cov)\n            n_res_new = current_n_res + unique_cov\n            \n            score_new = get_score_metrics(n_res_new, logm_new, logboost_new, penalty_w=sa_penalty_weight)\n            score_curr = get_score_metrics(current_n_res, current_logm, current_logboost, penalty_w=sa_penalty_weight)\n            delta = score_new - score_curr\n            if delta > 0 or random.random() < math.exp(delta / temp):\n                current_cnt -= is_cov\n                del current_congr[r]\n                current_logm = logm_new\n                current_logboost = logboost_new\n                current_n_res = n_res_new\n                accepted = True\n                \n        elif move_type == \'swap\':\n            r_drop = random.choice(list(current_congr.keys()))\n            a_drop = current_congr[r_drop]\n            \n            is_cov_drop = (targets_mod_r[r_drop] == a_drop)\n            cnt_temp = current_cnt - is_cov_drop\n            uncovered_temp = (cnt_temp == 0)\n            \n            weights = [cand_to_weight[r] for r in cand_pool]\n            raw_cands = random.choices(cand_pool, weights=weights, k=15)\n            cands = []\n            for rc in raw_cands:\n                if rc not in cands:\n                    cands.append(rc)\n                if len(cands) >= 4:\n                    break\n                    \n            best_r_add, best_a_add, max_cov = cands[0], 0, -1\n            for r in cands:\n                rem = targets_mod_r[r][uncovered_temp]\n                if len(rem) == 0:\n                    a = random.randint(0, r - 1)\n                    cov = 0\n                else:\n                    counts = np.bincount(rem, minlength=r)\n                    a = np.argmax(counts)\n                    cov = counts[a]\n                if cov > max_cov:\n                    max_cov = cov\n                    best_r_add = r\n                    best_a_add = a\n                    \n            r_add = best_r_add\n            a_add = best_a_add\n            cov_count = max_cov\n                \n            n_res_new = np.count_nonzero(uncovered_temp) - cov_count\n            logm_new = current_logm - math.log(r_drop) + math.log(r_add)\n            logboost_new = current_logboost - math.log(r_drop / (r_drop - 1)) + math.log(r_add / (r_add - 1))\n            \n            score_new = get_score_metrics(n_res_new, logm_new, logboost_new, penalty_w=sa_penalty_weight)\n            score_curr = get_score_metrics(current_n_res, current_logm, current_logboost, penalty_w=sa_penalty_weight)\n            delta = score_new - score_curr\n            if delta > 0 or random.random() < math.exp(delta / temp):\n                current_cnt -= is_cov_drop\n                del current_congr[r_drop]\n                \n                current_congr[r_add] = int(a_add)\n                current_cnt += (targets_mod_r[r_add] == a_add)\n                current_logm = logm_new\n                current_logboost = logboost_new\n                current_n_res = n_res_new\n                accepted = True\n                \n        elif move_type == \'mutate_a\':\n            r = random.choice(list(current_congr.keys()))\n            a_old = current_congr[r]\n            \n            is_cov_old = (targets_mod_r[r] == a_old)\n            cnt_temp = current_cnt - is_cov_old\n            uncovered_temp = (cnt_temp == 0)\n            \n            rem = targets_mod_r[r][uncovered_temp]\n            if len(rem) > 0:\n                counts = np.bincount(rem, minlength=r)\n                counts[a_old] = -1\n                a_new = np.argmax(counts)\n            else:\n                a_new = random.choice([i for i in range(r) if i != a_old])\n                \n            is_cov_new = (targets_mod_r[r] == a_new)\n            cnt_new = cnt_temp + is_cov_new\n            n_res_new = np.count_nonzero(cnt_new == 0)\n            \n            score_new = get_score_metrics(n_res_new, current_logm, current_logboost, penalty_w=sa_penalty_weight)\n            score_curr = get_score_metrics(current_n_res, current_logm, current_logboost, penalty_w=sa_penalty_weight)\n            delta = score_new - score_curr\n            if delta > 0 or random.random() < math.exp(delta / temp):\n                current_cnt[:] = cnt_new\n                current_congr[r] = int(a_new)\n                current_n_res = n_res_new\n                accepted = True\n                    \n        if accepted:\n            current_score = get_score_metrics(current_n_res, current_logm, current_logboost, penalty_w=100.0)\n            if current_score > best_score:\n                best_score = current_score\n                best_congr = current_congr.copy()\n\n    # 2. Run greedy hill-climbing polish starting from the best cover found\n    current_congr = best_congr.copy()\n    current_cnt = np.zeros(len(targets), dtype=np.int16)\n    current_logm = math.log(2)\n    current_logboost = math.log(2.0)\n    for r, a in current_congr.items():\n        current_cnt += (targets_mod_r[r] == a)\n        current_logm += math.log(r)\n        current_logboost += math.log(r / (r - 1))\n    current_n_res = np.count_nonzero(current_cnt == 0)\n\n    def sweep_remainders():\n        nonlocal current_n_res\n        sweep_improved = True\n        while sweep_improved:\n            sweep_improved = False\n            for r in list(current_congr.keys()):\n                a_old = current_congr[r]\n                is_cov = (targets_mod_r[r] == a_old)\n                cnt_bg = current_cnt - is_cov\n                uncovered = (cnt_bg == 0)\n                rem_uncovered = targets_mod_r[r][uncovered]\n                if len(rem_uncovered) > 0:\n                    counts = np.bincount(rem_uncovered, minlength=r)\n                    a_new = np.argmax(counts)\n                else:\n                    a_new = a_old\n                    \n                if a_new != a_old:\n                    current_congr[r] = int(a_new)\n                    current_cnt[:] = cnt_bg + (targets_mod_r[r] == a_new)\n                    current_n_res = np.count_nonzero(current_cnt == 0)\n                    sweep_improved = True\n\n    # Run initial sweep to make sure remainders are perfectly optimal\n    sweep_remainders()\n    best_score = get_score_metrics(current_n_res, current_logm, current_logboost, penalty_w=100.0)\n    best_congr = current_congr.copy()\n\n    for polish_iter in range(8):\n        improved = False\n        \n        # Try adding a modulus greedily (biased towards smaller primes)\n        best_add_r = None\n        best_add_a = None\n        best_add_score = -float(\'inf\')\n        \n        cand_pool = [r for r in cand_mods if r not in current_congr]\n        if cand_pool:\n            weights = [cand_to_weight[r] for r in cand_pool]\n            raw_cands = random.choices(cand_pool, weights=weights, k=400)\n            sampled_cands = list(set(raw_cands))[:200]\n        else:\n            sampled_cands = []\n            \n        uncovered_indices = (current_cnt == 0)\n        \n        for r in sampled_cands:\n            rem = targets_mod_r[r][uncovered_indices]\n            if len(rem) == 0:\n                a = 0\n                n_res_new = current_n_res\n            else:\n                counts = np.bincount(rem, minlength=r)\n                a = np.argmax(counts)\n                n_res_new = current_n_res - counts[a]\n                \n            logm_new = current_logm + math.log(r)\n            logboost_new = current_logboost + math.log(r / (r - 1))\n            score_new = get_score_metrics(n_res_new, logm_new, logboost_new, penalty_w=100.0)\n            if score_new > best_add_score:\n                best_add_score = score_new\n                best_add_r = r\n                best_add_a = a\n                \n        if best_add_score > best_score:\n            r = best_add_r\n            a = best_add_a\n            current_congr[r] = int(a)\n            current_cnt += (targets_mod_r[r] == a)\n            current_logm += math.log(r)\n            current_logboost += math.log(r / (r - 1))\n            current_n_res = np.count_nonzero(current_cnt == 0)\n            \n            sweep_remainders()\n            best_score = get_score_metrics(current_n_res, current_logm, current_logboost, penalty_w=100.0)\n            best_congr = current_congr.copy()\n            improved = True\n            \n        # Try dropping a modulus greedily\n        best_drop_r = None\n        best_drop_score = -float(\'inf\')\n        for r in list(current_congr.keys()):\n            a = current_congr[r]\n            is_cov = (targets_mod_r[r] == a)\n            unique_cov = np.count_nonzero((current_cnt == 1) & is_cov)\n            n_res_new = current_n_res + unique_cov\n            \n            logm_new = current_logm - math.log(r)\n            logboost_new = current_logboost - math.log(r / (r - 1))\n            score_new = get_score_metrics(n_res_new, logm_new, logboost_new, penalty_w=100.0)\n            if score_new > best_drop_score:\n                best_drop_score = score_new\n                best_drop_r = r\n                \n        if best_drop_score > best_score:\n            r = best_drop_r\n            a = current_congr[r]\n            current_cnt -= (targets_mod_r[r] == a)\n            del current_congr[r]\n            current_logm -= math.log(r)\n            current_logboost -= math.log(r / (r - 1))\n            current_n_res = np.count_nonzero(current_cnt == 0)\n            \n            sweep_remainders()\n            best_score = get_score_metrics(current_n_res, current_logm, current_logboost, penalty_w=100.0)\n            best_congr = current_congr.copy()\n            improved = True\n            \n        # Try swapping greedily\n        best_swap_r_drop = None\n        best_swap_r_add = None\n        best_swap_a_add = None\n        best_swap_score = -float(\'inf\')\n        \n        cover_keys = list(current_congr.keys())\n        sampled_drops = random.sample(cover_keys, min(30, len(cover_keys))) if cover_keys else []\n        \n        for r_drop in sampled_drops:\n            a_drop = current_congr[r_drop]\n            is_cov_drop = (targets_mod_r[r_drop] == a_drop)\n            cnt_temp = current_cnt - is_cov_drop\n            uncovered_temp = (cnt_temp == 0)\n            \n            cand_pool = [r for r in cand_mods if r not in current_congr and r != r_drop]\n            if cand_pool:\n                weights = [cand_to_weight[r] for r in cand_pool]\n                raw_cands = random.choices(cand_pool, weights=weights, k=60)\n                sampled_adds = list(set(raw_cands))[:25]\n            else:\n                sampled_adds = []\n                \n            for r_add in sampled_adds:\n                rem = targets_mod_r[r_add][uncovered_temp]\n                if len(rem) == 0:\n                    a_add = 0\n                    n_res_new = np.count_nonzero(uncovered_temp)\n                else:\n                    counts = np.bincount(rem, minlength=r_add)\n                    a_add = np.argmax(counts)\n                    n_res_new = np.count_nonzero(uncovered_temp) - counts[a_add]\n                    \n                logm_new = current_logm - math.log(r_drop) + math.log(r_add)\n                logboost_new = current_logboost - math.log(r_drop / (r_drop - 1)) + math.log(r_add / (r_add - 1))\n                score_new = get_score_metrics(n_res_new, logm_new, logboost_new, penalty_w=100.0)\n                if score_new > best_swap_score:\n                    best_swap_score = score_new\n                    best_swap_r_drop = r_drop\n                    best_swap_r_add = r_add\n                    best_swap_a_add = a_add\n                    \n        if best_swap_score > best_score:\n            r_drop = best_swap_r_drop\n            r_add = best_swap_r_add\n            a_add = best_swap_a_add\n            \n            a_drop = current_congr[r_drop]\n            current_cnt -= (targets_mod_r[r_drop] == a_drop)\n            del current_congr[r_drop]\n            \n            current_congr[r_add] = int(a_add)\n            current_cnt += (targets_mod_r[r_add] == a_add)\n            \n            current_logm += -math.log(r_drop) + math.log(r_add)\n            current_logboost += -math.log(r_drop / (r_drop - 1)) + math.log(r_add / (r_add - 1))\n            current_n_res = np.count_nonzero(current_cnt == 0)\n            \n            sweep_remainders()\n            best_score = get_score_metrics(current_n_res, current_logm, current_logboost, penalty_w=100.0)\n            best_congr = current_congr.copy()\n            improved = True\n            \n        if not improved:\n            break\n            \n    return best_congr\n# EVOLVE-BLOCK-END\n\ndef evaluate(eval_inputs: Mapping[str, Any]) -> dict[str, float]:\n    """Run evaluation on the optimized step."""\n    import sympy\n    import numpy as np\n    Q = 100003\n    targets = np.array(list(sympy.primerange(3, Q)), dtype=np.int64)\n    \n    # Warm-start from the 195-digit record cover instead of starting empty\n    congr_dict = {int(r): int(a) for r, a in eval_inputs["warm_start_cover"]}\n    \n    cand_mods = [int(r) for r in sympy.primerange(3, 8000)]\n    cnt_array = np.zeros(len(targets), dtype=np.int16)\n    \n    # Pre-populate counts\n    for r, a in congr_dict.items():\n        cnt_array += (targets % r) == a\n        \n    for it in range(10):\n        t_temp = 0.8 * (0.02 / 0.8) ** (it / 10)\n        # Recalculate cnt_array based on congr_dict\n        cnt_array = np.zeros(len(targets), dtype=np.int16)\n        logm = math.log(2)\n        logboost = math.log(2.0)\n        for r, a in congr_dict.items():\n            cnt_array += (targets % r) == a\n            logm += math.log(r)\n            logboost += math.log(r / (r - 1))\n            \n        congr_dict = optimize_cover_step(congr_dict, cand_mods, targets, cnt_array, logm, logboost, t_temp)\n        \n    # Recalculate final metrics\n    cnt_array = np.zeros(len(targets), dtype=np.int16)\n    logm = math.log(2)\n    logboost = math.log(2.0)\n    for r, a in congr_dict.items():\n        cnt_array += (targets % r) == a\n        logm += math.log(r)\n        logboost += math.log(r / (r - 1))\n        \n    n_res = int((cnt_array == 0).sum())\n    boost = math.exp(logboost)\n    m_digits = logm / math.log(10)\n    \n    ub = n_res * boost\n    LN10 = math.log(10)\n    D = (m_digits + math.sqrt(m_digits ** 2 + 4 * ub / (LN10 * LN10))) / 2\n    \n    # Constrain E <= 17.5 via Lagrangian penalty to prevent reward hacking\n    E_limit = 17.5\n    E_actual = ub / (D * LN10) if D > 0 else 0.0\n    lagrangian_penalty = 0.0\n    if E_actual > E_limit:\n        lagrangian_penalty = 100.0 * (E_actual - E_limit) ** 2\n        \n    score_headline = -float(D + lagrangian_penalty)\n    \n    # Expose E, |U|, digits(M) as negated secondary metrics for joint optimization visibility\n    return {\n        "neg_est_digits": score_headline,\n        "neg_E": -float(E_actual),\n        "neg_residual_count": -float(n_res),\n        "neg_m_digits": -float(m_digits)\n    }\n'}]}, 'evaluation': {'scores': {'scores': [{'metric': 'neg_est_digits', 'score': -192.83691}, {'metric': 'neg_E', 'score': -17.527027}, {'metric': 'neg_residual_count', 'score': -711}, {'metric': 'neg_m_digits', 'score': -185.15198}]}, 'insights': {'insights': [{'label': 'Evaluation Metrics', 'text': 'Estimated Digits: 192.8369 (constrained), E: 17.5270, |U|: 711, digits(M): 185.15'}]}}, 'parentPrograms': ['projects/799795028847/locations/global/collections/default_collection/engines/goldbach_1784979910032/sessions/7658735534374771723/alphaEvolveExperiments/9582896010645531772/alphaEvolvePrograms/7662895210918131074'], 'state': 'COMPLETED'}, {'name': 'projects/799795028847/locations/global/collections/default_collection/engines/goldbach_1784979910032/sessions/7658735534374771723/alphaEvolveExperiments/9582896010645531772/alphaEvolvePrograms/6680257159901448398', 'createTime': '2026-07-26T10:22:29.546296Z', 'content': {'files': [{'path': 'program.py', 'content': '# Copyright 2026 Google LLC\nfrom typing import Any, Mapping\nimport math\nimport random\nimport numpy as np\n\n# EVOLVE-BLOCK-START\ndef optimize_cover_step(congr_dict, cand_mods, targets, cnt_array, logm, logboost, t_temp):\n    """Optimize a single step of congruence cover using simulated annealing style logic.\n\n    Args:\n        congr_dict: Dictionary of r -> a\n        cand_mods: List of prime candidates\n        targets: np.array of target primes\n        cnt_array: np.array of coverage counts\n        logm: current log of modulus M\n        logboost: current log of boost factor\n        t_temp: current temperature\n\n    Returns:\n        Updated congr_dict\n    """\n    import math\n    import random\n    import numpy as np\n\n    # Ensure congr_dict values are python ints\n    congr_dict = {int(k): int(v) for k, v in congr_dict.items()}\n\n    LN10 = 2.302585092994046\n    LN10_SQ = 5.301898110478393\n    \n    def get_score(nr, lm, lb):\n        if nr == 0:\n            return lm / LN10\n        md = lm / LN10\n        ub = nr * math.exp(lb)\n        D = (md + math.sqrt(md * md + 4.0 * ub / LN10_SQ)) / 2.0\n        E_actual = ub / (D * LN10) if D > 0 else 0.0\n        penalty = 0.0\n        if E_actual > 17.5:\n            penalty = 100.0 * (E_actual - 17.5) ** 2\n        return D + penalty\n\n    cnt_array = cnt_array.copy()\n    \n    # Fast redundant prime elimination\n    changed = True\n    while changed:\n        changed = False\n        mask_1 = (cnt_array == 1)\n        for r in list(congr_dict.keys()):\n            a = congr_dict[r]\n            mask = (targets % r) == a\n            if np.sum(mask_1 & mask) == 0:\n                cnt_array -= mask\n                del congr_dict[r]\n                logm -= math.log(r)\n                logboost -= math.log(r / (r - 1))\n                changed = True\n                mask_1 = (cnt_array == 1)\n\n    n_res = int((cnt_array == 0).sum())\n    curr_score = get_score(n_res, logm, logboost)\n    \n    num_steps = 2500\n    \n    for step_idx in range(num_steps):\n        curr_t_temp = t_temp * (1.0 - 0.5 * step_idx / num_steps)\n        action = random.choices([\'add\', \'drop\', \'optimize\', \'swap\', \'multi_swap\'], weights=[10, 10, 20, 40, 20])[0]\n        \n        if action == \'add\':\n            cand_pool = [m for m in cand_mods if m not in congr_dict]\n            if not cand_pool:\n                continue\n            cand_pool_sorted = sorted(cand_pool)\n            cands = cand_pool_sorted[:40]\n            if len(cand_pool_sorted) > 40:\n                cands += random.sample(cand_pool_sorted[40:], min(100, len(cand_pool_sorted) - 40))\n                \n            uncovered = targets[cnt_array == 0]\n            if len(uncovered) == 0:\n                continue\n                \n            best_new_score = float(\'inf\')\n            best_r = None\n            best_a = None\n            best_hits = 0\n            \n            for r in cands:\n                rem = uncovered % r\n                counts = np.bincount(rem, minlength=r)\n                a = int(np.argmax(counts))\n                hits = counts[a]\n                \n                nr = n_res - hits\n                lm = logm + math.log(r)\n                lb = logboost + math.log(r / (r - 1))\n                sc = get_score(nr, lm, lb)\n                \n                if sc < best_new_score:\n                    best_new_score = sc\n                    best_r = r\n                    best_a = a\n                    best_hits = hits\n                    \n            if best_r is not None:\n                score_diff = best_new_score - curr_score\n                if score_diff < 0 or random.random() < math.exp(-score_diff / curr_t_temp):\n                    congr_dict[best_r] = best_a\n                    cnt_array += ((targets % best_r) == best_a)\n                    n_res -= best_hits\n                    logm += math.log(best_r)\n                    logboost += math.log(best_r / (best_r - 1))\n                    curr_score = best_new_score\n                    \n        elif action == \'drop\':\n            mods_in = list(congr_dict.keys())\n            if not mods_in:\n                continue\n            cands = random.sample(mods_in, min(40, len(mods_in)))\n            \n            best_new_score = float(\'inf\')\n            best_r = None\n            best_a = None\n            best_unique = 0\n            best_mask = None\n            \n            mask_1 = (cnt_array == 1)\n            for r in cands:\n                a = congr_dict[r]\n                mask = (targets % r) == a\n                unique_hits = np.sum(mask_1 & mask)\n                \n                nr = n_res + unique_hits\n                lm = logm - math.log(r)\n                lb = logboost - math.log(r / (r - 1))\n                sc = get_score(nr, lm, lb)\n                \n                if sc < best_new_score:\n                    best_new_score = sc\n                    best_r = r\n                    best_a = a\n                    best_unique = unique_hits\n                    best_mask = mask\n                    \n            if best_r is not None:\n                score_diff = best_new_score - curr_score\n                if score_diff < 0 or random.random() < math.exp(-score_diff / curr_t_temp):\n                    del congr_dict[best_r]\n                    cnt_array -= best_mask\n                    n_res += best_unique\n                    logm -= math.log(best_r)\n                    logboost -= math.log(best_r / (best_r - 1))\n                    curr_score = best_new_score\n                    \n        elif action == \'optimize\':\n            mods_in = list(congr_dict.keys())\n            if not mods_in:\n                continue\n            \n            cands = random.sample(mods_in, min(25, len(mods_in)))\n            best_eff = float(\'inf\')\n            r = cands[0]\n            mask_1 = (cnt_array == 1)\n            for cand_r in cands:\n                cand_a = congr_dict[cand_r]\n                eff = np.sum(mask_1 & ((targets % cand_r) == cand_a)) / math.log(cand_r)\n                if eff < best_eff:\n                    best_eff = eff\n                    r = cand_r\n                    \n            a_old = congr_dict[r]\n            \n            mask_old = (targets % r) == a_old\n            unique_hits = np.sum((cnt_array == 1) & mask_old)\n            n_res_bg = n_res + unique_hits\n            \n            cnt_bg = cnt_array - mask_old\n            uncovered_bg = targets[cnt_bg == 0]\n            \n            if len(uncovered_bg) > 0:\n                rem = uncovered_bg % r\n                counts = np.bincount(rem, minlength=r)\n                noise = np.random.uniform(0, curr_t_temp * np.max(counts) + 1e-9, size=r)\n                a_new = int(np.argmax(counts + noise))\n                hits = counts[a_new]\n            else:\n                a_new = random.randint(0, r - 1)\n                hits = 0\n                \n            new_n_res = n_res_bg - hits\n            new_score = get_score(new_n_res, logm, logboost)\n            \n            score_diff = new_score - curr_score\n            if score_diff < 0 or random.random() < math.exp(-score_diff / curr_t_temp):\n                congr_dict[r] = a_new\n                cnt_array = cnt_bg + ((targets % r) == a_new)\n                n_res = new_n_res\n                curr_score = new_score\n                \n        elif action == \'multi_swap\':\n            mods_in = list(congr_dict.keys())\n            cand_pool = [m for m in cand_mods if m not in congr_dict]\n            if len(mods_in) < 5 or not cand_pool:\n                continue\n                \n            cands = random.sample(mods_in, min(40, len(mods_in)))\n            mask_1 = (cnt_array == 1)\n            effs = []\n            for cand_r in cands:\n                cand_a = congr_dict[cand_r]\n                eff = np.sum(mask_1 & ((targets % cand_r) == cand_a)) / math.log(cand_r)\n                effs.append((eff, cand_r, cand_a))\n                \n            effs.sort()\n            num_swap = random.randint(2, 5)\n            drops = effs[:num_swap]\n            \n            n_res_bg = n_res\n            cnt_bg = cnt_array.copy()\n            lm_bg = logm\n            lb_bg = logboost\n            \n            for _, r_drop, a_drop in drops:\n                mask_drop = (targets % r_drop) == a_drop\n                cnt_bg -= mask_drop\n                lm_bg -= math.log(r_drop)\n                lb_bg -= math.log(r_drop / (r_drop - 1))\n                \n            n_res_bg = int((cnt_bg == 0).sum())\n            uncovered_bg = targets[cnt_bg == 0]\n            \n            cand_pool_sorted = sorted(cand_pool)\n            cands_add = cand_pool_sorted[:40]\n            if len(cand_pool_sorted) > 40:\n                cands_add += random.sample(cand_pool_sorted[40:], min(100, len(cand_pool_sorted) - 40))\n                \n            best_new_score = float(\'inf\')\n            \n            chosen_adds = []\n            for _ in range(num_swap):\n                best_add_sc = float(\'inf\')\n                best_add_r = None\n                best_add_a = None\n                best_add_hits = 0\n                for r_add in cands_add:\n                    if r_add in [r for r, a in chosen_adds]:\n                        continue\n                    if len(uncovered_bg) > 0:\n                        rem = uncovered_bg % r_add\n                        counts = np.bincount(rem, minlength=r_add)\n                        a_add = int(np.argmax(counts))\n                        hits = counts[a_add]\n                    else:\n                        a_add = random.randint(0, r_add - 1)\n                        hits = 0\n                        \n                    nr = n_res_bg - hits\n                    lm = lm_bg + math.log(r_add)\n                    lb = lb_bg + math.log(r_add / (r_add - 1))\n                    sc = get_score(nr, lm, lb)\n                    \n                    if sc < best_add_sc:\n                        best_add_sc = sc\n                        best_add_r = r_add\n                        best_add_a = a_add\n                        best_add_hits = hits\n                        \n                if best_add_r is not None:\n                    chosen_adds.append((best_add_r, best_add_a))\n                    mask_add = (targets % best_add_r) == best_add_a\n                    cnt_bg += mask_add\n                    n_res_bg -= best_add_hits\n                    lm_bg += math.log(best_add_r)\n                    lb_bg += math.log(best_add_r / (best_add_r - 1))\n                    uncovered_bg = targets[cnt_bg == 0]\n                    \n            best_new_score = get_score(n_res_bg, lm_bg, lb_bg)\n            \n            if len(chosen_adds) == num_swap:\n                score_diff = best_new_score - curr_score\n                if score_diff < 0 or random.random() < math.exp(-score_diff / curr_t_temp):\n                    for _, r_drop, _ in drops:\n                        del congr_dict[r_drop]\n                    for r_add, a_add in chosen_adds:\n                        congr_dict[r_add] = a_add\n                    cnt_array = cnt_bg\n                    n_res = n_res_bg\n                    logm = lm_bg\n                    logboost = lb_bg\n                    curr_score = best_new_score\n\n        elif action == \'swap\':\n            mods_in = list(congr_dict.keys())\n            cand_pool = [m for m in cand_mods if m not in congr_dict]\n            if not mods_in or not cand_pool:\n                continue\n                \n            cands = random.sample(mods_in, min(25, len(mods_in)))\n            best_eff = float(\'inf\')\n            r_drop = cands[0]\n            mask_1 = (cnt_array == 1)\n            for cand_r in cands:\n                cand_a = congr_dict[cand_r]\n                eff = np.sum(mask_1 & ((targets % cand_r) == cand_a)) / math.log(cand_r)\n                if eff < best_eff:\n                    best_eff = eff\n                    r_drop = cand_r\n                    \n            a_drop = congr_dict[r_drop]\n            \n            mask_drop = (targets % r_drop) == a_drop\n            unique_hits = np.sum((cnt_array == 1) & mask_drop)\n            n_res_bg = n_res + unique_hits\n            \n            cnt_bg = cnt_array - mask_drop\n            uncovered_bg = targets[cnt_bg == 0]\n            \n            cand_pool_sorted = sorted(cand_pool)\n            cands = cand_pool_sorted[:40]\n            if len(cand_pool_sorted) > 40:\n                cands += random.sample(cand_pool_sorted[40:], min(100, len(cand_pool_sorted) - 40))\n                \n            best_new_score = float(\'inf\')\n            best_r_add = None\n            best_a_add = None\n            best_hits = 0\n            \n            for r_add in cands:\n                if len(uncovered_bg) > 0:\n                    rem = uncovered_bg % r_add\n                    counts = np.bincount(rem, minlength=r_add)\n                    a_add = int(np.argmax(counts))\n                    hits = counts[a_add]\n                else:\n                    a_add = random.randint(0, r_add - 1)\n                    hits = 0\n                    \n                nr = n_res_bg - hits\n                lm = logm - math.log(r_drop) + math.log(r_add)\n                lb = logboost - math.log(r_drop / (r_drop - 1)) + math.log(r_add / (r_add - 1))\n                sc = get_score(nr, lm, lb)\n                \n                if sc < best_new_score:\n                    best_new_score = sc\n                    best_r_add = r_add\n                    best_a_add = a_add\n                    best_hits = hits\n                    \n            if best_r_add is not None:\n             