== a_old)\n            logm -= math.log(r)\n            logboost -= math.log(r / (r - 1))\n            \n        uncovered_mask = (cnt_array == 0)\n        n_res_base = int(np.sum(uncovered_mask))\n        D_drop = calc_D(logm, n_res_base * math.exp(logboost))\n        \n        if n_res_base > 0:\n            counts = np.bincount(tr[uncovered_mask], minlength=r)\n            a_best = int(np.argmax(counts))\n            max_covered = counts[a_best]\n        else:\n            a_best = 0\n            max_covered = 0\n            \n        new_logm = logm + math.log(r)\n        new_logboost = logboost + math.log(r / (r - 1))\n        D_add = calc_D(new_logm, (n_res_base - max_covered) * math.exp(new_logboost))\n        \n        delta = (D_add - D_drop) / max(t_temp, 1e-9)\n        if delta > 20:\n            p_add = 0.0\n        elif delta < -20:\n            p_add = 1.0\n        else:\n            p_add = 1.0 / (1.0 + math.exp(delta))\n            \n        if random.random() < p_add:\n            congr_dict[r] = a_best\n            cnt_array += (tr == a_best)\n            logm = new_logm\n            logboost = new_logboost\n        elif was_in:\n            del congr_dict[r]\n\n    return congr_dict\n# EVOLVE-BLOCK-END\n\ndef evaluate(eval_inputs: Mapping[str, Any]) -> dict[str, float]:\n    """Run evaluation on the optimized step."""\n    # Let\'s say we maximize -n_digits_est (smaller estimated N-size)\n    # Using sympy/math to compute est digits\n    import sympy\n    import numpy as np\n    Q = 100003\n    targets = np.array(list(sympy.primerange(3, Q)), dtype=np.int64)\n    # Let\'s run the optimize_cover_step starting from empty cover for some iterations\n    congr_dict = {}\n    cand_mods = [int(r) for r in sympy.primerange(3, 8000)]\n    cnt_array = np.zeros(len(targets), dtype=np.int16)\n    logm = math.log(2)\n    logboost = math.log(2.0)\n    \n    for it in range(10):\n        t_temp = 0.8 * (0.02 / 0.8) ** (it / 10)\n        # Update cnt_array based on congr_dict\n        cnt_array = np.zeros(len(targets), dtype=np.int16)\n        logm = math.log(2)\n        logboost = math.log(2.0)\n        for r, a in congr_dict.items():\n            cnt_array += (targets % r) == a\n            logm += math.log(r)\n            logboost += math.log(r / (r - 1))\n            \n        congr_dict = optimize_cover_step(congr_dict, cand_mods, targets, cnt_array, logm, logboost, t_temp)\n        \n    # Recalculate final metrics\n    cnt_array = np.zeros(len(targets), dtype=np.int16)\n    logm = math.log(2)\n    logboost = math.log(2.0)\n    for r, a in congr_dict.items():\n        cnt_array += (targets % r) == a\n        logm += math.log(r)\n        logboost += math.log(r / (r - 1))\n        \n    n_res = int((cnt_array == 0).sum())\n    boost = math.exp(logboost)\n    m_digits = logm / math.log(10)\n    \n    ub = n_res * boost\n    LN10 = math.log(10)\n    D = (m_digits + math.sqrt(m_digits ** 2 + 4 * ub / (LN10 * LN10))) / 2\n    return {"neg_est_digits": -float(D)}\n'}]}, 'evaluation': {'scores': {'scores': [{'metric': 'neg_est_digits', 'score': -50.76326}]}}, 'parentPrograms': ['projects/799795028847/locations/global/collections/default_collection/engines/goldbach_1784979910032/sessions/7013217697778074030/alphaEvolveExperiments/15164875354338173448/alphaEvolvePrograms/18102573509735108720'], 'state': 'COMPLETED'}, {'name': 'projects/799795028847/locations/global/collections/default_collection/engines/goldbach_1784979910032/sessions/7013217697778074030/alphaEvolveExperiments/15164875354338173448/alphaEvolvePrograms/18102573509735112517', 'createTime': '2026-07-25T19:44:38.519029Z', 'content': {'files': [{'path': 'program.py', 'content': '# Copyright 2026 Google LLC\nfrom typing import Any, Mapping\nimport math\nimport random\nimport numpy as np\n\n# EVOLVE-BLOCK-START\ndef optimize_cover_step(congr_dict, cand_mods, targets, cnt_array, logm, logboost, t_temp):\n    """Optimize a single step of congruence cover using simulated annealing style logic.\n\n    Args:\n        congr_dict: Dictionary of r -> a\n        cand_mods: List of prime candidates\n        targets: np.array of target primes\n        cnt_array: np.array of coverage counts\n        logm: current log of modulus M\n        logboost: current log of boost factor\n        t_temp: current temperature\n\n    Returns:\n        Updated congr_dict\n    """\n    import numpy as np\n    import random\n\n    # Persistent, self-cleaning cache of remainder arrays to avoid repeated modulo operations\n    if not hasattr(optimize_cover_step, "_last_targets_id") or optimize_cover_step._last_targets_id != id(targets):\n        optimize_cover_step._mod_cache = {}\n        optimize_cover_step._last_targets_id = id(targets)\n    cache = optimize_cover_step._mod_cache\n\n    def get_mod_array(r):\n        if r not in cache:\n            cache[r] = (targets % r).astype(np.int32)\n        return cache[r]\n\n    LN10 = np.log(10)\n    LN10_SQ = LN10 * LN10\n\n    def compute_D(lm, lb, nr):\n        m_d = lm / LN10\n        ub = nr * np.exp(lb)\n        return (m_d + np.sqrt(max(0.0, m_d**2 + 4 * ub / LN10_SQ))) / 2.0\n\n    # Initialize local search state\n    cnt = cnt_array.copy()\n    current_logm = logm\n    current_logboost = logboost\n    n_res = int(np.sum(cnt == 0))\n    current_D = compute_D(current_logm, current_logboost, n_res)\n\n    best_overall_dict = congr_dict.copy()\n    best_overall_D = current_D\n\n    # Crazy Idea: Pure Gibbs Sampling over the space of subsets!\n    # Instead of complex ad-hoc logic with batching evaluations for ADD/DROP/SWAP,\n    # we unify everything into purely sequential single-variable Gibbs updates.\n    # This massively simplifies the code while exploring the combinatorial landscape \n    # much more robustly because every single evaluation dynamically reacts to the \n    # latest state. We can run 10000 steps since each step evaluates just one element!\n    steps = 10000\n    for step in range(steps):\n        frac = step / steps\n        temp = max(t_temp * (0.15 ** frac), 1e-5)\n\n        r = random.choice(cand_mods)\n        rem = get_mod_array(r)\n        \n        # 1. Temporarily extract r from the state if it\'s currently present\n        was_in = r in congr_dict\n        if was_in:\n            a_old = congr_dict[r]\n            cnt[rem == a_old] -= 1\n            del congr_dict[r]\n            current_logm -= np.log(r)\n            current_logboost -= np.log(r / (r - 1.0))\n            \n        # Compute current coverage state (without r)\n        uncovered_mask = (cnt == 0)\n        n_res = int(np.sum(uncovered_mask))\n            \n        # 2. Calculate Energy (D) for the "dropped" state\n        D_drop = compute_D(current_logm, current_logboost, n_res)\n        \n        # 3. Calculate Energy (D) for the "added" state with optimal remainder \'a\'\n        counts = np.bincount(rem, weights=uncovered_mask.astype(np.float64), minlength=r)\n        best_a = int(np.argmax(counts))\n        cov = int(counts[best_a])\n        \n        new_logm = current_logm + np.log(r)\n        new_logboost = current_logboost + np.log(r / (r - 1.0))\n        D_add = compute_D(new_logm, new_logboost, n_res - cov)\n        \n        # 4. Gibbs Sampling / Metropolis-Hastings decision\n        diff = (D_add - D_drop) / temp\n        diff = max(min(diff, 500.0), -500.0) # Prevent overflow\n        p_add = 1.0 / (1.0 + np.exp(diff))\n        \n        if random.random() < p_add:\n            # Add r back with best_a\n            congr_dict[r] = best_a\n            cnt[rem == best_a] += 1\n            current_logm = new_logm\n            current_logboost = new_logboost\n            n_res -= cov\n            current_D = D_add\n        else:\n            current_D = D_drop\n\n        # Track the absolute best configuration encountered\n        if current_D < best_overall_D:\n            best_overall_D = current_D\n            best_overall_dict = congr_dict.copy()\n\n    return best_overall_dict\n# EVOLVE-BLOCK-END\n\ndef evaluate(eval_inputs: Mapping[str, Any]) -> dict[str, float]:\n    """Run evaluation on the optimized step."""\n    # Let\'s say we maximize -n_digits_est (smaller estimated N-size)\n    # Using sympy/math to compute est digits\n    import sympy\n    import numpy as np\n    Q = 100003\n    targets = np.array(list(sympy.primerange(3, Q)), dtype=np.int64)\n    # Let\'s run the optimize_cover_step starting from empty cover for some iterations\n    congr_dict = {}\n    cand_mods = [int(r) for r in sympy.primerange(3, 8000)]\n    cnt_array = np.zeros(len(targets), dtype=np.int16)\n    logm = math.log(2)\n    logboost = math.log(2.0)\n    \n    for it in range(10):\n        t_temp = 0.8 * (0.02 / 0.8) ** (it / 10)\n        # Update cnt_array based on congr_dict\n        cnt_array = np.zeros(len(targets), dtype=np.int16)\n        logm = math.log(2)\n        logboost = math.log(2.0)\n        for r, a in congr_dict.items():\n            cnt_array += (targets % r) == a\n            logm += math.log(r)\n            logboost += math.log(r / (r - 1))\n            \n        congr_dict = optimize_cover_step(congr_dict, cand_mods, targets, cnt_array, logm, logboost, t_temp)\n        \n    # Recalculate final metrics\n    cnt_array = np.zeros(len(targets), dtype=np.int16)\n    logm = math.log(2)\n    logboost = math.log(2.0)\n    for r, a in congr_dict.items():\n        cnt_array += (targets % r) == a\n        logm += math.log(r)\n        logboost += math.log(r / (r - 1))\n        \n    n_res = int((cnt_array == 0).sum())\n    boost = math.exp(logboost)\n    m_digits = logm / math.log(10)\n    \n    ub = n_res * boost\n    LN10 = math.log(10)\n    D = (m_digits + math.sqrt(m_digits ** 2 + 4 * ub / (LN10 * LN10))) / 2\n    return {"neg_est_digits": -float(D)}\n'}]}, 'evaluation': {'scores': {'scores': [{'metric': 'neg_est_digits', 'score': -50.76326}]}}, 'parentPrograms': ['projects/799795028847/locations/global/collections/default_collection/e