g(r)\n                    new_logboost = logboost_after_drop + math.log(r / (r - 1))\n                    \n                    new_D = calc_D_val(new_n_res, new_logm, new_logboost)\n                    if new_D < best_new_D:\n                        best_new_D = new_D\n                        best_add_r = r\n                        best_add_a = a\n                        best_new_n_res = new_n_res\n                        \n                if best_add_r is not None:\n                    delta = best_new_D - current_D\n                    if delta < 0 or random.random() < math.exp(-delta / temp):\n                        del congr_dict[r_drop]\n                        congr_dict[best_add_r] = best_add_a\n                        cnt_array[targets % best_add_r == best_add_a] += 1\n                        n_res = best_new_n_res\n                        logm = logm_after_drop + math.log(best_add_r)\n                        logboost = logboost_after_drop + math.log(best_add_r / (best_add_r - 1))\n                        current_D = best_new_D\n                    else:\n                        cnt_array[rem_drop == a_drop] += 1\n                else:\n                    cnt_array[rem_drop == a_drop] += 1\n\n        elif action == \'optimize\':\n            active = list(congr_dict.keys())\n            if active:\n                sampled = random.sample(active, min(15, len(active)))\n                for r in sampled:\n                    a_old = congr_dict[r]\n                    is_cov = (targets % r) == a_old\n                    cnt_array[is_cov] -= 1\n                    \n                    a_new, _ = find_best_a(r, cnt_array)\n                    \n                    cnt_array[(targets % r) == a_new] += 1\n                    congr_dict[r] = a_new\n                    \n                n_res = int((cnt_array == 0).sum())\n                current_D = calc_D_val(n_res, logm, logboost)\n\n    # Final cleanup to ensure absolute optimality of residues\n    optimize_all(congr_dict, cnt_array)\n    return congr_dict\n# EVOLVE-BLOCK-END\n\ndef evaluate(eval_inputs: Mapping[str, Any]) -> dict[str, float]:\n    """Run evaluation on the optimized step."""\n    import sympy\n    import numpy as np\n    Q = 100003\n    targets = np.array(list(sympy.primerange(3, Q)), dtype=np.int64)\n    \n    # Warm-start from the 195-digit record cover instead of starting empty\n    congr_dict = {int(r): int(a) for r, a in eval_inputs["warm_start_cover"]}\n    \n    cand_mods = [int(r) for r in sympy.primerange(3, 8000)]\n    cnt_array = np.zeros(len(targets), dtype=np.int16)\n    \n    # Pre-populate counts\n    for r, a in congr_dict.items():\n        cnt_array += (targets % r) == a\n        \n    for it in range(10):\n        t_temp = 0.8 * (0.02 / 0.8) ** (it / 10)\n        # Recalculate cnt_array based on congr_dict\n        cnt_array = np.zeros(len(targets), dtype=np.int16)\n        logm = math.log(2)\n        logboost = math.log(2.0)\n        for r, a in congr_dict.items():\n            cnt_array += (targets % r) == a\n            logm += math.log(r)\n            logboost += math.log(r / (r - 1))\n            \n        congr_dict = optimize_cover_step(congr_dict, cand_mods, targets, cnt_array, logm, logboost, t_temp)\n        \n    # Recalculate final metrics\n    cnt_array = np.zeros(len(targets), dtype=np.int16)\n    logm = math.log(2)\n    logboost = math.log(2.0)\n    for r, a in congr_dict.items():\n        cnt_array += (targets % r) == a\n        logm += math.log(r)\n        logboost += math.log(r / (r - 1))\n        \n    n_res = int((cnt_array == 0).sum())\n    boost = math.exp(logboost)\n    m_digits = logm / math.log(10)\n    \n    ub = n_res * boost\n    LN10 = math.log(10)\n    D = (m_digits + math.sqrt(m_digits ** 2 + 4 * ub / (LN10 * LN10))) / 2\n    \n    # Constrain E <= 17.5 via Lagrangian penalty to prevent reward hacking\n    E_limit = 17.5\n    E_actual = ub / (D * LN10) if D > 0 else 0.0\n    lagrangian_penalty = 0.0\n    if E_actual > E_limit:\n        lagrangian_penalty = 100.0 * (E_actual - E_limit) ** 2\n        \n    score_headline = -float(D + lagrangian_penalty)\n    \n    # Expose E, |U|, digits(M) as negated secondary metrics for joint optimization visibility\n    return {\n        "neg_est_digits": score_headline,\n        "neg_E": -float(E_actual),\n        "neg_residual_count": -float(n_res),\n        "neg_m_digits": -float(m_digits)\n    }\n'}]}, 'evaluation': {'scores': {'scores': [{'metric': 'neg_est_digits', 'score': -236.81628}, {'metric': 'neg_E', 'score': -17.50636}, {'metric': 'neg_residual_count', 'score': -1103}, {'metric': 'neg_m_digits', 'score': -229.20932}]}, 'insights': {'insights': [{'label': 'Evaluation Metrics', 'text': 'Estimated Digits: 236.8163 (constrained), E: 17.5064, |U|: 1103, digits(M): 229.21'}]}}, 'parentPrograms': ['projects/799795028847/locations/global/collections/default_collection/engines/goldbach_1784979910032/sessions/7658735534374771723/alphaEvolveExperiments/9582896010645531772/alphaEvolvePrograms/7662895210918131204', 'projects/799795028847/locations/global/collections/default_collection/engines/goldbach_1784979910032/sessions/7658735534374771723/alphaEvolveExperiments/9582896010645531772/alphaEvolvePrograms/7662895210918129792', 'projects/799795028847/locations/global/collections/default_collection/engines/goldbach_1784979910032/sessions/7658735534374771723/alphaEvolveExperiments/9582896010645531772/alphaEvolvePrograms/7662895210918132147', 'projects/799795028847/locations/global/collections/default_collection/engines/goldbach_1784979910032/sessions/7658735534374771723/alphaEvolveExperiments/9582896010645531772/alphaEvolvePrograms/7662895210918132147'], 'state': 'COMPLETED'}, {'name': 'projects/799795028847/locations/global/collections/default_collection/engines/goldbach_1784979910032/sessions/7658735534374771723/alphaEvolveExperiments/9582896010645531772/alphaEvolvePrograms/7662895210918131545', 'createTime': '2026-07-26T06:04:20.272761Z', 'content': {'files': [{'path': 'program.py', 'content': '# Copyright 2026 Google LLC\nfrom typing import Any, Mapping\nimport math\nimport random\nimport numpy as np\n\n# EVOLVE-BLOCK-START\ndef optimize_cover_step(congr_dict, cand_mods, targets, cnt_array, logm, logboost, t_temp):\n    """Optimize a single step of congruence cover using simulated annealing style logic.\n\n    Args:\n        congr_dict: Dictionary of r -> a\n        cand_mods: List of prime candidates\n        targets: np.array of target primes\n        cnt_array: np.array of coverage counts\n        logm: current log of modulus M\n        logboost: current log of boost factor\n        t_temp: current temperature\n\n    Returns:\n        Updated congr_dict\n    """\n    import numpy as np\n    import random\n    import math\n\n    if len(targets) == 0:\n        return congr_dict\n\n    LN10 = math.log(10)\n    C_UB = 4.0 / (LN10 * LN10)\n    \n    def compute_score(lm, lb, nr):\n        m_digits = lm / LN10\n        ub = nr * math.exp(lb)\n        D = (m_digits + math.sqrt(max(0.0, m_digits ** 2 + C_UB * ub))) / 2\n        E_actual = ub / (D * LN10) if D > 0 else 0.0\n        lagrangian_penalty = 100.0 * (E_actual - 17.5) ** 2 if E_actual > 17.5 else 0.0\n        return -float(D + lagrangian_penalty)\n\n    # Perform multiple inner steps to search the neighborhood space much more thoroughly\n    inner_steps = 120\n    congr_dict = dict(congr_dict)\n    cnt_array = np.array(cnt_array, dtype=np.int16)\n\n    for step in range(inner_steps):\n        t_curr = t_temp * (0.97 ** step)\n        temp = max(t_curr, 1e-4)\n        \n        factor = min(max(t_curr, 0.0), 1.0)\n        p_opt = 0.40 - 0.10 * factor\n        p_add = 0.20 + 0.05 * factor\n        p_drop = 0.20 + 0.05 * factor\n        p_swap = 0.20\n\n        kind = random.random()\n        mods_in = list(congr_dict.keys())\n        cand_pool = [m for m in cand_mods if m not in congr_dict]\n        \n        if not mods_in:\n            action = \'add\'\n        elif not cand_pool:\n            action = \'optimize\' if kind < (p_opt / (p_opt + p_drop)) else \'drop\'\n        else:\n            if kind < p_add:\n                action = \'add\'\n            elif kind < p_add + p_opt:\n                action = \'optimize\'\n            elif kind < p_add + p_opt + p_drop:\n                action = \'drop\'\n            else:\n                action = \'swap\'\n\n        uncovered_mask = (cnt_array == 0)\n        single_cover_mask = (cnt_array == 1)\n        n_res_curr = np.sum(uncovered_mask)\n        targets_uncovered = targets[uncovered_mask]\n\n        if action == \'add\':\n            if not cand_pool:\n                continue\n            sampled_cands = random.sample(cand_pool, min(40, len(cand_pool)))\n                \n            scores = []\n            cands_data = []\n            for r in sampled_cands:\n                if len(targets_uncovered) > 0:\n                    counts = np.bincount(targets_uncovered % r, minlength=r)\n                    a = int(np.argmax(counts))\n                    cov_count = counts[a]\n                else:\n                    a = 0\n                    cov_count = 0\n                    \n                n_res_new = n_res_curr - cov_count\n                logm_new = logm + math.log(r)\n                logboost_new = logboost + math.log(r / (r - 1))\n                \n                score = compute_score(logm_new, logboost_new, n_res_new)\n                scores.append(score)\n                cands_data.append((r, a))\n                \n            scores = np.array(scores)\n            scaled_scores = scores / temp\n            scaled_scores = scaled_scores - np.max(scaled_scores)\n            probs = np.exp(scaled_scores)\n            probs /= np.sum(probs)\n            \n            idx = np.random.choice(len(sampled_cands), p=probs)\n            best_cand, best_a = cands_data[idx]\n            \n            # Apply change\n            best_cand, best_a = int(best_cand), int(best_a)\n            congr_dict[best_cand] = best_a\n            cnt_array += (targets % best_cand) == best_a\n            logm += math.log(best_cand)\n            logboost += math.log(best_cand / (best_cand - 1))\n\n        elif action == \'optimize\':\n            if not mods_in:\n                continue\n            sampled_mods = random.sample(mods_in, min(25, len(mods_in)))\n            \n            options = []\n            scores = []\n            for r in sampled_mods:\n                a_old = congr_dict[r]\n                newly_uncovered_mask = single_cover_mask & ((targets % r) == a_old)\n                n_res_bg = n_res_curr + np.sum(newly_uncovered_mask)\n                targets_bg_uncovered = np.concatenate([targets_uncovered, targets[newly_uncovered_mask]])\n                \n                if len(targets_bg_uncovered) > 0:\n                    counts = np.bincount(targets_bg_uncovered % r, minlength=r)\n                    a_new = int(np.argmax(counts))\n                    cov_count = counts[a_new]\n                else:\n                    a_new = 0\n                    cov_count = 0\n                    \n                n_res_new = n_res_bg - cov_count\n                score = compute_score(logm, logboost, n_res_new)\n                scores.append(score)\n                options.append((r, a_old, a_new))\n                \n            scores = np.array(scores)\n            scaled_scores = scores / temp\n            scaled_scores = scaled_scores - np.max(scaled_scores)\n            probs = np.exp(scaled_scores)\n            probs /= np.sum(probs)\n            \n            idx = np.random.choice(len(options), p=probs)\n            best_r, a_old, best_a = options[idx]\n            \n            # Apply change\n            best_r, best_a = int(best_r), int(best_a)\n            congr_dict[best_r] = best_a\n            cnt_array -= (targets % best_r) == a_old\n            cnt_array += (targets % best_r) == best_a\n\n        elif action == \'drop\':\n            if not mods_in:\n                continue\n            sampled_mods = random.sample(mods_in, min(30, len(mods_in)))\n            \n            scores = []\n            r_list = []\n            \n            for r in sampled_mods:\n                a = congr_dict[r]\n                num_newly_uncovered = np.sum(single_cover_mask & ((targets % r) == a))\n                \n                n_res_new = n_res_curr + num_newly_uncovered\n                logm_new = logm - math.log(r)\n                logboost_new = logboost - math.log(r / (r - 1))\n                \n                score = compute_score(logm_new, logboost_new, n_res_new)\n                scores.append(score)\n                r_list.append(r)\n                \n            scores = np.array(scores)\n            scaled_scores = scores / temp\n            scaled_scores = scaled_scores - np.max(scaled_scores)\n            probs = np.exp(scaled_scores)\n            probs /= np.sum(probs)\n            \n            idx = np.random.choice(len(r_list), p=probs)\n            r_drop = r_list[idx]\n            a_drop = congr_dict[r_drop]\n            \n            # Apply change\n            r_drop = int(r_drop)\n            del congr_dict[r_drop]\n            cnt_array -= (targets % r_drop) == a_drop\n            logm -= math.log(r_drop)\n            logboost -= math.log(r_drop / (r_drop - 1))\n\n        elif action == \'swap\':\n            if not mods_in or not cand_pool:\n                continue\n            sampled_mods = random.sample(mods_in, min(12, len(mods_in)))\n            sampled_cands = random.sample(cand_pool, min(15, len(cand_pool)))\n            \n            scores = []\n            options = []\n            \n            for r_drop in sampled_mods:\n                a_drop = congr_dict[r_drop]\n                newly_uncovered_mask = single_cover_mask & ((targets % r_drop) == a_drop)\n                n_res_bg = n_res_curr + np.sum(newly_uncovered_mask)\n                targets_bg_uncovered = np.concatenate([targets_uncovered, targets[newly_uncovered_mask]])\n                \n                logm_bg = logm - math.log(r_drop)\n                logboost_bg = logboost - math.log(r_drop / (r_drop - 1))\n                \n                for r_add in sampled_cands:\n                    if len(targets_bg_uncovered) > 0:\n                        counts = np.bincount(targets_bg_uncovered % r_add, minlength=r_add)\n                        a_add = int(np.argmax(counts))\n                        cov_count = counts[a_add]\n                    else:\n                        a_add = 0\n                        cov_count = 0\n                        \n                    n_res_new = n_res_bg - cov_count\n                    logm_new = logm_bg + math.log(r_add)\n                    logboost_new = logboost_bg + math.log(r_add / (r_add - 1))\n                    \n                    score = compute_score(logm_new, logboost_new, n_res_new)\n                    scores.append(score)\n                    options.append((r_drop, a_drop, r_add, a_add))\n                    \n            scores = np.array(scores)\n            scaled_scores = scores / temp\n            scaled_scores = scaled_scores - np.max(scaled_scores)\n            probs = np.exp(scaled_scores)\n            probs /= np.sum(probs)\n            \n            idx = np.random.choice(len(options), p=probs)\n            r_drop, a_drop, r_add, a_add = options[idx]\n            \n            # Apply change\n            r_drop, r_add, a_add = int(r_drop), int(r_add), int(a_add)\n            del congr_dict[r_drop]\n            cnt_array -= (targets % r_drop) == a_drop\n            congr_dict[r_add] = a_add\n            cnt_array += (targets % r_add) == a_add\n            logm += math.log(r_add) - math.log(r_drop)\n            logboost += math.log(r_add / (r_add - 1)) - math.log(r_drop / (r_drop - 1))\n\n    return congr_dict\n# EVOLVE-BLOCK-END\n\ndef evaluate(eval_inputs: Mapping[str, Any]) -> dict[str, float]:\n    """Run evaluation on the optimized step."""\n    import sympy\n    import numpy as np\n    Q = 100003\n    targets = np.array(list(sympy.primerange(3, Q)), dtype=np.int64)\n    \n    # Warm-start from the 195-digit record cover instead of starting empty\n    congr_dict = {int(r): int(a) for r, a in eval_inputs["warm_start_cover"]}\n    \n    cand_mods = [int(r) for r in sympy.primerange(3, 8000)]\n    cnt_array = np.zeros(len(targets), dtype=np.int16)\n    \n    # Pre-populate counts\n    for r, a in congr_dict.items():\n        cnt_array += (targets % r) == a\n        \n    for it in range(10):\n        t_temp = 0.8 * (0.02 / 0.8) ** (it / 10)\n        # Recalculate cnt_array based on congr_dict\n        cnt_array = np.zeros(len(targets), dtype=np.int16)\n        logm = math.log(2)\n        logboost = math.log(2.0)\n        for r, a in congr_dict.items():\n            cnt_array += (targets % r) == a\n            logm += math.log(r)\n            logboost += math.log(r / (r - 1))\n            \n        congr_dict = optimize_cover_step(congr_dict, cand_mods, targets, cnt_array, logm, logboost, t_temp)\n        \n    # Recalculate final metrics\n    cnt_array = np.zeros(len(targets), dtype=np.int16)\n    logm = math.log(2)\n    logboost = math.log(2.0)\n    for r, a in congr_dict.items():\n        cnt_array += (targets % r) == a\n        logm += math.log(r)\n        logboost += math.log(r / (r - 1))\n        \n    n_res = int((cnt_array == 0).sum())\n    boost = math.exp(logboost)\n    m_digits = logm / math.log(10)\n    \n    ub = n_res * boost\n    LN10 = math.log(10)\n    D = (m_digits + math.sqrt(m_digits ** 2 + 4 * ub / (LN10 * LN10))) / 2\n    \n    # Constrain E <= 17.5 via Lagrangian penalty to prevent reward hacking\n    E_limit = 17.5\n    E_actual = ub / (D * LN10) if D > 0 else 0.0\n    lagrangian_penalty = 0.0\n    if E_actual > E_limit:\n        lagrangian_penalty = 100.0 * (E_actual - E_limit) ** 2\n        \n    score_headline = -float(D + lagrangian_penalty)\n    \n    # Expose E, |U|, digits(M) as negated secondary metrics for joint optimization visibility\n    return {\n        "neg_est_digits": score_headline,\n        "neg_E": -float(E_actual),\n        "neg_residual_count": -float(n_res),\n        "neg_m_digits": -float(m_digits)\n    }\n'}]}, 'evaluation': {'scores': {'scores': [{'metric': 'neg_est_digits', 'score': -247.72298}, {'metric': 'neg_E', 'score': -12.087568}, {'metric': 'neg_residual_count', 'score': -605}, {'metric': 'neg_m_digits', 'score': -242.47342}]}, 'insights': {'insights': [{'label': 'Evaluation Metrics', 'text': 'Estimated Digits: 247.7230 (constrained), E: 12.0876, |U|: 605, digits(M): 242.47'}]}}, 'parentPrograms': ['projects/799795028847/locations/global/collections/default_collection/engines/goldbach_1784979910032/sessions/7658735534374771723/alphaEvolveExperiments/9582896010645531772/alphaEvolvePrograms/7662895210918130130'], 'state': 'COMPLETED'}, {'name': 'projects/799795028847/locations/global/collections/default_collection/engines/goldbach_1784979910032/sessions/7658735534374771723/alphaEvolveExperiments/9582896010645531772/alphaEvolvePrograms/11597998738524451851', 'createTime': '2026-07-26T09:31:12.832966Z', 'content': {'files': [{'path': 'program.py', 'content': '# Copyright 2026 Google LLC\nfrom typing import Any, Mapping\nimport math\nimport random\nimport numpy as np\n\n# EVOLVE-BLOCK-START\ndef optimize_cover_step(congr_dict, cand_mods, targets, cnt_array, logm, logboost, t_temp):\n    """Optimize congruence cover using Symbiotic Prime-Residue Wormholes (SPRW) with Antimatter Annihilation."""\n    import math\n    import random\n    import numpy as np\n\n    # CRAZY IDEA: "Symbiotic Prime-Residue Wormholes (SPRW) with Antimatter Annihilation"\n    # We model the prime moduli as inter-dimensional wormholes in a Goldbach multiverse.\n    # Uncovered targets are baryonic matter. Wormholes greedily consume this matter.\n    # To escape local minima traps, we unleash "Antimatter Annihilation" cascades to aggressively \n    # obliterate the most bloated, useless wormholes and force a search for leaner, more efficient pathways.\n    \n    cnt_array = cnt_array.copy()\n    n_res = int((cnt_array == 0).sum())\n\n    def calc_D_val(n_res_val, logm_val, logboost_val):\n        boost = math.exp(logboost_val)\n        m_digits = logm_val / math.log(10)\n        ub = n_res_val * boost\n        LN10 = math.log(10)\n        inside_sqrt = m_digits ** 2 + 4 * ub / (LN10 * LN10)\n        D = (m_digits + math.sqrt(max(0.0, inside_sqrt))) / 2\n        \n        E_limit = 17.5\n        E_actual = ub / (D * LN10) if D > 0 else 0.0\n        lagrangian_penalty = 0.0\n        if E_actual > E_limit:\n            lagrangian_penalty = 1000.0 * (E_actual - E_limit) ** 2\n        return D + lagrangian_penalty\n\n    def optimize_all(congr, cnt):\n        # Two-Pass Alternating Residue Refinement (ALS for Tensor-like Cover)\n        # Sort keys descending to optimize largest, most constrained primes first.\n        # Smaller primes have broad coverage and can flexibly wrap around the large primes.\n        keys = sorted(list(congr.keys()), reverse=True)\n        for _ in range(2):\n            for r in keys:\n                a_old = congr[r]\n                is_cov = (targets % r) == a_old\n                cnt[is_cov] -= 1\n                uncovered = targets[cnt == 0]\n                if len(uncovered) > 0:\n                    counts = np.bincount(uncovered % r, minlength=r)\n                    a_new = int(np.argmax(counts))\n                else:\n                    a_new = 0\n                if a_new != a_old:\n                    cnt[(targets % r) == a_new] += 1\n                    congr[r] = a_new\n                else:\n                    cnt[is_cov] += 1\n\n    # Initialize residues optimally\n    optimize_all(congr_dict, cnt_array)\n    n_res = int((cnt_array == 0).sum())\n    current_D = calc_D_val(n_res, logm, logboost)\n\n    # High-intensity inner loop (2000 steps) acting as local search\n    N_STEPS = 2000\n    base_temp = max(t_temp, 1e-5)\n\n    for step in range(N_STEPS):\n        temp = base_temp * (0.90 ** (10 * step / N_STEPS))\n        \n        # Periodic symbiotic mutation (resynchronize the network)\n        if step > 0 and step % 200 == 0:\n            optimize_all(congr_dict, cnt_array)\n            n_res = int((cnt_array == 0).sum())\n            current_D = calc_D_val(n_res, logm, logboost)\n\n        # "Antimatter Annihilation": Destroy the most bloated wormholes\n        if temp > 0.05 and random.random() < 0.02 and congr_dict:\n            active = list(congr_dict.keys())\n            sample_active = random.sample(active, min(20, len(active)))\n            worst_r = None\n            worst_score = float(\'inf\')\n            singly_covered = (cnt_array == 1)\n            \n            for r in sample_active:\n                unique_cov = np.sum(singly_covered & ((targets % r) == congr_dict[r]))\n                new_n_res = n_res + unique_cov\n                new_logm = logm - math.log(r)\n                new_logboost = logboost - math.log(r / (r - 1))\n                new_D = calc_D_val(new_n_res, new_logm, new_logboost)\n                \n                if new_D < worst_score:\n                    worst_score = new_D\n                    worst_r = r\n                    \n            if worst_r is not None:\n                r_drop = worst_r\n                a_drop = congr_dict[r_drop]\n                cnt_array[(targets % r_drop) == a_drop] -= 1\n                del congr_dict[r_drop]\n                n_res = int((cnt_array == 0).sum())\n                logm -= math.log(r_drop)\n                logboost -= math.log(r_drop / (r_drop - 1))\n                current_D = calc_D_val(n_res, logm, logboost)\n                continue\n\n        action = random.choices([\'add\', \'drop\', \'swap\', \'optimize\'], weights=[0.25, 0.15, 0.45, 0.15], k=1)[0]\n\n        if action == \'add\':\n            cand_pool = [m for m in cand_mods if m not in congr_dict]\n            if cand_pool:\n                uncovered_targets = targets[cnt_array == 0]\n                n_res_current = len(uncovered_targets)\n                \n                sampled = random.sample(cand_pool, min(250, len(cand_pool)))\n                best_r = None\n                best_a = None\n                best_new_D = float(\'inf\')\n                best_new_n_res = n_res\n                \n                for r in sampled:\n                    if n_res_current > 0:\n                        counts = np.bincount(uncovered_targets % r, minlength=r)\n                        a = int(np.argmax(counts))\n                        added_cov = counts[a]\n                    else:\n                        a = 0\n                        added_cov = 0\n                    new_n_res = n_res - added_cov\n                    new_logm = logm + math.log(r)\n                    new_logboost = logboost + math.log(r / (r - 1))\n                    new_D = calc_D_val(new_n_res, new_logm, new_logboost)\n                    if new_D < best_new_D:\n                        best_new_D = new_D\n                        best_r = r\n                        best_a = a\n                        best_new_n_res = new_n_res\n                        \n                if best_r is not None:\n                    delta = best_new_D - current_D\n                    if delta < 0 or random.random() < math.exp(-delta / temp):\n                        congr_dict[best_r] = best_a\n                        cnt_array[targets % best_r == best_a] += 1\n                        n_res = best_new_n_res\n                        logm += math.log(best_r)\n                        logboost += math.log(best_r / (best_r - 1))\n                        current_D = best_new_D\n\n        elif action == \'drop\':\n            active = list(congr_dict.keys())\n            if active:\n                sampled = random.sample(active, min(80, len(active)))\n                best_r = None\n                best_new_D = float(\'inf\')\n                best_new_n_res = n_res\n                \n                singly_covered = (cnt_array == 1)\n                for r in sampled:\n                    a = congr_dict[r]\n                    lost_cov = np.sum(singly_covered & ((targets % r) == a))\n                    new_n_res = n_res + lost_cov\n                    new_logm = logm - math.log(r)\n                    new_logboost = logboost - math.log(r / (r - 1))\n                    new_D = calc_D_val(new_n_res, new_logm, new_logboost)\n                    if new_D < best_new_D:\n                        best_new_D = new_D\n                        best_r = r\n                        best_new_n_res = new_n_res\n                        \n                if best_r is not None:\n                    delta = best_new_D - current_D\n                    if delta < 0 or random.random() < math.exp(-delta / temp):\n                        r_drop = best_r\n                        a_drop = congr_dict[r_drop]\n                        cnt_array[targets % r_drop == a_drop] -= 1\n                        del congr_dict[r_drop]\n                        n_res = best_new_n_res\n                        logm -= math.log(r_drop)\n                        logboost -= math.log(r_drop / (r_drop - 1))\n                        current_D = best_new_D\n\n        elif action == \'swap\':\n            active = list(congr_dict.keys())\n            cand_pool = [m for m in cand_mods if m not in congr_dict]\n            if active and cand_pool:\n                sample_active = random.sample(active, min(30, len(active)))\n                r_drop = sample_active[0]\n                worst_score = float(\'inf\')\n                singly_covered = (cnt_array == 1)\n                for r in sample_active:\n                    loss = np.sum(singly_covered & ((targets % r) == congr_dict[r]))\n                    new_n_res = n_res + loss\n                    new_logm = logm - math.log(r)\n                    new_logboost = logboost - math.log(r / (r - 1))\n                    new_D = calc_D_val(new_n_res, new_logm, new_logboost)\n                    if new_D < worst_score:\n                        worst_score = new_D\n                        r_drop = r\n                \n                a_drop = congr_dict[r_drop]\n                \n                rem_drop = targets % r_drop\n                cnt_array[rem_drop == a_drop] -= 1\n                uncovered = (cnt_array == 0)\n                \n                sampled_add = random.sample(cand_pool, min(250, len(cand_pool)))\n                best_add_r = None\n                best_add_a = None\n                best_new_D = float(\'inf\')\n                best_new_n_res = n_res\n                \n                uncovered_targets = targets[uncovered]\n                n_res_after_drop = len(uncovered_targets)\n                logm_after_drop = logm - math.log(r_drop)\n                logboost_after_drop = logboost - math.log(r_drop / (r_drop - 1))\n                \n                for r in sampled_add:\n                    if n_res_after_drop > 0:\n                        counts = np.bincount(uncovered_targets % r, minlength=r)\n                        a = int(np.argmax(counts))\n                        added_cov = counts[a]\n                    else:\n                        a = 0\n                        added_cov = 0\n                    \n                    new_n_res = n_res_after_drop - added_cov\n                    new_logm = logm_after_drop + math.log(r)\n                    new_logboost = logboost_after_drop + math.log(r / (r - 1))\n                    \n                    new_D = calc_D_val(new_n_res, new_logm, new_logboost)\n                    if new_D < best_new_D:\n                        best_new_D = new_D\n                        best_add_r = r\n                        best_add_a = a\n                        best_new_n_res = new_n_res\n                        \n                if best_add_r is not None:\n                    delta = best_new_D - current_D\n                    if delta < 0 or random.random() < math.exp(-delta / temp):\n                        del congr_dict[r_drop]\n                        congr_dict[best_add_r] = best_add_a\n                        cnt_array[targets % best_add_r == best_add_a] += 1\n                        n_res = best_new_n_res\n                        logm = logm_after_drop + math.log(best_add_r)\n                        logboost = logboost_after_drop + math.log(best_add_r / (best_add_r - 1))\n                        current_D = best_new_D\n                    else:\n                        cnt_array[rem_drop == a_drop] += 1\n                else:\n                    cnt_array[rem_drop == a_drop] += 1\n\n        elif action == \'optimize\':\n            active = list(congr_dict.keys())\n            if active:\n                sampled = random.sample(active, min(15, len(active)))\n                sampled.sort(reverse=True)\n                for r in sampled:\n                    a_old = congr_dict[r]\n                    is_cov = (targets % r) == a_old\n                    cnt_array[is_cov] -= 1\n                    \n                    uncovered_targets = targets[cnt_array == 0]\n                    if len(uncovered_targets) > 0:\n                        counts = np.bincount(uncovered_targets % r, minlength=r)\n                        a_new = int(np.argmax(counts))\n                    else:\n                        a_new = 0\n                    \n                    cnt_array[(targets % r) == a_new] += 1\n                    congr_dict[r] = a_new\n                    \n                n_res = int((cnt_array == 0).sum())\n                current_D = calc_D_val(n_res, logm, logboost)\n\n    # Final cleanup to ensure absolute optimality of residues\n    optimize_all(congr_dict, cnt_array)\n    return congr_dict\n# EVOLVE-BLOCK-END\n\ndef evaluate(eval_inputs: Mapping[str, Any]) -> dict[str, float]:\n    """Run evaluation on the optimized step."""\n    import sympy\n    import numpy as np\n    Q = 100003\n    targets = np.array(list(sympy.primerange(3, Q)), dtype=np.int64)\n    \n    # Warm-start from the 195-digit record cover instead of starting empty\n    congr_dict = {int(r): int(a) for r, a in eval_inputs["warm_start_cover"]}\n    \n    cand_mods = [int(r) for r in sympy.primerange(3, 8000)]\n    cnt_array = np.zeros(len(targets), dtype=np.int16)\n    \n    # Pre-populate counts\n    for r, a in congr_dict.items():\n        cnt_array += (targets % r) == a\n        \n    for it in range(10):\n        t_temp = 0.8 * (0.02 / 0.8) ** (it / 10)\n        # Recalculate cnt_array based on congr_dict\n        cnt_array = np.zeros(len(targets), dtype=np.int16)\n        logm = math.log(2)\n        logboost = math.log(2.0)\n        for r, a in congr_dict.items():\n            cnt_array += (targets % r) == a\n            logm += math.log(r)\n            logboost += math.log(r / (r - 1))\n            \n        congr_dict = optimize_cover_step(congr_dict, cand_mods, targets, cnt_array, logm, logboost, t_temp)\n        \n    # Recalculate final metrics\n    cnt_array = np.zeros(len(targets), dtype=np.int16)\n    logm = math.log(2)\n    logboost = math.log(2.0)\n    for r, a in congr_dict.items():\n        cnt_array += (targets % r) == a\n        logm += math.log(r)\n        logboost += math.log(r / (r - 1))\n        \n    n_res = int((cnt_array == 0).sum())\n    boost = math.exp(logboost)\n    m_digits = logm / math.log(10)\n    \n    ub = n_res * boost\n    LN10 = math.log(10)\n    D = (m_digits + math.sqrt(m_digits ** 2 + 4 * ub / (LN10 * LN10))) / 2\n    \n    # Constrain E <= 17.5 via Lagrangian penalty to prevent reward hacking\n    E_limit = 17.5\n    E_actual = ub / (D * LN10) if D > 0 else 0.0\n    lagrangian_penalty = 0.0\n    if E_actual > E_limit:\n        lagrangian_penalty = 100.0 * (E_actual - E_limit) ** 2\n        \n    score_headline = -float(D + lagrangian_penalty)\n    \n    # Expose E, |U|, digits(M) as negated secondary metrics for joint optimization visibility\n    return {\n        "neg_est_digits": score_headline,\n        "neg_E": -float(E_actual),\n        "neg_residual_count": -float(n_res),\n        "neg_m_digits": -float(m_digits)\n    }\n'}]}, 'evaluation': {'scores': {'scores': [{'metric': 'neg_est_digits', 'score': -250.59993}, {'metric': 'neg_E', 'score': -17.526209}, {'metric': 'neg_residual_count', 'score': -1262}, {'metric': 'neg_m_digits', 'score': -242.9197}]}, 'insights': {'insights': [{'label': 'Evaluation Metrics', 'text': 'Estimated Digits: 250.5999 (constrained), E: 17.5262, |U|: 1262, digits(M): 242.92'}]}}, 'parentPrograms': ['projects/799795028847/locations/global/collections/default_collection/engines/goldbach_1784979910032/sessions/7658735534374771723/alphaEvolveExperiments/9582896010645531772/alphaEvolvePrograms/7662895210918133436', 'projects/799795028847/locations/global/collections/default_collection/engines/goldbach_1784979910032/sessions/7658735534374771723/alphaEvolveExperiments/9582896010645531772/alphaEvolvePrograms/7662895210918132147', 'projects/799795028847/locations/global/collections/default_collection/engines/goldbach_1784979910032/sessions/7658735534374771723/alphaEvolveExperiments/9582896010645531772/alphaEvolvePrograms/11597998738524454422', 'projects/799795028847/locations/global/collections/default_collection/engines/goldbach_1784979910032/sessions/7658735534374771723/alphaEvolveExperiments/9582896010645531772/alphaEvolvePrograms/7662895210918132147'], 'state': 'COMPLETED'}, {'name': 'projects/799795028847/locations/global/collections/default_collection/engines/goldbach_1784979910032/sessions/7658735534374771723/alphaEvolveExperiments/9582896010645531772/alphaEvolvePrograms/11597998738524453413', 'createTime': '2026-07-26T08:57:39.067436Z', 'content': {'files': [{'path': 'program.py', 'content': '# Copyright 2026 Google LLC\nfrom typing import Any, Mapping\nimport math\nimport random\nimport numpy as np\n\n# EVOLVE-BLOCK-START\ndef optimize_cover_step(congr_dict, cand_mods, targets, cnt_array, logm, logboost, t_temp):\n    """Optimize a single step of congruence cover using simulated annealing style logic.\n\n    Args:\n        congr_dict: Dictionary of r -> a\n        cand_mods: List of prime candidates\n        targets: np.array of target primes\n        cnt_array: np.array of coverage counts\n        logm: current log of modulus M\n        logboost: current log of boost factor\n        t_temp: current temperature\n\n    Returns:\n        Updated congr_dict\n    """\n    import numpy as np\n    import random\n    import math\n\n    if len(targets) == 0:\n        # Safety fallback\n        kind = random.random()\n        r_in = random.choice(list(congr_dict)) if congr_dict else None\n        if kind < 0.5 and r_in is not None:\n            a_old = congr_dict[r_in]\n            a_new = random.randint(0, r_in - 1)\n            if a_new != a_old:\n                congr_dict[r_in] = a_new\n        elif kind < 0.7 and r_in is not None:\n            del congr_dict[r_in]\n        else:\n            r_out = random.choice(cand_mods)\n            if r_out not in congr_dict:\n                a_new = random.randint(0, r_out - 1)\n                congr_dict[r_out] = a_new\n        return congr_dict\n\n    def calc_score(m_digits, ub):\n        LN10 = 2.302585092994046\n        D = 0.5 * (m_digits + math.sqrt(max(0.0, m_digits ** 2 + 4 * ub / (LN10 * LN10))))\n        E = ub / (D * LN10) if D > 0 else 0.0\n        penalty = 0.0\n        if E > 17.5:\n            penalty = 100.0 * (E - 17.5) ** 2\n        return D + penalty\n\n    # We run multiple internal steps per external call to accelerate optimization\n    num_steps = 45\n    cnt_array_local = cnt_array.copy()\n    logm_local = logm\n    logboost_local = logboost\n\n    # Dynamic action probabilities based on temperature\n    # At high temp, we explore (more add/drop). At low temp, we exploit (more optimize).\n    factor = np.clip(t_temp, 0.0, 1.0)\n    p_opt = 0.85 - 0.45 * factor\n    p_add = 0.10 + 0.25 * factor\n    p_drop = 0.05 + 0.20 * factor\n    total_p = p_opt + p_add + p_drop\n    p_opt /= total_p\n    p_add /= total_p\n    p_drop /= total_p\n\n    for _ in range(num_steps):\n        if not congr_dict:\n            action = \'add\'\n        else:\n            cand_pool = [m for m in cand_mods if m not in congr_dict]\n            if not cand_pool:\n                p_opt_cond = p_opt / (p_opt + p_drop)\n                action = \'optimize\' if random.random() < p_opt_cond else \'drop\'\n            else:\n                kind = random.random()\n                if kind < p_add:\n                    action = \'add\'\n                elif kind < p_add + p_opt:\n                    action = \'optimize\'\n                else:\n                    action = \'drop\'\n\n        if action == \'add\':\n            cand_pool = [m for m in cand_mods if m not in congr_dict]\n            if cand_pool:\n                sample_size = min(50, len(cand_pool))\n                sampled_cands = random.sample(cand_pool, sample_size)\n                \n                n_res_curr = np.sum(cnt_array_local == 0)\n                boost_curr = math.exp(logboost_local)\n                m_digits_curr = logm_local / math.log(10)\n                score_curr = calc_score(m_digits_curr, n_res_curr * boost_curr)\n                \n                cand_scores = []\n                cand_choices = []\n                \n                uncovered_mask = (cnt_array_local == 0)\n                for r in sampled_cands:\n                    rem = targets % r\n                    counts = np.bincount(rem, weights=uncovered_mask, minlength=r)\n                    a = int(np.argmax(counts))\n                    cov_count = counts[a]\n                    \n                    m_digits_new = (logm_local + math.log(r)) / math.log(10)\n                    boost_new = boost_curr * r / (r - 1)\n                    n_res_new = max(0, n_res_curr - cov_count)\n                    ub_new = n_res_new * boost_new\n                    score_new = calc_score(m_digits_new, ub_new)\n                    \n                    benefit = score_curr - score_new\n                    cand_scores.append(benefit)\n                    cand_choices.append((r, a))\n                    \n                cand_scores = np.array(cand_scores)\n                temp = max(t_temp, 1e-4)\n                scaled = cand_scores / temp\n                scaled = scaled - np.max(scaled)\n                probs = np.exp(scaled)\n                probs /= np.sum(probs)\n                \n                idx = np.random.choice(len(cand_choices), p=probs)\n                best_cand, best_a = cand_choices[idx]\n                \n                congr_dict[best_cand] = int(best_a)\n                cnt_array_local += (targets % best_cand == best_a)\n                logm_local += math.log(best_cand)\n                logboost_local += math.log(best_cand / (best_cand - 1))\n\n        elif action == \'optimize\':\n            mods_in = list(congr_dict.keys())\n            if mods_in:\n                r = random.choice(mods_in)\n                a_old = congr_dict[r]\n                \n                is_covered_by_r = (targets % r) == a_old\n                cnt_bg = cnt_array_local - is_covered_by_r\n                n_res_bg = np.sum(cnt_bg == 0)\n                \n                boost_curr = math.exp(logboost_local)\n                m_digits_curr = logm_local / math.log(10)\n                score_curr = calc_score(m_digits_curr, np.sum(cnt_array_local == 0) * boost_curr)\n                \n                bg_uncovered_mask = (cnt_bg == 0)\n                counts = np.bincount(targets % r, weights=bg_uncovered_mask, minlength=r)\n                \n                scores_new = []\n                for a in range(r):\n                    n_res_new = max(0, n_res_bg - counts[a])\n                    ub_new = n_res_new * boost_curr\n                    scores_new.append(calc_score(m_digits_curr, ub_new))\n                    \n                scores_new = np.array(scores_new)\n                benefits = score_curr - scores_new\n                \n                temp = max(t_temp, 1e-4)\n                scaled = benefits / temp\n                scaled = scaled - np.max(scaled)\n                probs = np.exp(scaled)\n                probs /= np.sum(probs)\n                \n                a_new = np.random.choice(r, p=probs)\n                \n                congr_dict[r] = int(a_new)\n                cnt_array_local -= is_covered_by_r\n                cnt_array_local += (targets % r == a_new)\n\n        elif action == \'drop\':\n            mods_in = list(congr_dict.keys())\n            if mods_in:\n                boost_curr = math.exp(logboost_local)\n                m_digits_curr = logm_local / math.log(10)\n                score_curr = calc_score(m_digits_curr, np.sum(cnt_array_local == 0) * boost_curr)\n                \n                benefits = []\n                bg_uncovered_masks = []\n                for r in mods_in:\n                    a = congr_dict[r]\n                    is_covered_by_r = (targets % r) == a\n                    cnt_bg = cnt_array_local - is_covered_by_r\n                    n_res_new = np.sum(cnt_bg == 0)\n                    \n                    m_digits_new = (logm_local - math.log(r)) / math.log(10)\n                    boost_new = boost_curr * (r - 1) / r\n                    ub_new = n_res_new * boost_new\n                    score_new = calc_score(m_digits_new, ub_new)\n                    \n                    benefits.append(score_curr - score_new)\n                    bg_uncovered_masks.append(is_covered_by_r)\n                    \n                benefits = np.array(benefits)\n                temp = max(t_temp, 1e-4)\n                scaled = benefits / temp\n                scaled = scaled - np.max(scaled)\n                probs = np.exp(scaled)\n                probs /= np.sum(probs)\n                \n                idx = np.random.choice(len(mods_in), p=probs)\n                r_drop = mods_in[idx]\n                is_covered_by_r = bg_uncovered_masks[idx]\n                \n                del congr_dict[r_drop]\n                cnt_array_local -= is_covered_by_r\n                logm_local -= math.log(r_drop)\n                logboost_local -= math.log(r_drop / (r_drop - 1))\n\n    return congr_dict\n# EVOLVE-BLOCK-END\n\ndef evaluate(eval_inputs: Mapping[str, Any]) -> dict[str, float]:\n    """Run evaluation on the optimized step."""\n    import sympy\n    import numpy as np\n    Q = 100003\n    targets = np.array(list(sympy.primerange(3, Q)), dtype=np.int64)\n    \n    # Warm-start from the 195-digit record cover instead of starting empty\n    congr_dict = {int(r): int(a) for r, a in eval_inputs["warm_start_cover"]}\n    \n    cand_mods = [int(r) for r in sympy.primerange(3, 8000)]\n    cnt_array = np.zeros(len(targets), dtype=np.int16)\n    \n    # Pre-populate counts\n    for r, a in congr_dict.items():\n        cnt_array += (targets % r) == a\n        \n    for it in range(10):\n        t_temp = 0.8 * (0.02 / 0.8) ** (it / 10)\n        # Recalculate cnt_array based on congr_dict\n        cnt_array = np.zeros(len(targets), dtype=np.int16)\n        logm = math.log(2)\n        logboost = math.log(2.0)\n        for r, a in congr_dict.items():\n            cnt_array += (targets % r) == a\n            logm += math.log(r)\n            logboost += math.log(r / (r - 1))\n            \n        congr_dict = optimize_cover_step(congr_dict, cand_mods, targets, cnt_array, logm, logboost, t_temp)\n        \n    # Recalculate final metrics\n    cnt_array = np.zeros(len(targets), dtype=np.int16)\n    logm = math.log(2)\n    logboost = math.log(2.0)\n    for r, a in congr_dict.items():\n        cnt_array += (targets % r) == a\n        logm += math.log(r)\n        l