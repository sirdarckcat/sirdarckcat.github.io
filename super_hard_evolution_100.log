logm_val / LN10\n        ub = n_res_val * boost\n        inside_sqrt = m_digits ** 2 + 4 * ub / (LN10 * LN10)\n        D = (m_digits + math.sqrt(max(0.0, inside_sqrt))) / 2\n        \n        E_actual = ub / (D * LN10) if D > 0 else 0.0\n        penalty = 1000.0 * (E_actual - 17.5) ** 2 if E_actual > 17.5 else 0.0\n        return D + penalty\n\n    def optimize_subset(keys, congr, cnt):\n        for r in keys:\n            a_old = congr[r]\n            rem = targets % r\n            cnt[rem == a_old] -= 1\n            counts = np.bincount(rem[cnt == 0], minlength=r)\n            a_new = int(np.argmax(counts))\n            cnt[rem == a_new] += 1\n            congr[r] = a_new\n\n    # Initial residue optimization\n    init_keys = list(congr_dict.keys())\n    random.shuffle(init_keys)\n    optimize_subset(init_keys, congr_dict, cnt_array)\n    n_res = int((cnt_array == 0).sum())\n    current_D = calc_D_val(n_res, logm, logboost)\n\n    base_temp = max(t_temp, 1e-6)\n    N_STEPS = 100000\n\n    for step in range(N_STEPS):\n        current_temp = base_temp * (0.01 ** (step / max(1, N_STEPS - 1)))\n        \n        # Periodically optimize all to stay on the local optimum manifold\n        if step > 0 and step % 10000 == 0:\n            keys = list(congr_dict.keys())\n            random.shuffle(keys)\n            optimize_subset(keys, congr_dict, cnt_array)\n            n_res = int((cnt_array == 0).sum())\n            current_D = calc_D_val(n_res, logm, logboost)\n\n        action = random.choices([\'add\', \'drop\', \'swap\', \'optimize\'], weights=[0.25, 0.25, 0.40, 0.10], k=1)[0]\n\n        if action == \'add\':\n            sample = []\n            for _ in range(20):\n                r = random.choice(cand_mods)\n                if r not in congr_dict and r not in sample:\n                    sample.append(r)\n                if len(sample) == 8:\n                    break\n            \n            if sample:\n                best_r = None\n                best_a = None\n                best_D = float(\'inf\')\n                best_n_res = None\n                \n                uncovered = targets[cnt_array == 0]\n                for r in sample:\n                    counts = np.bincount(uncovered % r, minlength=r)\n                    a = int(np.argmax(counts))\n                    new_n_res = n_res - counts[a]\n                    new_D = calc_D_val(new_n_res, logm + math.log(r), logboost + math.log(r / (r - 1)))\n                    if new_D < best_D:\n                        best_D = new_D\n                        best_r = r\n                        best_a = a\n                        best_n_res = new_n_res\n                \n                if best_D < current_D or random.random() < math.exp(-(best_D - current_D) / current_temp):\n                    congr_dict[best_r] = best_a\n                    cnt_array[targets % best_r == best_a] += 1\n                    n_res, current_D = best_n_res, best_D\n                    logm += math.log(best_r)\n                    logboost += math.log(best_r / (best_r - 1))\n\n        elif action == \'drop\':\n            active = list(congr_dict.keys())\n            if active:\n                sample = random.sample(active, min(4, len(active)))\n                best_r = None\n                best_D = float(\'inf\')\n                best_n_res = None\n                \n                for r in sample:\n                    a = congr_dict[r]\n                    lost_cov = np.sum((targets[cnt_array == 1] % r) == a)\n                    new_n_res = n_res + lost_cov\n                    new_D = calc_D_val(new_n_res, logm - math.log(r), logboost - math.log(r / (r - 1)))\n                    if new_D < best_D:\n                        best_D = new_D\n                        best_r = r\n                        best_n_res = new_n_res\n                        \n                if best_D < current_D or random.random() < math.exp(-(best_D - current_D) / current_temp):\n                    a = congr_dict[best_r]\n                    cnt_array[targets % best_r == a] -= 1\n                    del congr_dict[best_r]\n                    n_res, current_D = best_n_res, best_D\n                    logm -= math.log(best_r)\n                    logboost -= math.log(best_r / (best_r - 1))\n\n        elif action == \'swap\':\n            active = list(congr_dict.keys())\n            if active:\n                sample_drop = random.sample(active, min(4, len(active)))\n                best_r_drop = None\n                best_drop_D = float(\'inf\')\n                best_drop_n_res = None\n                for r in sample_drop:\n                    a = congr_dict[r]\n                    lost_cov = np.sum((targets[cnt_array == 1] % r) == a)\n                    new_n_res = n_res + lost_cov\n                    new_D = calc_D_val(new_n_res, logm - math.log(r), logboost - math.log(r / (r - 1)))\n                    if new_D < best_drop_D:\n                        best_drop_D = new_D\n                        best_r_drop = r\n                        best_drop_n_res = new_n_res\n                \n                r_drop = best_r_drop\n                a_drop = congr_dict[r_drop]\n                \n                cnt_array[targets % r_drop == a_drop] -= 1\n                logm_after = logm - math.log(r_drop)\n                logboost_after = logboost - math.log(r_drop / (r_drop - 1))\n                \n                sample_add = []\n                for _ in range(20):\n                    r = random.choice(cand_mods)\n                    if r not in congr_dict and r != r_drop and r not in sample_add:\n                        sample_add.append(r)\n                    if len(sample_add) == 8:\n                        break\n                \n                if sample_add:\n                    uncovered = targets[cnt_array == 0]\n                    best_r_add = None\n                    best_a_add = None\n                    best_D = float(\'inf\')\n                    best_n_res = None\n                    \n                    for r in sample_add:\n                        counts = np.bincount(uncovered % r, minlength=r)\n                        a = int(np.argmax(counts))\n                        new_n_res = best_drop_n_res - counts[a]\n                        new_D = calc_D_val(new_n_res, logm_after + math.log(r), logboost_after + math.log(r / (r - 1)))\n                        if new_D < best_D:\n                            best_D = new_D\n                            best_r_add = r\n                            best_a_add = a\n                            best_n_res = new_n_res\n                    \n                    if best_D < current_D or random.random() < math.exp(-(best_D - current_D) / current_temp):\n                        del congr_dict[r_drop]\n                        congr_dict[best_r_add] = best_a_add\n                        cnt_array[targets % best_r_add == best_a_add] += 1\n                        n_res, current_D = best_n_res, best_D\n                        logm = logm_after + math.log(best_r_add)\n                        logboost = logboost_after + math.log(best_r_add / (best_r_add - 1))\n                    else:\n                        cnt_array[targets % r_drop == a_drop] += 1\n                else:\n                    cnt_array[targets % r_drop == a_drop] += 1\n\n        elif action == \'optimize\':\n            active = list(congr_dict.keys())\n            if active:\n                sampled = random.sample(active, min(5, len(active)))\n                optimize_subset(sampled, congr_dict, cnt_array)\n                n_res = int((cnt_array == 0).sum())\n                current_D = calc_D_val(n_res, logm, logboost)\n\n    # Final cleanup to ensure absolute optimality of residues\n    final_keys = list(congr_dict.keys())\n    random.shuffle(final_keys)\n    optimize_subset(final_keys, congr_dict, cnt_array)\n    return congr_dict\n# EVOLVE-BLOCK-END\n\ndef evaluate(eval_inputs: Mapping[str, Any]) -> dict[str, float]:\n    """Run evaluation on the optimized step."""\n    import sympy\n    import numpy as np\n    Q = 100003\n    targets = np.array(list(sympy.primerange(3, Q)), dtype=np.int64)\n    \n    # Warm-start from the 195-digit record cover instead of starting empty\n    congr_dict = {int(r): int(a) for r, a in eval_inputs["warm_start_cover"]}\n    \n    cand_mods = [int(r) for r in sympy.primerange(3, 8000)]\n    cnt_array = np.zeros(len(targets), dtype=np.int16)\n    \n    # Pre-populate counts\n    for r, a in congr_dict.items():\n        cnt_array += (targets % r) == a\n        \n    for it in range(10):\n        t_temp = 0.8 * (0.02 / 0.8) ** (it / 10)\n        # Recalculate cnt_array based on congr_dict\n        cnt_array = np.zeros(len(targets), dtype=np.int16)\n        logm = math.log(2)\n        logboost = math.log(2.0)\n        for r, a in congr_dict.items():\n            cnt_array += (targets % r) == a\n            logm += math.log(r)\n            logboost += math.log(r / (r - 1))\n            \n        congr_dict = optimize_cover_step(congr_dict, cand_mods, targets, cnt_array, logm, logboost, t_temp)\n        \n    # Recalculate final metrics\n    cnt_array = np.zeros(len(targets), dtype=np.int16)\n    logm = math.log(2)\n    logboost = math.log(2.0)\n    for r, a in congr_dict.items():\n        cnt_array += (targets % r) == a\n        logm += math.log(r)\n        logboost += math.log(r / (r - 1))\n        \n    n_res = int((cnt_array == 0).sum())\n    boost = math.exp(logboost)\n    m_digits = logm / math.log(10)\n    \n    ub = n_res * boost\n    LN10 = math.log(10)\n    D = (m_digits + math.sqrt(m_digits ** 2 + 4 * ub / (LN10 * LN10))) / 2\n    \n    # Constrain E <= 17.5 via Lagrangian penalty to prevent reward hacking\n    E_limit = 17.5\n    E_actual = ub / (D * LN10) if D > 0 else 0.0\n    lagrangian_penalty = 0.0\n    if E_actual > E_limit:\n        lagrangian_penalty = 100.0 * (E_actual - E_limit) ** 2\n        \n    score_headline = -float(D + lagrangian_penalty)\n    \n    # Expose E, |U|, digits(M) as negated secondary metrics for joint optimization visibility\n    return {\n        "neg_est_digits": score_headline,\n        "neg_E": -float(E_actual),\n        "neg_residual_count": -float(n_res),\n        "neg_m_digits": -float(m_digits)\n    }\n'}]}, 'evaluation': {'scores': {'scores': [{'metric': 'neg_est_digits', 'score': -191.38599}, {'metric': 'neg_E', 'score': -17.50308}, {'metric': 'neg_residual_count', 'score': -711}, {'metric': 'neg_m_digits', 'score': -183.78355}]}, 'insights': {'insights': [{'label': 'Evaluation Metrics', 'text': 'Estimated Digits: 191.3860 (constrained), E: 17.5031, |U|: 711, digits(M): 183.78'}]}}, 'parentPrograms': ['projects/799795028847/locations/global/collections/default_collection/engines/goldbach_1784979910032/sessions/7658735534374771723/alphaEvolveExperiments/9582896010645531772/alphaEvolvePrograms/11597998738524452663', 'projects/799795028847/locations/global/collections/default_collection/engines/goldbach_1784979910032/sessions/7658735534374771723/alphaEvolveExperiments/9582896010645531772/alphaEvolvePrograms/11597998738524454422', 'projects/799795028847/locations/global/collections/default_collection/engines/goldbach_1784979910032/sessions/7658735534374771723/alphaEvolveExperiments/9582896010645531772/alphaEvolvePrograms/7662895210918132147', 'projects/799795028847/locations/global/collections/default_collection/engines/goldbach_1784979910032/sessions/7658735534374771723/alphaEvolveExperiments/9582896010645531772/alphaEvolvePrograms/7662895210918132147'], 'state': 'COMPLETED'}, {'name': 'projects/799795028847/locations/global/collections/default_collection/engines/goldbach_1784979910032/sessions/7658735534374771723/alphaEvolveExperiments/9582896010645531772/alphaEvolvePrograms/7662895210918133436', 'createTime': '2026-07-26T06:22:05.448621Z', 'content': {'files': [{'path': 'program.py', 'content': '# Copyright 2026 Google LLC\nfrom typing import Any, Mapping\nimport math\nimport random\nimport numpy as np\n\n# EVOLVE-BLOCK-START\ndef optimize_cover_step(congr_dict, cand_mods, targets, cnt_array, logm, logboost, t_temp):\n    """Optimize congruence cover using Symbiotic Prime-Residue Wormholes (SPRW) with Antimatter Annihilation."""\n    import math\n    import random\n    import numpy as np\n\n    # CRAZY IDEA: "Symbiotic Prime-Residue Wormholes (SPRW) with Antimatter Annihilation"\n    # We model the prime moduli as inter-dimensional wormholes in a Goldbach multiverse.\n    # Uncovered targets are baryonic matter. Wormholes greedily consume this matter.\n    # To escape local minima traps, we unleash "Antimatter Annihilation" cascades to aggressively \n    # obliterate the most bloated, useless wormholes and force a search for leaner, more efficient pathways.\n    \n    cnt_array = cnt_array.copy()\n    n_res = int((cnt_array == 0).sum())\n\n    def calc_D_val(n_res_val, logm_val, logboost_val):\n        boost = math.exp(logboost_val)\n        m_digits = logm_val / math.log(10)\n        ub = n_res_val * boost\n        LN10 = math.log(10)\n        inside_sqrt = m_digits ** 2 + 4 * ub / (LN10 * LN10)\n        D = (m_digits + math.sqrt(max(0.0, inside_sqrt))) / 2\n        \n        E_limit = 17.5\n        E_actual = ub / (D * LN10) if D > 0 else 0.0\n        lagrangian_penalty = 0.0\n        if E_actual > E_limit:\n            lagrangian_penalty = 1000.0 * (E_actual - E_limit) ** 2\n        return D + lagrangian_penalty\n\n    def optimize_all(congr, cnt):\n        keys = list(congr.keys())\n        random.shuffle(keys)\n        for r in keys:\n            a_old = congr[r]\n            is_cov = (targets % r) == a_old\n            cnt[is_cov] -= 1\n            uncovered = targets[cnt == 0]\n            if len(uncovered) > 0:\n                counts = np.bincount(uncovered % r, minlength=r)\n                a_new = int(np.argmax(counts))\n            else:\n                a_new = 0\n            if a_new != a_old:\n                cnt[(targets % r) == a_new] += 1\n                congr[r] = a_new\n            else:\n                cnt[is_cov] += 1\n\n    # Initialize residues optimally\n    optimize_all(congr_dict, cnt_array)\n    n_res = int((cnt_array == 0).sum())\n    current_D = calc_D_val(n_res, logm, logboost)\n\n    # High-intensity inner loop (1500 steps) acting as local search\n    N_STEPS = 1500\n    base_temp = max(t_temp, 1e-5)\n\n    for step in range(N_STEPS):\n        temp = base_temp * (0.95 ** (10 * step / N_STEPS))\n        \n        # Periodic symbiotic mutation (resynchronize the network)\n        if step > 0 and step % 150 == 0:\n            optimize_all(congr_dict, cnt_array)\n            n_res = int((cnt_array == 0).sum())\n            current_D = calc_D_val(n_res, logm, logboost)\n\n        # "Antimatter Annihilation": Destroy the most bloated wormholes\n        if temp > 0.05 and random.random() < 0.02 and congr_dict:\n            active = list(congr_dict.keys())\n            sample_active = random.sample(active, min(15, len(active)))\n            worst_r = None\n            worst_score = float(\'inf\')\n            \n            for r in sample_active:\n                unique_cov = np.sum((cnt_array == 1) & ((targets % r) == congr_dict[r]))\n                score = unique_cov / (math.log(r) + 1e-9)\n                if score < worst_score:\n                    worst_score = score\n                    worst_r = r\n                    \n            if worst_r is not None:\n                r_drop = worst_r\n                a_drop = congr_dict[r_drop]\n                cnt_array[(targets % r_drop) == a_drop] -= 1\n                del congr_dict[r_drop]\n                n_res = int((cnt_array == 0).sum())\n                logm -= math.log(r_drop)\n                logboost -= math.log(r_drop / (r_drop - 1))\n                current_D = calc_D_val(n_res, logm, logboost)\n                continue\n\n        action = random.choices([\'add\', \'drop\', \'swap\', \'optimize\'], weights=[0.25, 0.15, 0.45, 0.15], k=1)[0]\n\n        if action == \'add\':\n            cand_pool = [m for m in cand_mods if m not in congr_dict]\n            if cand_pool:\n                uncovered_targets = targets[cnt_array == 0]\n                n_res_current = len(uncovered_targets)\n                \n                sampled = random.sample(cand_pool, min(250, len(cand_pool)))\n                best_r = None\n                best_a = None\n                best_new_D = float(\'inf\')\n                best_new_n_res = n_res\n                \n                for r in sampled:\n                    if n_res_current > 0:\n                        counts = np.bincount(uncovered_targets % r, minlength=r)\n                        a = int(np.argmax(counts))\n                        added_cov = counts[a]\n                    else:\n                        a = 0\n                        added_cov = 0\n                    new_n_res = n_res - added_cov\n                    new_logm = logm + math.log(r)\n                    new_logboost = logboost + math.log(r / (r - 1))\n                    new_D = calc_D_val(new_n_res, new_logm, new_logboost)\n                    if new_D < best_new_D:\n                        best_new_D = new_D\n                        best_r = r\n                        best_a = a\n                        best_new_n_res = new_n_res\n                        \n                if best_r is not None:\n                    delta = best_new_D - current_D\n                    if delta < 0 or random.random() < math.exp(-delta / temp):\n                        congr_dict[best_r] = best_a\n                        cnt_array[targets % best_r == best_a] += 1\n                        n_res = best_new_n_res\n                        logm += math.log(best_r)\n                        logboost += math.log(best_r / (best_r - 1))\n                        current_D = best_new_D\n\n        elif action == \'drop\':\n            active = list(congr_dict.keys())\n            if active:\n                sampled = random.sample(active, min(80, len(active)))\n                best_r = None\n                best_new_D = float(\'inf\')\n                best_new_n_res = n_res\n                \n                singly_covered = (cnt_array == 1)\n                for r in sampled:\n                    a = congr_dict[r]\n                    lost_cov = np.sum(singly_covered & ((targets % r) == a))\n                    new_n_res = n_res + lost_cov\n                    new_logm = logm - math.log(r)\n                    new_logboost = logboost - math.log(r / (r - 1))\n                    new_D = calc_D_val(new_n_res, new_logm, new_logboost)\n                    if new_D < best_new_D:\n                        best_new_D = new_D\n                        best_r = r\n                        best_new_n_res = new_n_res\n                        \n                if best_r is not None:\n                    delta = best_new_D - current_D\n                    if delta < 0 or random.random() < math.exp(-delta / temp):\n                        r_drop = best_r\n                        a_drop = congr_dict[r_drop]\n                        cnt_array[targets % r_drop == a_drop] -= 1\n                        del congr_dict[r_drop]\n                        n_res = best_new_n_res\n                        logm -= math.log(r_drop)\n                        logboost -= math.log(r_drop / (r_drop - 1))\n                        current_D = best_new_D\n\n        elif action == \'swap\':\n            active = list(congr_dict.keys())\n            cand_pool = [m for m in cand_mods if m not in congr_dict]\n            if active and cand_pool:\n                sample_active = random.sample(active, min(20, len(active)))\n                r_drop = sample_active[0]\n                worst_score = float(\'inf\')\n                singly_covered = (cnt_array == 1)\n                for r in sample_active:\n                    loss = np.sum(singly_covered & ((targets % r) == congr_dict[r]))\n         