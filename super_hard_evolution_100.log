0 * LN10)\n        if val < 0:\n            val = 0.0\n        return 0.5 * (m_digits + math.sqrt(val))\n\n    def get_best_residue(r, cnt_array, targets):\n        weights = (cnt_array == 0).astype(np.float64)\n        counts = np.bincount(get_mod_array(r), weights=weights, minlength=r)\n        best_a = np.argmax(counts)\n        return int(best_a), counts[best_a]\n\n    # Precompute candidate weights for Gumbel-Max weighted sampling\n    # We favor smaller primes elegantly by scaling with 1.0 / r**0.5\n    def get_candidates(cand_pool, k=16):\n        if not cand_pool:\n            return []\n        if len(cand_pool) <= k:\n            return sorted(cand_pool)\n        \n        # Gumbel-Max / A-Res weighted sampling without replacement\n        keys = []\n        for r in cand_pool:\n            key = math.log(max(random.random(), 1e-15)) * (r ** 0.5)\n            keys.append((key, r))\n        keys.sort(reverse=True, key=lambda x: x[0])\n        return [r for _, r in keys[:k]]\n\n    # Convert congr_dict to a normal dictionary\n    congr_dict = dict(congr_dict)\n    \n    # Initialize state variables\n    current_n_res = int(np.sum(cnt_array == 0))\n    current_logm = float(logm)\n    current_logboost = float(logboost)\n    current_D = calc_D(current_n_res, current_logm, current_logboost)\n    \n    cnt_array = cnt_array.copy()\n    \n    # Increased inner steps due to massive speedup from cache and smart sampling\n    N_INNER_STEPS = 1200\n    \n    for step in range(N_INNER_STEPS):\n        if not congr_dict:\n            action = \'add\'\n        else:\n            r_val = random.random()\n            if r_val < 0.25:\n                action = \'add\'\n            elif r_val < 0.40:\n                action = \'drop\'\n            elif r_val < 0.80:\n                action = \'swap\'\n            else:\n                action = \'optimize\'\n                \n        if action == \'add\':\n            cand_pool = [m for m in cand_mods if m not in congr_dict]\n            sampled_cands = get_candidates(cand_pool, k=16)\n            if sampled_cands:\n                best_cand = None\n                best_a = None\n                best_new_D = float(\'inf\')\n                best_num_covered = 0\n                \n                for r in sampled_cands:\n                    a, num_covered = get_best_residue(r, cnt_array, targets)\n                    new_logm = current_logm + math.log(r)\n                    new_logboost = current_logboost + math.log(r / (r - 1))\n                    new_n_res = current_n_res - num_covered\n                    new_D = calc_D(new_n_res, new_logm, new_logboost)\n                    if new_D < best_new_D:\n                        best_new_D = new_D\n                        best_cand = r\n                        best_a = a\n                        best_num_covered = num_covered\n                        \n                if best_cand is not None:\n                    delta_D = best_new_D - current_D\n                    if delta_D <= 0 or random.random() < math.exp(-delta_D / max(t_temp, 1e-6)):\n                        congr_dict[best_cand] = best_a\n                        cnt_array += (get_mod_array(best_cand) == best_a)\n                        current_n_res -= best_num_covered\n                        current_logm += math.log(best_cand)\n                        current_logboost += math.log(best_cand / (best_cand - 1))\n                        current_D = best_new_D\n                        \n        elif action == \'drop\':\n            mods_in = list(congr_dict.keys())\n            if mods_in:\n                sampled_drops = random.sample(mods_in, min(16, len(mods_in)))\n                best_cand = None\n                best_new_D = float(\'inf\')\n                best_num_uncovered = 0\n                \n                for r in sampled_drops:\n                    a = congr_dict[r]\n                    num_uncovered = int(np.sum((cnt_array == 1) & (get_mod_array(r) == a)))\n                    new_logm = current_logm - math.log(r)\n                    new_logboost = current_logboost - math.log(r / (r - 1))\n                    new_n_res = current_n_res + num_uncovered\n                    new_D = calc_D(new_n_res, new_logm, new_logboost)\n                    if new_D < best_new_D:\n                        best_new_D = new_D\n                        best_cand = r\n                        best_num_uncovered = num_uncovered\n                        \n                if best_cand is not None:\n                    delta_D = best_new_D - current_D\n                    if delta_D <= 0 or random.random() < math.exp(-delta_D / max(t_temp, 1e-6)):\n                        a = congr_dict[best_cand]\n                        cnt_array -= (get_mod_array(best_cand) == a)\n                        del congr_dict[best_cand]\n                        current_n_res += best_num_uncovered\n                        current_logm -= math.log(best_cand)\n                        current_logboost -= math.log(best_cand / (best_cand - 1))\n                        current_D = best_new_D\n                        \n        elif action == \'swap\':\n            mods_in = list(congr_dict.keys())\n            cand_pool = [m for m in cand_mods if m not in congr_dict]\n            sampled_cands = get_candidates(cand_pool, k=16)\n            if mods_in and sampled_cands:\n                # Target the weakest active modulus (minimize unique coverage) among 8 sampled ones\n                sampled_ins = random.sample(mods_in, min(8, len(mods_in)))\n                r_in = min(sampled_ins, key=lambda r: np.sum((cnt_array == 1) & (get_mod_array(r) == congr_dict[r])))\n                a_in = congr_dict[r_in]\n                \n                temp_cnt_array = cnt_array - (get_mod_array(r_in) == a_in)\n                temp_n_res = int(np.sum(temp_cnt_array == 0))\n                temp_logm = current_logm - math.log(r_in)\n                temp_logboost = current_logboost - math.log(r_in / (r_in - 1))\n                \n                best_out = None\n                best_a_out = None\n                best_new_D = float(\'inf\')\n                best_num_covered = 0\n                \n                for r_out in sampled_cands:\n                    a_out, num_covered = get_best_residue(r_out, temp_cnt_array, targets)\n                    new_logm = temp_logm + math.log(r_out)\n                    new_logboost = temp_logboost + math.log(r_out / (r_out - 1))\n                    new_n_res = temp_n_res - num_covered\n                    new_D = calc_D(new_n_res, new_logm, new_logboost)\n                    if new_D < best_new_D:\n                        best_new_D = new_D\n                        best_out = r_out\n                        best_a_out = a_out\n                        best_num_covered = num_covered\n                        \n                if best_out is not None:\n                    delta_D = best_new_D - current_D\n                    if delta_D <= 0 or random.random() < math.exp(-delta_D / max(t_temp, 1e-6)):\n                        del congr_dict[r_in]\n                        congr_dict[best_out] = best_a_out\n                        cnt_array = temp_cnt_array + (get_mod_array(best_out) == best_a_out)\n                        current_n_res = temp_n_res - best_num_covered\n                        current_logm = temp_logm + math.log(best_out)\n                        current_logboost = temp_logboost + math.log(best_out / (best_out - 1))\n                        current_D = best_new_D\n                        \n        elif action == \'optimize\':\n            mods_in = list(congr_dict.keys())\n            if mods_in:\n                r = random.choice(mods_in)\n                a_old = congr_dict[r]\n                \n                temp_cnt_array = cnt_array - (get_mod_array(r) == a_old)\n                temp_n_res = int(np.sum(temp_cnt_array == 0))\n                \n                a_new, num_covered = get_best_residue(r, temp_cnt_array, targets)\n                new_n_res = temp_n_res - num_covered\n                new_D = calc_D(new_n_res, current_logm, current_logboost)\n                \n                delta_D = new_D - current_D\n                if delta_D <= 0 or random.random() < math.exp(-delta_D / max(t_temp, 1e-6)):\n                    congr_dict[r] = a_new\n                    cnt_array = temp_cnt_array + (get_mod_array(r) == a_new)\n                    current_n_res = new_n_res\n                    current_D = new_D\n\n    return congr_dict\n# EVOLVE-BLOCK-END\n\ndef evaluate(eval_inputs: Mapping[str, Any]) -> dict[str, float]:\n    """Run evaluation on the optimized step."""\n    # Let\'s say we maximize -n_digits_est (smaller estimated N-size)\n    # Using sympy/math to compute est digits\n    import sympy\n    import numpy as np\n    Q = 100003\n    targets = np.array(list(sympy.primerange(3, Q)), dtype=np.int64)\n    # Let\'s run the optimize_cover_step starting from empty cover for some iterations\n    congr_dict = {}\n    cand_mods = [int(r) for r in sympy.primerange(3, 8000)]\n    cnt_array = np.zeros(len(targets), dtype=np.int16)\n    logm = math.log(2)\n    logboost = math.log(2.0)\n    \n    for it in range(10):\n        t_temp = 0.8 * (0.02 / 0.8) ** (it / 10)\n        # Update cnt_array based on congr_dict\n        cnt_array = np.zeros(len(targets), dtype=np.int16)\n        logm = math.log(2)\n        logboost = math.log(2.0)\n        for r, a in congr_dict.items():\n            cnt_array += (targets % r) == a\n            logm += math.log(r)\n            logboost += math.log(r / (r - 1))\n            \n        congr_dict = optimize_cover_step(congr_dict, cand_mods, targets, cnt_array, logm, logboost, t_temp)\n        \n    # Recalculate final metrics\n    cnt_array = np.zeros(len(targets), dtype=np.int16)\n    logm = math.log(2)\n    logboost = math.log(2.0)\n    for r, a in congr_dict.items():\n        cnt_array += (targets % r) == a\n        logm += math.log(r)\n        logboost += math.log(r / (r - 1))\n        \n    n_res = int((cnt_array == 0).sum())\n    boost = math.exp(logboost)\n    m_digits = logm / math.log(10)\n    \n    ub = n_res * boost\n    LN10 = math.log(10)\n    D = (m_digits + math.sqrt(m_digits ** 2 + 4 * ub / (LN10 * LN10))) / 2\n    return {"neg_est_digits": -float(D)}\n'}]}, 'evaluation': {'scores': {'scores': [{'metric': 'neg_est_digits', 'score': -50.655006}]}}, 'parentPrograms': ['projects/799795028847/locations/global/collections/default_collection/engines/goldbach_1784979910032/sessions/7013217697778074030/alphaEvolveExperiments/15164875354338173448/alphaEvolvePrograms/18102573509735111676'], 'state': 'COMPLETED'}, {'name': 'projects/799795028847/locations/global/collections/default_collection/engines/goldbach_1784979910032/sessions/7013217697778074030/alphaEvolveExperiments/15164875354338173448/alphaEvolvePrograms/18102573509735109925', 'createTime': '2026-07-25T19:35:26.180213Z', 'content': {'files': [{'path': 'program.py', 'content': '# Copyright 2026 Google LLC\nfrom typing import Any, Mapping\nimport math\nimport random\nimport numpy as np\n\n# EVOLVE-BLOCK-START\ndef optimize_cover_step(congr_dict, cand_mods, targets, cnt_array, logm, logboost, t_temp):\n    """Optimize a single step of congruence cover using simulated annealing style logic.\n\n    Args:\n        congr_dict: Dictionary of r -> a\n        cand_mods: List of prime candidates\n        targets: np.array of target primes\n        cnt_array: np.array of coverage counts\n        logm: current log of modulus M\n        logboost: current log of boost factor\n        t_temp: current temperature\n\n    Returns:\n        Updated congr_dict\n    """\n    import numpy as np\n    import random\n    import math\n\n    if len(targets) == 0:\n        return congr_dict\n\n    def calc_D(n_res, logm, logboost):\n        LN10 = 2.302585092994046\n        m_digits = logm / LN10\n        ub = n_res * math.exp(logboost)\n        val = m_digits ** 2 + 4.0 * ub / (LN10 * LN10)\n        if val < 0:\n            val = 0.0\n        return 0.5 * (m_digits + math.sqrt(val))\n\n    def get_best_residue_fast(r, uncovered_targets):\n        if len(uncovered_targets) == 0:\n            return 0, 0\n        counts = np.bincount(uncovered_targets % r, minlength=r)\n        best_a = np.argmax(counts)\n        return int(best_a), int(counts[best_a])\n\n    def get_candidates(cand_pool, k=12):\n        if not cand_pool:\n            return []\n        sorted_pool = sorted(cand_pool)\n        if len(sorted_pool) <= k:\n            return sorted_pool\n        \n        pool_arr = np.array(sorted_pool, dtype=np.float64)\n        w = 1.0 / (pool_arr * np.log(np.maximum(pool_arr, 1.1)))\n        w /= w.sum()\n        weights = 0.85 * w + 0.15 * (1.0 / len(pool_arr))\n        \n        return list(np.random.choice(pool_arr, size=k, replace=False, p=weights).astype(int))\n\n    # Convert congr_dict to a normal dictionary\n    congr_dict = dict(congr_dict)\n    \n    # Initialize state variables\n    current_n_res = int(np.sum(cnt_array == 0))\n    current_logm = float(logm)\n    current_logboost = float(logboost)\n    current_D = calc_D(current_n_res, current_logm, current_logboost)\n    \n    cnt_array = cnt_array.copy()\n    \n    # Initialize fast lookup caches\n    uncovered_targets = targets[cnt_array == 0]\n    cnt_1_targets = targets[cnt_array == 1]\n    \n    best_state_congr = dict(congr_dict)\n    best_state_D = current_D\n    \n    # We perform 1000 internal steps of simulated annealing per call due to cache speedups\n    N_INNER_STEPS = 1000\n    \n    for step in range(N_INNER_STEPS):\n        curr_temp = t_temp * (0.5 ** (step / N_INNER_STEPS))\n        \n        if not congr_dict:\n            action = \'add\'\n        else:\n            if current_n_res == 0:\n                # Fully covered! Focus on dropping/swapping to reduce modulus size\n                r_val = random.random()\n                if r_val < 0.60:\n                    action = \'drop\'\n                elif r_val < 0.90:\n                    action = \'swap\'\n                else:\n                    action = \'optimize\'\n            else:\n                # Dynamic action scaling based on percent uncovered targets\n                r_val = random.random()\n                pct_uncovered = current_n_res / len(targets)\n                add_prob = 0.10 + 0.40 * pct_uncovered\n                drop_prob = 0.10 + 0.05 * (1.0 - pct_uncovered)\n                swap_prob = 0.30 + 0.20 * (1.0 - pct_uncovered)\n                \n                if r_val < add_prob:\n                    action = \'add\'\n                elif r_val < add_prob + drop_prob:\n                    action = \'drop\'\n                elif r_val < add_prob + drop_prob + swap_prob:\n                    action = \'swap\'\n                else:\n                    action = \'optimize\'\n                \n        if action == \'add\':\n            cand_pool = [m for m in cand_mods if m not in congr_dict]\n            sampled_cands = get_candidates(cand_pool, k=12)\n            if sampled_cands:\n                best_cand = None\n                best_a = None\n                best_new_D = float(\'inf\')\n                best_num_covered = 0\n                \n                for r in sampled_cands:\n                    a, num_covered = get_best_residue_fast(r, uncovered_targets)\n                    new_logm = current_logm + math.log(r)\n                    new_logboost = current_logboost + math.log(r / (r - 1))\n                    new_n_res = current_n_res - num_covered\n                    new_D = calc_D(new_n_res, new_logm, new_logboost)\n                    if new_D < best_new_D:\n                        best_new_D = new_D\n                        best_cand = r\n                        best_a = a\n                        best_num_covered = num_covered\n                        \n                if best_cand is not None:\n                    delta_D = best_new_D - current_D\n                    if delta_D <= 0 or random.random() < math.exp(-delta_D / max(curr_temp, 1e-6)):\n                        congr_dict[best_cand] = best_a\n                        cnt_array += (targets % best_cand == best_a)\n                        current_n_res -= best_num_covered\n                        current_logm += math.log(best_cand)\n                        current_logboost += math.log(best_cand / (best_cand - 1))\n                        current_D = best_new_D\n                        \n                        # Re-filter fast caches\n                        uncovered_targets = targets[cnt_array == 0]\n                        cnt_1_targets = targets[cnt_array == 1]\n                        \n                        if current_D < best_state_D:\n                            best_state_D = current_D\n                            best_state_congr = dict(congr_dict)\n                        \n        elif action == \'drop\':\n            mods_in = list(congr_dict.keys())\n            if mods_in:\n                sampled_drops = random.sample(mods_in, min(12, len(mods_in)))\n                best_cand = None\n                best_new_D = float(\'inf\')\n                best_num_uncovered = 0\n                \n                for r in sampled_drops:\n                    a = congr_dict[r]\n                    num_uncovered = int(np.sum(cnt_1_targets % r == a))\n                    new_logm = current_logm - math.log(r)\n                    new_logboost = current_logboost - math.log(r / (r - 1))\n                    new_n_res = current_n_res + num_uncovered\n                    new_D = calc_D(new_n_res, new_logm, new_logboost)\n                    if new_D < best_new_D:\n                        best_new_D = new_D\n                        best_cand = r\n                        best_num_uncovered = num_uncovered\n                        \n                if best_cand is not None:\n                    delta_D = best_new_D - current_D\n                    if delta_D <= 0 or random.random() < math.exp(-delta_D / max(curr_temp, 1e-6)):\n                        a = congr_dict[best_cand]\n                        cnt_array -= (targets % best_cand == a)\n                        del congr_dict[best_cand]\n                        current_n_res += best_num_uncovered\n                        current_logm -= math.log(best_cand)\n                        current_logboost -= math.log(best_cand / (best_cand - 1))\n                        current_D = best_new_D\n                        \n                        # Re-filter fast caches\n                        uncovered_targets = targets[cnt_array == 0]\n                        cnt_1_targets = targets[cnt_array == 1]\n                        \n                        if current_D < best_state_D:\n                            best_state_D = current_D\n                            best_state_congr = dict(congr_dict)\n                        \n        elif action == \'swap\':\n            mods_in = list(congr_dict.keys())\n            cand_pool = [m for m in cand_mods if m not in congr_dict]\n            sampled_cands = get_candidates(cand_pool, k=12)\n            if mods_in and sampled_cands:\n                r_in = random.choice(mods_in)\n                a_in = congr_dict[r_in]\n                \n                temp_cnt_array = cnt_array - (targets % r_in == a_in)\n                temp_uncovered_targets = targets[temp_cnt_array == 0]\n                temp_n_res = len(temp_uncovered_targets)\n                temp_logm = current_logm - math.log(r_in)\n                temp_logboost = current_logboost - math.log(r_in / (r_in - 1))\n                \n                best_out = None\n                best_a_out = None\n                best_new_D = float(\'inf\')\n                best_num_covered = 0\n                \n                for r_out in sampled_cands:\n                    a_out, num_covered = get_best_residue_fast(r_out, temp_uncovered_targets)\n                    new_logm = temp_logm + math.log(r_out)\n                    new_logboost = temp_logboost + math.log(r_out / (r_out - 1))\n                    new_n_res = temp_n_res - num_covered\n                    new_D = calc_D(new_n_res, new_logm, new_logboost)\n                    if new_D < best_new_D:\n                        best_new_D = new_D\n                        best_out = r_out\n                        best_a_out = a_out\n                        best_num_covered = num_covered\n                        \n                if best_out is not None:\n                    delta_D = best_new_D - current_D\n                    if delta_D <= 0 or random.random() < math.exp(-delta_D / max(curr_temp, 1e-6)):\n                        del congr_dict[r_in]\n                        congr_dict[best_out] = best_a_out\n                        cnt_array = temp_cnt_array + (targets % best_out == best_a_out)\n                        current_n_res = temp_n_res - best_num_covered\n                        current_logm = temp_logm + math.log(best_out)\n                        current_logboost = temp_logboost + math.log(best_out / (best_out - 1))\n                        current_D = best_new_D\n                        \n                        # Re-filter fast caches\n                        uncovered_targets = targets[cnt_array == 0]\n                        cnt_1_targets = targets[cnt_array == 1]\n                        \n                        if current_D < best_state_D:\n                            best_state_D = current_D\n                            best_state_congr = dict(congr_dict)\n                        \n        elif action == \'optimize\':\n            mods_in = list(congr_dict.keys())\n            if mods_in:\n                r = random.choice(mods_in)\n                a_old = congr_dict[r]\n                \n                temp_cnt_array = cnt_array - (targets % r == a_old)\n                temp_uncovered_targets = targets[temp_cnt_array == 0]\n                \n                a_new, num_covered = get_best_residue_fast(r, temp_uncovered_targets)\n                new_n_res = len(temp_uncovered_targets) - num_covered\n                new_D = calc_D(new_n_res, current_logm, current_logboost)\n                \n                delta_D = new_D - current_D\n                if delta_D <= 0 or random.random() < math.exp(-delta_D / max(curr_temp, 1e-6)):\n                    congr_dict[r] = a_new\n                    cnt_array = temp_cnt_array + (targets % r == a_new)\n                    current_n_res = new_n_res\n                    current_D = new_D\n                    \n                    # Re-filter fast caches\n                    uncovered_targets = targets[cnt_array == 0]\n                    cnt_1_targets = targets[cnt_array == 1]\n                    \n                    if current_D < best_state_D:\n                        best_state_D = current_D\n                        best_state_congr = dict(congr_dict)\n\n    return best_state_congr\n# EVOLVE-BLOCK-END\n\ndef evaluate(eval_inputs: Mapping[str, Any]) -> dict[str, float]:\n    """Run evaluation on the optimized step."""\n    # Let\'s say we maximize -n_digits_est (smaller estimated N-size)\n    # Using sympy/math to compute est digits\n    import sympy\n    import numpy as np\n    Q = 100003\n    targets = np.array(list(sympy.primerange(3, Q)), dtype=np.int64)\n    # Let\'s run the optimize_cover_step starting from empty cover for some iterations\n    congr_dict = {}\n    cand_mods = [int(r) for r in sympy.primerange(3, 8000)]\n    cnt_array = np.zeros(len(targets), dtype=np.int16)\n    logm = math.log(2)\n    logboost = math.log(2.0)\n    \n    for it in range(10):\n        t_temp = 0.8 * (0.02 / 0.8) ** (it / 10)\n        # Update cnt_array based on congr_dict\n        cnt_array = np.zeros(len(targets), dtype=np.int16)\n        logm = math.log(2)\n        logboost = math.log(2.0)\n        for r, a in congr_dict.items():\n            cnt_array += (targets % r) == a\n            logm += math.log(r)\n            logboost += math.log(r / (r - 1))\n            \n        congr_dict = optimize_cover_step(congr_dict, cand_mods, targets, cnt_array, logm, logboost, t_temp)\n        \n    # Recalculate final metrics\n    cnt_array = np.zeros(len(targets), dtype=np.int16)\n    logm = math.log(2)\n    logboost = math.log(2.0)\n    for r, a in congr_dict.items():\n        cnt_array += (targets % r) == a\n        logm += math.log(r)\n        logboost += math.log(r / (r - 1))\n        \n    n_res = int((cnt_array == 0).sum())\n    boost = math.exp(logboost)\n    m_digits = logm / math.log(10)\n    \n    ub = n_res * boost\n    LN10 = math.log(10)\n    D = (m_digits + math.sqrt(m_digits ** 2 + 4 * ub / (LN10 * LN10))) / 2\n    return {"neg_est_digits": -float(D)}\n'}]}, 'evaluation': {'scores': {'scores': [{'metric': 'neg_est_digits', 'score': -50.655006}]}}, 'parentPrograms': ['projects/799795028847/locations/global/collections/default_collection/engines/goldbach_1784979910032/sessions/7013217697778074030/alphaEvolveExperiments/15164875354338173448/alphaEvolvePrograms/18102573509735111676'], 'state': 'COMPLETED'}, {'name': 'projects/799795028847/locations/global/collections/default_collection/engines/goldbach_1784979910032/sessions/7013217697778074030/alphaEvolveExperiments/15164875354338173448/alphaEvolvePrograms/18102573509735108912', 'createTime': '2026-07-25T19:35:01.171473Z', 'content': {'files': [{'path': 'program.py', 'content': '# Copyright 2026 Google LLC\nfrom typing import Any, Mapping\nimport math\nimport random\nimport numpy as np\n\n# EVOLVE-BLOCK-START\ndef optimize_cover_step(congr_dict, cand_mods, targets, cnt_array, logm, logboost, t_temp):\n    """Optimize a single step of congruence cover using simulated annealing style logic.\n\n    Args:\n        congr_dict: Dictionary of r -> a\n        cand_mods: List of prime candidates\n        targets: np.array of target primes\n        cnt_array: np.array of coverage counts\n        logm: current log of modulus M\n        logboost: current log of boost factor\n        t_temp: current temperature\n\n    Returns:\n        Updated congr_dict\n    """\n    import numpy as np\n    import random\n    import math\n\n    if len(targets) == 0:\n        return congr_dict\n\n    def calc_D(n_res, logm, logboost):\n        LN10 = 2.302585092994046\n        m_digits = logm / LN10\n        ub = n_res * math.exp(logboost)\n        val = m_digits ** 2 + 4.0 * ub / (LN10 * LN10)\n        if val < 0:\n            val = 0.0\n        return 0.5 * (m_digits + math.sqrt(val))\n\n    def get_best_residue(r, targets_unc):\n        if len(targets_unc) == 0:\n            return 0, 0\n        counts = np.bincount(targets_unc % r, minlength=r)\n        best_a = int(np.argmax(counts))\n        return best_a, counts[best_a]\n\n    def get_candidates(cand_pool, k=32):\n        if not cand_pool:\n            return []\n        if len(cand_pool) <= k:\n            return cand_pool\n        # Focus on smaller primes with 75% probability\n        if random.random() < 0.75:\n            sub_pool_size = min(200, len(cand_pool))\n            sub_pool = cand_pool[:sub_pool_size]\n            return random.sample(sub_pool, min(k, sub_pool_size))\n        else:\n            return random.sample(cand_pool, k)\n\n    # Convert congr_dict to a normal dictionary\n    congr_dict = dict(congr_dict)\n    \n    # Initialize state variables\n    current_n_res = int(np.sum(cnt_array == 0))\n    current_logm = float(logm)\n    current_logboost = float(logboost)\n    current_D = calc_D(current_n_res, current_logm, current_logboost)\n    \n    cnt_array = cnt_array.copy()\n    \n    # We perform 600 internal steps of simulated annealing per call\n    N_INNER_STEPS = 600\n    \n    for step in range(N_INNER_STEPS):\n        if not congr_dict:\n            action = \'add\'\n        else:\n            r_val = random.random()\n            if r_val < 0.25:\n                action = \'add\'\n            elif r_val <