h with Simulated Annealing style logic."""\n    import numpy as np\n    import random\n    import math\n\n    if len(targets) == 0:\n        return congr_dict\n\n    # Copy to avoid side effects during search\n    cnt_array = cnt_array.copy()\n    n_res = int((cnt_array == 0).sum())\n\n    def calc_D_val(n_res_val, logm_val, logboost_val):\n        boost = math.exp(logboost_val)\n        m_digits = logm_val / math.log(10)\n        ub = n_res_val * boost\n        LN10 = math.log(10)\n        inside_sqrt = m_digits ** 2 + 4 * ub / (LN10 * LN10)\n        D = (m_digits + math.sqrt(max(0.0, inside_sqrt))) / 2\n        \n        E_limit = 17.5\n        E_actual = ub / (D * LN10) if D > 0 else 0.0\n        lagrangian_penalty = 0.0\n        if E_actual > E_limit:\n            lagrangian_penalty = 100.0 * (E_actual - E_limit) ** 2\n        return D + lagrangian_penalty\n\n    def optimize_all(congr, cnt):\n        keys = list(congr.keys())\n        random.shuffle(keys)\n        for r in keys:\n            a_old = congr[r]\n            rem = targets % r\n            is_cov = (rem == a_old)\n            # Remove contribution\n            cnt[is_cov] -= 1\n            # Find best a\n            uncovered = targets[cnt == 0]\n            if len(uncovered) > 0:\n                counts = np.bincount(uncovered % r, minlength=r)\n                a_new = int(np.argmax(counts))\n            else:\n                a_new = 0\n            # Add contribution back\n            if a_new != a_old:\n                cnt[rem == a_new] += 1\n                congr[r] = a_new\n            else:\n                cnt[is_cov] += 1\n\n    # Initial residue optimization\n    optimize_all(congr_dict, cnt_array)\n    n_res = int((cnt_array == 0).sum())\n    current_D = calc_D_val(n_res, logm, logboost)\n\n    # CRAZY IDEA: "The Zen of Speed"\n    # Ditch the slow, complicated softmax sampling over hundreds of elements.\n    # Instead, we just use extremely rapid single-move Simulated Annealing.\n    # This simplifies the code enormously and lets us perform 5000+ steps!\n    \n    base_temp = max(t_temp, 1e-4)\n    N_STEPS = 5000\n    \n    cand_pool = [m for m in cand_mods if m not in congr_dict]\n    mods_in = list(congr_dict.keys())\n\n    for step in range(N_STEPS):\n        temp = base_temp * (0.95 ** (step / 100))\n        \n        # Periodically optimize all to stay on the local optimum manifold\n        if step > 0 and step % 1000 == 0:\n            optimize_all(congr_dict, cnt_array)\n            n_res = int((cnt_array == 0).sum())\n            current_D = calc_D_val(n_res, logm, logboost)\n\n        if not mods_in:\n            action = \'add\'\n        elif not cand_pool:\n            action = random.choice([\'drop\', \'optimize\'])\n        else:\n            action = random.choices([\'add\', \'drop\', \'swap\', \'optimize\'], weights=[0.2, 0.1, 0.5, 0.2])[0]\n\n        if action == \'add\':\n            r = random.choice(cand_pool)\n            uncovered = targets[cnt_array == 0]\n            if len(uncovered) > 0:\n                counts = np.bincount(uncovered % r, minlength=r)\n                a = int(np.argmax(counts))\n                newly_covered = counts[a]\n            else:\n                a = 0\n                newly_covered = 0\n                \n            n_res_new = n_res - newly_covered\n            logm_new = logm + math.log(r)\n            logboost_new = logboost + math.log(r / (r - 1))\n            D_new = calc_D_val(n_res_new, logm_new, logboost_new)\n            \n            delta = D_new - current_D\n            if delta < 0 or random.random() < math.exp(-delta / temp):\n                congr_dict[r] = a\n                cand_pool.remove(r)\n                mods_in.append(r)\n                cnt_array += (targets % r == a)\n                n_res = n_res_new\n                logm = logm_new\n                logboost = logboost_new\n                current_D = D_new\n\n        elif action == \'drop\':\n            r = random.choice(mods_in)\n            a = congr_dict[r]\n            loss = np.sum((cnt_array == 1) & (targets % r == a))\n            n_res_new = n_res + loss\n            logm_new = logm - math.log(r)\n            logboost_new = logboost - math.log(r / (r - 1))\n            D_new = calc_D_val(n_res_new, logm_new, logboost_new)\n            \n            delta = D_new - current_D\n            if delta < 0 or random.random() < math.exp(-delta / temp):\n                del congr_dict[r]\n                mods_in.remove(r)\n                cand_pool.append(r)\n                cnt_array -= (targets % r == a)\n                n_res = n_res_new\n                logm = logm_new\n                logboost = logboost_new\n                current_D = D_new\n\n        elif action == \'optimize\':\n            r = random.choice(mods_in)\n            a_old = congr_dict[r]\n            \n            cnt_array -= (targets % r == a_old)\n            uncovered = targets[cnt_array == 0]\n            \n            if len(uncovered) > 0:\n                counts = np.bincount(uncovered % r, minlength=r)\n                a_new = int(np.argmax(counts))\n                newly_covered = counts[a_new]\n            else:\n                a_new = 0\n                newly_covered = 0\n                \n            n_res_new = len(uncovered) - newly_covered\n            D_new = calc_D_val(n_res_new, logm, logboost)\n            \n            delta = D_new - current_D\n            if delta < 0 or random.random() < math.exp(-delta / temp):\n                congr_dict[r] = a_new\n                cnt_array += (targets % r == a_new)\n                n_res = n_res_new\n                current_D = D_new\n            else:\n                cnt_array += (targets % r == a_old)\n\n        elif action == \'swap\':\n            r_drop = random.choice(mods_in)\n            r_add = random.choice(cand_pool)\n            \n            a_drop = congr_dict[r_drop]\n            cnt_array -= (targets % r_drop == a_drop)\n            \n            uncovered = targets[cnt_array == 0]\n            if len(uncovered) > 0:\n                counts = np.bincount(uncovered % r_add, minlength=r_add)\n                a_add = int(np.argmax(counts))\n                newly_covered = counts[a_add]\n            else:\n                a_add = 0\n                newly_covered = 0\n                \n            n_res_new = len(uncovered) - newly_covered\n            logm_new = logm - math.log(r_drop) + math.log(r_add)\n            logboost_new = logboost - math.log(r_drop / (r_drop - 1)) + math.log(r_add / (r_add - 1))\n            D_new = calc_D_val(n_res_new, logm_new, logboost_new)\n            \n            delta = D_new - current_D\n            if delta < 0 or random.random() < math.exp(-delta / temp):\n                del congr_dict[r_drop]\n                mods_in.remove(r_drop)\n                cand_pool.append(r_drop)\n                \n                congr_dict[r_add] = a_add\n                mods_in.append(r_add)\n                cand_pool.remove(r_add)\n                \n                cnt_array += (targets % r_add == a_add)\n                n_res = n_res_new\n                logm = logm_new\n                logboost = logboost_new\n                current_D = D_new\n            else:\n                cnt_array += (targets % r_drop == a_drop)\n\n    # Final cleanup to ensure absolute optimality of residues\n    optimize_all(congr_dict, cnt_array)\n    return congr_dict\n# EVOLVE-BLOCK-END\n\ndef evaluate(eval_inputs: Mapping[str, Any]) -> dict[str, float]:\n    """Run evaluation on the optimized step."""\n    import sympy\n    import numpy as np\n    Q = 100003\n    targets = np.array(list(sympy.primerange(3, Q)), dtype=np.int64)\n    \n    # Warm-start from the 195-digit record cover instead of starting empty\n    congr_dict = {int(r): int(a) for r, a in eval_inputs["warm_start_cover"]}\n    \n    cand_mods = [int(r) for r in sympy.primerange(3, 8000)]\n    cnt_array = np.zeros(len(targets), dtype=np.int16)\n    \n    # Pre-populate counts\n    for r, a in congr_dict.items():\n        cnt_array += (targets % r) == a\n        \n    for it in range(10):\n        t_temp = 0.8 * (0.02 / 0.8) ** (it / 10)\n        # Recalculate cnt_array based on congr_dict\n        cnt_array = np.zeros(len(targets), dtype=np.int16)\n        logm = math.log(2)\n        logboost = math.log(2.0)\n        for r, a in congr_dict.items():\n            cnt_array += (targets % r) == a\n            logm += math.log(r)\n            logboost += math.log(r / (r - 1))\n            \n        congr_dict = optimize_cover_step(congr_dict, cand_mods, targets, cnt_array, logm, logboost, t_temp)\n        \n    # Recalculate final metrics\n    cnt_array = np.zeros(len(targets), dtype=np.int16)\n    logm = math.log(2)\n    logboost = math.log(2.0)\n    for r, a in congr_dict.items():\n        cnt_array += (targets % r) == a\n        logm += math.log(r)\n        logboost += math.log(r / (r - 1))\n        \n    n_res = int((cnt_array == 0).sum())\n    boost = math.exp(logboost)\n    m_digits = logm / math.log(10)\n    \n    ub = n_res * boost\n    LN10 = math.log(10)\n    D = (m_digits + math.sqrt(m_digits ** 2 + 4 * ub / (LN10 * LN10))) / 2\n    \n    # Constrain E <= 17.5 via Lagrangian penalty to prevent reward hacking\n    E_limit = 17.5\n    E_actual = ub / (D * LN10) if D > 0 else 0.0\n    lagrangian_penalty = 0.0\n    if E_actual > E_limit:\n        lagrangian_penalty = 100.0 * (E_actual - E_limit) ** 2\n        \n    score_headline = -float(D + lagrangian_penalty)\n    \n    # Expose E, |U|, digits(M) as negated secondary metrics for joint optimization visibility\n    return {\n        "neg_est_digits": score_headline,\n        "neg_E": -float(E_actual),\n        "neg_residual_count": -float(n_res),\n        "neg_m_digits": -float(m_digits)\n    }\n'}]}, 'evaluation': {'scores': {'scores': [{'metric': 'neg_est_digits', 'score': -191.58221}, {'metric': 'neg_E', 'score': -17.541992}, {'metric'