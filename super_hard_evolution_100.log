 is already sorted)\n    inactive_list = [m for m in cand_mods if m not in active_mods]\n    active_list = list(active_mods)\n    \n    # On-demand static caches to avoid redundant numpy ops across steps\n    rem_cache = {}\n    counts_all_cache = {}\n    \n    for _ in range(num_updates):\n        # 50/50 chance to update an active coordinate vs an inactive one\n        if active_list and (not inactive_list or random.random() < 0.5):\n            idx = random.randrange(len(active_list))\n            r = active_list[idx]\n            is_active = True\n        elif inactive_list:\n            # Power bias (p=3.0) to heavily prioritize smaller, high-impact moduli\n            idx = int(len(inactive_list) * (random.random() ** 3.0))\n            r = inactive_list[idx]\n            is_active = False\n        else:\n            break\n            \n        # Retrieve or compute the remainder targets for r\n        if r in rem_cache:\n            rem_targets = rem_cache[r]\n        else:\n            rem_targets = (targets % r).astype(np.int16)\n            rem_cache[r] = rem_targets\n        \n        if is_active:\n            a_old = congr_dict[r]\n            mask_old = rem_targets == a_old\n            is_uniquely_covered = (cnt_array == 1) & mask_old\n            uncovered_if_removed = int(is_uniquely_covered.sum())\n            bg_n_res = current_n_res + uncovered_if_removed\n            bg_logm = current_logm - math.log(r)\n            bg_logboost = current_logboost - math.log(r / (r - 1.0))\n            \n            # Uncovered mask includes currently uncovered ones + uniquely covered by old remainder\n            mask_uncovered = (cnt_array == 0) | is_uniquely_covered\n            current_state = a_old\n        else:\n            bg_n_res = current_n_res\n            bg_logm = current_logm\n            bg_logboost = current_logboost\n            \n            mask_uncovered = (cnt_array == 0)\n            current_state = -1\n            \n        bg_m_digits = bg_logm / LN10\n        bg_boost = math.exp(bg_logboost)\n            \n        # Highly optimized: bincount is run only over the small subset of uncovered targets!\n        counts = np.bincount(rem_targets[mask_uncovered], minlength=r)\n        \n        new_n_res_all = np.zeros(r + 1)\n        new_n_res_all[:r] = bg_n_res - counts\n        new_n_res_all[r] = bg_n_res\n        \n        new_m_digits_all = np.full(r + 1, bg_m_digits + math.log10(r))\n        new_m_digits_all[r] = bg_m_digits\n        \n        new_boost_all = np.full(r + 1, bg_boost * r / (r - 1.0))\n        new_boost_all[r] = bg_boost\n        \n        ub_all = new_n_res_all * new_boost_all\n        inner_sqrt_all = np.maximum(0.0, new_m_digits_all**2 + C * ub_all)\n        D_all = (new_m_digits_all + np.sqrt(inner_sqrt_all)) / 2.0\n        \n        inner_sqrt_bg = max(0.0, bg_m_digits**2 + C * bg_n_res * bg_boost)\n        if inner_sqrt_bg > 0:\n            dD_dn = C * bg_boost / (4.0 * math.sqrt(inner_sqrt_bg))\n        else:\n            dD_dn = 1.0\n            \n        scores = -D_all / (dD_dn + 1e-12)\n        \n        # Retrieve or compute the total remainder counts for r\n        if r in counts_all_cache:\n            counts_all = counts_all_cache[r]\n        else:\n            counts_all = np.bincount(rem_targets, minlength=r)\n            counts_all_cache[r] = counts_all\n            \n        # Tie-breaker to prefer overlapping already covered targets\n        scores[:r] += 1e-6 * counts_all\n        \n        # Gibbs sampling over the r+1 states\n        scaled_scores = scores / temp\n        scaled_scores -= np.max(scaled_scores)\n        probs = np.exp(scaled_scores)\n        probs /= np.sum(probs)\n        \n        a_new = np.random.choice(r + 1, p=probs)\n        \n        # Apply the update and maintain cnt_array / state tracking\n        if a_new == r:\n            if current_state != -1:\n                del congr_dict[r]\n                cnt_array -= mask_old.astype(cnt_array.dtype)\n                active_mods.remove(r)\n                active_list[idx] = active_list[-1]\n                active_list.pop()\n                bisect.insort(inactive_list, r)\n                current_n_res = bg_n_res\n                current_logm = bg_logm\n                current_logboost = bg_logboost\n        else:\n            if current_state == -1:\n                mask_new = rem_targets == a_new\n                congr_dict[r] = int(a_new)\n                cnt_array += mask_new.astype(cnt_array.dtype)\n                active_mods.add(r)\n                active_list.append(r)\n                inactive_list.pop(idx)\n                current_n_res = bg_n_res - int(counts[a_new] + 0.1)\n                current_logm = bg_logm + math.log(r)\n                current_logboost = bg_logboost + math.log(r / (r - 1.0))\n            elif current_state != a_new:\n                mask_new = rem_targets == a_new\n                congr_dict[r] = int(a_new)\n                cnt_array -= mask_old.astype(cnt_array.dtype)\n                cnt_array += mask_new.astype(cnt_array.dtype)\n                current_n_res = bg_n_res - int(counts[a_new] + 0.1)\n                current_logm = bg_logm + math.log(r)\n                current_logboost = bg_logboost + math.log(r / (r - 1.0))\n\n    return congr_dict\n# EVOLVE-BLOCK-END\n\ndef evaluate(eval_inputs: Mapping[str, Any]) -> dict[str, float]:\n    """Run evaluation on the optimized step."""\n    # Let\'s say we maximize -n_digits_est (smaller estimated N-size)\n    # Using sympy/math to compute est digits\n    import sympy\n    import numpy as np\n    Q = 100003\n    targets = np.array(list(sympy.primerange(3, Q)), dtype=np.int64)\n    # Let\'s run the optimize_cover_step starting from empty cover for some iterations\n    congr_dict = {}\n    cand_mods = [int(r) for r in sympy.primerange(3, 8000)]\n    cnt_array = np.zeros(len(targets), dtype=np.int16)\n    logm = math.log(2)\n    logboost = math.log(2.0)\n    \n    for it in range(10):\n        t_temp = 0.8 * (0.02 / 0.8) ** (it / 10)\n        # Update cnt_array based on congr_dict\n        cnt_array = np.zeros(len(targets), dtype=np.int16)\n        logm = math.log(2)\n        logboost = math.log(2.0)\n        for r, a in congr_dict.items():\n            cnt_array += (targets % r) == a\n            logm += math.log(r)\n            logboost += math.log(r / (r - 1))\n            \n        congr_dict = optimize_cover_step(congr_dict, cand_mods, targets, cnt_array, logm, logboost, t_temp)\n        \n    # Recalculate final metrics\n    cnt_array = np.zeros(len(targets), dtype=np.int16)\n    logm = math.log(2)\n    logboost = math.log(2.0)\n    for r, a in congr_dict.items():\n        cnt_array += (targets % r) == a\n        logm += math.log(r)\n        logboost += math.log(r / (r - 1))\n        \n    n_res = int((cnt_array == 0).sum())\n    boost = math.exp(logboost)\n    m_digits = logm / math.log(10)\n    \n    ub = n_res * boost\n    LN10 = math.log(10)\n    D = (m_digits + math.sqrt(m_digits ** 2 + 4 * ub / (LN10 * LN10))) / 2\n    return {"neg_est_digits": -float(D)}\n'}]}, 'evaluation': {'scores': {'scores': [{'metric': 'neg_est_digits', 'score': -50.655006}]}}, 'parentPrograms': ['projects/799795028847/locations/global/collections/default_collection/engines/goldbach_1784979910032/sessions/7013217697778074030/alphaEvolveExperiments/15164875354338173448/alphaEvolvePrograms/18102573509735112082', 'projects/799795028847/locations/global/collections/default_collection/engines/goldbach_1784979910032/sessions/7013217697778074030/alphaEvolveExperiments/15164875354338173448/alphaEvolvePrograms/18102573509735112469'], 'state': 'COMPLETED'}, {'name': 'projects/799795028847/locations/global/collections/default_collection/engines/goldbach_1784979910032/sessions/7013217697778074030/alphaEvolveExperiments/15164875354338173448/alphaEvolvePrograms/18102573509735109924', 'createTime': '2026-07-25T19:56:38.090689Z', 'content': {'files': [{'path': 'program.py', 'content': '# Copyright 2026 Google LLC\nfrom typing import Any, Mapping\nimport math\nimport random\nimport numpy as np\n\n# EVOLVE-BLOCK-START\ndef optimize_cover_step(congr_dict, cand_mods, targets, cnt_array, logm, logboost, t_temp):\n    """Optimize congruence cover using multi-step exact simulated annealing logic."""\n    import numpy as np\n    import random\n    import math\n\n    def calc_D(m_val, ub_val):\n        LN10 = 2.302585092994046\n        m_dig = m_val / LN10\n        if ub_val >= 0:\n            return (m_dig + math.sqrt(m_dig**2 + 4 * ub_val / (LN10**2))) / 2\n        else:\n            dD_dub = 1.0 / max(1e-9, 2.0 * m_dig * (LN10**2))\n            return m_dig + ub_val * dD_dub\n\n    if len(targets) == 0:\n        return congr_dict\n\n    # Cast cnt_array to np.int64 to support safe accumulation\n    cnt_array = np.array(cnt_array, dtype=np.int64)\n\n    # Multi-step Metropolis-Hastings SA with Smart Mutation and Swap Moves!\n    # By testing multiple candidates per step and employing swap, we dramatically improve search efficiency.\n    internal_steps = 10000\n\n    n_res = int(np.sum(cnt_array == 0))\n    current_ub = n_res * math.exp(logboost)\n    current_D = calc_D(logm, current_ub)\n\n    for _ in range(internal_steps):\n        action = random.choice([\'add\', \'drop\', \'optimize\', \'optimize\', \'swap\', \'swap\'])\n        if not congr_dict:\n            action = \'add\'\n\n        if action == \'add\':\n            r_cands = random.sample(cand_mods, min(3, len(cand_mods)))\n            best_new_D = float(\'inf\')\n            best_r, best_a, best_max_cov = None, None, None\n            \n            uncovered_targets = targets[cnt_array == 0]\n            \n            for r in r_cands:\n                if r in congr_dict:\n                    continue\n                if len(uncovered_targets) > 0:\n                    counts = np.bincount(uncovered_targets % r, minlength=r)\n                    a = int(np.argmax(counts))\n                    max_covered = counts[a]\n                else:\n                    a, max_covered = 0, 0\n                    \n                new_n_res = n_res - max_covered\n                new_logm = logm + math.log(r)\n                new_logboost = logboost + math.log(r / (r - 1))\n                new_ub = new_n_res * math.exp(new_logboost)\n                new_D_r = calc_D(new_logm, new_ub)\n                \n                if new_D_r < best_new_D:\n                    best_new_D = new_D_r\n                    best_r = r\n                    best_a = a\n                    best_max_cov = max_covered\n            \n            if best_r is not None:\n                new_D = best_new_D\n                new_n_res = n_res - best_max_cov\n                new_logm = logm + math.log(best_r)\n                new_logboost = logboost + math.log(best_r / (best_r - 1))\n                \n                if new_D < current_D or random.random() < math.exp((current_D - new_D) / max(t_temp, 1e-9)):\n                    congr_dict[best_r] = best_a\n                    cnt_array += (targets % best_r) == best_a\n                    logm, logboost, current_D, n_res = new_logm, new_logboost, new_D, new_n_res\n\n        elif action == \'drop\':\n            r = random.choice(list(congr_dict.keys()))\n            a_drop = congr_dict[r]\n            \n            mask = (targets % r) == a_drop\n            num_only_r = np.sum((cnt_array == 1) & mask)\n            \n            new_n_res = n_res + num_only_r\n            new_logm = logm - math.log(r)\n            new_logboost = logboost - math.log(r / (r - 1))\n            new_ub = new_n_res * math.exp(new_logboost)\n            new_D = calc_D(new_logm, new_ub)\n            \n            if new_D < current_D or random.random() < math.exp((current_D - new_D) / max(t_temp, 1e-9)):\n                del congr_dict[r]\n                cnt_array -= mask\n                logm, logboost, current_D, n_res = new_logm, new_logboost, new_D, new_n_res\n\n        elif action == \'optimize\':\n            r = random.choice(list(congr_dict.keys()))\n            a_old = congr_dict[r]\n            \n            mask = (targets % r) == a_old\n            only_r_mask = (cnt_array == 1) & mask\n            uncovered_bg = targets[(cnt_array == 0) | only_r_mask]\n            \n            if len(uncovered_bg) > 0:\n                counts = np.bincount(uncovered_bg % r, minlength=r)\n                a_new = int(np.argmax(counts))\n                max_covered = counts[a_new]\n            else:\n                a_new = 0\n                max_covered = 0\n                \n            if a_new != a_old:\n                new_n_res = n_res + np.sum(only_r_mask) - max_covered\n                new_ub = new_n_res * math.exp(logboost)\n                new_D = calc_D(logm, new_ub)\n                \n                if new_D < current_D or random.random() < math.exp((current_D - new_D) / max(t_temp, 1e-9)):\n                    congr_dict[r] = a_new\n                    cnt_array -= mask\n                    cnt_array += (targets % r) == a_new\n                    current_D, n_res = new_D, new_n_res\n\n        elif action == \'swap\':\n            r_drop = random.choice(list(congr_dict.keys()))\n            a_drop = congr_dict[r_drop]\n            \n            mask_drop = (targets % r_drop) == a_drop\n            num_only_r_drop = np.sum((cnt_array == 1) & mask_drop)\n            \n            uncovered_mask = (cnt_array == 0) | ((cnt_array == 1) & mask_drop)\n            uncovered_targets = targets[uncovered_mask]\n\n            r_cands = random.sample(cand_mods, min(3, len(cand_mods)))\n            best_new_D = float(\'inf\')\n            best_r, best_a, best_max_cov = None, None, None\n\n            for r_add in r_cands:\n                if r_add in congr_dict or r_add == r_drop:\n                    continue\n                if len(uncovered_targets) > 0:\n                    counts = np.bincount(uncovered_targets % r_add, minlength=r_add)\n                    a_add = int(np.argmax(counts))\n                    max_covered = counts[a_add]\n                else:\n                    a_add, max_covered = 0, 0\n\n                new_n_res = n_res + num_only_r_drop - max_covered\n                new_logm = logm - math.log(r_drop) + math.log(r_add)\n                new_logboost = logboost - math.log(r_drop / (r_drop - 1)) + math.log(r_add / (r_add - 1))\n                new_ub = new_n_res * math.exp(new_logboost)\n                new_D_r = calc_D(new_logm, new_ub)\n\n                if new_D_r < best_new_D:\n                    best_new_D = new_D_r\n                    best_r = r_add\n                    best_a = a_add\n                    best_max_cov = max_covered\n            \n            if best_r is not None:\n                new_D = best_new_D\n                new_n_res = n_res + num_only_r_drop - best_max_cov\n                new_logm = logm - math.log(r_drop) + math.log(best_r)\n                new_logboost = logboost - math.log(r_drop / (r_drop - 1)) + math.log(best_r / (best_r - 1))\n                \n                if new_D < current_D or random.random() < math.exp((current_D - new_D) / max(t_temp, 1e-9)):\n                    del congr_dict[r_drop]\n                    cnt_array -= mask_drop\n                    congr_dict[best_r] = best_a\n                    cnt_array += (targets % best_r) == best_a\n                    logm, logboost, current_D, n_res = new_logm, new_logboost, new_D, new_n_res\n\n    return congr_dict\n# EVOLVE-BLOCK-END\n\ndef evaluate(eval_inputs: Mapping[str, Any]) -> dict[str, float]:\n    """Run evaluation on the optimized step."""\n    # Let\'s say we maximize -n_digits_est (smaller estimated N-size)\n    # Using sympy/math to compute est digits\n    import sympy\n    import numpy as np\n    Q = 100003\n    targets = np.array(list(sympy.primerange(3, Q)), dtype=np.int64)\n    # Let\'s run the optimize_cover_step starting from empty cover for some iterations\n    congr_dict = {}\n    cand_mods = [int(r) for r in sympy.primerange(3, 8000)]\n    cnt_array = np.zeros(len(targets), dtype=np.int16)\n    logm = math.log(2)\n    logboost = math.log(2.0)\n    \n    for it in range(10):\n        t_temp = 0.8 * (0.02 / 0.8) ** (it / 10)\n        # Update cnt_array based on congr_dict\n        cnt_array = np.zeros(len(targets), dtype=np.int16)\n        logm = math.log(2)\n        logboost = math.log(2.0)\n        for r, a in congr_dict.items():\n            cnt_array += (targets % r) == a\n            logm += math.log(r)\n            logboost += math.log(r / (r - 1))\n            \n        congr_dict = optimize_cover_step(congr_dict, cand_mods, targets, cnt_array, logm, logboost, t_temp)\n        \n    # Recalculate final metrics\n    cnt_array = np.zeros(len(targets), dtype=np.int16)\n    logm = math.log(2)\n    logboost = math.log(2.0)\n    for r, a in congr_dict.items():\n        cnt_array += (targets % r) == a\n        logm += math.log(r)\n        logboost += math.log(r / (r - 1))\n        \n    n_res = int((cnt_array == 0).sum())\n    boost = math.exp(logboost)\n    m_digits = logm / math.log(10)\n    \n    ub = n_res * boost\n    LN10 = math.log(10)\n    D = (m_digits + math.sqrt(m_digits ** 2 + 4 * ub / (LN10 * LN10))) / 2\n    return {"neg_est_digits": -float(D)}\n'}]}, 'evaluation': {'scores': {'scores': [{'metric': 'neg_est_digits', 'score': -50.655006}]}}, 'parentPrograms': ['projects/799795028847/locations/global/collections/default_collection/engines/goldbach_1784979910032/sessions/7013217697778074030/alphaEvolveExperiments/15164875354338173448/alphaEvolvePrograms/18102573509735108720'], 'state': 'COMPLETED'}, {'name': 'projects/799795028847/locations/global/collections/default_collection/engines/goldbach_1784979910032/sessions/7013217697778074030/alphaEvolveExperiments/15164875354338173448/alphaEvolvePrograms/18102573509735110614', 'createTime': '2026-07-25T19:56:07.463158Z', 'content': {'files': [{'path': 'program.py', 'content': '# Copyright 2026 Google LLC\nfrom typing import Any, Mapping\nimport math\nimport random\nimport numpy as np\n\n# EVOLVE-BLOCK-START\ndef optimize_cover_step(congr_dict, cand_mods, targets, cnt_array, logm, logboost, t_temp):\n    """Optimize congruence cover using an intensive internal simulated annealing / local search.\n\n    Args:\n        congr_dict: Dictionary of r -> a\n        cand_mods: List of prime candidates\n        targets: np.array of target primes\n        cnt_array: np.array of coverage counts\n        logm: current log of modulus M\n        logboost: current log of boost factor\n        t_temp: current temperature\n\n    Returns:\n        Updated congr_dict\n    """\n    import numpy as np\n    import random\n    import math\n\n    # Precompute / cache logs, weights and targets % r\n    if not hasattr(optimize_cover_step, "log_cache"):\n        optimize_cover_step.log_cache = {}\n    log_cache = optimize_cover_step.log_cache\n    for r in cand_mods:\n        if r not in log_cache:\n            log_cache[r] = (math.log(r), math.log(r / (r - 1)))\n\n    if not hasattr(optimize_cover_step, "weight_cache"):\n        optimize_cover_step.weight_cache = {}\n    weight_cache = optimize_cover_step.weight_cache\n    for r in cand_mods:\n        if r not in weight_cache:\n            weight_cache[r] = 1.0 / (r ** 0.8)\n\n    if not hasattr(optimize_cover_step, "mod_cache"):\n        optimize_cover_step.mod_cache = {}\n    mod_cache = optimize_cover_step.mod_cache\n\n    def get_score(n_res, lm, lb):\n        m_dig = lm / 2.302585092994046\n        ub = n_res * math.exp(lb)\n        return (m_dig + math.sqrt(m_dig * m_dig + 0.7544467881615819 * ub)) / 2\n\n    # Initialize current state variables\n    cnt_array = cnt_array.copy()\n    n_res = int(np.count_nonzero(cnt_array == 0))\n    current_score = get_score(n_res, logm, logboost)\n\n    # Run an intensive internal search of 120 steps\n    num_inner_steps = 120\n    temp = max(t_temp, 1e-4)\n\n    for step in range(num_inner_steps):\n        proposals = []\n        # Always include the option to stay\n        proposals.append((current_score, \'stay\', None, n_res))\n\n        # 1. ADD MOVES\n        cand_pool = [m for m in cand_mods if m not in congr_dict]\n        sampled_adds = []\n        if cand_pool:\n            # Weighted random sampling without replacement using Gumbel-Max\n            pool_keys = [(random.random() ** (1.0 / weight_cache[m]), m) for m in cand_pool]\n            pool_keys.sort(reverse=True)\n            sampled_adds = [m for _, m in pool_keys[:min(30, len(pool_keys))]]\n            \n            uncovered_mask = (cnt_array == 0)\n            n_uncovered = n_res\n            \n            for r in sampled_adds:\n                cache_key = (id(targets), r)\n                t_mod = mod_cache.get(cache_key)\n                if t_mod is None:\n                    t_mod = targets % r\n                    mod_cache[cache_key] = t_mod\n                \n                if n_uncovered > 0:\n                    sub_arr = t_mod[uncovered_mask]\n                    counts = np.bincount(sub_arr, minlength=r)\n                    best_a = int(np.argmax(counts))\n                    max_covered = counts[best_a]\n                else:\n                    best_a = 0\n                    max_covered = 0\n                \n                n_res_new = n_res - max_covered\n                lm_new = logm + log_cache[r][0]\n                lb_new = logboost + log_cache[r][1]\n                score_new = get_score(n_res_new, lm_new, lb_new)\n                proposals.append((score_new, \'add\', (r, best_a), n_res_new))\n\n        # 2. DROP MOVES\n        if congr_dict:\n            for r, a in congr_dict.items():\n                cache_key = (id(targets), r)\n                t_mod = mod_cache.get(cache_key)\n                if t_mod is None:\n                    t_mod = targets % r\n                    mod_cache[cache_key] = t_mod\n                \n                num_newly_uncovered = int(np.count_nonzero((t_mod == a) & (cnt_array == 1)))\n                n_res_new = n_res + num_newly_uncovered\n                lm_new = logm - log_cache[r][0]\n                lb_new = logboost - log_cache[r][1]\n                score_new = get_score(n_res_new, lm_new, lb_new)\n                proposals.append((score_new, \'drop\', (r, a), n_res_new))\n\n        # 3. SWAP MOVES (OPTIMIZE CONGRUENCE)\n        if congr_dict:\n            sampled_swaps = list(congr_dict.keys())\n            if len(sampled_swaps) > 30:\n                sampled_swaps = random.sample(sampled_swaps, 30)\n                \n            for r in sampled_swaps:\n                a_old = congr_dict[r]\n                cache_key = (id(targets), r)\n                t_mod = mod_cache.get(cache_key)\n                if t_mod is None:\n                    t_mod = targets % r\n                    mod_cache[cache_key] = t_mod\n                \n                is_covered = (t_mod == a_old)\n                cnt_bg = cnt_array - is_covered\n                uncovered_mask_bg = (cnt_bg == 0)\n                n_uncovered_bg = int(np.count_nonzero(uncovered_mask_bg))\n                \n                if n_uncovered_bg > 0:\n                    sub_arr = t_mod[uncovered_mask_bg]\n                    counts = np.bincount(sub_arr, minlength=r)\n                    best_a = int(np.argmax(counts))\n                    max_covered = counts[best_a]\n                else:\n                    best_a = 0\n                    max_covered = 0\n                \n                if best_a != a_old:\n                    n_res_new = n_uncovered_bg - max_covered\n                    score_new = get_score(n_res_new, logm, logboost)\n                    proposals.append((score_new, \'swap\', (r, best_a), n_res_new))\n\n        # 4. REPLACE MOVES (DROP ONE, ADD ONE)\n        if congr_dict and len(sampled_adds) > 0:\n            active_list = list(congr_dict.keys())\n            # Biased drop: prefer replacing larger moduli\n            drop_keys = [(random.random() ** (1.0 / r), r) for r in active_list]\n            drop_keys.sort(reverse=True)\n            sampled_drops = [r for _, r in drop_keys[:min(8, len(drop_keys))]]\n            \n            for r_old in sampled_drops:\n                a_old = congr_dict[r_old]\n                cache_key_old = (id(targets), r_old)\n                t_mod_old = mod_cache.get(cache_key_old)\n                if t_mod_old is None:\n                    t_mod_old = targets % r_old\n                    mod_cache[cache_key_old] = t_mod_old\n                \n                sampled_news = [m for m in sampled_adds[:3] if m != r_old]\n                \n                is_covered_old = (t_mod_old == a_old)\n                cnt_bg = cnt_array - is_covered_old\n                uncovered_mask_bg = (cnt_bg == 0)\n                n_uncovered_bg = int(np.count_nonzero(uncovered_mask_bg))\n                \n                for r_new in sampled_news:\n                    cache_key_new = (id(targets), r_new)\n                    t_mod_new = mod_cache.get(cache_key_new)\n                    if t_mod_new is None:\n                        t_mod_new = targets % r_new\n                        mod_cache[cache_key_new] = t_mod_new\n                    \n                    if n_uncovered_bg > 0:\n                        sub_arr = t_mod_new[uncovered_mask_bg]\n                        counts = np.bincount(sub_arr, minlength=r_new)\n                        best_a = int(np.argmax(counts))\n                        max_covered = counts[best_a]\n                    else:\n                        best_a = 0\n                        max_covered = 0\n                    \n                    n_res_new = n_uncovered_bg - max_covered\n                    lm_new = logm - log_cache[r_old][0] + log_cache[r_new][0]\n                    lb_new = logboost - log_cache[r_old][1] + log_cache[r_new][1]\n                    score_new = get_score(n_res_new, lm_new, lb_new)\n                    proposals.append((score_new, \'replace\', (r_old, a_old, r_new, best_a), n_res_new))\n\n        # Choose a proposal using Boltzmann distribution\n        scores = np.array([p[0] for p in proposals])\n        \n        # Softmax selection (minimizing score)\n        logits = -scores / temp\n        logits = logits - np.max(logits)  # Numerically stable\n        probs = np.exp(logits)\n        probs = probs / np.sum(probs)\n        \n        cum_probs = np.cumsum(probs)\n        chosen_idx = np.searchsorted(cum_probs, random.random())\n        chosen_idx = min(chosen_idx, len(proposals) - 1)\n        \n        chosen_score, move_type, move_args, n_res_new = proposals[chosen_idx]\n\n        # Apply the chosen move\n        if move_type == \'add\':\n            r, a = move_args\n            congr_dict[r] = a\n            cache_key = (id(targets), r)\n            t_mod = mod_cache[cache_key]\n            cnt_array += (t_mod == a)\n            logm += log_cache[r][0]\n            logboost += log_cache[r][1]\n            n_res = n_res_new\n            current_score = chosen_score\n        elif move_type == \'drop\':\n            r, a = move_args\n            del congr_dict[r]\n            cache_key = (id(targets), r)\n            t_mod = mod_cache[cache_key]\n            cnt_array -= (t_mod == a)\n            logm -= log_cache[r][0]\n            logboost -= log_cache[r][1]\n            n_res = n_res_new\n            current_score = chosen_score\n        elif move_type == \'swap\':\n            r, a = move_args\n            a_old = congr_dict[r]\n            cache_key = (id(targets), r)\n            t_mod = mod_cache[cache_key]\n            cnt_array -= (t_mod == a_old)\n            cnt_array += (t_mod == a)\n            congr_dict[r] = a\n            n_res = n_res_new\n            current_score = chosen_score\n        elif move_type == \'replace\':\n            r_old, a_old, r_new, a_new = move_args\n            # Remove old\n            del congr_dict[r_old]\n            cache_key_old = (id(targets), r_old)\n            t_mod_old = mod_cache[cache_key_old]\n            cnt_array -= (t_mod_old == a_old)\n            # Add new\n            congr_dict[r_new] = a_new\n            cache_key_new = (id(targets), r_new)\n            t_mod_new = mod_cache[cache_key_new]\n            cnt_array += (t_mod_new == a_new)\n            \n            logm += log_cache[r_new][0] - log_cache[r_old][0]\n            logboost += log_cache[r_new][1] - log_cache[r_old][1]\n            n_res = n_res_new\n            current_score = chosen_score\n\n    return congr_dict\n# EVOLVE-BLOCK-END\n\ndef evaluate(eval_inputs: Mapping[str, Any]) -> dict[str, float]:\n    """Run evaluation on the optimized step."""\n    # Let\'s say we maximize -n_digits_est (smaller estimated N-size)\n    # Using sympy/math to compute est digits\n    import sympy\n    import numpy as np\n    Q = 100003\n    targets = np.array(list(sympy.primerange(3, Q)), dtype=np.int64)\n    # Let\'s run the optimize_cover_step starting from empty cover for some iterations\n    congr_dict = {}\n    cand_mods = [int(r) for r in sympy.primerange(3, 8000)]\n    cnt_array = np.zeros(len(targets), dtype=np.int16)\n    logm = math.log(2)\n    logboost = math.log(2.0)\n    \n    for it in range(10):\n        t_temp = 0.8 * (0.02 / 0.8) ** (it / 10)\n        # Update cnt_array based on congr_dict\n        cnt_array = np.zeros(len(targets), dtype=np.int16)\n        logm = math.log(2)\n        logboost = math.log(2.0)\n        for r, a in congr_dict.items():\n            cnt_array += (targets % r) == a\n            logm += math.log(r)\n            logboost += math.log(r / (r - 1))\n            \n        congr_dict = optimize_cover_step(congr_dict, cand_mods, targets, cnt_array, logm, logboost, t_temp)\n        \n    # Recalculate final metrics\n    cnt_array = np.zeros(len(targets), dtype=np.int16)\n    logm = math.log(2)\n    logboost = math.log(2.0)\n   