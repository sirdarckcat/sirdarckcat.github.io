          cnt[rem == a_new] += 1\n            congr[r] = a_new\n\n    optimize_all(congr_dict, cnt_array)\n    n_res = int((cnt_array == 0).sum())\n    current_D = calc_D_val(n_res, logm, logboost)\n\n    temp = max(t_temp, 1e-6)\n    N_STEPS = 400\n\n    cand_pool_set = set(cand_mods) - set(congr_dict.keys())\n\n    for step in range(N_STEPS):\n        if step > 0 and step % 100 == 0:\n            optimize_all(congr_dict, cnt_array)\n            n_res = int((cnt_array == 0).sum())\n            current_D = calc_D_val(n_res, logm, logboost)\n\n        action = random.choices([\'add\', \'drop\', \'swap\', \'optimize\'], weights=[0.25, 0.25, 0.35, 0.15], k=1)[0]\n\n        if action == \'add\':\n            cand_pool = list(cand_pool_set)\n            if cand_pool:\n                sampled = random.sample(cand_pool, min(40, len(cand_pool)))\n                best_r, best_a, best_new_D, best_new_n_res = None, None, float(\'inf\'), n_res\n                uncovered = (cnt_array == 0)\n                \n                # Tensor-like broadcast calculation for coverage components\n                for r in sampled:\n                    rem = targets % r\n                    counts = np.bincount(rem, weights=uncovered, minlength=r)\n                    a = int(np.argmax(counts))\n                    \n                    added_cov = counts[a]\n                    new_n_res = n_res - added_cov\n                    new_logm = logm + math.log(r)\n                    new_logboost = logboost + math.log(r / (r - 1))\n                    new_D = calc_D_val(new_n_res, new_logm, new_logboost)\n                    if new_D < best_new_D:\n                        best_new_D = new_D\n                        best_r = r\n                        best_a = a\n                        best_new_n_res = new_n_res\n                        \n                if best_r is not None:\n                    delta = best_new_D - current_D\n                    if delta < 0 or random.random() < math.exp(-delta / temp):\n                        congr_dict[best_r] = best_a\n                        cand_pool_set.remove(best_r)\n                        cnt_array[targets % best_r == best_a] += 1\n                        n_res = best_new_n_res\n                        logm += math.log(best_r)\n                        logboost += math.log(best_r / (best_r - 1))\n                        current_D = best_new_D\n\n        elif action == \'drop\':\n            active = list(congr_dict.keys())\n            if active:\n                sampled = random.sample(active, min(40, len(active)))\n                best_r, best_new_D, best_new_n_res = None, float(\'inf\'), n_res\n                singly_covered = (cnt_array == 1)\n                \n                for r in sampled:\n                    a = congr_dict[r]\n                    rem = targets % r\n                    lost_cov = np.sum(singly_covered & (rem == a))\n                    new_n_res = n_res + lost_cov\n                    new_logm = logm - math.log(r)\n                    new_logboost = logboost - math.log(r / (r - 1))\n                    new_D = calc_D_val(new_n_res, new_logm, new_logboost)\n                    if new_D < best_new_D:\n                        best_new_D = new_D\n                        best_r = r\n                        best_new_n_res = new_n_res\n\n                if best_r is not None:\n                    delta = best_new_D - current_D\n                    if delta < 0 or random.random() < math.exp(-delta / temp):\n                        r_drop = best_r\n                        a_drop = congr_dict[r_drop]\n                        cnt_array[targets % r_drop == a_drop] -= 1\n                        del congr_dict[r_drop]\n                        cand_pool_set.add(r_drop)\n                        n_res = best_new_n_res\n                        logm -= math.log(r_drop)\n                        logboost -= math.log(r_drop / (r_drop - 1))\n                        current_D = best_new_D\n\n        elif actio