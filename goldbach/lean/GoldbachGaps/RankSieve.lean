/-- **Goldbach below `2^25`, with the least summand.** Every even `N` with `6 ≤ N < 2^25` is
the sum of two primes, the smaller of which is at most `997`. -/
theorem exists_summand_le {N : ℕ} (hE : Even N) (h6 : 6 ≤ N) (hX : N < 2 ^ 25) :
    ∃ q, q ≤ 997 ∧ IsSummand N q :=
  summand_of_chain recChain_isChain recChain_holds recChain_shape h6 hX hE.two_dvd

/-- **The record holders below `2^25` are exactly the 26 numbers of the table.** An even
`N` with `6 ≤ N < 2^25` has a least Goldbach summand larger than that of every smaller even
number from `6` on if and only if it is one of
`6, 12, 30, 98, 220, 308, 556, 992, 2642, 5372, 7426, 43532, 54244, 63274, 113672, 128168, 194428, 194470, 413572, 503222, 1077422, 3526958, 3807404, 10759922, 24106882, 27789878`. -/
theorem isRecordHolder_iff {N : ℕ} (hE : Even N) (h6 : 6 ≤ N) (hX : N < 2 ^ 25) :
    IsRecordHolder N ↔ N ∈ records25.map Prod.fst := by
  constructor
  · exact mem_of_isRecordHolder recChain_isChain recChain_holds recChain_link records25_spec
      recChain_table hE h6 hX
  · intro h
    obtain ⟨x, hx, rfl⟩ := List.mem_map.mp h
    exact isRecordHolder_of_mem recChain_isChain recChain_holds recChain_link records25_spec
      recChain_table x hx

