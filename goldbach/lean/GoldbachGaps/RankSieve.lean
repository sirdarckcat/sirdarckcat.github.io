theorem primes5800_eq : sievePrimesBelow 5800 = primes5800 := by decide +kernel

theorem mem_primes5800 {p : ℕ} : p ∈ primes5800 ↔ p.Prime ∧ p < 5800 := by
  rw [← primes5800_eq]
  exact mem_sievePrimesBelow (by norm_num)

theorem mem_ds {D : ℕ} (hD : D ≤ 5800) :
    ∀ p, p.Prime → p < D → p ∈ primes5800.filter (· < D) := by
  intro p hp hlt
  rw [List.mem_filter, decide_eq_true_eq]
  exact ⟨mem_primes5800.mpr ⟨hp, by omega⟩, hlt⟩

theorem prime_of_mem_qs : ∀ q ∈ primes5800.filter (· < 1000), q.Prime := fun _ hq =>
  (mem_primes5800.mp (List.mem_of_mem_filter hq)).1

