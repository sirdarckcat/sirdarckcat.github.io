/-- **No multiple of `6` between `1362` and `2^25` enters the ten largest.** For every `N`
divisible by `6` with `1362 < N < 2^25`, ten smaller even numbers have a least Goldbach summand at
least as large as that of `N`. (`1362` itself does enter the ten largest, by the scan.) -/
theorem notAmongTen_of_dvd_6 {N : ℕ} (hm : 6 ∣ N) (hlo : 1362 < N) (hX : N < 2 ^ 25) :
    NotAmongTen N := by
  have h1 : 1368 ≤ N := by
    obtain ⟨k, rfl⟩ := hm
    omega
  exact notAmongTen_of_chain top6_isChain top6_holds top6_shape RankData.witnessTable_spec
    top6_ten h1 hX hm

