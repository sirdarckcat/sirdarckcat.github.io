import GoldbachGaps.Gpu28.Conv

/-!
# One step of the `fermat28` GPU kernel

`fm28_step(x, n, np, b)` of `goldbach/fermat661/cuda/fermat28_step_s1.cuh` (generated by
`gen_fermat28.py`, commit `560a2cf`, branch `ccr-b8c25887-i6tn9f`) is a Montgomery squaring
by columns on `L = 24` limbs of 28 bits, followed by a multiplication by `2^b`:

    column k < L   : acc = c + Σ_{i < k-i} (2 x_i) x_{k-i} + [k even] x_{k/2}² + Σ_{i < k} m_i n_{k-i}
                     m_k = ((u32)acc * np) & MASK28 ;  acc += m_k n_0 ;  c = acc >> 28
    column k ≥ L   : the same sums over the indices that exist ;  y_{k-L} = (u32)acc & MASK28 ;  c = acc >> 28
    y_{L-1} = (u32)c ;  then  v = (y_i << b) + cy ;  x_i = v & MASK28 ;  cy = v >> 28

The model below follows the generator: the same lists of products per column in the same
order (`sqTerms`, `redTerms`), accumulated by wrapping 64-bit multiply-adds (`madFold`). The
variants with 2 or 4 accumulators per column add the same products in another grouping;
wrapping addition is commutative, so they compute the same `acc` and the theorem applies to
them as well.

`pre_spec` (with `B = 2^28`, `R = B^L`, `X`, `N` the values of `x`, `n`): if the limbs of `x`
are below `2^29`, those of `n` below `B`, `X < 4N`, `16 N < R`, `n_0 · np ≡ -1 (mod B)` and
`L ≤ 24`, then the limbs `y_i` are below `B` and their value `Y` satisfies `R · Y = X² + μ N`
for some `μ < R`, with `Y < 2N`. No accumulator wraps on the way (`colAcc_eq`: every column
sum is below `2^63`).

Two endings of the step follow from it, for `b ≤ 1`:

* `step_spec`, the carry chain above (`stepF`): output limbs below `B`, `R · Y' = 2^b (X² + μ N)`,
  `Y' < 4N`.
* `stepR_spec`, the redundant step of `fermat28_step_s1r.cuh`, `_r.cuh`, `_s1rw.cuh` (commit
  `fa7d9d1`), which ends with `x_i = y_i << b` and no carry chain (`stepR`): output limbs below
  `2^29`, the same relation and `Y' < 4N`. So "limbs below `2^29`, value below `4N`" is an
  invariant of the loop.

The files with `FM28_MADN` (`mul.wide.u32`) or `FM28_ASM` (`mad.wide.u32`) write the same
products with PTX instructions; the model takes those at their documented meaning, the exact
32 × 32 → 64 bit product and multiply-add.
-/

namespace Gpu28

open Finset

local notation "B" => (2 ^ 28 : ℕ)

/-! ### The machine model -/

/-- A chain of `FM28_MAD(acc, a, b)`: `acc += (u64)a * b` with 64-bit wrapping. -/
def madFold (acc : ℕ) (terms : List (ℕ × ℕ)) : ℕ :=
  terms.foldl (fun a p => (a + p.1 * p.2 % 2 ^ 64) % 2 ^ 64) acc

/-- The squaring products of column `k`, as the generator lists them: `(d_i, x_{k-i})` with
`d_i = x_i << 1` for `i < k - i < L`, then the diagonal `(x_{k/2}, x_{k/2})` for even `k`. -/
def sqTerms (x : ℕ → ℕ) (L k : ℕ) : List (ℕ × ℕ) :=
  ((List.range (k + 1)).filter fun i => decide (i < k - i ∧ k - i < L)).map
      (fun i => ((x i <<< 1) % 2 ^ 32, x (k - i))) ++
    if k % 2 = 0 ∧ k / 2 < L then [(x (k / 2), x (k / 2))] else []

/-- The reduction products of column `k`: `(m_i, n_{k-i})` for the indices that exist, without
`i = k` in a lower column (`m_k n_0` is added after `m_k` has been computed). -/
def redTerms (m n : ℕ → ℕ) (L k : ℕ) : List (ℕ × ℕ) :=
  ((List.range (k + 1)).filter fun i => decide (i < L ∧ k - i < L ∧ (k < L → i < k))).map
    fun i => (m i, n (k - i))

/-- The accumulator of column `k` after its products, starting from the carry `c`. -/
def colAcc (x n m : ℕ → ℕ) (L k c : ℕ) : ℕ := madFold c (sqTerms x L k ++ redTerms m n L k)

/-- `((u32)a0 * np) & MASK28`. -/
def mulLo (a0 np : ℕ) : ℕ := ((a0 % 2 ^ 32) * np % 2 ^ 32) &&& 268435455

/-- A lower column: state `(c, m)` before, `(c, m)` after. -/
def lowStep (x n : ℕ → ℕ) (np L k : ℕ) (st : ℕ × (ℕ → ℕ)) : ℕ × (ℕ → ℕ) :=
  (((colAcc x n st.2 L k st.1 + mulLo (colAcc x n st.2 L k st.1) np * n 0 % 2 ^ 64) % 2 ^ 64) >>> 28,
    Function.update st.2 k (mulLo (colAcc x n st.2 L k st.1) np))

/-- The state after the lower columns `0 .. k-1`. -/
def lower (x n : ℕ → ℕ) (np L : ℕ) : ℕ → ℕ × (ℕ → ℕ)
  | 0 => (0, fun _ => 0)
  | k + 1 => lowStep x n np L k (lower x n np L k)

/-- An upper column `k ≥ L`: state `(c, y)` before and after. -/
def upStep (x n m : ℕ → ℕ) (L k : ℕ) (st : ℕ × (ℕ → ℕ)) : ℕ × (ℕ → ℕ) :=
  (colAcc x n m L k st.1 >>> 28,
    Function.update st.2 (k - L) ((colAcc x n m L k st.1 % 2 ^ 32) &&& 268435455))

/-- The state after the upper columns `L .. L+j-1`, starting from the carry `c0`. -/
def upper (x n m : ℕ → ℕ) (L c0 : ℕ) : ℕ → ℕ × (ℕ → ℕ)
  | 0 => (c0, fun _ => 0)
  | j + 1 => upStep x n m L (L + j) (upper x n m L c0 j)

/-- The limbs `y_0 .. y_{L-1}` before the shift: columns `L .. 2L-2`, then `y_{L-1} = (u32)c`. -/
def preLimbs (x n : ℕ → ℕ) (np L : ℕ) : ℕ → ℕ :=
  Function.update (upper x n (lower x n np L L).2 L (lower x n np L L).1 (L - 1)).2 (L - 1)
    ((upper x n (lower x n np L L).2 L (lower x n np L L).1 (L - 1)).1 % 2 ^ 32)

/-- The carry into limb `i` of the final chain `v = (y_i << b) + cy; cy = v >> 28`. -/
def cyAt (y : ℕ → ℕ) (b : ℕ) : ℕ → ℕ
  | 0 => 0
  | i + 1 => (((y i <<< b) % 2 ^ 32 + cyAt y b i) % 2 ^ 32) >>> 28

/-- Limb `i` written by the final chain: `v & MASK28`. -/
def chainLimb (y : ℕ → ℕ) (b i : ℕ) : ℕ :=
  (((y i <<< b) % 2 ^ 32 + cyAt y b i) % 2 ^ 32) &&& 268435455

/-- **The step**: limb `i` of the output of `fm28_step`. -/
def stepF (x n : ℕ → ℕ) (np b L : ℕ) (i : ℕ) : ℕ := chainLimb (preLimbs x n np L) b i

/-! ### Exactness of the accumulators -/

/-- The sum of the products of a list of pairs. -/
def prodSum (terms : List (ℕ × ℕ)) : ℕ := (terms.map fun p => p.1 * p.2).sum

theorem prodSum_append (l₁ l₂ : List (ℕ × ℕ)) : prodSum (l₁ ++ l₂) = prodSum l₁ + prodSum l₂ := by
  simp [prodSum]

theorem madFold_eq : ∀ (terms : List (ℕ × ℕ)) (acc : ℕ), acc + prodSum terms < 2 ^ 64 →
    madFold acc terms = acc + prodSum terms
  | [], acc, _ => by simp [madFold, prodSum]
  | p :: ps, acc, h => by
    have hp : prodSum (p :: ps) = p.1 * p.2 + prodSum ps := by simp [prodSum]
    rw [hp] at h ⊢
    have h1 : (acc + p.1 * p.2 % 2 ^ 64) % 2 ^ 64 = acc + p.1 * p.2 := by
      generalize p.1 * p.2 = q at h ⊢
      omega
    show madFold ((acc + p.1 * p.2 % 2 ^ 64) % 2 ^ 64) ps = _
    rw [h1, madFold_eq ps _ (by omega)]
    omega

theorem and_mask (a : ℕ) : a &&& 268435455 = a % B := by
  rw [show (268435455 : ℕ) = 2 ^ 28 - 1 by norm_num, Nat.and_two_pow_sub_one_eq_mod]

theorem mulLo_eq (a0 np : ℕ) : mulLo a0 np = (a0 * np) % B := by
  unfold mulLo
  rw [and_mask, Nat.mod_mod_of_dvd _ (by norm_num : (2 ^ 28 : ℕ) ∣ 2 ^ 32), Nat.mul_mod,
    Nat.mod_mod_of_dvd _ (by norm_num : (2 ^ 28 : ℕ) ∣ 2 ^ 32), ← Nat.mul_mod]

/-- The reduction sum of column `k` as the machine forms it. -/
def redSum (m n : ℕ → ℕ) (L k : ℕ) : ℕ :=
  ∑ i ∈ range (k + 1), if i < L ∧ k - i < L ∧ (k < L → i < k) then m i * n (k - i) else 0

theorem prodSum_redTerms (m n : ℕ → ℕ) (L k : ℕ) : prodSum (redTerms m n L k) = redSum m n L k := by
  unfold prodSum redTerms redSum
  rw [List.map_map, sum_map_filter_range]
  refine Finset.sum_congr rfl fun i _ => ?_
  simp only [decide_eq_true_eq, Function.comp]

theorem prodSum_sqTerms {x : ℕ → ℕ} (hx : ∀ i, x i < 2 * B) (L k : ℕ) :
    prodSum (sqTerms x L k) = conv x x L k := by
  unfold sqTerms
  rw [prodSum_append, conv_self]
  congr 1
  · unfold prodSum
    rw [List.map_map, sum_map_filter_range]
    refine Finset.sum_congr rfl fun i _ => ?_
    have hxi := hx i
    have e : (x i <<< 1) % 2 ^ 32 = 2 * x i := by
      rw [Nat.shiftLeft_eq]
      omega
    simp only [decide_eq_true_eq, Function.comp, e]
  · split_ifs <;> simp [prodSum]

theorem redSum_of_le {m n : ℕ → ℕ} {L k : ℕ} (hk : L ≤ k) : redSum m n L k = conv m n L k := by
  unfold redSum conv
  refine Finset.sum_congr rfl fun i _ => ?_
  have : ¬ k < L := by omega
  simp [this]

theorem redSum_add {m n : ℕ → ℕ} {L k : ℕ} (hk : k < L) :
    redSum m n L k + m k * n 0 = conv m n L k := by
  unfold redSum conv
  rw [Finset.sum_range_succ, Finset.sum_range_succ]
  have h1 : (∑ i ∈ range k, if i < L ∧ k - i < L ∧ (k < L → i < k) then m i * n (k - i) else 0) =
      ∑ i ∈ range k, if i < L ∧ k - i < L then m i * n (k - i) else 0 := by
    refine Finset.sum_congr rfl fun i hi => ?_
    have := Finset.mem_range.mp hi
    simp [this]
  have h2 : ¬ (k < L ∧ k - k < L ∧ (k < L → k < k)) := by omega
  have h3 : k < L ∧ k - k < L := by omega
  rw [h1, ite_eq_right_of_eq_false _ _ (eq_false h2), ite_eq_left_of_eq_true _ _ (eq_true h3), Nat.sub_self]
  omega

theorem redSum_le_conv (m n : ℕ → ℕ) (L k : ℕ) : redSum m n L k ≤ conv m n L k := by
  unfold redSum conv
  refine Finset.sum_le_sum fun i _ => ?_
  split_ifs with ha hb
  · exact le_refl _
  · exact absurd ⟨ha.1, ha.2.1⟩ hb
  · exact Nat.zero_le _
  · exact le_refl _

theorem conv_update_of_lt (m n : ℕ → ℕ) (L : ℕ) {j k : ℕ} (v : ℕ) (h : j < k) :
    conv (Function.update m k v) n L j = conv m n L j := by
  unfold conv
  refine Finset.sum_congr rfl fun i hi => ?_
  have := Finset.mem_range.mp hi
  rw [Function.update_of_ne (by omega)]

theorem redSum_update (m n : ℕ → ℕ) {L k : ℕ} (v : ℕ) (hk : k < L) :
    redSum (Function.update m k v) n L k = redSum m n L k := by
  unfold redSum
  refine Finset.sum_congr rfl fun i _ => ?_
  by_cases hik : i = k
  · subst hik
    have : ¬ (i < L ∧ i - i < L ∧ (i < L → i < i)) := by omega
    simp only [this, ↓reduceIte]
  · rw [Function.update_of_ne hik]

theorem conv_update_self (m n : ℕ → ℕ) {L k : ℕ} (v : ℕ) (hk : k < L) :
    conv (Function.update m k v) n L k = redSum m n L k + v * n 0 := by
  rw [← redSum_add (m := Function.update m k v) hk, redSum_update m n v hk, Function.update_self]

/-- **No accumulator wraps (C3).** With limbs of `x` below `2^29` (below `2^28` in the plain
step, below `2^29` in the redundant one), limbs of `n` and `m` below `2^28`, at most 24 limbs
and a carry below `2^36`, the accumulator of a column is the exact sum, and the two sums are
at most `120 · 2^56 < 2^63`. -/
theorem colAcc_eq {x n m : ℕ → ℕ} {L c : ℕ} (hL : L ≤ 24) (hx : ∀ i, x i < 2 * B)
    (hn : ∀ i, n i < B) (hm : ∀ i, m i < B) (hc : c < 2 ^ 36) (k : ℕ) :
    colAcc x n m L k c = c + conv x x L k + redSum m n L k ∧
      conv x x L k + redSum m n L k ≤ 120 * 2 ^ 56 := by
  have hb1 : conv x x L k ≤ L * (2 * B * (2 * B)) :=
    conv_le (fun i j => Nat.mul_le_mul (hx i).le (hx j).le) L k
  have hb2 : conv m n L k ≤ L * (B * B) :=
    conv_le (fun i j => Nat.mul_le_mul (hm i).le (hn j).le) L k
  have hb3 := redSum_le_conv m n L k
  have hb4 : L * (2 * B * (2 * B)) ≤ 96 * 2 ^ 56 := by
    have := Nat.mul_le_mul_right (2 * B * (2 * B)) hL
    omega
  have hb5 : L * (B * B) ≤ 24 * 2 ^ 56 := by
    have := Nat.mul_le_mul_right (B * B) hL
    omega
  have hbound : conv x x L k + redSum m n L k ≤ 120 * 2 ^ 56 := by omega
  refine ⟨?_, hbound⟩
  unfold colAcc
  rw [madFold_eq, prodSum_append, prodSum_sqTerms hx, prodSum_redTerms]
  · omega
  · rw [prodSum_append, prodSum_sqTerms hx, prodSum_redTerms]
    omega

/-! ### The invariant of the columns -/

/-- The columns `0 .. k-1` of `X² + μ N`, weighted. -/
def Ssum (x n m : ℕ → ℕ) (L k : ℕ) : ℕ := ∑ j ∈ range k, (conv x x L j + conv m n L j) * B ^ j

theorem Ssum_succ (x n m : ℕ → ℕ) (L k : ℕ) :
    Ssum x n m L (k + 1) = Ssum x n m L k + (conv x x L k + conv m n L k) * B ^ k :=
  Finset.sum_range_succ _ _

theorem Ssum_update (x n m : ℕ → ℕ) (L : ℕ) {j k : ℕ} (v : ℕ) (h : k ≤ j) :
    Ssum x n (Function.update m j v) L k = Ssum x n m L k := by
  unfold Ssum
  refine Finset.sum_congr rfl fun i hi => ?_
  have := Finset.mem_range.mp hi
  rw [conv_update_of_lt m n L v (by omega)]

/-- **The lower columns.** After columns `0 .. k-1` (`k ≤ L`): the carry is below `2^36`, the
multipliers are below `2^28`, and `c · B^k` is exactly the sum of those columns: every lower
column leaves its low 28 bits zero (C1). -/
theorem lower_inv {x n : ℕ → ℕ} {np L : ℕ} (hL : L ≤ 24) (hx : ∀ i, x i < 2 * B)
    (hn : ∀ i, n i < B)
    (hinv : (n 0 * np + 1) % B = 0) : ∀ k, k ≤ L →
    (lower x n np L k).1 < 2 ^ 36 ∧ (∀ i, (lower x n np L k).2 i < B) ∧
      (lower x n np L k).1 * B ^ k = Ssum x n (lower x n np L k).2 L k
  | 0, _ => by
    refine ⟨by simp [lower], fun i => by simp [lower], by simp [lower, Ssum]⟩
  | k + 1, hk => by
    obtain ⟨hc, hm, hS⟩ := lower_inv hL hx hn hinv k (by omega)
    obtain ⟨ha, hbound⟩ := colAcc_eq hL hx hn hm hc k
    show (lowStep x n np L k (lower x n np L k)).1 < 2 ^ 36 ∧
      (∀ i, (lowStep x n np L k (lower x n np L k)).2 i < B) ∧
      (lowStep x n np L k (lower x n np L k)).1 * B ^ (k + 1) =
        Ssum x n (lowStep x n np L k (lower x n np L k)).2 L (k + 1)
    unfold lowStep
    simp only []
    generalize hst : lower x n np L k = st at hc hm hS ha hbound ⊢
    obtain ⟨c, m⟩ := st
    simp only [] at hc hm hS ha hbound ⊢
    rw [ha, mulLo_eq]
    set a0 := c + conv x x L k + redSum m n L k with ha0
    set mk := (a0 * np) % B with hmk
    have hmklt : mk < B := Nat.mod_lt _ (by norm_num)
    have hn0 := hn 0
    have hprod : mk * n 0 ≤ B * B := Nat.mul_le_mul hmklt.le hn0.le
    have hwrap : (a0 + mk * n 0 % 2 ^ 64) % 2 ^ 64 = a0 + mk * n 0 := by
      generalize mk * n 0 = q at hprod ⊢
      omega
    have hzero : (a0 + mk * n 0) % B = 0 := by
      have e1 : (a0 + mk * n 0) % B = (a0 + a0 * np * n 0) % B := by
        rw [hmk]
        conv_lhs => rw [Nat.add_mod, Nat.mul_mod, Nat.mod_mod, ← Nat.mul_mod, ← Nat.add_mod]
      have e2 : a0 + a0 * np * n 0 = a0 * (n 0 * np + 1) := by ring
      rw [e1, e2, Nat.mul_mod, hinv, mul_zero, Nat.zero_mod]
    rw [hwrap, Nat.shiftRight_eq_div_pow]
    refine ⟨?_, ?_, ?_⟩
    · generalize mk * n 0 = q at hprod ⊢
      omega
    · intro i
      by_cases hik : i = k
      · subst hik
        rw [Function.update_self]
        exact hmklt
      · rw [Function.update_of_ne hik]
        exact hm i
    · rw [Ssum_succ, Ssum_update x n m L mk (le_refl k), ← hS, conv_update_self m n mk (by omega)]
      have hdiv : (a0 + mk * n 0) / B * B = a0 + mk * n 0 := Nat.div_mul_cancel
        (Nat.dvd_of_mod_eq_zero hzero)
      have e : (a0 + mk * n 0) / B * B ^ (k + 1) = (a0 + mk * n 0) / B * B * B ^ k := by
        rw [pow_succ (2 ^ 28) k]
        ring
      rw [e, hdiv, ha0]
      ring

/-- **The upper columns.** After columns `L .. L+j-1`: the limbs written so far are below
`2^28` and `c · B^(L+j) + B^L · (y_0 + … + y_{j-1} B^(j-1))` is the sum of all columns so
far. -/
theorem upper_inv {x n m : ℕ → ℕ} {L c0 : ℕ} (hL : L ≤ 24) (hx : ∀ i, x i < 2 * B)
    (hn : ∀ i, n i < B)
    (hm : ∀ i, m i < B) (hc0 : c0 < 2 ^ 36) (hS0 : c0 * B ^ L = Ssum x n m L L) : ∀ j,
    (upper x n m L c0 j).1 < 2 ^ 36 ∧ (∀ i, (upper x n m L c0 j).2 i < B) ∧
      (upper x n m L c0 j).1 * B ^ (L + j) + B ^ L * V B j (upper x n m L c0 j).2 =
        Ssum x n m L (L + j)
  | 0 => by
    refine ⟨hc0, fun i => by simp [upper], ?_⟩
    simp only [upper, V, Finset.range_zero, Finset.sum_empty, mul_zero, add_zero]
    exact hS0
  | j + 1 => by
    obtain ⟨hc, hy, hS⟩ := upper_inv hL hx hn hm hc0 hS0 j
    obtain ⟨ha, hbound⟩ := colAcc_eq hL hx hn hm hc (L + j)
    show (upStep x n m L (L + j) (upper x n m L c0 j)).1 < 2 ^ 36 ∧
      (∀ i, (upStep x n m L (L + j) (upper x n m L c0 j)).2 i < B) ∧
      (upStep x n m L (L + j) (upper x n m L c0 j)).1 * B ^ (L + (j + 1)) +
          B ^ L * V B (j + 1) (upStep x n m L (L + j) (upper x n m L c0 j)).2 =
        Ssum x n m L (L + (j + 1))
    unfold upStep
    simp only []
    generalize hst : upper x n m L c0 j = st at hc hy hS ha hbound ⊢
    obtain ⟨c, y⟩ := st
    simp only [] at hc hy hS ha hbound ⊢
    rw [ha, redSum_of_le (Nat.le_add_right L j)] at *
    set a0 := c + conv x x L (L + j) + conv m n L (L + j) with ha0
    have hsub : L + j - L = j := by omega
    rw [hsub, and_mask, Nat.mod_mod_of_dvd _ (by norm_num : (2 ^ 28 : ℕ) ∣ 2 ^ 32),
      Nat.shiftRight_eq_div_pow]
    refine ⟨by omega, ?_, ?_⟩
    · intro i
      by_cases hij : i = j
      · subst hij
        rw [Function.update_self]
        exact Nat.mod_lt _ (by norm_num)
      · rw [Function.update_of_ne hij]
        exact hy i
    · have hV : V B (j + 1) (Function.update y j (a0 % B)) = V B j y + a0 % B * B ^ j := by
        rw [V_succ, Function.update_self]
        congr 1
        exact V_congr fun i hi => Function.update_of_ne (by omega) _ _
      have hadd : L + (j + 1) = L + j + 1 := rfl
      rw [hV, hadd, Ssum_succ, ← hS]
      have e1 : a0 / B * B ^ (L + j + 1) = a0 / B * B * B ^ (L + j) := by
        rw [pow_succ (2 ^ 28) (L + j)]
        ring
      have e2 : B ^ L * (V B j y + a0 % B * B ^ j) = B ^ L * V B j y + a0 % B * B ^ (L + j) := by
        rw [pow_add (2 ^ 28) L j]
        ring
      have e3 : a0 / B * B * B ^ (L + j) + a0 % B * B ^ (L + j) = a0 * B ^ (L + j) := by
        rw [← add_mul, Nat.div_add_mod' a0 B]
      rw [e1, e2]
      have e4 : (conv x x L (L + j) + conv m n L (L + j)) * B ^ (L + j) + c * B ^ (L + j) =
          a0 * B ^ (L + j) := by
        rw [ha0]
        ring
      generalize a0 / B * B * B ^ (L + j) = t1 at e3 ⊢
      generalize a0 % B * B ^ (L + j) = t2 at e3 ⊢
      generalize a0 * B ^ (L + j) = t3 at e3 e4
      generalize (conv x x L (L + j) + conv m n L (L + j)) * B ^ (L + j) = t4 at e4 ⊢
      generalize c * B ^ (L + j) = t5 at e4 ⊢
      omega

/-! ### The final carry chain and the step -/

/-- **The carry chain multiplies by `2^b`**: after `i` limbs, the limbs written plus the
carry are `2^b` times the limbs read, and the carry is `0` or `1`. -/
theorem chain_spec {y : ℕ → ℕ} {b : ℕ} (hy : ∀ i, y i < B) (hb : b ≤ 1) : ∀ i,
    cyAt y b i ≤ 1 ∧ V B i (chainLimb y b) + cyAt y b i * B ^ i = 2 ^ b * V B i y
  | 0 => by simp [cyAt, V]
  | i + 1 => by
    obtain ⟨hcy, hV⟩ := chain_spec hy hb i
    have hyi := hy i
    have hv : ((y i <<< b) % 2 ^ 32 + cyAt y b i) % 2 ^ 32 = 2 ^ b * y i + cyAt y b i := by
      rw [Nat.shiftLeft_eq]
      interval_cases b <;> omega
    have hlimb : chainLimb y b i = (2 ^ b * y i + cyAt y b i) % B := by
      unfold chainLimb
      rw [hv, and_mask]
    have hcy' : cyAt y b (i + 1) = (2 ^ b * y i + cyAt y b i) / B := by
      show (((y i <<< b) % 2 ^ 32 + cyAt y b i) % 2 ^ 32) >>> 28 = _
      rw [hv, Nat.shiftRight_eq_div_pow]
    refine ⟨?_, ?_⟩
    · rw [hcy']
      interval_cases b <;> omega
    · rw [V_succ, V_succ, hlimb, hcy', pow_succ (2 ^ 28) i]
      generalize hw : 2 ^ b * y i + cyAt y b i = w
      have e1 : w % B * B ^ i + w / B * (B ^ i * B) = w * B ^ i := by
        have := Nat.mod_add_div w B
        calc w % B * B ^ i + w / B * (B ^ i * B) = (w % B + B * (w / B)) * B ^ i := by ring
          _ = w * B ^ i := by rw [this]
      have e2 : w * B ^ i = 2 ^ b * (y i * B ^ i) + cyAt y b i * B ^ i := by
        rw [← hw]
        ring
      rw [mul_add]
      generalize w % B * B ^ i = t1 at e1 ⊢
      generalize w / B * (B ^ i * B) = t2 at e1 ⊢
      generalize w * B ^ i = t3 at e1 e2
      generalize 2 ^ b * (y i * B ^ i) = t4 at e2 ⊢
      generalize cyAt y b i * B ^ i = t5 at e2 hV
      generalize 2 ^ b * V B i y = t6 at hV ⊢
      omega

/-- The carry chain for wider limbs: if `y_i · 2^b < 2^31` for every limb, the limbs written
plus the carry are `2^b` times the limbs read, and the carry is at most 8. With `b = 0` and
limbs below `2^29` this is the normalisation block of the redundant kernel. -/
theorem chain_spec' {y : ℕ → ℕ} {b : ℕ} (hy : ∀ i, y i * 2 ^ b < 2 ^ 31) : ∀ i,
    cyAt y b i ≤ 8 ∧ V B i (chainLimb y b) + cyAt y b i * B ^ i = 2 ^ b * V B i y
  | 0 => by simp [cyAt, V]
  | i + 1 => by
    obtain ⟨hcy, hV⟩ := chain_spec' hy i
    have hyi := hy i
    have hv : ((y i <<< b) % 2 ^ 32 + cyAt y b i) % 2 ^ 32 = 2 ^ b * y i + cyAt y b i := by
      rw [Nat.shiftLeft_eq, mul_comm (2 ^ b) (y i)]
      generalize y i * 2 ^ b = w at hyi ⊢
      omega
    have hlimb : chainLimb y b i = (2 ^ b * y i + cyAt y b i) % B := by
      unfold chainLimb
      rw [hv, and_mask]
    have hcy' : cyAt y b (i + 1) = (2 ^ b * y i + cyAt y b i) / B := by
      show (((y i <<< b) % 2 ^ 32 + cyAt y b i) % 2 ^ 32) >>> 28 = _
      rw [hv, Nat.shiftRight_eq_div_pow]
    refine ⟨?_, ?_⟩
    · rw [hcy', mul_comm (2 ^ b) (y i)]
      generalize y i * 2 ^ b = w at hyi ⊢
      omega
    · rw [V_succ, V_succ, hlimb, hcy', pow_succ (2 ^ 28) i]
      generalize hw : 2 ^ b * y i + cyAt y b i = w
      have e1 : w % B * B ^ i + w / B * (B ^ i * B) = w * B ^ i := by
        have := Nat.mod_add_div w B
        calc w % B * B ^ i + w / B * (B ^ i * B) = (w % B + B * (w / B)) * B ^ i := by ring
          _ = w * B ^ i := by rw [this]
      have e2 : w * B ^ i = 2 ^ b * (y i * B ^ i) + cyAt y b i * B ^ i := by
        rw [← hw]
        ring
      rw [mul_add]
      generalize w % B * B ^ i = t1 at e1 ⊢
      generalize w / B * (B ^ i * B) = t2 at e1 ⊢
      generalize w * B ^ i = t3 at e1 e2
      generalize 2 ^ b * (y i * B ^ i) = t4 at e2 ⊢
      generalize cyAt y b i * B ^ i = t5 at e2 hV
      generalize 2 ^ b * V B i y = t6 at hV ⊢
      omega

/-- **The limbs before the final shift (C1, C2, C3).** Let `x` be an array of `L ≤ 24` limbs
below `2^29` and `n` one of limbs below `2^28`, with values `X < 4N` and `16 N < R = 2^(28 L)`,
and let `n_0 · np ≡ -1 (mod 2^28)`. Then the limbs `y_0 .. y_{L-1}` computed by the columns
are below `2^28`, and their value `Y` satisfies `R · Y = X² + μ N` for some `μ < R`, and
`Y < 2N`. -/
theorem pre_spec {x n : ℕ → ℕ} {np L : ℕ} (hL1 : 1 ≤ L) (hL : L ≤ 24) (hx : ∀ i, x i < 2 * B)
    (hn : ∀ i, n i < B) (hinv : (n 0 * np + 1) % B = 0) (hX : V B L x < 4 * V B L n)
    (hN : 16 * V B L n < B ^ L) :
    (∀ i, preLimbs x n np L i < B) ∧
      (∃ μ, μ < B ^ L ∧
        B ^ L * V B L (preLimbs x n np L) = V B L x * V B L x + μ * V B L n) ∧
      V B L (preLimbs x n np L) < 2 * V B L n := by
  obtain ⟨hc0, hm, hS0⟩ := lower_inv hL hx hn hinv L le_rfl
  obtain ⟨hc, hy, hS⟩ := upper_inv hL hx hn hm hc0 hS0 (L - 1)
  have hpre : preLimbs x n np L = Function.update
      (upper x n (lower x n np L L).2 L (lower x n np L L).1 (L - 1)).2 (L - 1)
      ((upper x n (lower x n np L L).2 L (lower x n np L L).1 (L - 1)).1 % 2 ^ 32) := rfl
  generalize (lower x n np L L).2 = m at hm hS0 hc hy hS hpre
  generalize (lower x n np L L).1 = c0 at hc0 hS0 hc hy hS hpre
  generalize hupper : upper x n m L c0 (L - 1) = st at hc hy hS hpre
  obtain ⟨c, y⟩ := st
  simp only [] at hc hy hS hpre
  -- all columns together
  have hLL : L + (L - 1) = 2 * L - 1 := by omega
  have htot : Ssum x n m L (2 * L - 1) = V B L x * V B L x + V B L m * V B L n := by
    unfold Ssum
    simp only [add_mul]
    rw [Finset.sum_add_distrib, sum_conv, sum_conv]
  rw [hLL, htot] at hS
  have hμ : V B L m < B ^ L := V_lt L fun i _ => hm i
  generalize V B L m = μ at hS hμ
  generalize hXv : V B L x = X at hX hS
  generalize hNv : V B L n = N at hX hN hS
  have hNpos : 0 < N := by omega
  have hpow : B ^ (2 * L - 1) = B ^ L * B ^ (L - 1) := by
    rw [← pow_add]
    congr 1
    omega
  have hpowL : B ^ L = B * B ^ (L - 1) := by
    conv_lhs => rw [show L = (L - 1) + 1 by omega, pow_succ]
    ring
  -- the value before the shift
  have hY : B ^ L * (V B (L - 1) y + c * B ^ (L - 1)) = X * X + μ * N := by
    rw [← hS, hpow]
    ring
  have hYlt : V B (L - 1) y + c * B ^ (L - 1) < 2 * N := by
    have h1 : X * X < 4 * N * (4 * N) := Nat.mul_lt_mul'' hX hX
    have h2 : 4 * N * (4 * N) = N * (16 * N) := by ring
    have h3 : N * (16 * N) < N * B ^ L := Nat.mul_lt_mul_of_pos_left hN hNpos
    have h4 : μ * N < B ^ L * N := Nat.mul_lt_mul_of_pos_right hμ hNpos
    have h5 : B ^ L * (V B (L - 1) y + c * B ^ (L - 1)) < B ^ L * (2 * N) := by
      have e : B ^ L * (2 * N) = N * B ^ L + B ^ L * N := by ring
      rw [hY, e]
      omega
    exact Nat.lt_of_mul_lt_mul_left h5
  have hcsmall : c < 2 ^ 25 := by
    have h1 : c * B ^ (L - 1) < 2 * N := by omega
    have h2 : 8 * c * B ^ (L - 1) < B * B ^ (L - 1) := by
      rw [← hpowL]
      have : 8 * c * B ^ (L - 1) = 8 * (c * B ^ (L - 1)) := by ring
      omega
    have := Nat.lt_of_mul_lt_mul_right h2
    omega
  have hcmod : c % 2 ^ 32 = c := Nat.mod_eq_of_lt (by omega)
  rw [hcmod] at hpre
  -- the limbs before the shift
  have hpre_lt : ∀ i, preLimbs x n np L i < B := by
    intro i
    rw [hpre]
    by_cases hi : i = L - 1
    · subst hi
      rw [Function.update_self]
      omega
    · rw [Function.update_of_ne hi]
      exact hy i
  have hpreV : V B L (preLimbs x n np L) = V B (L - 1) y + c * B ^ (L - 1) := by
    have e : V B L (preLimbs x n np L) = V B (L - 1 + 1) (preLimbs x n np L) := by
      congr 1
      omega
    rw [e, V_succ, hpre, Function.update_self]
    congr 1
    exact V_congr fun i hi => Function.update_of_ne (by omega) _ _
  refine ⟨hpre_lt, ⟨μ, hμ, ?_⟩, ?_⟩
  · rw [hpreV]
    exact hY
  · rw [hpreV]
    exact hYlt

/-- **One step of `fermat28`, plain limbs.** Under the hypotheses of `pre_spec` and `b ≤ 1`,
the limbs written by `fm28_step` (carry chain of `× 2^b`) are below `2^28`, their value `Y`
satisfies `R · Y = 2^b (X² + μ N)` for some `μ < R`, and `Y < 4N`. -/
theorem step_spec {x n : ℕ → ℕ} {np b L : ℕ} (hL1 : 1 ≤ L) (hL : L ≤ 24) (hx : ∀ i, x i < 2 * B)
    (hn : ∀ i, n i < B) (hinv : (n 0 * np + 1) % B = 0) (hX : V B L x < 4 * V B L n)
    (hN : 16 * V B L n < B ^ L) (hb : b ≤ 1) :
    (∀ i, stepF x n np b L i < B) ∧
      (∃ μ, μ < B ^ L ∧
        B ^ L * V B L (stepF x n np b L) = 2 ^ b * (V B L x * V B L x + μ * V B L n)) ∧
      V B L (stepF x n np b L) < 4 * V B L n := by
  obtain ⟨hpre_lt, ⟨μ, hμ, hY⟩, hYlt⟩ := pre_spec hL1 hL hx hn hinv hX hN
  obtain ⟨hcy, hch⟩ := chain_spec hpre_lt hb L
  have hstep : stepF x n np b L = chainLimb (preLimbs x n np L) b := rfl
  rw [hstep]
  have hVlt := V_lt (Bs := B) (f := chainLimb (preLimbs x n np L) b) L fun i _ => by
    unfold chainLimb
    rw [and_mask]
    exact Nat.mod_lt _ (by norm_num)
  generalize V B L (preLimbs x n np L) = Y at hY hYlt hch
  have h2b : 2 ^ b * Y < 4 * V B L n := by
    interval_cases b <;> omega
  have hcy0 : cyAt (preLimbs x n np L) b L = 0 := by
    by_contra hne
    have h1 : cyAt (preLimbs x n np L) b L = 1 := by omega
    rw [h1, one_mul] at hch
    omega
  rw [hcy0, zero_mul, add_zero] at hch
  refine ⟨fun i => ?_, ⟨μ, hμ, ?_⟩, ?_⟩
  · unfold chainLimb
    rw [and_mask]
    exact Nat.mod_lt _ (by norm_num)
  · rw [hch, ← hY]
    ring
  · rw [hch]
    exact h2b

/-! ### The redundant step -/

/-- **The redundant step** (`fermat28_step_s1r.cuh`, `_r.cuh`, `_s1rw.cuh`): the same columns,
then `x[i] = y_i << b` in 32 bits, with no carry chain. -/
def stepR (x n : ℕ → ℕ) (np b L : ℕ) (i : ℕ) : ℕ := (preLimbs x n np L i <<< b) % 2 ^ 32

/-- **One step of `fermat28`, redundant limbs (C1, C2, C3').** For input limbs below `2^29`
with value `X < 4N`: the output limbs are below `2^29`, their value `Y` satisfies
`R · Y = 2^b (X² + μ N)` for some `μ < R`, and `Y < 4N`. The invariant "limbs below `2^29`,
value below `4N`" is preserved. -/
theorem stepR_spec {x n : ℕ → ℕ} {np b L : ℕ} (hL1 : 1 ≤ L) (hL : L ≤ 24)
    (hx : ∀ i, x i < 2 * B) (hn : ∀ i, n i < B) (hinv : (n 0 * np + 1) % B = 0)
    (hX : V B L x < 4 * V B L n) (hN : 16 * V B L n < B ^ L) (hb : b ≤ 1) :
    (∀ i, stepR x n np b L i < 2 * B) ∧
      (∃ μ, μ < B ^ L ∧
        B ^ L * V B L (stepR x n np b L) = 2 ^ b * (V B L x * V B L x + μ * V B L n)) ∧
      V B L (stepR x n np b L) < 4 * V B L n := by
  obtain ⟨hpre_lt, ⟨μ, hμ, hY⟩, hYlt⟩ := pre_spec hL1 hL hx hn hinv hX hN
  have hlimb : ∀ i, stepR x n np b L i = 2 ^ b * preLimbs x n np L i := by
    intro i
    have := hpre_lt i
    unfold stepR
    rw [Nat.shiftLeft_eq]
    interval_cases b <;> omega
  have hV : V B L (stepR x n np b L) = 2 ^ b * V B L (preLimbs x n np L) := by
    unfold V
    rw [Finset.mul_sum]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [hlimb, mul_assoc]
  refine ⟨fun i => ?_, ⟨μ, hμ, ?_⟩, ?_⟩
  · rw [hlimb]
    have := hpre_lt i
    interval_cases b <;> omega
  · rw [hV, ← hY]
    ring
  · rw [hV]
    interval_cases b <;> omega

end Gpu28
