theorem mul_modEq (x y : ℕ) : mul x y ≡ x * y [MOD B] :=
  Nat.ModEq.mul (Nat.mod_mod_of_dvd x (by norm_num)) (Nat.mod_mod_of_dvd y (by norm_num))

/-- Only the low 30 bits of `z` matter in `(z·k) & mask`, although the multiply truncates
