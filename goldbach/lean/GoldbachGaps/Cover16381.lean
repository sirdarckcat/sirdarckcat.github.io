/-- **The complete cover.** `N` is even, has 198 digits, and for every prime `q < 16381` the
number `N - q` has a divisor `r` with `2 ≤ r ≤ 479` (so it is composite: `r < N - q`). -/
theorem complete_cover :
    N < 10 ^ 198 ∧ Even N ∧
      (∀ q < 16381, q.Prime → ∃ r, 2 ≤ r ∧ r ≤ 479 ∧ r < N - q ∧ r ∣ N - q) ∧
      ∀ q < 16381, ¬ IsSummand N q := by
  have hl := lists
  simp only [desertListsCheck, Bool.and_eq_true, decide_eq_true_eq, List.all_eq_true] at hl
  refine ⟨N_lt, N_even, fun q hq hqp => ?_, fun q hq => noSummand q (Nat.zero_le q) hq⟩
  obtain ⟨r, hr, hrq⟩ := covered q (Nat.zero_le q) hq hqp
  have h2 := hl.2 r hr
  have hQ : Q = 16381 := rfl
  exact ⟨r, h2.1, coverMods_le r hr, by omega, hrq⟩

/-- The product of the moduli: the step of the covered progression. -/
