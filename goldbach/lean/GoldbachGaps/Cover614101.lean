/-- No prime below `Q` is a Goldbach summand of `N`. -/
theorem noSummand : NoSummandIn N 0 Q :=
  covered.noSummandIn lists le_rfl

/-- **The complete cover.** `N` is even, has 4298 digits, and for every prime `q < 614101` the
number `N - q` has a divisor `r` with `2 ≤ r ≤ 9973` (so it is composite: `r < N - q`). -/
theorem complete_cover :
    N < 10 ^ 4298 ∧ Even N ∧
      (∀ q < 614101, q.Prime → ∃ r, 2 ≤ r ∧ r ≤ 9973 ∧ r < N - q ∧ r ∣ N - q) ∧
      ∀ q < 614101, ¬ IsSummand N q := by
  have hl := lists
  simp only [desertListsCheck, Bool.and_eq_true, decide_eq_true_eq, List.all_eq_true] at hl
  refine ⟨N_lt, N_even, fun q hq hqp => ?_, fun q hq => noSummand q (Nat.zero_le q) hq⟩
  obtain ⟨r, hr, hrq⟩ := covered q (Nat.zero_le q) hq hqp
  have h2 := hl.2 r hr
  have hQ : Q = 614101 := rfl
  exact ⟨r, h2.1, coverMods_le r hr, by omega, hrq⟩

/-- The product of the moduli: the step of the covered progression. -/
def M : ℕ := coverMods.prod

theorem M_eq : M =
     := by
  decide +kernel

/-- **The covered progression.** For every `t` the number `N + t M` is even, every
`N + t M - q` with `q < 614101` prime has a divisor `r` with `2 ≤ r ≤ 9973` and `r < N + t M - q`,
and no prime below `614101` is a Goldbach summand of `N + t M`. -/
theorem complete_cover_family (t : ℕ) :
    Even (N + t * M) ∧
      (∀ q < 614101, q.Prime → ∃ r, 2 ≤ r ∧ r ≤ 9973 ∧ r < N + t * M - q ∧ r ∣ N + t * M - q) ∧
      ∀ q < 614101, ¬ IsSummand (N + t * M) q := by
  have hl := lists
  simp only [desertListsCheck, Bool.and_eq_true, decide_eq_true_eq, List.all_eq_true] at hl
  have hQ : Q = 614101 := rfl
  have hNQ : Q ≤ N := by
    have := hl.1.1
    omega
  have hcov : CoveredIn (N + t * M) coverMods 0 Q := covered.add_mul hNQ t
  have hmods : ∀ r ∈ coverMods, 2 ≤ r ∧ r + Q < N + t * M := fun r hr => by
    have h2 := hl.2 r hr
    have : N ≤ N + t * M := Nat.le_add_right _ _
    exact ⟨h2.1, by omega⟩
  have h2M : 2 ∣ M := List.dvd_prod (List.mem_of_mem_head? rfl)
  refine ⟨N_even.add (Even.mul_left (even_iff_two_dvd.mpr h2M) t), fun q hq hqp => ?_,
    fun q hq => hcov.noSummandIn_of_lt hmods q (Nat.zero_le q) hq⟩
  obtain ⟨r, hr, hrq⟩ := hcov q (Nat.zero_le q) hq hqp
  have h2 := hmods r hr
  exact ⟨r, h2.1, coverMods_le r hr, by omega, hrq⟩

