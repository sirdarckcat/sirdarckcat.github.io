/-! ### Goldbach below `841` by covering -/

/-- **Every even number from `6` to `840` is a sum of two primes, one of them at most `163`**,
and no `N - q` is tested for primality: for `N < y²` the residues of `N` modulo the odd primes
below `y` would otherwise strike every odd prime up to the cover depth of those primes. -/
theorem exists_isSummand_of_lt_841 {N : ℕ} (hE : Even N) (h6 : 6 ≤ N) (hN : N < 841) :
    ∃ q ≤ 163, IsSummand N q := by
  have key : ∀ (y D : ℕ) (mods : List ℕ), oddPrimesBelow y = mods → IsDepth mods D →
      y ≤ 5929 → D ≤ 163 → D + 3 ≤ N → N < y * y → ∃ q ≤ 163, IsSummand N q := by
    intro y D mods hm hD hy hD' hDN hNy
    subst hm
    obtain ⟨q, hq, hs⟩ := exists_isSummand_of_lt_sq hy hE hD hDN hNy
    exact ⟨q, by omega, hs⟩
  rcases Nat.lt_or_ge N 9 with h | h
  · exact key 3 3 [] (by decide +kernel) isDepth_0 (by norm_num) (by norm_num) (by omega)
      (by omega)
  rcases Nat.lt_or_ge N 25 with h | h
  · exact key 5 5 [3] (by decide +kernel) isDepth_1 (by norm_num) (by norm_num) (by omega)
      (by omega)
  rcases Nat.lt_or_ge N 49 with h | h
  · exact key 7 7 [3, 5] (by decide +kernel) isDepth_2 (by norm_num) (by norm_num) (by omega)
      (by omega)
  rcases Nat.lt_or_ge N 121 with h | h
  · exact key 11 19 [3, 5, 7] (by decide +kernel) isDepth_3 (by norm_num) (by norm_num)
      (by omega) (by omega)
  rcases Nat.lt_or_ge N 169 with h | h
  · exact key 13 31 [3, 5, 7, 11] (by decide +kernel) isDepth_4 (by norm_num) (by norm_num)
      (by omega) (by omega)
  rcases Nat.lt_or_ge N 289 with h | h
  · exact key 17 43 [3, 5, 7, 11, 13] (by decide +kernel) isDepth_5 (by norm_num)
      (by norm_num) (by omega) (by omega)
  rcases Nat.lt_or_ge N 361 with h | h
  · exact key 19 67 [3, 5, 7, 11, 13, 17] (by decide +kernel) isDepth_6 (by norm_num)
      (by norm_num) (by omega) (by omega)
  rcases Nat.lt_or_ge N 529 with h | h
  · exact key 23 103 [3, 5, 7, 11, 13, 17, 19] (by decide +kernel) isDepth_7 (by norm_num)
      (by norm_num) (by omega) (by omega)
  · exact key 29 163 [3, 5, 7, 11, 13, 17, 19, 23] (by decide +kernel) isDepth_8
      (by norm_num) (by norm_num) (by omega) (by omega)

