+def _fermat_stream():
+    """FERMAT_STREAM_PRIORITY=high: the Fermat halves' streams get the highest stream priority (with OVERLAP_SIEVE_PRIORITY=0 the sieve thread's stream is then below them: the sieve only gets what the Fermat
