st = math.exp(logboost)\n    U_val = n_res_exact * boost\n    sqrt_term = math.sqrt(m_digits**2 + C_coeff * U_val) if (m_digits**2 + C_coeff * U_val) > 0 else 1e-9\n    \n    # Exact partial derivatives of the D metric\n    dD_dM = 0.5 * (1.0 + m_digits / sqrt_term)\n    dD_dU = 0.5 * C_coeff / sqrt_term\n\n    # Dynamic action probabilities based on temperature\n    # At high temp, we explore (more add/drop). At low temp, we exploit (more optimize).\n    factor = np.clip(t_temp, 0.0, 1.0)\n    p_opt = 0.85 - 0.45 * factor\n    p_add = 0.10 + 0.25 * factor\n    p_drop = 0.05 + 0.20 * factor\n    total_p = p_opt + p_add + p_drop\n    p_opt /= total_p\n    p_add /= total_p\n    p_drop /= total_p\n\n    kind = random.random()\n    if not congr_dict:\n        action = \'add\'\n    else:\n        cand_pool = [m for m in cand_mods if m not in congr_dict]\n        if not cand_pool:\n            p_opt_cond = p_opt / (p_opt + p_drop)\n            action = \'optimize\' if kind < p_opt_cond else \'drop\'\n        else:\n            if kind < p_add:\n                action = \'add\'\n            elif kind < p_add + p_opt:\n                action = \'optimize\'\n            else:\n                action = \'drop\'\n\n    if action == \'add\':\n        cand_pool = [m for m in cand_mods if m not in congr_dict]\n        if cand_pool:\n            # Quantum Multi-verse evaluation: test many moduli simultaneously\n            sample_size = min(100, len(cand_pool))\n            sampled_cands = random.sample(cand_pool, sample_size)\n            \n            # Fractional Entanglement: evaluate non-linear topology of covered targets\n            weights_add = np.exp(-1.2 * cnt_array)\n            \n            dD_list = []\n            cands_data = []\n            for r in sampled_cands:\n                rem = targets % r\n                counts = np.bincount(rem, weights=weights_add, minlength=r)\n                \n                # Consider top 3 residues for adding\n                top_k = min(3, r)\n                best_as = np.argpartition(counts, -top_k)[-top_k:]\n                for a in best_as:\n                    K = counts[a]\n                    dU = boost * (n_res_exact / (r - 1) - K * r / (r - 1))\n                    dM = math.log(r) / LN10\n                    dD = dD_dM * dM + dD_dU * dU\n                    dD_list.append(dD)\n                    cands_data.append((r, a))\n            \n            # Convert to thermodynamic energy scores (lower dD is better)\n            scores = -np.array(dD_list)\n            temp = max(t_temp, 1e-4) * 0.5\n            scaled_scores = scores / temp\n            scaled_scores = scaled_scores - np.max(scaled_scores)\n            probs = np.exp(scaled_scores)\n            probs /= np.sum(probs)\n            \n            idx = np.random.choice(len(scores), p=probs)\n            best_cand, best_a = cands_data[idx]\n            congr_dict[best_cand] = int(best_a)\n\n    elif action == \'optimize\':\n        mods_in = list(congr_dict.keys())\n        if mods_in:\n            # Multi-dimensional topology sweep: re-evaluate active moduli assignments\n            sample_size = min(12, len(mods_in))\n            sampled_mods = random.sample(mods_in, sample_size)\n            \n            dD_list = []\n            cands_data = []\n            \n            for r in sampled_mods:\n                a_old = congr_dict[r]\n                rem = targets % r\n                is_covered_by_r = (rem == a_old)\n                cnt_bg = cnt_array - is_covered_by_r\n                \n                # Fractional entanglement weights based on background topology\n                weights_bg = np.exp(-1.2 * cnt_bg)\n                K_old = np.sum(weights_bg[is_covered_by_r])\n                \n                counts = np.bincount(rem, weights=weights_bg, minlength=r)\n                \n                top_k = min(3, r)\n                best_as = np.argpartition(counts, -top_k)[-top_k:]\n                for a_new in b